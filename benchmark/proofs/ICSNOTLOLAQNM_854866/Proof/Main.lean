        Real.rpow D ((2 : ℝ) / 5) * Real.rpow L2 ((2 : ℝ) / 5) / 48 ≤
          52 * Real.rpow (d : ℝ) ((2 : ℝ) / 5) *
            Real.rpow L1 ((2 : ℝ) / 5) := by
      apply (div_le_iff₀ (by norm_num : (0 : ℝ) < 48)).2
      calc
        _ ≤ 216 * Real.rpow (d : ℝ) ((2 : ℝ) / 5) *
            Real.rpow L1 ((2 : ℝ) / 5) := hpower_product_bound
        _ = 216 * (Real.rpow (d : ℝ) ((2 : ℝ) / 5) *
            Real.rpow L1 ((2 : ℝ) / 5)) := by ring
        _ ≤ (52 * 48) * (Real.rpow (d : ℝ) ((2 : ℝ) / 5) *
            Real.rpow L1 ((2 : ℝ) / 5)) := by
              gcongr <;> norm_num
        _ = (52 * Real.rpow (d : ℝ) ((2 : ℝ) / 5) *
            Real.rpow L1 ((2 : ℝ) / 5)) * 48 := by ring
    field_simp [ne_of_gt hD, ne_of_gt hMr]
    have hD8_nonneg : 0 ≤ Real.rpow D ((8 : ℝ) / 5) :=
      (Real.rpow_pos_of_pos hD _).le
    calc
      _ = (Real.rpow D ((2 : ℝ) / 5) * Real.rpow L2 ((2 : ℝ) / 5) / 48) *
          Real.rpow D ((8 : ℝ) / 5) * 48 := by ring
      _ ≤ (52 * Real.rpow (d : ℝ) ((2 : ℝ) / 5) *
          Real.rpow L1 ((2 : ℝ) / 5)) * Real.rpow D ((8 : ℝ) / 5) * 48 := by
            gcongr
      _ = _ := by ring
  apply hpre.trans
  simp only [convergence_rate_bound]
  rw [hfirst, ← hsecond, ← hthird, hfourth]
  ring_nf at habsorb ⊢
  linarith

@[blueprint "thm:convergence-rate-formal"
  (statement := /-- Let \(f:\mathbb{R}^d\to\mathbb{R}\) be twice continuously differentiable and
  have optimal value \(f^*\), meaning that \(f^*\) is the greatest lower bound of its range.
  Suppose that its gradient is \(L_1\)-Lipschitz and its Hessian is \(L_2\)-Lipschitz.  If a
  trajectory satisfies the optimistic quasi-Newton execution conditions of
  \(\cref{def:conversion-algorithm-execution}\), including the objective-accuracy and
  first-order residual conditions for every trust-region subproblem and the aggregate
  model-quality budget, for \(K\) positive-length episodes, and the
  positive parameters \(D,\eta,\delta\) satisfy
  \(\cref{def:prescribed-parameters}\), then
  \[
    \frac1K\sum_{k=0}^{K-1}\|\nabla f(\bar w^k)\|
    \leq
    \mathcal B\bigl(d,M,L_1,L_2,f(x_0)-f^*\bigr),
  \]
  where the right-hand side is the explicit four-term quantity defined in
  \(\cref{def:convergence-rate-bound}\). -/)
  (proof := /-- Apply \(\cref{lem:source-convergence-rate-gap}\) to the given conversion run,
  its strengthened algorithm-execution certificate, the prescribed parameter identities, and the
  greatest-lower-bound characterization of \(f^*\). -/)
  (title := /-- Explicit convergence rate for the conversion algorithm -/)
  (latexEnv := "theorem")]
theorem convergence_rate_formal
    {d K T M : ℕ} {D eta delta L1 L2 fStar : ℝ}
    (f : optimization_point d → ℝ)
    (run : conversion_run d K T D eta delta)
    (h_smooth : ContDiff ℝ 2 f)
    (h_gradient : has_lipschitz_gradient f L1)
    (h_hessian : has_lipschitz_hessian f L2)
    (h_optimal : IsGLB (Set.range f) fStar)
    (h_execution : conversion_algorithm_execution (L1 := L1) (L2 := L2) f run)
    (h_parameters :
      prescribed_parameters d K T M L1 L2
        (f (run.iterate 0) - fStar) D eta delta) :
    (K : ℝ)⁻¹ *
        ∑ k ∈ Finset.range K, ‖gradient f (episode_average run k)‖ ≤
      convergence_rate_bound d M L1 L2 (f (run.iterate 0) - fStar) := by
  exact source_convergence_rate_gap f run h_smooth h_gradient h_hessian h_optimal h_execution h_parameters
