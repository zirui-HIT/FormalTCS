import Architect
import Mathlib
import Mathlib.MeasureTheory.Function.ConditionalExpectation.Basic
import Mathlib.Probability.Moments.SubGaussian
import Mathlib.Probability.Kernel.Defs
import Mathlib.Probability.Process.Filtration
import Mathlib.Data.Matrix.Mul
import Mathlib.LinearAlgebra.Matrix.ConjTranspose

set_option linter.all false
set_option maxHeartbeats 500000

@[blueprint "def:is-moore-penrose-inverse"
  (statement := /-- Let (A,B\in\mathbb{R}^{d\times d}).  We say that (B) is a
  Moore--Penrose inverse of (A) if
  [
    ABA=A,qquad BAB=B,qquad (AB)^{\mathsf T}=AB,qquad
    (BA)^{\mathsf T}=BA.
  ] -/)
  (title := /-- Moore--Penrose inverse -/)
  (latexEnv := "definition")]
def is_moore_penrose_inverse {d : ℕ}
    (A B : Matrix (Fin d) (Fin d) ℝ) : Prop :=
  A * B * A = A ∧ B * A * B = B ∧
    Matrix.conjTranspose (A * B) = A * B ∧
    Matrix.conjTranspose (B * A) = B * A

@[blueprint "def:cumulative-score"
  (statement := /-- For covariates (X_t\in\mathbb{R}^d), responses
  (Y_t\in\mathbb{R}), and an outcome (omega), define
  [
    S_T(\omega)=\sum_{t=0}^{T-1}Y_t(\omega)X_t(\omega).
  ] -/)
  (title := /-- Cumulative score vector -/)
  (latexEnv := "definition")]
def cumulative_score {Ω : Type*} {T d : ℕ}
    (X : Fin T → Ω → Fin d → ℝ) (Y : Fin T → Ω → ℝ) (ω : Ω) : Fin d → ℝ :=
  ∑ t, Y t ω • X t ω

@[blueprint "def:empirical-gram"
  (statement := /-- For covariates (X_t\in\mathbb{R}^d) and an outcome
  (omega), define the empirical Gram matrix
  [
    V_T(\omega)=\sum_{t=0}^{T-1}X_t(\omega)X_t(\omega)^{\mathsf T}.
  ] -/)
  (title := /-- Empirical Gram matrix -/)
  (latexEnv := "definition")]
def empirical_gram {Ω : Type*} {T d : ℕ}
    (X : Fin T → Ω → Fin d → ℝ) (ω : Ω) : Matrix (Fin d) (Fin d) ℝ :=
  ∑ t, Matrix.vecMulVec (X t ω) (X t ω)

@[blueprint "def:self-normalized-energy"
  (statement := /-- For (s\in\mathbb{R}^d) and a Moore--Penrose inverse
  (V^\dagger) of a positive semidefinite matrix (V), define
  [
    \lVert s\rVert_{V^\dagger}^2=s^{\mathsf T}V^\dagger s.
  ] -/)
  (title := /-- Self-normalized quadratic energy -/)
  (latexEnv := "definition")]
def self_normalized_energy {d : ℕ}
    (s : Fin d → ℝ) (Vdagger : Matrix (Fin d) (Fin d) ℝ) : ℝ :=
  dotProduct s (Matrix.mulVec Vdagger s)

@[blueprint "def:predictable-covariates"
  (statement := /-- Let ((\mathcal F_n)_{n\geq 0}) be a filtration on
  (Omega).  A finite covariate process ((X_t)_{t<T}) is predictable when
  (X_t) is strongly measurable with respect to (mathcal F_t) for every
  (t<T).  Here index (t) represents round (t+1) in the paper. -/)
  (title := /-- Predictable covariates -/)
  (latexEnv := "definition")]
def predictable_covariates {Ω : Type*} [mΩ : MeasurableSpace Ω] {T d : ℕ}
    (ℱ : MeasureTheory.Filtration ℕ mΩ) (X : Fin T → Ω → Fin d → ℝ) : Prop :=
  ∀ t : Fin T, @Measurable Ω (Fin d → ℝ) (ℱ t.val) inferInstance (X t)

@[blueprint "def:covariate-history-filtration"
  (statement := /-- Let ((X_t)_{t<T}) be a finite covariate process on
  (\Omega).  A filtration ((\mathcal H^x_n)_{n\geq0}) is its earlier
  covariate-history filtration if, for every (n), the sigma-algebra
  (\mathcal H^x_n) is generated by the inverse images
  (X_s^{-1}(A)) with (s<n) and measurable (A\subseteq\mathbb R^d).
  Thus, when Lean index (t) represents round (t+1) in the paper,
  (\mathcal H^x_t) contains precisely the covariate information revealed
  before the current covariate (X_{t+1}). -/)
  (title := /-- Earlier covariate-history filtration -/)
  (latexEnv := "definition")]
def covariate_history_filtration {Ω : Type*} [mΩ : MeasurableSpace Ω]
    {T d : ℕ} (ℋx : MeasureTheory.Filtration ℕ mΩ)
    (X : Fin T → Ω → Fin d → ℝ) : Prop :=
  ∀ n : ℕ, ℋx n = MeasurableSpace.generateFrom
    {s : Set Ω | ∃ t : Fin T, t.val < n ∧
      ∃ A : Set (Fin d → ℝ), MeasurableSet A ∧ s = X t ⁻¹' A}

@[blueprint "def:conditionally-subgaussian-noise"
  (statement := /-- Let ((\mathcal F_n)_{n\geq 0}) be a filtration on a
  probability space ((\Omega,\mathcal F,\mu)).  A finite real process
  ((Y_t)_{t<T}) is adapted and conditionally sub-Gaussian with parameter
  (sigma) when, for every (t<T), the random variable (Y_t) is measurable
  with respect to (\mathcal F_{t+1}), and, for every
  (alpha\in\mathbb{R}), the random variable (\exp(\alpha Y_t)) is
  integrable and
  [
    \mathbb E_\mu[\exp(\alpha Y_t)\mid\mathcal F_t]
      \leq \exp(\alpha^2\sigma^2/2)
      \quad\text{almost surely}.
  ]
  Thus (\mathcal F_t) is the information available before round (t), and
  (Y_t) is revealed by the successor stage (\mathcal F_{t+1}). -/)
  (title := /-- Conditionally sub-Gaussian noise -/)
  (latexEnv := "definition")]
def conditionally_subgaussian_noise {Ω : Type*} [mΩ : MeasurableSpace Ω]
    {T : ℕ} (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsFiniteMeasure μ]
    (ℱ : MeasureTheory.Filtration ℕ mΩ) (Y : Fin T → Ω → ℝ) (σ : ℝ) : Prop :=
  (∀ t : Fin T, @Measurable Ω ℝ (ℱ (t.val + 1)) inferInstance (Y t)) ∧
  ∀ (t : Fin T) (α : ℝ),
    MeasureTheory.Integrable (fun ω => Real.exp (α * Y t ω)) μ ∧
    MeasureTheory.condExp (m := ℱ t.val) μ
      (fun ω => Real.exp (α * Y t ω))
      ≤ᵐ[μ] fun _ => Real.exp (α ^ 2 * σ ^ 2 / 2)

@[blueprint "def:conditional-covariate-law"
  (statement := /-- Let ((\mathcal H^x_n)_{n\geq0}) be the earlier
  covariate-history filtration of a process (X_t\in\mathbb{R}^d).
  For each (t<T), let (P_t) be a kernel from
  ((\Omega,\mathcal H^x_t)) to (\mathbb R^d).  This family is a
  conditional law of (X_t) given (\mathcal H^x_t) if every
  (P_t(\omega,\cdot)) is a probability measure and, for every
  measurable test function (f) for which (f(X_t)) is integrable,
  [
    \mathbb E_\mu[f(X_t)\mid\mathcal H^x_t](\omega)
      =\int_{\mathbb R^d} f(x)\,P_t(\omega,dx)
  ]
  for (\mu)-almost every (\omega). -/)
  (title := /-- Conditional law of the covariates -/)
  (latexEnv := "definition")]
def conditional_covariate_law {Ω : Type*} [mΩ : MeasurableSpace Ω]
    {T d : ℕ} (μ : MeasureTheory.Measure Ω)
    (ℋx : MeasureTheory.Filtration ℕ mΩ) (X : Fin T → Ω → Fin d → ℝ)
    (P : (t : Fin T) → @ProbabilityTheory.Kernel Ω (Fin d → ℝ)
      (ℋx t.val) inferInstance) : Prop :=
  (∀ t ω, MeasureTheory.IsProbabilityMeasure (P t ω)) ∧
  ∀ (t : Fin T) (f : (Fin d → ℝ) → ℝ), Measurable f →
    MeasureTheory.Integrable (fun ω => f (X t ω)) μ →
    MeasureTheory.condExp (m := ℋx t.val) μ (fun ω => f (X t ω))
      =ᵐ[μ] fun ω => ∫ x, f x ∂P t ω

@[blueprint "def:smooth-covariates"
  (statement := /-- Let (\mu_0) be a probability measure on
  (\mathbb{R}^d), and, for each (t<T), let (P_t) be a probability
  kernel from the earlier covariate-history space
  ((\Omega,\mathcal H^x_t)) to (\mathbb R^d).  The covariates are
  (C_{\mathrm{cov}})-smooth when, for every (t<T) and every history
  (\omega), the kernel value (P_t(\omega,\cdot)) is dominated by
  (C_{\mathrm{cov}}\mu_0).  Equivalently, its Radon--Nikodym derivative
  with respect to (\mu_0) is at most (C_{\mathrm{cov}}),
  (\mu_0)-almost everywhere. -/)
  (title := /-- Smooth conditional covariate laws -/)
  (latexEnv := "definition")]
noncomputable def smooth_covariates {Ω : Type*} [mΩ : MeasurableSpace Ω]
    {T d : ℕ} (ℋx : MeasureTheory.Filtration ℕ mΩ)
    (P : (t : Fin T) → @ProbabilityTheory.Kernel Ω (Fin d → ℝ)
      (ℋx t.val) inferInstance)
    (μ0 : MeasureTheory.Measure (Fin d → ℝ)) (Ccov : ℝ) : Prop :=
  ∀ t ω, P t ω ≤ ENNReal.ofReal Ccov • μ0

@[blueprint "def:self-normalized-smooth-rate"
  (statement := /-- For a horizon (T), dimension (d), noise parameter
  (sigma), smoothness parameter (C_{\mathrm{cov}}), and confidence
  level (delta), define
  [
    r(T,d,sigma,C_{\mathrm{cov}},delta)
      =\sigma^2\left(
        \sqrt{dC_{\mathrm{cov}}T\log(2T/\delta)}
        +\log(2/\delta)\right).
  ] -/)
  (title := /-- Self-normalized smoothness rate -/)
  (latexEnv := "definition")]
noncomputable def self_normalized_smooth_rate
    (T d : ℕ) (σ Ccov δ : ℝ) : ℝ :=
  σ ^ 2 * (Real.sqrt ((d : ℝ) * Ccov * (T : ℝ) *
    Real.log (2 * (T : ℝ) / δ)) + Real.log (2 / δ))

@[blueprint "def:self-normalized-smoothness-claim"
  (statement := /-- There is an absolute constant (C>0) with the following
  property.  For every positive horizon (T), positive dimension (d),
  probability space ((\Omega,\mathcal F,\mu)), round filtration
  ((\mathcal F_n)_{n\geq0}), and covariate process
  (X_t\in\mathbb{R}^d) that is (\mathcal F_t)-measurable, let
  ((\mathcal H^x_n)_{n\geq0}) be the filtration in which
  (\mathcal H^x_n) is generated by ((X_s)_{s<n}).  Assume that
  (\mathcal H^x_n\subseteq\mathcal F_n) for every (n).  Suppose that
  for each (t<T), (P_t) is a probability kernel from
  ((\Omega,\mathcal H^x_t)) to (\mathbb R^d) and is the conditional law
  of (X_t) given (\mathcal H^x_t), that the kernel family (P_t) is
  (C_{\mathrm{cov}})-smooth relative to a base probability measure
  (\mu_0), and that, for every (t<T), the variable (Y_t) is measurable
  with respect to (\mathcal F_{t+1}), its exponential transforms are
  integrable, and its conditional moment-generating function given
  (\mathcal F_t) is sub-Gaussian with parameter (sigma>0).  For every
  (C_{\mathrm{cov}}\geq1) and (delta\in(0,1)), one then has
  [
    \mathbb P_\mu\!\left(
      \lVert S_T\rVert_{V_T^\dagger}^2
      \leq C\,r(T,d,sigma,C_{\mathrm{cov}},delta)\right)
      \geq 1-\delta.
  ]
  The assertion is required for every pointwise choice of (V_T^\dagger)
  satisfying the four Moore--Penrose equations for (V_T). -/)
  (title := /-- Universal self-normalized smoothness assertion -/)
  (latexEnv := "definition")]
def self_normalized_smoothness_claim : Prop :=
  ∃ C : ℝ, 0 < C ∧
    ∀ (T d : ℕ) (Ω : Type*) [mΩ : MeasurableSpace Ω]
      (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
      (ℱ ℋx : MeasureTheory.Filtration ℕ mΩ)
      (X : Fin T → Ω → Fin d → ℝ) (Y : Fin T → Ω → ℝ)
      (P : (t : Fin T) → @ProbabilityTheory.Kernel Ω (Fin d → ℝ)
        (ℋx t.val) inferInstance)
      (μ0 : MeasureTheory.Measure (Fin d → ℝ))
      [MeasureTheory.IsProbabilityMeasure μ0]
      (Vdagger : Ω → Matrix (Fin d) (Fin d) ℝ)
      (σ Ccov δ : ℝ),
      0 < T → 0 < d → 0 < σ → 1 ≤ Ccov → 0 < δ → δ < 1 →
      covariate_history_filtration ℋx X →
      (∀ n, ℋx n ≤ ℱ n) →
      predictable_covariates ℱ X →
      conditionally_subgaussian_noise μ ℱ Y σ →
      conditional_covariate_law μ ℋx X P →
      smooth_covariates ℋx P μ0 Ccov →
      (∀ ω, is_moore_penrose_inverse (empirical_gram X ω) (Vdagger ω)) →
      μ {ω | self_normalized_energy (cumulative_score X Y ω) (Vdagger ω)
        ≤ C * self_normalized_smooth_rate T d σ Ccov δ}
        ≥ ENNReal.ofReal (1 - δ)

@[blueprint "def:partial-cumulative-score"
  (statement := /-- For (0\leq n\leq T), covariates
  (X_t\in\mathbb R^d), responses (Y_t\in\mathbb R), and an outcome
  (\omega), define the prefix score
  [
    S_n(\omega)=\sum_{t<n}Y_t(\omega)X_t(\omega).
  ] -/)
  (title := /-- Prefix cumulative score -/)
  (latexEnv := "definition")]
def partial_cumulative_score {Ω : Type*} {T d : ℕ}
    (X : Fin T → Ω → Fin d → ℝ) (Y : Fin T → Ω → ℝ)
    (n : Fin (T + 1)) (ω : Ω) : Fin d → ℝ :=
  ∑ t, if t.val < n.val then Y t ω • X t ω else 0

@[blueprint "def:partial-empirical-gram"
  (statement := /-- For (0\leq n\leq T), covariates
  (X_t\in\mathbb R^d), and an outcome (\omega), define the prefix Gram
  matrix
  [
    V_n(\omega)=\sum_{t<n}X_t(\omega)X_t(\omega)^{\mathsf T}.
  ] -/)
  (title := /-- Prefix empirical Gram matrix -/)
  (latexEnv := "definition")]
def partial_empirical_gram {Ω : Type*} {T d : ℕ}
    (X : Fin T → Ω → Fin d → ℝ) (n : Fin (T + 1)) (ω : Ω) :
    Matrix (Fin d) (Fin d) ℝ :=
  ∑ t, if t.val < n.val
    then Matrix.vecMulVec (X t ω) (X t ω) else 0

@[blueprint "def:self-normalized-leverage"
  (statement := /-- Given matrices (U_n\in\mathbb R^{d\times d}) for
  (0\leq n\leq T), define the leverage at round (t<T) by
  [
    q_t=X_t^{\mathsf T}U_{t+1}X_t.
  ] -/)
  (title := /-- Sequential self-normalized leverage -/)
  (latexEnv := "definition")]
def self_normalized_leverage {Ω : Type*} {T d : ℕ}
    (X : Fin T → Ω → Fin d → ℝ)
    (U : Fin (T + 1) → Ω → Matrix (Fin d) (Fin d) ℝ)
    (t : Fin T) (ω : Ω) : ℝ :=
  self_normalized_energy (X t ω) (U t.succ ω)

@[blueprint "def:self-normalized-prediction"
  (statement := /-- Given prefix inverse matrices
  (U_n\in\mathbb R^{d\times d}), define the predictable scalar
  [
    \widehat Y_t=X_t^{\mathsf T}U_{t+1}S_t,
    \qquad S_t=\sum_{s<t}X_sY_s.
  ] -/)
  (title := /-- Sequential self-normalized prediction -/)
  (latexEnv := "definition")]
def self_normalized_prediction {Ω : Type*} {T d : ℕ}
    (X : Fin T → Ω → Fin d → ℝ) (Y : Fin T → Ω → ℝ)
    (U : Fin (T + 1) → Ω → Matrix (Fin d) (Fin d) ℝ)
    (t : Fin T) (ω : Ω) : ℝ :=
  dotProduct (X t ω)
    (Matrix.mulVec (U t.succ ω)
      (partial_cumulative_score X Y t.castSucc ω))

@[blueprint "lem:partial-empirical-gram-pos-semidef"
  (statement := /-- Let (T,d\in\mathbb N), let
  (X_t:\Omega\to\mathbb R^d) for (t<T), let (0\leq n\leq T), and let
  (\omega\in\Omega).  The prefix Gram matrix
  (\sum_{t<n}X_t(\omega)X_t(\omega)^{\mathsf T}) is positive
  semidefinite. -/)
  (proof := /-- By \cref{def:partial-empirical-gram}, the matrix is the
  sum, over all (t<T), of the outer product of (X_t(\omega)) with
  itself when (t<n), and of the zero outer product otherwise.  Hence it
  is a finite sum of outer products of vectors with themselves and is
  positive semidefinite. -/)
  (title := /-- Positive semidefiniteness of prefix Gram matrices -/)
  (latexEnv := "lemma")]
lemma partial_empirical_gram_pos_semidef {Ω : Type*} {T d : ℕ}
    (X : Fin T → Ω → Fin d → ℝ) (n : Fin (T + 1)) (ω : Ω) :
    (partial_empirical_gram X n ω).PosSemidef := by
  rw [Matrix.posSemidef_iff_eq_sum_vecMulVec]
  refine ⟨T, fun t => if t.val < n.val then X t ω else 0, ?_⟩
  rw [partial_empirical_gram]
  apply Finset.sum_congr rfl
  intro t ht
  split
  · simp_all
  · have htn : ¬ t.val < n.val := by omega
    simp [htn]

@[blueprint "lem:pos-semidef-moore-penrose-exists"
  (statement := /-- For every (d\in\mathbb N) and every positive
  semidefinite matrix (A\in\mathbb R^{d\times d}), there exists a
  Moore--Penrose inverse of (A). -/)
  (proof := /-- Diagonalize (A) by the spectral theorem.  Replace every
  eigenvalue (\lambda) by its field inverse (\lambda^{-1}), with
  (0^{-1}=0), and conjugate the resulting diagonal matrix back by the
  same orthogonal change of basis.  The four identities in
  \cref{def:is-moore-penrose-inverse} then reduce coordinatewise to the
  corresponding scalar identities. -/)
  (title := /-- Existence of Moore--Penrose inverses for positive semidefinite matrices -/)
  (latexEnv := "lemma")]
lemma pos_semidef_moore_penrose_exists {d : ℕ}
    (A : Matrix (Fin d) (Fin d) ℝ) (hA : A.PosSemidef) :
    ∃ B, is_moore_penrose_inverse A B := by
  let h := hA.1
  let φ := Unitary.conjStarAlgAut ℝ (Matrix (Fin d) (Fin d) ℝ)
    h.eigenvectorUnitary
  let D := Matrix.diagonal h.eigenvalues
  let E := Matrix.diagonal fun i => (h.eigenvalues i)⁻¹
  refine ⟨φ E, ?_⟩
  rw [is_moore_penrose_inverse, h.spectral_theorem]
  change (φ D * φ E * φ D = φ D) ∧ (φ E * φ D * φ E = φ E) ∧
    Matrix.conjTranspose (φ D * φ E) = φ D * φ E ∧
    Matrix.conjTranspose (φ E * φ D) = φ E * φ D
  constructor
  · rw [← map_mul, ← map_mul]
    congr 1
    simp only [D, E, Matrix.diagonal_mul_diagonal]
    ext i j
    by_cases hi : h.eigenvalues i = 0 <;> simp [hi]
  constructor
  · rw [← map_mul, ← map_mul]
    congr 1
    simp only [D, E, Matrix.diagonal_mul_diagonal]
    ext i j
    by_cases hij : i = j
    · subst j
      by_cases hi : h.eigenvalues i = 0 <;> simp [hi]
    · simp [Matrix.diagonal_apply, hij]
  constructor
  · rw [← map_mul]
    change star (φ (D * E)) = φ (D * E)
    rw [← map_star]
    congr 1
    ext i j
    by_cases hij : i = j
    · subst j
      simp [D, E, Matrix.diagonal_mul_diagonal, Matrix.diagonal_apply]
    · have hji : ¬j = i := fun hji => hij hji.symm
      simp [D, E, Matrix.diagonal_mul_diagonal, Matrix.diagonal_apply, hij, hji]
  · rw [← map_mul]
    change star (φ (E * D)) = φ (E * D)
    rw [← map_star]
    congr 1
    ext i j
    by_cases hij : i = j
    · subst j
      simp [D, E, Matrix.diagonal_mul_diagonal, Matrix.diagonal_apply]
    · have hji : ¬j = i := fun hji => hij hji.symm
      simp [D, E, Matrix.diagonal_mul_diagonal, Matrix.diagonal_apply, hij, hji]

@[blueprint "lem:local-moore-penrose-inverse-unique"
  (statement := /-- For every (d\in\mathbb N) and all matrices
  (A,B,C\in\mathbb R^{d\times d}), if (B) and (C) are Moore--Penrose
  inverses of (A), then (B=C). -/)
  (proof := /-- Expand \cref{def:is-moore-penrose-inverse}.  From
  (ACA=A), one obtains (BA=(BA)(CA)); taking adjoints and using the
  self-adjointness of (BA) and (CA) gives (BA=(CA)(BA)).  Interchanging
  (B) and (C) yields (CA=(CA)(BA)) and (CA=(BA)(CA)), so (BA=CA).
  The same argument with the self-adjoint products (AB) and (AC) gives
  (AB=AC).  Consequently (B=BAB=CAB=CAC=C). -/)
  (title := /-- Local uniqueness of the Moore--Penrose inverse -/)
  (latexEnv := "lemma")]
lemma local_moore_penrose_inverse_unique {d : ℕ}
    {A B C : Matrix (Fin d) (Fin d) ℝ}
    (hB : is_moore_penrose_inverse A B)
    (hC : is_moore_penrose_inverse A C) : B = C := by
  have hBA : B * A = (B * A) * (C * A) := by
    calc
      B * A = B * (A * C * A) := by rw [hC.1]
      _ = (B * A) * (C * A) := by noncomm_ring
  have hCA : C * A = (C * A) * (B * A) := by
    calc
      C * A = C * (A * B * A) := by rw [hB.1]
      _ = (C * A) * (B * A) := by noncomm_ring
  have hCA' : C * A = (B * A) * (C * A) := by
    calc
      C * A = Matrix.conjTranspose (C * A) := hC.2.2.2.symm
      _ = Matrix.conjTranspose ((C * A) * (B * A)) :=
        congrArg Matrix.conjTranspose hCA
      _ = Matrix.conjTranspose (B * A) * Matrix.conjTranspose (C * A) :=
        Matrix.conjTranspose_mul _ _
      _ = (B * A) * (C * A) := by rw [hB.2.2.2, hC.2.2.2]
  have hBA_eq : B * A = C * A := hBA.trans hCA'.symm
  have hAB : A * B = (A * C) * (A * B) := by
    calc
      A * B = (A * C * A) * B := by rw [hC.1]
      _ = (A * C) * (A * B) := by noncomm_ring
  have hAC : A * C = (A * B) * (A * C) := by
    calc
      A * C = (A * B * A) * C := by rw [hB.1]
      _ = (A * B) * (A * C) := by noncomm_ring
  have hAC' : A * C = (A * C) * (A * B) := by
    calc
      A * C = Matrix.conjTranspose (A * C) := hC.2.2.1.symm
      _ = Matrix.conjTranspose ((A * B) * (A * C)) :=
        congrArg Matrix.conjTranspose hAC
      _ = Matrix.conjTranspose (A * C) * Matrix.conjTranspose (A * B) :=
        Matrix.conjTranspose_mul _ _
      _ = (A * C) * (A * B) := by rw [hC.2.2.1, hB.2.2.1]
  have hAB_eq : A * B = A * C := hAB.trans hAC'.symm
  calc
    B = B * A * B := hB.2.1.symm
    _ = C * A * B := by rw [hBA_eq]
    _ = C * (A * B) := by noncomm_ring
    _ = C * (A * C) := by rw [hAB_eq]
    _ = C * A * C := by noncomm_ring
    _ = C := hC.2.1

@[blueprint "lem:measurable-gram-moore-penrose"
  (statement := /-- Let (\Omega) be a measurable space, let
  (T,d\in\mathbb N), and let ((\mathcal F_n)_{n\geq0}) be a filtration
  on (\Omega).  Suppose that, for every (t<T), the map
  (X_t:\Omega\to\mathbb R^d) is (\mathcal F_t)-measurable.  There is a
  family ((U_n:\Omega\to\mathbb R^{d\times d})_{0\leq n\leq T}) such
  that, for every (n) and every (\omega\in\Omega), the matrix
  (U_n(\omega)) is a Moore--Penrose inverse of the prefix Gram matrix
  [
    V_n(\omega)=\sum_{s<n}X_s(\omega)X_s(\omega)^{\mathsf T}.
  ]
  For every pair of coordinate indices, the corresponding entry of
  (U_0) is (\mathcal F_0)-measurable; for every (t<T), every entry of
  (U_{t+1}) is (\mathcal F_t)-measurable. -/)
  (proof := /-- For every prefix (n) and outcome (\omega),
  \cref{lem:partial-empirical-gram-pos-semidef} shows that
  (V_n(\omega)) is positive semidefinite.  Choose a Moore--Penrose
  inverse (U_n(\omega)) by
  \cref{lem:pos-semidef-moore-penrose-exists}.  At (n=0), both
  (U_0(\omega)) and the zero matrix are Moore--Penrose inverses of the
  zero Gram matrix, so
  \cref{lem:local-moore-penrose-inverse-unique} gives
  (U_0(\omega)=0).  Its entries are therefore
  (\mathcal F_0)-measurable.

  Fix (t<T), put (A=V_{t+1}(\omega)) and (B=U_{t+1}(\omega)), and set
  (\varepsilon_k=(k+1)^{-1}) and
  [
    R_k(\omega)=\bigl(A^2+\varepsilon_k I\bigr)^{-1}A.
  ]
  Every entry of (A) is (\mathcal F_t)-measurable: each summand uses
  some (X_s) with (s\leq t), and filtration monotonicity promotes its
  (\mathcal F_s)-measurability to (\mathcal F_t)-measurability.  Hence
  every entry of (R_k) is measurable, since the determinant and
  adjugate are polynomial in the matrix entries and scalar inversion
  is measurable.

  It remains to identify the pointwise limit.  Positive
  semidefiniteness makes (A) self-adjoint.  The adjoint (B^{\mathsf T})
  satisfies the same four Moore--Penrose identities as (B), so
  \cref{lem:local-moore-penrose-inverse-unique} makes (B) self-adjoint.
  The self-adjointness identities then give (AB=BA), whence
  (A^2B=A) and (AB^2=B).  For every (\varepsilon>0), the matrices
  (M=A^2+\varepsilon I) and (N=I+\varepsilon B^2) are positive
  definite, and the preceding identities give (MB=AN).  Thus
  [
    M^{-1}A=BN^{-1}.
  ]
  As (\varepsilon_k\to0), one has (N\to I); continuity of matrix
  inversion at (I) therefore yields (R_k(\omega)\to B).  Each entry of
  (U_{t+1}) is consequently a pointwise limit of
  (\mathcal F_t)-measurable real functions and is itself
  (\mathcal F_t)-measurable. -/)
  (title := /-- Measurable Moore--Penrose inverses of prefix Gram matrices -/)
  (latexEnv := "lemma")]
lemma measurable_gram_moore_penrose {Ω : Type*}
    [mΩ : MeasurableSpace Ω] {T d : ℕ}
    (ℱ : MeasureTheory.Filtration ℕ mΩ)
    (X : Fin T → Ω → Fin d → ℝ)
    (hX : predictable_covariates ℱ X) :
    ∃ U : Fin (T + 1) → Ω → Matrix (Fin d) (Fin d) ℝ,
      (∀ n ω, is_moore_penrose_inverse
        (partial_empirical_gram X n ω) (U n ω)) ∧
      (∀ i j, @Measurable Ω ℝ (ℱ 0) inferInstance
        (fun ω => U 0 ω i j)) ∧
      ∀ (t : Fin T) i j,
        @Measurable Ω ℝ (ℱ t.val) inferInstance
          (fun ω => U t.succ ω i j) := by
  let U : Fin (T + 1) → Ω → Matrix (Fin d) (Fin d) ℝ := fun n ω =>
    Classical.choose (pos_semidef_moore_penrose_exists
      (partial_empirical_gram X n ω)
      (partial_empirical_gram_pos_semidef X n ω))
  have hU : ∀ n ω, is_moore_penrose_inverse
      (partial_empirical_gram X n ω) (U n ω) := fun n ω =>
    Classical.choose_spec (pos_semidef_moore_penrose_exists
      (partial_empirical_gram X n ω)
      (partial_empirical_gram_pos_semidef X n ω))
  refine ⟨U, hU, ?_, ?_⟩
  · intro i j
    have hzero : ∀ ω, U 0 ω = 0 := by
      intro ω
      apply local_moore_penrose_inverse_unique (hU 0 ω)
      simp [is_moore_penrose_inverse, partial_empirical_gram]
    simpa only [hzero, Pi.zero_apply, Matrix.zero_apply] using
      (measurable_const : @Measurable Ω ℝ (ℱ 0) inferInstance
        (fun _ => (0 : ℝ)))
  · intro t i j
    letI : MeasurableSpace Ω := ℱ t.val
    let A : Ω → Matrix (Fin d) (Fin d) ℝ := fun ω =>
      partial_empirical_gram X t.succ ω
    have hA : @Measurable Ω (Fin d → Fin d → ℝ)
        (ℱ t.val) inferInstance A := by
      change @Measurable Ω (Fin d → Fin d → ℝ) (ℱ t.val) inferInstance
        (fun ω => fun a b => A ω a b)
      rw [measurable_pi_iff]
      intro a
      rw [measurable_pi_iff]
      intro b
      rw [show A = fun ω => partial_empirical_gram X t.succ ω by rfl]
      simp only [partial_empirical_gram, Matrix.sum_apply]
      apply Finset.measurable_sum
      intro s hs
      by_cases hst : s.val < t.succ.val
      · simp only [if_pos hst, Matrix.vecMulVec_apply]
        have hst' : s.val ≤ t.val := by
          rw [Fin.val_succ] at hst
          omega
        have hXs : @Measurable Ω (Fin d → ℝ) (ℱ t.val) inferInstance (X s) :=
          (hX s).mono (ℱ.mono hst') le_rfl
        exact (hXs.eval (a := a)).mul (hXs.eval (a := b))
      · simp only [if_neg hst, Matrix.zero_apply]
        exact measurable_const
    have hAA : @Measurable Ω (Fin d → Fin d → ℝ)
        (ℱ t.val) inferInstance (fun ω => A ω * A ω) := by
      change @Measurable Ω (Fin d → Fin d → ℝ) (ℱ t.val) inferInstance
        (fun ω => fun a b => (A ω * A ω) a b)
      rw [measurable_pi_iff]
      intro a
      rw [measurable_pi_iff]
      intro b
      simp only [Matrix.mul_apply]
      exact Finset.measurable_sum _ fun k _ =>
        ((hA.eval (a := a)).eval (a := k)).mul
          ((hA.eval (a := k)).eval (a := b))
    let ε : ℕ → ℝ := fun n => ((n + 1 : ℕ) : ℝ)⁻¹
    let M : ℕ → Ω → Matrix (Fin d) (Fin d) ℝ := fun n ω =>
      A ω * A ω + ε n • 1
    let R : ℕ → Ω → Matrix (Fin d) (Fin d) ℝ := fun n ω =>
      (M n ω)⁻¹ * A ω
    have hM : ∀ n, @Measurable Ω (Fin d → Fin d → ℝ)
        (ℱ t.val) inferInstance (M n) := by
      intro n
      change @Measurable Ω (Fin d → Fin d → ℝ) (ℱ t.val) inferInstance
        (fun ω => fun a b => M n ω a b)
      rw [measurable_pi_iff]
      intro a
      rw [measurable_pi_iff]
      intro b
      exact (((hAA.eval (a := a)).eval (a := b)).add measurable_const)
    have hR : ∀ n, @Measurable Ω ℝ (ℱ t.val) inferInstance
        (fun ω => R n ω i j) := by
      intro n
      have hdet_map : Measurable
          (fun Q : Fin d → Fin d → ℝ => Matrix.det Q) := by
        have hc : Continuous (fun Q : Fin d → Fin d → ℝ => Q) := continuous_id
        exact hc.matrix_det.measurable
      have hdet : @Measurable Ω ℝ (ℱ t.val) inferInstance
          (fun ω => (M n ω).det) :=
        hdet_map.comp (hM n)
      simp only [R, Matrix.mul_apply, Matrix.inv_def, Ring.inverse_eq_inv',
        Pi.smul_apply, smul_eq_mul]
      apply Finset.measurable_sum
      intro k hk
      have hadj_map : Measurable
          (fun Q : Fin d → Fin d → ℝ =>
            Matrix.adjugate Q i k) := by
        have hc : Continuous (fun Q : Fin d → Fin d → ℝ => Q) := continuous_id
        exact (hc.matrix_adjugate.matrix_elem i k).measurable
      have hadj : @Measurable Ω ℝ (ℱ t.val) inferInstance
          (fun ω => (M n ω).adjugate i k) := by
        simpa only [Function.comp_def] using hadj_map.comp (hM n)
      convert (hdet.inv.mul hadj).mul
        ((hA.eval (a := k)).eval (a := j)) using 1 <;> rfl
    have hε : Filter.Tendsto ε Filter.atTop (nhds 0) := by
      exact tendsto_inv_atTop_zero.comp
        (tendsto_natCast_atTop_atTop.comp (Filter.tendsto_add_atTop_nat 1))
    have hpoint : ∀ ω, Filter.Tendsto (fun n => R n ω i j)
        Filter.atTop (nhds (U t.succ ω i j)) := by
      intro ω
      let B := U t.succ ω
      have hpos : (A ω).PosSemidef :=
        partial_empirical_gram_pos_semidef X t.succ ω
      have hBinv : is_moore_penrose_inverse (A ω) B := hU t.succ ω
      have hAstar : Matrix.conjTranspose (A ω) = A ω := hpos.1
      have hBstar_inv : is_moore_penrose_inverse (A ω)
          (Matrix.conjTranspose B) := by
        rcases hBinv with ⟨hABA, hBAB, hAB, hBA⟩
        have hABstar : A ω * Matrix.conjTranspose B = B * A ω := by
          calc
            A ω * Matrix.conjTranspose B =
                Matrix.conjTranspose (B * A ω) := by
              simp only [Matrix.conjTranspose_mul, hAstar]
            _ = B * A ω := hBA
        have hBAstar : Matrix.conjTranspose B * A ω = A ω * B := by
          calc
            Matrix.conjTranspose B * A ω =
                Matrix.conjTranspose (A ω * B) := by
              simp only [Matrix.conjTranspose_mul, hAstar]
            _ = A ω * B := hAB
        refine ⟨?_, ?_, ?_, ?_⟩
        · have ht := congrArg Matrix.conjTranspose hABA
          simpa only [Matrix.conjTranspose_mul,
            Matrix.conjTranspose_conjTranspose, hAstar, mul_assoc] using ht
        · have ht := congrArg Matrix.conjTranspose hBAB
          simpa only [Matrix.conjTranspose_mul,
            Matrix.conjTranspose_conjTranspose, hAstar, mul_assoc] using ht
        · simpa only [hABstar, hBA]
        · simpa only [hBAstar, hAB]
      have hBstar : Matrix.conjTranspose B = B :=
        local_moore_penrose_inverse_unique hBstar_inv hBinv
      have hcomm : A ω * B = B * A ω := by
        calc
          A ω * B = Matrix.conjTranspose (A ω * B) := hBinv.2.2.1.symm
          _ = Matrix.conjTranspose B * Matrix.conjTranspose (A ω) :=
            Matrix.conjTranspose_mul _ _
          _ = B * A ω := by rw [hBstar, hAstar]
      have hAAB : A ω * A ω * B = A ω := by
        calc
          A ω * A ω * B = A ω * (A ω * B) := by noncomm_ring
          _ = A ω * (B * A ω) := by rw [hcomm]
          _ = A ω * B * A ω := by noncomm_ring
          _ = A ω := hBinv.1
      have hABB : A ω * (B * B) = B := by
        calc
          A ω * (B * B) = (A ω * B) * B := by noncomm_ring
          _ = (B * A ω) * B := by rw [hcomm]
          _ = B * A ω * B := by noncomm_ring
          _ = B := hBinv.2.1
      have hreg : ∀ n, R n ω = B * (1 + ε n • (B * B))⁻¹ := by
        intro n
        have hεpos : 0 < ε n := by
          simp only [ε]
          positivity
        have hAApos : (A ω * A ω).PosSemidef := by
          simpa only [hAstar] using
            Matrix.posSemidef_conjTranspose_mul_self (A ω)
        have hBBpos : (B * B).PosSemidef := by
          simpa only [hBstar] using
            Matrix.posSemidef_conjTranspose_mul_self B
        have hMpos : (M n ω).PosDef := by
          apply Matrix.PosDef.posSemidef_add hAApos
          exact Matrix.PosDef.one.smul hεpos
        have hNpos : (1 + ε n • (B * B)).PosDef :=
          Matrix.PosDef.one.add_posSemidef (hBBpos.smul hεpos.le)
        have hMunit : IsUnit (M n ω).det :=
          isUnit_iff_ne_zero.mpr hMpos.det_pos.ne'
        have hNunit : IsUnit (1 + ε n • (B * B)).det :=
          isUnit_iff_ne_zero.mpr hNpos.det_pos.ne'
        have hMN : M n ω * B = A ω * (1 + ε n • (B * B)) := by
          simp only [M, add_mul, mul_add, one_mul, mul_one, hAAB, hABB,
            smul_mul_assoc, mul_smul_comm]
        simp only [R]
        calc
          (M n ω)⁻¹ * A ω =
              ((M n ω)⁻¹ * A ω) *
                ((1 + ε n • (B * B)) * (1 + ε n • (B * B))⁻¹) := by
            simp only [Matrix.mul_nonsing_inv _ hNunit, mul_one]
          _ = (M n ω)⁻¹ * (A ω * (1 + ε n • (B * B))) *
                (1 + ε n • (B * B))⁻¹ := by noncomm_ring
          _ = (M n ω)⁻¹ * (M n ω * B) *
                (1 + ε n • (B * B))⁻¹ := by rw [hMN]
          _ = ((M n ω)⁻¹ * M n ω) * B *
                (1 + ε n • (B * B))⁻¹ := by noncomm_ring
          _ = B * (1 + ε n • (B * B))⁻¹ := by
            simp only [Matrix.nonsing_inv_mul _ hMunit, one_mul]
      have hN : Filter.Tendsto (fun n => 1 + ε n • (B * B))
          Filter.atTop (nhds (1 : Matrix (Fin d) (Fin d) ℝ)) := by
        simpa using tendsto_const_nhds.add (hε.smul_const (B * B))
      have hinv : Filter.Tendsto
          (fun n => (1 + ε n • (B * B))⁻¹) Filter.atTop
          (nhds (1 : Matrix (Fin d) (Fin d) ℝ)) := by
        have hraw :=
          (continuousAt_matrix_inv (1 : Matrix (Fin d) (Fin d) ℝ)
            (by simpa using
              (continuousAt_id.inv₀ (by norm_num : (1 : ℝ) ≠ 0)))).tendsto.comp hN
        convert hraw using 1 <;>
          simp [Function.comp_def, Matrix.inv_def]
      have hmatrix : Filter.Tendsto (fun n => R n ω) Filter.atTop (nhds B) := by
        rw [show (fun n => R n ω) =
          fun n => B * (1 + ε n • (B * B))⁻¹ by funext n; exact hreg n]
        simpa using tendsto_const_nhds.mul hinv
      exact ((tendsto_pi_nhds.1 (tendsto_pi_nhds.1 hmatrix i)) j)
    refine @measurable_of_tendsto_metrizable Ω ℝ (ℱ t.val) _ _ _ _ _ _
      hR ?_
    exact tendsto_pi_nhds.2 hpoint

@[blueprint "lem:prefix-gram-moore-penrose-inverse-unique-local"
  (statement := /-- Let (A,B,C\in\mathbb R^{d\times d}).  If both (B)
  and (C) are Moore--Penrose inverses of (A), then (B=C). -/)
  (proof := /-- Expand the four identities in
  \cref{def:is-moore-penrose-inverse}.  The self-adjoint idempotents
  (BA) and (CA) satisfy ((BA)(CA)=BA) and ((CA)(BA)=CA).  Taking the
  adjoint of the first identity and using self-adjointness shows that
  ((CA)(BA)=BA), whence (BA=CA).  Applying the same argument to (AB)
  and (AC) gives (AB=AC).  Therefore
  (B=BAB=CAB=CAC=C). -/)
  (title := /-- Local uniqueness of the Moore--Penrose inverse -/)
  (latexEnv := "lemma")]
lemma prefix_gram_moore_penrose_inverse_unique_local {d : ℕ}
    {A B C : Matrix (Fin d) (Fin d) ℝ}
    (hB : is_moore_penrose_inverse A B)
    (hC : is_moore_penrose_inverse A C) : B = C := by
  rcases hB with ⟨hABA, hBAB, hAB, hBA⟩
  rcases hC with ⟨hACA, hCAC, hAC, hCA⟩
  have hBA_CA : B * A = C * A := by
    have h₁ : (B * A) * (C * A) = B * A := by
      calc
        (B * A) * (C * A) = B * (A * C * A) := by
          simp only [Matrix.mul_assoc]
        _ = B * A := by rw [hACA]
    have h₂ : (C * A) * (B * A) = C * A := by
      calc
        (C * A) * (B * A) = C * (A * B * A) := by
          simp only [Matrix.mul_assoc]
        _ = C * A := by rw [hABA]
    have h₃ : (C * A) * (B * A) = B * A := by
      have h := congrArg Matrix.conjTranspose h₁
      simpa only [Matrix.conjTranspose_mul, hBA, hCA] using h
    exact h₃.symm.trans h₂
  have hAB_AC : A * B = A * C := by
    have h₁ : (A * B) * (A * C) = A * C := by
      calc
        (A * B) * (A * C) = (A * B * A) * C := by
          simp only [Matrix.mul_assoc]
        _ = A * C := by rw [hABA]
    have h₂ : (A * C) * (A * B) = A * B := by
      calc
        (A * C) * (A * B) = (A * C * A) * B := by
          simp only [Matrix.mul_assoc]
        _ = A * B := by rw [hACA]
    have h₃ : (A * C) * (A * B) = A * C := by
      have h := congrArg Matrix.conjTranspose h₁
      simpa only [Matrix.conjTranspose_mul, hAB, hAC] using h
    exact h₂.symm.trans h₃
  calc
    B = B * A * B := hBAB.symm
    _ = C * A * B := by rw [hBA_CA]
    _ = C * (A * B) := by simp only [Matrix.mul_assoc]
    _ = C * (A * C) := by rw [hAB_AC]
    _ = C * A * C := by simp only [Matrix.mul_assoc]
    _ = C := hCAC

@[blueprint "lem:prefix-gram-moore-penrose-self-adjoint-local"
  (statement := /-- Let (A,B\in\mathbb R^{d\times d}).  If (A) is
  self-adjoint and (B) is a Moore--Penrose inverse of (A), then (B) is
  self-adjoint. -/)
  (proof := /-- Transpose the four equations in
  \cref{def:is-moore-penrose-inverse}.  Since (A^{\mathsf T}=A), the
  resulting identities show that (B^{\mathsf T}) is also a
  Moore--Penrose inverse of (A).  Its equality with (B) follows from
  \cref{lem:prefix-gram-moore-penrose-inverse-unique-local}. -/)
  (title := /-- Self-adjointness of a Moore--Penrose inverse -/)
  (latexEnv := "lemma")]
lemma prefix_gram_moore_penrose_self_adjoint_local {d : ℕ}
    {A B : Matrix (Fin d) (Fin d) ℝ}
    (hA : Matrix.conjTranspose A = A)
    (hB : is_moore_penrose_inverse A B) :
    Matrix.conjTranspose B = B := by
  apply prefix_gram_moore_penrose_inverse_unique_local ?_ hB
  rcases hB with ⟨hABA, hBAB, hAB, hBA⟩
  have hABA' : A * Matrix.conjTranspose B * A = A := by
    have h := congrArg Matrix.conjTranspose hABA
    simpa only [Matrix.conjTranspose_mul,
      Matrix.conjTranspose_conjTranspose, hA, Matrix.mul_assoc] using h
  have hBAB' : Matrix.conjTranspose B * A * Matrix.conjTranspose B =
      Matrix.conjTranspose B := by
    have h := congrArg Matrix.conjTranspose hBAB
    simpa only [Matrix.conjTranspose_mul,
      Matrix.conjTranspose_conjTranspose, hA, Matrix.mul_assoc] using h
  have hAB' : A * Matrix.conjTranspose B = B * A := by
    simpa only [Matrix.conjTranspose_mul, hA] using hBA
  have hBA' : Matrix.conjTranspose B * A = A * B := by
    simpa only [Matrix.conjTranspose_mul, hA] using hAB
  refine ⟨hABA', hBAB', ?_, ?_⟩
  · simpa only [Matrix.conjTranspose_mul,
      Matrix.conjTranspose_conjTranspose, hA] using hAB'.symm
  · simpa only [Matrix.conjTranspose_mul,
      Matrix.conjTranspose_conjTranspose, hA] using hBA'.symm

@[blueprint "lem:prefix-gram-self-adjoint-idempotent-diagonal-nonnegative"
  (statement := /-- Let (P\in\mathbb R^{n\times n}) be self-adjoint
  and idempotent.  Then every diagonal entry of (P) is nonnegative. -/)
  (proof := /-- Fix an index (i).  Self-adjointness and idempotence give
  [
    P_{ii}=(P^2)_{ii}=\sum_j P_{ij}P_{ji}
      =\sum_j P_{ij}^2\geq0.
  ] -/)
  (title := /-- Nonnegative diagonal of a self-adjoint idempotent -/)
  (latexEnv := "lemma")]
lemma prefix_gram_self_adjoint_idempotent_diagonal_nonnegative
    {n : ℕ} (P : Matrix (Fin n) (Fin n) ℝ)
    (hP : Matrix.conjTranspose P = P) (hP2 : P * P = P)
    (i : Fin n) : 0 ≤ P i i := by
  have hsymm : ∀ j, P j i = P i j := by
    intro j
    have h := congrFun (congrFun hP j) i
    simpa using h.symm
  have hdiag : P i i = ∑ j, (P i j) ^ 2 := by
    calc
      P i i = (P * P) i i := by
        exact (congrFun (congrFun hP2 i) i).symm
      _ = ∑ j, P i j * P j i := by rw [Matrix.mul_apply]
      _ = ∑ j, (P i j) ^ 2 := by
        apply Finset.sum_congr rfl
        intro j hj
        rw [hsymm j]
        ring
  rw [hdiag]
  positivity

@[blueprint "lem:prefix-gram-leverage-bounds"
  (statement := /-- Let (\Omega) be a type, let (T,d\in\mathbb N), and
  for every (t<T) let (X_t:\Omega\to\mathbb R^d).  For each
  (0\leq n\leq T), let
  (U_n:\Omega\to\mathbb R^{d\times d}) and suppose that, for every
  (\omega\in\Omega), the matrix (U_n(\omega)) is a Moore--Penrose
  inverse of
  [
    V_n(\omega)=\sum_{s<n}X_s(\omega)X_s(\omega)^{\mathsf T}.
  ]
  Then, for every (t<T) and every (\omega\in\Omega), the sequential
  leverage
  [
    q_t(\omega)=X_t(\omega)^{\mathsf T}U_{t+1}(\omega)X_t(\omega)
  ]
  satisfies (0\leq q_t(\omega)\leq1). -/)
  (proof := /-- Fix (t) and (\omega), and form the matrix (Z) whose
  first (t+1) columns are (X_0(\omega),\ldots,X_t(\omega)) and whose
  remaining columns vanish.  By
  \cref{def:partial-empirical-gram},
  (V_{t+1}(\omega)=ZZ^{\mathsf T}).  The matrix (V_{t+1}(\omega)) is
  self-adjoint, so
  \cref{lem:prefix-gram-moore-penrose-self-adjoint-local} shows that
  (U_{t+1}(\omega)) is self-adjoint.  The Moore--Penrose equations then
  imply that
  [
    P=Z^{\mathsf T}U_{t+1}(\omega)Z
  ]
  is self-adjoint and idempotent.  The same properties hold for (I-P).
  By
  \cref{lem:prefix-gram-self-adjoint-idempotent-diagonal-nonnegative},
  both (P_{tt}) and ((I-P)_{tt}=1-P_{tt}) are nonnegative.  Finally,
  \cref{def:self-normalized-leverage} gives
  (P_{tt}=q_t(\omega)), and hence (0\leq q_t(\omega)\leq1). -/)
  (title := /-- Unit bounds for prefix Gram leverage -/)
  (latexEnv := "lemma")]
lemma prefix_gram_leverage_bounds {Ω : Type*} {T d : ℕ}
    (X : Fin T → Ω → Fin d → ℝ)
    (U : Fin (T + 1) → Ω → Matrix (Fin d) (Fin d) ℝ)
    (hU : ∀ n ω, is_moore_penrose_inverse
      (partial_empirical_gram X n ω) (U n ω)) :
    ∀ (t : Fin T) (ω : Ω),
      0 ≤ self_normalized_leverage X U t ω ∧
      self_normalized_leverage X U t ω ≤ 1 := by
  intro t ω
  let Z : Matrix (Fin d) (Fin T) ℝ := fun i s =>
    if s.val < t.succ.val then X s ω i else 0
  let A := partial_empirical_gram X t.succ ω
  let B := U t.succ ω
  have hA : A = Z * Matrix.conjTranspose Z := by
    ext i j
    dsimp [A, partial_empirical_gram]
    rw [Matrix.sum_apply]
    apply Finset.sum_congr rfl
    intro s hs
    by_cases hst : s ≤ t <;>
      simp [hst, Z, Matrix.mul_apply, Matrix.vecMulVec, Matrix.of_apply]
  have hAstar : Matrix.conjTranspose A = A := by
    rw [hA]
    simp
  have hmp : is_moore_penrose_inverse A B := hU t.succ ω
  have hBstar : Matrix.conjTranspose B = B :=
    prefix_gram_moore_penrose_self_adjoint_local hAstar hmp
  have hBtranspose : Matrix.transpose B = B := by
    simpa using hBstar
  let P : Matrix (Fin T) (Fin T) ℝ :=
    Matrix.conjTranspose Z * (B * Z)
  have hPstar : Matrix.conjTranspose P = P := by
    simp [P, hBtranspose, Matrix.mul_assoc]
  have hP2 : P * P = P := by
    rcases hmp with ⟨hABA, hBAB, hAB, hBA⟩
    calc
      P * P = Matrix.conjTranspose Z * B *
          (Z * Matrix.conjTranspose Z) * B * Z := by
        simp [P, Matrix.mul_assoc]
      _ = Matrix.conjTranspose Z * B * A * B * Z := by rw [← hA]
      _ = Matrix.conjTranspose Z * (B * A * B) * Z := by
        simp only [Matrix.mul_assoc]
      _ = Matrix.conjTranspose Z * B * Z := by rw [hBAB]
      _ = P := by simp [P, Matrix.mul_assoc]
  have hPtranspose : Matrix.transpose P = P := by
    simpa using hPstar
  have hQstar : Matrix.conjTranspose (1 - P) = 1 - P := by
    simp [hPtranspose]
  have hQ2 : (1 - P) * (1 - P) = 1 - P := by
    noncomm_ring [hP2]
  have hPt :=
    prefix_gram_self_adjoint_idempotent_diagonal_nonnegative P hPstar hP2 t
  have hQt :=
    prefix_gram_self_adjoint_idempotent_diagonal_nonnegative
      (1 - P) hQstar hQ2 t
  have hlev : self_normalized_leverage X U t ω = P t t := by
    simp [self_normalized_leverage, self_normalized_energy, P, Z, B,
      Matrix.mul_apply, Matrix.mulVec, dotProduct]
  constructor
  · rwa [hlev]
  · have hcomp : 0 ≤ 1 - P t t := by simpa using hQt
    rw [hlev]
    linarith

@[blueprint "lem:finite-gram-moore-penrose-family"
  (statement := /-- Let (\Omega) be a measurable space, let
  (T,d\in\mathbb N), and let ((\mathcal F_n)_{n\geq0}) be a filtration
  on (\Omega).  For (t<T), let (X_t:\Omega\to\mathbb R^d) and
  (Y_t:\Omega\to\mathbb R).  Suppose that (X_t) is
  (\mathcal F_t)-measurable and (Y_t) is
  (\mathcal F_{t+1})-measurable for every (t<T).  Let
  (V_T^\dagger:\Omega\to\mathbb R^{d\times d}) be such that, for every
  (\omega\in\Omega), the matrix (V_T^\dagger(\omega)) is a
  Moore--Penrose inverse of
  [
    V_T(\omega)=\sum_{s<T}X_s(\omega)X_s(\omega)^{\mathsf T}.
  ]
  Then there exists a family
  ((U_n:\Omega\to\mathbb R^{d\times d})_{0\leq n\leq T}) such that,
  for every (0\leq n\leq T) and (\omega\in\Omega), the matrix
  (U_n(\omega)) is a Moore--Penrose inverse of
  [
    V_n(\omega)=\sum_{s<n}X_s(\omega)X_s(\omega)^{\mathsf T},
  ]
  and (U_T(\omega)=V_T^\dagger(\omega)).  Moreover, for every (t<T),
  the predictor (\widehat Y_t) and leverage (q_t) of
  \cref{def:self-normalized-prediction,def:self-normalized-leverage}
  are (\mathcal F_t)-measurable, and, for every (\omega\in\Omega),
  (0\leq q_t(\omega)\leq1). -/)
  (proof := /-- Apply
  \cref{lem:measurable-gram-moore-penrose} to obtain a pointwise
  Moore--Penrose family whose entries at time (t+1) are
  (\mathcal F_t)-measurable.  Fix (t<T).  For every (s<t), filtration
  monotonicity promotes the (\mathcal F_s)-measurability of (X_s) and
  the (\mathcal F_{s+1})-measurability of (Y_s) to
  (\mathcal F_t)-measurability.  Thus every coordinate of the prefix
  score in \cref{def:partial-cumulative-score} is measurable, since it
  is a finite sum of products of measurable real functions.  The entrywise
  measurability of (U_{t+1}) and the formulas in
  \cref{def:self-normalized-prediction,def:self-normalized-leverage}
  then show, again by finite sums and products, that the predictor and
  leverage are (\mathcal F_t)-measurable.

  At time (T), \cref{def:partial-empirical-gram,def:empirical-gram}
  identifies the terminal prefix Gram matrix with (V_T).  Hence both
  (U_T) and the prescribed (V_T^\dagger) are Moore--Penrose inverses of
  the same matrix, so
  \cref{lem:local-moore-penrose-inverse-unique} gives
  (U_T=V_T^\dagger) pointwise.  Finally,
  \cref{lem:prefix-gram-leverage-bounds} gives
  (0\leq q_t\leq1) pointwise. -/)
  (title := /-- Measurable Moore--Penrose inverses of prefix Gram matrices -/)
  (latexEnv := "lemma")]
lemma finite_gram_moore_penrose_family {Ω : Type*}
    [mΩ : MeasurableSpace Ω] {T d : ℕ}
    (ℱ : MeasureTheory.Filtration ℕ mΩ)
    (X : Fin T → Ω → Fin d → ℝ) (Y : Fin T → Ω → ℝ)
    (Vdagger : Ω → Matrix (Fin d) (Fin d) ℝ)
    (hX : predictable_covariates ℱ X)
    (hY : ∀ t : Fin T,
      @Measurable Ω ℝ (ℱ (t.val + 1)) inferInstance (Y t))
    (hV : ∀ ω,
      is_moore_penrose_inverse (empirical_gram X ω) (Vdagger ω)) :
    ∃ U : Fin (T + 1) → Ω → Matrix (Fin d) (Fin d) ℝ,
      (∀ n ω, is_moore_penrose_inverse
        (partial_empirical_gram X n ω) (U n ω)) ∧
      (∀ ω, U (Fin.last T) ω = Vdagger ω) ∧
      (∀ t : Fin T,
        @Measurable Ω ℝ (ℱ t.val) inferInstance
          (self_normalized_prediction X Y U t)) ∧
      (∀ t : Fin T,
        @Measurable Ω ℝ (ℱ t.val) inferInstance
          (self_normalized_leverage X U t)) ∧
      ∀ (t : Fin T) (ω : Ω),
        0 ≤ self_normalized_leverage X U t ω ∧
        self_normalized_leverage X U t ω ≤ 1 := by
  obtain ⟨U, hU, _, hUsucc⟩ := measurable_gram_moore_penrose ℱ X hX
  refine ⟨U, hU, ?_, ?_, ?_, prefix_gram_leverage_bounds X U hU⟩
  · intro ω
    apply local_moore_penrose_inverse_unique
    · simpa [partial_empirical_gram, empirical_gram] using
        hU (Fin.last T) ω
    · exact hV ω
  · intro t
    letI : MeasurableSpace Ω := ℱ t.val
    unfold self_normalized_prediction
    simp only [dotProduct, Matrix.mulVec, partial_cumulative_score,
      Finset.sum_apply, ite_apply, Pi.smul_apply, Pi.zero_apply, smul_eq_mul]
    apply Finset.measurable_sum
    intro i hi
    apply ((hX t).eval (a := i)).mul
    apply Finset.measurable_sum
    intro j hj
    apply (hUsucc t i j).mul
    apply Finset.measurable_sum
    intro s hs
    by_cases hst : s.val < t.castSucc.val
    · simp only [if_pos hst]
      have hXs : @Measurable Ω (Fin d → ℝ) (ℱ t.val) inferInstance (X s) :=
        (hX s).mono (ℱ.mono (Nat.le_of_lt hst)) le_rfl
      have hst' : s.val + 1 ≤ t.val := by
        simpa using hst
      have hYs : @Measurable Ω ℝ (ℱ t.val) inferInstance (Y s) :=
        (hY s).mono (ℱ.mono hst') le_rfl
      exact hYs.mul (hXs.eval (a := j))
    · simp only [if_neg hst]
      exact measurable_const
  · intro t
    letI : MeasurableSpace Ω := ℱ t.val
    change Measurable (fun ω => ∑ i, X t ω i *
      ∑ j, U t.succ ω i j * X t ω j)
    apply Finset.measurable_sum
    intro i hi
    apply ((hX t).eval (a := i)).mul
    apply Finset.measurable_sum
    intro j hj
    exact (hUsucc t i j).mul ((hX t).eval (a := j))

@[blueprint "lem:self-normalized-moore-penrose-inverse-unique"
  (statement := /-- For every (d\in\mathbb N) and all matrices
  (A,B,C\in\mathbb R^{d\times d}), if both (B) and (C) are
  Moore--Penrose inverses of (A), then (B=C). -/)
  (proof := /-- Expand the four defining identities from
  \cref{def:is-moore-penrose-inverse}.  The products (BA) and (CA) are
  self-adjoint and satisfy ((BA)(CA)=BA) and ((CA)(BA)=CA).  Taking the
  adjoint of the first equality and comparing it with the second gives
  (BA=CA).  The same argument applied to the self-adjoint products
  (AB) and (AC) gives (AB=AC).  Finally,
  (B=BAB=CAB=CAC=C). -/)
  (title := /-- Uniqueness of the Moore--Penrose inverse -/)
  (latexEnv := "lemma")]
lemma self_normalized_moore_penrose_inverse_unique {d : ℕ}
    {A B C : Matrix (Fin d) (Fin d) ℝ}
    (hB : is_moore_penrose_inverse A B)
    (hC : is_moore_penrose_inverse A C) : B = C := by
  rcases hB with ⟨hABA, hBAB, hAB, hBA⟩
  rcases hC with ⟨hACA, hCAC, hAC, hCA⟩
  have hBACABA : (B * A) * (C * A) = B * A := by
    calc
      (B * A) * (C * A) = B * (A * C * A) := by simp only [mul_assoc]
      _ = B * A := by rw [hACA]
  have hCABACA : (C * A) * (B * A) = C * A := by
    calc
      (C * A) * (B * A) = C * (A * B * A) := by simp only [mul_assoc]
      _ = C * A := by rw [hABA]
  have hBAeqCA : B * A = C * A := by
    have ht := congrArg Matrix.conjTranspose hBACABA
    have ht' : (C * A) * (B * A) = B * A := by
      simpa only [Matrix.conjTranspose_mul, hCA, hBA] using ht
    exact ht'.symm.trans hCABACA
  have hABAC : (A * B) * (A * C) = A * C := by
    calc
      (A * B) * (A * C) = (A * B * A) * C := by simp only [mul_assoc]
      _ = A * C := by rw [hABA]
  have hACAB : (A * C) * (A * B) = A * B := by
    calc
      (A * C) * (A * B) = (A * C * A) * B := by simp only [mul_assoc]
      _ = A * B := by rw [hACA]
  have hABeqAC : A * B = A * C := by
    have ht := congrArg Matrix.conjTranspose hABAC
    have ht' : (A * C) * (A * B) = A * C := by
      simpa only [Matrix.conjTranspose_mul, hAC, hAB] using ht
    exact hACAB.symm.trans ht'
  calc
    B = B * A * B := hBAB.symm
    _ = C * A * B := by rw [hBAeqCA]
    _ = C * (A * B) := by simp only [mul_assoc]
    _ = C * (A * C) := by rw [hABeqAC]
    _ = C * A * C := by simp only [mul_assoc]
    _ = C := hCAC

@[blueprint "lem:self-normalized-moore-penrose-inverse-self-adjoint"
  (statement := /-- For every (d\in\mathbb N) and all matrices
  (A,B\in\mathbb R^{d\times d}), if (A) is self-adjoint and (B) is a
  Moore--Penrose inverse of (A), then (B) is self-adjoint. -/)
  (proof := /-- Taking adjoints in the four identities from
  \cref{def:is-moore-penrose-inverse} shows that (B^{\mathsf T}) is
  another Moore--Penrose inverse of (A), because (A^{\mathsf T}=A).
  The uniqueness result
  \cref{lem:self-normalized-moore-penrose-inverse-unique} therefore
  gives (B^{\mathsf T}=B). -/)
  (title := /-- Self-adjointness of a Moore--Penrose inverse -/)
  (latexEnv := "lemma")]
lemma self_normalized_moore_penrose_inverse_self_adjoint {d : ℕ}
    {A B : Matrix (Fin d) (Fin d) ℝ}
    (hA : Matrix.conjTranspose A = A)
    (hB : is_moore_penrose_inverse A B) : Matrix.conjTranspose B = B := by
  apply Eq.symm
  apply self_normalized_moore_penrose_inverse_unique hB
  rcases hB with ⟨hABA, hBAB, hAB, hBA⟩
  have hABstar : A * Matrix.conjTranspose B = B * A := by
    calc
      A * Matrix.conjTranspose B = Matrix.conjTranspose (B * A) := by
        simp only [Matrix.conjTranspose_mul, hA]
      _ = B * A := hBA
  have hBAstar : Matrix.conjTranspose B * A = A * B := by
    calc
      Matrix.conjTranspose B * A = Matrix.conjTranspose (A * B) := by
        simp only [Matrix.conjTranspose_mul, hA]
      _ = A * B := hAB
  refine ⟨?_, ?_, ?_, ?_⟩
  · have ht := congrArg Matrix.conjTranspose hABA
    simpa only [Matrix.conjTranspose_mul,
      Matrix.conjTranspose_conjTranspose, hA, mul_assoc] using ht
  · have ht := congrArg Matrix.conjTranspose hBAB
    simpa only [Matrix.conjTranspose_mul,
      Matrix.conjTranspose_conjTranspose, hA, mul_assoc] using ht
  · simpa only [Matrix.conjTranspose_mul,
      Matrix.conjTranspose_conjTranspose, hA] using hABstar.symm
  · simpa only [Matrix.conjTranspose_mul,
      Matrix.conjTranspose_conjTranspose, hA] using hBAstar.symm

@[blueprint "lem:self-normalized-gram-projection-fixes-generator"
  (statement := /-- Let (z_i\in\mathbb R^d) be a finite family, set
  (A=\sum_i z_i z_i^{\mathsf T}), and let (B) be a Moore--Penrose
  inverse of (A).  Then the orthogonal projector (AB) fixes every
  generator: ((AB)z_i=z_i) for every (i). -/)
  (proof := /-- By the defining identities in
  \cref{def:is-moore-penrose-inverse}, (P=AB) is a self-adjoint
  idempotent satisfying (PA=AP=A).  For (e=z_i-Pz_i), these identities
  give (Pe=0) and (Ae=0).  Expanding (e^{\mathsf T}Ae) as
  (\sum_j(z_j^{\mathsf T}e)^2) shows that
  (z_i^{\mathsf T}e=0).  Self-adjointness of (P) also gives
  (e^{\mathsf T}Pz_i=0), and hence (e^{\mathsf T}e=0).  Therefore
  (e=0), which is the asserted projector identity. -/)
  (title := /-- A Gram projector fixes its generators -/)
  (latexEnv := "lemma")]
lemma self_normalized_gram_projection_fixes_generator
    {ι : Type*} [Fintype ι] {d : ℕ}
    (z : ι → Fin d → ℝ) (B : Matrix (Fin d) (Fin d) ℝ)
    (hB : is_moore_penrose_inverse
      (∑ j, Matrix.vecMulVec (z j) (z j)) B) (i : ι) :
    Matrix.mulVec ((∑ j, Matrix.vecMulVec (z j) (z j)) * B) (z i) = z i := by
  classical
  let A : Matrix (Fin d) (Fin d) ℝ :=
    ∑ j, Matrix.vecMulVec (z j) (z j)
  let P : Matrix (Fin d) (Fin d) ℝ := A * B
  have hA : Matrix.conjTranspose A = A := by
    ext k l
    simp only [A, Matrix.conjTranspose_apply, star_trivial,
      Matrix.sum_apply, Matrix.vecMulVec_apply]
    apply Finset.sum_congr rfl
    intro j hj
    ring
  rcases hB with ⟨hABA, hBAB, hP, hBA⟩
  have hP' : Matrix.conjTranspose P = P := by
    simpa only [P, A] using hP
  have hPA : P * A = A := by
    simpa only [P, mul_assoc] using hABA
  have hAP : A * P = A := by
    have ht := congrArg Matrix.conjTranspose hPA
    simpa only [Matrix.conjTranspose_mul, hA, hP'] using ht
  have hPP : P * P = P := by
    calc
      P * P = (A * B * A) * B := by simp only [P, mul_assoc]
      _ = A * B := by rw [hABA]
      _ = P := rfl
  let e : Fin d → ℝ := z i - Matrix.mulVec P (z i)
  have hPe : Matrix.mulVec P e = 0 := by
    simp only [e, Matrix.mulVec_sub, Matrix.mulVec_mulVec, hPP, sub_self]
  have hAe : Matrix.mulVec A e = 0 := by
    simp only [e, Matrix.mulVec_sub, Matrix.mulVec_mulVec, hAP, sub_self]
  have houter (j : ι) :
      Matrix.mulVec (Matrix.vecMulVec (z j) (z j)) e =
        (dotProduct (z j) e) • z j := by
    ext k
    simp only [Matrix.mulVec, Matrix.vecMulVec_apply, dotProduct,
      Pi.smul_apply, smul_eq_mul]
    simp only [mul_assoc]
    rw [← Finset.mul_sum]
    ring
  have hAsum : Matrix.mulVec A e = ∑ j, (dotProduct (z j) e) • z j := by
    simp only [A, Matrix.sum_mulVec, houter]
  have hsum : ∑ j, (dotProduct (z j) e) ^ 2 = 0 := by
    calc
      ∑ j, (dotProduct (z j) e) ^ 2 = dotProduct e (Matrix.mulVec A e) := by
        rw [hAsum]
        simp only [dotProduct_sum, dotProduct_smul, dotProduct_comm]
        congr 1
        funext j
        ring
      _ = 0 := by rw [hAe, dotProduct_zero]
  have hi : dotProduct (z i) e = 0 := by
    have hall : (fun j => (dotProduct (z j) e) ^ 2) = 0 :=
      (Fintype.sum_eq_zero_iff_of_nonneg
        (fun j => sq_nonneg (dotProduct (z j) e))).mp hsum
    have hi2 : (dotProduct (z i) e) ^ 2 = 0 := by
      simpa using congrFun hall i
    nlinarith
  have hPT : P.transpose = P := by
    ext k l
    change P l k = P k l
    simpa only [Matrix.conjTranspose_apply, star_trivial] using
      congrFun (congrFun hP' k) l
  have heP : dotProduct e (Matrix.mulVec P (z i)) = 0 := by
    calc
      dotProduct e (Matrix.mulVec P (z i)) =
          dotProduct e (Matrix.mulVec P.transpose (z i)) := by rw [hPT]
      _ = dotProduct (z i) (Matrix.mulVec P e) :=
        Matrix.dotProduct_transpose_mulVec P e (z i)
      _ = 0 := by rw [hPe, dotProduct_zero]
  have hee : dotProduct e e = 0 := by
    calc
      dotProduct e e = dotProduct e (z i - Matrix.mulVec P (z i)) := rfl
      _ = dotProduct e (z i) - dotProduct e (Matrix.mulVec P (z i)) :=
        dotProduct_sub _ _ _
      _ = 0 := by rw [dotProduct_comm e (z i), hi, heP, sub_self]
  have he : e = 0 := dotProduct_self_eq_zero.mp hee
  have hz : z i = Matrix.mulVec P (z i) := sub_eq_zero.mp he
  exact hz.symm

@[blueprint "lem:self-normalized-gram-quadratic-nonnegative"
  (statement := /-- For every finite family
  (z_i\in\mathbb R^d) and every (v\in\mathbb R^d),
  [
    0\leq v^{\mathsf T}\left(\sum_i z_i z_i^{\mathsf T}\right)v.
  ] -/)
  (proof := /-- Multiplication by each rank-one matrix gives
  ((z_i z_i^{\mathsf T})v=(z_i^{\mathsf T}v)z_i).  Distributing over
  the finite sum therefore identifies the displayed quadratic form
  with (\sum_i(z_i^{\mathsf T}v)^2), which is nonnegative term by term. -/)
  (title := /-- Nonnegativity of finite Gram quadratic forms -/)
  (latexEnv := "lemma")]
lemma self_normalized_gram_quadratic_nonnegative
    {ι : Type*} [Fintype ι] {d : ℕ}
    (z : ι → Fin d → ℝ) (v : Fin d → ℝ) :
    0 ≤ dotProduct v
      (Matrix.mulVec (∑ j, Matrix.vecMulVec (z j) (z j)) v) := by
  classical
  have houter (j : ι) :
      Matrix.mulVec (Matrix.vecMulVec (z j) (z j)) v =
        (dotProduct (z j) v) • z j := by
    ext k
    simp only [Matrix.mulVec, Matrix.vecMulVec_apply, dotProduct,
      Pi.smul_apply, smul_eq_mul, mul_assoc]
    rw [← Finset.mul_sum]
    ring
  rw [Matrix.sum_mulVec]
  simp_rw [houter]
  simp only [dotProduct_sum, dotProduct_smul, dotProduct_comm, smul_eq_mul]
  have hs : 0 ≤ ∑ j, (dotProduct (z j) v) ^ 2 :=
    Finset.sum_nonneg fun j hj => sq_nonneg (dotProduct (z j) v)
  rw [show (∑ j, dotProduct v (z j) * dotProduct v (z j)) =
      ∑ j, (dotProduct (z j) v) ^ 2 by
    apply Finset.sum_congr rfl
    intro j hj
    rw [dotProduct_comm v (z j)]
    ring]
  exact hs

@[blueprint "lem:self-normalized-rank-one-energy-step"
  (statement := /-- Let (A=\sum_i z_i z_i^{\mathsf T}) and
  (D=A+xx^{\mathsf T}), let (B) and (C) be Moore--Penrose inverses of
  (A) and (D), respectively, and suppose that both projectors (AB) and
  (DC) fix (s).  Then, for every (y\in\mathbb R),
  [
    \lVert s+yx\rVert_C^2-\lVert s\rVert_B^2
      \leq 2y\,x^{\mathsf T}Cs-(x^{\mathsf T}Cs)^2
        +y^2x^{\mathsf T}Cx.
  ] -/)
  (proof := /-- Put (w=Bs), (r=Cs), and (p=x^{\mathsf T}r).  The
  projector assumptions give (Aw=s) and (Dr=s).  By
  \cref{lem:self-normalized-gram-quadratic-nonnegative},
  ((w-r)^{\mathsf T}A(w-r)\geq0); expanding this inequality and using
  (D=A+xx^{\mathsf T}) yields
  (\lVert s\rVert_B^2\geq\lVert s\rVert_C^2+p^2).
  By \cref{lem:self-normalized-moore-penrose-inverse-self-adjoint},
  (C) is self-adjoint.  Expanding
  (\lVert s+yx\rVert_C^2) and substituting the preceding bound proves
  the stated one-step inequality. -/)
  (title := /-- Rank-one self-normalized energy step -/)
  (latexEnv := "lemma")]
lemma self_normalized_rank_one_energy_step
    {ι : Type*} [Fintype ι] {d : ℕ}
    (z : ι → Fin d → ℝ) (x s : Fin d → ℝ) (y : ℝ)
    (B C : Matrix (Fin d) (Fin d) ℝ)
    (hB : is_moore_penrose_inverse
      (∑ j, Matrix.vecMulVec (z j) (z j)) B)
    (hC : is_moore_penrose_inverse
      ((∑ j, Matrix.vecMulVec (z j) (z j)) +
        Matrix.vecMulVec x x) C)
    (hBs : Matrix.mulVec
      ((∑ j, Matrix.vecMulVec (z j) (z j)) * B) s = s)
    (hCs : Matrix.mulVec
      (((∑ j, Matrix.vecMulVec (z j) (z j)) +
        Matrix.vecMulVec x x) * C) s = s) :
    self_normalized_energy (s + y • x) C - self_normalized_energy s B ≤
      2 * dotProduct x (Matrix.mulVec C s) * y -
        (dotProduct x (Matrix.mulVec C s)) ^ 2 +
        self_normalized_energy x C * y ^ 2 := by
  classical
  let A : Matrix (Fin d) (Fin d) ℝ :=
    ∑ j, Matrix.vecMulVec (z j) (z j)
  let D : Matrix (Fin d) (Fin d) ℝ := A + Matrix.vecMulVec x x
  let w : Fin d → ℝ := Matrix.mulVec B s
  let r : Fin d → ℝ := Matrix.mulVec C s
  let p : ℝ := dotProduct x r
  have hA : Matrix.conjTranspose A = A := by
    ext k l
    simp only [A, Matrix.conjTranspose_apply, star_trivial,
      Matrix.sum_apply, Matrix.vecMulVec_apply]
    apply Finset.sum_congr rfl
    intro j hj
    ring
  have hD : Matrix.conjTranspose D = D := by
    ext k l
    simp only [D, A, Matrix.conjTranspose_apply, star_trivial,
      Matrix.add_apply, Matrix.sum_apply, Matrix.vecMulVec_apply]
    congr 1
    · apply Finset.sum_congr rfl
      intro j hj
      ring
    · ring
  have hCT : Matrix.conjTranspose C = C :=
    self_normalized_moore_penrose_inverse_self_adjoint hD hC
  have hAT : A.transpose = A := by
    ext k l
    change A l k = A k l
    simpa only [Matrix.conjTranspose_apply, star_trivial] using
      congrFun (congrFun hA k) l
  have hCT' : C.transpose = C := by
    ext k l
    change C l k = C k l
    simpa only [Matrix.conjTranspose_apply, star_trivial] using
      congrFun (congrFun hCT k) l
  have hAw : Matrix.mulVec A w = s := by
    simpa only [A, w, Matrix.mulVec_mulVec] using hBs
  have hDr : Matrix.mulVec D r = s := by
    simpa only [D, A, r, Matrix.mulVec_mulVec] using hCs
  have hcrossA :
      dotProduct w (Matrix.mulVec A r) = dotProduct r s := by
    calc
      dotProduct w (Matrix.mulVec A r) =
          dotProduct w (Matrix.mulVec A.transpose r) := by rw [hAT]
      _ = dotProduct r (Matrix.mulVec A w) :=
        Matrix.dotProduct_transpose_mulVec A w r
      _ = dotProduct r s := by rw [hAw]
  have henergyB :
      self_normalized_energy s B = dotProduct w s := by
    calc
      self_normalized_energy s B = dotProduct s w := rfl
      _ = dotProduct w s := dotProduct_comm s w
  have hnonneg :
      0 ≤ dotProduct (w - r) (Matrix.mulVec A (w - r)) := by
    exact self_normalized_gram_quadratic_nonnegative z (w - r)
  have hexpand :
      dotProduct (w - r) (Matrix.mulVec A (w - r)) =
        self_normalized_energy s B - 2 * dotProduct r s +
          dotProduct r (Matrix.mulVec A r) := by
    rw [Matrix.mulVec_sub, sub_dotProduct, dotProduct_sub]
    rw [hcrossA, hAw, dotProduct_sub, ← henergyB]
    ring
  have hvariational :
      2 * dotProduct r s - dotProduct r (Matrix.mulVec A r) ≤
        self_normalized_energy s B := by
    nlinarith [hnonneg]
  have houter : Matrix.mulVec (Matrix.vecMulVec x x) r = p • x := by
    ext k
    simp only [Matrix.mulVec, Matrix.vecMulVec_apply, dotProduct, p,
      Pi.smul_apply, smul_eq_mul, mul_assoc]
    rw [← Finset.mul_sum]
    ring
  have hdecompose :
      dotProduct r s = dotProduct r (Matrix.mulVec A r) + p ^ 2 := by
    calc
      dotProduct r s = dotProduct r (Matrix.mulVec D r) := by rw [hDr]
      _ = dotProduct r
          (Matrix.mulVec A r + Matrix.mulVec (Matrix.vecMulVec x x) r) := by
        simp only [D, Matrix.add_mulVec]
      _ = dotProduct r (Matrix.mulVec A r) + p ^ 2 := by
        rw [dotProduct_add, houter, dotProduct_smul, dotProduct_comm r x]
        simp only [p, smul_eq_mul]
        ring
  have henergyC : self_normalized_energy s C = dotProduct r s := by
    calc
      self_normalized_energy s C = dotProduct s r := rfl
      _ = dotProduct r s := dotProduct_comm s r
  have hbase :
      self_normalized_energy s C + p ^ 2 ≤ self_normalized_energy s B := by
    rw [henergyC]
    nlinarith [hvariational, hdecompose]
  have hcrossC : dotProduct s (Matrix.mulVec C x) = p := by
    calc
      dotProduct s (Matrix.mulVec C x) =
          dotProduct s (Matrix.mulVec C.transpose x) := by rw [hCT']
      _ = dotProduct x (Matrix.mulVec C s) :=
        Matrix.dotProduct_transpose_mulVec C s x
      _ = p := rfl
  have hupdate :
      self_normalized_energy (s + y • x) C =
        self_normalized_energy s C + 2 * y * p +
          y ^ 2 * self_normalized_energy x C := by
    unfold self_normalized_energy
    rw [Matrix.mulVec_add, Matrix.mulVec_smul]
    simp only [add_dotProduct, dotProduct_add, smul_dotProduct,
      dotProduct_smul, smul_eq_mul]
    rw [hcrossC]
    change _ = dotProduct s (Matrix.mulVec C s) + 2 * y * p +
      y ^ 2 * dotProduct x (Matrix.mulVec C x)
    ring
  rw [hupdate]
  change self_normalized_energy s C + 2 * y * p +
      y ^ 2 * self_normalized_energy x C - self_normalized_energy s B ≤
    2 * p * y - p ^ 2 + self_normalized_energy x C * y ^ 2
  nlinarith [hbase]

@[blueprint "lem:self-normalized-fin-telescope"
  (statement := /-- For every (T\in\mathbb N) and every function
  (E:\{0,\ldots,T\}\to\mathbb R),
  [
    \sum_{t=0}^{T-1}\bigl(E(t+1)-E(t)\bigr)=E(T)-E(0).
  ] -/)
  (proof := /-- Induct on (T).  The assertion is immediate for (T=0).
  For the successor step, split the sum into its first (T) terms and
  its last term.  The induction hypothesis reduces the first part to
  (E(T)-E(0)); adding (E(T+1)-E(T)) gives the stated difference. -/)
  (title := /-- Telescoping over finite indices -/)
  (latexEnv := "lemma")]
lemma self_normalized_fin_telescope {T : ℕ} (E : Fin (T + 1) → ℝ) :
    ∑ t : Fin T, (E t.succ - E t.castSucc) =
      E (Fin.last T) - E 0 := by
  induction T with
  | zero => simp
  | succ T ih =>
      rw [Fin.sum_univ_castSucc]
      simp_rw [Fin.succ_castSucc]
      rw [ih (fun n => E n.castSucc)]
      simp only [Fin.succ_last, Fin.castSucc_zero]
      ring

@[blueprint "lem:self-normalized-partial-gram-succ"
  (statement := /-- For every round (t<T) and outcome (\omega), the
  consecutive prefix Gram matrices satisfy
  [
    V_{t+1}(\omega)=V_t(\omega)
      +X_t(\omega)X_t(\omega)^{\mathsf T}.
  ] -/)
  (proof := /-- Expand both prefix Gram matrices using
  \cref{def:partial-empirical-gram}.  In the sum for (V_{t+1}), the
  summands with index below (t) form (V_t), the summand with index (t)
  is (X_tX_t^{\mathsf T}), and every remaining summand is zero. -/)
  (title := /-- Successor identity for prefix Gram matrices -/)
  (latexEnv := "lemma")]
lemma self_normalized_partial_gram_succ {Ω : Type*} {T d : ℕ}
    (X : Fin T → Ω → Fin d → ℝ) (t : Fin T) (ω : Ω) :
    partial_empirical_gram X t.succ ω =
      partial_empirical_gram X t.castSucc ω +
        Matrix.vecMulVec (X t ω) (X t ω) := by
  classical
  ext k l
  simp only [partial_empirical_gram, Matrix.sum_apply,
    Matrix.add_apply, Matrix.vecMulVec_apply, Matrix.ite_apply,
    Matrix.zero_apply, Fin.val_succ, Fin.val_castSucc]
  let f : Fin T → ℝ := fun j => X j ω k * X j ω l
  change (∑ j, if j.val < t.val + 1 then f j else 0) =
    (∑ j, if j.val < t.val then f j else 0) + f t
  calc
    (∑ j, if j.val < t.val + 1 then f j else 0) =
        ∑ j, ((if j.val < t.val then f j else 0) +
          if j = t then f j else 0) := by
      apply Finset.sum_congr rfl
      intro j hj
      by_cases hjt : j = t
      · subst j
        simp
      · have hjval : j.val ≠ t.val := by
          intro hval
          apply hjt
          exact Fin.ext hval
        simp only [hjt, if_false, add_zero]
        by_cases hjlt : j.val < t.val
        · have hjsucc : j.val < t.val + 1 := by omega
          simp [hjlt, hjsucc]
        · have hjsucc : ¬j.val < t.val + 1 := by omega
          simp [hjlt, hjsucc]
    _ = (∑ j, if j.val < t.val then f j else 0) + f t := by
      rw [Finset.sum_add_distrib]
      simp

@[blueprint "lem:self-normalized-partial-score-succ"
  (statement := /-- For every round (t<T) and outcome (\omega), the
  consecutive prefix scores satisfy
  [
    S_{t+1}(\omega)=S_t(\omega)+Y_t(\omega)X_t(\omega).
  ] -/)
  (proof := /-- Expand both prefix scores using
  \cref{def:partial-cumulative-score}.  Splitting the successor-prefix
  sum at index (t) leaves the previous prefix sum and the single new
  summand (Y_tX_t). -/)
  (title := /-- Successor identity for prefix scores -/)
  (latexEnv := "lemma")]
lemma self_normalized_partial_score_succ {Ω : Type*} {T d : ℕ}
    (X : Fin T → Ω → Fin d → ℝ) (Y : Fin T → Ω → ℝ)
    (t : Fin T) (ω : Ω) :
    partial_cumulative_score X Y t.succ ω =
      partial_cumulative_score X Y t.castSucc ω + Y t ω • X t ω := by
  classical
  ext k
  simp only [partial_cumulative_score, Finset.sum_apply, Pi.add_apply,
    Pi.smul_apply, smul_eq_mul, Pi.zero_apply, ite_apply,
    Fin.val_succ, Fin.val_castSucc]
  let f : Fin T → ℝ := fun j => Y j ω * X j ω k
  change (∑ j, if j.val < t.val + 1 then f j else 0) =
    (∑ j, if j.val < t.val then f j else 0) + f t
  calc
    (∑ j, if j.val < t.val + 1 then f j else 0) =
        ∑ j, ((if j.val < t.val then f j else 0) +
          if j = t then f j else 0) := by
      apply Finset.sum_congr rfl
      intro j hj
      by_cases hjt : j = t
      · subst j
        simp
      · have hjval : j.val ≠ t.val := by
          intro hval
          apply hjt
          exact Fin.ext hval
        simp only [hjt, if_false, add_zero]
        by_cases hjlt : j.val < t.val
        · have hjsucc : j.val < t.val + 1 := by omega
          simp [hjlt, hjsucc]
        · have hjsucc : ¬j.val < t.val + 1 := by omega
          simp [hjlt, hjsucc]
    _ = (∑ j, if j.val < t.val then f j else 0) + f t := by
      rw [Finset.sum_add_distrib]
      simp

@[blueprint "lem:self-normalized-prefix-projector-fixes-earlier-score"
  (statement := /-- Let (0\leq m\leq n\leq T), let (B) be a
  Moore--Penrose inverse of the prefix Gram matrix (V_n), and let
  (S_m) be the prefix score through time (m).  Then
  [
    V_n B S_m=S_m.
  ] -/)
  (proof := /-- Write (V_n) as the Gram sum of the masked generators
  (z_j=\mathbf 1_{\{j<n\}}X_j).  By
  \cref{lem:self-normalized-gram-projection-fixes-generator}, the
  projector (V_nB) fixes every (z_j).  Each summand of (S_m) is either
  zero or a scalar multiple of some (z_j), since (m\leq n).
  Linearity and summation give (V_nBS_m=S_m). -/)
  (title := /-- Prefix Gram projectors fix earlier scores -/)
  (latexEnv := "lemma")]
lemma self_normalized_prefix_projector_fixes_earlier_score
    {Ω : Type*} {T d : ℕ}
    (X : Fin T → Ω → Fin d → ℝ) (Y : Fin T → Ω → ℝ)
    (m n : Fin (T + 1)) (ω : Ω) (hmn : m.val ≤ n.val)
    (B : Matrix (Fin d) (Fin d) ℝ)
    (hB : is_moore_penrose_inverse (partial_empirical_gram X n ω) B) :
    Matrix.mulVec (partial_empirical_gram X n ω * B)
      (partial_cumulative_score X Y m ω) =
        partial_cumulative_score X Y m ω := by
  classical
  let z : Fin T → Fin d → ℝ := fun j =>
    if j.val < n.val then X j ω else 0
  have hgram : partial_empirical_gram X n ω =
      ∑ j, Matrix.vecMulVec (z j) (z j) := by
    unfold partial_empirical_gram
    apply Finset.sum_congr rfl
    intro j hj
    by_cases hjn : j.val < n.val
    · simp [z, hjn]
    · simp [z, hjn]
  have hB' : is_moore_penrose_inverse
      (∑ j, Matrix.vecMulVec (z j) (z j)) B := by
    rw [← hgram]
    exact hB
  rw [hgram]
  unfold partial_cumulative_score
  rw [Matrix.mulVec_sum]
  apply Finset.sum_congr rfl
  intro j hj
  by_cases hjm : j.val < m.val
  · have hjn : j.val < n.val := lt_of_lt_of_le hjm hmn
    have hfix := self_normalized_gram_projection_fixes_generator z B hB' j
    have hscaled := congrArg (fun v => Y j ω • v) hfix
    simpa only [hjm, if_true, Matrix.mulVec_smul, z, hjn] using hscaled
  · simp [hjm, Matrix.mulVec_zero]

@[blueprint "lem:self-normalized-deterministic-decomposition"
  (statement := /-- For every type (\Omega), all (T,d\in\mathbb N),
  covariates (X_t:\Omega\to\mathbb R^d), responses
  (Y_t:\Omega\to\mathbb R), matrix families
  (U_n:\Omega\to\mathbb R^{d\times d}) for (0\leq n\leq T), and
  (V^\dagger:\Omega\to\mathbb R^{d\times d}), suppose that, for every
  (n) and (\omega), the matrix (U_n(\omega)) is a Moore--Penrose inverse
  of the prefix Gram matrix
  (V_n(\omega)=\sum_{t<n}X_t(\omega)X_t(\omega)^{\mathsf T}), and that
  (U_T(\omega)=V^\dagger(\omega)).  Then, for every (\omega\in\Omega),
  [
    \lVert S_T(\omega)\rVert_{V^\dagger(\omega)}^2
      \leq\sum_{t<T}\left(
        2\widehat Y_t(\omega)Y_t(\omega)
          -\widehat Y_t(\omega)^2+q_t(\omega)Y_t(\omega)^2\right),
  ]
  where (S_T), (\widehat Y_t), and (q_t) are defined in
  \cref{def:cumulative-score,def:self-normalized-prediction,
  def:self-normalized-leverage}. -/)
  (proof := /-- Fix (\omega).  For every (t<T),
  \cref{lem:self-normalized-prefix-projector-fixes-earlier-score}
  shows that both (V_tU_t) and (V_{t+1}U_{t+1}) fix (S_t).  The
  identities
  \cref{lem:self-normalized-partial-gram-succ,
  lem:self-normalized-partial-score-succ} give
  (V_{t+1}=V_t+X_tX_t^{\mathsf T}) and
  (S_{t+1}=S_t+Y_tX_t).  Hence
  \cref{lem:self-normalized-rank-one-energy-step} yields
  [
    S_{t+1}^{\mathsf T}U_{t+1}S_{t+1}
      -S_t^{\mathsf T}U_tS_t
      \leq2\widehat Y_tY_t-\widehat Y_t^2+q_tY_t^2.
  ]
  Summing over (t<T) and applying
  \cref{lem:self-normalized-fin-telescope} leaves the terminal energy
  minus the zero initial energy.  The definitions
  \cref{def:cumulative-score,def:self-normalized-prediction,
  def:self-normalized-leverage}, together with (U_T=V^\dagger), identify
  the terminal energy and every summand with the displayed quantities,
  proving the assertion. -/)
  (title := /-- Deterministic self-normalized decomposition -/)
  (latexEnv := "lemma")]
lemma self_normalized_deterministic_decomposition {Ω : Type*} {T d : ℕ}
    (X : Fin T → Ω → Fin d → ℝ) (Y : Fin T → Ω → ℝ)
    (U : Fin (T + 1) → Ω → Matrix (Fin d) (Fin d) ℝ)
    (Vdagger : Ω → Matrix (Fin d) (Fin d) ℝ)
    (hU : ∀ n ω, is_moore_penrose_inverse
      (partial_empirical_gram X n ω) (U n ω))
    (hterminal : ∀ ω, U (Fin.last T) ω = Vdagger ω) :
    ∀ ω,
      self_normalized_energy (cumulative_score X Y ω) (Vdagger ω) ≤
        ∑ t, (2 * self_normalized_prediction X Y U t ω * Y t ω -
          (self_normalized_prediction X Y U t ω) ^ 2 +
          self_normalized_leverage X U t ω * (Y t ω) ^ 2) := by
  classical
  intro ω
  let E : Fin (T + 1) → ℝ := fun n =>
    self_normalized_energy (partial_cumulative_score X Y n ω) (U n ω)
  have hstep (t : Fin T) :
      E t.succ - E t.castSucc ≤
        2 * self_normalized_prediction X Y U t ω * Y t ω -
          (self_normalized_prediction X Y U t ω) ^ 2 +
          self_normalized_leverage X U t ω * (Y t ω) ^ 2 := by
    let z : Fin T → Fin d → ℝ := fun j =>
      if j.val < t.val then X j ω else 0
    have hAeq : (∑ j, Matrix.vecMulVec (z j) (z j)) =
        partial_empirical_gram X t.castSucc ω := by
      unfold partial_empirical_gram
      apply Finset.sum_congr rfl
      intro j hj
      by_cases hjt : j.val < t.val
      · have hjt' : j < t := hjt
        simp [z, hjt']
      · have hjt' : ¬j < t := hjt
        simp [z, hjt']
    have hB' : is_moore_penrose_inverse
        (∑ j, Matrix.vecMulVec (z j) (z j)) (U t.castSucc ω) := by
      rw [hAeq]
      exact hU t.castSucc ω
    have hC' : is_moore_penrose_inverse
        ((∑ j, Matrix.vecMulVec (z j) (z j)) +
          Matrix.vecMulVec (X t ω) (X t ω)) (U t.succ ω) := by
      rw [hAeq, ← self_normalized_partial_gram_succ X t ω]
      exact hU t.succ ω
    have hBs0 := self_normalized_prefix_projector_fixes_earlier_score
      X Y t.castSucc t.castSucc ω (by rfl) (U t.castSucc ω)
        (hU t.castSucc ω)
    have hBs : Matrix.mulVec
        ((∑ j, Matrix.vecMulVec (z j) (z j)) * U t.castSucc ω)
          (partial_cumulative_score X Y t.castSucc ω) =
            partial_cumulative_score X Y t.castSucc ω := by
      rw [hAeq]
      exact hBs0
    have hCs0 := self_normalized_prefix_projector_fixes_earlier_score
      X Y t.castSucc t.succ ω (by
        change t.val ≤ t.val + 1
        omega) (U t.succ ω) (hU t.succ ω)
    have hCs : Matrix.mulVec
        (((∑ j, Matrix.vecMulVec (z j) (z j)) +
          Matrix.vecMulVec (X t ω) (X t ω)) * U t.succ ω)
          (partial_cumulative_score X Y t.castSucc ω) =
            partial_cumulative_score X Y t.castSucc ω := by
      rw [hAeq, ← self_normalized_partial_gram_succ X t ω]
      exact hCs0
    have hs := self_normalized_rank_one_energy_step z (X t ω)
      (partial_cumulative_score X Y t.castSucc ω) (Y t ω)
      (U t.castSucc ω) (U t.succ ω) hB' hC' hBs hCs
    rw [← self_normalized_partial_score_succ X Y t ω] at hs
    simpa only [E, self_normalized_prediction,
      self_normalized_leverage] using hs
  have hsum :
      (∑ t : Fin T, (E t.succ - E t.castSucc)) ≤
        ∑ t, (2 * self_normalized_prediction X Y U t ω * Y t ω -
          (self_normalized_prediction X Y U t ω) ^ 2 +
          self_normalized_leverage X U t ω * (Y t ω) ^ 2) :=
    Finset.sum_le_sum fun t ht => hstep t
  have hscore_terminal :
      partial_cumulative_score X Y (Fin.last T) ω =
        cumulative_score X Y ω := by
    ext k
    simp [partial_cumulative_score, cumulative_score, Fin.val_last]
  have hEzero : E 0 = 0 := by
    simp [E, partial_cumulative_score, self_normalized_energy,
      Matrix.mulVec, dotProduct]
  have hEterminal :
      E (Fin.last T) =
        self_normalized_energy (cumulative_score X Y ω) (Vdagger ω) := by
    dsimp only [E]
    rw [hscore_terminal, hterminal]
  rw [self_normalized_fin_telescope E, hEzero, sub_zero, hEterminal] at hsum
  exact hsum

@[blueprint "lem:predictable-subgaussian-linear-control"
  (statement := /-- Let ((\Omega,\mathcal A,\mu)) be a probability space,
  let (T\in\mathbb N), and let ((\mathcal F_n)_{n\geq0}) be a filtration
  on ((\Omega,\mathcal A)).  Suppose that ((Y_t)_{t<T}) is conditionally
  sub-Gaussian with parameter (\sigma>0) relative to this filtration.
  For every real process ((a_t)_{t<T}) such that (a_t) is
  (\mathcal F_t)-measurable for each (t<T), and every
  (\eta\in(0,1)), with (\mu)-probability at least (1-\eta),
  [
    \sum_{t<T}(2a_tY_t-a_t^2)
      \leq2\sigma^2\log(1/\eta).
  ] -/)
  (proof := /-- First suppose that every coefficient is a finite-valued
  predictable simple function.  By
  \cref{def:conditionally-subgaussian-noise}, decomposition over its
  finite range and conditioning at round (t) with parameter
  (a_t/\sigma^2) show that
  [
    \exp\!\left(\frac{2a_tY_t-a_t^2}{2\sigma^2}\right)
  ]
  has conditional expectation at most one.  The required exponential
  factors and their finite products are integrable.  Multiplying by the
  nonnegative product from the preceding rounds and iterating conditional
  expectation therefore bounds the expectation of the terminal product
  by one.

  For general predictable coefficients, approximate each coefficient
  pointwise by finite-valued measurable simple functions.  The associated
  terminal products converge pointwise to the desired exponential
  product, and Fatou's lemma preserves the upper bound one for its lower
  integral.  The product equals
  [
    \exp\!\left(\frac{\sum_{t<T}(2a_tY_t-a_t^2)}{2\sigma^2}\right).
  ]
  Markov's inequality at threshold (1/\eta) bounds the complementary
  event by (\eta); taking complements in the probability space gives the
  claimed lower bound. -/)
  (title := /-- Predictable linear sub-Gaussian control -/)
  (latexEnv := "lemma")]
lemma predictable_subgaussian_linear_control {Ω : Type*}
    [mΩ : MeasurableSpace Ω] {T : ℕ}
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
    (ℱ : MeasureTheory.Filtration ℕ mΩ) (Y : Fin T → Ω → ℝ)
    (a : Fin T → Ω → ℝ) (σ η : ℝ)
    (hσ : 0 < σ) (hη0 : 0 < η) (hη1 : η < 1)
    (hY : conditionally_subgaussian_noise μ ℱ Y σ)
    (ha : ∀ t : Fin T,
      @Measurable Ω ℝ (ℱ t.val) inferInstance (a t)) :
    μ {ω | ∑ t, (2 * a t ω * Y t ω - (a t ω) ^ 2) ≤
      2 * σ ^ 2 * Real.log (1 / η)} ≥ ENNReal.ofReal (1 - η) := by
  classical
  rcases hY with ⟨hYmeas, hYmgf⟩
  have h_simple_integrable (t : Fin T)
      (s : @MeasureTheory.SimpleFunc Ω (ℱ t.val) ℝ) (c : ℝ) :
      MeasureTheory.Integrable
        (fun ω => Real.exp
          (c * (2 * s ω * Y t ω - (s ω) ^ 2) / (2 * σ ^ 2))) μ := by
    rcases s with ⟨s, hsmeas, hsfinite⟩
    let g : ℝ → Ω → ℝ := fun r ω =>
      Real.exp (c * (2 * r * Y t ω - r ^ 2) / (2 * σ ^ 2))
    change MeasureTheory.Integrable (fun ω => g (s ω) ω) μ
    have hg (r : ℝ) : MeasureTheory.Integrable (g r) μ := by
      have heq : g r = fun ω =>
          Real.exp (-c * r ^ 2 / (2 * σ ^ 2)) *
            Real.exp ((c * r / σ ^ 2) * Y t ω) := by
        funext ω
        dsimp [g]
        rw [← Real.exp_add]
        congr 1
        field_simp [ne_of_gt hσ]
        ring
      rw [heq]
      exact (hYmgf t (c * r / σ ^ 2)).1.const_mul _
    let sr : Finset ℝ := hsfinite.toFinset
    have hmem (ω : Ω) : s ω ∈ sr :=
      hsfinite.mem_toFinset.mpr ⟨ω, rfl⟩
    have hdecomp :
        (fun ω => g (s ω) ω) =
          ∑ r ∈ sr, (s ⁻¹' {r}).indicator (g r) := by
      funext ω
      symm
      simp only [Finset.sum_apply, Set.indicator_apply]
      rw [Finset.sum_eq_single (s ω)]
      · simp
      · intro b hb hne
        simp [hne, Ne.symm hne]
      · simp [hmem]
    rw [hdecomp]
    exact MeasureTheory.integrable_finsetSum' _ (fun r hr =>
      (hg r).indicator ((ℱ.le t.val) _ (hsmeas r)))
  have h_simple_cond (t : Fin T)
      (s : @MeasureTheory.SimpleFunc Ω (ℱ t.val) ℝ) :
      MeasureTheory.condExp (m := ℱ t.val) μ
        (fun ω => Real.exp
          ((2 * s ω * Y t ω - (s ω) ^ 2) / (2 * σ ^ 2)))
        ≤ᵐ[μ] fun _ => 1 := by
    rcases s with ⟨s, hsmeas, hsfinite⟩
    let g : ℝ → Ω → ℝ := fun r ω =>
      Real.exp ((2 * r * Y t ω - r ^ 2) / (2 * σ ^ 2))
    change MeasureTheory.condExp (m := ℱ t.val) μ
        (fun ω => g (s ω) ω) ≤ᵐ[μ] fun _ => 1
    have hg (r : ℝ) : MeasureTheory.Integrable (g r) μ := by
      have heq : g r = fun ω =>
          Real.exp (-r ^ 2 / (2 * σ ^ 2)) *
            Real.exp ((r / σ ^ 2) * Y t ω) := by
        funext ω
        dsimp [g]
        rw [← Real.exp_add]
        congr 1
        field_simp [ne_of_gt hσ]
        ring
      rw [heq]
      exact (hYmgf t (r / σ ^ 2)).1.const_mul _
    have hgeq (r : ℝ) : g r = fun ω =>
        Real.exp (-r ^ 2 / (2 * σ ^ 2)) *
          Real.exp ((r / σ ^ 2) * Y t ω) := by
      funext ω
      dsimp [g]
      rw [← Real.exp_add]
      congr 1
      field_simp [ne_of_gt hσ]
      ring
    have hgcond (r : ℝ) :
        MeasureTheory.condExp (m := ℱ t.val) μ (g r)
          ≤ᵐ[μ] fun _ => 1 := by
      have hscale :
          MeasureTheory.condExp (m := ℱ t.val) μ (g r) =ᵐ[μ]
            fun ω => Real.exp (-r ^ 2 / (2 * σ ^ 2)) *
              MeasureTheory.condExp (m := ℱ t.val) μ
                (fun x => Real.exp ((r / σ ^ 2) * Y t x)) ω := by
        rw [hgeq]
        have hf :
            (fun x => Real.exp (-r ^ 2 / (2 * σ ^ 2)) *
              Real.exp ((r / σ ^ 2) * Y t x)) =
              Real.exp (-r ^ 2 / (2 * σ ^ 2)) •
                (fun x => Real.exp ((r / σ ^ 2) * Y t x)) := by
          funext x
          simp [Pi.smul_apply, smul_eq_mul]
        rw [hf]
        have hs := MeasureTheory.condExp_smul
          (μ := μ) (Real.exp (-r ^ 2 / (2 * σ ^ 2)))
          (fun x => Real.exp ((r / σ ^ 2) * Y t x)) (ℱ t.val)
        filter_upwards [hs] with ω hω
        simpa [Pi.smul_apply, smul_eq_mul] using hω
      filter_upwards [hscale, (hYmgf t (r / σ ^ 2)).2] with ω heq hle
      rw [heq]
      calc
        _ ≤ Real.exp (-r ^ 2 / (2 * σ ^ 2)) *
            Real.exp ((r / σ ^ 2) ^ 2 * σ ^ 2 / 2) :=
          mul_le_mul_of_nonneg_left hle (Real.exp_pos _).le
        _ = 1 := by
          rw [← Real.exp_add, ← Real.exp_zero]
          congr 1
          field_simp [ne_of_gt hσ]
          ring
    let sr : Finset ℝ := hsfinite.toFinset
    have hmem (ω : Ω) : s ω ∈ sr :=
      hsfinite.mem_toFinset.mpr ⟨ω, rfl⟩
    have hdecomp :
        (fun ω => g (s ω) ω) =
          ∑ r ∈ sr, (s ⁻¹' {r}).indicator (g r) := by
      funext ω
      symm
      simp only [Finset.sum_apply, Set.indicator_apply]
      rw [Finset.sum_eq_single (s ω)]
      · simp
      · intro b hb hne
        simp [hne, Ne.symm hne]
      · simp [hmem]
    have hsum :
        MeasureTheory.condExp (m := ℱ t.val) μ (fun ω => g (s ω) ω) =ᵐ[μ]
          ∑ r ∈ sr, MeasureTheory.condExp (m := ℱ t.val) μ
            ((s ⁻¹' {r}).indicator (g r)) := by
      rw [hdecomp]
      exact MeasureTheory.condExp_finsetSum
        (fun r hr => (hg r).indicator ((ℱ.le t.val) _ (hsmeas r)))
        (ℱ t.val)
    have hall : ∀ᵐ ω ∂μ, ∀ r ∈ sr,
        MeasureTheory.condExp (m := ℱ t.val) μ
          ((s ⁻¹' {r}).indicator (g r)) ω ≤
            (s ⁻¹' {r}).indicator (fun _ => (1 : ℝ)) ω := by
      rw [Filter.eventually_all_finset]
      intro r hr
      filter_upwards [
        MeasureTheory.condExp_indicator (hg r) (hsmeas r),
        hgcond r] with ω heq hle
      rw [heq]
      exact Set.indicator_le_indicator hle
    filter_upwards [hsum, hall] with ω heq hall
    rw [heq]
    simp only [Finset.sum_apply]
    calc
      _ ≤ ∑ r ∈ sr, (s ⁻¹' {r}).indicator (fun _ => (1 : ℝ)) ω :=
        Finset.sum_le_sum fun r hr => hall r hr
      _ = 1 := by
        simp only [Set.indicator_apply]
        rw [Finset.sum_eq_single (s ω)]
        · simp
        · intro b hb hne
          simp [hne, Ne.symm hne]
        · simp [hmem]
  let inc (s : (t : Fin T) → @MeasureTheory.SimpleFunc Ω (ℱ t.val) ℝ)
      (t : Fin T) (ω : Ω) :=
    Real.exp ((2 * s t ω * Y t ω - (s t ω) ^ 2) / (2 * σ ^ 2))
  have hinc_memLp (s : (t : Fin T) → @MeasureTheory.SimpleFunc Ω (ℱ t.val) ℝ)
      (t : Fin T) (k : ℕ) (hk : k ≠ 0) :
      MeasureTheory.MemLp (inc s t) (k : ENNReal) μ := by
    have hmeas : MeasureTheory.AEStronglyMeasurable (inc s t) μ := by
      simpa [inc] using (h_simple_integrable t (s t) 1).aestronglyMeasurable
    apply (MeasureTheory.integrable_norm_rpow_iff (p := (k : ENNReal))
      hmeas (by simp [hk]) (by simp)).mp
    convert h_simple_integrable t (s t) (k : ℝ) using 1
    funext ω
    simp only [inc, ENNReal.toReal_natCast, Real.norm_eq_abs,
      abs_of_pos (Real.exp_pos _), Real.rpow_natCast, ← Real.exp_nat_mul]
    congr 1
    ring
  have hprod_integrable
      (s : (t : Fin T) → @MeasureTheory.SimpleFunc Ω (ℱ t.val) ℝ)
      (S : Finset (Fin T)) :
      MeasureTheory.Integrable (fun ω => ∏ t ∈ S, inc s t ω) μ := by
    by_cases hS : S = ∅
    · simp [hS]
    have hcard : S.card ≠ 0 := Finset.card_ne_zero.mpr
      (Finset.nonempty_iff_ne_empty.mpr hS)
    have hp := MeasureTheory.MemLp.prod'
      (s := S) (f := fun t => inc s t)
      (p := fun _ => (S.card : ENNReal))
      (fun t _ => hinc_memLp s t S.card hcard)
    have hone :
        (∑ t ∈ S, ((S.card : ENNReal))⁻¹)⁻¹ = 1 := by
      rw [Finset.sum_const, nsmul_eq_mul]
      rw [ENNReal.mul_inv_cancel (by exact_mod_cast hcard) (by simp)]
      simp
    rw [hone] at hp
    exact MeasureTheory.memLp_one_iff_integrable.mp hp
  have hinc_meas
      (s : (t : Fin T) → @MeasureTheory.SimpleFunc Ω (ℱ t.val) ℝ)
      (t : Fin T) :
      @Measurable Ω ℝ (ℱ (t.val + 1)) inferInstance (inc s t) := by
    have hs0 : @Measurable Ω ℝ (ℱ t.val) inferInstance (s t) :=
      @MeasureTheory.SimpleFunc.measurable Ω ℝ (ℱ t.val) inferInstance (s t)
    have hs : @Measurable Ω ℝ (ℱ (t.val + 1)) inferInstance (s t) :=
      hs0.mono (ℱ.mono (Nat.le_succ t.val)) le_rfl
    have hy : @Measurable Ω ℝ (ℱ (t.val + 1)) inferInstance (Y t) := hYmeas t
    change @Measurable Ω ℝ (ℱ (t.val + 1)) inferInstance
      (fun ω => Real.exp ((2 * s t ω * Y t ω - (s t ω) ^ 2) /
        (2 * σ ^ 2)))
    exact (((hs.const_mul 2).mul hy).sub (hs.pow_const 2)).div_const
      (2 * σ ^ 2) |>.exp
  have hpref_meas
      (s : (t : Fin T) → @MeasureTheory.SimpleFunc Ω (ℱ t.val) ℝ)
      (n : ℕ) :
      @Measurable Ω ℝ (ℱ n) inferInstance
        (fun ω => ∏ t ∈ Finset.univ.filter (fun t : Fin T => t.val < n),
          inc s t ω) := by
    apply Finset.measurable_prod
    intro t ht
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at ht
    exact (hinc_meas s t).mono (ℱ.mono (Nat.succ_le_iff.mpr ht)) le_rfl
  let pref
      (s : (t : Fin T) → @MeasureTheory.SimpleFunc Ω (ℱ t.val) ℝ)
      (n : ℕ) (ω : Ω) :=
    ∏ t ∈ Finset.univ.filter (fun t : Fin T => t.val < n), inc s t ω
  have hpref_integrable
      (s : (t : Fin T) → @MeasureTheory.SimpleFunc Ω (ℱ t.val) ℝ)
      (n : ℕ) : MeasureTheory.Integrable (pref s n) μ := by
    exact hprod_integrable s
      (Finset.univ.filter (fun t : Fin T => t.val < n))
  have hpref_succ
      (s : (t : Fin T) → @MeasureTheory.SimpleFunc Ω (ℱ t.val) ℝ)
      (n : ℕ) (hn : n < T) :
      pref s (n + 1) =
        fun ω => pref s n ω * inc s ⟨n, hn⟩ ω := by
    funext ω
    simp only [pref]
    rw [show Finset.univ.filter (fun t : Fin T => t.val < n + 1) =
      insert ⟨n, hn⟩ (Finset.univ.filter (fun t : Fin T => t.val < n)) by
        ext t
        simp only [Finset.mem_filter, Finset.mem_univ, true_and,
          Finset.mem_insert]
        constructor
        · intro h
          by_cases hlt : t.val < n
          · exact Or.inr hlt
          · left
            apply Fin.ext
            simp
            omega
        · rintro (rfl | h)
          · simp
          · omega]
    rw [Finset.prod_insert]
    · ring
    · simp
  have hpref_step
      (s : (t : Fin T) → @MeasureTheory.SimpleFunc Ω (ℱ t.val) ℝ)
      (n : ℕ) (hn : n < T) :
      ∫ ω, pref s (n + 1) ω ∂μ ≤ ∫ ω, pref s n ω ∂μ := by
    let tn : Fin T := ⟨n, hn⟩
    have hinc_int : MeasureTheory.Integrable (inc s tn) μ := by
      simpa [inc] using h_simple_integrable tn (s tn) 1
    have hprod_int :
        MeasureTheory.Integrable (fun ω => pref s n ω * inc s tn ω) μ := by
      change MeasureTheory.Integrable
        (fun ω => pref s n ω * inc s ⟨n, hn⟩ ω) μ
      rw [← hpref_succ s n hn]
      exact hpref_integrable s (n + 1)
    have hpull :
        MeasureTheory.condExp (m := ℱ n) μ
            (fun ω => pref s n ω * inc s tn ω) =ᵐ[μ]
          fun ω => pref s n ω *
            MeasureTheory.condExp (m := ℱ n) μ (inc s tn) ω := by
      apply MeasureTheory.condExp_mul_of_stronglyMeasurable_left
      · simpa [pref] using (hpref_meas s n).stronglyMeasurable
      · exact hprod_int
      · exact hinc_int
    have hc :
        MeasureTheory.condExp (m := ℱ n) μ (inc s tn)
          ≤ᵐ[μ] fun _ => 1 := by
      simpa [tn, inc] using h_simple_cond tn (s tn)
    have hnonneg : ∀ ω, 0 ≤ pref s n ω := by
      intro ω
      simp only [pref]
      apply Finset.prod_nonneg
      intro t _
      exact (Real.exp_pos _).le
    have hle :
        MeasureTheory.condExp (m := ℱ n) μ
            (fun ω => pref s n ω * inc s tn ω)
          ≤ᵐ[μ] pref s n := by
      filter_upwards [hpull, hc] with ω heq hcond
      rw [heq]
      simpa using mul_le_mul_of_nonneg_left hcond (hnonneg ω)
    rw [hpref_succ s n hn]
    rw [← MeasureTheory.integral_condExp (μ := μ) (m := ℱ n)
      (f := fun ω => pref s n ω * inc s tn ω) (ℱ.le n)]
    exact MeasureTheory.integral_mono_ae MeasureTheory.integrable_condExp
      (hpref_integrable s n) hle
  have hsimple_integral
      (s : (t : Fin T) → @MeasureTheory.SimpleFunc Ω (ℱ t.val) ℝ) :
      ∫ ω, pref s T ω ∂μ ≤ 1 := by
    have hind : ∀ n : ℕ, n ≤ T → ∫ ω, pref s n ω ∂μ ≤ 1 := by
      intro n hn
      induction n with
      | zero =>
          simp [pref]
      | succ n ih =>
          exact (hpref_step s n (by omega)).trans (ih (by omega))
    exact hind T le_rfl
  let hstrong (t : Fin T) :
      @MeasureTheory.StronglyMeasurable Ω ℝ inferInstance (ℱ t.val) (a t) :=
    (ha t).stronglyMeasurable
  have happ (t : Fin T) (ω : Ω) :
      Filter.Tendsto (fun k => (hstrong t).approx k ω)
        Filter.atTop (nhds (a t ω)) := by
    exact (hstrong t).tendsto_approx ω
  let app (k : ℕ) :
      (t : Fin T) → @MeasureTheory.SimpleFunc Ω (ℱ t.val) ℝ :=
    fun t => (hstrong t).approx k
  have hinc_tendsto (t : Fin T) (ω : Ω) :
      Filter.Tendsto (fun k => inc (app k) t ω) Filter.atTop
        (nhds (Real.exp ((2 * a t ω * Y t ω - (a t ω) ^ 2) /
          (2 * σ ^ 2)))) := by
    dsimp [inc, app]
    apply Real.continuous_exp.continuousAt.tendsto.comp
    exact ((((happ t ω).const_mul 2).mul_const (Y t ω)).sub
      ((happ t ω).pow 2)).div_const (2 * σ ^ 2)
  let Z (ω : Ω) :=
    ∏ t : Fin T,
      Real.exp ((2 * a t ω * Y t ω - (a t ω) ^ 2) / (2 * σ ^ 2))
  have hZ_tendsto (ω : Ω) :
      Filter.Tendsto (fun k => pref (app k) T ω)
        Filter.atTop (nhds (Z ω)) := by
    have hp :
        Filter.Tendsto
          (fun k => ∏ t : Fin T, inc (app k) t ω) Filter.atTop
          (nhds (∏ t : Fin T,
            Real.exp ((2 * a t ω * Y t ω - (a t ω) ^ 2) /
              (2 * σ ^ 2)))) := by
      apply tendsto_finset_prod
      intro t _
      exact hinc_tendsto t ω
    simpa [pref, Z] using hp
  have hlin_app (k : ℕ) :
      (∫⁻ ω, ENNReal.ofReal (pref (app k) T ω) ∂μ) ≤ 1 := by
    rw [← MeasureTheory.ofReal_integral_eq_lintegral_ofReal
      (hpref_integrable (app k) T)
      (Filter.Eventually.of_forall (fun ω => by
        simp only [pref]
        apply Finset.prod_nonneg
        intro t ht
        exact (Real.exp_pos _).le))]
    exact ENNReal.ofReal_le_one.mpr (hsimple_integral (app k))
  have hliminf (ω : Ω) :
      Filter.liminf
        (fun k => ENNReal.ofReal (pref (app k) T ω)) Filter.atTop =
          ENNReal.ofReal (Z ω) := by
    apply Filter.Tendsto.liminf_eq
    exact ENNReal.continuous_ofReal.continuousAt.tendsto.comp (hZ_tendsto ω)
  have hlin_Z : (∫⁻ ω, ENNReal.ofReal (Z ω) ∂μ) ≤ 1 := by
    have hfat := MeasureTheory.lintegral_liminf_le (μ := μ)
      (u := Filter.atTop)
      (f := fun k ω => ENNReal.ofReal (pref (app k) T ω))
      (fun k =>
        ((hpref_meas (app k) T).mono (ℱ.le T) le_rfl).ennreal_ofReal)
    rw [show (fun ω => Filter.liminf
      (fun k => ENNReal.ofReal (pref (app k) T ω)) Filter.atTop) =
        fun ω => ENNReal.ofReal (Z ω) by
          funext ω
          exact hliminf ω] at hfat
    exact hfat.trans (by
      have hle : ∀ᶠ k in Filter.atTop,
          (∫⁻ ω, ENNReal.ofReal (pref (app k) T ω) ∂μ) ≤ 1 :=
        Filter.Eventually.of_forall hlin_app
      have hlim := Filter.liminf_le_liminf hle
        (hu := by isBoundedDefault)
        (hv := by isBoundedDefault)
      simpa using hlim)
  have hZ_meas : Measurable Z := by
    dsimp [Z]
    apply Finset.measurable_prod
    intro t ht
    have hat : Measurable (a t) :=
      (ha t).mono (ℱ.le t.val) le_rfl
    have hyt : Measurable (Y t) :=
      (hYmeas t).mono (ℱ.le (t.val + 1)) le_rfl
    exact ((((hat.const_mul 2).mul hyt).sub
      (hat.pow_const 2)).div_const (2 * σ ^ 2)).exp
  have hZ_eq (ω : Ω) :
      Z ω = Real.exp ((∑ t,
        (2 * a t ω * Y t ω - (a t ω) ^ 2)) / (2 * σ ^ 2)) := by
    simp only [Z, ← Real.exp_sum, Finset.sum_div]
  have hmarkov :
      μ {ω | ENNReal.ofReal (1 / η) ≤ ENNReal.ofReal (Z ω)} ≤
        ENNReal.ofReal η := by
    calc
      _ ≤ (∫⁻ ω, ENNReal.ofReal (Z ω) ∂μ) /
        ENNReal.ofReal (1 / η) :=
        MeasureTheory.meas_ge_le_lintegral_div
          hZ_meas.ennreal_ofReal.aemeasurable
          (by positivity) ENNReal.ofReal_ne_top
      _ ≤ 1 / ENNReal.ofReal (1 / η) :=
        ENNReal.div_le_div_right hlin_Z _
      _ = ENNReal.ofReal η := by
        rw [← ENNReal.ofReal_one]
        rw [← ENNReal.ofReal_div_of_pos (one_div_pos.mpr hη0)]
        congr 1
        field_simp [ne_of_gt hη0]
  let good : Set Ω := {ω | ∑ t,
    (2 * a t ω * Y t ω - (a t ω) ^ 2) ≤
      2 * σ ^ 2 * Real.log (1 / η)}
  have hgood_meas : MeasurableSet good := by
    have hsum : Measurable (fun ω => ∑ t,
        (2 * a t ω * Y t ω - (a t ω) ^ 2)) := by
      apply Finset.measurable_sum
      intro t ht
      have hat : Measurable (a t) :=
        (ha t).mono (ℱ.le t.val) le_rfl
      have hyt : Measurable (Y t) :=
        (hYmeas t).mono (ℱ.le (t.val + 1)) le_rfl
      exact ((hat.const_mul 2).mul hyt).sub (hat.pow_const 2)
    exact measurableSet_le hsum measurable_const
  have hbad : μ goodᶜ ≤ ENNReal.ofReal η := by
    calc
      _ ≤ μ {ω | ENNReal.ofReal (1 / η) ≤ ENNReal.ofReal (Z ω)} := by
        apply MeasureTheory.measure_mono
        intro ω hω
        simp only [good, Set.mem_compl_iff, Set.mem_setOf_eq] at hω ⊢
        apply ENNReal.ofReal_le_ofReal
        rw [hZ_eq]
        rw [← Real.exp_log (one_div_pos.mpr hη0)]
        apply Real.exp_le_exp.mpr
        apply le_of_lt
        apply (lt_div_iff₀ (by positivity : 0 < 2 * σ ^ 2)).mpr
        simpa [mul_comm] using lt_of_not_ge hω
      _ ≤ ENNReal.ofReal η := hmarkov
  change ENNReal.ofReal (1 - η) ≤ μ good
  have hgood_eq : μ good = 1 - μ goodᶜ := by
    simpa using MeasureTheory.measure_compl (μ := μ) hgood_meas.compl
      (MeasureTheory.measure_ne_top μ goodᶜ)
  calc
    ENNReal.ofReal (1 - η) = 1 - ENNReal.ofReal η := by
      rw [ENNReal.ofReal_sub 1 hη0.le, ENNReal.ofReal_one]
    _ ≤ 1 - μ goodᶜ := tsub_le_tsub_left hbad 1
    _ = μ good := hgood_eq.symm

@[blueprint "lem:predictable-subgaussian-quadratic-control"
  (statement := /-- Let ((\Omega,\mathcal A,\mu)) be a probability
  space, let (T\in\mathbb N), and let ((\mathcal F_n)_{n\geq0}) be a
  filtration.  Fix (\sigma>0), and let ((Y_t)_{t<T}) be a real-valued
  process that is conditionally sub-Gaussian with parameter (\sigma) in
  the sense of \cref{def:conditionally-subgaussian-noise}.  Let
  ((q_t)_{t<T}) be real-valued, with each (q_t) measurable with respect
  to (\mathcal F_t), and suppose that (0\leq q_t(\omega)\leq1) for every
  (t<T) and (\omega\in\Omega).  Then, for every (\eta\in(0,1)), with
  (\mu)-probability at least (1-\eta),
  [
    \sum_{t<T}q_tY_t^2
      \leq4\sigma^2\left(\sum_{t<T}q_t+\log(1/\eta)\right).
  ] -/)
  (proof := /-- Let (\gamma) denote the standard Gaussian measure on
  (\mathbb R).  Direct evaluation of its density gives
  [
    \int_{\mathbb R}\exp(g^2/4)\,\gamma(dg)=\sqrt2.
  ]
  For every finite measure (\nu) and every real random variable (X)
  satisfying
  [
    \int\exp(aX)\,d\nu
      \leq\nu(\Omega)\exp(a^2\sigma^2/2),\qquad a\in\mathbb R,
  ]
  Fubini's theorem and the Gaussian moment-generating function yield
  [
    \int\exp\!\left(\frac{X^2}{4\sigma^2}\right)d\nu
      \leq\sqrt2\,\nu(\Omega)\leq2\nu(\Omega).
  ]
  Indeed, integrate (\exp(gX/(\sqrt2\sigma))) first with respect to
  (\gamma) and then with respect to (\nu); reversing the order permits
  application of the assumed moment-generating-function bound.

  Fix (t<T).  Apply this estimate to the restriction of (\mu) to an
  arbitrary (\mathcal F_t)-measurable set.  The conditional
  moment-generating-function inequality in
  \cref{def:conditionally-subgaussian-noise} and the defining integral
  identity for conditional expectation verify the required hypothesis
  for every such restriction.  Characterization by integrals over
  (\mathcal F_t)-measurable sets therefore gives
  [
    \mathbb E_\mu\!\left[
      \exp\!\left(\frac{Y_t^2}{4\sigma^2}\right)
      \middle|\mathcal F_t\right]\leq2
    \quad\text{almost surely}.
  ]
  Put
  [
    Z_t=\exp\!\left(
      q_t\left(\frac{Y_t^2}{4\sigma^2}-1\right)\right).
  ]
  Convexity of the exponential function and (0\leq q_t\leq1) imply
  [
    Z_t\leq1-q_t+
      q_t e^{-1}\exp\!\left(\frac{Y_t^2}{4\sigma^2}\right).
  ]
  Since (q_t) is (\mathcal F_t)-measurable and (2e^{-1}\leq1), pulling
  the bounded factor (q_t) through conditional expectation proves
  (\mathbb E[Z_t\mid\mathcal F_t]\leq1) almost surely.

  Let (M_n=\prod_{t<n}Z_t).  Inductively, (M_n) is
  (\mathcal F_n)-measurable, integrable, nonnegative, and has expectation
  at most one.  To justify the induction without assuming a bounded
  (Z_n), replace it by (Z_n\wedge k), pull (M_n) through conditional
  expectation, and then let (k\to\infty); monotone convergence supplies
  both integrability of (M_nZ_n) and the expectation bound.  Thus
  [
    \mathbb E\exp\!\left(\sum_{t<T}
      q_t\left(\frac{Y_t^2}{4\sigma^2}-1\right)\right)\leq1.
  ]
  Markov's inequality shows that the exponent exceeds
  (\log(1/\eta)) with probability at most (\eta).  Multiplication by
  the positive number (4\sigma^2) and rearrangement give the asserted
  event and probability bound. -/)
  (title := /-- Predictable quadratic sub-Gaussian control -/)
  (latexEnv := "lemma")]
lemma predictable_subgaussian_quadratic_control {Ω : Type*}
    [mΩ : MeasurableSpace Ω] {T : ℕ}
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
    (ℱ : MeasureTheory.Filtration ℕ mΩ) (Y : Fin T → Ω → ℝ)
    (q : Fin T → Ω → ℝ) (σ η : ℝ)
    (hσ : 0 < σ) (hη0 : 0 < η) (hη1 : η < 1)
    (hY : conditionally_subgaussian_noise μ ℱ Y σ)
    (hqmeas : ∀ t : Fin T,
      @Measurable Ω ℝ (ℱ t.val) inferInstance (q t))
    (hq : ∀ (t : Fin T) (ω : Ω), 0 ≤ q t ω ∧ q t ω ≤ 1) :
    μ {ω | ∑ t, q t ω * (Y t ω) ^ 2 ≤
      4 * σ ^ 2 * (∑ t, q t ω) + 4 * σ ^ 2 * Real.log (1 / η)}
      ≥ ENNReal.ofReal (1 - η) := by
  have hgauss :
      (∫ g : ℝ, Real.exp (g ^ 2 / 4) ∂(ProbabilityTheory.gaussianReal 0 1)) =
        Real.sqrt 2 := by
    rw [ProbabilityTheory.integral_gaussianReal_eq_integral_smul
      (f := fun g : ℝ => Real.exp (g ^ 2 / 4)) (v := 1) one_ne_zero]
    simp only [smul_eq_mul, ProbabilityTheory.gaussianPDFReal_def, NNReal.coe_one,
      mul_one, sub_zero]
    calc
      (∫ x : ℝ, (Real.sqrt (2 * Real.pi))⁻¹ * Real.exp (-(x ^ 2) / 2) *
          Real.exp (x ^ 2 / 4)) =
          (Real.sqrt (2 * Real.pi))⁻¹ *
            ∫ x : ℝ, Real.exp (-(1 / 4 : ℝ) * x ^ 2) := by
        rw [← MeasureTheory.integral_const_mul]
        apply MeasureTheory.integral_congr_ae
        filter_upwards with x
        rw [mul_assoc, ← Real.exp_add]
        congr 2
        ring
      _ = Real.sqrt 2 := by
        rw [integral_gaussian]
        have hs : Real.sqrt (2 * Real.pi) ≠ 0 := by positivity
        rw [inv_mul_eq_div]
        apply (div_eq_iff hs).2
        rw [← Real.sqrt_mul (show (0 : ℝ) ≤ 2 by norm_num)]
        congr 1
        ring
  have hgaussInt : MeasureTheory.Integrable
      (fun g : ℝ => Real.exp (g ^ 2 / 4))
      (ProbabilityTheory.gaussianReal 0 1) := by
    rw [ProbabilityTheory.gaussianReal, if_neg one_ne_zero]
    rw [MeasureTheory.integrable_withDensity_iff
      (ProbabilityTheory.measurable_gaussianPDF 0 1)
      (Filter.Eventually.of_forall fun _ => ProbabilityTheory.gaussianPDF_lt_top)]
    simp only [ProbabilityTheory.gaussianPDF, ENNReal.toReal_ofReal
      (ProbabilityTheory.gaussianPDFReal_nonneg 0 1 _)]
    apply MeasureTheory.Integrable.congr
      ((integrable_exp_neg_mul_sq
        (show (0 : ℝ) < 1 / 4 by norm_num)).const_mul
          (Real.sqrt (2 * Real.pi))⁻¹)
    filter_upwards with x
    simp only [ProbabilityTheory.gaussianPDFReal_def, NNReal.coe_one, mul_one,
      sub_zero]
    rw [← mul_assoc,
      mul_comm (Real.exp (x ^ 2 / 4)) (Real.sqrt (2 * Real.pi))⁻¹,
      mul_assoc, ← Real.exp_add]
    congr 1
    ring_nf
  have hSquare : ∀ (ν : MeasureTheory.Measure Ω) [MeasureTheory.SFinite ν]
      (X : Ω → ℝ),
      Measurable X →
      (∀ a : ℝ, MeasureTheory.Integrable (fun ω => Real.exp (a * X ω)) ν) →
      (∀ a : ℝ, (∫ ω, Real.exp (a * X ω) ∂ν) ≤
        ν.real Set.univ * Real.exp (a ^ 2 * σ ^ 2 / 2)) →
      MeasureTheory.Integrable
          (fun ω => Real.exp (X ω ^ 2 / (4 * σ ^ 2))) ν ∧
        (∫ ω, Real.exp (X ω ^ 2 / (4 * σ ^ 2)) ∂ν) ≤
          2 * ν.real Set.univ := by
    intro ν _ X hXm hInt hMgf
    let γ := ProbabilityTheory.gaussianReal 0 1
    let F : ℝ → Ω → ℝ := fun g ω =>
      Real.exp ((g / (Real.sqrt 2 * σ)) * X ω)
    have hs2 : Real.sqrt 2 ≠ 0 := by positivity
    have hFmeas : MeasureTheory.AEStronglyMeasurable
        (Function.uncurry F) (γ.prod ν) := by
      apply Measurable.aestronglyMeasurable
      fun_prop
    have hbound : ∀ g : ℝ, (∫ ω, ‖F g ω‖ ∂ν) ≤
        ν.real Set.univ * Real.exp (g ^ 2 / 4) := by
      intro g
      simp only [F, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
      convert hMgf (g / (Real.sqrt 2 * σ)) using 1
      congr 2
      field_simp
      nlinarith [Real.sq_sqrt (show (0 : ℝ) ≤ 2 by norm_num), sq_nonneg σ]
    have hFint : MeasureTheory.Integrable
        (Function.uncurry F) (γ.prod ν) := by
      rw [MeasureTheory.integrable_prod_iff hFmeas]
      constructor
      · exact Filter.Eventually.of_forall fun g => by
          simpa [F] using hInt (g / (Real.sqrt 2 * σ))
      · refine (hgaussInt.const_mul (ν.real Set.univ)).mono' ?_ ?_
        · exact hFmeas.norm.integral_prod_right'
        · filter_upwards with g
          rw [Real.norm_eq_abs, abs_of_nonneg (MeasureTheory.integral_nonneg
            fun _ => norm_nonneg _)]
          exact hbound g
    have hinner : ∀ ω, (∫ g, F g ω ∂γ) =
        Real.exp (X ω ^ 2 / (4 * σ ^ 2)) := by
      intro ω
      have heq : (fun g => F g ω) =
          fun g => Real.exp ((X ω / (Real.sqrt 2 * σ)) * g) := by
        funext g
        simp only [F]
        congr 1
        field_simp
      rw [heq]
      change ProbabilityTheory.mgf id γ (X ω / (Real.sqrt 2 * σ)) =
        Real.exp (X ω ^ 2 / (4 * σ ^ 2))
      rw [show ProbabilityTheory.mgf id γ =
        fun t => Real.exp (0 * t + (1 : ℝ) * t ^ 2 / 2) by
          simpa [γ] using
            (ProbabilityTheory.mgf_id_gaussianReal (μ := 0) (v := 1))]
      simp only [zero_mul, one_mul, zero_add]
      congr 1
      field_simp
      nlinarith [Real.sq_sqrt (show (0 : ℝ) ≤ 2 by norm_num), sq_nonneg σ]
    have hsqInt : MeasureTheory.Integrable
        (fun ω => Real.exp (X ω ^ 2 / (4 * σ ^ 2))) ν := by
      refine (hFint.integral_prod_right).congr ?_
      filter_upwards with ω
      exact hinner ω
    refine ⟨hsqInt, ?_⟩
    calc
      (∫ ω, Real.exp (X ω ^ 2 / (4 * σ ^ 2)) ∂ν) =
          ∫ ω, ∫ g, F g ω ∂γ ∂ν := by
        apply MeasureTheory.integral_congr_ae
        exact Filter.Eventually.of_forall fun ω => (hinner ω).symm
      _ = ∫ g, ∫ ω, F g ω ∂ν ∂γ :=
        (MeasureTheory.integral_integral_swap hFint).symm
      _ ≤ ∫ g, ν.real Set.univ * Real.exp (g ^ 2 / 4) ∂γ := by
        apply MeasureTheory.integral_mono_ae
        · exact hFint.integral_prod_left
        · exact hgaussInt.const_mul _
        · filter_upwards with g
          simpa [F] using hbound g
      _ = ν.real Set.univ * Real.sqrt 2 := by
        rw [MeasureTheory.integral_const_mul, hgauss]
      _ ≤ 2 * ν.real Set.univ := by
        have hsqrt : Real.sqrt 2 ≤ 2 := by
          nlinarith [Real.sq_sqrt (show (0 : ℝ) ≤ 2 by norm_num)]
        calc
          ν.real Set.univ * Real.sqrt 2 ≤ ν.real Set.univ * 2 :=
            mul_le_mul_of_nonneg_left hsqrt MeasureTheory.measureReal_nonneg
          _ = 2 * ν.real Set.univ := by ring
  have hCondSquare : ∀ t : Fin T,
      MeasureTheory.Integrable
          (fun ω => Real.exp ((Y t ω) ^ 2 / (4 * σ ^ 2))) μ ∧
        MeasureTheory.condExp (m := ℱ t.val) μ
            (fun ω => Real.exp ((Y t ω) ^ 2 / (4 * σ ^ 2)))
          ≤ᵐ[μ] fun _ => (2 : ℝ) := by
    intro t
    have hYm : Measurable (Y t) :=
      (hY.1 t).mono (ℱ.le (t.val + 1)) le_rfl
    have hMgfUniv : ∀ a : ℝ,
        (∫ ω, Real.exp (a * Y t ω) ∂μ) ≤
          μ.real Set.univ * Real.exp (a ^ 2 * σ ^ 2 / 2) := by
      intro a
      calc
        (∫ ω, Real.exp (a * Y t ω) ∂μ) =
            ∫ ω, MeasureTheory.condExp (m := ℱ t.val) μ
              (fun z => Real.exp (a * Y t z)) ω ∂μ :=
          (MeasureTheory.integral_condExp (ℱ.le t.val)).symm
        _ ≤ ∫ _ : Ω, Real.exp (a ^ 2 * σ ^ 2 / 2) ∂μ := by
          apply MeasureTheory.integral_mono_ae
          · exact MeasureTheory.integrable_condExp
          · exact MeasureTheory.integrable_const _
          · exact (hY.2 t a).2
        _ = μ.real Set.univ * Real.exp (a ^ 2 * σ ^ 2 / 2) := by
          simp [mul_comm]
    have hsquare := hSquare μ (Y t) hYm (fun a => (hY.2 t a).1) hMgfUniv
    refine ⟨hsquare.1, ?_⟩
    apply MeasureTheory.ae_le_of_ae_le_trim
      (hm := ℱ.le t.val)
    apply MeasureTheory.ae_le_of_forall_setIntegral_le
      (MeasureTheory.integrable_condExp.trim (ℱ.le t.val)
        MeasureTheory.stronglyMeasurable_condExp)
      ((MeasureTheory.integrable_const (2 : ℝ)).trim (ℱ.le t.val)
        measurable_const.stronglyMeasurable)
    intro s hs _
    rw [← MeasureTheory.setIntegral_trim (ℱ.le t.val)
      MeasureTheory.stronglyMeasurable_condExp hs]
    rw [← MeasureTheory.setIntegral_trim (ℱ.le t.val)
      measurable_const.stronglyMeasurable hs]
    rw [MeasureTheory.setIntegral_condExp (ℱ.le t.val) hsquare.1 hs]
    have hMgfSet : ∀ a : ℝ,
        (∫ ω, Real.exp (a * Y t ω) ∂(μ.restrict s)) ≤
          (μ.restrict s).real Set.univ *
            Real.exp (a ^ 2 * σ ^ 2 / 2) := by
      intro a
      calc
        (∫ ω, Real.exp (a * Y t ω) ∂(μ.restrict s)) =
            ∫ ω in s, Real.exp (a * Y t ω) ∂μ := rfl
        _ = ∫ ω in s, MeasureTheory.condExp (m := ℱ t.val) μ
            (fun z => Real.exp (a * Y t z)) ω ∂μ :=
          (MeasureTheory.setIntegral_condExp (ℱ.le t.val)
            (hY.2 t a).1 hs).symm
        _ ≤ ∫ _ in s, Real.exp (a ^ 2 * σ ^ 2 / 2) ∂μ := by
          apply MeasureTheory.integral_mono_ae
          · exact MeasureTheory.integrable_condExp.mono_measure
              MeasureTheory.Measure.restrict_le_self
          · exact (MeasureTheory.integrable_const _).mono_measure
              MeasureTheory.Measure.restrict_le_self
          · exact MeasureTheory.ae_restrict_of_ae (hY.2 t a).2
        _ = (μ.restrict s).real Set.univ *
            Real.exp (a ^ 2 * σ ^ 2 / 2) := by
          simp [MeasureTheory.Measure.restrict_apply, hs, mul_comm]
    have hsquareSet := hSquare (μ.restrict s) (Y t) hYm
      (fun a => (hY.2 t a).1.restrict) hMgfSet
    calc
      (∫ ω in s, Real.exp ((Y t ω) ^ 2 / (4 * σ ^ 2)) ∂μ) =
          ∫ ω, Real.exp ((Y t ω) ^ 2 / (4 * σ ^ 2))
            ∂(μ.restrict s) := rfl
      _ ≤ 2 * (μ.restrict s).real Set.univ := hsquareSet.2
      _ = ∫ _ in s, (2 : ℝ) ∂μ := by
        simp [MeasureTheory.Measure.restrict_apply, hs]
        ring
  let Z : Fin T → Ω → ℝ := fun t ω =>
    Real.exp (q t ω * ((Y t ω) ^ 2 / (4 * σ ^ 2) - 1))
  have hZ : ∀ t : Fin T,
      MeasureTheory.Integrable (Z t) μ ∧
        MeasureTheory.condExp (m := ℱ t.val) μ (Z t)
          ≤ᵐ[μ] fun _ => (1 : ℝ) := by
    intro t
    let R : Ω → ℝ := Real.exp (-1) •
      fun ω => Real.exp ((Y t ω) ^ 2 / (4 * σ ^ 2))
    let B : Ω → ℝ := fun ω => 1 - q t ω + q t ω * R ω
    have hqsm := (hqmeas t).stronglyMeasurable
    have hqm : Measurable (q t) :=
      (hqmeas t).mono (ℱ.le t.val) le_rfl
    have hYm : Measurable (Y t) :=
      (hY.1 t).mono (ℱ.le (t.val + 1)) le_rfl
    have hqbnd : ∀ᵐ ω ∂μ, ‖q t ω‖ ≤ (1 : ℝ) :=
      Filter.Eventually.of_forall fun ω => by
        rw [Real.norm_eq_abs, abs_of_nonneg (hq t ω).1]
        exact (hq t ω).2
    have hqInt : MeasureTheory.Integrable (q t) μ := by
      simpa using ((MeasureTheory.integrable_const (1 : ℝ)).bdd_mul
        hqm.aestronglyMeasurable hqbnd)
    have hRInt : MeasureTheory.Integrable R μ := by
      refine ((hCondSquare t).1.const_mul (Real.exp (-1))).congr ?_
      filter_upwards with ω
      rfl
    have hqRInt : MeasureTheory.Integrable (fun ω => q t ω * R ω) μ :=
      hRInt.bdd_mul hqm.aestronglyMeasurable hqbnd
    have hBInt : MeasureTheory.Integrable B μ := by
      exact ((MeasureTheory.integrable_const (1 : ℝ)).sub hqInt).add hqRInt
    have hconv : ∀ ω, Z t ω ≤ B ω := by
      intro ω
      have hc := convexOn_exp.2 (Set.mem_univ (0 : ℝ))
        (Set.mem_univ ((Y t ω) ^ 2 / (4 * σ ^ 2) - 1))
        (sub_nonneg.mpr (hq t ω).2) (hq t ω).1 (by ring)
      simpa [Z, B, R, Real.exp_sub, div_eq_mul_inv, Real.exp_neg,
        Pi.smul_apply, smul_eq_mul, mul_assoc, mul_comm, mul_left_comm] using hc
    have hBnonneg : ∀ ω, 0 ≤ B ω := by
      intro ω
      dsimp [B, R]
      have hq0 := (hq t ω).1
      have hq1 := (hq t ω).2
      positivity
    have hZmeas : Measurable (Z t) := by
      dsimp [Z]
      exact Real.continuous_exp.measurable.comp
        (hqm.mul (((hYm.pow_const 2).div measurable_const).sub measurable_const))
    have hZInt : MeasureTheory.Integrable (Z t) μ := by
      refine hBInt.mono' hZmeas.aestronglyMeasurable ?_
      exact Filter.Eventually.of_forall fun ω => by
        rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
        exact hconv ω
    refine ⟨hZInt, ?_⟩
    have hmono := MeasureTheory.condExp_mono hZInt hBInt
      (Filter.Eventually.of_forall hconv) (m := ℱ t.val)
    have hRcond :
        MeasureTheory.condExp (m := ℱ t.val) μ R
          ≤ᵐ[μ] fun _ => Real.exp (-1) * 2 := by
      have hsmul := MeasureTheory.condExp_smul
        (μ := μ) (Real.exp (-1))
        (fun ω => Real.exp ((Y t ω) ^ 2 / (4 * σ ^ 2))) (ℱ t.val)
      filter_upwards [hsmul, (hCondSquare t).2] with ω heq hle
      change MeasureTheory.condExp (m := ℱ t.val) μ R ω ≤
        Real.exp (-1) * 2
      have heq' : MeasureTheory.condExp (m := ℱ t.val) μ R ω =
          Real.exp (-1) * MeasureTheory.condExp (m := ℱ t.val) μ
            (fun z => Real.exp ((Y t z) ^ 2 / (4 * σ ^ 2))) ω := by
        simpa [R, smul_eq_mul] using heq
      rw [heq']
      exact mul_le_mul_of_nonneg_left hle (Real.exp_pos _).le
    have hqRcond := MeasureTheory.condExp_stronglyMeasurable_mul_of_bound
      (μ := μ) (ℱ.le t.val) hqsm hRInt 1 hqbnd
    have hleftm : @Measurable Ω ℝ (ℱ t.val) inferInstance
        (fun ω => 1 - q t ω) := by
      exact (show @Measurable Ω ℝ (ℱ t.val) inferInstance
        (fun _ => (1 : ℝ)) from measurable_const).sub (hqmeas t)
    have hleftsm := hleftm.stronglyMeasurable
    have hleftInt : MeasureTheory.Integrable (fun ω => 1 - q t ω) μ :=
      (MeasureTheory.integrable_const (1 : ℝ)).sub hqInt
    have hBcond : MeasureTheory.condExp (m := ℱ t.val) μ B
        ≤ᵐ[μ] fun _ => (1 : ℝ) := by
      have hadd := MeasureTheory.condExp_add hleftInt hqRInt (ℱ t.val)
      have hleft := MeasureTheory.condExp_of_stronglyMeasurable
        (μ := μ) (ℱ.le t.val) hleftsm hleftInt
      filter_upwards [hadd, hqRcond, hRcond] with ω hadd hqR hR
      change MeasureTheory.condExp (m := ℱ t.val) μ B ω ≤ 1
      change MeasureTheory.condExp (m := ℱ t.val) μ
        ((fun z => 1 - q t z) + fun z => q t z * R z) ω ≤ 1
      rw [hadd, hleft]
      change 1 - q t ω +
        MeasureTheory.condExp (m := ℱ t.val) μ (q t * R) ω ≤ 1
      rw [hqR]
      have hq0 := (hq t ω).1
      have hq1 := (hq t ω).2
      have he : Real.exp (-1) * 2 ≤ 1 := by
        nlinarith [Real.exp_neg_one_lt_half]
      dsimp only [Pi.add_apply, Pi.sub_apply, Pi.one_apply, Pi.mul_apply]
      calc
        1 - q t ω + q t ω *
            MeasureTheory.condExp (m := ℱ t.val) μ R ω
            ≤ 1 - q t ω + q t ω * (Real.exp (-1) * 2) := by
          gcongr
        _ ≤ 1 := by nlinarith
    exact hmono.trans hBcond
  have hMulStep : ∀ (m : MeasurableSpace Ω) (P W : Ω → ℝ),
      m ≤ mΩ →
      @Measurable Ω ℝ m inferInstance P →
      MeasureTheory.Integrable P μ →
      (∀ ω, 0 ≤ P ω) →
      @Measurable Ω ℝ mΩ inferInstance W →
      MeasureTheory.Integrable W μ →
      (∀ ω, 0 ≤ W ω) →
      (MeasureTheory.condExp (m := m) μ W ≤ᵐ[μ] fun _ => (1 : ℝ)) →
      MeasureTheory.Integrable (fun ω => P ω * W ω) μ ∧
        (∫ ω, P ω * W ω ∂μ) ≤ ∫ ω, P ω ∂μ := by
    intro m P W hm hPm hPInt hPnonneg hWm hWInt hWnonneg hWcond
    let Wn : ℕ → Ω → ℝ := fun n ω => min (W ω) n
    have hWnMeas : ∀ n, @Measurable Ω ℝ mΩ inferInstance (Wn n) :=
      fun n => by
      dsimp [Wn]
      fun_prop
    have hWnNonneg : ∀ n ω, 0 ≤ Wn n ω := fun n ω => by
      dsimp [Wn]
      exact le_min (hWnonneg ω) (Nat.cast_nonneg n)
    have hWnInt : ∀ n, MeasureTheory.Integrable (Wn n) μ := by
      intro n
      refine hWInt.mono' (hWnMeas n).aestronglyMeasurable ?_
      exact Filter.Eventually.of_forall fun ω => by
        rw [Real.norm_eq_abs, abs_of_nonneg (hWnNonneg n ω)]
        exact min_le_left (W ω) (n : ℝ)
    have hWnBound : ∀ n, ∀ᵐ ω ∂μ, ‖Wn n ω‖ ≤ (n : ℝ) := fun n =>
      Filter.Eventually.of_forall fun ω => by
        rw [Real.norm_eq_abs, abs_of_nonneg (hWnNonneg n ω)]
        exact min_le_right _ _
    have hPWnInt : ∀ n,
        MeasureTheory.Integrable (fun ω => P ω * Wn n ω) μ := fun n =>
      hPInt.mul_bdd (hWnMeas n).aestronglyMeasurable (hWnBound n)
    have hIntBound : ∀ n,
        (∫ ω, P ω * Wn n ω ∂μ) ≤ ∫ ω, P ω ∂μ := by
      intro n
      have hWnCond :
          MeasureTheory.condExp (m := m) μ (Wn n) ≤ᵐ[μ] fun _ => (1 : ℝ) := by
        have hm := MeasureTheory.condExp_mono (hWnInt n) hWInt
          (Filter.Eventually.of_forall fun ω => min_le_left _ _) (m := m)
        exact hm.trans hWcond
      have hpull := MeasureTheory.condExp_mul_of_stronglyMeasurable_left
        (μ := μ) hPm.stronglyMeasurable (hPWnInt n) (hWnInt n)
      have hPCInt : MeasureTheory.Integrable
          (fun ω => P ω *
            MeasureTheory.condExp (m := m) μ (Wn n) ω) μ := by
        exact MeasureTheory.integrable_condExp.congr hpull
      calc
        (∫ ω, P ω * Wn n ω ∂μ) =
            ∫ ω, MeasureTheory.condExp (m := m) μ
              (fun z => P z * Wn n z) ω ∂μ :=
          (MeasureTheory.integral_condExp hm).symm
        _ = ∫ ω, P ω *
            MeasureTheory.condExp (m := m) μ (Wn n) ω ∂μ :=
          MeasureTheory.integral_congr_ae hpull
        _ ≤ ∫ ω, P ω ∂μ := by
          apply MeasureTheory.integral_mono_ae hPCInt hPInt
          filter_upwards [hWnCond] with ω hw
          exact mul_le_of_le_one_right (hPnonneg ω) hw
    let f : ℕ → Ω → ENNReal := fun n ω =>
      ENNReal.ofReal (P ω * Wn n ω)
    let F : Ω → ENNReal := fun ω => ENNReal.ofReal (P ω * W ω)
    have hfMeas : ∀ n, @Measurable Ω ENNReal mΩ inferInstance (f n) :=
      fun n => by
      dsimp [f]
      fun_prop
    have hfMono : ∀ ω, Monotone fun n => f n ω := by
      intro ω i j hij
      dsimp [f, Wn]
      apply ENNReal.ofReal_le_ofReal
      apply mul_le_mul_of_nonneg_left _ (hPnonneg ω)
      apply min_le_min_left
      exact_mod_cast hij
    have hfTendsto : ∀ ω, Filter.Tendsto (fun n => f n ω)
        Filter.atTop (nhds (F ω)) := by
      intro ω
      obtain ⟨N, hN⟩ := exists_nat_ge (W ω)
      apply tendsto_const_nhds.congr'
      filter_upwards [Filter.eventually_ge_atTop N] with n hn
      dsimp [f, F, Wn]
      rw [min_eq_left]
      exact hN.trans (by exact_mod_cast hn)
    have hlinTendsto := MeasureTheory.lintegral_tendsto_of_tendsto_of_monotone
      (μ := μ) (fun n => (hfMeas n).aemeasurable)
      (Filter.Eventually.of_forall hfMono)
      (Filter.Eventually.of_forall hfTendsto)
    have hlinBound : (∫⁻ ω, F ω ∂μ) ≤
        ENNReal.ofReal (∫ ω, P ω ∂μ) := by
      apply le_of_tendsto' hlinTendsto
      intro n
      rw [← MeasureTheory.ofReal_integral_eq_lintegral_ofReal
        (hPWnInt n) (Filter.Eventually.of_forall fun ω =>
          mul_nonneg (hPnonneg ω) (hWnNonneg n ω))]
      exact ENNReal.ofReal_le_ofReal (hIntBound n)
    have hPWMeas : @Measurable Ω ℝ mΩ inferInstance
        (fun ω => P ω * W ω) :=
      (hPm.mono hm le_rfl).mul hWm
    have hPWNonneg : ∀ᵐ ω ∂μ, 0 ≤ P ω * W ω :=
      Filter.Eventually.of_forall fun ω => mul_nonneg (hPnonneg ω) (hWnonneg ω)
    have hPWInt : MeasureTheory.Integrable (fun ω => P ω * W ω) μ := by
      rw [← MeasureTheory.lintegral_ofReal_ne_top_iff_integrable
        hPWMeas.aestronglyMeasurable hPWNonneg]
      exact ne_top_of_le_ne_top ENNReal.ofReal_ne_top hlinBound
    refine ⟨hPWInt, ?_⟩
    rw [← ENNReal.ofReal_le_ofReal_iff
      (MeasureTheory.integral_nonneg (show 0 ≤ P from hPnonneg))]
    rw [MeasureTheory.ofReal_integral_eq_lintegral_ofReal hPWInt hPWNonneg]
    exact hlinBound
  have hZadapt : ∀ t : Fin T,
      @Measurable Ω ℝ (ℱ (t.val + 1)) inferInstance (Z t) := by
    intro t
    have hqm := (hqmeas t).mono (ℱ.mono (Nat.le_succ t.val)) le_rfl
    have hYm := hY.1 t
    dsimp [Z]
    exact Real.continuous_exp.measurable.comp
      (hqm.mul (((hYm.pow_const 2).div measurable_const).sub measurable_const))
  let P : ℕ → Ω → ℝ := fun n ω =>
    ∏ t ∈ Finset.univ.filter (fun t : Fin T => t.val < n), Z t ω
  have hPmeas : ∀ n,
      @Measurable Ω ℝ (ℱ n) inferInstance (P n) := by
    intro n
    dsimp [P]
    apply Finset.measurable_fun_prod
    intro t ht
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at ht
    exact (hZadapt t).mono (ℱ.mono (Nat.succ_le_of_lt ht)) le_rfl
  have hPnonneg : ∀ n ω, 0 ≤ P n ω := by
    intro n ω
    dsimp [P]
    positivity
  have hPsucc : ∀ n (hn : n < T),
      P (n + 1) = fun ω => P n ω * Z ⟨n, hn⟩ ω := by
    intro n hn
    funext ω
    dsimp [P]
    have hfilter : Finset.univ.filter (fun t : Fin T => t.val < n + 1) =
        insert (⟨n, hn⟩ : Fin T)
          (Finset.univ.filter (fun t : Fin T => t.val < n)) := by
      ext t
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_insert]
      constructor
      · intro ht
        by_cases heq : t.val = n
        · left
          apply Fin.ext
          exact heq
        · right
          omega
      · rintro (rfl | ht)
        · change n < n + 1
          omega
        · omega
    rw [hfilter, Finset.prod_insert]
    · simpa [mul_comm]
    · simp
  have hPInt : ∀ n, n ≤ T →
      MeasureTheory.Integrable (P n) μ ∧ (∫ ω, P n ω ∂μ) ≤ 1 := by
    intro n hn
    induction n with
    | zero =>
        simp [P]
    | succ n ih =>
        have hnlt : n < T := by omega
        have hprev := ih (by omega)
        let t : Fin T := ⟨n, hnlt⟩
        have hstep := hMulStep (ℱ n) (P n) (Z t) (ℱ.le n)
          (hPmeas n) hprev.1 (hPnonneg n)
          ((hZadapt t).mono (ℱ.le (t.val + 1)) le_rfl)
          (hZ t).1 (fun ω => (Real.exp_pos _).le) (hZ t).2
        have heq := hPsucc n hnlt
        constructor
        · exact hstep.1.congr (Filter.Eventually.of_forall fun ω => by
            rw [heq])
        · calc
            (∫ ω, P (n + 1) ω ∂μ) =
                ∫ ω, P n ω * Z t ω ∂μ := by rw [heq]
            _ ≤ ∫ ω, P n ω ∂μ := hstep.2
            _ ≤ 1 := hprev.2
  have hPT := hPInt T le_rfl
  have hprod : P T = fun ω => ∏ t : Fin T, Z t ω := by
    funext ω
    simp [P]
  have hExpInt : MeasureTheory.Integrable
      (fun ω => Real.exp (∑ t : Fin T,
        q t ω * ((Y t ω) ^ 2 / (4 * σ ^ 2) - 1))) μ := by
    refine hPT.1.congr (Filter.Eventually.of_forall fun ω => ?_)
    rw [hprod]
    simp [Z, Real.exp_sum]
  have hExpBound :
      (∫ ω, Real.exp (∑ t : Fin T,
        q t ω * ((Y t ω) ^ 2 / (4 * σ ^ 2) - 1)) ∂μ) ≤ 1 := by
    calc
      (∫ ω, Real.exp (∑ t : Fin T,
          q t ω * ((Y t ω) ^ 2 / (4 * σ ^ 2) - 1)) ∂μ) =
          ∫ ω, P T ω ∂μ := by
        apply MeasureTheory.integral_congr_ae
        exact Filter.Eventually.of_forall fun ω => by
          rw [hprod]
          simp [Z, Real.exp_sum]
      _ ≤ 1 := hPT.2
  let S : Ω → ℝ := fun ω => ∑ t : Fin T,
    q t ω * ((Y t ω) ^ 2 / (4 * σ ^ 2) - 1)
  let A : Set Ω := {ω | 1 / η ≤ Real.exp (S ω)}
  have hSm : Measurable S := by
    dsimp [S]
    apply Finset.measurable_fun_sum
    intro t _
    have hqm := (hqmeas t).mono (ℱ.le t.val) le_rfl
    have hYm := (hY.1 t).mono (ℱ.le (t.val + 1)) le_rfl
    exact hqm.mul (((hYm.pow_const 2).div measurable_const).sub measurable_const)
  have hAmeas : MeasurableSet A := by
    dsimp [A]
    exact measurableSet_le measurable_const
      (Real.continuous_exp.measurable.comp hSm)
  have hmarkov : (1 / η) * μ.real A ≤ 1 := by
    have hm := MeasureTheory.mul_meas_ge_le_integral_of_nonneg
      (μ := μ) (Filter.Eventually.of_forall fun ω =>
        (Real.exp_pos (S ω)).le) hExpInt (1 / η)
    have hm' : (1 / η) * μ.real A ≤
        ∫ ω, Real.exp (S ω) ∂μ := by
      simpa [A, S] using hm
    exact hm'.trans (by simpa [S] using hExpBound)
  have hA_le : μ.real A ≤ η := by
    have hinv : (1 / η) * η = 1 := by field_simp
    nlinarith
  have hsubset : Aᶜ ⊆ {ω | ∑ t, q t ω * (Y t ω) ^ 2 ≤
      4 * σ ^ 2 * (∑ t, q t ω) +
        4 * σ ^ 2 * Real.log (1 / η)} := by
    intro ω hω
    have hexp : Real.exp (S ω) < 1 / η := by
      simpa [A] using hω
    have hpos : 0 < 1 / η := by positivity
    have hSlt : S ω < Real.log (1 / η) :=
      (Real.lt_log_iff_exp_lt hpos).2 hexp
    have hscale : 0 < 4 * σ ^ 2 := by positivity
    have hid : (4 * σ ^ 2) * S ω =
        (∑ t, q t ω * (Y t ω) ^ 2) -
          4 * σ ^ 2 * (∑ t, q t ω) := by
      dsimp [S]
      rw [Finset.mul_sum]
      calc
        (∑ t, 4 * σ ^ 2 *
            (q t ω * ((Y t ω) ^ 2 / (4 * σ ^ 2) - 1))) =
            ∑ t, (q t ω * (Y t ω) ^ 2 -
              4 * σ ^ 2 * q t ω) := by
          apply Finset.sum_congr rfl
          intro t _
          field_simp
        _ = (∑ t, q t ω * (Y t ω) ^ 2) -
            4 * σ ^ 2 * (∑ t, q t ω) := by
          rw [Finset.sum_sub_distrib, Finset.mul_sum]
    have hscaled := mul_lt_mul_of_pos_left hSlt hscale
    rw [hid] at hscaled
    change (∑ t, q t ω * (Y t ω) ^ 2) ≤
      4 * σ ^ 2 * (∑ t, q t ω) +
        4 * σ ^ 2 * Real.log (1 / η)
    nlinarith
  apply (ENNReal.ofReal_le_iff_le_toReal (MeasureTheory.measure_ne_top μ _)).2
  change 1 - η ≤ μ.real {ω | ∑ t, q t ω * (Y t ω) ^ 2 ≤
    4 * σ ^ 2 * (∑ t, q t ω) + 4 * σ ^ 2 * Real.log (1 / η)}
  calc
    1 - η ≤ 1 - μ.real A := by linarith
    _ = μ.real Aᶜ := (MeasureTheory.probReal_compl_eq_one_sub hAmeas).symm
    _ ≤ μ.real {ω | ∑ t, q t ω * (Y t ω) ^ 2 ≤
        4 * σ ^ 2 * (∑ t, q t ω) +
          4 * σ ^ 2 * Real.log (1 / η)} :=
      MeasureTheory.measureReal_mono hsubset

@[blueprint "lem:dominated-kernel-residual-decomposition"
  (statement := /-- Let ((P_t)_{t<T}) be a measurable family of
  probability kernels on (\mathbb R^d), let (\mu_0) be a probability
  measure, and suppose that
  (P_t(\omega,\cdot)\leq C_{\mathrm{cov}}\mu_0) for every
  (t,\omega), where (C_{\mathrm{cov}}\geq1).  Then there is a
  measurable family of probability kernels ((R_t)_{t<T}) such that
  [
    \mu_0=C_{\mathrm{cov}}^{-1}P_t(\omega,\cdot)
      +(1-C_{\mathrm{cov}}^{-1})R_t(\omega,\cdot)
  ]
  for every (t) and (\omega). -/)
  (proof := /-- Write (C=C_{\mathrm{cov}}).  If (C=1), the domination
  in \cref{def:smooth-covariates}, together with equality of the total
  masses, gives (P_t(\omega,\cdot)=\mu_0); taking
  (R_t(\omega,\cdot)=\mu_0) proves the assertion.  Suppose now that
  (C>1).  For every measurable set (A), define
  [
    R_t(\omega,A)
      =\frac{C\mu_0(A)-P_t(\omega,A)}{C-1}.
  ]
  Domination makes the numerator nonnegative.  Since both terms are
  finite measures and the difference is nonnegative on every
  measurable set, countable additivity follows by subtracting the two
  countably additive identities.  The total mass is
  ((C-1)/(C-1)=1).  For fixed (A), measurability in (\omega) follows
  from the kernel measurability of
  (\omega\mapsto P_t(\omega,A)); hence (R_t) is a probability
  kernel.  Rearranging its defining identity yields the claimed
  decomposition. -/)
  (title := /-- Measurable residual decomposition of dominated kernels -/)
  (latexEnv := "lemma")]
lemma dominated_kernel_residual_decomposition :
    ∀ (T d : ℕ) (Ω : Type*) [mΩ : MeasurableSpace Ω]
      (ℋx : MeasureTheory.Filtration ℕ mΩ)
      (P : (t : Fin T) → @ProbabilityTheory.Kernel Ω (Fin d → ℝ)
        (ℋx t.val) inferInstance)
      (μ0 : MeasureTheory.Measure (Fin d → ℝ)) (Ccov : ℝ),
      (∀ t ω, MeasureTheory.IsProbabilityMeasure (P t ω)) →
      MeasureTheory.IsProbabilityMeasure μ0 →
      1 ≤ Ccov →
      smooth_covariates ℋx P μ0 Ccov →
      ∃ R : (t : Fin T) → @ProbabilityTheory.Kernel Ω (Fin d → ℝ)
          (ℋx t.val) inferInstance,
        (∀ t ω, MeasureTheory.IsProbabilityMeasure (R t ω)) ∧
        ∀ t ω, μ0 =
          ENNReal.ofReal (Ccov⁻¹) • P t ω +
          ENNReal.ofReal (1 - Ccov⁻¹) • R t ω := by
  intro T d Ω mΩ ℋx P μ0 Ccov hP hμ0 hCcov hdom
  have hCcov_pos : 0 < Ccov := lt_of_lt_of_le zero_lt_one hCcov
  by_cases hCcov_one : Ccov = 1
  · subst Ccov
    let R : (t : Fin T) → @ProbabilityTheory.Kernel Ω (Fin d → ℝ)
        (ℋx t.val) inferInstance := fun t =>
      @ProbabilityTheory.Kernel.const Ω (Fin d → ℝ)
        (ℋx t.val) inferInstance μ0
    refine ⟨R, ?_, ?_⟩
    · intro t ω
      exact hμ0
    · intro t ω
      have hle : P t ω ≤ μ0 := by
        simpa [smooth_covariates] using hdom t ω
      letI : MeasureTheory.IsProbabilityMeasure (P t ω) := hP t ω
      letI : MeasureTheory.IsProbabilityMeasure μ0 := hμ0
      have heq : P t ω = μ0 :=
        MeasureTheory.Measure.eq_of_le_of_isProbabilityMeasure hle
      simp [R, heq]
  · have hCcov_sub_pos : 0 < Ccov - 1 :=
      sub_pos.mpr (lt_of_le_of_ne hCcov (Ne.symm hCcov_one))
    have hweight_nonneg : 0 ≤ 1 - Ccov⁻¹ := by
      rw [sub_nonneg]
      exact (inv_le_one₀ hCcov_pos).2 hCcov
    have hresidual_weight :
        ENNReal.ofReal (1 - Ccov⁻¹) * ENNReal.ofReal ((Ccov - 1)⁻¹) =
          ENNReal.ofReal (Ccov⁻¹) := by
      rw [← ENNReal.ofReal_mul hweight_nonneg]
      congr 1
      field_simp
    have hinverse_weight :
        ENNReal.ofReal (Ccov⁻¹) * ENNReal.ofReal Ccov = 1 := by
      rw [← ENNReal.ofReal_mul (inv_nonneg.mpr hCcov_pos.le)]
      field_simp
      norm_num
    have hCcov_diff :
        ENNReal.ofReal Ccov - 1 = ENNReal.ofReal (Ccov - 1) := by
      rw [ENNReal.ofReal_sub Ccov (by norm_num)]
      norm_num
    let R : (t : Fin T) → @ProbabilityTheory.Kernel Ω (Fin d → ℝ)
        (ℋx t.val) inferInstance := fun t =>
      @ProbabilityTheory.Kernel.mk Ω (Fin d → ℝ) (ℋx t.val) inferInstance
        (fun ω => ENNReal.ofReal ((Ccov - 1)⁻¹) •
          (ENNReal.ofReal Ccov • μ0 - P t ω))
        (by
          rw [MeasureTheory.Measure.measurable_measure]
          intro s hs
          have hsub :
              (fun ω => (ENNReal.ofReal Ccov • μ0 - P t ω) s) =
                fun ω => ENNReal.ofReal Ccov * μ0 s - P t ω s := by
            funext ω
            letI : MeasureTheory.IsProbabilityMeasure (P t ω) := hP t ω
            rw [MeasureTheory.Measure.sub_apply hs (hdom t ω)]
            simp only [MeasureTheory.Measure.smul_apply, smul_eq_mul]
          simp only [MeasureTheory.Measure.smul_apply, smul_eq_mul]
          have heq :
              (fun ω => ENNReal.ofReal ((Ccov - 1)⁻¹) *
                (ENNReal.ofReal Ccov • μ0 - P t ω) s) =
                fun ω => ENNReal.ofReal ((Ccov - 1)⁻¹) *
                  (ENNReal.ofReal Ccov * μ0 s - P t ω s) := by
            funext ω
            rw [congrFun hsub ω]
          rw [heq]
          exact measurable_const.mul
            (measurable_const.sub ((P t).measurable_coe hs)))
    refine ⟨R, ?_, ?_⟩
    · intro t ω
      letI : MeasureTheory.IsProbabilityMeasure (P t ω) := hP t ω
      letI : MeasureTheory.IsProbabilityMeasure μ0 := hμ0
      constructor
      change ENNReal.ofReal ((Ccov - 1)⁻¹) *
          (ENNReal.ofReal Ccov • μ0 - P t ω) Set.univ = 1
      rw [MeasureTheory.Measure.sub_apply MeasurableSet.univ (hdom t ω)]
      simp only [MeasureTheory.Measure.smul_apply,
        MeasureTheory.IsProbabilityMeasure.measure_univ, smul_eq_mul, mul_one]
      rw [hCcov_diff, ENNReal.ofReal_inv_of_pos hCcov_sub_pos]
      exact ENNReal.inv_mul_cancel
        (ENNReal.ofReal_pos.mpr hCcov_sub_pos).ne' ENNReal.ofReal_ne_top
    · intro t ω
      letI : MeasureTheory.IsProbabilityMeasure (P t ω) := hP t ω
      change μ0 = ENNReal.ofReal (Ccov⁻¹) • P t ω +
        ENNReal.ofReal (1 - Ccov⁻¹) •
          (ENNReal.ofReal ((Ccov - 1)⁻¹) •
            (ENNReal.ofReal Ccov • μ0 - P t ω))
      rw [← mul_smul, hresidual_weight, ← smul_add]
      rw [add_comm, MeasureTheory.Measure.sub_add_cancel_of_le (hdom t ω)]
      rw [smul_smul, hinverse_weight, one_smul]

@[blueprint "lem:finite-reverse-mixture-event-recurrence"
  (statement := /-- If (p\in[0,1]), (b\geq q), and
  (q\geq1-(1-p)^n), then
  [
    p+(1-p)b\geq1-(1-p)^{n+1}.
  ]
  The same assertion holds after embedding the nonnegative quantities in
  (\mathbb R_{\geq0}\cup\{\infty\}). -/)
  (proof := /-- Monotonicity gives
  (p+(1-p)b\geq p+(1-p)q).  Substitute the lower bound on (q), use
  nonnegativity of (p), (1-p), and (1-(1-p)^n) to commute
  (\operatorname{ofReal}) with addition and multiplication, and expand:
  (p+(1-p)(1-(1-p)^n)=1-(1-p)^{n+1}). -/)
  (title := /-- Geometric matching recurrence -/)
  (latexEnv := "lemma")]
lemma finite_reverse_mixture_event_recurrence :
    ∀ (n : ℕ) (p : ℝ) (b q : ENNReal),
      0 ≤ p →
      p ≤ 1 →
      b ≥ q →
      q ≥ ENNReal.ofReal (1 - (1 - p) ^ n) →
      ENNReal.ofReal p + ENNReal.ofReal (1 - p) * b ≥
        ENNReal.ofReal (1 - (1 - p) ^ (n + 1)) := by
  intro n p b q hp hp_one hb hq
  have hr0 : 0 ≤ 1 - p := sub_nonneg.mpr hp_one
  have hr1 : 1 - p ≤ 1 := by linarith
  have hqn : 0 ≤ 1 - (1 - p) ^ n :=
    sub_nonneg.mpr (pow_le_one₀ hr0 hr1)
  calc
    ENNReal.ofReal p + ENNReal.ofReal (1 - p) * b ≥
        ENNReal.ofReal p + ENNReal.ofReal (1 - p) * q := by gcongr
    _ ≥ ENNReal.ofReal p + ENNReal.ofReal (1 - p) *
        ENNReal.ofReal (1 - (1 - p) ^ n) := by gcongr
    _ = ENNReal.ofReal (1 - (1 - p) ^ (n + 1)) := by
      rw [← ENNReal.ofReal_mul hr0,
        ← ENNReal.ofReal_add hp (mul_nonneg hr0 hqn)]
      congr 1
      ring

@[blueprint "def:finite-reverse-mixture-success-branch"
  (statement := /-- The success branch prepends an independent
  (P(\omega,\cdot))-draw to the proposal marginal of a coupling and uses
  that draw as the accepted coordinate. -/)
  (title := /-- Success branch of the reverse mixture construction -/)
  (latexEnv := "definition")]
noncomputable def finite_reverse_mixture_success_branch {d n : ℕ}
    {Ω : Type*} [MeasurableSpace Ω]
    (P : ProbabilityTheory.Kernel Ω (Fin d → ℝ))
    (Q : ProbabilityTheory.Kernel Ω
      ((Fin d → ℝ) × (Fin n → Fin d → ℝ))) :
    ProbabilityTheory.Kernel Ω
      ((Fin d → ℝ) × (Fin (n + 1) → Fin d → ℝ)) :=
  let M := Q.map (fun z => z.2)
  let e := MeasurableEquiv.piFinSuccAbove
    (fun _ : Fin (n + 1) => Fin d → ℝ) 0
  (P.prod M).map (fun z => (z.1, e.symm z))

@[blueprint "def:finite-reverse-mixture-failure-branch"
  (statement := /-- The failure branch prepends an independent
  (R(\omega,\cdot))-draw to an existing accepted-vector and proposal-block
  coupling. -/)
  (title := /-- Failure branch of the reverse mixture construction -/)
  (latexEnv := "definition")]
noncomputable def finite_reverse_mixture_failure_branch {d n : ℕ}
    {Ω : Type*} [MeasurableSpace Ω]
    (R : ProbabilityTheory.Kernel Ω (Fin d → ℝ))
    (Q : ProbabilityTheory.Kernel Ω
      ((Fin d → ℝ) × (Fin n → Fin d → ℝ))) :
    ProbabilityTheory.Kernel Ω
      ((Fin d → ℝ) × (Fin (n + 1) → Fin d → ℝ)) :=
  let e := MeasurableEquiv.piFinSuccAbove
    (fun _ : Fin (n + 1) => Fin d → ℝ) 0
  (R.prod Q).map (fun z => (z.2.1, e.symm (z.1, z.2.2)))

@[blueprint "lem:finite-reverse-mixture-success-branch-properties"
  (statement := /-- If (P) and the input coupling are probability kernels
  and the input proposal marginal is (\mu_0^{\otimes n}), then the success
  branch is a probability kernel with accepted marginal (P), proposal law
  (P\otimes\mu_0^{\otimes n}), and matching probability one. -/)
  (proof := /-- Unfold the success kernel from
  \cref{def:finite-reverse-mixture-success-branch}.  Map the input coupling
  to its proposal block, take its product with (P), and apply the measurable
  head--tail equivalence.  Product marginals give the accepted and proposal
  laws.  The new head is the accepted coordinate pointwise, so the measurable
  matching event has full measure. -/)
  (title := /-- Properties of the success branch -/)
  (latexEnv := "lemma")]
lemma finite_reverse_mixture_success_branch_properties :
    ∀ (d n : ℕ) (Ω : Type*) [mΩ : MeasurableSpace Ω]
      (P : ProbabilityTheory.Kernel Ω (Fin d → ℝ))
      (μ0 : MeasureTheory.Measure (Fin d → ℝ))
      (Q : ProbabilityTheory.Kernel Ω
        ((Fin d → ℝ) × (Fin n → Fin d → ℝ))),
      (∀ ω, MeasureTheory.IsProbabilityMeasure (P ω)) →
      (∀ ω, MeasureTheory.IsProbabilityMeasure (Q ω)) →
      (∀ ω, MeasureTheory.Measure.map (fun z => z.2) (Q ω) =
        MeasureTheory.Measure.pi (fun _ : Fin n => μ0)) →
      ∀ ω,
        MeasureTheory.IsProbabilityMeasure
          (finite_reverse_mixture_success_branch P Q ω) ∧
        MeasureTheory.Measure.map (fun z => z.1)
          (finite_reverse_mixture_success_branch P Q ω) = P ω ∧
        MeasureTheory.Measure.map (fun z => z.2)
          (finite_reverse_mixture_success_branch P Q ω) =
            ((P ω).prod (MeasureTheory.Measure.pi (fun _ : Fin n => μ0))).map
              (MeasurableEquiv.piFinSuccAbove
                (fun _ : Fin (n + 1) => Fin d → ℝ) 0).symm ∧
        finite_reverse_mixture_success_branch P Q ω
          {z | ∃ j : Fin (n + 1), z.1 = z.2 j} = 1 := by
  classical
  intro d n Ω mΩ P μ0 Q hP hQprob hQsecond ω
  letI : ProbabilityTheory.IsMarkovKernel P := ⟨hP⟩
  letI : ProbabilityTheory.IsMarkovKernel Q := ⟨hQprob⟩
  let M : ProbabilityTheory.Kernel Ω (Fin n → Fin d → ℝ) :=
    Q.map (fun z => z.2)
  letI : ProbabilityTheory.IsMarkovKernel M :=
    ProbabilityTheory.Kernel.IsMarkovKernel.map Q (by fun_prop)
  let e : (Fin (n + 1) → Fin d → ℝ) ≃ᵐ
      ((Fin d → ℝ) × (Fin n → Fin d → ℝ)) :=
    MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) => Fin d → ℝ) 0
  let A := finite_reverse_mixture_success_branch P Q
  letI : ProbabilityTheory.IsMarkovKernel A := by
    dsimp [A, finite_reverse_mixture_success_branch]
    exact ProbabilityTheory.Kernel.IsMarkovKernel.map (P.prod M) (by fun_prop)
  have hM : M ω = MeasureTheory.Measure.pi (fun _ : Fin n => μ0) := by
    change (Q.map (fun z => z.2)) ω =
      MeasureTheory.Measure.pi (fun _ : Fin n => μ0)
    rw [ProbabilityTheory.Kernel.map_apply Q (by fun_prop) ω]
    exact hQsecond ω
  have hA :
      A ω = ((P ω).prod (M ω)).map
        (fun z => (z.1, e.symm z)) := by
    change ((P.prod M).map (fun z => (z.1, e.symm z))) ω = _
    rw [ProbabilityTheory.Kernel.map_apply (P.prod M) (by fun_prop) ω,
      ProbabilityTheory.Kernel.prod_apply]
  have hfirst : MeasureTheory.Measure.map (fun z => z.1) (A ω) = P ω := by
    rw [hA, MeasureTheory.Measure.map_map (by fun_prop) (by fun_prop)]
    change MeasureTheory.Measure.map Prod.fst ((P ω).prod (M ω)) = P ω
    rw [MeasureTheory.Measure.map_fst_prod,
      MeasureTheory.IsProbabilityMeasure.measure_univ, one_smul]
  have hsecond : MeasureTheory.Measure.map (fun z => z.2) (A ω) =
      ((P ω).prod (M ω)).map e.symm := by
    rw [hA, MeasureTheory.Measure.map_map (by fun_prop) (by fun_prop)]
    rfl
  let Snext : Set ((Fin d → ℝ) × (Fin (n + 1) → Fin d → ℝ)) :=
    {z | ∃ j : Fin (n + 1), z.1 = z.2 j}
  have hSnext : MeasurableSet Snext := by
    dsimp [Snext]
    measurability
  have hevent : A ω Snext = 1 := by
    rw [hA, MeasureTheory.Measure.map_apply (by fun_prop) hSnext]
    have hpre : (fun z => (z.1, e.symm z)) ⁻¹' Snext = Set.univ := by
      ext z
      simp only [Set.mem_preimage, Set.mem_univ, iff_true]
      refine ⟨0, ?_⟩
      simp [Snext, e]
    rw [hpre, MeasureTheory.IsProbabilityMeasure.measure_univ]
  refine ⟨inferInstance, hfirst, ?_, hevent⟩
  simpa [A, e, hM] using hsecond

@[blueprint "lem:finite-reverse-mixture-failure-branch-properties"
  (statement := /-- If (R) and the input coupling are probability kernels,
  the input accepted marginal is (P), and its proposal marginal is
  (\mu_0^{\otimes n}), then the failure branch is a probability kernel with
  accepted marginal (P), proposal law (R\otimes\mu_0^{\otimes n}), and
  matching probability no smaller than that of the input coupling. -/)
  (proof := /-- Unfold the failure kernel from
  \cref{def:finite-reverse-mixture-failure-branch}.  Take the product of (R)
  with the input coupling and apply the measurable head--tail equivalence.
  Product marginals give the asserted accepted and proposal laws.  The
  preimage of the new matching event contains the product of the full
  (R)-space with the old matching event; product-measure monotonicity
  therefore gives the probability bound. -/)
  (title := /-- Properties of the failure branch -/)
  (latexEnv := "lemma")]
lemma finite_reverse_mixture_failure_branch_properties :
    ∀ (d n : ℕ) (Ω : Type*) [mΩ : MeasurableSpace Ω]
      (P R : ProbabilityTheory.Kernel Ω (Fin d → ℝ))
      (μ0 : MeasureTheory.Measure (Fin d → ℝ))
      (Q : ProbabilityTheory.Kernel Ω
        ((Fin d → ℝ) × (Fin n → Fin d → ℝ))),
      (∀ ω, MeasureTheory.IsProbabilityMeasure (R ω)) →
      (∀ ω, MeasureTheory.IsProbabilityMeasure (Q ω)) →
      (∀ ω, MeasureTheory.Measure.map (fun z => z.1) (Q ω) = P ω) →
      (∀ ω, MeasureTheory.Measure.map (fun z => z.2) (Q ω) =
        MeasureTheory.Measure.pi (fun _ : Fin n => μ0)) →
      ∀ ω,
        MeasureTheory.IsProbabilityMeasure
          (finite_reverse_mixture_failure_branch R Q ω) ∧
        MeasureTheory.Measure.map (fun z => z.1)
          (finite_reverse_mixture_failure_branch R Q ω) = P ω ∧
        MeasureTheory.Measure.map (fun z => z.2)
          (finite_reverse_mixture_failure_branch R Q ω) =
            ((R ω).prod (MeasureTheory.Measure.pi (fun _ : Fin n => μ0))).map
              (MeasurableEquiv.piFinSuccAbove
                (fun _ : Fin (n + 1) => Fin d → ℝ) 0).symm ∧
        finite_reverse_mixture_failure_branch R Q ω
          {z | ∃ j : Fin (n + 1), z.1 = z.2 j} ≥
            Q ω {z | ∃ j : Fin n, z.1 = z.2 j} := by
  classical
  intro d n Ω mΩ P R μ0 Q hR hQprob hQfirst hQsecond ω
  letI : ProbabilityTheory.IsMarkovKernel R := ⟨hR⟩
  letI : ProbabilityTheory.IsMarkovKernel Q := ⟨hQprob⟩
  let M : ProbabilityTheory.Kernel Ω (Fin n → Fin d → ℝ) :=
    Q.map (fun z => z.2)
  letI : ProbabilityTheory.IsMarkovKernel M :=
    ProbabilityTheory.Kernel.IsMarkovKernel.map Q (by fun_prop)
  let e : (Fin (n + 1) → Fin d → ℝ) ≃ᵐ
      ((Fin d → ℝ) × (Fin n → Fin d → ℝ)) :=
    MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) => Fin d → ℝ) 0
  let B := finite_reverse_mixture_failure_branch R Q
  letI : ProbabilityTheory.IsMarkovKernel B := by
    dsimp [B, finite_reverse_mixture_failure_branch]
    exact ProbabilityTheory.Kernel.IsMarkovKernel.map (R.prod Q) (by fun_prop)
  have hM : M ω = MeasureTheory.Measure.pi (fun _ : Fin n => μ0) := by
    change (Q.map (fun z => z.2)) ω =
      MeasureTheory.Measure.pi (fun _ : Fin n => μ0)
    rw [ProbabilityTheory.Kernel.map_apply Q (by fun_prop) ω]
    exact hQsecond ω
  have hB :
      B ω = ((R ω).prod (Q ω)).map
        (fun z => (z.2.1, e.symm (z.1, z.2.2))) := by
    change ((R.prod Q).map
      (fun z => (z.2.1, e.symm (z.1, z.2.2)))) ω = _
    rw [ProbabilityTheory.Kernel.map_apply (R.prod Q) (by fun_prop) ω,
      ProbabilityTheory.Kernel.prod_apply]
  have hfirst : MeasureTheory.Measure.map (fun z => z.1) (B ω) = P ω := by
    rw [hB, MeasureTheory.Measure.map_map (by fun_prop) (by fun_prop)]
    change MeasureTheory.Measure.map (fun z => z.2.1)
      ((R ω).prod (Q ω)) = P ω
    calc
      _ = MeasureTheory.Measure.map Prod.fst
          (MeasureTheory.Measure.map Prod.snd ((R ω).prod (Q ω))) := by
            rw [MeasureTheory.Measure.map_map (by fun_prop) (by fun_prop)]
            rfl
      _ = P ω := by
        rw [MeasureTheory.Measure.map_snd_prod,
          MeasureTheory.IsProbabilityMeasure.measure_univ, one_smul]
        exact hQfirst ω
  have hsecond : MeasureTheory.Measure.map (fun z => z.2) (B ω) =
      ((R ω).prod (M ω)).map e.symm := by
    rw [hB, MeasureTheory.Measure.map_map (by fun_prop) (by fun_prop)]
    change MeasureTheory.Measure.map
      (fun z => e.symm (z.1, z.2.2)) ((R ω).prod (Q ω)) =
        MeasureTheory.Measure.map e.symm ((R ω).prod (M ω))
    calc
      _ = MeasureTheory.Measure.map e.symm
          (MeasureTheory.Measure.map (fun z => (z.1, z.2.2))
            ((R ω).prod (Q ω))) := by
            rw [MeasureTheory.Measure.map_map (by fun_prop) (by fun_prop)]
            rfl
      _ = MeasureTheory.Measure.map e.symm ((R ω).prod (M ω)) := by
        congr 1
        calc
          MeasureTheory.Measure.map (fun z => (z.1, z.2.2))
              ((R ω).prod (Q ω)) =
              MeasureTheory.Measure.map (Prod.map id Prod.snd)
                ((R ω).prod (Q ω)) := by congr
          _ = (MeasureTheory.Measure.map id (R ω)).prod
              (MeasureTheory.Measure.map Prod.snd (Q ω)) := by
                exact MeasureTheory.Measure.map_prod_map
                  (R ω) (Q ω) measurable_id measurable_snd |>.symm
          _ = (R ω).prod (M ω) := by
            rw [MeasureTheory.Measure.map_id]
            congr 1
            exact (ProbabilityTheory.Kernel.map_apply Q measurable_snd ω).symm
  let Snext : Set ((Fin d → ℝ) × (Fin (n + 1) → Fin d → ℝ)) :=
    {z | ∃ j : Fin (n + 1), z.1 = z.2 j}
  let Sold : Set ((Fin d → ℝ) × (Fin n → Fin d → ℝ)) :=
    {z | ∃ j : Fin n, z.1 = z.2 j}
  have hSnext : MeasurableSet Snext := by
    dsimp [Snext]
    measurability
  have hevent : B ω Snext ≥ Q ω Sold := by
    rw [hB, MeasureTheory.Measure.map_apply (by fun_prop) hSnext]
    calc
      Q ω Sold = ((R ω).prod (Q ω)) (Set.univ ×ˢ Sold) := by simp
      _ ≤ ((R ω).prod (Q ω))
          ((fun z => (z.2.1, e.symm (z.1, z.2.2))) ⁻¹' Snext) := by
        apply MeasureTheory.measure_mono
        rintro z ⟨hz, j, hj⟩
        change ∃ k : Fin (n + 1), z.2.1 = e.symm (z.1, z.2.2) k
        refine ⟨Fin.succ j, ?_⟩
        simpa [e] using hj
  refine ⟨inferInstance, hfirst, ?_, hevent⟩
  simpa [B, e, hM] using hsecond

@[blueprint "lem:finite-reverse-mixture-kernel-branches"
  (statement := /-- Given a coupling with accepted marginal (P) and proposal
  law (\mu_0^{\otimes n}), there are two measurable successor branches.
  The success branch prepends the accepted vector drawn independently of the
  old proposal block; the failure branch prepends an independent (R)-draw to
  the old coupling.  Both retain accepted marginal (P), their proposal laws
  are respectively (P\otimes\mu_0^{\otimes n}) and
  (R\otimes\mu_0^{\otimes n}), the success branch always matches, and the
  failure branch has matching probability at least that of the old
  coupling. -/)
  (proof := /-- Apply
  \cref{lem:finite-reverse-mixture-success-branch-properties} and
  \cref{lem:finite-reverse-mixture-failure-branch-properties}.  The first
  supplies the success kernel with its two marginals and certain matching;
  the second supplies the failure kernel with its two marginals and the
  inherited matching lower bound.  Combining these conclusions gives the
  asserted pair of branches. -/)
  (title := /-- Success and failure branches for reverse mixture coupling -/)
  (latexEnv := "lemma")]
lemma finite_reverse_mixture_kernel_branches :
    ∀ (d n : ℕ) (Ω : Type*) [mΩ : MeasurableSpace Ω]
      (P R : ProbabilityTheory.Kernel Ω (Fin d → ℝ))
      (μ0 : MeasureTheory.Measure (Fin d → ℝ))
      (Q : ProbabilityTheory.Kernel Ω
        ((Fin d → ℝ) × (Fin n → Fin d → ℝ))),
      (∀ ω, MeasureTheory.IsProbabilityMeasure (P ω)) →
      (∀ ω, MeasureTheory.IsProbabilityMeasure (R ω)) →
      (∀ ω,
        MeasureTheory.IsProbabilityMeasure (Q ω) ∧
        MeasureTheory.Measure.map
          (fun z : (Fin d → ℝ) × (Fin n → Fin d → ℝ) => z.1)
          (Q ω) = P ω ∧
        MeasureTheory.Measure.map
          (fun z : (Fin d → ℝ) × (Fin n → Fin d → ℝ) => z.2)
          (Q ω) = MeasureTheory.Measure.pi (fun _ : Fin n => μ0)) →
      ∃ A B : ProbabilityTheory.Kernel Ω
          ((Fin d → ℝ) × (Fin (n + 1) → Fin d → ℝ)),
        ∀ ω,
          MeasureTheory.IsProbabilityMeasure (A ω) ∧
          MeasureTheory.IsProbabilityMeasure (B ω) ∧
          MeasureTheory.Measure.map (fun z => z.1) (A ω) = P ω ∧
          MeasureTheory.Measure.map (fun z => z.1) (B ω) = P ω ∧
          MeasureTheory.Measure.map (fun z => z.2) (A ω) =
            ((P ω).prod (MeasureTheory.Measure.pi (fun _ : Fin n => μ0))).map
              (MeasurableEquiv.piFinSuccAbove
                (fun _ : Fin (n + 1) => Fin d → ℝ) 0).symm ∧
          MeasureTheory.Measure.map (fun z => z.2) (B ω) =
            ((R ω).prod (MeasureTheory.Measure.pi (fun _ : Fin n => μ0))).map
              (MeasurableEquiv.piFinSuccAbove
                (fun _ : Fin (n + 1) => Fin d → ℝ) 0).symm ∧
          A ω {z | ∃ j : Fin (n + 1), z.1 = z.2 j} = 1 ∧
          B ω {z | ∃ j : Fin (n + 1), z.1 = z.2 j} ≥
            Q ω {z | ∃ j : Fin n, z.1 = z.2 j} := by
  intro d n Ω mΩ P R μ0 Q hP hR hQ
  refine ⟨finite_reverse_mixture_success_branch P Q,
    finite_reverse_mixture_failure_branch R Q, fun ω => ?_⟩
  rcases finite_reverse_mixture_success_branch_properties
      d n Ω P μ0 Q hP (fun ω => (hQ ω).1)
        (fun ω => (hQ ω).2.2) ω with
    ⟨hAp, hAf, hAs, hAe⟩
  rcases finite_reverse_mixture_failure_branch_properties
      d n Ω P R μ0 Q hR (fun ω => (hQ ω).1)
        (fun ω => (hQ ω).2.1) (fun ω => (hQ ω).2.2) ω with
    ⟨hBp, hBf, hBs, hBe⟩
  exact ⟨hAp, hBp, hAf, hBf, hAs, hBs, hAe, hBe⟩

@[blueprint "lem:finite-reverse-mixture-kernel-prepend"
  (statement := /-- Suppose a probability kernel couples a
  (P(\omega,\cdot))-distributed accepted vector to (n) proposals with joint
  law (\mu_0^{\otimes n}) and matching probability at least
  (1-(1-p)^n).  If
  (\mu_0=pP(\omega,\cdot)+(1-p)R(\omega,\cdot)) with (p\in[0,1]), then
  there is such a coupling for (n+1) proposals with matching probability at
  least (1-(1-p)^{n+1}). -/)
  (proof := /-- Obtain the success and failure kernels from
  \cref{lem:finite-reverse-mixture-kernel-branches} and mix them with weights
  (p) and (1-p).  Their accepted marginals are both (P), while their proposal
  laws mix to
  ((pP+(1-p)R)\otimes\mu_0^{\otimes n}
  =\mu_0^{\otimes(n+1)}).  Their matching probabilities and
  \cref{lem:finite-reverse-mixture-event-recurrence} give the lower bound
  (1-(1-p)^{n+1}). -/)
  (title := /-- Prepending a proposal to a reverse mixture coupling -/)
  (latexEnv := "lemma")]
lemma finite_reverse_mixture_kernel_prepend :
    ∀ (d n : ℕ) (Ω : Type*) [mΩ : MeasurableSpace Ω]
      (P R : ProbabilityTheory.Kernel Ω (Fin d → ℝ))
      (μ0 : MeasureTheory.Measure (Fin d → ℝ)) (p : ℝ)
      (Q : ProbabilityTheory.Kernel Ω
        ((Fin d → ℝ) × (Fin n → Fin d → ℝ))),
      (∀ ω, MeasureTheory.IsProbabilityMeasure (P ω)) →
      (∀ ω, MeasureTheory.IsProbabilityMeasure (R ω)) →
      MeasureTheory.IsProbabilityMeasure μ0 →
      0 ≤ p →
      p ≤ 1 →
      (∀ ω, μ0 =
        ENNReal.ofReal p • P ω + ENNReal.ofReal (1 - p) • R ω) →
      (∀ ω,
        MeasureTheory.IsProbabilityMeasure (Q ω) ∧
        MeasureTheory.Measure.map
          (fun z : (Fin d → ℝ) × (Fin n → Fin d → ℝ) => z.1)
          (Q ω) = P ω ∧
        MeasureTheory.Measure.map
          (fun z : (Fin d → ℝ) × (Fin n → Fin d → ℝ) => z.2)
          (Q ω) = MeasureTheory.Measure.pi (fun _ : Fin n => μ0) ∧
        Q ω {z | ∃ j : Fin n, z.1 = z.2 j} ≥
          ENNReal.ofReal (1 - (1 - p) ^ n)) →
      ∃ Qnext : ProbabilityTheory.Kernel Ω
          ((Fin d → ℝ) × (Fin (n + 1) → Fin d → ℝ)),
        ∀ ω,
          MeasureTheory.IsProbabilityMeasure (Qnext ω) ∧
          MeasureTheory.Measure.map
            (fun z : (Fin d → ℝ) × (Fin (n + 1) → Fin d → ℝ) => z.1)
            (Qnext ω) = P ω ∧
          MeasureTheory.Measure.map
            (fun z : (Fin d → ℝ) × (Fin (n + 1) → Fin d → ℝ) => z.2)
            (Qnext ω) =
              MeasureTheory.Measure.pi (fun _ : Fin (n + 1) => μ0) ∧
          Qnext ω {z | ∃ j : Fin (n + 1), z.1 = z.2 j} ≥
            ENNReal.ofReal (1 - (1 - p) ^ (n + 1)) := by
  classical
  intro d n Ω mΩ P R μ0 p Q hP hR hμ0 hp hp_one hmix hQ
  obtain ⟨A, B, hAB⟩ :=
    finite_reverse_mixture_kernel_branches d n Ω P R μ0 Q hP hR
      (fun ω => ⟨(hQ ω).1, (hQ ω).2.1, (hQ ω).2.2.1⟩)
  letI : ProbabilityTheory.IsMarkovKernel A := ⟨fun ω => (hAB ω).1⟩
  letI : ProbabilityTheory.IsMarkovKernel B := ⟨fun ω => (hAB ω).2.1⟩
  let Qnext : ProbabilityTheory.Kernel Ω
      ((Fin d → ℝ) × (Fin (n + 1) → Fin d → ℝ)) :=
    { toFun := fun ω =>
        ENNReal.ofReal p • A ω + ENNReal.ofReal (1 - p) • B ω
      measurable' := by
        refine MeasureTheory.Measure.measurable_of_measurable_coe _ ?_
        intro s hs
        simp only [MeasureTheory.Measure.add_apply,
          MeasureTheory.Measure.smul_apply, smul_eq_mul]
        exact
          (measurable_const.mul (A.measurable_coe hs)).add
            (measurable_const.mul (B.measurable_coe hs)) }
  have hweight : ENNReal.ofReal p + ENNReal.ofReal (1 - p) = 1 := by
    rw [← ENNReal.ofReal_add hp (sub_nonneg.mpr hp_one)]
    norm_num
  refine ⟨Qnext, fun ω => ?_⟩
  rcases hAB ω with ⟨hAp, hBp, hAf, hBf, hAs, hBs, hAe, hBe⟩
  have hQnext :
      Qnext ω =
        ENNReal.ofReal p • A ω + ENNReal.ofReal (1 - p) • B ω := rfl
  refine ⟨?_, ?_, ?_, ?_⟩
  · constructor
    rw [hQnext]
    simp only [MeasureTheory.Measure.add_apply,
      MeasureTheory.Measure.smul_apply, smul_eq_mul,
      MeasureTheory.IsProbabilityMeasure.measure_univ, mul_one]
    exact hweight
  · rw [hQnext, MeasureTheory.Measure.map_add _ _ (by fun_prop),
      MeasureTheory.Measure.map_smul, MeasureTheory.Measure.map_smul,
      hAf, hBf, ← add_smul, hweight, one_smul]
  · let e : (Fin (n + 1) → Fin d → ℝ) ≃ᵐ
        ((Fin d → ℝ) × (Fin n → Fin d → ℝ)) :=
      MeasurableEquiv.piFinSuccAbove
        (fun _ : Fin (n + 1) => Fin d → ℝ) 0
    rw [hQnext, MeasureTheory.Measure.map_add _ _ (by fun_prop),
      MeasureTheory.Measure.map_smul, MeasureTheory.Measure.map_smul,
      hAs, hBs, ← MeasureTheory.Measure.map_smul,
      ← MeasureTheory.Measure.map_smul,
      ← MeasureTheory.Measure.map_add _ _ (by fun_prop)]
    rw [← MeasureTheory.Measure.prod_smul_left,
      ← MeasureTheory.Measure.prod_smul_left,
      ← MeasureTheory.Measure.add_prod, ← hmix ω]
    exact
      (MeasureTheory.measurePreserving_piFinSuccAbove
        (fun _ : Fin (n + 1) => μ0) 0).symm.map_eq
  · let Snext : Set
        ((Fin d → ℝ) × (Fin (n + 1) → Fin d → ℝ)) :=
      {z | ∃ j : Fin (n + 1), z.1 = z.2 j}
    let Sold : Set ((Fin d → ℝ) × (Fin n → Fin d → ℝ)) :=
      {z | ∃ j : Fin n, z.1 = z.2 j}
    change Qnext ω Snext ≥
      ENNReal.ofReal (1 - (1 - p) ^ (n + 1))
    rw [hQnext, MeasureTheory.Measure.add_apply,
      MeasureTheory.Measure.smul_apply, MeasureTheory.Measure.smul_apply,
      smul_eq_mul, smul_eq_mul, hAe, mul_one]
    exact finite_reverse_mixture_event_recurrence n p
      (B ω Snext) (Q ω Sold) hp hp_one hBe (hQ ω).2.2.2

@[blueprint "lem:finite-reverse-mixture-kernel-empty"
  (statement := /-- For a probability kernel (P), adjoining the unique empty
  proposal tuple gives a probability coupling with accepted marginal (P),
  empty product proposal law, and the zero matching lower bound. -/)
  (proof := /-- Take the kernel product of (P) with the constant empty product
  measure.  The first marginal is unchanged, while the second marginal is the
  empty product law, equivalently the Dirac mass at the unique empty tuple.
  The matching lower bound reduces to (0\geq0). -/)
  (title := /-- Empty reverse mixture coupling -/)
  (latexEnv := "lemma")]
lemma finite_reverse_mixture_kernel_empty :
    ∀ (d : ℕ) (Ω : Type*) [mΩ : MeasurableSpace Ω]
      (P : ProbabilityTheory.Kernel Ω (Fin d → ℝ))
      (μ0 : MeasureTheory.Measure (Fin d → ℝ)) (p : ℝ),
      (∀ ω, MeasureTheory.IsProbabilityMeasure (P ω)) →
      ∃ Q : ProbabilityTheory.Kernel Ω
          ((Fin d → ℝ) × (Fin 0 → Fin d → ℝ)),
        ∀ ω,
          MeasureTheory.IsProbabilityMeasure (Q ω) ∧
          MeasureTheory.Measure.map
            (fun z : (Fin d → ℝ) × (Fin 0 → Fin d → ℝ) => z.1)
            (Q ω) = P ω ∧
          MeasureTheory.Measure.map
            (fun z : (Fin d → ℝ) × (Fin 0 → Fin d → ℝ) => z.2)
            (Q ω) =
              MeasureTheory.Measure.pi (fun _ : Fin 0 => μ0) ∧
          Q ω {z | ∃ j : Fin 0, z.1 = z.2 j} ≥
            ENNReal.ofReal (1 - (1 - p) ^ 0) := by
  intro d Ω mΩ P μ0 p hP
  letI : ProbabilityTheory.IsMarkovKernel P := ⟨hP⟩
  letI : MeasureTheory.IsProbabilityMeasure
      (MeasureTheory.Measure.pi (fun _ : Fin 0 => μ0)) := by
    constructor
    rw [MeasureTheory.Measure.pi_of_empty]
    simp
  let Z : ProbabilityTheory.Kernel Ω (Fin 0 → Fin d → ℝ) :=
    ProbabilityTheory.Kernel.const Ω
      (MeasureTheory.Measure.pi (fun _ : Fin 0 => μ0))
  letI : ProbabilityTheory.IsMarkovKernel Z := by
    dsimp [Z]
    infer_instance
  let Q : ProbabilityTheory.Kernel Ω
      ((Fin d → ℝ) × (Fin 0 → Fin d → ℝ)) :=
    P.prod Z
  letI : ProbabilityTheory.IsMarkovKernel Q := by
    dsimp [Q]
    infer_instance
  refine ⟨Q, fun ω => ?_⟩
  have hQ : Q ω =
      (P ω).prod (MeasureTheory.Measure.pi (fun _ : Fin 0 => μ0)) := by
    change (P.prod Z) ω = _
    rw [ProbabilityTheory.Kernel.prod_apply]
    rfl
  refine ⟨inferInstance, ?_, ?_, ?_⟩
  · rw [hQ, MeasureTheory.Measure.map_fst_prod,
      MeasureTheory.IsProbabilityMeasure.measure_univ, one_smul]
  · rw [hQ, MeasureTheory.Measure.map_snd_prod,
      MeasureTheory.IsProbabilityMeasure.measure_univ, one_smul]
  · rw [pow_zero, sub_self, ENNReal.ofReal_zero]
    exact bot_le

@[blueprint "lem:finite-reverse-mixture-kernel-joint-law"
  (statement := /-- Let (P) and (R) be probability kernels from a measurable
  space (\Omega) to (\mathbb R^d), let (\mu_0) be a probability measure,
  and suppose that
  [
    \mu_0=pP(\omega,\cdot)+(1-p)R(\omega,\cdot)
  ]
  for every (\omega), where (p\in[0,1]).  For every (K\geq1), there is a
  probability kernel coupling a (P(\omega,\cdot))-distributed coordinate
  with a proposal block whose joint law is the finite product
  (\mu_0^{\otimes K}), and the accepted coordinate belongs to that block
  with probability at least (1-(1-p)^K). -/)
  (proof := /-- Induct on the block size.  The base case is
  \cref{lem:finite-reverse-mixture-kernel-empty}.  For the successor case,
  apply \cref{lem:finite-reverse-mixture-kernel-prepend} to the induction
  hypothesis.  It preserves the accepted marginal, extends the proposal
  product law by one factor (\mu_0), and updates the matching lower bound
  from (1-(1-p)^n) to (1-(1-p)^{n+1}). -/)
  (title := /-- Joint proposal law in the finite reverse mixture coupling -/)
  (latexEnv := "lemma")]
lemma finite_reverse_mixture_kernel_joint_law :
    ∀ (d K : ℕ) (Ω : Type*) [mΩ : MeasurableSpace Ω]
      (P R : ProbabilityTheory.Kernel Ω (Fin d → ℝ))
      (μ0 : MeasureTheory.Measure (Fin d → ℝ)) (p : ℝ),
      0 < K →
      (∀ ω, MeasureTheory.IsProbabilityMeasure (P ω)) →
      (∀ ω, MeasureTheory.IsProbabilityMeasure (R ω)) →
      MeasureTheory.IsProbabilityMeasure μ0 →
      0 ≤ p →
      p ≤ 1 →
      (∀ ω, μ0 =
        ENNReal.ofReal p • P ω + ENNReal.ofReal (1 - p) • R ω) →
      ∃ Q : ProbabilityTheory.Kernel Ω
          ((Fin d → ℝ) × (Fin K → Fin d → ℝ)),
        ∀ ω,
          MeasureTheory.IsProbabilityMeasure (Q ω) ∧
          MeasureTheory.Measure.map
            (fun z : (Fin d → ℝ) × (Fin K → Fin d → ℝ) => z.1)
            (Q ω) = P ω ∧
          MeasureTheory.Measure.map
            (fun z : (Fin d → ℝ) × (Fin K → Fin d → ℝ) => z.2)
            (Q ω) =
              MeasureTheory.Measure.pi (fun _ : Fin K => μ0) ∧
          Q ω {z | ∃ j : Fin K, z.1 = z.2 j} ≥
            ENNReal.ofReal (1 - (1 - p) ^ K) := by
  classical
  intro d K Ω mΩ P R μ0 p hK hP hR hμ0 hp hp_one hmix
  letI : ProbabilityTheory.IsMarkovKernel P := ⟨hP⟩
  letI : ProbabilityTheory.IsMarkovKernel R := ⟨hR⟩
  have hstrong : ∀ n : ℕ,
      ∃ Q : ProbabilityTheory.Kernel Ω
          ((Fin d → ℝ) × (Fin n → Fin d → ℝ)),
        ∀ ω,
          MeasureTheory.IsProbabilityMeasure (Q ω) ∧
          MeasureTheory.Measure.map
            (fun z : (Fin d → ℝ) × (Fin n → Fin d → ℝ) => z.1)
            (Q ω) = P ω ∧
          MeasureTheory.Measure.map
            (fun z : (Fin d → ℝ) × (Fin n → Fin d → ℝ) => z.2)
            (Q ω) =
              MeasureTheory.Measure.pi (fun _ : Fin n => μ0) ∧
          Q ω {z | ∃ j : Fin n, z.1 = z.2 j} ≥
            ENNReal.ofReal (1 - (1 - p) ^ n) := by
    intro n
    induction n with
    | zero =>
        exact finite_reverse_mixture_kernel_empty d Ω P μ0 p hP
    | succ n ih =>
        obtain ⟨Q, hQ⟩ := ih
        exact finite_reverse_mixture_kernel_prepend d n Ω P R μ0 p Q
          hP hR hμ0 hp hp_one hmix hQ
  exact hstrong K

@[blueprint "lem:finite-reverse-mixture-kernel"
  (statement := /-- Let (P) and (R) be probability kernels from a measurable
  space (\Omega) to (\mathbb R^d), let (\mu_0) be a probability measure on
  (\mathbb R^d), and let (p\in[0,1]).  Suppose that
  [
    \mu_0=pP(\omega,\cdot)+(1-p)R(\omega,\cdot)
  ]
  for every (\omega\in\Omega).  For every integer (K\geq1), there is a
  probability kernel (Q) from (\Omega) to
  (\mathbb R^d\times(\mathbb R^d)^K) such that, under (Q(\omega,\cdot)),
  the first coordinate has law (P(\omega,\cdot)), the (K) coordinates in
  the second factor are independent with common law (\mu_0), and the first
  coordinate equals one of them with probability at least
  (1-(1-p)^K). -/)
  (proof := /-- Apply
  \cref{lem:finite-reverse-mixture-kernel-joint-law} to obtain a probability
  kernel whose accepted marginal is (P), whose full proposal-block marginal
  is (\mu_0^{\otimes K}), and whose matching probability has the required
  lower bound.  Mapping this product law by each coordinate evaluation gives
  proposal marginal (\mu_0).  The finite-family product-law
  characterization of independence then shows that all proposal coordinates
  are jointly independent.  The accepted marginal and matching bound are
  inherited unchanged. -/)
  (title := /-- Finite reverse coupling for a kernel mixture -/)
  (latexEnv := "lemma")]
lemma finite_reverse_mixture_kernel :
    ∀ (d K : ℕ) (Ω : Type*) [mΩ : MeasurableSpace Ω]
      (P R : ProbabilityTheory.Kernel Ω (Fin d → ℝ))
      (μ0 : MeasureTheory.Measure (Fin d → ℝ)) (p : ℝ),
      0 < K →
      (∀ ω, MeasureTheory.IsProbabilityMeasure (P ω)) →
      (∀ ω, MeasureTheory.IsProbabilityMeasure (R ω)) →
      MeasureTheory.IsProbabilityMeasure μ0 →
      0 ≤ p →
      p ≤ 1 →
      (∀ ω, μ0 =
        ENNReal.ofReal p • P ω + ENNReal.ofReal (1 - p) • R ω) →
      ∃ Q : ProbabilityTheory.Kernel Ω
          ((Fin d → ℝ) × (Fin K → Fin d → ℝ)),
        ∀ ω,
          MeasureTheory.IsProbabilityMeasure (Q ω) ∧
          MeasureTheory.Measure.map
            (fun z : (Fin d → ℝ) × (Fin K → Fin d → ℝ) => z.1)
            (Q ω) = P ω ∧
          ProbabilityTheory.iIndepFun
            (fun j : Fin K =>
              fun z : (Fin d → ℝ) × (Fin K → Fin d → ℝ) => z.2 j)
            (Q ω) ∧
          (∀ j : Fin K,
            MeasureTheory.Measure.map
              (fun z : (Fin d → ℝ) × (Fin K → Fin d → ℝ) => z.2 j)
              (Q ω) = μ0) ∧
          Q ω {z | ∃ j : Fin K, z.1 = z.2 j} ≥
            ENNReal.ofReal (1 - (1 - p) ^ K) := by
  classical
  intro d K Ω mΩ P R μ0 p hK hP hR hμ0 hp hp_one hmix
  obtain ⟨Q, hQ⟩ :=
    finite_reverse_mixture_kernel_joint_law d K Ω P R μ0 p
      hK hP hR hμ0 hp hp_one hmix
  refine ⟨Q, fun ω => ?_⟩
  letI : MeasureTheory.IsProbabilityMeasure (Q ω) := (hQ ω).1
  have hcoord (j : Fin K) :
      MeasureTheory.Measure.map
          (fun z : (Fin d → ℝ) × (Fin K → Fin d → ℝ) => z.2 j)
          (Q ω) = μ0 := by
    calc
      _ = MeasureTheory.Measure.map (Function.eval j)
          (MeasureTheory.Measure.map
            (fun z : (Fin d → ℝ) × (Fin K → Fin d → ℝ) => z.2)
            (Q ω)) := by
              rw [MeasureTheory.Measure.map_map (by fun_prop) (by fun_prop)]
              rfl
      _ = MeasureTheory.Measure.map (Function.eval j)
          (MeasureTheory.Measure.pi (fun _ : Fin K => μ0)) := by
              rw [(hQ ω).2.2.1]
      _ = μ0 := by
              rw [MeasureTheory.Measure.pi_map_eval]
              simp
  have hindep :
      ProbabilityTheory.iIndepFun
        (fun j : Fin K =>
          fun z : (Fin d → ℝ) × (Fin K → Fin d → ℝ) => z.2 j)
        (Q ω) := by
    apply
      (ProbabilityTheory.iIndepFun_iff_map_fun_eq_pi_map
        (μ := Q ω) (fun j => (by fun_prop : Measurable
          (fun z : (Fin d → ℝ) × (Fin K → Fin d → ℝ) => z.2 j)).aemeasurable)).2
    calc
      MeasureTheory.Measure.map
          (fun z : (Fin d → ℝ) × (Fin K → Fin d → ℝ) =>
            fun j => z.2 j) (Q ω) =
          MeasureTheory.Measure.map
            (fun z : (Fin d → ℝ) × (Fin K → Fin d → ℝ) => z.2)
            (Q ω) := by congr
      _ = MeasureTheory.Measure.pi (fun _ : Fin K => μ0) :=
        (hQ ω).2.2.1
      _ = MeasureTheory.Measure.pi (fun j : Fin K =>
          MeasureTheory.Measure.map
            (fun z : (Fin d → ℝ) × (Fin K → Fin d → ℝ) => z.2 j)
            (Q ω)) := by
              congr 1
              funext j
              exact (hcoord j).symm
  exact ⟨(hQ ω).1, (hQ ω).2.1, hindep, hcoord, (hQ ω).2.2.2⟩

@[blueprint "lem:one-block-reverse-rejection-kernel"
  (statement := /-- Let (T,d,K) be nonnegative integers with (K\geq1),
  let (\Omega) be a measurable space equipped with a filtration
  ((\mathcal H_t^x)_{t\geq0}), and let ((P_t)_{t<T}) be probability
  kernels from ((\Omega,\mathcal H_t^x)) to (\mathbb R^d).  Let
  (\mu_0) be a probability measure on (\mathbb R^d), let
  (C_{\mathrm{cov}}\geq1), and assume the smoothness condition
  (P_t(\omega,\cdot)\leq C_{\mathrm{cov}}\mu_0) for every
  (t<T) and (\omega\in\Omega).  Then there are probability kernels
  (Q_t) from ((\Omega,\mathcal H_t^x)) to
  (\mathbb R^d\times(\mathbb R^d)^K) such that, for every (t<T) and
  (\omega\in\Omega), the first coordinate under (Q_t(\omega,\cdot))
  has law (P_t(\omega,\cdot)), the (K) coordinates in the second
  factor are independent with common law (\mu_0), and the first
  coordinate equals one of them with probability at least
  (1-(1-C_{\mathrm{cov}}^{-1})^K). -/)
  (proof := /-- By
  \cref{lem:dominated-kernel-residual-decomposition}, there are probability
  kernels (R_t) such that, for every round (t) and history (\omega),
  [
    \mu_0=C_{\mathrm{cov}}^{-1}P_t(\omega,\cdot)
      +(1-C_{\mathrm{cov}}^{-1})R_t(\omega,\cdot).
  ]
  Since (C_{\mathrm{cov}}\geq1), the number
  (p=C_{\mathrm{cov}}^{-1}) belongs to ([0,1]).  Apply
  \cref{lem:finite-reverse-mixture-kernel} to (P_t), (R_t), (\mu_0), and
  this value of (p), separately for each (t) with the measurable structure
  supplied by the earlier-history filtration.  The resulting kernels have
  accepted marginal (P_t(\omega,\cdot)), independent proposal marginals
  (\mu_0), and matching probability at least
  (1-(1-C_{\mathrm{cov}}^{-1})^K), exactly as asserted. -/)
  (title := /-- A finite reverse rejection block -/)
  (latexEnv := "lemma")]
lemma one_block_reverse_rejection_kernel :
    ∀ (T d K : ℕ) (Ω : Type*) [mΩ : MeasurableSpace Ω]
      (ℋx : MeasureTheory.Filtration ℕ mΩ)
      (P : (t : Fin T) → @ProbabilityTheory.Kernel Ω (Fin d → ℝ)
        (ℋx t.val) inferInstance)
      (μ0 : MeasureTheory.Measure (Fin d → ℝ)) (Ccov : ℝ),
      0 < K →
      (∀ t ω, MeasureTheory.IsProbabilityMeasure (P t ω)) →
      MeasureTheory.IsProbabilityMeasure μ0 →
      1 ≤ Ccov →
      smooth_covariates ℋx P μ0 Ccov →
      ∃ Q : (t : Fin T) →
          @ProbabilityTheory.Kernel Ω
            ((Fin d → ℝ) × (Fin K → Fin d → ℝ))
            (ℋx t.val) inferInstance,
        ∀ t ω,
          MeasureTheory.IsProbabilityMeasure (Q t ω) ∧
          MeasureTheory.Measure.map
            (fun z : (Fin d → ℝ) × (Fin K → Fin d → ℝ) => z.1)
            (Q t ω) = P t ω ∧
          ProbabilityTheory.iIndepFun
            (fun j : Fin K =>
              fun z : (Fin d → ℝ) × (Fin K → Fin d → ℝ) => z.2 j)
            (Q t ω) ∧
          (∀ j : Fin K,
            MeasureTheory.Measure.map
              (fun z : (Fin d → ℝ) × (Fin K → Fin d → ℝ) => z.2 j)
              (Q t ω) = μ0) ∧
          Q t ω {z | ∃ j : Fin K, z.1 = z.2 j} ≥
            ENNReal.ofReal (1 - (1 - Ccov⁻¹) ^ K) := by
  classical
  intro T d K Ω mΩ ℋx P μ0 Ccov hK hP hμ0 hCcov hsmooth
  obtain ⟨R, hR, hmix⟩ :=
    dominated_kernel_residual_decomposition T d Ω ℋx P μ0 Ccov
      hP hμ0 hCcov hsmooth
  have hCcov_pos : 0 < Ccov := lt_of_lt_of_le zero_lt_one hCcov
  have hp_nonneg : 0 ≤ Ccov⁻¹ := (inv_nonneg.mpr hCcov_pos.le)
  have hp_le_one : Ccov⁻¹ ≤ 1 := (inv_le_one₀ hCcov_pos).2 hCcov
  have hQ := fun t : Fin T =>
    @finite_reverse_mixture_kernel d K Ω (ℋx t.val)
      (P t) (R t) μ0 Ccov⁻¹ hK (hP t) (hR t) hμ0 hp_nonneg
        hp_le_one (hmix t)
  choose Q hQ using hQ
  exact ⟨Q, hQ⟩

@[blueprint "lem:sequential-reverse-disintegration"
  (statement := /-- Let (T,d,K) be nonnegative integers, let
  ((\Omega,\mathcal F)) be a measurable space with a filtration
  ((\mathcal H_t^x)_{t\geq0}), and, for every (t<T), let (Q_t) be a
  probability kernel from ((\Omega,\mathcal H_t^x)) to
  (\mathbb R^d\times(\mathbb R^d)^K).  Then there is a Markov kernel
  (R_t) from
  ((\Omega,\mathcal H_t^x)\times\mathbb R^d) to
  ((\mathbb R^d)^K) such that
  [
    (Q_t)_{1}\otimes R_t=Q_t,
  ]
  where ((Q_t)_1) is the first-coordinate marginal of (Q_t). -/)
  (proof := /-- Fix (t<T).  The spaces (\mathbb R^d) and
  ((\mathbb R^d)^K) are standard Borel.  The parameterized
  disintegration theorem for the probability kernel (Q_t) therefore
  supplies its conditional kernel (R_t) for the proposal block given
  the accepted coordinate.  This conditional kernel is Markov, is
  measurable for the product of (\mathcal H_t^x) and the Borel
  sigma-algebra on (\mathbb R^d), and satisfies the asserted
  composition-product identity. -/)
  (title := /-- Parameterized reverse disintegration of proposal blocks -/)
  (latexEnv := "lemma")]
lemma sequential_reverse_disintegration :
    ∀ (T d K : ℕ) (Ω : Type*) [mΩ : MeasurableSpace Ω]
      (ℋx : MeasureTheory.Filtration ℕ mΩ)
      (Q : (t : Fin T) →
        @ProbabilityTheory.Kernel Ω
          ((Fin d → ℝ) × (Fin K → Fin d → ℝ))
          (ℋx t.val) inferInstance),
      (∀ t ω, MeasureTheory.IsProbabilityMeasure (Q t ω)) →
      ∀ t : Fin T,
        ∃ R : @ProbabilityTheory.Kernel
            (Ω × (Fin d → ℝ)) (Fin K → Fin d → ℝ)
            ((ℋx t.val).prod inferInstance) inferInstance,
          ProbabilityTheory.IsMarkovKernel R ∧
          (Q t).fst.compProd R = Q t := by
  intro T d K Ω mΩ ℋx Q hQ t
  letI : ProbabilityTheory.IsMarkovKernel (Q t) := ⟨hQ t⟩
  exact ⟨(Q t).condKernel, inferInstance,
    ProbabilityTheory.Kernel.disintegrate (Q t) (Q t).condKernel⟩

@[blueprint "lem:sequential-reverse-product-coupling"
  (statement := /-- Let (T) and (K) be positive integers, let (d) be a
  nonnegative integer, let
  ((\Omega,\mathcal F,\mu)) be a probability space, let
  ((\mathcal H_t^x)_{t\geq0}) be the earlier-covariate filtration of
  ((X_t)_{t<T}), and let (P_t) be the conditional law of (X_t) given
  (\mathcal H_t^x).  Suppose that, for every (t<T), (Q_t) is a
  probability kernel from ((\Omega,\mathcal H_t^x)) to
  (\mathbb R^d\times(\mathbb R^d)^K), its first marginal is (P_t),
  and its proposal block consists of independent coordinates with common
  law (\mu_0).  If the probability under (Q_t(\omega,\cdot)) that the
  accepted coordinate occurs in its proposal block is at least (1-q),
  where (q\in[0,1]), then there is a probability measure (\gamma) on
  [
    \Omega\times\prod_{t<T}(\mathbb R^d)^K
  ]
  whose (\Omega)-marginal is (\mu), whose entire family of (TK)
  proposal coordinates is independent with common law (\mu_0), and for
  which the match event in each fixed block has probability at least
  (1-q). -/)
  (proof := /-- Apply
  \cref{lem:sequential-reverse-disintegration} to obtain, for every
  (t<T), a Markov kernel (R_t) giving the conditional law of the proposal
  block given the accepted coordinate.  By
  \cref{def:covariate-history-filtration}, (X_t) is
  (\mathcal H_{t+1}^x)-measurable.  Moreover,
  \cref{def:conditional-covariate-law} implies the following joint-law
  identity: for every bounded measurable (h) on
  (\Omega,\mathcal H_t^x)\times\mathbb R^d),
  [
    \int h(\omega,X_t(\omega))\,\mu(d\omega)
      =\int\!\int h(\omega,a)\,P_t(\omega,da)\,\mu(d\omega).
  ]

  Starting from (\nu_0=\mu), construct (\nu_{n+1}) from (\nu_n) by
  adjoining one block according to
  (R_n(\omega,X_n(\omega),\cdot)).  Induction on (n) shows simultaneously
  that the (\Omega)-marginal of (\nu_n) is (\mu) and that the first (n)
  proposal blocks have law
  ((\mu_0^{\otimes K})^{\otimes n}).  For the induction step, integration
  over the preceding blocks leaves an (\mathcal H_n^x)-measurable
  function of (\omega): the (s)-th reverse kernel is measurable with
  respect to (\mathcal H_{s+1}^x), and
  (\mathcal H_{s+1}^x\subseteq\mathcal H_n^x) for (s<n).  The displayed
  joint-law identity and the disintegration identity then replace the
  integral over ((X_n,b_n)) by integration against (Q_n).  The proposal
  marginal of (Q_n) is (\mu_0^{\otimes K}), so this new block is
  independent of the preceding blocks.  Adjoining a Markov kernel leaves
  the (\Omega)-marginal unchanged.

  At (n=T), the induction gives the full product law of all proposal
  coordinates and hence their joint independence and common marginal
  (\mu_0).  The same disintegration calculation identifies the law of
  ((X_t,b_t)) with the law obtained by integrating (Q_t) against (\mu).
  Integrating the assumed pointwise match bound therefore shows that the
  match event in every fixed block has probability at least (1-q). -/)
  (title := /-- Sequential reverse-kernel product coupling -/)
  (latexEnv := "lemma")]
lemma sequential_reverse_product_coupling :
    ∀ (T d K : ℕ) (Ω : Type*) [mΩ : MeasurableSpace Ω]
      (μ : MeasureTheory.Measure Ω)
      [MeasureTheory.IsProbabilityMeasure μ]
      (ℋx : MeasureTheory.Filtration ℕ mΩ)
      (X : Fin T → Ω → Fin d → ℝ)
      (P : (t : Fin T) → @ProbabilityTheory.Kernel Ω (Fin d → ℝ)
        (ℋx t.val) inferInstance)
      (μ0 : MeasureTheory.Measure (Fin d → ℝ))
      [MeasureTheory.IsProbabilityMeasure μ0]
      (q : ℝ)
      (Q : (t : Fin T) →
        @ProbabilityTheory.Kernel Ω
          ((Fin d → ℝ) × (Fin K → Fin d → ℝ))
          (ℋx t.val) inferInstance),
      0 < T → 0 < K → 0 ≤ q → q ≤ 1 →
      covariate_history_filtration ℋx X →
      conditional_covariate_law μ ℋx X P →
      (∀ t ω,
        MeasureTheory.IsProbabilityMeasure (Q t ω) ∧
        MeasureTheory.Measure.map
          (fun z : (Fin d → ℝ) × (Fin K → Fin d → ℝ) => z.1)
          (Q t ω) = P t ω ∧
        ProbabilityTheory.iIndepFun
          (fun j : Fin K =>
            fun z : (Fin d → ℝ) × (Fin K → Fin d → ℝ) => z.2 j)
          (Q t ω) ∧
        (∀ j : Fin K,
          MeasureTheory.Measure.map
            (fun z : (Fin d → ℝ) × (Fin K → Fin d → ℝ) => z.2 j)
            (Q t ω) = μ0) ∧
        Q t ω {z | ∃ j : Fin K, z.1 = z.2 j} ≥
          ENNReal.ofReal (1 - q)) →
      ∃ γ : MeasureTheory.Measure
          (Ω × (Fin T → Fin K → Fin d → ℝ)),
        MeasureTheory.IsProbabilityMeasure γ ∧
        MeasureTheory.Measure.map
          (fun z : Ω × (Fin T → Fin K → Fin d → ℝ) => z.1) γ = μ ∧
        ProbabilityTheory.iIndepFun
          (fun ij : Fin T × Fin K =>
            fun z : Ω × (Fin T → Fin K → Fin d → ℝ) =>
              z.2 ij.1 ij.2) γ ∧
        (∀ ij : Fin T × Fin K,
          MeasureTheory.Measure.map
            (fun z : Ω × (Fin T → Fin K → Fin d → ℝ) =>
              z.2 ij.1 ij.2) γ = μ0) ∧
        ∀ t : Fin T,
          γ {z | ∃ j : Fin K, X t z.1 = z.2 t j} ≥
            ENNReal.ofReal (1 - q) := by
  classical
  intro T d K Ω mΩ μ hμ ℋx X P μ0 hμ0 q Q hT hK hq0 hq1 hℋ hP hQ
  have hX_hist (t : Fin T) :
      @Measurable Ω (Fin d → ℝ) (ℋx (t.val + 1)) inferInstance (X t) := by
    rw [hℋ (t.val + 1)]
    intro s hs
    exact MeasurableSpace.measurableSet_generateFrom
      ⟨t, Nat.lt_succ_self t.val, s, hs, rfl⟩
  have hX_meas (t : Fin T) : Measurable (X t) :=
    (hX_hist t).mono (ℋx.le (t.val + 1)) le_rfl
  have hjoint (t : Fin T) :
      @MeasureTheory.Measure.map Ω (Ω × (Fin d → ℝ)) mΩ
          ((ℋx t.val).prod inferInstance) (fun ω => (ω, X t ω)) μ =
        @MeasureTheory.Measure.compProd Ω (Fin d → ℝ) (ℋx t.val)
          inferInstance (μ.trim (ℋx.le t.val)) (P t) := by
    apply MeasureTheory.Measure.ext_prod
    intro s u hs hu
    letI : ProbabilityTheory.IsMarkovKernel (P t) := by
      constructor
      exact hP.1 t
    have hpair : @Measurable Ω (Ω × (Fin d → ℝ)) mΩ
        ((ℋx t.val).prod inferInstance) (fun ω => (ω, X t ω)) := by
      exact @Measurable.prodMk Ω mΩ Ω (Fin d → ℝ) (ℋx t.val)
        inferInstance id (X t) (measurable_id'' (ℋx.le t.val)) (hX_meas t)
    rw [MeasureTheory.Measure.map_apply hpair (hs.prod hu),
      MeasureTheory.Measure.compProd_apply_prod hs hu]
    change μ (s ∩ X t ⁻¹' u) =
      ∫⁻ a in s, P t a u ∂μ.trim (ℋx.le t.val)
    rw [MeasureTheory.setLIntegral_trim (ℋx.le t.val)
      ((P t).measurable_coe hu) hs]
    have hr_trim : (∫⁻ x in s, P t x u ∂μ.trim (ℋx.le t.val)) ≠ ⊤ := by
      rw [← MeasureTheory.Measure.compProd_apply_prod hs hu]
      exact MeasureTheory.measure_ne_top _ _
    have hr : (∫⁻ x in s, P t x u ∂μ) ≠ ⊤ := by
      rwa [MeasureTheory.setLIntegral_trim (ℋx.le t.val)
        ((P t).measurable_coe hu) hs] at hr_trim
    rw [← ENNReal.toReal_eq_toReal_iff'
      (MeasureTheory.measure_ne_top μ (s ∩ X t ⁻¹' u)) hr]
    let f : (Fin d → ℝ) → ℝ := u.indicator (fun _ => 1)
    have hf : Measurable f := measurable_const.indicator hu
    have hXu : MeasurableSet (X t ⁻¹' u) := hX_meas t hu
    have hs_ambient : MeasurableSet s := ℋx.le t.val s hs
    have hf_int : MeasureTheory.Integrable (fun ω => f (X t ω)) μ := by
      have hi := (MeasureTheory.integrable_const (μ := μ) (1 : ℝ)).indicator hXu
      have heq : (fun ω => f (X t ω)) =
          (X t ⁻¹' u).indicator (fun _ => (1 : ℝ)) := by
        funext ω
        by_cases hω : X t ω ∈ u <;> simp [f, hω]
      rw [heq]
      exact hi
    have hc := hP.2 t f hf hf_int
    have hc' : MeasureTheory.condExp (m := ℋx t.val) μ
        (fun ω => f (X t ω)) =ᵐ[μ]
          fun ω => (P t ω u).toReal := by
      filter_upwards [hc] with ω hω
      rw [hω]
      simp [f, MeasureTheory.measureReal_def, hu]
    have hp_meas : Measurable (fun ω => P t ω u) :=
      ((P t).measurable_coe hu).mono (ℋx.le t.val) le_rfl
    have hlin : (∫⁻ x in s, P t x u ∂μ).toReal =
        ∫ x in s, (P t x u).toReal ∂μ := by
      symm
      apply MeasureTheory.integral_toReal hp_meas.aemeasurable.restrict
      exact Filter.Eventually.of_forall fun ω =>
        MeasureTheory.measure_lt_top (P t ω) u
    calc
      (μ (s ∩ X t ⁻¹' u)).toReal =
          ∫ ω in s, f (X t ω) ∂μ := by
            have heq : (fun ω => f (X t ω)) =
                (X t ⁻¹' u).indicator (fun _ => (1 : ℝ)) := by
              funext ω
              by_cases hωu : X t ω ∈ u <;> simp [f, hωu]
            rw [heq, MeasureTheory.setIntegral_indicator hXu]
            simp [MeasureTheory.measureReal_def]
