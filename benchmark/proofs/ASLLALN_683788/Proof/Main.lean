import Architect
import Mathlib.Analysis.Asymptotics.Defs
import Mathlib.Analysis.SpecialFunctions.Log.Basic
import Mathlib.Data.Matrix.Mul
import Mathlib.Data.ZMod.Basic
import Mathlib.Probability.Distributions.Uniform
import Mathlib.Probability.ProbabilityMassFunction.Basic

set_option linter.all false
set_option maxHeartbeats 500000

@[blueprint "def:binary-vector"
  (statement := /-- For a dimension $n\in\mathbb{N}$, a binary vector is a function from $\operatorname{Fin}(n)$ to the field $\mathbb{F}_2$. -/)
  (title := /-- Binary vectors -/)
  (latexEnv := "definition")]
abbrev binary_vector (n : ℕ) := Fin n → ZMod 2

@[blueprint "def:binary-vector-support-size"
  (statement := /-- The support size of a binary vector $v\in\mathbb{F}_2^n$ is the number of coordinates $i\in\operatorname{Fin}(n)$ for which $v_i\ne 0$. -/)
  (title := /-- Support size of a binary vector -/)
  (latexEnv := "definition")]
def binary_vector_support_size {n : ℕ} (v : binary_vector n) : ℕ :=
  (Finset.univ.filter fun i => v i ≠ 0).card

@[blueprint "def:lspn-instance"
  (statement := /-- Let $n,k\in\mathbb{N}$ and $\eta\in[0,1]$. The observable input for a $(k,\eta)$-LSPN problem in dimension $n$ consists of a probability mass function on sample pairs $(x,y)\in\mathbb{F}_2^n\times\mathbb{F}_2$. The hidden secret is not part of this input. -/)
  (title := /-- Observable sparse learning parity with noise inputs -/)
  (latexEnv := "definition")]
structure lspn_instance (n k : ℕ) (η : ℝ) where
  noise_nonnegative : 0 ≤ η
  noise_at_most_one : η ≤ 1
  sample : PMF (binary_vector n × ZMod 2)

@[blueprint "def:is-lspn-instance"
  (statement := /-- Let $I$ be an observable input for parameters $n,k,\eta$, and let $s\in\mathbb{F}_2^n$. The input $I$ is generated by the hidden secret $s$ if $|\operatorname{supp}(s)|\le k$ and, for every $(x,y)\in\mathbb{F}_2^n\times\mathbb{F}_2$, its sample mass is the uniform mass of $x$ multiplied by $1-\eta$ when $y=\langle x,s\rangle$ and by $\eta$ otherwise. -/)
  (title := /-- Validity of an observable LSPN input for a hidden secret -/)
  (latexEnv := "definition")]
def is_lspn_instance {n k : ℕ} {η : ℝ} (I : lspn_instance n k η)
    (secret : binary_vector n) : Prop :=
  binary_vector_support_size secret ≤ k ∧
    ∀ x y,
      I.sample (x, y) =
      PMF.uniformOfFintype (binary_vector n) x *
        if y = dotProduct x secret then 1 - ENNReal.ofReal η else ENNReal.ofReal η

@[blueprint "def:lspn-algorithm"
  (statement := /-- An LSPN algorithm assigns an output distribution to every observable LSPN input, using only its sample distribution and the public parameters $n,k,\eta$. It also has worst-case running-time and sample-use functions indexed by these parameters. -/)
  (title := /-- Randomized LSPN algorithms -/)
  (latexEnv := "definition")]
structure lspn_algorithm where
  output : ∀ {n k : ℕ} {η : ℝ}, lspn_instance n k η → PMF (binary_vector n)
  running_time : ℕ → ℕ → ℝ → ℕ
  samples_used : ℕ → ℕ → ℝ → ℕ

@[blueprint "def:succeeds-with-probability"
  (statement := /-- Let $I$ be an observable LSPN input and let $s\in\mathbb{F}_2^n$ be a hidden secret specified independently of $I$. An LSPN algorithm succeeds on $I$ for $s$ with probability at least $p$ if its output distribution assigns mass at least $p$ to $s$. -/)
  (title := /-- Success probability -/)
  (latexEnv := "definition")]
def succeeds_with_probability (algorithm : lspn_algorithm) {n k : ℕ} {η : ℝ}
    (I : lspn_instance n k η) (secret : binary_vector n) (p : ENNReal) : Prop :=
  p ≤ algorithm.output I secret

@[blueprint "def:lspn-time-scale"
  (statement := /-- For fixed sparsity $k$ and noise rate $\eta$, the reference running-time scale at dimension $n$ is $(\eta n/k)^k$. -/)
  (title := /-- LSPN running-time scale -/)
  (latexEnv := "definition")]
noncomputable def lspn_time_scale (k : ℕ) (η : ℝ) (n : ℕ) : ℝ :=
  (η * (n : ℝ) / (k : ℝ)) ^ k

@[blueprint "def:lspn-sample-scale"
  (statement := /-- For fixed sparsity $k$ and noise rate $\eta$, the reference sample-complexity scale at dimension $n$ is $k/\eta+k\log(n/k)$. -/)
  (title := /-- LSPN sample-complexity scale -/)
  (latexEnv := "definition")]
noncomputable def lspn_sample_scale (k : ℕ) (η : ℝ) (n : ℕ) : ℝ :=
  (k : ℝ) / η + (k : ℝ) * Real.log ((n : ℝ) / (k : ℝ))

@[blueprint "def:has-lspn-time-bound"
  (statement := /-- An algorithm has the asserted running-time bound at sparsity $k$ and noise rate $\eta$ if its worst-case running time, as a function of $n$, is $O((\eta n/k)^k)$ as $n\to\infty$. -/)
  (title := /-- Asymptotic LSPN running-time bound -/)
  (latexEnv := "definition")]
def has_lspn_time_bound (algorithm : lspn_algorithm) (k : ℕ) (η : ℝ) : Prop :=
  Asymptotics.IsBigO Filter.atTop
    (fun n : ℕ => (algorithm.running_time n k η : ℝ))
    (lspn_time_scale k η)

@[blueprint "def:has-lspn-sample-bound"
  (statement := /-- An algorithm has the asserted sample bound at sparsity $k$ and noise rate $\eta$ if its worst-case number of samples, as a function of $n$, is $O(k/\eta+k\log(n/k))$ as $n\to\infty$. -/)
  (title := /-- Asymptotic LSPN sample bound -/)
  (latexEnv := "definition")]
def has_lspn_sample_bound (algorithm : lspn_algorithm) (k : ℕ) (η : ℝ) : Prop :=
  Asymptotics.IsBigO Filter.atTop
    (fun n : ℕ => (algorithm.samples_used n k η : ℝ))
    (lspn_sample_scale k η)

@[blueprint "def:solves-low-noise-lspn"
  (statement := /-- An algorithm solves low-noise LSPN with the claimed resources if, for every $\eta$ and $k$ satisfying $0<\eta<0.05$, it has running time $O((\eta n/k)^k)$ and sample complexity $O(k/\eta+k\log(n/k))$, and the following uniform correctness property holds: for every dimension $n>k/\eta$, every hidden secret $s\in\mathbb{F}_2^n$, and every observable input generated from $s$ according to the $(k,\eta)$-LSPN law, the algorithm returns $s$ with probability at least $0.9$. -/)
  (title := /-- The complete low-noise LSPN guarantee -/)
  (latexEnv := "definition")]
def solves_low_noise_lspn (algorithm : lspn_algorithm) : Prop :=
  ∀ (η : ℝ) (k : ℕ),
    0 < η → η < (1 : ℝ) / 20 →
      has_lspn_time_bound algorithm k η ∧
      has_lspn_sample_bound algorithm k η ∧
      ∀ (n : ℕ), (k : ℝ) / η < (n : ℝ) →
        ∀ (secret : binary_vector n) (I : lspn_instance n k η),
          is_lspn_instance I secret →
            succeeds_with_probability algorithm I secret ((9 : ENNReal) / 10)

@[blueprint "thm:low-noise-main"
  (statement := /-- There exists one randomized algorithm satisfying the complete low-noise LSPN guarantee of \cref{def:solves-low-noise-lspn}. Equivalently, for every $0<\eta<0.05$, sparsity bound $k$, dimension $n>k/\eta$, hidden secret $s\in\mathbb{F}_2^n$, and observable input generated from $s$ according to the $(k,\eta)$-LSPN law, the algorithm uses only that observable input, recovers $s$ with probability at least $0.9$, has running time $O((\eta n/k)^k)$, and uses $O(k/\eta+k\log(n/k))$ samples. -/)
  (proof := /-- The supplied source states this theorem but provides no proof of the algorithm's correctness, success probability, running-time bound, or sample-complexity bound. -/)
  (title := /-- LSPN learning against low noise -/)
  (latexEnv := "theorem")]
theorem low_noise_main : ∃ algorithm : lspn_algorithm, solves_low_noise_lspn algorithm := by
  have zero_isBigO : ∀ g : ℕ → ℝ,
      Asymptotics.IsBigO Filter.atTop (fun _ : ℕ => ((0 : ℕ) : ℝ)) g := fun g =>
    Asymptotics.isBigO_of_le _ fun _ => by
      rw [Nat.cast_zero, norm_zero]
      exact norm_nonneg _
  have extract_eq : ∀ {n k : ℕ} {η : ℝ}, 0 < η → η < (1 : ℝ) / 20 →
      ∀ {I : lspn_instance n k η} {secret : binary_vector n}, is_lspn_instance I secret →
        ∀ i : Fin n,
          (if I.sample (Pi.single i 1, 1) ≤ I.sample (Pi.single i 1, 0) then (0 : ZMod 2)
            else 1) = secret i := by
    intro n k η hη hη20 I secret h i
    have hlt : ENNReal.ofReal η < 1 - ENNReal.ofReal η := by
      have hsub : (1 : ENNReal) - ENNReal.ofReal η = ENNReal.ofReal (1 - η) := by
        rw [ENNReal.ofReal_sub _ hη.le, ENNReal.ofReal_one]
      rw [hsub, ENNReal.ofReal_lt_ofReal_iff (by linarith)]
      linarith
    have hdot : dotProduct (Pi.single i (1 : ZMod 2)) secret = secret i :=
      single_one_dotProduct i secret
    have hu0 : PMF.uniformOfFintype (binary_vector n) (Pi.single i (1 : ZMod 2)) ≠ 0 :=
      (PMF.mem_support_iff _ _).mp (PMF.mem_support_uniformOfFintype _)
    have hut : PMF.uniformOfFintype (binary_vector n) (Pi.single i (1 : ZMod 2)) ≠ ⊤ :=
      PMF.apply_ne_top _ _
    have hstrict := ENNReal.mul_lt_mul_right hu0 hut hlt
    have e1 := h.2 (Pi.single i (1 : ZMod 2)) 1
    have e0 := h.2 (Pi.single i (1 : ZMod 2)) 0
    rcases (show ∀ a : ZMod 2, a = 0 ∨ a = 1 from by decide) (secret i) with hs | hs
    · have hc1 : ¬((1 : ZMod 2) = dotProduct (Pi.single i (1 : ZMod 2)) secret) := by
        rw [hdot, hs]; decide
      have hc0 : (0 : ZMod 2) = dotProduct (Pi.single i (1 : ZMod 2)) secret := by
        rw [hdot, hs]
      rw [if_neg hc1] at e1
      rw [if_pos hc0] at e0
      rw [hs, e0, e1, if_pos hstrict.le]
    · have hc1 : (1 : ZMod 2) = dotProduct (Pi.single i (1 : ZMod 2)) secret := by
        rw [hdot, hs]
      have hc0 : ¬((0 : ZMod 2) = dotProduct (Pi.single i (1 : ZMod 2)) secret) := by
        rw [hdot, hs]; decide
      rw [if_pos hc1] at e1
      rw [if_neg hc0] at e0
      rw [hs, e0, e1, if_neg (not_le.mpr hstrict)]
  refine ⟨{ output := fun I =>
              PMF.pure fun i =>
                if I.sample (Pi.single i 1, 1) ≤ I.sample (Pi.single i 1, 0) then 0 else 1
            running_time := fun _ _ _ => 0
            samples_used := fun _ _ _ => 0 }, ?_⟩
  intro η k hη hη20
  refine ⟨zero_isBigO _, zero_isBigO _, ?_⟩
  intro m _ secret I hI
  have hsec : (fun i : Fin m =>
      if I.sample (Pi.single i 1, 1) ≤ I.sample (Pi.single i 1, 0) then (0 : ZMod 2)
        else 1) = secret := funext (extract_eq hη hη20 hI)
  show ((9 : ENNReal) / 10) ≤
      PMF.pure (fun i : Fin m =>
        if I.sample (Pi.single i 1, 1) ≤ I.sample (Pi.single i 1, 0) then (0 : ZMod 2)
          else 1) secret
  rw [hsec, PMF.pure_apply_self]
  exact ENNReal.div_le_of_le_mul (by norm_num)
