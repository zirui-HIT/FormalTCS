set_option linter.all false
set_option maxHeartbeats 500000

@[blueprint "def:online-point"
  (statement := /-- For a dimension $d\in\mathbb{N}$, the decision space is the real Euclidean space $\mathbb{R}^d$. -/)
  (title := /-- Finite-dimensional decision space -/)
  (latexEnv := "definition")]
abbrev online_point (d : ℕ) := EuclideanSpace ℝ (Fin d)

@[blueprint "def:lightons-problem"
  (statement := /-- A LightONS problem consists of a positive dimension $d$, a nonempty compact convex domain $\mathcal X\subset\mathbb{R}^d$ of diameter at most $D$ contained in the ball of radius $D/2$, and a sequence of differentiable losses $f_t$.  For every $t\in\mathbb N$ and $x\in\mathcal X$, the chosen vector $\nabla f_t(x)$ is a gradient of $f_t$ within $\mathcal X$ and satisfies $\|\nabla f_t(x)\|\leq G$; moreover, every $f_t$ is $G$-Lipschitz on $\mathcal X$, and $x\mapsto\exp(-\alpha f_t(x))$ is concave on $\mathcal X$.  The parameters satisfy $D,G,\alpha,\varepsilon>0$, $k>1$, $c_f,c_g\geq 1$, $2<\omega\leq 3$, and the Euclidean-projection cost $\mathrm{EP}_{\mathcal X}$ is nonnegative. -/)
  (title := /-- LightONS problem data and standing assumptions -/)
  (latexEnv := "definition")]
structure lightons_problem where
  dimension : ℕ
  dimension_pos : 0 < dimension
  diameter : ℝ
  diameter_pos : 0 < diameter
  gradientBound : ℝ
  gradientBound_pos : 0 < gradientBound
  expConcavity : ℝ
  expConcavity_pos : 0 < expConcavity
  epsilon : ℝ
  epsilon_pos : 0 < epsilon
  deferral : ℝ
  one_lt_deferral : 1 < deferral
  conversionLoss : ℝ
  one_le_conversionLoss : 1 ≤ conversionLoss
  conversionGradient : ℝ
  one_le_conversionGradient : 1 ≤ conversionGradient
  matrixExponent : ℝ
  two_lt_matrixExponent : 2 < matrixExponent
  matrixExponent_le_three : matrixExponent ≤ 3
  projectionCost : ℝ
  projectionCost_nonneg : 0 ≤ projectionCost
  domain : Set (online_point dimension)
  domain_nonempty : domain.Nonempty
  domain_convex : Convex ℝ domain
  domain_compact : IsCompact domain
  domain_diameter : Metric.diam domain ≤ diameter
  domain_radius : ∀ x ∈ domain, ‖x‖ ≤ diameter / 2
  loss : ℕ → online_point dimension → ℝ
  lossGradient : ℕ → online_point dimension → online_point dimension
  loss_hasGradient : ∀ t x, x ∈ domain →
    HasGradientWithinAt (loss t) (lossGradient t x) domain x
  lossGradient_norm : ∀ t x, x ∈ domain →
    ‖lossGradient t x‖ ≤ gradientBound
  loss_lipschitz : ∀ t x, x ∈ domain → ∀ y, y ∈ domain →
    |loss t x - loss t y| ≤ gradientBound * dist x y
  loss_expConcave : ∀ t,
    ConcaveOn ℝ domain (fun x => Real.exp (-expConcavity * loss t x))

@[blueprint "def:lightons-run"
  (statement := /-- For a problem from \cref{def:lightons-problem}, a run record consists of decisions $x_t\in\mathcal X$, expanded-domain points $y_t\in B(kD/2)$, surrogate gradients $\nabla g_t(y_t)$, their computation times, and a cumulative runtime.  The surrogate gradients take $O(\mathrm{EP}_{\mathcal X}+d)$ time and obey $\|\nabla g_t(y_t)\|\leq c_g\|\nabla f_t(x_t)\|$ and $\langle\nabla f_t(x_t),x_t-u\rangle\leq c_f\langle\nabla g_t(y_t),y_t-u\rangle$ for every $u\in\mathcal X$.  This record contains observable data and side conditions only; \cref{def:is-lightons-run} specifies when it is generated by LightONS. -/)
  (title := /-- Observable run data and domain-conversion conditions -/)
  (latexEnv := "definition")]
structure lightons_run (P : lightons_problem) where
  decision : ℕ → online_point P.dimension
  surrogatePoint : ℕ → online_point P.dimension
  surrogateGradient : ℕ → online_point P.dimension
  surrogateGradientRuntime : ℕ → ℝ
  runtime : ℕ → ℝ
  decision_mem : ∀ t, decision t ∈ P.domain
  surrogatePoint_mem : ∀ t, ‖surrogatePoint t‖ ≤ P.deferral * P.diameter / 2
  surrogateGradientRuntime_nonneg : ∀ t, 0 ≤ surrogateGradientRuntime t
  runtime_nonneg : ∀ T, 0 ≤ runtime T
  surrogateGradient_cost : Asymptotics.IsBigO Filter.atTop surrogateGradientRuntime
    (fun _ : ℕ => P.projectionCost + (P.dimension : ℝ))
  surrogateGradient_norm : ∀ t,
    ‖surrogateGradient t‖ ≤
      P.conversionGradient * ‖P.lossGradient t (decision t)‖
  domainConversion : ∀ t u, u ∈ P.domain →
    inner ℝ (P.lossGradient t (decision t)) (decision t - u) ≤
      P.conversionLoss * inner ℝ (surrogateGradient t) (surrogatePoint t - u)

@[blueprint "def:online-regret"
  (statement := /-- For a run from \cref{def:lightons-run}, a horizon $T\in\mathbb{N}$, and a comparator $u\in\mathcal X$, the regret is
  \[
    \operatorname{Reg}_T(u)=\sum_{t=0}^{T-1}\bigl(f_t(x_t)-f_t(u)\bigr).
  \] -/)
  (title := /-- Regret against a fixed comparator -/)
  (latexEnv := "definition")]
def online_regret (P : lightons_problem) (run : lightons_run P)
    (T : ℕ) (u : online_point P.dimension) : ℝ :=
  ∑ t ∈ Finset.range T, (P.loss t (run.decision t) - P.loss t u)

@[blueprint "def:gamma-prime"
  (statement := /-- For the parameters of \cref{def:lightons-problem}, define
  \[
    \gamma'=\frac12\min\left\{\frac1{DG},\alpha,
      \frac4{(k+1)c_fc_gDG}\right\}.
  \] -/)
  (title := /-- Curvature parameter -/)
  (latexEnv := "definition")]
noncomputable def gamma_prime (P : lightons_problem) : ℝ :=
  (1 / 2 : ℝ) * min (1 / (P.diameter * P.gradientBound))
    (min P.expConcavity
      (4 / ((P.deferral + 1) * P.conversionLoss * P.conversionGradient *
        P.diameter * P.gradientBound)))

@[blueprint "def:is-lightons-run"
  (statement := /-- Let $P$ be as in \cref{def:lightons-problem} and let $R$ be an observable run record as in \cref{def:lightons-run}.  Write $y_t$ for its surrogate point and $\bar g_t=c_f\nabla g_t(y_t)$.  The predicate \(operatorname{IsLightONSRun}(P,R)\) holds precisely when there are symmetric-metric coefficients $A_t$ and unconstrained proposals $z_{t+1}$ satisfying
  \[
    y_0=0,\qquad A_0(v,w)=\varepsilon\langle v,w\rangle,\qquad
    A_{t+1}(v,w)=A_t(v,w)+\langle\bar g_t,v\rangle\langle\bar g_t,w\rangle,
  \]
  and $z_{t+1}$ minimizes
  \[
    z\longmapsto \langle\bar g_t,z-y_t\rangle+
      \frac{\gamma'}2 A_{t+1}(z-y_t,z-y_t)
  \]
  over $\mathbb R^d$.  If $z_{t+1}\in B(kD/2)$, then $y_{t+1}=z_{t+1}$; otherwise $y_{t+1}$ is an $A_{t+1}$-projection of $z_{t+1}$ onto $\mathcal X$.  At every round, $x_t$ is a Euclidean projection of $y_t$ onto $\mathcal X$.  Finally, the recorded cumulative runtime is the sum of the recorded surrogate-gradient cost, one Euclidean projection, the quadratic-time rank-one update, and, exactly on deferred-projection rounds, a $d^\omega$ metric-projection cost. -/)
  (title := /-- Declarative LightONS initialization, update, output, and cost invariant -/)
  (latexEnv := "definition")]
noncomputable def is_lightons_run (P : lightons_problem) (run : lightons_run P) : Prop :=
  ∃ (metric : ℕ → online_point P.dimension → online_point P.dimension → ℝ)
      (proposal : ℕ → online_point P.dimension),
    run.surrogatePoint 0 = 0 ∧
    (∀ v w, metric 0 v w = P.epsilon * inner ℝ v w) ∧
    (∀ t v w,
      metric (t + 1) v w =
        metric t v w +
          inner ℝ (P.conversionLoss • run.surrogateGradient t) v *
            inner ℝ (P.conversionLoss • run.surrogateGradient t) w) ∧
    (∀ t z,
      inner ℝ (P.conversionLoss • run.surrogateGradient t)
          (proposal t - run.surrogatePoint t) +
          gamma_prime P / 2 *
            metric (t + 1) (proposal t - run.surrogatePoint t)
              (proposal t - run.surrogatePoint t) ≤
        inner ℝ (P.conversionLoss • run.surrogateGradient t)
          (z - run.surrogatePoint t) +
          gamma_prime P / 2 *
            metric (t + 1) (z - run.surrogatePoint t)
              (z - run.surrogatePoint t)) ∧
    (∀ t,
      if ‖proposal t‖ ≤ P.deferral * P.diameter / 2 then
        run.surrogatePoint (t + 1) = proposal t
      else
        run.surrogatePoint (t + 1) ∈ P.domain ∧
          ∀ u, u ∈ P.domain →
            metric (t + 1) (run.surrogatePoint (t + 1) - proposal t)
                (run.surrogatePoint (t + 1) - proposal t) ≤
              metric (t + 1) (u - proposal t) (u - proposal t)) ∧
    (∀ t u, u ∈ P.domain →
      dist (run.decision t) (run.surrogatePoint t) ≤
        dist u (run.surrogatePoint t)) ∧
    (∀ T,
      run.runtime T =
        ∑ t ∈ Finset.range T,
          (run.surrogateGradientRuntime t + P.projectionCost +
            (P.dimension : ℝ) ^ 2 +
            if ‖proposal t‖ ≤ P.deferral * P.diameter / 2 then 0
            else Real.rpow (P.dimension : ℝ) P.matrixExponent))

@[blueprint "def:lightons-regret-bound"
  (statement := /-- For a problem from \cref{def:lightons-problem}, the asserted regret upper bound at horizon $T$ is
  \[
    \frac{d}{2\gamma'}\log\left(1+
      \frac{c_f^2c_g^2G^2}{d\varepsilon}T\right)
      +\frac{\gamma'\varepsilon D^2}{8},
  \]
  where $\gamma'$ is given by \cref{def:gamma-prime}. -/)
  (title := /-- LightONS regret-bound expression -/)
  (latexEnv := "definition")]
noncomputable def lightons_regret_bound (P : lightons_problem) (T : ℕ) : ℝ :=
  (P.dimension : ℝ) / (2 * gamma_prime P) *
      Real.log (1 +
        (P.conversionLoss ^ 2 * P.conversionGradient ^ 2 * P.gradientBound ^ 2 /
          ((P.dimension : ℝ) * P.epsilon)) * (T : ℝ)) +
    gamma_prime P * P.epsilon * P.diameter ^ 2 / 8

@[blueprint "def:lightons-runtime-scale"
  (statement := /-- For a problem from \cref{def:lightons-problem}, the reference scale in the runtime estimate is
  \[
    (\mathrm{EP}_{\mathcal X}+d^2)T
      +(k-1)^{-1}d^{\omega+1/2}\sqrt{T/\varepsilon}\log T.
  \] -/)
  (title := /-- LightONS runtime reference scale -/)
  (latexEnv := "definition")]
noncomputable def lightons_runtime_scale (P : lightons_problem) (T : ℕ) : ℝ :=
  (P.projectionCost + (P.dimension : ℝ) ^ 2) * (T : ℝ) +
    (P.deferral - 1)⁻¹ *
      Real.rpow (P.dimension : ℝ) (P.matrixExponent + 0.5) *
      Real.sqrt ((T : ℝ) / P.epsilon) * Real.log (T : ℝ)

@[blueprint "lem:lightons-log-quadratic"
  (statement := /-- If $c\in(0,1]$, $1+x>0$, and $|cx|\leq1$, then
  \[
    \log(1+x)\leq x-\frac{c x^2}{4}.
  \] -/)
  (proof := /-- Put $F(x)=x-cx^2/4-\log(1+x)$.  On the interval between $0$ and $x$,
  \[
    F'(z)=\frac{z(1-c(1+z)/2)}{1+z}.
  \]
  The assumptions give $1+z>0$ and $c(1+z)\leq2$.  Thus $F'$ has the sign of $z$: $F$ is increasing to the right of $0$ and decreasing to the left of $0$.  Since $F(0)=0$, in either case $F(x)\geq0$. -/)
  (title := /-- A quadratic upper bound for the logarithm -/)
  (latexEnv := "lemma")]
lemma lightons_log_quadratic {c x : ℝ} (hc : 0 < c) (hc_one : c ≤ 1)
    (hx : 0 < 1 + x) (hcx : |c * x| ≤ 1) :
    Real.log (1 + x) ≤ x - c * x ^ 2 / 4 := by
  rw [Real.log_le_iff_le_exp hx]
  let R : ℝ := x - c * x ^ 2 / 4
  by_cases hx_nonneg : 0 ≤ x
  · have hcx_nonneg : 0 ≤ c * x := mul_nonneg hc.le hx_nonneg
    have hcx_upper : c * x ≤ 1 := le_trans (le_abs_self (c * x)) hcx
    have hR : R = x * (1 - c * x / 4) := by dsimp [R]; ring
    have hR_nonneg : 0 ≤ R := by
      rw [hR]
      exact mul_nonneg hx_nonneg (by nlinarith)
    have hK : 0 ≤ (1 / 2 : ℝ) - c / 4 - (c * x) / 4 + (c * x) ^ 2 / 32 := by
      nlinarith [sq_nonneg (c * x)]
    have hbase : 1 + x ≤ 1 + R + R ^ 2 / 2 := by
      rw [hR]
      have hsquare := mul_nonneg (sq_nonneg x) hK
      nlinarith
    exact hbase.trans (Real.quadratic_le_exp_of_nonneg hR_nonneg)
  · have hx_neg : x < 0 := lt_of_not_ge hx_nonneg
    have hc_nonneg : 0 ≤ c := hc.le
    have hx_sq_le : x ^ 2 ≤ 1 := by
      have hprod : 0 ≤ (1 + x) * (-x) := mul_nonneg hx.le (neg_nonneg.mpr hx_neg.le)
      nlinarith
    have hcx_sq_le : c * x ^ 2 ≤ x ^ 2 :=
      mul_le_of_le_one_left (sq_nonneg x) hc_one
    let t : ℝ := -R
    have ht : t = -x + c * x ^ 2 / 4 := by dsimp [t, R]; ring
    have ht_nonneg : 0 ≤ t := by
      rw [ht]
      exact add_nonneg (neg_nonneg.mpr hx_neg.le)
        (div_nonneg (mul_nonneg hc_nonneg (sq_nonneg x)) (by norm_num))
    have ht_two : t ≤ (2 : ℕ) := by rw [ht]; norm_num; nlinarith
    have ht_sq : c * x ^ 2 ≤ t ^ 2 := by
      have hplus : 0 ≤ t + x := by rw [ht]; nlinarith
      have hminus : 0 ≤ t - x := by rw [ht]; nlinarith
      have hdiff := mul_nonneg hplus hminus
      nlinarith
    have hbase : 1 + x ≤ (1 - t / (2 : ℕ)) ^ (2 : ℕ) := by
      norm_num
      nlinarith
    calc
      1 + x ≤ (1 - t / (2 : ℕ)) ^ (2 : ℕ) := hbase
      _ ≤ Real.exp (-t) := Real.one_sub_div_pow_le_exp_neg ht_two
      _ = Real.exp R := by simp [t]

@[blueprint "lem:lightons-gamma-prime-pos"
  (statement := /-- For every LightONS problem $P$, the curvature parameter $\gamma'$ defined in \cref{def:gamma-prime} is strictly positive. -/)
  (proof := /-- Each of $(DG)^{-1}$, $\alpha$, and $4/((k+1)c_fc_gDG)$ is strictly positive by the parameter hypotheses in \cref{def:lightons-problem}.  Their iterated minimum is therefore positive, and multiplication by $1/2$ preserves strict positivity. -/)
  (title := /-- Positivity of the LightONS curvature parameter -/)
  (latexEnv := "lemma")]
lemma lightons_gamma_prime_pos (P : lightons_problem) : 0 < gamma_prime P := by
  unfold gamma_prime
  have hdiameter_gradient : 0 < P.diameter * P.gradientBound :=
    mul_pos P.diameter_pos P.gradientBound_pos
  have hconversion :
      0 < (P.deferral + 1) * P.conversionLoss * P.conversionGradient *
        P.diameter * P.gradientBound := by
    have hk : 0 < P.deferral + 1 := by linarith [P.one_lt_deferral]
    have hcf : 0 < P.conversionLoss := lt_of_lt_of_le zero_lt_one P.one_le_conversionLoss
    have hcg : 0 < P.conversionGradient :=
      lt_of_lt_of_le zero_lt_one P.one_le_conversionGradient
    exact mul_pos (mul_pos (mul_pos (mul_pos hk hcf) hcg) P.diameter_pos)
      P.gradientBound_pos
  have hfirst : 0 < 1 / (P.diameter * P.gradientBound) := one_div_pos.mpr hdiameter_gradient
  have hthird : 0 < 4 / ((P.deferral + 1) * P.conversionLoss * P.conversionGradient *
      P.diameter * P.gradientBound) := div_pos (by norm_num) hconversion
  exact mul_pos (by norm_num) (lt_min hfirst (lt_min P.expConcavity_pos hthird))

@[blueprint "lem:lightons-loss-step"
  (statement := /-- For a LightONS problem $P$, an observable run $R$, a round $t$, and a comparator $u\in\mathcal X$, put $\bar g_t=c_f\nabla g_t(y_t)$.  Then
  \[
    f_t(x_t)-f_t(u)\leq
      \langle\bar g_t,y_t-u\rangle
      -\frac{\gamma'}2\langle\bar g_t,y_t-u\rangle^2.
  \] -/)
  (proof := /-- Concavity of $\exp(-\alpha f_t)$ from \cref{def:lightons-problem}, restricted to the segment from $x_t$ to $u$, and the chosen within-domain gradient give
  \[
    \exp\!\bigl(\alpha(f_t(x_t)-f_t(u))\bigr)
      \leq1+\alpha\langle\nabla f_t(x_t),x_t-u\rangle.
  \]
  Apply \cref{lem:lightons-log-quadratic} with $c=2\gamma'/\alpha$.  Positivity from \cref{lem:lightons-gamma-prime-pos}, the definition \cref{def:gamma-prime}, the gradient bound, and the diameter bound verify $0<c\leq1$ and the required scaled-inner-product bound.  This yields the quadratic estimate with the true gradient.  Finally, the domain-conversion inequality in \cref{def:lightons-run} and the bounds on the surrogate point and surrogate gradient show that replacing the true-gradient inner product by $\langle\bar g_t,y_t-u\rangle$ can only increase the same quadratic expression. -/)
  (title := /-- Exp-concave one-step loss estimate -/)
  (latexEnv := "lemma")]
lemma lightons_loss_step (P : lightons_problem) (run : lightons_run P) (t : ℕ)
    (u : online_point P.dimension) (hu : u ∈ P.domain) :
    P.loss t (run.decision t) - P.loss t u ≤
      inner ℝ (P.conversionLoss • run.surrogateGradient t) (run.surrogatePoint t - u) -
        gamma_prime P / 2 *
          inner ℝ (P.conversionLoss • run.surrogateGradient t)
            (run.surrogatePoint t - u) ^ 2 := by
  let x := run.decision t
  let grad := P.lossGradient t x
  let a := inner ℝ grad (x - u)
  let b := inner ℝ (P.conversionLoss • run.surrogateGradient t)
    (run.surrogatePoint t - u)
  let F : ℝ → online_point P.dimension := fun s => x + s • (u - x)
  have hx : x ∈ P.domain := run.decision_mem t
  have hsegment : Set.Icc (0 : ℝ) 1 ⊆
      F ⁻¹' P.domain := by
    intro s hs
    simpa [F, AffineMap.lineMap_apply, add_comm] using
      P.domain_convex.lineMap_mem hx hu hs
  have hconcave : ConcaveOn ℝ (Set.Icc (0 : ℝ) 1)
      (fun s => Real.exp (-P.expConcavity * P.loss t (F s))) := by
    have hpre := (P.loss_expConcave t).comp_affineMap (AffineMap.lineMap x u)
    refine ⟨convex_Icc (0 : ℝ) 1, ?_⟩
    intro z hz w hw c d hc hd hcd
    simpa [F, AffineMap.lineMap_apply, add_comm] using
      hpre.2 (P.domain_convex.lineMap_mem hx hu hz)
        (P.domain_convex.lineMap_mem hx hu hw) hc hd hcd
  have hgrad := (P.loss_hasGradient t x hx).hasFDerivWithinAt
  rw [show x = F 0 by simp [F]] at hgrad
  have hline : HasDerivWithinAt F (u - x) (F ⁻¹' P.domain) 0 := by
    have hline' : HasDerivWithinAt F (0 + (1 : ℝ) • (u - x))
        (F ⁻¹' P.domain) 0 :=
      ((hasDerivAt_const (0 : ℝ) x).add
        ((hasDerivAt_id' (0 : ℝ)).smul_const (u - x))).hasDerivWithinAt
    simpa using hline'
  have hcomp := hgrad.comp_hasDerivWithinAt (x := (0 : ℝ)) hline
    (Set.mapsTo_preimage F P.domain)
  have hloss := hcomp.mono hsegment
  have hslope_deriv := ((hloss.const_mul (-P.expConcavity)).exp)
  have hslope : slope
      (fun s : ℝ => Real.exp (-P.expConcavity * P.loss t (F s))) 0 1 ≤
      Real.exp (-P.expConcavity * P.loss t (F 0)) *
        (-P.expConcavity *
          ((InnerProductSpace.toDual ℝ (online_point P.dimension))
            (P.lossGradient t (F 0))) (u - x)) := by
    letI : (nhdsWithin (0 : ℝ) (Set.Icc (0 : ℝ) 1 \ {0})).NeBot := by
      rw [← mem_closure_iff_nhdsWithin_neBot]
      have hset : Set.Icc (0 : ℝ) 1 \ {0} = Set.Ioc 0 1 := by
        ext z
        simp only [Set.mem_diff, Set.mem_Icc, Set.mem_singleton_iff, Set.mem_Ioc]
        constructor
        · rintro ⟨⟨hz0, hz1⟩, hzne⟩
          exact ⟨lt_of_le_of_ne hz0 (Ne.symm hzne), hz1⟩
        · rintro ⟨hz0, hz1⟩
          exact ⟨⟨hz0.le, hz1⟩, ne_of_gt hz0⟩
      rw [hset, closure_Ioc (by norm_num : (0 : ℝ) ≠ 1)]
      simp
    apply ge_of_tendsto (hasDerivWithinAt_iff_tendsto_slope.mp hslope_deriv)
    filter_upwards [self_mem_nhdsWithin] with s hs
    rcases hs with ⟨⟨hs0, hs1⟩, hsne⟩
    have hconc := hconcave.2 (x := (0 : ℝ)) (y := (1 : ℝ))
      (by simp) (by simp) (sub_nonneg.mpr hs1) hs0 (by ring)
    have hspos : 0 < s := lt_of_le_of_ne hs0 (Ne.symm hsne)
    simp only [slope, sub_zero, inv_one, one_smul]
    rw [smul_eq_mul, inv_mul_eq_div]
    apply (le_div_iff₀ hspos).2
    simp [F] at hconc ⊢
    nlinarith
  have ha_exp : Real.exp (P.expConcavity *
      (P.loss t x - P.loss t u)) ≤ 1 + P.expConcavity * a := by
    have hepos : 0 < Real.exp (-P.expConcavity * P.loss t x) := Real.exp_pos _
    have hraw :
      Real.exp (-P.expConcavity * P.loss t u) ≤
        Real.exp (-P.expConcavity * P.loss t x) *
          (1 + P.expConcavity * a) := by
      have ha_neg : a = -inner ℝ grad (u - x) := by
        dsimp [a]
        rw [sub_eq_add_neg, sub_eq_add_neg, inner_add_right, inner_add_right,
          inner_neg_right, inner_neg_right]
        ring
      have hs := hslope
      simp [slope, F, grad] at hs
      calc
        Real.exp (-P.expConcavity * P.loss t u) ≤
            Real.exp (-P.expConcavity * P.loss t x) -
              Real.exp (-P.expConcavity * P.loss t x) *
                (P.expConcavity * inner ℝ grad (u - x)) :=
          (le_sub_iff_add_le).2 (by simpa [add_comm] using hs)
        _ = Real.exp (-P.expConcavity * P.loss t x) *
            (1 + P.expConcavity * a) := by rw [ha_neg]; ring
    have hdiv : Real.exp (-P.expConcavity * P.loss t u) /
        Real.exp (-P.expConcavity * P.loss t x) ≤ 1 + P.expConcavity * a :=
      (div_le_iff₀ hepos).2 (by simpa [mul_comm] using hraw)
    calc
      Real.exp (P.expConcavity * (P.loss t x - P.loss t u)) =
          Real.exp (-P.expConcavity * P.loss t u) /
            Real.exp (-P.expConcavity * P.loss t x) := by
        rw [← Real.exp_sub]
        congr 2
        ring
      _ ≤ 1 + P.expConcavity * a := hdiv
  have ha_pos : 0 < 1 + P.expConcavity * a :=
    lt_of_lt_of_le (Real.exp_pos _) ha_exp
  have ha_norm : |a| ≤ P.gradientBound * P.diameter := by
    have hgrad : ‖grad‖ ≤ P.gradientBound := P.lossGradient_norm t x hx
    have hxu : ‖x - u‖ ≤ P.diameter := by
      calc
        ‖x - u‖ ≤ ‖x‖ + ‖u‖ := norm_sub_le x u
        _ ≤ P.diameter / 2 + P.diameter / 2 :=
          add_le_add (P.domain_radius x hx) (P.domain_radius u hu)
        _ = P.diameter := by ring
    calc
      |a| ≤ ‖grad‖ * ‖x - u‖ := by exact abs_real_inner_le_norm grad (x - u)
      _ ≤ P.gradientBound * P.diameter :=
        mul_le_mul hgrad hxu (norm_nonneg _) (le_of_lt P.gradientBound_pos)
  have hgamma_alpha : 2 * gamma_prime P ≤ P.expConcavity := by
    unfold gamma_prime
    have hm := min_le_right (1 / (P.diameter * P.gradientBound))
      (min P.expConcavity
        (4 / ((P.deferral + 1) * P.conversionLoss * P.conversionGradient *
          P.diameter * P.gradientBound)))
    have hm' := min_le_left P.expConcavity
      (4 / ((P.deferral + 1) * P.conversionLoss * P.conversionGradient *
        P.diameter * P.gradientBound))
    nlinarith
  have hgamma_dg : 2 * gamma_prime P * (P.diameter * P.gradientBound) ≤ 1 := by
    unfold gamma_prime
    have hm := min_le_left (1 / (P.diameter * P.gradientBound))
      (min P.expConcavity
        (4 / ((P.deferral + 1) * P.conversionLoss * P.conversionGradient *
          P.diameter * P.gradientBound)))
    have hdg := mul_pos P.diameter_pos P.gradientBound_pos
    calc
      2 * (1 / 2 * min (1 / (P.diameter * P.gradientBound))
          (min P.expConcavity
            (4 / ((P.deferral + 1) * P.conversionLoss * P.conversionGradient *
              P.diameter * P.gradientBound)))) *
          (P.diameter * P.gradientBound) =
          min (1 / (P.diameter * P.gradientBound))
            (min P.expConcavity
              (4 / ((P.deferral + 1) * P.conversionLoss * P.conversionGradient *
                P.diameter * P.gradientBound))) *
            (P.diameter * P.gradientBound) := by ring
      _ ≤ (1 / (P.diameter * P.gradientBound)) *
          (P.diameter * P.gradientBound) :=
        mul_le_mul_of_nonneg_right hm hdg.le
      _ = 1 := by
        rw [one_div, inv_mul_cancel₀ (ne_of_gt hdg)]
  have hc_pos : 0 < 2 * gamma_prime P / P.expConcavity :=
    div_pos (mul_pos (by norm_num) (lightons_gamma_prime_pos P)) P.expConcavity_pos
  have hc_one : 2 * gamma_prime P / P.expConcavity ≤ 1 :=
    (div_le_one P.expConcavity_pos).2 hgamma_alpha
  have hscaled : |(2 * gamma_prime P / P.expConcavity) *
      (P.expConcavity * a)| ≤ 1 := by
    rw [show (2 * gamma_prime P / P.expConcavity) * (P.expConcavity * a) =
      2 * gamma_prime P * a by field_simp [ne_of_gt P.expConcavity_pos]]
    rw [abs_mul, abs_of_pos (mul_pos (by norm_num) (lightons_gamma_prime_pos P))]
    calc
      2 * gamma_prime P * |a| ≤
          2 * gamma_prime P * (P.gradientBound * P.diameter) :=
        mul_le_mul_of_nonneg_left ha_norm
          (mul_nonneg (by norm_num) (lightons_gamma_prime_pos P).le)
      _ = 2 * gamma_prime P * (P.diameter * P.gradientBound) := by ring
      _ ≤ 1 := hgamma_dg
  have hlog := lightons_log_quadratic hc_pos hc_one ha_pos hscaled
  have ha_quad : P.loss t x - P.loss t u ≤ a - gamma_prime P / 2 * a ^ 2 := by
    have htake_log : P.expConcavity * (P.loss t x - P.loss t u) ≤
        Real.log (1 + P.expConcavity * a) :=
      (Real.le_log_iff_exp_le ha_pos).2 ha_exp
    have halpha := P.expConcavity_pos
    have hmul : P.expConcavity * (P.loss t x - P.loss t u) ≤
        P.expConcavity * (a - gamma_prime P / 2 * a ^ 2) := calc
      P.expConcavity * (P.loss t x - P.loss t u) ≤
          Real.log (1 + P.expConcavity * a) := htake_log
      _ ≤ P.expConcavity * a -
          (2 * gamma_prime P / P.expConcavity) *
            (P.expConcavity * a) ^ 2 / 4 := hlog
      _ = P.expConcavity * (a - gamma_prime P / 2 * a ^ 2) := by
        field_simp [ne_of_gt P.expConcavity_pos]
        ring
    nlinarith
  have hab : a ≤ b := by
    dsimp [a, b, x, grad]
    rw [inner_smul_left]
    simpa using run.domainConversion t u hu
  have hb_upper : gamma_prime P * b ≤ 1 := by
    have hcf : 0 ≤ P.conversionLoss := le_trans zero_le_one P.one_le_conversionLoss
    have hcg : 0 ≤ P.conversionGradient := le_trans zero_le_one P.one_le_conversionGradient
    have hsg : ‖run.surrogateGradient t‖ ≤
        P.conversionGradient * P.gradientBound :=
      (run.surrogateGradient_norm t).trans
        (mul_le_mul_of_nonneg_left (P.lossGradient_norm t x hx) hcg)
    have hyu : ‖run.surrogatePoint t - u‖ ≤
        (P.deferral + 1) * P.diameter / 2 := by
      calc
        ‖run.surrogatePoint t - u‖ ≤ ‖run.surrogatePoint t‖ + ‖u‖ :=
          norm_sub_le _ _
        _ ≤ P.deferral * P.diameter / 2 + P.diameter / 2 :=
          add_le_add (run.surrogatePoint_mem t) (P.domain_radius u hu)
        _ = (P.deferral + 1) * P.diameter / 2 := by ring
    have hb : b ≤ P.conversionLoss * P.conversionGradient * P.gradientBound *
        ((P.deferral + 1) * P.diameter / 2) := by
      calc
        b ≤ |b| := le_abs_self b
        _ ≤ ‖P.conversionLoss • run.surrogateGradient t‖ *
            ‖run.surrogatePoint t - u‖ := by
          exact abs_real_inner_le_norm _ _
        _ ≤ (P.conversionLoss * (P.conversionGradient * P.gradientBound)) *
            ((P.deferral + 1) * P.diameter / 2) := by
          rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hcf]
          exact mul_le_mul (mul_le_mul_of_nonneg_left hsg hcf) hyu
            (norm_nonneg _) (mul_nonneg hcf (mul_nonneg hcg P.gradientBound_pos.le))
        _ = P.conversionLoss * P.conversionGradient * P.gradientBound *
            ((P.deferral + 1) * P.diameter / 2) := by ring
    have hm' := min_le_right P.expConcavity
      (4 / ((P.deferral + 1) * P.conversionLoss * P.conversionGradient *
        P.diameter * P.gradientBound))
    have hden : 0 < (P.deferral + 1) * P.conversionLoss * P.conversionGradient *
        P.diameter * P.gradientBound := by
      have hk : 0 < P.deferral + 1 := by linarith [P.one_lt_deferral]
      have hcfpos : 0 < P.conversionLoss := lt_of_lt_of_le zero_lt_one P.one_le_conversionLoss
      have hcgpos : 0 < P.conversionGradient :=
        lt_of_lt_of_le zero_lt_one P.one_le_conversionGradient
      exact mul_pos (mul_pos (mul_pos (mul_pos hk hcfpos) hcgpos) P.diameter_pos)
        P.gradientBound_pos
    have hgamma_bound : gamma_prime P ≤ 2 / ((P.deferral + 1) *
        P.conversionLoss * P.conversionGradient * P.diameter * P.gradientBound) := by
      unfold gamma_prime
      have hm := min_le_right (1 / (P.diameter * P.gradientBound))
        (min P.expConcavity
          (4 / ((P.deferral + 1) * P.conversionLoss * P.conversionGradient *
            P.diameter * P.gradientBound)))
      have hall := hm.trans hm'
      calc
        1 / 2 * min (1 / (P.diameter * P.gradientBound))
            (min P.expConcavity
              (4 / ((P.deferral + 1) * P.conversionLoss * P.conversionGradient *
                P.diameter * P.gradientBound))) ≤
            1 / 2 * (4 / ((P.deferral + 1) * P.conversionLoss *
              P.conversionGradient * P.diameter * P.gradientBound)) :=
          mul_le_mul_of_nonneg_left hall (by norm_num)
        _ = 2 / ((P.deferral + 1) * P.conversionLoss * P.conversionGradient *
            P.diameter * P.gradientBound) := by ring
    calc
      gamma_prime P * b ≤ gamma_prime P *
          (P.conversionLoss * P.conversionGradient * P.gradientBound *
            ((P.deferral + 1) * P.diameter / 2)) :=
        mul_le_mul_of_nonneg_left hb (lightons_gamma_prime_pos P).le
      _ = gamma_prime P *
          ((P.deferral + 1) * P.conversionLoss * P.conversionGradient *
            P.diameter * P.gradientBound) / 2 := by ring
      _ ≤ (2 / ((P.deferral + 1) * P.conversionLoss * P.conversionGradient *
          P.diameter * P.gradientBound)) *
          ((P.deferral + 1) * P.conversionLoss * P.conversionGradient *
            P.diameter * P.gradientBound) / 2 := by
        gcongr
      _ = ((P.deferral + 1) * P.conversionLoss * P.conversionGradient *
          P.diameter * P.gradientBound) /
          ((P.deferral + 1) * P.conversionLoss * P.conversionGradient *
            P.diameter * P.gradientBound) := by ring
      _ = 1 := div_self (ne_of_gt hden)
  have hmono_quad : a - gamma_prime P / 2 * a ^ 2 ≤
      b - gamma_prime P / 2 * b ^ 2 := by
    have hga : gamma_prime P * a ≤ 1 := le_trans
      (mul_le_mul_of_nonneg_left hab (lightons_gamma_prime_pos P).le) hb_upper
    nlinarith [mul_nonneg (sub_nonneg.mpr hab)
      (show 0 ≤ 1 - gamma_prime P / 2 * (a + b) by nlinarith)]
  exact ha_quad.trans hmono_quad

@[blueprint "lem:lightons-det-rank-one-sub"
  (statement := /-- Let $A$ be a positive-definite real matrix and $g$ a real vector.  Then
  \[
    \det(A-gg^{\mathsf T})=\det(A)
      \left(1-g^{\mathsf T}A^{-1}g\right).
  \] -/)
  (proof := /-- Positive-definiteness makes $A$ invertible, so factor the left-hand matrix as
  $A(I-(A^{-1}g)g^{\mathsf T})$.  Multiplicativity of the determinant reduces the result to the determinant of the rank-one perturbation of the identity.  The Weinstein--Aronszajn identity exchanges the two rectangular factors and reduces this determinant to the corresponding one-dimensional determinant, namely $1-g^{\mathsf T}A^{-1}g$. -/)
  (title := /-- Rank-one determinant identity for a positive-definite matrix -/)
  (latexEnv := "lemma")]
lemma lightons_det_rank_one_sub {n : Type*} [Fintype n] [DecidableEq n]
    (A : Matrix n n ℝ) (hA : A.PosDef) (g : n → ℝ) :
    (A - Matrix.vecMulVec g g).det =
      A.det * (1 - g ⬝ᵥ ((A⁻¹).mulVec g)) := by
  let v : n → ℝ := (A⁻¹).mulVec g
  have hAv : A.mulVec v = g := by
    dsimp [v]
    rw [Matrix.mulVec_mulVec]
    rw [Matrix.mul_nonsing_inv A (isUnit_iff_ne_zero.mpr (ne_of_gt hA.det_pos))]
    simp
  have houter : A * Matrix.vecMulVec v g = Matrix.vecMulVec g g := by
    ext i j
    change (∑ k, A i k * (v k * g j)) = g i * g j
    rw [← congrFun hAv i]
    change (∑ k, A i k * (v k * g j)) = (∑ k, A i k * v k) * g j
    rw [Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro k hk
    ring
  have hfactor : A - Matrix.vecMulVec g g =
      A * (1 - Matrix.vecMulVec v g) := by
    rw [Matrix.mul_sub, Matrix.mul_one, houter]
  rw [hfactor, Matrix.det_mul]
  let X : Matrix n (Fin 1) ℝ := fun i _ => -v i
  let Y : Matrix (Fin 1) n ℝ := fun _ j => g j
  have hXY : X * Y = -Matrix.vecMulVec v g := by
    ext i j
    simp [X, Y, Matrix.mul_apply, Matrix.vecMulVec]
  have hYX : Y * X = fun _ _ => -(g ⬝ᵥ v) := by
    ext i j
    simp [X, Y, Matrix.mul_apply, dotProduct]
  have hWA := Matrix.det_one_add_mul_comm X Y
  rw [hXY, hYX] at hWA
  simp [Matrix.det_fin_one] at hWA
  simpa [v, sub_eq_add_neg] using congrArg (fun z => A.det * z) hWA

@[blueprint "lem:lightons-surrogate-regret"
  (statement := /-- Let $P$ be a LightONS problem and let $R$ satisfy the LightONS invariant.  For every $T\in\mathbb N$ and $u\in\mathcal X$, writing $\bar g_t=c_f\nabla g_t(y_t)$, one has
  \[
    \sum_{t<T}\left(\langle\bar g_t,y_t-u\rangle
      -\frac{\gamma'}2\langle\bar g_t,y_t-u\rangle^2\right)
    \leq \frac{d}{2\gamma'}\log\left(1+
      \frac{c_f^2c_g^2G^2T}{d\varepsilon}\right)
      +\frac{\gamma'\varepsilon D^2}{8}.
  \] -/)
  (proof := /-- Expand the metric recursion in \cref{def:is-lightons-run} as
  $A_T=\varepsilon I+\sum_{t<T}\bar g_t\bar g_t^{\mathsf T}$.  Positivity of the curvature parameter is supplied by \cref{lem:lightons-gamma-prime-pos}.  The unconstrained update optimality and the metric-projection inequality give the usual one-step ONS potential estimate.  After cancellation of its quadratic term, summation telescopes to the initial potential plus $(2\gamma')^{-1}$ times the sum of the leverage scores $\bar g_t^{\mathsf T}A_{t+1}^{-1}\bar g_t$.  The initial condition, $y_0=0$, and $\|u\|\leq D/2$ bound the initial potential by $\gamma'\varepsilon D^2/8$.  Applying the rank-one determinant identity \cref{lem:lightons-det-rank-one-sub} and $q\leq-\log(1-q)$ bounds the leverage-score sum by $\log(\det A_T/\det A_0)$.  Finally, AM--GM on the positive eigenvalues, together with $\|\bar g_t\|\leq c_fc_gG$, bounds this logarithm by
  $d\log(1+c_f^2c_g^2G^2T/(d\varepsilon))$. -/)
  (title := /-- LightONS surrogate-regret potential bound -/)
  (latexEnv := "lemma")]
lemma lightons_surrogate_regret (P : lightons_problem) (run : lightons_run P)
    (run_is_lightons : is_lightons_run P run) (T : ℕ)
    (u : online_point P.dimension) (hu : u ∈ P.domain) :
    (∑ t ∈ Finset.range T,
      (inner ℝ (P.conversionLoss • run.surrogateGradient t) (run.surrogatePoint t - u) -
        gamma_prime P / 2 *
          inner ℝ (P.conversionLoss • run.surrogateGradient t)
            (run.surrogatePoint t - u) ^ 2)) ≤ lightons_regret_bound P T := by
  classical
  rcases run_is_lightons with ⟨metric, proposal, hy0, hmetric0, hmetric_succ,
    hproposal_min, hprojection, hdecision_projection, hruntime⟩
  let gv : ℕ → online_point P.dimension :=
    fun t => P.conversionLoss • run.surrogateGradient t
  let g : ℕ → Fin P.dimension → ℝ := fun t i => (gv t) i
  let A : ℕ → Matrix (Fin P.dimension) (Fin P.dimension) ℝ :=
    fun n => P.epsilon • 1 +
      ∑ t ∈ Finset.range n, Matrix.vecMulVec (g t) (g t)
  have hinner (v w : online_point P.dimension) :
      inner ℝ v w = (fun i => v i) ⬝ᵥ (fun i => w i) := by
    rw [EuclideanSpace.inner_eq_star_dotProduct]
    simp [dotProduct, mul_comm]
  have hA_succ (n : ℕ) :
      A (n + 1) = A n + Matrix.vecMulVec (g n) (g n) := by
    simp [A, Finset.sum_range_succ, add_assoc]
  have hdot_add (M N : Matrix (Fin P.dimension) (Fin P.dimension) ℝ)
      (v w : Fin P.dimension → ℝ) :
      v ⬝ᵥ ((M + N).mulVec w) =
        v ⬝ᵥ (M.mulVec w) + v ⬝ᵥ (N.mulVec w) := by
    simp [dotProduct, Matrix.mulVec, Finset.sum_add_distrib, mul_add, add_mul]
  have houter_dot (a v w : Fin P.dimension → ℝ) :
      v ⬝ᵥ ((Matrix.vecMulVec a a).mulVec w) =
        (a ⬝ᵥ v) * (a ⬝ᵥ w) := by
    rw [Matrix.dotProduct_mulVec, Matrix.vecMul_vecMulVec, smul_dotProduct]
    rw [dotProduct_comm v a]
    simp
  have hmetricA (n : ℕ) (v w : online_point P.dimension) :
      metric n v w =
        (fun i => v i) ⬝ᵥ ((A n).mulVec (fun i => w i)) := by
    induction n with
    | zero =>
        rw [hmetric0]
        simp [A, hinner, dotProduct, Matrix.mulVec, Matrix.one_apply,
          Finset.mul_sum, mul_comm]
        apply Finset.sum_congr rfl
        intro i hi
        ring
    | succ n ih =>
        rw [hmetric_succ n, ih, hA_succ]
        rw [hdot_add (A n) (Matrix.vecMulVec (g n) (g n))
          (fun i => v i) (fun i => w i)]
        rw [houter_dot]
        simp only [g]
        rw [← hinner, ← hinner]
  have houter_posSemidef (t : ℕ) :
      (Matrix.vecMulVec (g t) (g t)).PosSemidef := by
    apply Matrix.PosSemidef.of_dotProduct_mulVec_nonneg
    · ext i j
      simp [Matrix.IsHermitian, Matrix.conjTranspose_apply,
        Matrix.vecMulVec, mul_comm]
    · intro x
      simp only [star_trivial, dotProduct, Matrix.mulVec, Matrix.vecMulVec,
        Matrix.of_apply]
      have hs := sq_nonneg (∑ i, g t i * x i)
      convert hs using 1
      simp only [pow_two, Finset.sum_mul, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i hi
      apply Finset.sum_congr rfl
      intro j hj
      ring
  have hbase_posDef :
      (P.epsilon • (1 :
        Matrix (Fin P.dimension) (Fin P.dimension) ℝ)).PosDef := by
    apply Matrix.PosDef.of_dotProduct_mulVec_pos
    · ext i j
      simp [Matrix.IsHermitian, Matrix.conjTranspose_apply, Matrix.one_apply]
      by_cases hij : i = j
      · subst j
        simp
      · simp [hij, Ne.symm hij]
    · intro x hx
      obtain ⟨i, hi⟩ : ∃ i, x i ≠ 0 := by
        by_contra h
        push Not at h
        exact hx (funext h)
      simp [dotProduct, Matrix.mulVec, Matrix.smul_apply, Matrix.one_apply]
      have hterm : 0 < P.epsilon * x i ^ 2 :=
        mul_pos P.epsilon_pos (sq_pos_of_ne_zero hi)
      have hsum : 0 < ∑ j, P.epsilon * x j ^ 2 :=
        Finset.sum_pos' (fun j hj =>
          mul_nonneg P.epsilon_pos.le (sq_nonneg _))
          ⟨i, Finset.mem_univ i, hterm⟩
      rw [show (∑ j, x j * (P.epsilon * x j)) =
          ∑ j, P.epsilon * x j ^ 2 by
        apply Finset.sum_congr rfl
        intro j hj
        ring]
      exact hsum
  have hApos (n : ℕ) : (A n).PosDef := by
    dsimp [A]
    apply hbase_posDef.add_posSemidef
    apply Matrix.posSemidef_sum
    intro t ht
    exact houter_posSemidef t
  have hmetric_sum (n : ℕ) (v w : online_point P.dimension) :
      metric n v w = P.epsilon * inner ℝ v w +
        ∑ t ∈ Finset.range n, inner ℝ (gv t) v * inner ℝ (gv t) w := by
    induction n with
    | zero => simp [hmetric0]
    | succ n ih =>
        rw [hmetric_succ n, ih]
        simp [gv, Finset.sum_range_succ]
        ring
  have hmetric_sym (n : ℕ) (v w : online_point P.dimension) :
      metric n v w = metric n w v := by
    rw [hmetric_sum, hmetric_sum, real_inner_comm v w]
    congr 1
    apply Finset.sum_congr rfl
    intro t ht
    ring
  have hmetric_add_left (n : ℕ) (v w z : online_point P.dimension) :
      metric n (v + w) z = metric n v z + metric n w z := by
    simp [hmetric_sum, inner_add_left, inner_add_right,
      Finset.sum_add_distrib, add_mul]
    ring
  have hmetric_smul_left (n : ℕ) (c : ℝ) (v w : online_point P.dimension) :
      metric n (c • v) w = c * metric n v w := by
    rw [hmetric_sum, hmetric_sum, real_inner_smul_left]
    simp_rw [real_inner_smul_right]
    rw [mul_add, Finset.mul_sum]
    ring_nf
  have hmetric_add_right (n : ℕ) (v w z : online_point P.dimension) :
      metric n v (w + z) = metric n v w + metric n v z := by
    rw [hmetric_sym n v, hmetric_add_left,
      hmetric_sym n w v, hmetric_sym n z v]
  have hmetric_smul_right (n : ℕ) (c : ℝ) (v w : online_point P.dimension) :
      metric n v (c • w) = c * metric n v w := by
    rw [hmetric_sym n v, hmetric_smul_left, hmetric_sym n w v]
  have hmetric_neg_left (n : ℕ) (v w : online_point P.dimension) :
      metric n (-v) w = -metric n v w := by
    simpa using hmetric_smul_left n (-1) v w
  have hmetric_neg_right (n : ℕ) (v w : online_point P.dimension) :
      metric n v (-w) = -metric n v w := by
    simpa using hmetric_smul_right n (-1) v w
  have hmetric_sub_left (n : ℕ) (v w z : online_point P.dimension) :
      metric n (v - w) z = metric n v z - metric n w z := by
    rw [sub_eq_add_neg, hmetric_add_left, hmetric_neg_left, sub_eq_add_neg]
  have hmetric_sub_right (n : ℕ) (v w z : online_point P.dimension) :
      metric n v (w - z) = metric n v w - metric n v z := by
    rw [sub_eq_add_neg, hmetric_add_right, hmetric_neg_right, sub_eq_add_neg]
  have hmetric_square_sub (n : ℕ) (v w : online_point P.dimension) :
      metric n (v - w) (v - w) =
        metric n v v - 2 * metric n v w + metric n w w := by
    rw [hmetric_sub_left, hmetric_sub_right, hmetric_sub_right,
      hmetric_sym n w v]
    ring
  have hmetric_square_add (n : ℕ) (v w : online_point P.dimension) :
      metric n (v + w) (v + w) =
        metric n v v + 2 * metric n v w + metric n w w := by
    rw [hmetric_add_left, hmetric_add_right, hmetric_add_right,
      hmetric_sym n w v]
    ring
  have hmetric_pos (n : ℕ) (v : online_point P.dimension) (hv : v ≠ 0) :
      0 < metric n v v := by
    rw [hmetric_sum]
    have hvv : 0 < inner ℝ v v := real_inner_self_pos.mpr hv
    have hs : 0 ≤ ∑ t ∈ Finset.range n,
        inner ℝ (gv t) v * inner ℝ (gv t) v :=
      Finset.sum_nonneg fun t ht => mul_self_nonneg _
    nlinarith [P.epsilon_pos]
  have hmetric_nonneg (n : ℕ) (v : online_point P.dimension) :
      0 ≤ metric n v v := by
    by_cases hv : v = 0
    · subst v
      simp [hmetric_sum]
    · exact (hmetric_pos n v hv).le
  let invg : ℕ → online_point P.dimension :=
    fun t => WithLp.toLp 2 ((A (t + 1))⁻¹.mulVec (g t))
  have hA_invg (t : ℕ) :
      (A (t + 1)).mulVec (fun i => (invg t) i) = g t := by
    simp only [invg]
    rw [Matrix.mulVec_mulVec]
    rw [Matrix.mul_nonsing_inv (A (t + 1))
      (isUnit_iff_ne_zero.mpr (ne_of_gt (hApos (t + 1)).det_pos))]
    simp
  have hmetric_invg (t : ℕ) (v : online_point P.dimension) :
