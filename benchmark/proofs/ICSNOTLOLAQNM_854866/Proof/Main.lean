import Architect
import Mathlib.Analysis.Calculus.ContDiff.Defs
import Mathlib.Analysis.Calculus.Gradient.Basic
import Mathlib.Analysis.Calculus.Taylor
import Mathlib.Analysis.SpecialFunctions.Pow.Real

set_option linter.all false
set_option maxHeartbeats 500000

open scoped BigOperators

@[blueprint "def:optimization-point"
  (statement := /-- For a natural number \(d\), the optimization domain is the Euclidean space
  \(\mathbb{R}^d\), represented with coordinates indexed by \(\operatorname{Fin}(d)\). -/)
  (title := /-- Euclidean optimization domain -/)
  (latexEnv := "definition")]
abbrev optimization_point (d : ℕ) :=
  EuclideanSpace ℝ (Fin d)

@[blueprint "def:objective-hessian"
  (statement := /-- Let \(f:\mathbb{R}^d\to\mathbb{R}\).  Its Hessian at \(x\) is represented as the
  Fréchet derivative at \(x\) of the Riesz-represented gradient map
  \(x\mapsto \nabla f(x)\). -/)
  (title := /-- Hessian of the objective -/)
  (latexEnv := "definition")]
noncomputable def objective_hessian {d : ℕ}
    (f : optimization_point d → ℝ) (x : optimization_point d) :
    optimization_point d →L[ℝ] optimization_point d :=
  fderiv ℝ (gradient f) x

@[blueprint "def:has-lipschitz-gradient"
  (statement := /-- A function \(f:\mathbb{R}^d\to\mathbb{R}\) has \(L_1\)-Lipschitz gradient if,
  for every \(x,y\in\mathbb{R}^d\),
  \[
    \|\nabla f(x)-\nabla f(y)\|\leq L_1\|x-y\|.
  \] -/)
  (title := /-- Lipschitz-gradient assumption -/)
  (latexEnv := "definition")]
def has_lipschitz_gradient {d : ℕ}
    (f : optimization_point d → ℝ) (L1 : ℝ) : Prop :=
  ∀ x y, ‖gradient f x - gradient f y‖ ≤ L1 * ‖x - y‖

@[blueprint "def:has-lipschitz-hessian"
  (statement := /-- A function \(f:\mathbb{R}^d\to\mathbb{R}\) has \(L_2\)-Lipschitz Hessian if,
  for every \(x,y\in\mathbb{R}^d\),
  \[
    \|\nabla^2 f(x)-\nabla^2 f(y)\|\leq L_2\|x-y\|,
  \]
  where the norm on Hessians is the operator norm. -/)
  (title := /-- Lipschitz-Hessian assumption -/)
  (latexEnv := "definition")]
def has_lipschitz_hessian {d : ℕ}
    (f : optimization_point d → ℝ) (L2 : ℝ) : Prop :=
  ∀ x y, ‖objective_hessian f x - objective_hessian f y‖ ≤ L2 * ‖x - y‖

@[blueprint "def:conversion-run"
  (statement := /-- A conversion trajectory with dimension \(d\), \(K\) episodes of length
  \(T\), trust-region radius \(D\), learning rate \(\eta\), and subproblem accuracy \(\delta\)
  consists of iterates \(x_n\) and displacements \(\Delta_n\) satisfying
  \(x_{n+1}=x_n+\Delta_n\) and \(\|\Delta_n\|\leq D\) for every \(n\).  This structure
  records only the kinematic data of a run; whether the trajectory is generated by the
  conversion algorithm is expressed separately by
  \(\cref{def:conversion-algorithm-execution}\). -/)
  (title := /-- Kinematic data of a conversion trajectory -/)
  (latexEnv := "definition")]
structure conversion_run (d K T : ℕ) (D eta delta : ℝ) where
  iterate : ℕ → optimization_point d
  displacement : ℕ → optimization_point d
  iterate_succ : ∀ n, iterate (n + 1) = iterate n + displacement n
  displacement_norm_le : ∀ n, ‖displacement n‖ ≤ D

@[blueprint "def:conversion-midpoint"
  (statement := /-- For the \(n\)-th update of a conversion run, define its midpoint by
  \[
    w_n=\frac{x_n+x_{n+1}}{2}.
  \] -/)
  (title := /-- Midpoint of one algorithmic update -/)
  (latexEnv := "definition")]
noncomputable def conversion_midpoint {d K T : ℕ} {D eta delta : ℝ}
    (run : conversion_run d K T D eta delta) (n : ℕ) : optimization_point d :=
  (2 : ℝ)⁻¹ • (run.iterate n + run.iterate (n + 1))

@[blueprint "def:episode-average"
  (statement := /-- For an episode \(k\) of length \(T\), define the averaged midpoint by
  \[
    \bar w^k=\frac1T\sum_{n=0}^{T-1}w_{kT+n}.
  \]
  This is the zero-based version of the indexing in the paper. -/)
  (title := /-- Average midpoint of an episode -/)
  (latexEnv := "definition")]
noncomputable def episode_average {d K T : ℕ} {D eta delta : ℝ}
    (run : conversion_run d K T D eta delta) (k : ℕ) : optimization_point d :=
  (T : ℝ)⁻¹ •
    ∑ n ∈ Finset.range T, conversion_midpoint run (k * T + n)

@[blueprint "def:episode-gradient-sum"
  (statement := /-- The midpoint-gradient sum in episode \(k\) is
  \[
    G_k=\sum_{n=0}^{T-1}\nabla f(w_{kT+n}).
  \] -/)
  (title := /-- Sum of midpoint gradients in one episode -/)
  (latexEnv := "definition")]
noncomputable def episode_gradient_sum {d K T : ℕ} {D eta delta : ℝ}
    (f : optimization_point d → ℝ)
    (run : conversion_run d K T D eta delta) (k : ℕ) : optimization_point d :=
  ∑ n ∈ Finset.range T, gradient f (conversion_midpoint run (k * T + n))

@[blueprint "def:episode-comparator"
  (statement := /-- The comparator for episode \(k\) is
  \[
    u^k=-D\,\frac{G_k}{\|G_k\|},
  \]
  with division interpreted by the ambient real-field convention when \(G_k=0\). -/)
  (title := /-- Episode comparator -/)
  (latexEnv := "definition")]
noncomputable def episode_comparator {d K T : ℕ} {D eta delta : ℝ}
    (f : optimization_point d → ℝ)
    (run : conversion_run d K T D eta delta) (k : ℕ) : optimization_point d :=
  (-D / ‖episode_gradient_sum f run k‖) • episode_gradient_sum f run k

@[blueprint "def:conversion-regret"
  (statement := /-- Given episode comparators \(u^0,\ldots,u^{K-1}\), define the conversion
  regret by
  \[
    \operatorname{Reg}_T(u)=
    \sum_{k=0}^{K-1}\sum_{n=0}^{T-1}
    \left\langle\nabla f(w_{kT+n}),\Delta_{kT+n}-u^k\right\rangle.
  \] -/)
  (title := /-- Regret of a conversion run -/)
  (latexEnv := "definition")]
noncomputable def conversion_regret {d K T : ℕ} {D eta delta : ℝ}
    (f : optimization_point d → ℝ)
    (run : conversion_run d K T D eta delta)
    (u : ℕ → optimization_point d) : ℝ :=
  ∑ k ∈ Finset.range K, ∑ n ∈ Finset.range T,
    inner ℝ (gradient f (conversion_midpoint run (k * T + n)))
      (run.displacement (k * T + n) - u k)

@[blueprint "def:conversion-algorithm-execution"
  (statement := /-- Let \(f:\mathbb{R}^d\to\mathbb{R}\), and let
  \((x_n,\Delta_n)_{n\geq 0}\) be the trajectory
  \(\cref{def:conversion-run}\) with parameters \(D,\eta,\delta\).  The trajectory satisfies
  the rate-relevant execution conditions of the optimistic quasi-Newton conversion algorithm if
  there are linear models \(B_n:\mathbb{R}^d\to\mathbb{R}^d\) such that, for every
  \(0\leq n<KT\), one has \(\|B_n\|\leq 2L_1\), and \(\Delta_n\) solves the model
  trust-region problem to objective accuracy \(\delta\):
  \[
    \langle\nabla f(w_n),\Delta_n\rangle
      +\frac12\langle\Delta_n,B_n\Delta_n\rangle
    \leq
    \langle\nabla f(w_n),u\rangle
      +\frac12\langle u,B_nu\rangle+\delta
  \]
  for every \(u\) with \(\|u\|\leq D\).  The inexact implicit quasi-Newton solve must also
  satisfy the first-order residual condition
  \[
    \left\langle \nabla f(w_n)+B_n\Delta_n,u-\Delta_n\right\rangle
      \geq-\delta\|u-\Delta_n\|
  \]
  for every such \(u\).  This condition couples the recorded displacement to the current
  gradient and model.  In particular, if \(D>0\) and \(\Delta_n=0\), choosing
  \(u=-D\nabla f(w_n)/\|\nabla f(w_n)\|\) when the gradient is nonzero shows that
  \(\|\nabla f(w_n)\|\leq\delta\); thus a stationary trajectory at a nonstationary point
  is not an execution merely because an additive objective tolerance is large enough.
  Finally, the optimistic online updates with learning rate \(\eta\) must certify
  \[
    \operatorname{Reg}_T
    \leq \frac{D^2}{2\eta}
      +\frac{\eta}{2}\sum_{n=0}^{KT-1}
        \|\nabla f(w_n)-B_n\Delta_n\|^2
      +\delta KT,
  \]
  and the Hessian-learning update must give the aggregate model-quality budget
  \[
  \begin{aligned}
    &\frac{D^2}{2\eta}
      +\frac{\eta}{2}\sum_{n=0}^{KT-1}
        \|\nabla f(w_n)-B_n\Delta_n\|^2
      +\delta KT+DKT\frac{L_2T^2D^2}{2}\\
    &\qquad\leq DKT\left(
      \frac{L_2^{8/5}D^{13/5}}{8d^{3/5}L_1^{3/5}}
      +\frac{7\,52^{3/13}d^{2/5}L_1^{7/5}D^{3/5}}
        {L_2^{2/5}KT}\right).
  \end{aligned}
  \]
  This last inequality is the aggregate consequence of the surrogate-loss and dynamic-regret
  bounds for the generated quasi-Newton models; it is not implied by the norm bound on an
  arbitrary model sequence.  The regret and episode comparators are those of
  \(\cref{def:conversion-regret,def:episode-comparator}\).  Thus \(\eta\) and \(\delta\)
  impose substantive conditions on the trajectory, rather than serving as phantom indices. -/)
  (title := /-- Rate-relevant execution certificate for the conversion algorithm -/)
  (latexEnv := "definition")]
def conversion_algorithm_execution
    {d K T : ℕ} {D eta delta L1 L2 : ℝ}
    (f : optimization_point d → ℝ)
    (run : conversion_run d K T D eta delta) : Prop :=
  ∃ model : ℕ → (optimization_point d →L[ℝ] optimization_point d),
    (∀ n < K * T, ‖model n‖ ≤ 2 * L1) ∧
    (∀ n < K * T, ∀ u, ‖u‖ ≤ D →
      inner ℝ (gradient f (conversion_midpoint run n)) (run.displacement n) +
          (2 : ℝ)⁻¹ * inner ℝ (run.displacement n) (model n (run.displacement n)) ≤
        inner ℝ (gradient f (conversion_midpoint run n)) u +
          (2 : ℝ)⁻¹ * inner ℝ u (model n u) + delta) ∧
    (∀ n < K * T, ∀ u, ‖u‖ ≤ D →
      -delta * ‖u - run.displacement n‖ ≤
        inner ℝ
          (gradient f (conversion_midpoint run n) + model n (run.displacement n))
          (u - run.displacement n)) ∧
    conversion_regret f run (episode_comparator f run) ≤
      D ^ 2 / (2 * eta) +
        eta / 2 *
          ∑ n ∈ Finset.range (K * T),
            ‖gradient f (conversion_midpoint run n) -
              model n (run.displacement n)‖ ^ 2 +
        delta * (K * T : ℕ) ∧
    D ^ 2 / (2 * eta) +
          eta / 2 *
            ∑ n ∈ Finset.range (K * T),
              ‖gradient f (conversion_midpoint run n) -
                model n (run.displacement n)‖ ^ 2 +
          delta * (K * T : ℕ) +
          D * (K * T : ℕ) * (L2 / 2 * (T : ℝ) ^ 2 * D ^ 2) ≤
      D * (K * T : ℕ) *
        (Real.rpow L2 ((8 : ℝ) / 5) * Real.rpow D ((13 : ℝ) / 5) /
            (8 * Real.rpow (d : ℝ) ((3 : ℝ) / 5) *
              Real.rpow L1 ((3 : ℝ) / 5)) +
          7 * Real.rpow 52 ((3 : ℝ) / 13) *
              Real.rpow (d : ℝ) ((2 : ℝ) / 5) *
              Real.rpow L1 ((7 : ℝ) / 5) * Real.rpow D ((3 : ℝ) / 5) /
            (Real.rpow L2 ((2 : ℝ) / 5) * (K * T : ℕ)))

@[blueprint "def:prescribed-parameters"
  (statement := /-- Given an initial gap \(\Gamma=f(x_0)-f^*\), the prescribed parameters are
  \[
  D=\left(\frac{\Gamma}
  {52d^{2/5}L_1^{2/5}L_2^{3/5}M}\right)^{5/13},\qquad
  \eta=\left(\frac{1}
  {24dL_1L_2^{2/3}D^{2/3}}\right)^{3/5},
  \]
  \[
  T=\frac{3}{(DL_2\eta)^{1/3}},\qquad
  \delta=\frac{D}{\eta T},\qquad KT=M.
  \]
  Here \(d,K,T,M\) are positive natural numbers, while
  \(L_1,L_2,\Gamma,D,\eta,\delta\) are positive real numbers; these domain conditions make
  every average, reciprocal, and fractional-power expression nondegenerate.  Occurrences of
  natural numbers in real expressions are coerced to \(\mathbb{R}\). -/)
  (title := /-- Exact parameter prescription -/)
  (latexEnv := "definition")]
def prescribed_parameters
    (d K T M : ℕ) (L1 L2 gap D eta delta : ℝ) : Prop :=
  0 < d ∧ 0 < K ∧ 0 < T ∧ 0 < M ∧
    0 < L1 ∧ 0 < L2 ∧ 0 < gap ∧ 0 < D ∧ 0 < eta ∧ 0 < delta ∧
    D =
      Real.rpow
        (gap /
          (52 * Real.rpow (d : ℝ) ((2 : ℝ) / 5) *
            Real.rpow L1 ((2 : ℝ) / 5) * Real.rpow L2 ((3 : ℝ) / 5) * (M : ℝ)))
        ((5 : ℝ) / 13) ∧
    eta =
      Real.rpow
        (1 /
          (24 * (d : ℝ) * L1 * Real.rpow L2 ((2 : ℝ) / 3) *
            Real.rpow D ((2 : ℝ) / 3)))
        ((3 : ℝ) / 5) ∧
    (T : ℝ) = 3 / Real.rpow (D * L2 * eta) ((1 : ℝ) / 3) ∧
    delta = D / (eta * (T : ℝ)) ∧
    K * T = M

@[blueprint "def:convergence-rate-bound"
  (statement := /-- For dimension \(d\), iteration budget \(M\), smoothness constants
  \(L_1,L_2\), and initial gap \(\Gamma\), define
  \[
  \begin{aligned}
  \mathcal B={}&
  2\Gamma^{8/13}(52L_1^{2/5}L_2^{3/5})^{5/13}
       \frac{d^{2/13}}{M^{8/13}}
  +\frac{L_2\Gamma}{416dL_1M}\\
  &+\frac{7L_1^{17/13}\Gamma^{3/13}}{L_2^{7/13}}
       \frac{d^{4/13}}{M^{16/13}}
  +\frac{L_2^{7/13}}{48}
       \left(\frac{\Gamma}{52d^{2/5}L_1^{2/5}M}\right)^{10/13}.
  \end{aligned}
  \] -/)
  (title := /-- Explicit convergence-rate expression -/)
  (latexEnv := "definition")]
noncomputable def convergence_rate_bound
    (d M : ℕ) (L1 L2 gap : ℝ) : ℝ :=
  2 * Real.rpow gap ((8 : ℝ) / 13) *
      Real.rpow
        (52 * Real.rpow L1 ((2 : ℝ) / 5) * Real.rpow L2 ((3 : ℝ) / 5))
        ((5 : ℝ) / 13) *
      Real.rpow (d : ℝ) ((2 : ℝ) / 13) /
      Real.rpow (M : ℝ) ((8 : ℝ) / 13) +
    L2 * gap / (416 * (d : ℝ) * L1 * (M : ℝ)) +
    7 * Real.rpow L1 ((17 : ℝ) / 13) * Real.rpow gap ((3 : ℝ) / 13) /
        Real.rpow L2 ((7 : ℝ) / 13) *
        Real.rpow (d : ℝ) ((4 : ℝ) / 13) /
        Real.rpow (M : ℝ) ((16 : ℝ) / 13) +
    Real.rpow L2 ((7 : ℝ) / 13) / 48 *
      Real.rpow
        (gap /
          (52 * Real.rpow (d : ℝ) ((2 : ℝ) / 5) *
            Real.rpow L1 ((2 : ℝ) / 5) * (M : ℝ)))
        ((10 : ℝ) / 13)

@[blueprint "lem:midpoint-conversion"
  (statement := /-- Let \(d,K,T\in\mathbb{N}\) and
  \(D,\eta,\delta,L_2\in\mathbb{R}\).  Let
  \(f:\mathbb{R}^d\to\mathbb{R}\) be twice continuously differentiable and have
  \(L_2\)-Lipschitz Hessian in the sense of
  \(\cref{def:has-lipschitz-hessian}\), where \(L_2\geq 0\), and let
  \((x_n,\Delta_n)_{n\in\mathbb{N}}\) be a conversion run with parameters
  \((d,K,T,D,\eta,\delta)\) in the sense of \(\cref{def:conversion-run}\).  For
  \(n\in\mathbb{N}\), let \(w_n\) be the midpoint from
  \(\cref{def:conversion-midpoint}\).  Then
  \[
    f(x_n)-f(x_{n+1})
    \geq-\langle\nabla f(w_n),\Delta_n\rangle-\frac{L_2D^3}{24}.
  \] -/)
  (proof := /-- Put \(\Delta=\Delta_n\) and \(w=w_n\), where \(w_n\) is defined in
  \(\cref{def:conversion-midpoint}\).  For an arbitrary \(u\in\mathbb{R}^d\), set
  \(q_u=\langle\nabla^2 f(w)u,u\rangle\) and
  \(\phi_u(t)=f(w+tu)-t^2q_u/2\).  The integral form of Taylor's theorem on
  \([0,1/2]\) gives
  \[
    f(w+u/2)-f(w)-\frac12\langle\nabla f(w),u\rangle-\frac18q_u
    =\int_0^{1/2}\left(\frac12-t\right)
      \left\langle\bigl(\nabla^2 f(w+tu)-\nabla^2 f(w)\bigr)u,u\right\rangle\,dt.
  \]
  By \(\cref{def:has-lipschitz-hessian}\), the absolute value of the inner-product
  factor is at most \(L_2t\|u\|^3\) on this interval.  Since
  \(\int_0^{1/2}(1/2-t)t\,dt=1/48\), the absolute value of the displayed remainder
  is at most \(L_2\|u\|^3/48\).

  Apply this bound first with \(u=\Delta\) and then with \(u=-\Delta\).
  The update identity in \(\cref{def:conversion-run}\), together with
  \(\cref{def:conversion-midpoint}\), identifies \(w+\Delta/2\) with \(x_{n+1}\)
  and \(w-\Delta/2\) with \(x_n\).  Subtracting the two estimates cancels the
  identical quadratic terms and gives
  \[
    f(x_n)-f(x_{n+1})
      \geq-\langle\nabla f(w),\Delta\rangle
        -\frac{L_2\|\Delta\|^3}{24}.
  \]
  Finally, the radius condition in \(\cref{def:conversion-run}\) gives
  \(\|\Delta\|\leq D\).  Nonnegativity of \(L_2\) therefore implies
  \(L_2\|\Delta\|^3/24\leq L_2D^3/24\), which proves the claim. -/)
  (title := /-- Midpoint descent with cubic error -/)
  (latexEnv := "lemma")]
lemma midpoint_conversion
    {d K T : ℕ} {D eta delta L2 : ℝ}
    (f : optimization_point d → ℝ)
    (run : conversion_run d K T D eta delta)
    (h_smooth : ContDiff ℝ 2 f)
    (h_hessian : has_lipschitz_hessian f L2)
    (hL2 : 0 ≤ L2)
    (n : ℕ) :
    f (run.iterate n) - f (run.iterate (n + 1)) ≥
      -inner ℝ (gradient f (conversion_midpoint run n)) (run.displacement n) -
        L2 * D ^ 3 / 24 := by
  let v := run.displacement n
  let w := conversion_midpoint run n
  have hf_diff : Differentiable ℝ f := h_smooth.differentiable (by norm_num)
  have hgrad : ContDiff ℝ 1 (gradient f) := by
    change ContDiff ℝ 1 (fun x =>
      (InnerProductSpace.toDual ℝ (optimization_point d)).symm (fderiv ℝ f x))
    exact (InnerProductSpace.toDual ℝ (optimization_point d)).symm.contDiff.comp
      (h_smooth.fderiv_right (by norm_num))
  have hgrad_diff : Differentiable ℝ (gradient f) :=
    hgrad.differentiable (by norm_num)
  have hpoly :
      (∫ t in (0 : ℝ)..(1 / 2 : ℝ), ((1 / 2 : ℝ) - t) * t) = 1 / 48 := by
    have hderiv (t : ℝ) :
        HasDerivAt (fun s : ℝ => s ^ 2 / 4 - s ^ 3 / 3)
          (((1 / 2 : ℝ) - t) * t) t := by
      convert (((hasDerivAt_id t).pow 2).div_const 4).sub
        (((hasDerivAt_id t).pow 3).div_const 3) using 1
      all_goals first | rfl | (simp only [id_eq]; ring)
    have hint : IntervalIntegrable (fun t : ℝ => ((1 / 2 : ℝ) - t) * t)
        MeasureTheory.volume 0 (1 / 2) :=
      (by fun_prop : Continuous fun t : ℝ => ((1 / 2 : ℝ) - t) * t)
        |>.intervalIntegrable 0 (1 / 2)
    have hcalc := intervalIntegral.integral_eq_sub_of_hasDerivAt
      (a := (0 : ℝ)) (b := (1 / 2 : ℝ)) (fun t _ => hderiv t) hint
    norm_num at hcalc
    exact hcalc
  have htaylor (u : optimization_point d) :
      |f (w + (1 / 2 : ℝ) • u) - f w -
          (1 / 2 : ℝ) * inner ℝ (gradient f w) u -
          (1 / 8 : ℝ) * inner ℝ (objective_hessian f w u) u| ≤
        L2 * ‖u‖ ^ 3 / 48 := by
    let q0 : ℝ := inner ℝ (objective_hessian f w u) u
    let φ : ℝ → ℝ := fun t => f (w + t • u) - t ^ 2 / 2 * q0
    have hfline (t : ℝ) :
        HasDerivAt (fun s : ℝ => f (w + s • u))
          (inner ℝ (gradient f (w + t • u)) u) t := by
      change HasDerivAt (fun s : ℝ => f (w + s • u))
        (inner ℝ (gradient f (w + t • u)) u) t
      convert ((hf_diff (w + t • u)).hasFDerivAt.comp t
        (((hasDerivAt_id t).smul_const u).const_add w).hasFDerivAt).hasDerivAt using 1
      all_goals first | rfl | simp only [Function.comp_apply, inner_gradient_left, one_smul,
        ContinuousLinearMap.comp_apply, ContinuousLinearMap.toSpanSingleton_apply]
    have hgpath (t : ℝ) :
        HasDerivAt (fun s : ℝ => gradient f (w + s • u))
          (objective_hessian f (w + t • u) u) t := by
      dsimp [objective_hessian]
      convert ((hgrad_diff (w + t • u)).hasFDerivAt.comp t
        (((hasDerivAt_id t).smul_const u).const_add w).hasFDerivAt).hasDerivAt using 1
      all_goals first | rfl | simp only [Function.comp_apply, one_smul,
        ContinuousLinearMap.comp_apply, ContinuousLinearMap.toSpanSingleton_apply]
    have hψ (t : ℝ) :
        HasDerivAt (fun s : ℝ => inner ℝ (gradient f (w + s • u)) u)
          (inner ℝ (objective_hessian f (w + t • u) u) u) t := by
      convert ((innerSL ℝ u).hasFDerivAt.comp t (hgpath t).hasFDerivAt).hasDerivAt using 1
      all_goals first | rfl | exact funext fun s => real_inner_comm _ _ |
        simp only [Function.comp_apply, innerSL_apply_apply, real_inner_comm, one_smul,
          ContinuousLinearMap.comp_apply, ContinuousLinearMap.toSpanSingleton_apply]
    have hφ_deriv (t : ℝ) :
        HasDerivAt φ
          (inner ℝ (gradient f (w + t • u)) u - t * q0) t := by
      dsimp [φ]
      convert (hfline t).sub
        ((((hasDerivAt_id t).pow 2).div_const 2).mul_const q0) using 1
      all_goals first | rfl | (simp only [id_eq]; ring)
    have hφ_second_deriv (t : ℝ) :
        HasDerivAt
          (fun s : ℝ => inner ℝ (gradient f (w + s • u)) u - s * q0)
          (inner ℝ (objective_hessian f (w + t • u) u) u - q0) t := by
      convert (hψ t).sub ((hasDerivAt_id t).mul_const q0) using 1
      all_goals first | rfl | (funext s; simp only [Pi.sub_apply, id_eq]) | norm_num
    have hiter (t : ℝ) :
        iteratedDeriv 2 φ t =
          inner ℝ (objective_hessian f (w + t • u) u) u - q0 := by
      rw [show iteratedDeriv 2 φ = deriv (deriv φ) by
        simpa only [one_add_one_eq_two, iteratedDeriv_one] using
          (iteratedDeriv_succ (f := φ) (n := 1))]
      rw [show deriv φ = fun s : ℝ =>
        inner ℝ (gradient f (w + s • u)) u - s * q0 by
          funext s
          exact (hφ_deriv s).deriv]
      exact (hφ_second_deriv t).deriv
    have hφsmooth : ContDiff ℝ 2 φ := by
      dsimp [φ]
      fun_prop
    have hui : UniqueDiffOn ℝ (Set.uIcc (0 : ℝ) (1 / 2 : ℝ)) := by
      rw [Set.uIcc_of_le (by norm_num)]
      exact uniqueDiffOn_Icc (by norm_num)
    have hwithin (t : ℝ) (ht : t ∈ Set.uIcc (0 : ℝ) (1 / 2 : ℝ)) :
        iteratedDerivWithin 2 φ (Set.uIcc (0 : ℝ) (1 / 2 : ℝ)) t =
          inner ℝ (objective_hessian f (w + t • u) u) u - q0 := by
      rw [iteratedDerivWithin_eq_iteratedDeriv hui hφsmooth.contDiffAt ht]
      exact hiter t
    have hfirst :
        iteratedDerivWithin 1 φ (Set.uIcc (0 : ℝ) (1 / 2 : ℝ)) 0 =
          inner ℝ (gradient f w) u := by
      calc
        iteratedDerivWithin 1 φ (Set.uIcc (0 : ℝ) (1 / 2 : ℝ)) 0 =
            iteratedDeriv 1 φ 0 := iteratedDerivWithin_eq_iteratedDeriv
              hui (hφsmooth.of_le (by norm_num)).contDiffAt
              (by simp [Set.uIcc_of_le])
        _ = deriv φ 0 := by simp
        _ = inner ℝ (gradient f w) u := by
          rw [(hφ_deriv 0).deriv]
          simp
    have heval :
        taylorWithinEval φ 1 (Set.uIcc (0 : ℝ) (1 / 2 : ℝ)) 0 (1 / 2) =
          φ 0 + (1 / 2 : ℝ) * inner ℝ (gradient f w) u := by
      change taylorWithinEval φ (0 + 1) (Set.uIcc (0 : ℝ) (1 / 2 : ℝ))
        0 (1 / 2) = _
      rw [taylorWithinEval_succ, taylor_within_zero_eval, hfirst]
      norm_num
    have htaylor_raw := taylor_integral_remainder
      (f := φ) (x := (1 / 2 : ℝ)) (x₀ := 0) (n := 1) hφsmooth.contDiffOn
    have hrepr :
        f (w + (1 / 2 : ℝ) • u) - f w -
            (1 / 2 : ℝ) * inner ℝ (gradient f w) u -
            (1 / 8 : ℝ) * q0 =
          ∫ t in (0 : ℝ)..(1 / 2 : ℝ),
            ((1 / 2 : ℝ) - t) *
              (inner ℝ (objective_hessian f (w + t • u) u) u - q0) := by
      calc
        f (w + (1 / 2 : ℝ) • u) - f w -
              (1 / 2 : ℝ) * inner ℝ (gradient f w) u -
              (1 / 8 : ℝ) * q0 =
            φ (1 / 2) -
              taylorWithinEval φ 1 (Set.uIcc (0 : ℝ) (1 / 2 : ℝ)) 0 (1 / 2) := by
                rw [heval]
                simp only [φ, zero_smul, add_zero, zero_pow, OfNat.zero_ne_ofNat,
                  zero_div, zero_mul, sub_zero]
                ring
        _ = ∫ t in (0 : ℝ)..(1 / 2 : ℝ),
              (((1 / 2 : ℝ) - t) ^ 1 / (Nat.factorial 1 : ℝ)) •
                iteratedDerivWithin 2 φ (Set.uIcc (0 : ℝ) (1 / 2 : ℝ)) t :=
          htaylor_raw
        _ = ∫ t in (0 : ℝ)..(1 / 2 : ℝ),
              ((1 / 2 : ℝ) - t) *
                (inner ℝ (objective_hessian f (w + t • u) u) u - q0) := by
          apply intervalIntegral.integral_congr
          intro t ht
          change (((1 / 2 : ℝ) - t) ^ 1 / (Nat.factorial 1 : ℝ)) •
              iteratedDerivWithin 2 φ (Set.uIcc (0 : ℝ) (1 / 2 : ℝ)) t =
            ((1 / 2 : ℝ) - t) *
              (inner ℝ (objective_hessian f (w + t • u) u) u - q0)
          rw [hwithin t ht]
          norm_num
    have hqbound (t : ℝ) (ht : t ∈ Set.Icc (0 : ℝ) (1 / 2 : ℝ)) :
        |inner ℝ (objective_hessian f (w + t • u) u) u - q0| ≤
          L2 * t * ‖u‖ ^ 3 := by
      calc
        |inner ℝ (objective_hessian f (w + t • u) u) u - q0| =
            |inner ℝ
              ((objective_hessian f (w + t • u) - objective_hessian f w) u) u| := by
                simp [q0, ContinuousLinearMap.sub_apply, inner_sub_left]
        _ ≤ ‖(objective_hessian f (w + t • u) -
              objective_hessian f w) u‖ * ‖u‖ :=
          abs_real_inner_le_norm _ _
        _ ≤ (‖objective_hessian f (w + t • u) -
              objective_hessian f w‖ * ‖u‖) * ‖u‖ := by
          gcongr
          exact ContinuousLinearMap.le_opNorm _ _
        _ ≤ (L2 * ‖(w + t • u) - w‖ * ‖u‖) * ‖u‖ := by
          gcongr
          exact h_hessian (w + t • u) w
        _ = L2 * t * ‖u‖ ^ 3 := by
          rw [add_sub_cancel_left, norm_smul, Real.norm_eq_abs, abs_of_nonneg ht.1]
          ring
    have hinter : IntervalIntegrable
        (fun t : ℝ => ((1 / 2 : ℝ) - t) * L2 * t * ‖u‖ ^ 3)
        MeasureTheory.volume 0 (1 / 2) :=
      (by fun_prop : Continuous
        fun t : ℝ => ((1 / 2 : ℝ) - t) * L2 * t * ‖u‖ ^ 3)
        |>.intervalIntegrable 0 (1 / 2)
    have hnorm := intervalIntegral.norm_integral_le_of_norm_le
      (f := fun t : ℝ => ((1 / 2 : ℝ) - t) *
        (inner ℝ (objective_hessian f (w + t • u) u) u - q0))
      (g := fun t : ℝ => ((1 / 2 : ℝ) - t) * L2 * t * ‖u‖ ^ 3)
      (a := (0 : ℝ)) (b := (1 / 2 : ℝ)) (by norm_num) (by
        filter_upwards with t
        intro ht
        rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (sub_nonneg.mpr ht.2)]
        calc
          ((1 / 2 : ℝ) - t) *
                |inner ℝ (objective_hessian f (w + t • u) u) u - q0| ≤
              ((1 / 2 : ℝ) - t) * (L2 * t * ‖u‖ ^ 3) :=
            mul_le_mul_of_nonneg_left
              (hqbound t ⟨ht.1.le, ht.2⟩) (sub_nonneg.mpr ht.2)
          _ = ((1 / 2 : ℝ) - t) * L2 * t * ‖u‖ ^ 3 := by ring) hinter
    have hg_integral :
        (∫ t in (0 : ℝ)..(1 / 2 : ℝ),
          ((1 / 2 : ℝ) - t) * L2 * t * ‖u‖ ^ 3) =
            L2 * ‖u‖ ^ 3 / 48 := by
      rw [show (fun t : ℝ => ((1 / 2 : ℝ) - t) * L2 * t * ‖u‖ ^ 3) =
          fun t : ℝ => (L2 * ‖u‖ ^ 3) * (((1 / 2 : ℝ) - t) * t) by
            funext t
            ring]
      rw [intervalIntegral.integral_const_mul, hpoly]
      ring
    rw [Real.norm_eq_abs, ← hrepr, hg_integral] at hnorm
    simpa [q0] using hnorm
  have hw :
      w = run.iterate n + (1 / 2 : ℝ) • v := by
    dsimp [w, v, conversion_midpoint]
    rw [run.iterate_succ]
    module
  have hwplus :
      w + (1 / 2 : ℝ) • v = run.iterate (n + 1) := by
    rw [hw, run.iterate_succ]
    module
  have hwminus :
      w + (1 / 2 : ℝ) • (-v) = run.iterate n := by
    rw [hw]
    module
  have hp := htaylor v
  have hm := htaylor (-v)
  rw [hwplus] at hp
  rw [hwminus] at hm
  simp only [norm_neg, inner_neg_right, map_neg, inner_neg_left, neg_neg] at hm
  have hv : ‖v‖ ≤ D := run.displacement_norm_le n
  have hD : 0 ≤ D := (norm_nonneg v).trans hv
  have hcubic : L2 * ‖v‖ ^ 3 / 24 ≤ L2 * D ^ 3 / 24 := by
    gcongr
  have hp' := abs_le.mp hp
  have hm' := abs_le.mp hm
  change f (run.iterate n) - f (run.iterate (n + 1)) ≥
    -inner ℝ (gradient f w) v - L2 * D ^ 3 / 24
  nlinarith

@[blueprint "lem:averaged-gradient-estimate"
  (statement := /-- Let \(d,K,T\in\mathbb{N}\), let \(D,\eta,\delta,L_2\in\mathbb{R}\), and let
  \(f:\mathbb{R}^d\to\mathbb{R}\) be twice continuously differentiable with
  \(L_2\)-Lipschitz Hessian in the sense of \(\cref{def:has-lipschitz-hessian}\), where
  \(L_2\geq0\).  Let \(\mathsf{run}\) be a conversion run as in
  \(\cref{def:conversion-run}\), and suppose that \(T>0\).  Then, for every \(k\in\mathbb{N}\),
  \[
    \|\nabla f(\bar w^k)\|
    \leq \left\|\frac1T\sum_{n=0}^{T-1}\nabla f(w_{kT+n})\right\|
       +\frac{L_2}{2}T^2D^2.
  \]
  where the midpoint, episode average, and episode gradient sum are those of
  \(\cref{def:conversion-midpoint,def:episode-average,def:episode-gradient-sum}\). -/)
  (proof := /-- Fix an episode, write its midpoints as \(w_0,\ldots,w_{T-1}\), and write
  their average as \(\bar w\), according to
  \(\cref{def:conversion-midpoint,def:episode-average}\).  Since \(f\) is twice continuously
  differentiable, its gradient is continuously differentiable.  Apply the fundamental theorem
  of calculus along the segment from \(a\) to \(x\), and use the Hessian definition and
  Lipschitz bound from
  \(\cref{def:objective-hessian,def:has-lipschitz-hessian}\), to obtain
  \[
    \|\nabla f(x)-\nabla f(a)-\nabla^2f(a)(x-a)\|
      \leq \frac{L_2}{2}\|x-a\|^2.
  \]
  The update identity in \(\cref{def:conversion-run}\) telescopes to
  \(\|x_{i+m}-x_i\|\leq mD\).  Applying this estimate to both endpoints in the midpoint
  definition shows that two midpoints in the episode are at distance at most \(TD\).
  Positivity of \(T\) and the identity
  \(w_n-\bar w=T^{-1}\sum_{j=0}^{T-1}(w_n-w_j)\) therefore give
  \(\|w_n-\bar w\|\leq TD\).

  Define
  \(r_n=\nabla f(w_n)-\nabla f(\bar w)-\nabla^2f(\bar w)(w_n-\bar w)\).
  The Taylor estimate yields \(\|r_n\|\leq L_2T^2D^2/2\).  The definition of the average
  gives \(\sum_n(w_n-\bar w)=0\), so linearity of the Hessian cancels all first-order terms.
  Thus, using \(\cref{def:episode-gradient-sum}\),
  \[
    \nabla f(\bar w)=T^{-1}\sum_n\nabla f(w_n)-T^{-1}\sum_n r_n.
  \]
  The triangle inequality and the preceding uniform remainder bound prove the claimed estimate. -/)
  (title := /-- Gradient bound at an episode average -/)
  (latexEnv := "lemma")]
lemma averaged_gradient_estimate
    {d K T : ℕ} {D eta delta L2 : ℝ}
    (f : optimization_point d → ℝ)
    (run : conversion_run d K T D eta delta)
    (h_smooth : ContDiff ℝ 2 f)
    (h_hessian : has_lipschitz_hessian f L2)
    (hL2 : 0 ≤ L2)
    (hT : 0 < T)
    (k : ℕ) :
    ‖gradient f (episode_average run k)‖ ≤
      ‖(T : ℝ)⁻¹ • episode_gradient_sum f run k‖ +
        L2 / 2 * (T : ℝ) ^ 2 * D ^ 2 := by
  have h_grad_smooth : ContDiff ℝ 1 (gradient f) := by
    unfold gradient
    exact (InnerProductSpace.toDual ℝ (optimization_point d)).symm.contDiff.comp
      (h_smooth.fderiv_right (by norm_num))
  have h_taylor (a x : optimization_point d) :
      ‖gradient f x - gradient f a - objective_hessian f a (x - a)‖ ≤
        L2 / 2 * ‖x - a‖ ^ 2 := by
    let v := x - a
    have hline (t : ℝ) :=
      (hasDerivAt_const t a).add ((hasDerivAt_id t).smul_const v)
    have hcomp (t : ℝ) :=
      (h_grad_smooth.differentiable (by norm_num) (a + t • v)).hasFDerivAt
        |>.comp_hasDerivAt t (hline t)
    have hr_deriv (t : ℝ) := hcomp t |>.sub_const (gradient f a) |>.sub
      ((hasDerivAt_id t).smul_const (objective_hessian f a v))
    have h_hessian_cont : Continuous (objective_hessian f) := by
      unfold objective_hessian
      exact h_grad_smooth.continuous_fderiv (by norm_num)
    let q : ℝ → optimization_point d := fun t =>
      (objective_hessian f (a + t • v) - objective_hessian f a) v
    have hq_cont : Continuous q := by
      dsimp [q]
      fun_prop
    have hderiv_cont : Continuous (fun t : ℝ =>
        (fderiv ℝ (gradient f) (a + t • v)) (0 + (1 : ℝ) • v) -
          (1 : ℝ) • objective_hessian f a v) := by
      rw [show (fun t : ℝ =>
          (fderiv ℝ (gradient f) (a + t • v)) (0 + (1 : ℝ) • v) -
            (1 : ℝ) • objective_hessian f a v) = q by
        funext t
        simp [q, objective_hessian]]
      exact hq_cont
    have hfund : ∫ t in (0 : ℝ)..1, q t =
        gradient f (a + 1 • v) - gradient f a -
          1 • objective_hessian f a v := by
      have hfund0 := intervalIntegral.integral_eq_sub_of_hasDerivAt
        (a := (0 : ℝ)) (b := 1) (fun t _ => hr_deriv t)
          (hderiv_cont.intervalIntegrable (μ := MeasureTheory.volume) 0 1)
      convert hfund0 using 1 <;>
        simp [q, objective_hessian]
    have hq_bound (t : ℝ) (ht : t ∈ Set.uIcc (0 : ℝ) 1) :
        ‖q t‖ ≤ L2 * t * ‖v‖ ^ 2 := by
      calc
        ‖q t‖ ≤ ‖objective_hessian f (a + t • v) - objective_hessian f a‖ * ‖v‖ :=
          ContinuousLinearMap.le_opNorm
            (objective_hessian f (a + t • v) - objective_hessian f a) v
        _ ≤ (L2 * ‖(a + t • v) - a‖) * ‖v‖ := by
          gcongr
          exact h_hessian (a + t • v) a
        _ = L2 * t * ‖v‖ ^ 2 := by
          have ht0 : 0 ≤ t := by simpa [Set.uIcc_of_le zero_le_one] using ht.1
          rw [add_sub_cancel_left, norm_smul, Real.norm_eq_abs, abs_of_nonneg ht0]
          ring
    have hint_bound := intervalIntegral.norm_integral_le_of_norm_le
      (μ := MeasureTheory.volume) zero_le_one
      (f := q) (g := fun t : ℝ => L2 * t * ‖v‖ ^ 2)
      (Filter.Eventually.of_forall fun t ht => hq_bound t
        (by simpa [Set.uIcc_of_le zero_le_one] using ⟨ht.1.le, ht.2⟩))
      ((by fun_prop : Continuous (fun t : ℝ => L2 * t * ‖v‖ ^ 2)).intervalIntegrable
        (μ := MeasureTheory.volume) 0 1)
    have hid : ∫ t in (0 : ℝ)..1, t = 1 / 2 := by
      have hanti (t : ℝ) : HasDerivAt (fun s : ℝ => s ^ 2 / 2) t t := by
        simpa [pow_two] using (((hasDerivAt_id t).mul (hasDerivAt_id t)).div_const 2)
      have hi := intervalIntegral.integral_eq_sub_of_hasDerivAt
        (a := (0 : ℝ)) (b := 1) (fun t _ => hanti t)
        (continuous_id.intervalIntegrable (μ := MeasureTheory.volume) 0 1)
      norm_num at hi ⊢
      exact hi
    rw [show (fun t : ℝ => L2 * t * ‖v‖ ^ 2) =
        fun t : ℝ => (L2 * t) * ‖v‖ ^ 2 by funext t; ring,
      intervalIntegral.integral_mul_const,
      intervalIntegral.integral_const_mul,
      hid] at hint_bound
    norm_num at hint_bound
    rw [hfund] at hint_bound
    simpa [v, div_eq_mul_inv] using hint_bound
  have hD : 0 ≤ D :=
    (norm_nonneg (run.displacement 0)).trans (run.displacement_norm_le 0)
  have h_iterate_segment (i m : ℕ) :
      ‖run.iterate (i + m) - run.iterate i‖ ≤ (m : ℝ) * D := by
    induction m with
    | zero => simp
    | succ m ih =>
      rw [show i + Nat.succ m = (i + m) + 1 by omega, run.iterate_succ]
      calc
        ‖run.iterate (i + m) + run.displacement (i + m) - run.iterate i‖ =
            ‖(run.iterate (i + m) - run.iterate i) + run.displacement (i + m)‖ := by
              congr 1
              abel
        _ ≤ ‖run.iterate (i + m) - run.iterate i‖ + ‖run.displacement (i + m)‖ :=
          norm_add_le _ _
        _ ≤ (m : ℝ) * D + D := add_le_add ih (run.displacement_norm_le (i + m))
        _ = (Nat.succ m : ℝ) * D := by
          push_cast
          ring
  have h_midpoint_segment (i m : ℕ) :
      ‖conversion_midpoint run (i + m) - conversion_midpoint run i‖ ≤ (m : ℝ) * D := by
    have hsecond :
        ‖run.iterate (i + m + 1) - run.iterate (i + 1)‖ ≤ (m : ℝ) * D := by
      simpa only [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
        h_iterate_segment (i + 1) m
    rw [show conversion_midpoint run (i + m) - conversion_midpoint run i =
        (2 : ℝ)⁻¹ • ((run.iterate (i + m) - run.iterate i) +
          (run.iterate (i + m + 1) - run.iterate (i + 1))) by
      simp only [conversion_midpoint]
      module]
    calc
      ‖(2 : ℝ)⁻¹ • ((run.iterate (i + m) - run.iterate i) +
          (run.iterate (i + m + 1) - run.iterate (i + 1)))‖ =
          (2 : ℝ)⁻¹ * ‖(run.iterate (i + m) - run.iterate i) +
            (run.iterate (i + m + 1) - run.iterate (i + 1))‖ := by
              rw [norm_smul, Real.norm_eq_abs]
              norm_num
      _ ≤ (2 : ℝ)⁻¹ * (‖run.iterate (i + m) - run.iterate i‖ +
          ‖run.iterate (i + m + 1) - run.iterate (i + 1)‖) := by
            gcongr
            exact norm_add_le _ _
      _ ≤ (2 : ℝ)⁻¹ * ((m : ℝ) * D + (m : ℝ) * D) := by
        gcongr
        exact h_iterate_segment i m
      _ = (m : ℝ) * D := by ring
  have h_midpoint_pair {n j : ℕ} (hn : n < T) (hj : j < T) :
      ‖conversion_midpoint run (k * T + n) - conversion_midpoint run (k * T + j)‖ ≤
        (T : ℝ) * D := by
    by_cases hjn : j ≤ n
    · calc
        ‖conversion_midpoint run (k * T + n) -
            conversion_midpoint run (k * T + j)‖ =
            ‖conversion_midpoint run ((k * T + j) + (n - j)) -
              conversion_midpoint run (k * T + j)‖ := by
                congr 3
                omega
        _ ≤ (n - j : ℕ) * D := h_midpoint_segment (k * T + j) (n - j)
        _ ≤ (T : ℝ) * D := by
          gcongr
          exact_mod_cast (show n - j ≤ T by omega)
    · have hnj : n ≤ j := Nat.le_of_lt (Nat.lt_of_not_ge hjn)
      rw [norm_sub_rev]
      calc
        ‖conversion_midpoint run (k * T + j) -
            conversion_midpoint run (k * T + n)‖ =
            ‖conversion_midpoint run ((k * T + n) + (j - n)) -
              conversion_midpoint run (k * T + n)‖ := by
                congr 3
                omega
        _ ≤ (j - n : ℕ) * D := h_midpoint_segment (k * T + n) (j - n)
        _ ≤ (T : ℝ) * D := by
          gcongr
          exact_mod_cast (show j - n ≤ T by omega)
  have hTne : (T : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hT)
  have h_average_identity {n : ℕ} (hn : n < T) :
      conversion_midpoint run (k * T + n) - episode_average run k =
        (T : ℝ)⁻¹ • ∑ j ∈ Finset.range T,
          (conversion_midpoint run (k * T + n) -
            conversion_midpoint run (k * T + j)) := by
    simp [episode_average, Finset.sum_sub_distrib]
    rw [← Nat.cast_smul_eq_nsmul ℝ, smul_sub, smul_smul,
      inv_mul_cancel₀ hTne, one_smul]
  have h_centered {n : ℕ} (hn : n < T) :
      ‖conversion_midpoint run (k * T + n) - episode_average run k‖ ≤
        (T : ℝ) * D := by
    rw [h_average_identity hn, norm_smul, Real.norm_eq_abs,
      abs_of_nonneg (inv_nonneg.mpr (Nat.cast_nonneg T))]
    calc
      (T : ℝ)⁻¹ * ‖∑ j ∈ Finset.range T,
          (conversion_midpoint run (k * T + n) -
            conversion_midpoint run (k * T + j))‖ ≤
          (T : ℝ)⁻¹ * ∑ j ∈ Finset.range T,
            ‖conversion_midpoint run (k * T + n) -
              conversion_midpoint run (k * T + j)‖ := by
                gcongr
                exact norm_sum_le _ _
      _ ≤ (T : ℝ)⁻¹ * ∑ j ∈ Finset.range T, (T : ℝ) * D := by
        gcongr with j hj
        exact h_midpoint_pair hn (Finset.mem_range.mp hj)
      _ = (T : ℝ) * D := by
        simp [hTne]
  have h_center_sum :
      (∑ n ∈ Finset.range T,
        (conversion_midpoint run (k * T + n) - episode_average run k)) = 0 := by
    simp only [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_range]
    rw [← Nat.cast_smul_eq_nsmul ℝ, episode_average, smul_smul,
      mul_inv_cancel₀ hTne, one_smul, sub_self]
  have h_linear_sum :
      (∑ n ∈ Finset.range T, objective_hessian f (episode_average run k)
        (conversion_midpoint run (k * T + n) - episode_average run k)) = 0 := by
    rw [← map_sum, h_center_sum, map_zero]
  let rem : ℕ → optimization_point d := fun n =>
    gradient f (conversion_midpoint run (k * T + n)) -
      gradient f (episode_average run k) -
        objective_hessian f (episode_average run k)
          (conversion_midpoint run (k * T + n) - episode_average run k)
  have hrem_bound {n : ℕ} (hn : n < T) :
      ‖rem n‖ ≤ L2 / 2 * ((T : ℝ) * D) ^ 2 := by
    dsimp [rem]
    exact (h_taylor (episode_average run k)
      (conversion_midpoint run (k * T + n))).trans (by
        gcongr
        exact h_centered hn)
  have h_rem_sum :
      (∑ n ∈ Finset.range T, rem n) =
        episode_gradient_sum f run k - T • gradient f (episode_average run k) := by
    dsimp only [rem]
    rw [Finset.sum_sub_distrib, Finset.sum_sub_distrib, h_linear_sum, sub_zero]
    simp only [Finset.sum_const, Finset.card_range, episode_gradient_sum]
  have h_grad_eq :
      gradient f (episode_average run k) =
        (T : ℝ)⁻¹ • episode_gradient_sum f run k -
          (T : ℝ)⁻¹ • ∑ n ∈ Finset.range T, rem n := by
    rw [h_rem_sum, smul_sub, ← Nat.cast_smul_eq_nsmul ℝ, smul_smul,
      inv_mul_cancel₀ hTne, one_smul]
    abel
  have h_sum_rem :
      ‖(T : ℝ)⁻¹ • ∑ n ∈ Finset.range T, rem n‖ ≤
        L2 / 2 * (T : ℝ) ^ 2 * D ^ 2 := by
    rw [norm_smul, Real.norm_eq_abs,
      abs_of_nonneg (inv_nonneg.mpr (Nat.cast_nonneg T))]
    calc
      (T : ℝ)⁻¹ * ‖∑ n ∈ Finset.range T, rem n‖ ≤
          (T : ℝ)⁻¹ * ∑ n ∈ Finset.range T, ‖rem n‖ := by
            gcongr
            exact norm_sum_le _ _
      _ ≤ (T : ℝ)⁻¹ * ∑ n ∈ Finset.range T,
          (L2 / 2 * ((T : ℝ) * D) ^ 2) := by
            gcongr with n hn
            exact hrem_bound (Finset.mem_range.mp hn)
      _ = L2 / 2 * (T : ℝ) ^ 2 * D ^ 2 := by
        simp [hTne]
        ring
  rw [h_grad_eq]
  calc
    ‖(T : ℝ)⁻¹ • episode_gradient_sum f run k -
        (T : ℝ)⁻¹ • ∑ n ∈ Finset.range T, rem n‖ ≤
        ‖(T : ℝ)⁻¹ • episode_gradient_sum f run k‖ +
          ‖(T : ℝ)⁻¹ • ∑ n ∈ Finset.range T, rem n‖ := norm_sub_le _ _
    _ ≤ ‖(T : ℝ)⁻¹ • episode_gradient_sum f run k‖ +
        L2 / 2 * (T : ℝ) ^ 2 * D ^ 2 := by gcongr

@[blueprint "lem:average-gradient-from-regret"
  (statement := /-- Let \(d,K,T\in\mathbb{N}\) and
  \(D,\eta,\delta,L_2,f^*\in\mathbb{R}\), with \(D>0\), \(T>0\), and \(L_2\geq0\).
  Let \(f:\mathbb{R}^d\to\mathbb{R}\) be twice continuously differentiable, have
  \(L_2\)-Lipschitz Hessian, and satisfy \(f^*\leq f(x)\) for every
  \(x\in\mathbb{R}^d\).  Let \(\mathsf{run}\) be a conversion run with parameters
  \((d,K,T,D,\eta,\delta)\) in the sense of \(\cref{def:conversion-run}\).  For the episode
  comparators of \(\cref{def:episode-comparator}\),
  \[
  \begin{aligned}
  \frac1K\sum_{k=0}^{K-1}\|\nabla f(\bar w^k)\|
  \leq{}&\frac{f(x_0)-f^*}{DKT}
  +\frac{\operatorname{Reg}_T}{DKT}
  +\frac{L_2D^2}{24}
  +\frac{L_2T^2D^2}{2}.
  \end{aligned}
  \] -/)
  (proof := /-- Apply \(\cref{lem:midpoint-conversion}\) to the \(KT\) updates and sum the
  resulting inequalities first within each episode and then across the episodes.  The
  objective differences telescope, and the lower bound \(f^*\leq f(x)\) bounds the terminal
  objective value from below.  For the episode gradient sum \(G_k\) of
  \(\cref{def:episode-gradient-sum}\), the definition in
  \(\cref{def:episode-comparator}\), including the case \(G_k=0\), gives
  \(\langle G_k,u^k\rangle=-D\|G_k\|\).  Expanding the displacement-minus-comparator inner
  products in \(\cref{def:conversion-regret}\) therefore bounds
  \(D\sum_k\|G_k\|\) by the initial objective gap, the regret, and the accumulated midpoint
  remainder.

  If \(K=0\), the episode sums and all terms divided by \(K\) vanish under the real-field
  convention, and the result follows from \(L_2\geq0\).  Otherwise \(K>0\).  Divide the
  preceding bound by the positive quantities \(D\), \(K\), and \(T\).  Apply
  \(\cref{lem:averaged-gradient-estimate}\) in every episode and sum; the norm of
  \(T^{-1}G_k\) is \(T^{-1}\|G_k\|\) because \(T>0\).
  The \(KT\) midpoint remainders contribute \(L_2D^2/24\), while the episode-averaging
  remainders contribute \(L_2T^2D^2/2\), giving the displayed bound. -/)
  (title := /-- Average stationarity controlled by regret -/)
  (latexEnv := "lemma")]
lemma average_gradient_from_regret
    {d K T : ℕ} {D eta delta L2 fStar : ℝ}
    (f : optimization_point d → ℝ)
    (run : conversion_run d K T D eta delta)
    (h_smooth : ContDiff ℝ 2 f)
    (h_hessian : has_lipschitz_hessian f L2)
    (hL2 : 0 ≤ L2)
    (hD : 0 < D)
    (hT : 0 < T)
    (h_lower : ∀ x, fStar ≤ f x) :
    (K : ℝ)⁻¹ *
        ∑ k ∈ Finset.range K, ‖gradient f (episode_average run k)‖ ≤
      (f (run.iterate 0) - fStar) / (D * (K : ℝ) * (T : ℝ)) +
        conversion_regret f run (episode_comparator f run) /
          (D * (K : ℝ) * (T : ℝ)) +
        L2 / 24 * D ^ 2 + L2 / 2 * (T : ℝ) ^ 2 * D ^ 2 := by
  by_cases hKzero : K = 0
  · subst K
    simp [conversion_regret]
    positivity
  have hK : 0 < K := Nat.pos_of_ne_zero hKzero
  have hKr : 0 < (K : ℝ) := by exact_mod_cast hK
  have hTr : 0 < (T : ℝ) := by exact_mod_cast hT
  have hstep (n : ℕ) :
      f (run.iterate (n + 1)) - f (run.iterate n) - L2 * D ^ 3 / 24 ≤
        inner ℝ (gradient f (conversion_midpoint run n)) (run.displacement n) := by
    have h := midpoint_conversion f run h_smooth h_hessian hL2 n
    linarith
  have hepisode (k : ℕ) :
      f (run.iterate ((k + 1) * T)) - f (run.iterate (k * T)) -
          (T : ℝ) * (L2 * D ^ 3 / 24) ≤
        ∑ n ∈ Finset.range T,
          inner ℝ (gradient f (conversion_midpoint run (k * T + n)))
            (run.displacement (k * T + n)) := by
    calc
      f (run.iterate ((k + 1) * T)) - f (run.iterate (k * T)) -
          (T : ℝ) * (L2 * D ^ 3 / 24) =
          ∑ n ∈ Finset.range T,
            (f (run.iterate (k * T + (n + 1))) -
              f (run.iterate (k * T + n)) - L2 * D ^ 3 / 24) := by
        rw [Finset.sum_sub_distrib,
          Finset.sum_range_sub (fun n => f (run.iterate (k * T + n))) T]
        simp only [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
        congr 1 <;> norm_num <;> ring_nf
      _ ≤ ∑ n ∈ Finset.range T,
          inner ℝ (gradient f (conversion_midpoint run (k * T + n)))
            (run.displacement (k * T + n)) := by
        gcongr with n hn
        simpa only [Nat.add_assoc] using hstep (k * T + n)
  have hmovement :
      f (run.iterate (K * T)) - f (run.iterate 0) -
          (K : ℝ) * (T : ℝ) * (L2 * D ^ 3 / 24) ≤
        ∑ k ∈ Finset.range K, ∑ n ∈ Finset.range T,
          inner ℝ (gradient f (conversion_midpoint run (k * T + n)))
            (run.displacement (k * T + n)) := by
    calc
      f (run.iterate (K * T)) - f (run.iterate 0) -
          (K : ℝ) * (T : ℝ) * (L2 * D ^ 3 / 24) =
          ∑ k ∈ Finset.range K,
            (f (run.iterate ((k + 1) * T)) - f (run.iterate (k * T)) -
              (T : ℝ) * (L2 * D ^ 3 / 24)) := by
        rw [Finset.sum_sub_distrib,
          Finset.sum_range_sub (fun k => f (run.iterate (k * T))) K]
        simp only [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
        ring_nf
      _ ≤ ∑ k ∈ Finset.range K, ∑ n ∈ Finset.range T,
          inner ℝ (gradient f (conversion_midpoint run (k * T + n)))
            (run.displacement (k * T + n)) := by
        gcongr with k hk
        exact hepisode k
  have hcomp (k : ℕ) :
      ∑ n ∈ Finset.range T,
          inner ℝ (gradient f (conversion_midpoint run (k * T + n)))
            (episode_comparator f run k) =
        -D * ‖episode_gradient_sum f run k‖ := by
    rw [← sum_inner]
    unfold episode_comparator episode_gradient_sum
    rw [inner_smul_right, real_inner_self_eq_norm_sq]
    by_cases hG : ‖∑ n ∈ Finset.range T,
        gradient f (conversion_midpoint run (k * T + n))‖ = 0
    · simp [hG]
    · rw [div_mul_eq_mul_div]
      field_simp
  have hregret :
      conversion_regret f run (episode_comparator f run) =
        (∑ k ∈ Finset.range K, ∑ n ∈ Finset.range T,
          inner ℝ (gradient f (conversion_midpoint run (k * T + n)))
            (run.displacement (k * T + n))) +
          D * ∑ k ∈ Finset.range K, ‖episode_gradient_sum f run k‖ := by
    unfold conversion_regret
    calc
      (∑ k ∈ Finset.range K, ∑ n ∈ Finset.range T,
          inner ℝ (gradient f (conversion_midpoint run (k * T + n)))
            (run.displacement (k * T + n) - episode_comparator f run k)) =
          ∑ k ∈ Finset.range K,
            ((∑ n ∈ Finset.range T,
              inner ℝ (gradient f (conversion_midpoint run (k * T + n)))
                (run.displacement (k * T + n))) -
              ∑ n ∈ Finset.range T,
                inner ℝ (gradient f (conversion_midpoint run (k * T + n)))
                  (episode_comparator f run k)) := by
        apply Finset.sum_congr rfl
        intro k hk
        simp only [inner_sub_right, Finset.sum_sub_distrib]
      _ = ∑ k ∈ Finset.range K,
            ((∑ n ∈ Finset.range T,
              inner ℝ (gradient f (conversion_midpoint run (k * T + n)))
                (run.displacement (k * T + n))) +
              D * ‖episode_gradient_sum f run k‖) := by
        apply Finset.sum_congr rfl
        intro k hk
        rw [hcomp k]
        ring
      _ = (∑ k ∈ Finset.range K, ∑ n ∈ Finset.range T,
            inner ℝ (gradient f (conversion_midpoint run (k * T + n)))
              (run.displacement (k * T + n))) +
            D * ∑ k ∈ Finset.range K, ‖episode_gradient_sum f run k‖ := by
        rw [Finset.sum_add_distrib, Finset.mul_sum]
  have hnormsum :
      D * ∑ k ∈ Finset.range K, ‖episode_gradient_sum f run k‖ ≤
        f (run.iterate 0) - fStar +
          conversion_regret f run (episode_comparator f run) +
          (K : ℝ) * (T : ℝ) * (L2 * D ^ 3 / 24) := by
    rw [hregret]
    linarith [h_lower (run.iterate (K * T)), hmovement]
  have hnormsum_div :
      (∑ k ∈ Finset.range K, ‖episode_gradient_sum f run k‖) ≤
        (f (run.iterate 0) - fStar +
            conversion_regret f run (episode_comparator f run) +
            (K : ℝ) * (T : ℝ) * (L2 * D ^ 3 / 24)) / D := by
    apply (le_div_iff₀ hD).2
    simpa only [mul_comm] using hnormsum
  have havg_sum :
      (∑ k ∈ Finset.range K, ‖gradient f (episode_average run k)‖) ≤
        (∑ k ∈ Finset.range K,
          ‖(T : ℝ)⁻¹ • episode_gradient_sum f run k‖) +
          (K : ℝ) * (L2 / 2 * (T : ℝ) ^ 2 * D ^ 2) := by
    calc
      (∑ k ∈ Finset.range K, ‖gradient f (episode_average run k)‖) ≤
          ∑ k ∈ Finset.range K,
            (‖(T : ℝ)⁻¹ • episode_gradient_sum f run k‖ +
              L2 / 2 * (T : ℝ) ^ 2 * D ^ 2) := by
        gcongr with k hk
        exact averaged_gradient_estimate f run h_smooth h_hessian hL2 hT k
      _ = (∑ k ∈ Finset.range K,
            ‖(T : ℝ)⁻¹ • episode_gradient_sum f run k‖) +
            (K : ℝ) * (L2 / 2 * (T : ℝ) ^ 2 * D ^ 2) := by
        rw [Finset.sum_add_distrib]
        simp only [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  have hscaled (k : ℕ) :
      ‖(T : ℝ)⁻¹ • episode_gradient_sum f run k‖ =
        (T : ℝ)⁻¹ * ‖episode_gradient_sum f run k‖ := by
    rw [norm_smul]
    simp [Real.norm_eq_abs, abs_of_pos hTr]
  have hscaled_sum :
      (∑ k ∈ Finset.range K,
          ‖(T : ℝ)⁻¹ • episode_gradient_sum f run k‖) =
        (T : ℝ)⁻¹ * ∑ k ∈ Finset.range K, ‖episode_gradient_sum f run k‖ := by
    simp_rw [hscaled]
    rw [Finset.mul_sum]
  rw [hscaled_sum] at havg_sum
  calc
    (K : ℝ)⁻¹ *
        ∑ k ∈ Finset.range K, ‖gradient f (episode_average run k)‖ ≤
        (K : ℝ)⁻¹ *
          ((T : ℝ)⁻¹ *
              ∑ k ∈ Finset.range K, ‖episode_gradient_sum f run k‖ +
            (K : ℝ) * (L2 / 2 * (T : ℝ) ^ 2 * D ^ 2)) := by
      gcongr
    _ = (∑ k ∈ Finset.range K, ‖episode_gradient_sum f run k‖) /
          ((K : ℝ) * (T : ℝ)) + L2 / 2 * (T : ℝ) ^ 2 * D ^ 2 := by
      field_simp [ne_of_gt hKr, ne_of_gt hTr]
      <;> ring
    _ ≤ ((f (run.iterate 0) - fStar +
              conversion_regret f run (episode_comparator f run) +
              (K : ℝ) * (T : ℝ) * (L2 * D ^ 3 / 24)) / D) /
            ((K : ℝ) * (T : ℝ)) + L2 / 2 * (T : ℝ) ^ 2 * D ^ 2 := by
      exact add_le_add
        ((div_le_div_iff_of_pos_right (mul_pos hKr hTr)).2 hnormsum_div) le_rfl
    _ = (f (run.iterate 0) - fStar) / (D * (K : ℝ) * (T : ℝ)) +
          conversion_regret f run (episode_comparator f run) /
            (D * (K : ℝ) * (T : ℝ)) +
          L2 / 24 * D ^ 2 + L2 / 2 * (T : ℝ) ^ 2 * D ^ 2 := by
      field_simp [ne_of_gt hD, ne_of_gt hKr, ne_of_gt hTr]
      <;> ring

@[blueprint "lem:source-convergence-rate-gap"
  (statement := /-- Let \(d,K,T,M\) be natural numbers, let
  \(D,\eta,\delta,L_1,L_2,f^*\in\mathbb{R}\), and let
  \(f:\mathbb{R}^d\to\mathbb{R}\) be twice continuously differentiable with
  \(L_1\)-Lipschitz gradient and \(L_2\)-Lipschitz Hessian.  Assume that \(f^*\) is the
  greatest lower bound of the range of \(f\).  Let a conversion run with parameters
  \((d,K,T,D,\eta,\delta)\) satisfy the rate-relevant optimistic quasi-Newton conditions in
  \(\cref{def:conversion-algorithm-execution}\), including the objective-accuracy and
  first-order residual requirements for every trust-region subproblem and the aggregate
  model-quality budget.  Suppose also that
  \(d,K,T,M,L_1,L_2,f(x_0)-f^*,D,\eta,\delta\) are positive and satisfy all exact identities
  in \(\cref{def:prescribed-parameters}\), including \(KT=M\).  Then the run's
  episode-average gradients satisfy
  \[
    \frac1K\sum_{k=0}^{K-1}\|\nabla f(\bar w^k)\|
    \leq \mathcal B(d,M,L_1,L_2,f(x_0)-f^*),
  \]
  where \(\mathcal B\) is the four-term expression of
  \(\cref{def:convergence-rate-bound}\). -/)
  (proof := /-- Since \(f^*\) is the greatest lower bound of the range of \(f\), it is a lower
  bound for every objective value.  The parameter prescription gives \(L_2>0\) and \(T>0\).
  Apply \(\cref{lem:average-gradient-from-regret}\) with these facts.  Let \(E\) denote the
  displayed sum of squared prediction errors in
  \(\cref{def:conversion-algorithm-execution}\).  The regret and aggregate model-quality
  inequalities give
  \[
    \frac{\operatorname{Reg}_T}{DKT}+\frac{L_2T^2D^2}{2}
    \leq
    \frac{L_2^{8/5}D^{13/5}}{8d^{3/5}L_1^{3/5}}
    +\frac{7\,52^{3/13}d^{2/5}L_1^{7/5}D^{3/5}}{L_2^{2/5}KT};
  \]
  indeed, the first inequality replaces \(\operatorname{Reg}_T\) by
  \(D^2/(2\eta)+(\eta/2)E+\delta KT\), and the second bounds this quantity together with the
  averaging remainder.  Substitute the prescribed identities for \(D\) and \(KT=M\).
  The two terms on the right become respectively the second and third terms of
  \(\mathcal B\), while the initial objective term in
  \(\cref{lem:average-gradient-from-regret}\) is \(\Gamma/(DM)\).  The remaining midpoint
  contribution is \(L_2D^2/24\).  Split it into two
  copies of \(L_2D^2/48\); after substituting the formula for \(D\), one copy is exactly the
  fourth term of \(\mathcal B\).

  It remains to absorb the other copy.  Write \(\Gamma=f(x_0)-f^*\).  The first term of
  \(\mathcal B\) is \(2\Gamma/(DM)\), whereas the telescoping objective differences use one
  copy of \(\Gamma/(DM)\).  Since \(T\) is a positive integer, \(T\geq1\).  Substituting the
  prescribed formulas for \(T\) and \(\eta\) into this inequality gives
  \[
    \left(\frac{DL_2}{24dL_1}\right)^{1/5}\leq3.
  \]
  Squaring and using \(24^{2/5}\leq24\) yields
  \[
    \left(\frac{DL_2}{dL_1}\right)^{2/5}
      \leq 9\,24^{2/5}\leq216<48\cdot52.
  \]
  The prescribed identity
  \(\Gamma=52d^{2/5}L_1^{2/5}L_2^{3/5}MD^{13/5}\) therefore implies
  \(L_2D^2/48\leq\Gamma/(DM)\).  Thus the unused copy of \(\Gamma/(DM)\) in the leading term
  absorbs the additional midpoint remainder, and the displayed inequality follows. -/)
  (title := /-- Exact rate from the algorithmic execution certificate -/)
  (latexEnv := "lemma")]
lemma source_convergence_rate_gap
    {d K T M : ℕ} {D eta delta L1 L2 fStar : ℝ}
    (f : optimization_point d → ℝ)
    (run : conversion_run d K T D eta delta)
    (h_smooth : ContDiff ℝ 2 f)
    (h_gradient : has_lipschitz_gradient f L1)
    (h_hessian : has_lipschitz_hessian f L2)
    (h_optimal : IsGLB (Set.range f) fStar)
    (h_execution : conversion_algorithm_execution (L1 := L1) (L2 := L2) f run)
    (h_parameters :
      prescribed_parameters d K T M L1 L2
        (f (run.iterate 0) - fStar) D eta delta) :
    (K : ℝ)⁻¹ *
        ∑ k ∈ Finset.range K, ‖gradient f (episode_average run k)‖ ≤
      convergence_rate_bound d M L1 L2 (f (run.iterate 0) - fStar) := by
  rcases h_parameters with
    ⟨hd, hK, hT, hM, hL1, hL2, hgap, hD, heta, hdelta,
      hD_eq, heta_eq, hT_eq, hdelta_eq, hKT⟩
  have hKr : 0 < (K : ℝ) := by exact_mod_cast hK
  have hTr : 0 < (T : ℝ) := by exact_mod_cast hT
  have hMr : 0 < (M : ℝ) := by exact_mod_cast hM
  have hdr : 0 < (d : ℝ) := by exact_mod_cast hd
  have hKTr : (K : ℝ) * (T : ℝ) = (M : ℝ) := by exact_mod_cast hKT
  have hden : 0 < D * (K : ℝ) * (T : ℝ) := mul_pos (mul_pos hD hKr) hTr
  have h_lower : ∀ x, fStar ≤ f x := by
    intro x
    exact h_optimal.1 ⟨x, rfl⟩
  have havg := average_gradient_from_regret f run h_smooth h_hessian hL2.le hD hT h_lower
  rcases h_execution with
    ⟨model, hmodel, hobjective, hresidual, hregret, hbudget⟩
  have hcertificate :
      conversion_regret f run (episode_comparator f run) +
          (D * (K : ℝ) * (T : ℝ)) * (L2 / 2 * (T : ℝ) ^ 2 * D ^ 2) ≤
        (D * (K : ℝ) * (T : ℝ)) *
          (Real.rpow L2 ((8 : ℝ) / 5) * Real.rpow D ((13 : ℝ) / 5) /
              (8 * Real.rpow (d : ℝ) ((3 : ℝ) / 5) *
                Real.rpow L1 ((3 : ℝ) / 5)) +
            7 * Real.rpow 52 ((3 : ℝ) / 13) *
                Real.rpow (d : ℝ) ((2 : ℝ) / 5) *
                Real.rpow L1 ((7 : ℝ) / 5) * Real.rpow D ((3 : ℝ) / 5) /
              (Real.rpow L2 ((2 : ℝ) / 5) * ((K : ℝ) * (T : ℝ)))) := by
    have h :
        conversion_regret f run (episode_comparator f run) +
            D * (K * T : ℕ) * (L2 / 2 * (T : ℝ) ^ 2 * D ^ 2) ≤
          D * (K * T : ℕ) *
            (Real.rpow L2 ((8 : ℝ) / 5) * Real.rpow D ((13 : ℝ) / 5) /
                (8 * Real.rpow (d : ℝ) ((3 : ℝ) / 5) *
                  Real.rpow L1 ((3 : ℝ) / 5)) +
              7 * Real.rpow 52 ((3 : ℝ) / 13) *
                  Real.rpow (d : ℝ) ((2 : ℝ) / 5) *
                  Real.rpow L1 ((7 : ℝ) / 5) * Real.rpow D ((3 : ℝ) / 5) /
                (Real.rpow L2 ((2 : ℝ) / 5) * (K * T : ℕ))) := by
      calc
        _ ≤ (D ^ 2 / (2 * eta) +
              eta / 2 *
                ∑ n ∈ Finset.range (K * T),
                  ‖gradient f (conversion_midpoint run n) -
                    model n (run.displacement n)‖ ^ 2 +
              delta * (K * T : ℕ)) +
            D * (K * T : ℕ) * (L2 / 2 * (T : ℝ) ^ 2 * D ^ 2) := by
              gcongr
        _ ≤ _ := hbudget
    norm_num [Nat.cast_mul] at h ⊢
    simpa only [mul_assoc] using h
  have hcombined :
      conversion_regret f run (episode_comparator f run) /
            (D * (K : ℝ) * (T : ℝ)) +
          L2 / 2 * (T : ℝ) ^ 2 * D ^ 2 ≤
        Real.rpow L2 ((8 : ℝ) / 5) * Real.rpow D ((13 : ℝ) / 5) /
              (8 * Real.rpow (d : ℝ) ((3 : ℝ) / 5) *
                Real.rpow L1 ((3 : ℝ) / 5)) +
          7 * Real.rpow 52 ((3 : ℝ) / 13) *
              Real.rpow (d : ℝ) ((2 : ℝ) / 5) *
              Real.rpow L1 ((7 : ℝ) / 5) * Real.rpow D ((3 : ℝ) / 5) /
            (Real.rpow L2 ((2 : ℝ) / 5) * ((K : ℝ) * (T : ℝ))) := by
    calc
      _ = (conversion_regret f run (episode_comparator f run) +
            (D * (K : ℝ) * (T : ℝ)) *
              (L2 / 2 * (T : ℝ) ^ 2 * D ^ 2)) /
          (D * (K : ℝ) * (T : ℝ)) := by
            field_simp [ne_of_gt hden]
      _ ≤ ((D * (K : ℝ) * (T : ℝ)) *
            (Real.rpow L2 ((8 : ℝ) / 5) * Real.rpow D ((13 : ℝ) / 5) /
                (8 * Real.rpow (d : ℝ) ((3 : ℝ) / 5) *
