import Architect
import Mathlib.Data.Real.Sign
import Mathlib.MeasureTheory.Function.ConditionalExpectation.Basic
import Mathlib.MeasureTheory.Measure.Typeclasses.Probability

set_option linter.all false
set_option maxHeartbeats 500000

open MeasureTheory

@[blueprint "def:correlation"
  (statement := /-- Let $(\Omega,\mathcal F,\mu)$ be a measure space, let
  $X$ be a measurable feature space, and let $x:\Omega\to X$ and
  $y:\Omega\to\mathbb R$ be the feature and label random variables.  For a
  hypothesis $h:X\to\mathbb R$, its correlation with the label is
  \[
    \operatorname{cor}_{\mu}(y,h\circ x)
      = \int_{\Omega}(2y(\omega)-1)h(x(\omega))\,d\mu(\omega).
  \] -/)
  (title := /-- Correlation with a real-valued label -/)
  (latexEnv := "definition")]
noncomputable def correlation {Ω X : Type*} [MeasurableSpace Ω] [MeasurableSpace X]
    (μ : MeasureTheory.Measure Ω) (y : Ω → ℝ) (x : Ω → X) (h : X → ℝ) : ℝ :=
  ∫ ω, (2 * y ω - 1) * h (x ω) ∂μ

@[blueprint "def:residual-correlation"
  (statement := /-- Let $(\Omega,\mathcal F,\mu)$ be a measure space, let
  $X$ be a measurable feature space, and let $x:\Omega\to X$ and
  $y:\Omega\to\mathbb R$ be the feature and label random variables.  For a
  predictor $p:X\to\mathbb R$ and a test function $c:X\to\mathbb R$, define
  the residual correlation by
  \[
    R_{\mu}(y,p;c)=\int_{\Omega}c(x(\omega))
      \bigl(y(\omega)-p(x(\omega))\bigr)\,d\mu(\omega),
  \] -/)
  (title := /-- Residual correlation -/)
  (latexEnv := "definition")]
noncomputable def residual_correlation {Ω X : Type*}
    [MeasurableSpace Ω] [MeasurableSpace X]
    (μ : MeasureTheory.Measure Ω) (y : Ω → ℝ) (x : Ω → X)
    (p c : X → ℝ) : ℝ :=
  ∫ ω, c (x ω) * (y ω - p (x ω)) ∂μ

@[blueprint "def:threshold-predictor"
  (statement := /-- For a real-valued predictor $p:\Omega\to\mathbb R$, its
  sign-thresholded predictor is the function
  \[
    \widehat p(\omega)=\operatorname{sign}\bigl(2p(\omega)-1\bigr).
  \] -/)
  (title := /-- Sign-thresholded predictor -/)
  (latexEnv := "definition")]
noncomputable def threshold_predictor {Ω : Type*} (p : Ω → ℝ) : Ω → ℝ :=
  fun ω => Real.sign (2 * p ω - 1)

@[blueprint "def:multiaccurate"
  (statement := /-- Let $(\Omega,\mathcal F,\mu)$ be a measure space, let
  $X$ be a measurable feature space, let $x:\Omega\to X$ and
  $y:\Omega\to\mathbb R$ be the feature and label random variables, and let
  $\mathcal C$ be a class of functions $X\to\mathbb R$.  For
  $\tau\in\mathbb R$, a predictor $p:X\to\mathbb R$ is
  $(\mathcal C,\tau)$-multiaccurate for a label $y:\Omega\to\mathbb R$ if
  \[
    \left|R_{\mu}(y,p;c)\right|\leq \tau
    \qquad\text{for every }c\in\mathcal C.
  \] -/)
  (title := /-- Multiaccuracy -/)
  (latexEnv := "definition")]
def multiaccurate {Ω X : Type*} [MeasurableSpace Ω] [MeasurableSpace X]
    (μ : MeasureTheory.Measure Ω) (C : Set (X → ℝ)) (τ : ℝ)
    (y : Ω → ℝ) (x : Ω → X) (p : X → ℝ) : Prop :=
  ∀ c ∈ C, |residual_correlation μ y x p c| ≤ τ

@[blueprint "def:calibration-error"
  (statement := /-- Let $(\Omega,\mathcal F,\mu)$ be a measure space, let
  $X$ be a measurable feature space, let $x:\Omega\to X$ and
  $y:\Omega\to\mathbb R$ be the feature and label random variables, and let
  $p:X\to\mathbb R$ be a predictor.  With conditional expectation taken
  relative to the $\sigma$-algebra generated by $p\circ x$, define
  \[
    \operatorname{CalErr}_{\mu}(y,p\circ x)
      =\int_{\Omega}\left|
        \mathbb E_{\mu}[y\mid\sigma(p\circ x)](\omega)-p(x(\omega))
        \right|\,d\mu(\omega).
  \] -/)
  (title := /-- Global calibration error -/)
  (latexEnv := "definition")]
noncomputable def calibration_error {Ω X : Type*}
    [MeasurableSpace Ω] [MeasurableSpace X]
    (μ : MeasureTheory.Measure Ω) (y : Ω → ℝ) (x : Ω → X)
    (p : X → ℝ) : ℝ :=
  ∫ ω, |(μ[y | MeasurableSpace.comap (fun ω => p (x ω)) (borel ℝ)]) ω -
    p (x ω)| ∂μ

@[blueprint "def:calibrated"
  (statement := /-- Let $(\Omega,\mathcal F,\mu)$ be a measure space, let
  $X$ be a measurable feature space, let $x:\Omega\to X$ and
  $y:\Omega\to\mathbb R$ be the feature and label random variables, and let
  $\tau\in\mathbb R$.  A predictor $p:X\to\mathbb R$ is
  $\tau$-calibrated if
  \[
    \operatorname{CalErr}_{\mu}(y,p\circ x)\leq\tau.
  \] -/)
  (title := /-- Global calibration -/)
  (latexEnv := "definition")]
def calibrated {Ω X : Type*} [MeasurableSpace Ω] [MeasurableSpace X]
    (μ : MeasureTheory.Measure Ω) (τ : ℝ) (y : Ω → ℝ)
    (x : Ω → X) (p : X → ℝ) : Prop :=
  calibration_error μ y x p ≤ τ

@[blueprint "def:best-correlation"
  (statement := /-- Let $(\Omega,\mathcal F,\mu)$ be a measure space, let
  $X$ be a measurable feature space, let $x:\Omega\to X$ and
  $y:\Omega\to\mathbb R$ be the feature and label random variables, and let
  $\mathcal C$ be a class of functions $X\to\mathbb R$.  The best class
  correlation is the supremum
  \[
    \operatorname{BestCor}_{\mu}(y,x,\mathcal C)
      =\sup_{c\in\mathcal C}\operatorname{cor}_{\mu}(y,c\circ x).
  \] -/)
  (title := /-- Best correlation in a hypothesis class -/)
  (latexEnv := "definition")]
noncomputable def best_correlation {Ω X : Type*}
    [MeasurableSpace Ω] [MeasurableSpace X]
    (μ : MeasureTheory.Measure Ω) (y : Ω → ℝ) (x : Ω → X)
    (C : Set (X → ℝ)) : ℝ :=
  sSup ((fun c => correlation μ y x c) '' C)

@[blueprint "lem:calibration-controls-threshold-correlation"
  (statement := /-- Let $(\Omega,\mathcal F,\mu)$ be a probability space
  and let $X$ be a measurable feature space.  Let $x:\Omega\to X$,
  $y:\Omega\to\mathbb R$, and $p:X\to\mathbb R$ be measurable.  Assume
  that $y\in\{0,1\}$ almost everywhere and that $0\leq p(\xi)\leq1$ for
  every $\xi\in X$.  If $\tau\in\mathbb R$ and $p$ is
  $\tau$-calibrated with respect to the observed predictor $p\circ x$, then
  \[
    \operatorname{cor}_{\mu}(y,\widehat p\circ x)
      \geq 2\int_{\Omega}\left|p(x(\omega))-\frac12\right|\,d\mu(\omega)
        -2\tau.
  \] -/)
  (proof := /-- Write
  $q=\mathbb E_{\mu}[y\mid\sigma(p\circ x)]$ and set
  $A_{+}=\{2p\circ x-1>0\}$ and $A_{-}=\{2p\circ x-1<0\}$.
  The range and measurability hypotheses make all functions below
  integrable.  The sets $A_{+}$ and $A_{-}$ are measurable with respect to
  $\sigma(p\circ x)$, and, by \cref{def:threshold-predictor},
  $\widehat p\circ x=\mathbf 1_{A_{+}}-\mathbf 1_{A_{-}}$.  Applying the
  defining set-integral identity for conditional expectation separately on
  $A_{+}$ and $A_{-}$ therefore gives
  \[
    \operatorname{cor}_{\mu}(y,\widehat p\circ x)
      =\int_{\Omega}\widehat p(x(\omega))(2q(\omega)-1)\,d\mu(\omega).
  \]
  Split $2q-1=(2p\circ x-1)+2(q-p\circ x)$.  The identity
  $\operatorname{sign}(u)u=|u|$ makes the first resulting integral equal to
  $2\int_{\Omega}|p\circ x-1/2|\,d\mu$.  Moreover,
  $|\widehat p\circ x|\leq1$, so the triangle inequality bounds the second
  integral below by $-2\int_{\Omega}|q-p\circ x|\,d\mu$.  The latter
  integral is the quantity in \cref{def:calibration-error}, and the
  hypothesis \cref{def:calibrated} bounds it by $\tau$.  Substitution yields
  the stated inequality, expressed using \cref{def:correlation}. -/)
  (title := /-- Calibration controls threshold correlation -/)
  (latexEnv := "lemma")]
lemma calibration_controls_threshold_correlation
    {Ω X : Type*} [MeasurableSpace Ω] [MeasurableSpace X]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
    (y : Ω → ℝ) (x : Ω → X) (p : X → ℝ) (τ : ℝ)
    (hy : Measurable y) (hx : Measurable x) (hp : Measurable p)
    (hy_range : ∀ᵐ ω ∂μ, y ω = 0 ∨ y ω = 1)
    (hp_range : ∀ ξ, p ξ ∈ Set.Icc (0 : ℝ) 1)
    (hcal : calibrated μ τ y x p) :
    correlation μ y x (threshold_predictor p) ≥
      2 * (∫ ω, |p (x ω) - (1 / 2 : ℝ)| ∂μ) - 2 * τ := by
  let q : Ω → ℝ :=
    μ[y | MeasurableSpace.comap (fun ω => p (x ω)) (borel ℝ)]
  let s : Ω → ℝ := fun ω => threshold_predictor p (x ω)
  let A : Set Ω := {ω | 0 < 2 * p (x ω) - 1}
  let B : Set Ω := {ω | 2 * p (x ω) - 1 < 0}
  have hm :
      MeasurableSpace.comap (fun ω => p (x ω)) (borel ℝ) ≤
        ‹MeasurableSpace Ω› := by
    change MeasurableSpace.comap (fun ω => p (x ω)) Real.measurableSpace ≤ _
    exact (show Measurable (fun ω => p (x ω)) from hp.comp hx).comap_le
  have hy_int : Integrable y μ :=
    Integrable.of_bound hy.aestronglyMeasurable 1 (by
      filter_upwards [hy_range] with ω hω
      rcases hω with hω | hω <;> simp [hω])
  have hp_int : Integrable (fun ω => p (x ω)) μ :=
    Integrable.of_bound (hp.comp hx).aestronglyMeasurable 1 (by
      filter_upwards with ω
      rw [Real.norm_eq_abs, abs_of_nonneg (hp_range (x ω)).1]
      exact (hp_range (x ω)).2)
  have hsign : Measurable Real.sign :=
    (show Monotone Real.sign by
      intro a b hab
      simp only [Real.sign]
      split_ifs <;> norm_num at * <;> linarith).measurable
  have hs :
      StronglyMeasurable[
        MeasurableSpace.comap (fun ω => p (x ω)) (borel ℝ)] s := by
    dsimp [s, threshold_predictor]
    exact
      (hsign.comp
        ((measurable_const.mul (comap_measurable _)).sub measurable_const)).stronglyMeasurable
  have hs_bound : ∀ᵐ ω ∂μ, ‖s ω‖ ≤ (1 : ℝ) := by
    filter_upwards with ω
    dsimp [s, threshold_predictor]
    rw [Real.sign]
    split_ifs <;> norm_num
  have hs_ambient : StronglyMeasurable s := hs.mono hm
  have hs_int : Integrable s μ :=
    Integrable.of_bound hs_ambient.aestronglyMeasurable 1 hs_bound
  have hq_int : Integrable q μ := by
    dsimp [q]
    exact integrable_condExp
  have hd_int : Integrable (fun ω => q ω - p (x ω)) μ := hq_int.sub hp_int
  have habsd_int : Integrable (fun ω => |q ω - p (x ω)|) μ := hd_int.abs
  have ha_int : Integrable (fun ω => |p (x ω) - (1 / 2 : ℝ)|) μ :=
    (hp_int.sub (integrable_const (1 / 2 : ℝ))).abs
  have hsy_int : Integrable (fun ω => s ω * y ω) μ :=
    hy_int.bdd_mul hs_ambient.aestronglyMeasurable hs_bound
  have hsq_int : Integrable (fun ω => s ω * q ω) μ :=
    hq_int.bdd_mul hs_ambient.aestronglyMeasurable hs_bound
  have hsd_int : Integrable (fun ω => s ω * (q ω - p (x ω))) μ :=
    hd_int.bdd_mul hs_ambient.aestronglyMeasurable hs_bound
  have hfun :
      Measurable[
        MeasurableSpace.comap (fun ω => p (x ω)) (borel ℝ)]
          (fun ω => 2 * p (x ω) - 1) :=
    (measurable_const.mul (comap_measurable _)).sub measurable_const
  have hA :
      MeasurableSet[
        MeasurableSpace.comap (fun ω => p (x ω)) (borel ℝ)] A := by
    dsimp only [A]
    exact measurableSet_lt measurable_const hfun
  have hB :
      MeasurableSet[
        MeasurableSpace.comap (fun ω => p (x ω)) (borel ℝ)] B := by
    dsimp only [B]
    exact measurableSet_lt hfun measurable_const
  have hA_ambient : MeasurableSet A := hm A hA
  have hB_ambient : MeasurableSet B := hm B hB
  have hs_integral (f : Ω → ℝ) (hf : Integrable f μ) :
      (∫ ω, s ω * f ω ∂μ) =
        (∫ ω in A, f ω ∂μ) - ∫ ω in B, f ω ∂μ := by
    rw [← integral_indicator hA_ambient, ← integral_indicator hB_ambient]
    rw [← integral_sub (hf.indicator hA_ambient) (hf.indicator hB_ambient)]
    apply integral_congr_ae
    filter_upwards with ω
    dsimp [s, threshold_predictor]
    rw [Real.sign]
    split_ifs with hn hpos
    · have hωA : ω ∉ A := by
        simp only [A, Set.mem_setOf_eq]
        linarith
      have hωB : ω ∈ B := by
        simpa only [B, Set.mem_setOf_eq] using hn
      rw [Set.indicator_of_notMem hωA, Set.indicator_of_mem hωB]
      ring
    · have hωA : ω ∈ A := by
        simpa only [A, Set.mem_setOf_eq] using hpos
      have hωB : ω ∉ B := by
        simp only [B, Set.mem_setOf_eq]
        linarith
      rw [Set.indicator_of_mem hωA, Set.indicator_of_notMem hωB]
      ring
    · have hωA : ω ∉ A := by
        simpa only [A, Set.mem_setOf_eq] using hpos
      have hωB : ω ∉ B := by
        simpa only [B, Set.mem_setOf_eq] using hn
      rw [Set.indicator_of_notMem hωA, Set.indicator_of_notMem hωB]
      ring
  have hAcond :
      (∫ ω in A, q ω ∂μ) = ∫ ω in A, y ω ∂μ := by
    simpa only [q] using
      (setIntegral_condExp (μ := μ) hm hy_int hA)
  have hBcond :
      (∫ ω in B, q ω ∂μ) = ∫ ω in B, y ω ∂μ := by
    simpa only [q] using
      (setIntegral_condExp (μ := μ) hm hy_int hB)
  have hsy : (∫ ω, s ω * y ω ∂μ) = ∫ ω, s ω * q ω ∂μ := by
    rw [hs_integral y hy_int, hs_integral q hq_int, hAcond, hBcond]
  have hy_expand :
      (∫ ω, (2 * y ω - 1) * s ω ∂μ) =
        2 * (∫ ω, s ω * y ω ∂μ) - ∫ ω, s ω ∂μ := by
    calc
      (∫ ω, (2 * y ω - 1) * s ω ∂μ) =
          ∫ ω, 2 * (s ω * y ω) - s ω ∂μ := by
        apply integral_congr_ae
        filter_upwards with ω
        ring
      _ = 2 * (∫ ω, s ω * y ω ∂μ) - ∫ ω, s ω ∂μ := by
        rw [integral_sub (hsy_int.const_mul 2) hs_int, integral_const_mul]
  have hq_expand :
      (∫ ω, (2 * q ω - 1) * s ω ∂μ) =
        2 * (∫ ω, s ω * q ω ∂μ) - ∫ ω, s ω ∂μ := by
    calc
      (∫ ω, (2 * q ω - 1) * s ω ∂μ) =
          ∫ ω, 2 * (s ω * q ω) - s ω ∂μ := by
        apply integral_congr_ae
        filter_upwards with ω
        ring
      _ = 2 * (∫ ω, s ω * q ω ∂μ) - ∫ ω, s ω ∂μ := by
        rw [integral_sub (hsq_int.const_mul 2) hs_int, integral_const_mul]
  have hcorr_q :
      correlation μ y x (threshold_predictor p) =
        ∫ ω, (2 * q ω - 1) * s ω ∂μ := by
    change (∫ ω, (2 * y ω - 1) * s ω ∂μ) =
      ∫ ω, (2 * q ω - 1) * s ω ∂μ
    rw [hy_expand, hq_expand, hsy]
  have hid : ∀ a : ℝ,
      Real.sign (2 * a - 1) * (2 * a - 1) = 2 * |a - 1 / 2| := by
    intro a
    rw [show 2 * |a - 1 / 2| = |2 * a - 1| by
      rw [show 2 * a - 1 = 2 * (a - 1 / 2) by ring, abs_mul]
      norm_num]
    rw [Real.sign]
    split_ifs with hn hpos
    · rw [abs_of_neg hn]
      ring
    · rw [abs_of_pos hpos]
      ring
    · have hz : 2 * a - 1 = 0 :=
        le_antisymm (le_of_not_gt hpos) (le_of_not_gt hn)
      rw [hz]
      norm_num
  have hdecomp :
      (∫ ω, (2 * q ω - 1) * s ω ∂μ) =
        2 * (∫ ω, |p (x ω) - (1 / 2 : ℝ)| ∂μ) +
          2 * (∫ ω, s ω * (q ω - p (x ω)) ∂μ) := by
    calc
      (∫ ω, (2 * q ω - 1) * s ω ∂μ) =
          ∫ ω, 2 * |p (x ω) - (1 / 2 : ℝ)| +
            2 * (s ω * (q ω - p (x ω))) ∂μ := by
        apply integral_congr_ae
        filter_upwards with ω
        dsimp [s, threshold_predictor]
        calc
          (2 * q ω - 1) * Real.sign (2 * p (x ω) - 1) =
              Real.sign (2 * p (x ω) - 1) * (2 * p (x ω) - 1) +
                2 * (Real.sign (2 * p (x ω) - 1) *
                  (q ω - p (x ω))) := by ring
          _ = 2 * |p (x ω) - (1 / 2 : ℝ)| +
                2 * (Real.sign (2 * p (x ω) - 1) *
                  (q ω - p (x ω))) := by rw [hid]
      _ = 2 * (∫ ω, |p (x ω) - (1 / 2 : ℝ)| ∂μ) +
            2 * (∫ ω, s ω * (q ω - p (x ω)) ∂μ) := by
        rw [integral_add (ha_int.const_mul 2) (hsd_int.const_mul 2)]
        rw [integral_const_mul, integral_const_mul]
  have hres_lower :
      -(∫ ω, |q ω - p (x ω)| ∂μ) ≤
        ∫ ω, s ω * (q ω - p (x ω)) ∂μ := by
    rw [← integral_neg]
    apply integral_mono_ae habsd_int.neg hsd_int
    filter_upwards [hs_bound] with ω hsω
    rw [Real.norm_eq_abs] at hsω
    have habs :
        |s ω * (q ω - p (x ω))| ≤ |q ω - p (x ω)| := by
      rw [abs_mul]
      nlinarith [abs_nonneg (s ω), abs_nonneg (q ω - p (x ω))]
    exact (neg_le_neg habs).trans (neg_abs_le _)
  have hcal' : (∫ ω, |q ω - p (x ω)| ∂μ) ≤ τ := by
    simpa [calibrated, calibration_error, q] using hcal
  rw [hcorr_q, hdecomp]
  linarith

@[blueprint "lem:multiaccuracy-controls-predictor-deviation"
  (statement := /-- Let $(\Omega,\mathcal F,\mu)$ be a probability space
  and let $X$ be a measurable feature space.  Let $x:\Omega\to X$,
  $y:\Omega\to\mathbb R$, and $p:X\to\mathbb R$ be measurable, assume
  that $y\in[0,1]$ almost everywhere and that $p(\xi)\in[0,1]$ for every
  $\xi\in X$, and let $\tau\in\mathbb R$.  Let $\mathcal C$ be a class of
  measurable functions
  $c:X\to[-1,1]$.  If $p$ is $(\mathcal C,\tau)$-multiaccurate with
  respect to $(x,y)$, then, for every $c\in\mathcal C$,
  \[
    \int_{\Omega}\left|p(x(\omega))-\frac12\right|\,d\mu(\omega)
      \geq \frac{\operatorname{cor}_{\mu}(y,c\circ x)}2-\tau.
  \] -/)
  (proof := /-- Fix $c\in\mathcal C$.  All integrands below are integrable:
  the functions $y$, $p\circ x$, and $c\circ x$ are measurable and bounded,
  and $\mu$ is a probability measure.  By
  \cref{def:multiaccurate, def:residual-correlation},
  \[
    \int_{\Omega}c(x)(y-p(x))\,d\mu\leq\tau.
  \]
  Expanding \cref{def:correlation, def:residual-correlation}, applying the
  pointwise identity
  \[
    \frac{(2y-1)c(x)}2
      =c(x)(y-p(x))+c(x)\left(p(x)-\frac12\right),
  \]
  and using linearity of the integral give
  \[
    \frac{\operatorname{cor}_{\mu}(y,c\circ x)}2
      =\int_{\Omega}c(x)(y-p(x))\,d\mu
       +\int_{\Omega}c(x)\left(p(x)-\frac12\right)\,d\mu.
  \]
  Combining this identity with the preceding residual bound yields
  \[
    \int_{\Omega}c(x)\left(p(x)-\frac12\right)\,d\mu
      \geq\frac{\operatorname{cor}_{\mu}(y,c\circ x)}2-\tau.
  \]
  Since $|c(\xi)|\leq1$ for every $\xi\in X$, one has the pointwise inequality
  $c(x(\omega))(p(x(\omega))-1/2)\leq|p(x(\omega))-1/2|$ and monotonicity
  of the integral give the claimed estimate. -/)
  (title := /-- Multiaccuracy controls predictor deviation -/)
  (latexEnv := "lemma")]
lemma multiaccuracy_controls_predictor_deviation
    {Ω X : Type*} [MeasurableSpace Ω] [MeasurableSpace X]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
    (C : Set (X → ℝ)) (y : Ω → ℝ) (x : Ω → X) (p : X → ℝ) (τ : ℝ)
    (hy : Measurable y) (hx : Measurable x) (hp : Measurable p)
    (hy_range : ∀ᵐ ω ∂μ, y ω ∈ Set.Icc (0 : ℝ) 1)
    (hp_range : ∀ ξ, p ξ ∈ Set.Icc (0 : ℝ) 1)
    (hC : ∀ c ∈ C, Measurable c ∧ ∀ ξ, |c ξ| ≤ 1)
    (hma : multiaccurate μ C τ y x p) (c : X → ℝ) (hc : c ∈ C) :
    (∫ ω, |p (x ω) - (1 / 2 : ℝ)| ∂μ) ≥
      correlation μ y x c / 2 - τ := by
  have hy_int : Integrable y μ := by
    refine Integrable.of_bound hy.aestronglyMeasurable 1 ?_
    filter_upwards [hy_range] with ω hω
    rw [Real.norm_eq_abs]
    exact abs_le.2 ⟨by linarith [hω.1], hω.2⟩
  have hp_int : Integrable (fun ω => p (x ω)) μ := by
    refine Integrable.of_bound (hp.comp hx).aestronglyMeasurable 1 ?_
    filter_upwards with ω
    rw [Real.norm_eq_abs]
    exact abs_le.2 ⟨by linarith [(hp_range (x ω)).1], (hp_range (x ω)).2⟩
  have hconst_int : Integrable (fun _ : Ω => (1 / 2 : ℝ)) μ := by
    refine Integrable.of_bound measurable_const.aestronglyMeasurable (1 / 2) ?_
    filter_upwards with ω
    norm_num
  have hdev_int : Integrable (fun ω => p (x ω) - (1 / 2 : ℝ)) μ :=
    hp_int.sub hconst_int
  have habs_dev_int : Integrable (fun ω => |p (x ω) - (1 / 2 : ℝ)|) μ :=
    hdev_int.abs
  have hres_int : Integrable (fun ω => c (x ω) * (y ω - p (x ω))) μ :=
    (hy_int.sub hp_int).bdd_mul ((hC c hc).1.comp hx).aestronglyMeasurable
      (Filter.Eventually.of_forall fun ω => by
        simpa [Real.norm_eq_abs] using (hC c hc).2 (x ω))
  have hpred_int : Integrable (fun ω => c (x ω) * (p (x ω) - (1 / 2 : ℝ))) μ :=
    hdev_int.bdd_mul ((hC c hc).1.comp hx).aestronglyMeasurable
      (Filter.Eventually.of_forall fun ω => by
        simpa [Real.norm_eq_abs] using (hC c hc).2 (x ω))
  have hpred_le_abs :
      (∫ ω, c (x ω) * (p (x ω) - (1 / 2 : ℝ)) ∂μ) ≤
        ∫ ω, |p (x ω) - (1 / 2 : ℝ)| ∂μ := by
    refine integral_mono_ae hpred_int habs_dev_int ?_
    filter_upwards with ω
    have hc_bound := (hC c hc).2 (x ω)
    by_cases hd : 0 ≤ p (x ω) - (1 / 2 : ℝ)
    · rw [abs_of_nonneg hd]
      nlinarith [mul_nonneg (sub_nonneg.mpr (le_of_abs_le hc_bound)) hd]
    · rw [abs_of_nonpos (le_of_not_ge hd)]
      nlinarith [mul_nonneg (by linarith [neg_le_of_abs_le hc_bound] :
          0 ≤ c (x ω) + 1)
        (neg_nonneg.mpr (le_of_not_ge hd))]
  have hres_le : residual_correlation μ y x p c ≤ τ :=
    le_trans (le_abs_self _) (hma c hc)
  have hcor_identity :
      correlation μ y x c / 2 = residual_correlation μ y x p c +
        ∫ ω, c (x ω) * (p (x ω) - (1 / 2 : ℝ)) ∂μ := by
    rw [correlation, residual_correlation, ← integral_div]
    calc
      (∫ ω, ((2 * y ω - 1) * c (x ω)) / 2 ∂μ) =
          ∫ ω, c (x ω) * (y ω - p (x ω)) +
            c (x ω) * (p (x ω) - (1 / 2 : ℝ)) ∂μ := by
            refine integral_congr_ae ?_
            filter_upwards with ω
            ring
      _ = (∫ ω, c (x ω) * (y ω - p (x ω)) ∂μ) +
          ∫ ω, c (x ω) * (p (x ω) - (1 / 2 : ℝ)) ∂μ := by
            exact integral_add hres_int hpred_int
  linarith

@[blueprint "lem:pointwise-threshold-correlation-bound"
  (statement := /-- Let $(\Omega,\mathcal F,\mu)$ be a probability space,
  let $X$ be a measurable feature space, and let $\tau\in\mathbb R$.
  Let $x:\Omega\to X$, $y:\Omega\to\mathbb R$, and
  $p:X\to\mathbb R$ be measurable.  Assume that
  $y(\omega)\in\{0,1\}$ for $\mu$-almost every $\omega\in\Omega$ and that
  $p(\xi)\in[0,1]$ for every $\xi\in X$.  Let $\mathcal C$ be a class of
  functions $c:X\to\mathbb R$ such that every $c\in\mathcal C$ is
  measurable and satisfies $|c(\xi)|\leq1$ for every $\xi\in X$.
  If $p$ is both $(\mathcal C,\tau)$-multiaccurate and $\tau$-calibrated
  with respect to $(x,y)$, then every $c\in\mathcal C$ satisfies
  \[
    \operatorname{cor}_{\mu}(y,\widehat p\circ x)
      \geq\operatorname{cor}_{\mu}(y,c\circ x)-4\tau.
  \] -/)
  (proof := /-- Fix $c\in\mathcal C$.  Since $y$ is binary almost
  everywhere, one has $y(\omega)\in[0,1]$ for $\mu$-almost every
  $\omega\in\Omega$.  By
  \cref{lem:calibration-controls-threshold-correlation},
  \[
    \operatorname{cor}_{\mu}(y,\widehat p\circ x)
      \geq2\int_{\Omega}|p\circ x-1/2|\,d\mu-2\tau.
  \]
  By \cref{lem:multiaccuracy-controls-predictor-deviation},
  \[
    \int_{\Omega}|p\circ x-1/2|\,d\mu
      \geq\frac{\operatorname{cor}_{\mu}(y,c\circ x)}2-\tau.
  \]
  Multiplying the second inequality by $2$ and substituting it into the
  first gives
  $\operatorname{cor}_{\mu}(y,\widehat p\circ x)
    \geq\operatorname{cor}_{\mu}(y,c\circ x)-4\tau$. -/)
  (title := /-- Pointwise threshold-correlation bound -/)
  (latexEnv := "lemma")]
lemma pointwise_threshold_correlation_bound
    {Ω X : Type*} [MeasurableSpace Ω] [MeasurableSpace X]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
    (C : Set (X → ℝ)) (y : Ω → ℝ) (x : Ω → X) (p : X → ℝ) (τ : ℝ)
    (hy : Measurable y) (hx : Measurable x) (hp : Measurable p)
    (hy_range : ∀ᵐ ω ∂μ, y ω = 0 ∨ y ω = 1)
    (hp_range : ∀ ξ, p ξ ∈ Set.Icc (0 : ℝ) 1)
    (hC : ∀ c ∈ C, Measurable c ∧ ∀ ξ, |c ξ| ≤ 1)
    (hma : multiaccurate μ C τ y x p) (hcal : calibrated μ τ y x p)
    (c : X → ℝ) (hc : c ∈ C) :
    correlation μ y x (threshold_predictor p) ≥
      correlation μ y x c - 4 * τ := by
  have hy_range' : ∀ᵐ ω ∂μ, y ω ∈ Set.Icc (0 : ℝ) 1 := by
    filter_upwards [hy_range] with ω hω
    rcases hω with hω | hω
    · simp [hω]
    · simp [hω]
  have hcal_bound :=
    calibration_controls_threshold_correlation μ y x p τ hy hx hp hy_range
      hp_range hcal
  have hma_bound :=
    multiaccuracy_controls_predictor_deviation μ C y x p τ hy hx hp hy_range'
      hp_range hC hma c hc
  linarith

@[blueprint "lem:pointwise-to-best-correlation"
  (statement := /-- Let $(\Omega,\mathcal F,\mu)$ be a probability space
  and let $X$ be a measurable feature space.  Let $x:\Omega\to X$ and
  $y:\Omega\to\mathbb R$ be measurable, assume that
  $y(\omega)\in\{0,1\}$ for $\mu$-almost every $\omega\in\Omega$, let
  $p:X\to\mathbb R$, and let $\tau\in\mathbb R$.  Let $\mathcal C$ be a
  nonempty class of measurable
  functions $c:X\to[-1,1]$.  Suppose that
  \[
    \operatorname{cor}_{\mu}(y,\widehat p\circ x)
      \geq\operatorname{cor}_{\mu}(y,c\circ x)-4\tau
    \qquad\text{for every }c\in\mathcal C,
  \]
  then
  \[
    \operatorname{cor}_{\mu}(y,\widehat p\circ x)
      \geq\operatorname{BestCor}_{\mu}(y,x,\mathcal C)-4\tau.
  \] -/)
  (proof := /-- Let
  $S=\{\operatorname{cor}_{\mu}(y,c\circ x):c\in\mathcal C\}$.
  This set is nonempty because $\mathcal C$ is nonempty.  If $s\in S$,
  choose $c\in\mathcal C$ such that
  $s=\operatorname{cor}_{\mu}(y,c\circ x)$.  The pointwise hypothesis gives
  \[
    s\leq
    \operatorname{cor}_{\mu}(y,\widehat p\circ x)+4\tau
    .
  \]
  Hence this right-hand side is an upper bound for $S$, so the
  least-upper-bound property gives the same bound for $\sup S$.
  Substituting the definition in
  \cref{def:best-correlation} and rearranging proves the asserted
  inequality. -/)
  (title := /-- Passage from pointwise bounds to the best correlation -/)
  (latexEnv := "lemma")]
lemma pointwise_to_best_correlation
    {Ω X : Type*} [MeasurableSpace Ω] [MeasurableSpace X]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
    (C : Set (X → ℝ))
    (y : Ω → ℝ) (x : Ω → X) (p : X → ℝ) (τ : ℝ)
    (hy : Measurable y) (hx : Measurable x)
    (hy_range : ∀ᵐ ω ∂μ, y ω = 0 ∨ y ω = 1)
    (hC : ∀ c ∈ C, Measurable c ∧ ∀ ξ, |c ξ| ≤ 1)
    (hC_nonempty : C.Nonempty)
    (hpointwise : ∀ c ∈ C,
      correlation μ y x (threshold_predictor p) ≥
        correlation μ y x c - 4 * τ) :
    correlation μ y x (threshold_predictor p) ≥
      best_correlation μ y x C - 4 * τ := by
  unfold best_correlation
  apply sub_le_iff_le_add.mpr
  apply csSup_le (hC_nonempty.image _)
  rintro _ ⟨c, hc, rfl⟩
  linarith [hpointwise c hc]

@[blueprint "thm:calma-to-sal"
  (statement := /-- Let $(\Omega,\mathcal F,\mu)$ be a probability space
  and let $X$ be a measurable feature space.  Let $x:\Omega\to X$ and
  $y:\Omega\to\mathbb R$ be measurable, and suppose that
  $y(\omega)\in\{0,1\}$ for $\mu$-almost every $\omega\in\Omega$.  Let
  $\tau>0$, and let $p:X\to\mathbb R$ be measurable with
  $0\leq p(\xi)\leq1$ for every $\xi\in X$.  Let $\mathcal C$ be a class
  of measurable functions $c:X\to\mathbb R$ such that
  $|c(\xi)|\leq1$ for every $c\in\mathcal C$ and every $\xi\in X$.  If $p$ is
  $(\mathcal C,\tau)$-multiaccurate and $\tau$-calibrated with
  respect to the joint random variables $(x,y)$, then
  \[
    \operatorname{cor}_{\mu}
      \bigl(y,\operatorname{sign}(2p-1)\circ x\bigr)
      \geq \operatorname{BestCor}_{\mu}(y,x,\mathcal C)-4\tau.
  \] -/)
  (proof := /-- First suppose that $\mathcal C$ is nonempty.  For every
  $c\in\mathcal C$, \cref{lem:pointwise-threshold-correlation-bound} gives
  \[
    \operatorname{cor}_{\mu}
      \bigl(y,\operatorname{sign}(2p-1)\circ x\bigr)
      \geq\operatorname{cor}_{\mu}(y,c\circ x)-4\tau.
  \]
  The hypotheses on the probability space, the label, and the class allow
  \cref{lem:pointwise-to-best-correlation} to pass from these simultaneous
  pointwise bounds to the supremum defining the best-class correlation.

  It remains to consider $\mathcal C=\varnothing$.  In this case
  \cref{def:best-correlation} is the supremum of the empty subset of
  $\mathbb R$, hence is $0$.  By
  \cref{lem:calibration-controls-threshold-correlation},
  \[
    \operatorname{cor}_{\mu}
      \bigl(y,\operatorname{sign}(2p-1)\circ x\bigr)
      \geq 2\int_{\Omega}|p\circ x-1/2|\,d\mu-2\tau
      \geq-2\tau.
  \]
  Since $\tau>0$, this is at least $-4\tau$, which is precisely the desired
  inequality when the best-class correlation is $0$. -/)
  (title := /-- Global calibration strengthens multiaccuracy -/)
  (latexEnv := "theorem")]
theorem calma_to_sal
    {Ω X : Type*} [MeasurableSpace Ω] [MeasurableSpace X]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
    (C : Set (X → ℝ)) (y : Ω → ℝ) (x : Ω → X) (p : X → ℝ)
    (τ : ℝ) (hτ : 0 < τ)
    (hy : Measurable y) (hx : Measurable x) (hp : Measurable p)
    (hy_range : ∀ᵐ ω ∂μ, y ω = 0 ∨ y ω = 1)
    (hp_range : ∀ ξ, p ξ ∈ Set.Icc (0 : ℝ) 1)
    (hC : ∀ c ∈ C, Measurable c ∧ ∀ ξ, |c ξ| ≤ 1)
    (hma : multiaccurate μ C τ y x p) (hcal : calibrated μ τ y x p) :
    correlation μ y x (threshold_predictor p) ≥
      best_correlation μ y x C - 4 * τ := by
  rcases C.eq_empty_or_nonempty with rfl | hC_nonempty
  · have hbound :=
      calibration_controls_threshold_correlation μ y x p τ hy hx hp hy_range hp_range hcal
    have hnonneg : 0 ≤ ∫ ω, |p (x ω) - (1 / 2 : ℝ)| ∂μ := by
      positivity
    simp [best_correlation]
    linarith
  · exact
      pointwise_to_best_correlation μ C y x p τ hy hx hy_range hC hC_nonempty
        (fun c hc =>
          pointwise_threshold_correlation_bound μ C y x p τ hy hx hp hy_range hp_range hC
            hma hcal c hc)
