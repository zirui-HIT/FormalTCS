  [
    P_t(\omega,\cdot)\leq C_{\mathrm{cov}}\mu_0
    \qquad\text{for every }t<T\text{ and }\omega\in\Omega.
  ]
  Let (\sigma>0), and assume that every exponential transform of each
  (Y_t) is integrable and that
  [
    \mathbb E_\mu[\exp(\alpha Y_t)\mid\mathcal F_t]
      \leq \exp(\alpha^2\sigma^2/2)
      \quad\mu\text{-almost surely}
  ]
  for every (t<T) and (\alpha\in\mathbb R).

  For every function (V_T^\dagger) which is pointwise a
  Moore--Penrose inverse of
  (V_T=\sum_{t<T}X_tX_t^{\mathsf T}) and every
  (\delta\in(0,1)), one has
  [
    \mu\!\left\{\omega:
      \lVert S_T(\omega)\rVert_{V_T^\dagger(\omega)}^2
      \leq C\sigma^2\left(
        \sqrt{dC_{\mathrm{cov}}T\log(2T/\delta)}
        +\log(2/\delta)\right)\right\}
      \geq 1-\delta,
  ]
  where (S_T=\sum_{t<T}X_tY_t). -/)
  (proof := /-- The assertion is exactly the conclusion of
  \cref{lem:self-normalized-smoothness-source-gap}, which therefore
  proves the theorem. -/)
  (title := /-- Self-normalized martingales under smoothness -/)
  (latexEnv := "theorem")]
theorem self_normalized_martingales_under_smoothness :
    self_normalized_smoothness_claim := by
  exact self_normalized_smoothness_source_gap
