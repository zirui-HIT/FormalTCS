      have hlevproposal (i : Fin s.card) :
          r j ≤ self_normalized_energy (Z (ψ i) z) (W i.succ) := by
        have hi := s.orderEmbOfFin_mem rfl i
        rw [Finset.mem_filter] at hi
        have hthreshold : r j ≤ qfun (φs i) := by
