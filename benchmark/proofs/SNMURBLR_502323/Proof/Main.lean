    exact (@MeasureTheory.Measure.compProd_apply_univ Ω
      (Fin T → Fin K → Fin d → ℝ) mΩ inferInstance μ κambient
      inferInstance hκambient).trans MeasureTheory.measure_univ
  letI : MeasureTheory.IsProbabilityMeasure γ := hγprob
  refine ⟨γ, ?_, ?_, ?_, ?_, ?_⟩
  · exact hγprob
  · simpa [γ, MeasureTheory.Measure.fst] using
      (@MeasureTheory.Measure.fst_compProd Ω
        (Fin T → Fin K → Fin d → ℝ) mΩ inferInstance μ inferInstance
        κambient hκambient)
  · apply (ProbabilityTheory.iIndepFun_iff_map_fun_eq_pi_map
        (fun (ij : Fin T × Fin K) => (show Measurable
          (fun z : Ω × (Fin T → Fin K → Fin d → ℝ) => z.2 ij.1 ij.2) by
            fun_prop).aemeasurable)).2
    calc
      MeasureTheory.Measure.map
          (fun z : Ω × (Fin T → Fin K → Fin d → ℝ) =>
            fun ij : Fin T × Fin K => z.2 ij.1 ij.2) γ =
          MeasureTheory.Measure.map
            (fun b : Fin T → Fin K → Fin d → ℝ =>
              fun ij : Fin T × Fin K => b ij.1 ij.2)
            (MeasureTheory.Measure.map Prod.snd γ) := by
              rw [MeasureTheory.Measure.map_map]
              · rfl
              · fun_prop
              · fun_prop
      _ = MeasureTheory.Measure.map
            (fun b : Fin T → Fin K → Fin d → ℝ =>
              fun ij : Fin T × Fin K => b ij.1 ij.2)
            (MeasureTheory.Measure.pi (fun _ : Fin T => ν0)) := by
              rw [hsnd]
      _ = MeasureTheory.Measure.pi (fun ij : Fin T × Fin K =>
            MeasureTheory.Measure.map
              (fun b : Fin T → Fin K → Fin d → ℝ => b ij.1 ij.2)
              (MeasureTheory.Measure.pi (fun _ : Fin T => ν0))) :=
          hindnested.map_fun_eq_pi_map (fun ij =>
            ((measurable_pi_apply ij.2).comp
              (measurable_pi_apply ij.1)).aemeasurable)
      _ = MeasureTheory.Measure.pi (fun ij : Fin T × Fin K =>
            MeasureTheory.Measure.map
              (fun z : Ω × (Fin T → Fin K → Fin d → ℝ) =>
                z.2 ij.1 ij.2) γ) := by
          congr 1
          funext ij
          rw [← hsnd, MeasureTheory.Measure.map_map]
          · rfl
          · fun_prop
          · fun_prop
  · intro ij
    calc
      MeasureTheory.Measure.map
          (fun z : Ω × (Fin T → Fin K → Fin d → ℝ) =>
            z.2 ij.1 ij.2) γ =
          MeasureTheory.Measure.map
            (fun b : Fin T → Fin K → Fin d → ℝ => b ij.1 ij.2)
            (MeasureTheory.Measure.map Prod.snd γ) := by
              rw [MeasureTheory.Measure.map_map]
              · rfl
              · fun_prop
              · fun_prop
      _ = MeasureTheory.Measure.map
            (fun b : Fin T → Fin K → Fin d → ℝ => b ij.1 ij.2)
            (MeasureTheory.Measure.pi (fun _ : Fin T => ν0)) := by rw [hsnd]
      _ = MeasureTheory.Measure.map (fun b : Fin K → Fin d → ℝ => b ij.2) ν0 := by
          change MeasureTheory.Measure.map
            ((fun b : Fin K → Fin d → ℝ => b ij.2) ∘
              (fun b : Fin T → Fin K → Fin d → ℝ => b ij.1))
              (MeasureTheory.Measure.pi (fun _ : Fin T => ν0)) = _
          rw [← MeasureTheory.Measure.map_map]
          · rw [(MeasureTheory.measurePreserving_eval
                (μ := fun _ : Fin T => ν0) ij.1).map_eq]
          · fun_prop
          · fun_prop
      _ = μ0 := by
          simpa [ν0] using
            (MeasureTheory.measurePreserving_eval
              (μ := fun _ : Fin K => μ0) ij.2).map_eq
  · intro t
    let Eab : Set ((Fin d → ℝ) × (Fin K → Fin d → ℝ)) :=
      {z | ∃ j : Fin K, z.1 = z.2 j}
    have hEab : MeasurableSet Eab := by
      simp only [Eab, Set.setOf_exists]
      change MeasurableSet (⋃ j : Fin K,
        {z : (Fin d → ℝ) × (Fin K → Fin d → ℝ) | z.1 = z.2 j})
      apply MeasurableSet.iUnion
      intro j
      exact measurableSet_eq_fun measurable_fst
        ((measurable_pi_apply j).comp measurable_snd)
    let Efull : Set (Ω × (Fin T → Fin K → Fin d → ℝ)) :=
      {z | ∃ j : Fin K, X t z.1 = z.2 t j}
    have hEfull : MeasurableSet Efull := by
      simp only [Efull, Set.setOf_exists]
      change MeasurableSet (⋃ j : Fin K,
        {z : Ω × (Fin T → Fin K → Fin d → ℝ) |
          X t z.1 = z.2 t j})
      apply MeasurableSet.iUnion
      intro j
      exact measurableSet_eq_fun ((hX_meas t).comp measurable_fst)
        (by fun_prop)
    have hRtF : @ProbabilityTheory.IsFiniteKernel
        (Ω × (Fin d → ℝ)) (Fin K → Fin d → ℝ)
        ((ℋx t.val).prod inferInstance) inferInstance (R t) := by
      constructor
      exact ⟨1, ENNReal.one_lt_top, fun z => by
        rw [((hR t).isProbabilityMeasure z).measure_univ]⟩
    have hRtSF : @ProbabilityTheory.IsSFiniteKernel
        (Ω × (Fin d → ℝ)) (Fin K → Fin d → ℝ)
        ((ℋx t.val).prod inferInstance) inferInstance (R t) :=
      @ProbabilityTheory.Kernel.IsFiniteKernel.isSFiniteKernel
        (Ω × (Fin d → ℝ)) (Fin K → Fin d → ℝ)
        ((ℋx t.val).prod inferInstance) inferInstance (R t) hRtF
    have hPtM : @ProbabilityTheory.IsMarkovKernel Ω (Fin d → ℝ)
        (ℋx t.val) inferInstance (P t) := ⟨hP.1 t⟩
    have hPtF : @ProbabilityTheory.IsFiniteKernel Ω (Fin d → ℝ)
        (ℋx t.val) inferInstance (P t) := by
      constructor
      exact ⟨1, ENNReal.one_lt_top, fun ω => by
        rw [(hPtM.isProbabilityMeasure ω).measure_univ]⟩
    have hPtSF : @ProbabilityTheory.IsSFiniteKernel Ω (Fin d → ℝ)
        (ℋx t.val) inferInstance (P t) :=
      @ProbabilityTheory.Kernel.IsFiniteKernel.isSFiniteKernel Ω
        (Fin d → ℝ) (ℋx t.val) inferInstance (P t) hPtF
    letI : @ProbabilityTheory.IsSFiniteKernel
        (Ω × (Fin d → ℝ)) (Fin K → Fin d → ℝ)
        ((ℋx t.val).prod inferInstance) inferInstance (R t) := hRtSF
    letI : @ProbabilityTheory.IsSFiniteKernel Ω (Fin d → ℝ)
        (ℋx t.val) inferInstance (P t) := hPtSF
    let Etriple : Set (((Ω × (Fin d → ℝ)) × (Fin K → Fin d → ℝ))) :=
      {z | (z.1.2, z.2) ∈ Eab}
    have hEtriple : @MeasurableSet
        (((Ω × (Fin d → ℝ)) × (Fin K → Fin d → ℝ)))
        (((ℋx t.val).prod inferInstance).prod inferInstance) Etriple := by
      exact (measurable_fst.snd.prodMk measurable_snd) hEab
    let F : (Ω × (Fin d → ℝ)) → ENNReal := fun z =>
      R t z (Prod.mk z ⁻¹' Etriple)
    have hF : @Measurable (Ω × (Fin d → ℝ)) ENNReal
        ((ℋx t.val).prod inferInstance) inferInstance F := by
      exact @ProbabilityTheory.Kernel.measurable_kernel_prodMk_left
        (Ω × (Fin d → ℝ)) (Fin K → Fin d → ℝ)
        ((ℋx t.val).prod inferInstance) inferInstance (R t) hRtSF
          Etriple hEtriple
    have hpair_meas : @Measurable Ω (Ω × (Fin d → ℝ)) mΩ
        ((ℋx t.val).prod inferInstance) (fun ω => (ω, X t ω)) := by
      exact @Measurable.prodMk Ω mΩ Ω (Fin d → ℝ) (ℋx t.val)
        inferInstance id (X t) (measurable_id'' (ℋx.le t.val)) (hX_meas t)
    have hsection (ω : Ω) : κambient ω (Prod.mk ω ⁻¹' Efull) =
        F (ω, X t ω) := by
      let V : Set (Fin K → Fin d → ℝ) := Prod.mk (X t ω) ⁻¹' Eab
      have hV : MeasurableSet V := measurable_prodMk_left hEab
      have hb := congrArg
        (fun k : ProbabilityTheory.Kernel Ω (Fin K → Fin d → ℝ) => k ω V)
        (hblock T t)
      rw [ProbabilityTheory.Kernel.map_apply' (κα T)
        (measurable_pi_apply t) ω hV] at hb
      change κambient ω ((fun b => b t) ⁻¹' V) = F (ω, X t ω)
      rw [hb]
      change S' t.val ω V = _
      rw [show S' t.val = ProbabilityTheory.Kernel.comp (R t)
          (ProbabilityTheory.Kernel.deterministic
            (fun ω => (ω, X t ω)) (hpair_step t.val t.isLt)) by
        simp [S', t.isLt]]
      rw [ProbabilityTheory.Kernel.comp_apply,
        ProbabilityTheory.Kernel.deterministic_apply,
        MeasureTheory.Measure.dirac_bind (R t).measurable]
      rfl
    have hvalue : γ Efull = ∫⁻ ω, F (ω, X t ω) ∂μ := by
      change (MeasureTheory.Measure.compProd μ κambient) Efull = _
      rw [@MeasureTheory.Measure.compProd_apply Ω
        (Fin T → Fin K → Fin d → ℝ) mΩ inferInstance μ κambient
          inferInstance hκambient_sfinite Efull hEfull]
      apply MeasureTheory.lintegral_congr
      exact hsection
    have hdisE (ω : Ω) :
        (∫⁻ a, R t (ω, a) (Prod.mk a ⁻¹' Eab) ∂P t ω) = Q t ω Eab := by
      have hd := congrArg
        (fun k : @ProbabilityTheory.Kernel Ω
          ((Fin d → ℝ) × (Fin K → Fin d → ℝ))
          (ℋx t.val) inferInstance => k ω Eab) (hdis t)
      rw [hQfst t] at hd
      rw [ProbabilityTheory.Kernel.compProd_apply hEab (P t) (R t) ω] at hd
      exact hd
    have hcalc : γ Efull = ∫⁻ ω, Q t ω Eab ∂μ := by
      rw [hvalue]
      calc
        (∫⁻ ω, F (ω, X t ω) ∂μ) =
            ∫⁻ z, F z ∂(@MeasureTheory.Measure.map Ω
              (Ω × (Fin d → ℝ)) mΩ ((ℋx t.val).prod inferInstance)
                (fun ω => (ω, X t ω)) μ) :=
          (@MeasureTheory.lintegral_map Ω (Ω × (Fin d → ℝ))
            mΩ ((ℋx t.val).prod inferInstance) μ F
              (fun ω => (ω, X t ω)) hF hpair_meas).symm
        _ = ∫⁻ z, F z ∂(@MeasureTheory.Measure.compProd Ω
              (Fin d → ℝ) (ℋx t.val) inferInstance
                (μ.trim (ℋx.le t.val)) (P t)) := by rw [hjoint t]
        _ = ∫⁻ ω, ∫⁻ a, F (ω, a) ∂P t ω ∂μ.trim (ℋx.le t.val) := by
          exact @MeasureTheory.Measure.lintegral_compProd Ω (Fin d → ℝ)
            (ℋx t.val) inferInstance (μ.trim (ℋx.le t.val)) (P t)
              inferInstance hPtSF F hF
        _ = ∫⁻ ω, Q t ω Eab ∂μ.trim (ℋx.le t.val) := by
          apply MeasureTheory.lintegral_congr
          intro ω
          exact hdisE ω
        _ = ∫⁻ ω, Q t ω Eab ∂μ := by
          rw [MeasureTheory.lintegral_trim (ℋx.le t.val)]
          exact (Q t).measurable_coe hEab
    rw [hcalc]
    calc
      ENNReal.ofReal (1 - q) = ∫⁻ _ : Ω, ENNReal.ofReal (1 - q) ∂μ := by simp
      _ ≤ ∫⁻ ω, Q t ω Eab ∂μ := MeasureTheory.lintegral_mono fun ω => (hQ t ω).2.2.2.2

@[blueprint "lem:block-matches-give-subsequence"
  (statement := /-- Let (T) and (K) be positive natural numbers, let
  (d\in\mathbb N), let ((\Omega,\mathcal F,\mu)) be a probability
  space, and let (\mu_0) be a probability measure on (\mathbb R^d).
  Fix maps (X_t:\Omega\to\mathbb R^d) for (t<T) and a number
  (q\in[0,1]).  Let (\gamma) be a probability measure on
  (\Omega\times\prod_{t<T}(\mathbb R^d)^K) whose (\Omega)-marginal is
  (\mu), whose (TK) proposal coordinates are jointly independent, and
  whose every proposal-coordinate marginal is (\mu_0).  Suppose that,
  for every (t<T), the event that (X_t) equals some proposal in the
  (t)-th block is measurable and has (\gamma)-probability at least
  (1-q).

  Then there exists a probability measure (\gamma_{\mathrm{flat}}) on
  (\Omega\times(\mathbb R^d)^{TK}) whose (\Omega)-marginal is (\mu),
  whose (TK) proposal coordinates are jointly independent with marginal
  law (\mu_0), and under which ((X_t)_{t<T}) is an order-preserving
  subsequence of the proposal array with probability at least (1-Tq). -/)
  (proof := /-- For each (t<T), let (A_t) be the measurable event that
  the (t)-th proposal block contains (X_t).  Since (\gamma) is a
  probability measure and
  (\gamma(A_t)\geq 1-q), one has
  (\gamma(A_t^{\mathsf c})\leq q).  Applying countable subadditivity
  to the finite family of complements yields
  [
    \gamma\Bigl(\bigcap_{t<T}A_t\Bigr)
      \geq 1-Tq.
  ]
  This identity remains valid when (1-Tq<0), because the right-hand side
  of the formal inequality is its nonnegative extended-real truncation.

  Reindex a block coordinate ((t,j)\in\operatorname{Fin}(T)\times
  \operatorname{Fin}(K)) by the standard equivalence with
  (\operatorname{Fin}(TK)), and push (\gamma) forward by the resulting
  measurable flattening map.  The first projection commutes with this
  map, so the (\Omega)-marginal remains (\mu).  The finite-intersection
  characterization of joint independence, applied after the bijective
  reindexing, shows that the flattened proposal coordinates remain jointly
  independent.  Functoriality of pushforward measures likewise preserves
  each marginal law (\mu_0).

  On (\bigcap_{t<T}A_t), choose for each (t) an index (j_t<K) satisfying
  (X_t=z_{t,j_t}) and put (\phi(t)=tK+j_t).  If (t<t'), then
  [
    j_t+tK<K+tK=K(t+1)\leq Kt'\leq j_{t'}+Kt',
  ]
  so (\phi) is strictly increasing.  The inverse reindexing map makes
  the flattened image of the simultaneous-match event measurable, and
  this image is contained in the asserted subsequence event.  Monotonicity
  of the pushed-forward measure therefore gives the claimed lower bound. -/)
  (title := /-- Blockwise matches yield an ordered subsequence -/)
  (latexEnv := "lemma")]
lemma block_matches_give_subsequence :
    ∀ (T d K : ℕ) (Ω : Type*) [mΩ : MeasurableSpace Ω]
      (μ : MeasureTheory.Measure Ω)
      [MeasureTheory.IsProbabilityMeasure μ]
      (X : Fin T → Ω → Fin d → ℝ)
      (μ0 : MeasureTheory.Measure (Fin d → ℝ))
      [MeasureTheory.IsProbabilityMeasure μ0]
      (q : ℝ)
      (γ : MeasureTheory.Measure
        (Ω × (Fin T → Fin K → Fin d → ℝ))),
      0 < T → 0 < K → 0 ≤ q → q ≤ 1 →
      MeasureTheory.IsProbabilityMeasure γ →
      MeasureTheory.Measure.map
        (fun z : Ω × (Fin T → Fin K → Fin d → ℝ) => z.1) γ = μ →
      ProbabilityTheory.iIndepFun
        (fun ij : Fin T × Fin K =>
          fun z : Ω × (Fin T → Fin K → Fin d → ℝ) =>
            z.2 ij.1 ij.2) γ →
      (∀ ij : Fin T × Fin K,
        MeasureTheory.Measure.map
          (fun z : Ω × (Fin T → Fin K → Fin d → ℝ) =>
            z.2 ij.1 ij.2) γ = μ0) →
      (∀ t : Fin T,
        MeasurableSet
          {z : Ω × (Fin T → Fin K → Fin d → ℝ) |
            ∃ j : Fin K, X t z.1 = z.2 t j}) →
      (∀ t : Fin T,
        γ {z | ∃ j : Fin K, X t z.1 = z.2 t j} ≥
          ENNReal.ofReal (1 - q)) →
      ∃ γflat : MeasureTheory.Measure
          (Ω × (Fin (T * K) → Fin d → ℝ)),
        MeasureTheory.IsProbabilityMeasure γflat ∧
        MeasureTheory.Measure.map
          (fun z : Ω × (Fin (T * K) → Fin d → ℝ) => z.1) γflat = μ ∧
        ProbabilityTheory.iIndepFun
          (fun i : Fin (T * K) =>
            fun z : Ω × (Fin (T * K) → Fin d → ℝ) => z.2 i) γflat ∧
        (∀ i : Fin (T * K),
          MeasureTheory.Measure.map
            (fun z : Ω × (Fin (T * K) → Fin d → ℝ) => z.2 i) γflat = μ0) ∧
        γflat {z | ∃ φ : Fin T → Fin (T * K), StrictMono φ ∧
          ∀ t, X t z.1 = z.2 (φ t)} ≥
            ENNReal.ofReal (1 - (T : ℝ) * q) := by
  classical
  intro T d K Ω mΩ μ hμ X μ0 hμ0 q γ hT hK hq0 hq1 hγ hΩ hind hmarg
    hmeas hprob
  letI : MeasureTheory.IsProbabilityMeasure γ := hγ
  let A : Fin T → Set (Ω × (Fin T → Fin K → Fin d → ℝ)) :=
    fun t => {z | ∃ j : Fin K, X t z.1 = z.2 t j}
  have hAmeas (t : Fin T) : MeasurableSet (A t) := by
    simpa [A] using hmeas t
  have hfail (t : Fin T) : γ (A t)ᶜ ≤ ENNReal.ofReal q := by
    rw [MeasureTheory.prob_compl_eq_one_sub (hAmeas t)]
    calc
      1 - γ (A t) ≤ 1 - ENNReal.ofReal (1 - q) :=
        tsub_le_tsub_left (hprob t) 1
      _ = ENNReal.ofReal q := by
        rw [ENNReal.ofReal_sub 1 hq0, ENNReal.ofReal_one]
        exact ENNReal.sub_sub_cancel ENNReal.one_ne_top
          (ENNReal.ofReal_le_one.mpr hq1)
  let good : Set (Ω × (Fin T → Fin K → Fin d → ℝ)) := ⋂ t, A t
  have hgoodmeas : MeasurableSet good := by
    exact MeasurableSet.iInter hAmeas
  have hbad : γ goodᶜ ≤ (T : ENNReal) * ENNReal.ofReal q := by
    calc
      γ goodᶜ = γ (⋃ t, (A t)ᶜ) := by simp [good]
      _ ≤ ∑' t : Fin T, γ (A t)ᶜ := MeasureTheory.measure_iUnion_le _
      _ ≤ ∑' _t : Fin T, ENNReal.ofReal q := ENNReal.tsum_le_tsum hfail
      _ = (T : ENNReal) * ENNReal.ofReal q := by simp
  have hgoodprob : γ good ≥ ENNReal.ofReal (1 - (T : ℝ) * q) := by
    calc
      ENNReal.ofReal (1 - (T : ℝ) * q) =
          1 - (T : ENNReal) * ENNReal.ofReal q := by
            rw [ENNReal.ofReal_sub 1 (mul_nonneg (Nat.cast_nonneg T) hq0),
              ENNReal.ofReal_one, ENNReal.ofReal_mul (Nat.cast_nonneg T),
              ENNReal.ofReal_natCast]
      _ ≤ 1 - γ goodᶜ := tsub_le_tsub_left hbad 1
      _ = γ good := by
        have hc := MeasureTheory.prob_compl_eq_one_sub (μ := γ) hgoodmeas.compl
        simpa only [compl_compl] using hc.symm
  let flat : (Ω × (Fin T → Fin K → Fin d → ℝ)) →
      (Ω × (Fin (T * K) → Fin d → ℝ)) :=
    fun z => (z.1, fun i =>
      z.2 (finProdFinEquiv.symm i).1 (finProdFinEquiv.symm i).2)
  have hflat : Measurable flat := by fun_prop
  let unflat : (Ω × (Fin (T * K) → Fin d → ℝ)) →
      (Ω × (Fin T → Fin K → Fin d → ℝ)) :=
    fun z => (z.1, fun t j => z.2 (finProdFinEquiv (t, j)))
  have hunflat : Measurable unflat := by fun_prop
  have hround (z : Ω × (Fin T → Fin K → Fin d → ℝ)) :
      unflat (flat z) = z := by
    apply Prod.ext
    · rfl
    · funext t j
      change z.2 (finProdFinEquiv.symm (finProdFinEquiv (t, j))).1
          (finProdFinEquiv.symm (finProdFinEquiv (t, j))).2 = z.2 t j
      rw [Equiv.symm_apply_apply]
  let goodFlat : Set (Ω × (Fin (T * K) → Fin d → ℝ)) := unflat ⁻¹' good
  have hgoodFlatMeas : MeasurableSet goodFlat := hgoodmeas.preimage hunflat
  have hpreimage : flat ⁻¹' goodFlat = good := by
    ext z
    change unflat (flat z) ∈ good ↔ z ∈ good
    rw [hround z]
  have hsubset : goodFlat ⊆
      {z | ∃ φ : Fin T → Fin (T * K), StrictMono φ ∧
        ∀ t, X t z.1 = z.2 (φ t)} := by
    intro z hz
    have hz' : ∀ t : Fin T, ∃ j : Fin K,
        X t z.1 = z.2 (finProdFinEquiv (t, j)) := by
      simpa [goodFlat, good, A, unflat] using hz
    choose j hj using hz'
    refine ⟨fun t => finProdFinEquiv (t, j t), ?_, hj⟩
    intro a b hab
    apply Fin.mk_lt_mk.2
    simp only [finProdFinEquiv_apply_val]
    calc
      (j a).val + K * a.val < K + K * a.val :=
        Nat.add_lt_add_right (j a).isLt _
      _ = K * (a.val + 1) := by ring
      _ ≤ K * b.val := Nat.mul_le_mul_left K (Nat.succ_le_iff.mpr hab)
      _ ≤ (j b).val + K * b.val := Nat.le_add_left _ _
  let γflat := MeasureTheory.Measure.map flat γ
  have hγflat : MeasureTheory.IsProbabilityMeasure γflat :=
    MeasureTheory.Measure.isProbabilityMeasure_map hflat.aemeasurable
  have hsource : ProbabilityTheory.iIndepFun
      (fun i : Fin (T * K) => fun z : Ω × (Fin T → Fin K → Fin d → ℝ) =>
        z.2 (finProdFinEquiv.symm i).1 (finProdFinEquiv.symm i).2) γ :=
    hind.precomp finProdFinEquiv.symm.injective
  rw [ProbabilityTheory.iIndepFun_iff_measure_inter_preimage_eq_mul] at hsource
  have hIndflat : ProbabilityTheory.iIndepFun
      (fun i : Fin (T * K) =>
        fun z : Ω × (Fin (T * K) → Fin d → ℝ) => z.2 i) γflat := by
    rw [ProbabilityTheory.iIndepFun_iff_measure_inter_preimage_eq_mul]
    intro S sets hsets
    calc
      γflat (⋂ i ∈ S,
          (fun z : Ω × (Fin (T * K) → Fin d → ℝ) => z.2 i) ⁻¹' sets i) =
          γ (flat ⁻¹' (⋂ i ∈ S,
            (fun z : Ω × (Fin (T * K) → Fin d → ℝ) => z.2 i) ⁻¹'
              sets i)) := by
            apply MeasureTheory.Measure.map_apply hflat
            measurability
      _ = γ (⋂ i ∈ S,
          (fun z : Ω × (Fin T → Fin K → Fin d → ℝ) =>
            z.2 (finProdFinEquiv.symm i).1
              (finProdFinEquiv.symm i).2) ⁻¹' sets i) := by
            congr 1
            ext z
            simp [flat]
      _ = ∏ i ∈ S, γ
          ((fun z : Ω × (Fin T → Fin K → Fin d → ℝ) =>
            z.2 (finProdFinEquiv.symm i).1
              (finProdFinEquiv.symm i).2) ⁻¹' sets i) :=
            hsource S hsets
      _ = ∏ i ∈ S, γflat
          ((fun z : Ω × (Fin (T * K) → Fin d → ℝ) => z.2 i) ⁻¹'
            sets i) := by
            apply Finset.prod_congr rfl
            intro i hi
            dsimp [γflat]
            rw [MeasureTheory.Measure.map_apply hflat]
            · rfl
            · exact
                (by fun_prop :
                  Measurable
                    (fun z : Ω × (Fin (T * K) → Fin d → ℝ) => z.2 i))
                  (hsets i hi)
  have hmargflat : ∀ i : Fin (T * K),
      MeasureTheory.Measure.map
        (fun z : Ω × (Fin (T * K) → Fin d → ℝ) => z.2 i) γflat = μ0 := by
    intro i
    dsimp [γflat]
    rw [MeasureTheory.Measure.map_map (by fun_prop) hflat]
    simpa [Function.comp_def, flat] using hmarg (finProdFinEquiv.symm i)
  have hgoodFlatprob :
      γflat goodFlat ≥ ENNReal.ofReal (1 - (T : ℝ) * q) := by
    calc
      ENNReal.ofReal (1 - (T : ℝ) * q) ≤ γ good := hgoodprob
      _ = γ (flat ⁻¹' goodFlat) := by rw [hpreimage]
      _ = γflat goodFlat :=
        (MeasureTheory.Measure.map_apply hflat hgoodFlatMeas).symm
  refine ⟨γflat, hγflat, ?_, hIndflat, hmargflat, ?_⟩
  · dsimp [γflat]
    rw [MeasureTheory.Measure.map_map measurable_fst hflat]
    simpa [Function.comp_def, flat] using hΩ
  · calc
      ENNReal.ofReal (1 - (T : ℝ) * q) ≤ γflat goodFlat := hgoodFlatprob
      _ ≤ γflat {z | ∃ φ : Fin T → Fin (T * K), StrictMono φ ∧
          ∀ t, X t z.1 = z.2 (φ t)} := MeasureTheory.measure_mono hsubset

@[blueprint "lem:sequential-reverse-kernel-composition"
  (statement := /-- Let (T) and (K) be positive natural numbers, let
  (d\in\mathbb N), and let
  ((\Omega,\mathcal F,\mu)) be a probability space, and let
  ((\mathcal H_t^x)_{t\geq0}) be the earlier-covariate filtration of
  a process ((X_t)_{t<T}) in (\mathbb R^d).  Suppose that (P_t) is a
  conditional law of (X_t) given (\mathcal H_t^x).  Fix a probability
  measure (\mu_0) on (\mathbb R^d), a number (q\in[0,1]), and, for
  each (t<T), a probability kernel (Q_t) from
  ((\Omega,\mathcal H_t^x)) to
  (\mathbb R^d\times(\mathbb R^d)^K).  Assume that the first marginal
  of (Q_t(\omega,\cdot)) is (P_t(\omega,\cdot)), that its (K)
  proposal coordinates are jointly independent with common law
  (\mu_0), and that its accepted coordinate belongs to its proposal
  block with probability at least (1-q), for every (t<T) and every
  (\omega\in\Omega).

  Then there is a probability measure coupling the original
  (\Omega)-coordinate with (TK) proposal coordinates such that its
  (\Omega)-marginal is (\mu), all proposal coordinates are jointly
  independent with common law (\mu_0), and, with probability at least
  (1-Tq), the sequence ((X_t)_{t<T}) is an order-preserving subsequence
  of the flattened proposal array. -/)
  (proof := /-- Apply
  \cref{lem:sequential-reverse-product-coupling} to the kernels (Q_t).
  It gives a probability measure on the original sample coordinate and
  the (T) proposal blocks, preserves the (\Omega)-marginal, gives all
  (TK) proposal coordinates their joint product law, and makes the
  match event in each block have probability at least (1-q).

  It remains to verify the measurability premise of
  \cref{lem:block-matches-give-subsequence}.  By
  \cref{def:covariate-history-filtration}, for each (t<T), the preimages
  under (X_t) of Borel sets occur among the generators of
  (\mathcal H^x_{t+1}); since this sigma-algebra is contained in the
  ambient sigma-algebra on (\Omega), the map (X_t) is measurable.  Every
  proposal-coordinate projection is measurable as well.  Hence, for
  each (j<K), the equality event (\{X_t=z_{t,j}\}) is measurable, and
  its finite union over (j) is precisely the block-match event.

  The hypotheses of \cref{lem:block-matches-give-subsequence} are
  therefore satisfied.  That lemma applies the finite union bound to
  the blockwise failures and pushes the coupling through the measurable
  lexicographic flattening equivalence.  The resulting coupling has the
  required marginal and independence properties, and on an event of
  probability at least (1-Tq) the least matching coordinate in every
  block defines the required strictly increasing subsequence map. -/)
  (title := /-- Sequential composition of reverse proposal kernels -/)
  (latexEnv := "lemma")]
lemma sequential_reverse_kernel_composition :
    ∀ (T d K : ℕ) (Ω : Type*) [mΩ : MeasurableSpace Ω]
      (μ : MeasureTheory.Measure Ω)
      [MeasureTheory.IsProbabilityMeasure μ]
      (ℋx : MeasureTheory.Filtration ℕ mΩ)
      (X : Fin T → Ω → Fin d → ℝ)
      (P : (t : Fin T) → @ProbabilityTheory.Kernel Ω (Fin d → ℝ)
        (ℋx t.val) inferInstance)
      (μ0 : MeasureTheory.Measure (Fin d → ℝ))
      [MeasureTheory.IsProbabilityMeasure μ0]
      (q : ℝ)
      (Q : (t : Fin T) →
        @ProbabilityTheory.Kernel Ω
          ((Fin d → ℝ) × (Fin K → Fin d → ℝ))
          (ℋx t.val) inferInstance),
      0 < T → 0 < K → 0 ≤ q → q ≤ 1 →
      covariate_history_filtration ℋx X →
      conditional_covariate_law μ ℋx X P →
      (∀ t ω,
        MeasureTheory.IsProbabilityMeasure (Q t ω) ∧
        MeasureTheory.Measure.map
          (fun z : (Fin d → ℝ) × (Fin K → Fin d → ℝ) => z.1)
          (Q t ω) = P t ω ∧
        ProbabilityTheory.iIndepFun
          (fun j : Fin K =>
            fun z : (Fin d → ℝ) × (Fin K → Fin d → ℝ) => z.2 j)
          (Q t ω) ∧
        (∀ j : Fin K,
          MeasureTheory.Measure.map
            (fun z : (Fin d → ℝ) × (Fin K → Fin d → ℝ) => z.2 j)
            (Q t ω) = μ0) ∧
        Q t ω {z | ∃ j : Fin K, z.1 = z.2 j} ≥
          ENNReal.ofReal (1 - q)) →
      ∃ γ : MeasureTheory.Measure
          (Ω × (Fin (T * K) → Fin d → ℝ)),
        MeasureTheory.IsProbabilityMeasure γ ∧
        MeasureTheory.Measure.map
          (fun z : Ω × (Fin (T * K) → Fin d → ℝ) => z.1) γ = μ ∧
        ProbabilityTheory.iIndepFun
          (fun i : Fin (T * K) =>
            fun z : Ω × (Fin (T * K) → Fin d → ℝ) => z.2 i) γ ∧
        (∀ i : Fin (T * K),
          MeasureTheory.Measure.map
            (fun z : Ω × (Fin (T * K) → Fin d → ℝ) => z.2 i) γ = μ0) ∧
        γ {z | ∃ φ : Fin T → Fin (T * K), StrictMono φ ∧
          ∀ t, X t z.1 = z.2 (φ t)} ≥
            ENNReal.ofReal (1 - (T : ℝ) * q) := by
  classical
  intro T d K Ω mΩ μ hμ ℋx X P μ0 hμ0 q Q hT hK hq0 hq1 hℋ hP hQ
  have hX_hist (t : Fin T) :
      @Measurable Ω (Fin d → ℝ) (ℋx (t.val + 1)) inferInstance (X t) := by
    rw [hℋ (t.val + 1)]
    intro s hs
    exact MeasurableSpace.measurableSet_generateFrom
      ⟨t, Nat.lt_succ_self t.val, s, hs, rfl⟩
  have hX_meas (t : Fin T) : Measurable (X t) :=
    (hX_hist t).mono (ℋx.le (t.val + 1)) le_rfl
  obtain ⟨γ, hγ, hΩ, hind, hmarg, hmatch⟩ :=
    sequential_reverse_product_coupling T d K Ω μ ℋx X P μ0 q Q
      hT hK hq0 hq1 hℋ hP hQ
  refine block_matches_give_subsequence T d K Ω μ X μ0 q γ
    hT hK hq0 hq1 hγ hΩ hind hmarg ?_ hmatch
  intro t
  simp only [Set.setOf_exists]
  change MeasurableSet (⋃ j : Fin K,
    {z : Ω × (Fin T → Fin K → Fin d → ℝ) | X t z.1 = z.2 t j})
  apply MeasurableSet.iUnion
  intro j
  exact measurableSet_eq_fun ((hX_meas t).comp measurable_fst) (by fun_prop)

@[blueprint "lem:adaptive-reverse-kernel-gluing"
  (statement := /-- Let (T,K\in\mathbb N) be positive, let
  (d\in\mathbb N), and let ((\Omega,\mathcal F,\mu)) be a probability
  space.  Let ((\mathcal H_t^x)_{t\geq0}) be the earlier-covariate
  filtration of a process ((X_t)_{t<T}) in (\mathbb R^d), and suppose
  that (P_t) is a conditional law of (X_t) given (\mathcal H_t^x).
  Let (\mu_0) be a probability measure on (\mathbb R^d), and assume
  that, for some (C_{\mathrm{cov}}\geq1),
  (P_t(\omega,\cdot)\leq C_{\mathrm{cov}}\mu_0) for every
  (t<T) and (\omega\in\Omega).

  Then there is a probability measure coupling (\Omega) with (TK)
  proposal coordinates whose (\Omega)-marginal is (\mu), whose
  proposal coordinates are jointly independent with common law
  (\mu_0), and under which ((X_t)_{t<T}) is an order-preserving
  subsequence of the proposal array with probability at least
  (1-T(1-C_{\mathrm{cov}}^{-1})^K). -/)
  (proof := /-- By \cref{def:conditional-covariate-law}, every measure
  (P_t(\omega,\cdot)) is a probability measure.  Moreover,
  (C_{\mathrm{cov}}\geq1) implies
  (0\leq C_{\mathrm{cov}}^{-1}\leq1).  Hence, for
  (q=(1-C_{\mathrm{cov}}^{-1})^K), one has (0\leq q\leq1).

  Apply \cref{lem:one-block-reverse-rejection-kernel}.  It gives, at
  every round and every earlier history, a probability kernel whose
  accepted marginal is (P_t), whose proposal coordinates are jointly
  independent with common law (\mu_0), and whose matching probability
  is at least (1-q).  Apply
  \cref{lem:sequential-reverse-kernel-composition} to these kernels.
  The resulting probability measure preserves the (\Omega)-marginal,
  gives the flattened proposal array its full product law, and assigns
  probability at least
  (1-Tq=1-T(1-C_{\mathrm{cov}}^{-1})^K) to the event on which the
  blockwise matches define a strictly increasing subsequence map. -/)
  (title := /-- Gluing adaptive reverse rejection kernels -/)
  (latexEnv := "lemma")]
lemma adaptive_reverse_kernel_gluing :
    ∀ (T d K : ℕ) (Ω : Type*) [mΩ : MeasurableSpace Ω]
      (μ : MeasureTheory.Measure Ω)
      [MeasureTheory.IsProbabilityMeasure μ]
      (ℋx : MeasureTheory.Filtration ℕ mΩ)
      (X : Fin T → Ω → Fin d → ℝ)
      (P : (t : Fin T) → @ProbabilityTheory.Kernel Ω (Fin d → ℝ)
        (ℋx t.val) inferInstance)
      (μ0 : MeasureTheory.Measure (Fin d → ℝ))
      [MeasureTheory.IsProbabilityMeasure μ0]
      (Ccov : ℝ),
      0 < T → 0 < K → 1 ≤ Ccov →
      covariate_history_filtration ℋx X →
      conditional_covariate_law μ ℋx X P →
      smooth_covariates ℋx P μ0 Ccov →
      ∃ γ : MeasureTheory.Measure
          (Ω × (Fin (T * K) → Fin d → ℝ)),
        MeasureTheory.IsProbabilityMeasure γ ∧
        MeasureTheory.Measure.map
          (fun z : Ω × (Fin (T * K) → Fin d → ℝ) => z.1) γ = μ ∧
        ProbabilityTheory.iIndepFun
          (fun i : Fin (T * K) =>
            fun z : Ω × (Fin (T * K) → Fin d → ℝ) => z.2 i) γ ∧
        (∀ i : Fin (T * K),
          MeasureTheory.Measure.map
            (fun z : Ω × (Fin (T * K) → Fin d → ℝ) => z.2 i) γ = μ0) ∧
        γ {z | ∃ φ : Fin T → Fin (T * K), StrictMono φ ∧
          ∀ t, X t z.1 = z.2 (φ t)} ≥
            ENNReal.ofReal
              (1 - (T : ℝ) * (1 - Ccov⁻¹) ^ K) := by
  classical
  intro T d K Ω mΩ μ hμ ℋx X P μ0 hμ0 Ccov hT hK hC hℋ hP hsmooth
  have hCpos : 0 < Ccov := zero_lt_one.trans_le hC
  have hp0 : 0 ≤ Ccov⁻¹ := inv_nonneg.mpr hCpos.le
  have hp1 : Ccov⁻¹ ≤ 1 := (inv_le_one₀ hCpos).2 hC
  have hq0 : 0 ≤ (1 - Ccov⁻¹) ^ K :=
    pow_nonneg (sub_nonneg.mpr hp1) K
  have hq1 : (1 - Ccov⁻¹) ^ K ≤ 1 :=
    pow_le_one₀ (sub_nonneg.mpr hp1) (sub_le_self 1 hp0)
  obtain ⟨Q, hQ⟩ :=
    one_block_reverse_rejection_kernel T d K Ω ℋx P μ0 Ccov
      hK hP.1 hμ0 hC hsmooth
  exact sequential_reverse_kernel_composition T d K Ω μ ℋx X P μ0
    ((1 - Ccov⁻¹) ^ K) Q hT hK hq0 hq1 hℋ hP hQ

@[blueprint "lem:dominated-kernel-rejection-coupling"
  (statement := /-- Let (T,K\in\mathbb N) be positive, let
  (d\in\mathbb N), and let ((\Omega,\mathcal F,\mu)) be a probability
  space.  Let ((\mathcal H_n^x)_{n\geq0}) be the earlier-covariate
  filtration of a process ((X_t)_{t<T}) in (\mathbb R^d), and let
  ((P_t)_{t<T}) be its conditional laws given this filtration.  Let
  (\mu_0) be a probability measure on (\mathbb R^d), and suppose that
  (P_t(\omega,\cdot)\leq C_{\mathrm{cov}}\mu_0) for every
  (t<T,\omega\in\Omega), where (C_{\mathrm{cov}}\geq1).

  For every (\eta\in(0,1)) satisfying
  (C_{\mathrm{cov}}\log(T/\eta)\leq K), there is a probability measure
  coupling (\Omega) with (TK) proposal vectors whose first marginal is
  (\mu), whose proposal coordinates are jointly independent and each
  have law (\mu_0), and under which, with probability at least
  (1-\eta), there is a strictly increasing map from the (T) process
  indices to the (TK) proposal indices that matches every (X_t) to the
  corresponding proposal vector. -/)
  (proof := /-- Apply \cref{lem:adaptive-reverse-kernel-gluing}.  It
  preserves the original (\Omega)-marginal, makes all (TK) proposals
  jointly independent with common law (\mu_0), and bounds the failure
  probability by
  (T(1-C_{\mathrm{cov}}^{-1})^K).

  Since (C_{\mathrm{cov}}\geq1), the inequality
  (1-u\leq e^{-u}) for (u=C_{\mathrm{cov}}^{-1}) gives
  [
    (1-C_{\mathrm{cov}}^{-1})^K
      \leq \exp(-K/C_{\mathrm{cov}}).
  ]
  The assumed lower bound
  (K\geq C_{\mathrm{cov}}\log(T/\eta)) therefore implies
  [
    T(1-C_{\mathrm{cov}}^{-1})^K
      \leq T\exp(-K/C_{\mathrm{cov}})
      \leq T\exp(-\log(T/\eta))=\eta,
  ]
  where (T>0) and (0<\eta<1) ensure that every logarithm is taken at a
  positive argument.  Hence the success event supplied by that lemma
  has probability at least (1-\eta).  Its strictly increasing
  blockwise index map is exactly the required order-preserving
  subsequence map. -/)
  (title := /-- Measurable rejection coupling for dominated kernels -/)
  (latexEnv := "lemma")]
lemma dominated_kernel_rejection_coupling :
    ∀ (T d K : ℕ) (Ω : Type*) [mΩ : MeasurableSpace Ω]
      (μ : MeasureTheory.Measure Ω)
      [MeasureTheory.IsProbabilityMeasure μ]
      (ℋx : MeasureTheory.Filtration ℕ mΩ)
      (X : Fin T → Ω → Fin d → ℝ)
      (P : (t : Fin T) → @ProbabilityTheory.Kernel Ω (Fin d → ℝ)
        (ℋx t.val) inferInstance)
      (μ0 : MeasureTheory.Measure (Fin d → ℝ))
      [MeasureTheory.IsProbabilityMeasure μ0]
      (Ccov η : ℝ),
      0 < T → 0 < K → 1 ≤ Ccov → 0 < η → η < 1 →
      (Ccov * Real.log ((T : ℝ) / η) ≤ (K : ℝ)) →
      covariate_history_filtration ℋx X →
      conditional_covariate_law μ ℋx X P →
      smooth_covariates ℋx P μ0 Ccov →
      ∃ γ : MeasureTheory.Measure
          (Ω × (Fin (T * K) → Fin d → ℝ)),
        MeasureTheory.IsProbabilityMeasure γ ∧
        MeasureTheory.Measure.map
          (fun z : Ω × (Fin (T * K) → Fin d → ℝ) => z.1) γ = μ ∧
        ProbabilityTheory.iIndepFun
          (fun i : Fin (T * K) =>
            fun z : Ω × (Fin (T * K) → Fin d → ℝ) => z.2 i) γ ∧
        (∀ i : Fin (T * K),
          MeasureTheory.Measure.map
            (fun z : Ω × (Fin (T * K) → Fin d → ℝ) => z.2 i) γ = μ0) ∧
        γ {z | ∃ φ : Fin T → Fin (T * K), StrictMono φ ∧
          ∀ t, X t z.1 = z.2 (φ t)} ≥ ENNReal.ofReal (1 - η) := by
  classical
  intro T d K Ω mΩ μ hμ ℋx X P μ0 hμ0 Ccov η hT hK hC hη0 hη1 hsize
    hℋ hP hsmooth
  have hCpos : 0 < Ccov := zero_lt_one.trans_le hC
  have hbase : 0 ≤ 1 - Ccov⁻¹ := by
    exact sub_nonneg.mpr ((inv_le_one₀ hCpos).2 hC)
  have hpow : (1 - Ccov⁻¹) ^ K ≤ Real.exp (-((K : ℝ) / Ccov)) := by
    calc
      (1 - Ccov⁻¹) ^ K ≤ (Real.exp (-Ccov⁻¹)) ^ K :=
        pow_le_pow_left₀ hbase (Real.one_sub_le_exp_neg Ccov⁻¹) K
      _ = Real.exp ((K : ℝ) * (-Ccov⁻¹)) :=
        (Real.exp_nat_mul (-Ccov⁻¹) K).symm
      _ = Real.exp (-((K : ℝ) / Ccov)) := by
        congr 1
        ring
  have hlog : Real.log ((T : ℝ) / η) ≤ (K : ℝ) / Ccov := by
    rw [le_div_iff₀ hCpos]
    simpa [mul_comm] using hsize
  have hratio : 0 < (T : ℝ) / η :=
    div_pos (Nat.cast_pos.mpr hT) hη0
  have hexp : Real.exp (-((K : ℝ) / Ccov)) ≤ η / (T : ℝ) := by
    calc
      Real.exp (-((K : ℝ) / Ccov)) ≤
          Real.exp (-Real.log ((T : ℝ) / η)) :=
        Real.exp_le_exp.mpr (neg_le_neg hlog)
      _ = η / (T : ℝ) := by
        rw [Real.exp_neg, Real.exp_log hratio, inv_div]
  have hfail : (T : ℝ) * (1 - Ccov⁻¹) ^ K ≤ η := by
    calc
      (T : ℝ) * (1 - Ccov⁻¹) ^ K ≤
          (T : ℝ) * (η / (T : ℝ)) :=
        mul_le_mul_of_nonneg_left (hpow.trans hexp) (Nat.cast_nonneg T)
      _ = η := by
        field_simp [ne_of_gt (Nat.cast_pos.mpr hT)]
  obtain ⟨γ, hγ, hΩ, hind, hmarg, hmatch⟩ :=
    adaptive_reverse_kernel_gluing T d K Ω μ ℋx X P μ0 Ccov
      hT hK hC hℋ hP hsmooth
  refine ⟨γ, hγ, hΩ, hind, hmarg, ?_⟩
  calc
    γ {z | ∃ φ : Fin T → Fin (T * K), StrictMono φ ∧
        ∀ t, X t z.1 = z.2 (φ t)} ≥
        ENNReal.ofReal (1 - (T : ℝ) * (1 - Ccov⁻¹) ^ K) := hmatch
    _ ≥ ENNReal.ofReal (1 - η) :=
      ENNReal.ofReal_le_ofReal (sub_le_sub_left hfail 1)

@[blueprint "lem:reverse-average-leverage"
  (statement := /-- For (n,d\in\mathbb N), let
  (z_0,\ldots,z_{n-1}\in\mathbb R^d), and let (B\in\mathbb R^{d\times d})
  be a Moore--Penrose inverse of
  (\sum_{i<n}z_i z_i^{\mathsf T}).  Then
  [
    \sum_{i<n}z_i^{\mathsf T}Bz_i\leq d.
  ] -/)
  (proof := /-- Set (A=\sum_i z_i z_i^{\mathsf T}) and (P=BA).  By
  \cref{def:is-moore-penrose-inverse}, (P) is self-adjoint, while
  (BAB=B) implies (P^2=P).  Consequently, for every coordinate (j),
  [
    P_{jj}=(P^2)_{jj}=\sum_k P_{jk}P_{kj}
      =\sum_k P_{jk}^2.
  ]
  Thus (P_{jj}\geq0), and retaining the summand with (k=j) gives
  (P_{jj}^2\leq P_{jj}); hence (P_{jj}\leq1).  Expanding the quadratic
  energies from \cref{def:self-normalized-energy} and interchanging the
  finite sums yields
  [
    \sum_i z_i^{\mathsf T}Bz_i
      =\sum_i\operatorname{tr}(Bz_i z_i^{\mathsf T})
      =\operatorname{tr}(BA)=\sum_j P_{jj}\leq d.
  ] -/)
  (title := /-- Average leverage bound for a finite Gram matrix -/)
  (latexEnv := "lemma")]
lemma reverse_average_leverage {n d : ℕ}
    (z : Fin n → Fin d → ℝ)
    (B : Matrix (Fin d) (Fin d) ℝ)
    (hB : is_moore_penrose_inverse
      (∑ i, Matrix.vecMulVec (z i) (z i)) B) :
    (∑ i, self_normalized_energy (z i) B) ≤ (d : ℝ) := by
  classical
  let A : Matrix (Fin d) (Fin d) ℝ :=
    ∑ i, Matrix.vecMulVec (z i) (z i)
  let P : Matrix (Fin d) (Fin d) ℝ := B * A
  have hB' : is_moore_penrose_inverse A B := by
    simpa only [A] using hB
  rcases hB' with ⟨hABA, hBAB, hAB, hBA⟩
  have hPstar : Matrix.conjTranspose P = P := by
    simpa only [P] using hBA
  have hPP : P * P = P := by
    calc
      P * P = (B * A * B) * A := by simp only [P, mul_assoc]
      _ = B * A := by rw [hBAB]
      _ = P := rfl
  have hsym (j k : Fin d) : P j k = P k j := by
    have h := congrFun (congrFun hPstar k) j
    simpa only [Matrix.conjTranspose_apply, star_trivial] using h
  have hdiag (j : Fin d) : 0 ≤ P j j ∧ P j j ≤ 1 := by
    have hsquares : ∑ k, (P j k) ^ 2 = P j j := by
      calc
        ∑ k, (P j k) ^ 2 = ∑ k, P j k * P k j := by
          apply Finset.sum_congr rfl
          intro k hk
          rw [hsym k j]
          ring
        _ = (P * P) j j := by rw [Matrix.mul_apply]
        _ = P j j := by rw [hPP]
    have hnonneg : 0 ≤ P j j := by
      rw [← hsquares]
      exact Finset.sum_nonneg fun k hk => sq_nonneg (P j k)
    have hsqle : (P j j) ^ 2 ≤ ∑ k, (P j k) ^ 2 := by
      exact Finset.single_le_sum
        (fun k hk => sq_nonneg (P j k)) (Finset.mem_univ j)
    rw [hsquares] at hsqle
    constructor
    · exact hnonneg
    · nlinarith
  have henergy (i : Fin n) :
      self_normalized_energy (z i) B =
        Matrix.trace (B * Matrix.vecMulVec (z i) (z i)) := by
    simp only [self_normalized_energy, dotProduct, Matrix.mulVec,
      Matrix.trace, Matrix.diag, Matrix.mul_apply, Matrix.vecMulVec_apply]
    simp_rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j hj
    apply Finset.sum_congr rfl
    intro k hk
    ring
  have htrace :
      (∑ i, self_normalized_energy (z i) B) = Matrix.trace P := by
    calc
      (∑ i, self_normalized_energy (z i) B) =
          ∑ i, Matrix.trace (B * Matrix.vecMulVec (z i) (z i)) := by
        apply Finset.sum_congr rfl
        intro i hi
        exact henergy i
      _ = Matrix.trace (∑ i, B * Matrix.vecMulVec (z i) (z i)) := by
        simp only [Matrix.trace_sum]
      _ = Matrix.trace (B * A) := by
        simp only [A, Finset.mul_sum]
      _ = Matrix.trace P := rfl
  rw [htrace]
  simp only [Matrix.trace]
  calc
    ∑ j, Matrix.diag P j ≤ ∑ j, (1 : ℝ) := by
      apply Finset.sum_le_sum
      intro j hj
      simpa only [Matrix.diag] using (hdiag j).2
    _ = (d : ℝ) := by simp

@[blueprint "lem:iid-tuple-permutation-invariant"
  (statement := /-- Let \(k\in\mathbb N\), let \((\Omega,\nu)\) be a
  probability space, and let \(A\) be a measurable space.  Suppose
  that \(Z_i:\Omega\to A\), \(i\in\operatorname{Fin}(k)\), are
  measurable and independent and have a common distribution.  Then,
  for every permutation \(\pi\) of \(\operatorname{Fin}(k)\), the
  random tuples \((Z_{\pi(i)})_i\) and \((Z_i)_i\) have the same
  distribution. -/)
  (proof := /-- Precomposition by the injective map \(\pi\) preserves
  independence.  Apply the finite independent-family joint-law formula
  to the original family and to the reindexed family.  Their joint laws
  are the product measures formed from the respective marginal
  pushforwards.  For every coordinate \(i\), the common-distribution
  hypothesis identifies the marginal of \(Z_{\pi(i)}\) with that of
  \(Z_i\).  The two product measures, and hence the two joint
  pushforwards, are therefore equal. -/)
  (title := /-- Permutation invariance of a finite iid tuple -/)
  (latexEnv := "lemma")]
lemma iid_tuple_permutation_invariant :
    ∀ (k : ℕ) (Ω A : Type*) [mΩ : MeasurableSpace Ω]
      [mA : MeasurableSpace A]
      (ν : MeasureTheory.Measure Ω)
      [MeasureTheory.IsProbabilityMeasure ν]
      (Z : Fin k → Ω → A) (π : Equiv.Perm (Fin k)),
      (∀ i, Measurable (Z i)) →
      ProbabilityTheory.iIndepFun Z ν →
      (∀ i j, MeasureTheory.Measure.map (Z i) ν =
        MeasureTheory.Measure.map (Z j) ν) →
      MeasureTheory.Measure.map (fun ω i => Z (π i) ω) ν =
        MeasureTheory.Measure.map (fun ω i => Z i ω) ν := by
  intro k Ω A mΩ mA ν hν Z π hmeas hind hmap
  rw [
    (ProbabilityTheory.iIndepFun.precomp π.injective hind).map_fun_eq_pi_map
      (fun i => (hmeas (π i)).aemeasurable),
    hind.map_fun_eq_pi_map (fun i => (hmeas i).aemeasurable)]
  congr 1
  funext i
  exact hmap (π i) i

@[blueprint "lem:finite-permutation-orbit-measure-bound"
  (statement := /-- Let \(k\in\mathbb N\), let \(A\) be a measurable
  space, and let \(\rho\) be a probability measure on \(A^k\) that is
  invariant under every permutation of its coordinates.  Let
  \(E\subseteq A^k\) be measurable, and let \(q\geq0\).  If, for every
  \(z\in A^k\), at most \(qk!\) coordinate permutations of \(z\)
  belong to \(E\), then \(\rho(E)\leq q\). -/)
  (proof := /-- For each permutation \(\pi\), let
  \(f_\pi(z)=\mathbf 1_E((z_{\pi(i)})_{i<k})\).  The coordinate action is
  measurable, so every \(f_\pi\) is measurable.  The pushforward
  invariance hypothesis and the pushforward formula for measurable sets
  give
  \[
    \int f_\pi\,d\rho=\rho(E).
  \]
  Hence finite additivity of the nonnegative integral and the identity
  \(\lvert\operatorname{Perm}(\operatorname{Fin} k)\rvert=k!\) yield
  \[
    \int\sum_\pi f_\pi\,d\rho=k!\,\rho(E).
  \]
  For each \(z\), the sum \(\sum_\pi f_\pi(z)\) is exactly the number of
  coordinate permutations of \(z\) that lie in \(E\); the orbit-count
  hypothesis therefore bounds it by \(qk!\).  Integrating this pointwise
  inequality and using that \(\rho\) is a probability measure gives
  \(k!\,\rho(E)\leq qk!\).  Since \(k!\) is finite and nonzero,
  cancellation proves \(\rho(E)\leq q\). -/)
  (title := /-- Orbit averaging for a permutation-invariant measure -/)
  (latexEnv := "lemma")]
lemma finite_permutation_orbit_measure_bound :
    ∀ (k : ℕ) (A : Type*) [mA : MeasurableSpace A]
      (ρ : MeasureTheory.Measure (Fin k → A))
      [MeasureTheory.IsProbabilityMeasure ρ]
      (E : Set (Fin k → A)) (q : ℝ),
      MeasurableSet E →
      0 ≤ q →
      (∀ π : Equiv.Perm (Fin k),
        MeasureTheory.Measure.map
          (fun z : Fin k → A => fun i => z (π i)) ρ = ρ) →
      (∀ z : Fin k → A,
        (Set.ncard {π : Equiv.Perm (Fin k) |
          (fun i => z (π i)) ∈ E} : ℝ) ≤
            q * (Nat.factorial k : ℝ)) →
      ρ E ≤ ENNReal.ofReal q := by
  classical
  intro k A mA ρ hρ E q hE hq hinv hcount
  let act : Equiv.Perm (Fin k) → (Fin k → A) → (Fin k → A) :=
    fun π z i => z (π i)
  let f : Equiv.Perm (Fin k) → (Fin k → A) → ENNReal :=
    fun π z => E.indicator (fun _ => 1) (act π z)
  have hact (π : Equiv.Perm (Fin k)) : Measurable (act π) := by
    fun_prop
  have hf (π : Equiv.Perm (Fin k)) : Measurable (f π) := by
    exact measurable_const.indicator (hE.preimage (hact π))
  have hsum (z : Fin k → A) :
      ∑ π, f π z =
        ((Set.ncard {π : Equiv.Perm (Fin k) | act π z ∈ E} : ℕ) : ENNReal) := by
    rw [Set.ncard_eq_toFinset_card']
    simpa only [f, Set.indicator_apply, Set.toFinset_setOf] using
      (Finset.sum_boole (R := ENNReal) (fun π : Equiv.Perm (Fin k) => act π z ∈ E)
        Finset.univ)
  have hpoint (z : Fin k → A) :
      ∑ π, f π z ≤ ENNReal.ofReal (q * (Nat.factorial k : ℝ)) := by
    rw [hsum]
    simpa [act] using ENNReal.ofReal_le_ofReal (hcount z)
  have hfint (π : Equiv.Perm (Fin k)) :
      ∫⁻ z, f π z ∂ρ = ρ E := by
    calc
      ∫⁻ z, f π z ∂ρ = ρ (act π ⁻¹' E) := by
        rw [← MeasureTheory.lintegral_indicator_one (hE.preimage (hact π))]
        congr 1
      _ = MeasureTheory.Measure.map (act π) ρ E := by
        rw [MeasureTheory.Measure.map_apply (hact π) hE]
      _ = ρ E := by
        simpa [act] using congrArg (fun μ : MeasureTheory.Measure (Fin k → A) => μ E)
          (hinv π)
  have hint_eq :
      ∫⁻ z, ∑ π, f π z ∂ρ = (Nat.factorial k : ENNReal) * ρ E := by
    calc
      ∫⁻ z, ∑ π, f π z ∂ρ = ∑ π, ∫⁻ z, f π z ∂ρ := by
        simpa using MeasureTheory.lintegral_finsetSum (μ := ρ) Finset.univ
          (fun π _ => hf π)
      _ = (Nat.factorial k : ENNReal) * ρ E := by
        simp [hfint, Fintype.card_perm]
  have hint_le :
      ∫⁻ z, ∑ π, f π z ∂ρ ≤ ENNReal.ofReal (q * (Nat.factorial k : ℝ)) :=
    MeasureTheory.lintegral_le_const (Filter.Eventually.of_forall hpoint)
  apply (ENNReal.mul_le_mul_iff_left (by positivity : (Nat.factorial k : ENNReal) ≠ 0)
    (by simp : (Nat.factorial k : ENNReal) ≠ ⊤)).mp
  calc
    ρ E * (Nat.factorial k : ENNReal) = (Nat.factorial k : ENNReal) * ρ E :=
      mul_comm _ _
    _ = ∫⁻ z, ∑ π, f π z ∂ρ := hint_eq.symm
    _ ≤ ENNReal.ofReal (q * (Nat.factorial k : ℝ)) := hint_le
    _ = ENNReal.ofReal q * (Nat.factorial k : ENNReal) := by
      rw [ENNReal.ofReal_mul hq]
      simp

@[blueprint "lem:iid-bad-permutation-count-local"
  (statement := /-- Let (z_0,\ldots,z_{k-1}\in\mathbb R^d) and let
  (r>0).  The number of coordinate permutations for which every vector
  has self-normalized energy at least (r) against a Moore--Penrose
  inverse of its inclusive prefix Gram matrix is at most ((d/r)^k). -/)
  (proof := /-- Induct on (k), constructing an ordering backwards.  For
  the full Gram matrix choose a Moore--Penrose inverse using
  \cref{lem:pos-semidef-moore-penrose-exists}.  The identities from
  \cref{lem:self-normalized-gram-projection-fixes-generator} and
  \cref{lem:self-normalized-gram-quadratic-nonnegative} show that all
  resulting energies are nonnegative.  By
  \cref{lem:reverse-average-leverage}, at most (d/r) indexed vectors can
  be the last vector of a bad ordering.  For each possible last vector,
  remove that coordinate and apply the induction hypothesis to the
  remaining prefix.  \cref{lem:local-moore-penrose-inverse-unique}
  identifies the inverse supplied by a bad ordering with the chosen
  inverse, and summing the fiber bounds gives ((d/r)^{k+1}). -/)
  (title := /-- Reverse count of bad leverage permutations -/)
  (latexEnv := "lemma")]
lemma iid_bad_permutation_count_local {k d : ℕ}
    (z : Fin k → Fin d → ℝ) (r : ℝ) (hr : 0 < r) :
    (Set.ncard {π : Equiv.Perm (Fin k) |
      ∃ U : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
        (∀ m, is_moore_penrose_inverse
          (∑ i, if i.val < m.val then
            Matrix.vecMulVec (z (π i)) (z (π i)) else 0) (U m)) ∧
        ∀ i, r ≤ self_normalized_energy (z (π i)) (U i.succ)} : ℝ) ≤
      ((d : ℝ) / r) ^ k := by
  classical
  induction k with
  | zero =>
      norm_num only [pow_zero]
      exact_mod_cast Set.ncard_le_one_of_subsingleton
        {π : Equiv.Perm (Fin 0) |
          ∃ U : Fin (0 + 1) → Matrix (Fin d) (Fin d) ℝ,
            (∀ m, is_moore_penrose_inverse
              (∑ i, if i.val < m.val then
                Matrix.vecMulVec (z (π i)) (z (π i)) else 0) (U m)) ∧
            ∀ i, r ≤ self_normalized_energy (z (π i)) (U i.succ)}
  | succ k ih =>
      let A : Matrix (Fin d) (Fin d) ℝ :=
        ∑ i : Fin (k + 1), Matrix.vecMulVec (z i) (z i)
      have hApos : A.PosSemidef := by
        dsimp [A]
        simpa using Matrix.posSemidef_sum Finset.univ
          (fun i _ => by
            simpa using Matrix.posSemidef_vecMulVec_self_star (z i))
      obtain ⟨B, hB⟩ := pos_semidef_moore_penrose_exists A hApos
      let C : Finset (Fin (k + 1)) :=
        Finset.univ.filter fun a => r ≤ self_normalized_energy (z a) B
      have henergy_nonneg (a : Fin (k + 1)) :
          0 ≤ self_normalized_energy (z a) B := by
        have hfix := self_normalized_gram_projection_fixes_generator z B
          (by simpa only [A] using hB) a
        have hfix' :
            Matrix.mulVec A (Matrix.mulVec B (z a)) = z a := by
          simpa only [Matrix.mulVec_mulVec] using hfix
        calc
          0 ≤ dotProduct (Matrix.mulVec B (z a))
              (Matrix.mulVec A (Matrix.mulVec B (z a))) := by
            simpa only [A] using
              self_normalized_gram_quadratic_nonnegative z
                (Matrix.mulVec B (z a))
          _ = self_normalized_energy (z a) B := by
            rw [hfix']
            exact dotProduct_comm _ _
      have hCcard : (C.card : ℝ) ≤ (d : ℝ) / r := by
        have havg : (∑ a, self_normalized_energy (z a) B) ≤ (d : ℝ) :=
          reverse_average_leverage z B (by simpa only [A] using hB)
        have hlow :
            (C.card : ℝ) * r ≤
              ∑ a ∈ C, self_normalized_energy (z a) B := by
          rw [Finset.card_eq_sum_ones, Nat.cast_sum]
          simp only [Nat.cast_one, Finset.sum_mul]
          exact Finset.sum_le_sum fun a ha => by
            simpa only [one_mul] using (Finset.mem_filter.mp ha).2
        have hsub :
            (∑ a ∈ C, self_normalized_energy (z a) B) ≤
              ∑ a, self_normalized_energy (z a) B :=
          Finset.sum_le_sum_of_subset_of_nonneg
            (Finset.filter_subset _ _) (fun a _ _ => henergy_nonneg a)
        apply (le_div_iff₀ hr).2
        exact hlow.trans (hsub.trans havg)
      let Bad : Set (Equiv.Perm (Fin (k + 1))) :=
        {π | ∃ U : Fin (k + 1 + 1) → Matrix (Fin d) (Fin d) ℝ,
          (∀ m, is_moore_penrose_inverse
            (∑ i, if i.val < m.val then
              Matrix.vecMulVec (z (π i)) (z (π i)) else 0) (U m)) ∧
          ∀ i, r ≤ self_normalized_energy (z (π i)) (U i.succ)}
      let Fiber (a : Fin (k + 1)) : Set (Equiv.Perm (Fin (k + 1))) :=
        {π | π ∈ Bad ∧ π (Fin.last k) = a}
      have hlast : Bad ⊆ ⋃ a ∈ C, Fiber a := by
        intro π hπ
        rcases hπ with ⟨U, hU, hlev⟩
        have hsum :
            (∑ i : Fin (k + 1),
              Matrix.vecMulVec (z (π i)) (z (π i))) = A := by
          simpa only [A] using
            (Equiv.sum_comp π (fun i => Matrix.vecMulVec (z i) (z i)))
        have hUlast :
            is_moore_penrose_inverse A (U (Fin.last (k + 1))) := by
          rw [← hsum]
          convert hU (Fin.last (k + 1)) using 1
          apply Finset.sum_congr rfl
          intro i hi
          simp [Fin.val_last, i.isLt]
        have heq : U (Fin.last (k + 1)) = B :=
          local_moore_penrose_inverse_unique hUlast hB
        have ha : π (Fin.last k) ∈ C := by
          rw [Finset.mem_filter]
          refine ⟨Finset.mem_univ _, ?_⟩
          simpa [heq] using hlev (Fin.last k)
        rw [Set.mem_iUnion]
        refine ⟨π (Fin.last k), ?_⟩
        rw [Set.mem_iUnion]
        exact ⟨ha, ⟨⟨U, hU, hlev⟩, rfl⟩⟩
      have hfiber (a : Fin (k + 1)) :
          (Fiber a).ncard ≤
            Set.ncard {q : Equiv.Perm (Fin k) |
              ∃ V : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
                (∀ m, is_moore_penrose_inverse
                  (∑ i, if i.val < m.val then
                    Matrix.vecMulVec (z (a.succAbove (q i)))
                      (z (a.succAbove (q i))) else 0) (V m)) ∧
                ∀ i, r ≤ self_normalized_energy
                  (z (a.succAbove (q i))) (V i.succ)} := by
        let S := {π : Equiv.Perm (Fin (k + 1)) // π ∈ Fiber a}
        let T := {q : Equiv.Perm (Fin k) |
          ∃ V : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
            (∀ m, is_moore_penrose_inverse
              (∑ i, if i.val < m.val then
                Matrix.vecMulVec (z (a.succAbove (q i)))
                  (z (a.succAbove (q i))) else 0) (V m)) ∧
            ∀ i, r ≤ self_normalized_energy
              (z (a.succAbove (q i))) (V i.succ)}
        let inducedPerm (p : S) : Equiv.Perm (Fin k) :=
          (finSuccAboveEquiv (Fin.last k)).trans
            ((p.1.subtypeEquiv (fun x => by
              constructor
              · intro hx heq
                apply hx
                apply p.1.injective
                rw [heq, p.2.2]
              · intro hx heq
                apply hx
                rw [heq, p.2.2])).trans
              (finSuccAboveEquiv a).symm)
        have hinduced_apply (p : S) (i : Fin k) :
            a.succAbove (inducedPerm p i) = p.1 i.castSucc := by
          dsimp only [inducedPerm, Equiv.trans_apply,
            Equiv.subtypeEquiv_apply, finSuccAboveEquiv_apply]
          rw [← Fin.succAbove_last_apply]
          exact congrArg Subtype.val
            ((finSuccAboveEquiv a).apply_symm_apply _)
        let induced (p : S) : T := ⟨inducedPerm p, by
          rcases p.2.1 with ⟨U, hU, hlev⟩
          let V : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ :=
            fun m => U m.castSucc
          refine ⟨V, ?_, ?_⟩
          · intro m
            convert hU m.castSucc using 1
            rw [Fin.sum_univ_castSucc]
            simp only [Fin.val_castSucc, Fin.val_last]
            rw [if_neg (by omega)]
            simp only [add_zero]
            apply Finset.sum_congr rfl
            intro i hi
            rw [hinduced_apply]
            by_cases h : i.val < m.val <;> simp [h]
          · intro i
            simpa [V, hinduced_apply] using hlev i.castSucc⟩
        have hinj : Function.Injective induced := by
          intro p q hpq
          apply Subtype.ext
          apply Equiv.ext
          intro x
          refine Fin.lastCases ?_ (fun i => ?_) x
          · exact p.2.2.trans q.2.2.symm
          · have hperm : inducedPerm p = inducedPerm q :=
              congrArg Subtype.val hpq
            have h := congrArg
              (fun e : Equiv.Perm (Fin k) => a.succAbove (e i)) hperm
            simpa only [hinduced_apply] using h
        have hc := Fintype.card_le_of_injective induced hinj
        calc
          (Fiber a).ncard = Fintype.card S :=
            (Set.fintypeCard_eq_ncard (s := Fiber a)).symm
          _ ≤ Fintype.card T := hc
          _ = T.ncard := Set.fintypeCard_eq_ncard (s := T)
      have hbad :
          Bad.ncard ≤ ∑ a ∈ C, (Fiber a).ncard := by
        exact (Set.ncard_le_ncard hlast).trans
          (Finset.set_ncard_biUnion_le C Fiber)
      have hbreal : 0 ≤ (d : ℝ) / r := div_nonneg (Nat.cast_nonneg _) hr.le
      have hfiber_real (a : Fin (k + 1)) :
          ((Fiber a).ncard : ℝ) ≤ ((d : ℝ) / r) ^ k := by
        calc
          ((Fiber a).ncard : ℝ) ≤
              (Set.ncard {q : Equiv.Perm (Fin k) |
                ∃ V : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
                  (∀ m, is_moore_penrose_inverse
                    (∑ i, if i.val < m.val then
                      Matrix.vecMulVec (z (a.succAbove (q i)))
                        (z (a.succAbove (q i))) else 0) (V m)) ∧
                  ∀ i, r ≤ self_normalized_energy
                    (z (a.succAbove (q i))) (V i.succ)} : ℝ) := by
            exact_mod_cast hfiber a
          _ ≤ ((d : ℝ) / r) ^ k :=
            ih (fun i => z (a.succAbove i))
      change (Bad.ncard : ℝ) ≤ ((d : ℝ) / r) ^ (k + 1)
      rw [pow_succ]
      calc
        (Bad.ncard : ℝ) ≤ ∑ a ∈ C, ((Fiber a).ncard : ℝ) := by
          exact_mod_cast hbad
        _ ≤ ∑ _a ∈ C, ((d : ℝ) / r) ^ k :=
          Finset.sum_le_sum fun a ha => hfiber_real a
        _ = (C.card : ℝ) * ((d : ℝ) / r) ^ k := by simp
        _ ≤ ((d : ℝ) / r) * ((d : ℝ) / r) ^ k :=
          mul_le_mul_of_nonneg_right hCcard (pow_nonneg hbreal k)
        _ = ((d : ℝ) / r) ^ k * ((d : ℝ) / r) := mul_comm _ _

@[blueprint "lem:iid-bad-tuple-measure-bound-local"
  (statement := /-- Let (\rho) be a permutation-invariant probability
  measure on ((\mathbb R^d)^k).  For (r>0), the probability that all
  inclusive-prefix self-normalized energies of the ordered tuple are at
  least (r) is at most
  ((d/r)^k/k!). -/)
  (proof := /-- Use \cref{lem:measurable-gram-moore-penrose} on tuple
  space to choose a measurable family of prefix Moore--Penrose
  inverses.  \cref{lem:local-moore-penrose-inverse-unique} makes the
  resulting measurable bad event
  equivalent to the intrinsic event.  Its permutation-orbit count is
  bounded by \cref{lem:iid-bad-permutation-count-local}; applying
  \cref{lem:finite-permutation-orbit-measure-bound} and cancelling
  (k!) yields the assertion. -/)
  (title := /-- Measure bound for a bad invariant tuple -/)
  (latexEnv := "lemma")]
lemma iid_bad_tuple_measure_bound_local
    (k d : ℕ) (ρ : MeasureTheory.Measure (Fin k → Fin d → ℝ))
    [MeasureTheory.IsProbabilityMeasure ρ]
    (r : ℝ) (hr : 0 < r)
    (hinv : ∀ π : Equiv.Perm (Fin k),
      MeasureTheory.Measure.map
        (fun z : Fin k → Fin d → ℝ => fun i => z (π i)) ρ = ρ) :
    ρ {z | ∃ U : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
        (∀ m, is_moore_penrose_inverse
          (∑ i, if i.val < m.val then
            Matrix.vecMulVec (z i) (z i) else 0) (U m)) ∧
        ∀ i, r ≤ self_normalized_energy (z i) (U i.succ)} ≤
        ENNReal.ofReal (((d : ℝ) / r) ^ k / (Nat.factorial k : ℝ)) := by
  classical
  let X : Fin k → (Fin k → Fin d → ℝ) → Fin d → ℝ := fun i z => z i
  let ℱ : MeasureTheory.Filtration ℕ
      (inferInstance : MeasurableSpace (Fin k → Fin d → ℝ)) := ⊤
  have hX : predictable_covariates ℱ X := by
    intro i
    change Measurable (fun z : Fin k → Fin d → ℝ => z i)
    fun_prop
  obtain ⟨U, hU, hUzero, hUsucc⟩ :=
    measurable_gram_moore_penrose ℱ X hX
  let E : Set (Fin k → Fin d → ℝ) :=
    {z | ∀ i, r ≤ self_normalized_energy (z i) (U i.succ z)}
  have henergy (i : Fin k) :
      Measurable (fun z : Fin k → Fin d → ℝ =>
        self_normalized_energy (z i) (U i.succ z)) := by
    change Measurable (fun z : Fin k → Fin d → ℝ =>
      ∑ a, z i a * ∑ b, U i.succ z a b * z i b)
    apply Finset.measurable_sum
    intro a ha
    apply ((measurable_pi_apply i).eval (a := a)).mul
    apply Finset.measurable_sum
    intro b hb
    exact (hUsucc i a b).mul
      ((measurable_pi_apply i).eval (a := b))
  have hE : MeasurableSet E := by
    dsimp [E]
    simpa only [Set.setOf_forall] using
      (MeasurableSet.iInter fun i =>
        measurableSet_le measurable_const (henergy i))
  have hprefix (m : Fin (k + 1)) (z : Fin k → Fin d → ℝ) :
      is_moore_penrose_inverse
        (∑ i, if i.val < m.val then
          Matrix.vecMulVec (z i) (z i) else 0) (U m z) := by
    simpa [X, partial_empirical_gram] using hU m z
  have hset :
      {z : Fin k → Fin d → ℝ |
        ∃ V : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
          (∀ m, is_moore_penrose_inverse
            (∑ i, if i.val < m.val then
              Matrix.vecMulVec (z i) (z i) else 0) (V m)) ∧
          ∀ i, r ≤ self_normalized_energy (z i) (V i.succ)} = E := by
    ext z
    constructor
    · rintro ⟨V, hV, hlev⟩
      intro i
      rw [← local_moore_penrose_inverse_unique (hV i.succ)
        (hprefix i.succ z)]
      exact hlev i
    · intro hlev
      exact ⟨fun m => U m z, fun m => hprefix m z, hlev⟩
  let q : ℝ := ((d : ℝ) / r) ^ k / (Nat.factorial k : ℝ)
  have hq : 0 ≤ q := by
    dsimp [q]
    positivity
  have hcount (z : Fin k → Fin d → ℝ) :
      (Set.ncard {π : Equiv.Perm (Fin k) |
        (fun i => z (π i)) ∈ E} : ℝ) ≤
          q * (Nat.factorial k : ℝ) := by
    have hsub :
        {π : Equiv.Perm (Fin k) | (fun i => z (π i)) ∈ E} ⊆
          {π : Equiv.Perm (Fin k) |
            ∃ V : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
              (∀ m, is_moore_penrose_inverse
                (∑ i, if i.val < m.val then
                  Matrix.vecMulVec (z (π i)) (z (π i)) else 0) (V m)) ∧
              ∀ i, r ≤ self_normalized_energy (z (π i)) (V i.succ)} := by
      intro π hπ
      rw [← hset] at hπ
      exact hπ
    calc
      (Set.ncard {π : Equiv.Perm (Fin k) |
          (fun i => z (π i)) ∈ E} : ℝ) ≤
          (Set.ncard {π : Equiv.Perm (Fin k) |
            ∃ V : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
              (∀ m, is_moore_penrose_inverse
                (∑ i, if i.val < m.val then
                  Matrix.vecMulVec (z (π i)) (z (π i)) else 0) (V m)) ∧
              ∀ i, r ≤ self_normalized_energy
                (z (π i)) (V i.succ)} : ℝ) := by
        exact_mod_cast Set.ncard_le_ncard hsub
      _ ≤ ((d : ℝ) / r) ^ k :=
        iid_bad_permutation_count_local z r hr
      _ = q * (Nat.factorial k : ℝ) := by
        dsimp [q]
        field_simp
  rw [hset]
  exact finite_permutation_orbit_measure_bound k (Fin d → ℝ) ρ E q
    hE hq hinv hcount

@[blueprint "lem:iid-bad-tuple-measurable-local"
  (statement := /-- For every finite tuple dimension and real threshold,
  the intrinsic event that all inclusive-prefix self-normalized energies
  exceed the threshold is measurable. -/)
  (proof := /-- Apply \cref{lem:measurable-gram-moore-penrose} on tuple
  space to select measurable Moore--Penrose inverses for every prefix.
  The resulting finite intersection of energy inequalities is measurable,
  and \cref{lem:local-moore-penrose-inverse-unique} identifies it with
  the intrinsic existential event. -/)
  (title := /-- Measurability of the intrinsic bad-tuple event -/)
  (latexEnv := "lemma")]
lemma iid_bad_tuple_measurable_local (k d : ℕ) (r : ℝ) :
    MeasurableSet {z : Fin k → Fin d → ℝ |
      ∃ U : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
        (∀ m, is_moore_penrose_inverse
          (∑ i, if i.val < m.val then
            Matrix.vecMulVec (z i) (z i) else 0) (U m)) ∧
        ∀ i, r ≤ self_normalized_energy (z i) (U i.succ)} := by
  classical
  let X : Fin k → (Fin k → Fin d → ℝ) → Fin d → ℝ := fun i z => z i
  let ℱ : MeasureTheory.Filtration ℕ
      (inferInstance : MeasurableSpace (Fin k → Fin d → ℝ)) := ⊤
  have hX : predictable_covariates ℱ X := by
    intro i
    change Measurable (fun z : Fin k → Fin d → ℝ => z i)
    fun_prop
  obtain ⟨U, hU, _hUzero, hUsucc⟩ :=
    measurable_gram_moore_penrose ℱ X hX
  let E : Set (Fin k → Fin d → ℝ) :=
    {z | ∀ i, r ≤ self_normalized_energy (z i) (U i.succ z)}
  have henergy (i : Fin k) :
      Measurable (fun z : Fin k → Fin d → ℝ =>
        self_normalized_energy (z i) (U i.succ z)) := by
    change Measurable (fun z : Fin k → Fin d → ℝ =>
      ∑ a, z i a * ∑ b, U i.succ z a b * z i b)
    apply Finset.measurable_sum
    intro a ha
    apply ((measurable_pi_apply i).eval (a := a)).mul
    apply Finset.measurable_sum
    intro b hb
    exact (hUsucc i a b).mul ((measurable_pi_apply i).eval (a := b))
  have hE : MeasurableSet E := by
    dsimp [E]
    simpa only [Set.setOf_forall] using
      (MeasurableSet.iInter fun i =>
        measurableSet_le measurable_const (henergy i))
  have hprefix (m : Fin (k + 1)) (z : Fin k → Fin d → ℝ) :
      is_moore_penrose_inverse
        (∑ i, if i.val < m.val then
          Matrix.vecMulVec (z i) (z i) else 0) (U m z) := by
    simpa [X, partial_empirical_gram] using hU m z
  have hset :
      {z : Fin k → Fin d → ℝ |
        ∃ V : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
          (∀ m, is_moore_penrose_inverse
            (∑ i, if i.val < m.val then
              Matrix.vecMulVec (z i) (z i) else 0) (V m)) ∧
          ∀ i, r ≤ self_normalized_energy (z i) (V i.succ)} = E := by
    ext z
    constructor
    · rintro ⟨V, hV, hlev⟩
      intro i
      rw [← local_moore_penrose_inverse_unique (hV i.succ)
        (hprefix i.succ z)]
      exact hlev i
    · intro hlev
      exact ⟨fun m => U m z, fun m => hprefix m z, hlev⟩
  rw [hset]
  exact hE

@[blueprint "lem:iid-bad-selected-tuple-bound-local"
  (statement := /-- Every injectively selected length-(k) tuple from a
  measurable iid family has probability at most ((d/r)^k/k!) of being
  bad at all inclusive prefixes. -/)
  (proof := /-- The selected family remains measurable, independent,
  and identically distributed.  By
  \cref{lem:iid-tuple-permutation-invariant}, its joint pushforward is
  permutation invariant.  Apply
  \cref{lem:iid-bad-tuple-measure-bound-local} to that pushforward and
  use \cref{lem:iid-bad-tuple-measurable-local} with the measurable-map
  formula. -/)
  (title := /-- Bad-prefix bound for a selected iid tuple -/)
  (latexEnv := "lemma")]
lemma iid_bad_selected_tuple_bound_local
    (n k d : ℕ) (Ω : Type*) [MeasurableSpace Ω]
    (ν : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure ν]
    (Z : Fin n → Ω → Fin d → ℝ)
    (hZ : ∀ i, Measurable (Z i))
    (hi : ProbabilityTheory.iIndepFun Z ν)
    (hcommon : ∀ i j, MeasureTheory.Measure.map (Z i) ν =
      MeasureTheory.Measure.map (Z j) ν)
    (φ : Fin k → Fin n) (hφ : Function.Injective φ)
    (r : ℝ) (hr : 0 < r) :
    ν {ω | ∃ U : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
        (∀ m, is_moore_penrose_inverse
          (∑ i, if i.val < m.val then
            Matrix.vecMulVec (Z (φ i) ω) (Z (φ i) ω) else 0) (U m)) ∧
        ∀ i, r ≤ self_normalized_energy (Z (φ i) ω) (U i.succ)} ≤
        ENNReal.ofReal (((d : ℝ) / r) ^ k / (Nat.factorial k : ℝ)) := by
  let W : Fin k → Ω → Fin d → ℝ := fun i => Z (φ i)
  have hW : Measurable (fun ω i => W i ω) := by
    rw [measurable_pi_iff]
    exact fun i => hZ (φ i)
  let ρ := MeasureTheory.Measure.map (fun ω i => W i ω) ν
  letI : MeasureTheory.IsProbabilityMeasure ρ :=
    MeasureTheory.Measure.isProbabilityMeasure_map hW.aemeasurable
  have hWind : ProbabilityTheory.iIndepFun W ν := hi.precomp hφ
  have hWcommon : ∀ i j, MeasureTheory.Measure.map (W i) ν =
      MeasureTheory.Measure.map (W j) ν := fun i j => hcommon (φ i) (φ j)
  have hinv (π : Equiv.Perm (Fin k)) :
      MeasureTheory.Measure.map
        (fun z : Fin k → Fin d → ℝ => fun i => z (π i)) ρ = ρ := by
    have hp := iid_tuple_permutation_invariant k Ω (Fin d → ℝ) ν W π
      (fun i => hZ (φ i)) hWind hWcommon
    have hact : Measurable
        (fun z : Fin k → Fin d → ℝ => fun i => z (π i)) := by
      fun_prop
    dsimp only [ρ]
    rw [MeasureTheory.Measure.map_map hact hW]
    rw [show ((fun z : Fin k → Fin d → ℝ => fun i => z (π i)) ∘
      (fun ω => fun i => W i ω)) = (fun ω => fun i => W (π i) ω) by rfl]
    exact hp
  have hbound := iid_bad_tuple_measure_bound_local k d ρ r hr hinv
  have hbad := iid_bad_tuple_measurable_local k d r
  have hpre : {ω | ∃ U : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
      (∀ m, is_moore_penrose_inverse
        (∑ i, if i.val < m.val then
          Matrix.vecMulVec (Z (φ i) ω) (Z (φ i) ω) else 0) (U m)) ∧
      ∀ i, r ≤ self_normalized_energy (Z (φ i) ω) (U i.succ)} =
      (fun ω i => W i ω) ⁻¹'
        {z | ∃ U : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
          (∀ m, is_moore_penrose_inverse
            (∑ i, if i.val < m.val then
              Matrix.vecMulVec (z i) (z i) else 0) (U m)) ∧
          ∀ i, r ≤ self_normalized_energy (z i) (U i.succ)} := by rfl
  rw [hpre, ← MeasureTheory.Measure.map_apply hW hbad]
  exact hbound

@[blueprint "lem:iid-bad-selected-tuple-measurable-local"
  (statement := /-- The bad-inclusive-prefix event for every injectively
  selected finite tuple from a measurable family is measurable. -/)
  (proof := /-- By \cref{lem:iid-bad-tuple-measurable-local}, the
  intrinsic bad-tuple event is measurable.  The selected event is its
  preimage under the measurable tuple map. -/)
  (title := /-- Measurability of a selected bad tuple -/)
  (latexEnv := "lemma")]
lemma iid_bad_selected_tuple_measurable_local
    (n k d : ℕ) (Ω : Type*) [MeasurableSpace Ω]
    (Z : Fin n → Ω → Fin d → ℝ)
    (hZ : ∀ i, Measurable (Z i))
    (φ : Fin k → Fin n) (r : ℝ) :
    MeasurableSet {ω | ∃ U : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
      (∀ m, is_moore_penrose_inverse
        (∑ i, if i.val < m.val then
          Matrix.vecMulVec (Z (φ i) ω) (Z (φ i) ω) else 0) (U m)) ∧
      ∀ i, r ≤ self_normalized_energy (Z (φ i) ω) (U i.succ)} := by
  let W : Fin k → Ω → Fin d → ℝ := fun i => Z (φ i)
  have hW : Measurable (fun ω i => W i ω) := by
    rw [measurable_pi_iff]
    exact fun i => hZ (φ i)
  have hbad := iid_bad_tuple_measurable_local k d r
  have hpre : {ω | ∃ U : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
      (∀ m, is_moore_penrose_inverse
        (∑ i, if i.val < m.val then
          Matrix.vecMulVec (Z (φ i) ω) (Z (φ i) ω) else 0) (U m)) ∧
      ∀ i, r ≤ self_normalized_energy (Z (φ i) ω) (U i.succ)} =
      (fun ω i => W i ω) ⁻¹'
        {z | ∃ U : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
          (∀ m, is_moore_penrose_inverse
            (∑ i, if i.val < m.val then
              Matrix.vecMulVec (z i) (z i) else 0) (U m)) ∧
          ∀ i, r ≤ self_normalized_energy (z i) (U i.succ)} := by rfl
  rw [hpre]
  exact hbad.preimage hW

@[blueprint "lem:iid-strict-mono-card-local"
  (statement := /-- The number of strictly increasing maps from
  (\operatorname{Fin}(k)) to (\operatorname{Fin}(n)) is
  (\binom nk). -/)
  (proof := /-- Send a strictly increasing map to its range.  This is
  a (k)-element subset.  Conversely, enumerate every (k)-element subset
  increasingly.  Equality of ranges determines a strictly increasing
  map, so these constructions are inverse. -/)
  (title := /-- Count of finite increasing embeddings -/)
  (latexEnv := "lemma")]
lemma iid_strict_mono_card_local (n k : ℕ) :
    Fintype.card {φ : Fin k → Fin n // StrictMono φ} = Nat.choose n k := by
  classical
  let toSubset : {φ : Fin k → Fin n // StrictMono φ} →
      Set.powersetCard (Fin n) k := fun φ =>
    ⟨Finset.univ.image φ.1, by
      change (Finset.univ.image φ.1).card = k
      rw [Finset.card_image_of_injective _ φ.2.injective]
      simp⟩
  let fromSubset : Set.powersetCard (Fin n) k → Fin k → Fin n :=
    fun s i => s.1.orderEmbOfFin s.2 i
  have hfrom (s : Set.powersetCard (Fin n) k) :
      StrictMono (fromSubset s) :=
    (s.1.orderEmbOfFin s.2).strictMono
  let e : {φ : Fin k → Fin n // StrictMono φ} ≃
      Set.powersetCard (Fin n) k :=
    { toFun := toSubset
      invFun := fun s => ⟨fromSubset s, hfrom s⟩
      left_inv := by
        intro φ
        apply Subtype.ext
        symm
        apply (φ.2.range_inj (hfrom (toSubset φ))).mp
        ext x
        simp [toSubset, fromSubset, Finset.range_orderEmbOfFin]
      right_inv := by
        intro s
        apply Subtype.ext
        ext x
        simp [toSubset, fromSubset, Finset.range_orderEmbOfFin] }
  rw [Fintype.card_congr e]
  simpa using (Set.powersetCard.card (α := Fin n) (n := k))

@[blueprint "lem:iid-binomial-factorial-tail-local"
  (statement := /-- There is a numerical constant (100) such that, if
  (m>100(\sqrt{nd/r}+\log(1/\eta))), then
  [ \binom nm\frac{(d/r)^m}{m!}\leq\eta. ] -/)
  (proof := /-- Use the bounds
  (\binom nm\leq n^m/m!) and Stirling's lower bound
  (m!\geq(m/e)^m).  Since (e<3), the hypothesis makes the resulting
  ratio at most ((1/4)^m).  Finally,
  ((1/4)^m\leq e^{-m}\leq\eta) follows from
  (m>\log(1/\eta)). -/)
  (title := /-- Binomial-factorial square-root tail estimate -/)
  (latexEnv := "lemma")]
lemma iid_binomial_factorial_tail_local
    (n d m : ℕ) (r η : ℝ)
    (hn : 0 < n) (hd : 0 < d) (hr : 0 < r) (hr1 : r ≤ 1)
    (hη : 0 < η) (hη1 : η < 1)
    (hm : 100 * (Real.sqrt ((n : ℝ) * (d : ℝ) / r) +
      Real.log (1 / η)) < (m : ℝ)) :
    (Nat.choose n m : ℝ) *
        (((d : ℝ) / r) ^ m / (Nat.factorial m : ℝ)) ≤ η := by
  have ha : 0 < (n : ℝ) * (d : ℝ) / r := by positivity
  have hsqrt : 0 < Real.sqrt ((n : ℝ) * (d : ℝ) / r) :=
    Real.sqrt_pos.2 ha
  have hlog : 0 < Real.log (1 / η) := by
    apply Real.log_pos
    rw [one_div]
    exact (one_lt_inv₀ hη).2 hη1
  have hmpos : 0 < m := by
    have : 0 < (m : ℝ) := lt_trans (by positivity) hm
    exact_mod_cast this
  have hchoose :
      (Nat.choose n m : ℝ) ≤ (n : ℝ) ^ m / (Nat.factorial m : ℝ) :=
    Nat.choose_le_pow_div m n
  have hsqrtfac : 1 ≤ Real.sqrt (2 * Real.pi * (m : ℝ)) := by
    have hpi := Real.pi_gt_three
    have hmreal : (1 : ℝ) ≤ m := by exact_mod_cast hmpos
    have hnonneg : 0 ≤ 2 * Real.pi * (m : ℝ) := by positivity
    have hs := Real.sq_sqrt hnonneg
    nlinarith [Real.sqrt_nonneg (2 * Real.pi * (m : ℝ))]
  have hfact :
      ((m : ℝ) / Real.exp 1) ^ m ≤ (Nat.factorial m : ℝ) := by
    have hst := Stirling.le_factorial_stirling m
    have hp : 0 ≤ ((m : ℝ) / Real.exp 1) ^ m := by positivity
    nlinarith
  have he : Real.exp 1 < 3 := Real.exp_one_lt_three
  let A : ℝ := (n : ℝ) * (d : ℝ) / r
  have hA : 0 < A := ha
  have hmroot : 100 * Real.sqrt A < (m : ℝ) := by
    dsimp [A]
    nlinarith
  have hbase :
      A * (Real.exp 1) ^ 2 / (m : ℝ) ^ 2 ≤ (1 / 4 : ℝ) := by
    have hs := Real.sq_sqrt hA.le
    have hsq : 10000 * A < (m : ℝ) ^ 2 := by nlinarith
    have hm2 : 0 < (m : ℝ) ^ 2 := by positivity
    have he2 : (Real.exp 1) ^ 2 < 9 := by
      nlinarith [Real.exp_pos 1]
    have hAe : A * (Real.exp 1) ^ 2 < 9 * A :=
      by simpa [mul_comm] using mul_lt_mul_of_pos_left he2 hA
    apply (div_le_iff₀ hm2).2
    nlinarith
  have hmain :
      (Nat.choose n m : ℝ) *
          (((d : ℝ) / r) ^ m / (Nat.factorial m : ℝ)) ≤
        (A * (Real.exp 1) ^ 2 / (m : ℝ) ^ 2) ^ m := by
    have hfacpos : 0 < (Nat.factorial m : ℝ) := by positivity
    have hlowpos : 0 < ((m : ℝ) / Real.exp 1) ^ m := by positivity
    calc
      (Nat.choose n m : ℝ) *
          (((d : ℝ) / r) ^ m / (Nat.factorial m : ℝ)) ≤
          ((n : ℝ) ^ m / (Nat.factorial m : ℝ)) *
            (((d : ℝ) / r) ^ m / (Nat.factorial m : ℝ)) := by
        gcongr
      _ = A ^ m / ((Nat.factorial m : ℝ) ^ 2) := by
        dsimp [A]
        rw [div_pow]
        ring
      _ ≤ A ^ m / (((m : ℝ) / Real.exp 1) ^ m) ^ 2 := by
        gcongr
      _ = (A * (Real.exp 1) ^ 2 / (m : ℝ) ^ 2) ^ m := by
        have hden :
            ((((m : ℝ) / Real.exp 1) ^ m) ^ 2) =
              ((((m : ℝ) / Real.exp 1) ^ 2) ^ m) := by
          rw [← pow_mul, ← pow_mul]
          congr 1
          omega
        rw [hden, ← div_pow]
        congr 1
        field_simp
  have hquarter :
      (A * (Real.exp 1) ^ 2 / (m : ℝ) ^ 2) ^ m ≤
        (1 / 4 : ℝ) ^ m := by
    exact pow_le_pow_left₀ (by positivity) hbase m
  have hqexp : (1 / 4 : ℝ) ^ m ≤ Real.exp (-(m : ℝ)) := by
    have h14 : (1 / 4 : ℝ) ≤ Real.exp (-1) := by
      linarith [Real.exp_neg_one_gt_d9]
    calc
      (1 / 4 : ℝ) ^ m ≤ (Real.exp (-1)) ^ m :=
        pow_le_pow_left₀ (by positivity) h14 m
      _ = Real.exp (-(m : ℝ)) := by
        rw [← Real.exp_nat_mul]
        congr 1
        ring
  have hm_log : Real.log (1 / η) < (m : ℝ) := by
    nlinarith
  have hexpη : Real.exp (-(m : ℝ)) ≤ η := by
    have := Real.exp_monotone (neg_le_neg (le_of_lt hm_log))
    calc
      Real.exp (-(m : ℝ)) ≤ Real.exp (-Real.log (1 / η)) := this
      _ = η := by
        rw [Real.exp_neg, Real.exp_log (by positivity)]
        field_simp
  exact hmain.trans (hquarter.trans (hqexp.trans hexpη))

@[blueprint "lem:iid-bad-subsequence-tail"
  (statement := /-- There exists a universal constant (B>0) with the
  following property.  Let (n,d) be positive integers, let
  ((\Omega,\mathcal F,\nu)) be a probability space, let (\mu_0) be a
  probability measure on (\mathbb R^d), and let
  (Z_i:\Omega\to\mathbb R^d), (i\in\operatorname{Fin}(n)), be a
  measurable independent family such that every (Z_i) has law
  (\mu_0).  Fix (0<r\leq1) and (0<\eta<1).  Then, with
  (\nu)-probability at least (1-\eta), the following holds
  simultaneously for every (k\in\mathbb N), every strictly increasing
  map (\phi:\operatorname{Fin}(k)\to\operatorname{Fin}(n)), and every
  family ((U_m)_{m\in\operatorname{Fin}(k+1)}) such that (U_m) is a
  Moore--Penrose inverse of
  [
    \sum_{i<m}Z_{\phi(i)}Z_{\phi(i)}^{\mathsf T}
  ]
  for every (m): if
  [
    Z_{\phi(i)}^{\mathsf T}U_{i+1}Z_{\phi(i)}\geq r
    \qquad\text{for every }i\in\operatorname{Fin}(k),
  ]
  then
  [
    k\leq B\left(\sqrt{nd/r}+\log(1/\eta)\right).
  ] -/)
  (proof := /-- Take (B=100), put
  (x=\sqrt{nd/r}+\log(1/\eta)), and set
  (m=\lfloor100x\rfloor+1).  For every strictly increasing length-(m)
  selection, \cref{lem:iid-bad-selected-tuple-measurable-local} makes
  its bad-prefix event measurable and
  \cref{lem:iid-bad-selected-tuple-bound-local} bounds its probability
  by ((d/r)^m/m!).  A union bound, together with
  \cref{lem:iid-strict-mono-card-local}, therefore bounds the union of
  all such events by
  [
    \binom nm\frac{(d/r)^m}{m!}.
  ]
  This is at most (\eta) by
  \cref{lem:iid-binomial-factorial-tail-local}.  Hence the complement
  has probability at least (1-\eta).

  On that complement, suppose a bad increasing subsequence has length
  (k>100x).  The definition of (m) gives (m\leq k).  Restricting the
  increasing map and every prefix inverse to the first (m) positions
  produces one of the excluded length-(m) bad events, a contradiction.
  Thus every bad subsequence has (k\leq100x), as required. -/)
  (title := /-- Tail bound for iid high-leverage subsequences -/)
  (latexEnv := "lemma")]
lemma iid_bad_subsequence_tail :
    ∃ B : ℝ, 0 < B ∧
      ∀ (n d : ℕ) (Ω : Type*) [mΩ : MeasurableSpace Ω]
        (ν : MeasureTheory.Measure Ω)
        [MeasureTheory.IsProbabilityMeasure ν]
        (Z : Fin n → Ω → Fin d → ℝ)
        (μ0 : MeasureTheory.Measure (Fin d → ℝ))
        [MeasureTheory.IsProbabilityMeasure μ0]
        (r η : ℝ),
        0 < n → 0 < d → 0 < r → r ≤ 1 → 0 < η → η < 1 →
        (∀ i, Measurable (Z i)) →
        ProbabilityTheory.iIndepFun Z ν →
        (∀ i, MeasureTheory.Measure.map (Z i) ν = μ0) →
        ν {ω | ∀ (k : ℕ) (φ : Fin k → Fin n), StrictMono φ →
          ∀ U : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
            (∀ m, is_moore_penrose_inverse
              (∑ i, if i.val < m.val then
                Matrix.vecMulVec (Z (φ i) ω) (Z (φ i) ω) else 0)
              (U m)) →
            (∀ i, r ≤ self_normalized_energy (Z (φ i) ω) (U i.succ)) →
            (k : ℝ) ≤ B * (Real.sqrt ((n : ℝ) * (d : ℝ) / r) +
              Real.log (1 / η))} ≥ ENNReal.ofReal (1 - η) := by
  refine ⟨100, by norm_num, ?_⟩
  intro n d Ω mΩ ν hν Z μ0 hμ0 r η hn hd hr hr1 hη hη1 hZ hi hmap
  have hcommon : ∀ i j, MeasureTheory.Measure.map (Z i) ν =
      MeasureTheory.Measure.map (Z j) ν := fun i j => (hmap i).trans (hmap j).symm
  let x : ℝ := Real.sqrt ((n : ℝ) * (d : ℝ) / r) + Real.log (1 / η)
  have hxpos : 0 < x := by
    dsimp [x]
    have hsqrt : 0 < Real.sqrt ((n : ℝ) * (d : ℝ) / r) := by
      apply Real.sqrt_pos.2
      positivity
    have hlog : 0 < Real.log (1 / η) := by
      apply Real.log_pos
      rw [one_div]
      exact (one_lt_inv₀ hη).2 hη1
    positivity
  let m : ℕ := ⌊100 * x⌋₊ + 1
  have hmgt : 100 * x < (m : ℝ) := by
    simpa only [m, Nat.cast_add, Nat.cast_one] using
      (Nat.lt_floor_add_one (R := ℝ) (a := 100 * x))
  let Φ : Type := {φ : Fin m → Fin n // StrictMono φ}
  let Bad : Φ → Set Ω := fun φ =>
    {ω | ∃ U : Fin (m + 1) → Matrix (Fin d) (Fin d) ℝ,
      (∀ q, is_moore_penrose_inverse
        (∑ i, if i.val < q.val then
          Matrix.vecMulVec (Z (φ.1 i) ω) (Z (φ.1 i) ω) else 0) (U q)) ∧
      ∀ i, r ≤ self_normalized_energy (Z (φ.1 i) ω) (U i.succ)}
  have hBad (φ : Φ) : MeasurableSet (Bad φ) ∧
      ν (Bad φ) ≤ ENNReal.ofReal
        (((d : ℝ) / r) ^ m / (Nat.factorial m : ℝ)) := by
    dsimp only [Bad]
    constructor
    · exact iid_bad_selected_tuple_measurable_local n m d Ω Z hZ φ.1 r
    · exact iid_bad_selected_tuple_bound_local n m d Ω ν Z hZ hi hcommon
        φ.1 φ.2.injective r hr
  let E : Set Ω := ⋃ φ : Φ, Bad φ
  have hEmeas : MeasurableSet E := by
    dsimp only [E]
    exact MeasurableSet.iUnion fun φ => (hBad φ).1
  have htail : (Nat.choose n m : ℝ) *
      (((d : ℝ) / r) ^ m / (Nat.factorial m : ℝ)) ≤ η :=
    iid_binomial_factorial_tail_local n d m r η hn hd hr hr1 hη hη1 hmgt
  have hEbound : ν E ≤ ENNReal.ofReal η := by
    calc
      ν E ≤ ∑' φ : Φ, ν (Bad φ) := by
        dsimp only [E]
        simpa only using (MeasureTheory.measure_iUnion_le (μ := ν) Bad)
      _ ≤ ∑' _φ : Φ, ENNReal.ofReal
          (((d : ℝ) / r) ^ m / (Nat.factorial m : ℝ)) :=
        ENNReal.tsum_le_tsum fun φ => (hBad φ).2
      _ = ENNReal.ofReal ((Fintype.card Φ : ℝ) *
          (((d : ℝ) / r) ^ m / (Nat.factorial m : ℝ))) := by
        rw [tsum_fintype]
        simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
        rw [ENNReal.ofReal_mul (by positivity)]
        simp
      _ = ENNReal.ofReal ((Nat.choose n m : ℝ) *
          (((d : ℝ) / r) ^ m / (Nat.factorial m : ℝ))) := by
        rw [show Fintype.card Φ = Nat.choose n m by
          exact iid_strict_mono_card_local n m]
      _ ≤ ENNReal.ofReal η := ENNReal.ofReal_le_ofReal htail
  have hsubset : Eᶜ ⊆ {ω | ∀ (k : ℕ) (φ : Fin k → Fin n), StrictMono φ →
      ∀ U : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
        (∀ q, is_moore_penrose_inverse
          (∑ i, if i.val < q.val then
            Matrix.vecMulVec (Z (φ i) ω) (Z (φ i) ω) else 0) (U q)) →
        (∀ i, r ≤ self_normalized_energy (Z (φ i) ω) (U i.succ)) →
        (k : ℝ) ≤ 100 * x} := by
    intro ω hω k φ hφ U hU hlev
    by_contra hk
    have hkgt : 100 * x < (k : ℝ) := lt_of_not_ge hk
    have hfloor : (⌊100 * x⌋₊ : ℝ) ≤ 100 * x :=
      Nat.floor_le (by positivity)
    have hfloorlt : (⌊100 * x⌋₊ : ℝ) < (k : ℝ) := hfloor.trans_lt hkgt
    have hfloorlt' : ⌊100 * x⌋₊ < k := by exact_mod_cast hfloorlt
    have hmk : m ≤ k := by
      dsimp only [m]
      omega
    let ψ : Fin m → Fin k := fun i =>
      ⟨i.val, lt_of_lt_of_le i.isLt hmk⟩
    have hψ : StrictMono ψ := by
      intro i j hij
      exact hij
    let φm : Φ := ⟨fun i => φ (ψ i), hφ.comp hψ⟩
    let χ : Fin (m + 1) → Fin (k + 1) := fun q =>
      ⟨q.val, by omega⟩
    have hsum (q : Fin (m + 1)) :
        (∑ i : Fin m, if i.val < q.val then
          Matrix.vecMulVec (Z (φm.1 i) ω) (Z (φm.1 i) ω) else 0) =
        ∑ i : Fin k, if i.val < q.val then
          Matrix.vecMulVec (Z (φ i) ω) (Z (φ i) ω) else 0 := by
      rw [← Finset.sum_filter, ← Finset.sum_filter]
      refine Finset.sum_bij (fun i _hi => ψ i) ?_ ?_ ?_ ?_
      · intro i hi
        rw [Finset.mem_filter] at hi ⊢
        exact ⟨Finset.mem_univ _, hi.2⟩
      · intro i hi j hj hij
        exact hψ.injective hij
      · intro j hj
        rw [Finset.mem_filter] at hj
        let i : Fin m := ⟨j.val, by omega⟩
        refine ⟨i, ?_, ?_⟩
        · rw [Finset.mem_filter]
          exact ⟨Finset.mem_univ _, hj.2⟩
        · apply Fin.ext
          rfl
      · intro i hi
        rfl
    have hmemBad : ω ∈ Bad φm := by
      refine ⟨fun q => U (χ q), ?_, ?_⟩
      · intro q
        have hq := hU (χ q)
        convert hq using 1
        simpa only [χ] using hsum q
      · intro i
        change r ≤ self_normalized_energy (Z (φ (ψ i)) ω) (U (χ i.succ))
        rw [show χ i.succ = (ψ i).succ by apply Fin.ext; rfl]
        exact hlev (ψ i)
    have hmemE : ω ∈ E := by
      dsimp only [E]
      rw [Set.mem_iUnion]
      exact ⟨φm, hmemBad⟩
    exact hω hmemE
  have hcomp : ENNReal.ofReal (1 - η) ≤ ν Eᶜ := by
    calc
      ENNReal.ofReal (1 - η) = 1 - ENNReal.ofReal η := by
        rw [ENNReal.ofReal_sub 1 hη.le]
        simp
      _ ≤ 1 - ν E := tsub_le_tsub_left hEbound 1
      _ = ν Eᶜ := by
        rw [MeasureTheory.measure_compl hEmeas
          (MeasureTheory.measure_ne_top ν E), MeasureTheory.measure_univ]
  calc
    ENNReal.ofReal (1 - η) ≤ ν Eᶜ := hcomp
    _ ≤ ν {ω | ∀ (k : ℕ) (φ : Fin k → Fin n), StrictMono φ →
        ∀ U : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
          (∀ q, is_moore_penrose_inverse
            (∑ i, if i.val < q.val then
              Matrix.vecMulVec (Z (φ i) ω) (Z (φ i) ω) else 0) (U q)) →
          (∀ i, r ≤ self_normalized_energy (Z (φ i) ω) (U i.succ)) →
          (k : ℝ) ≤ 100 * x} := MeasureTheory.measure_mono hsubset
    _ = ν {ω | ∀ (k : ℕ) (φ : Fin k → Fin n), StrictMono φ →
        ∀ U : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
          (∀ q, is_moore_penrose_inverse
            (∑ i, if i.val < q.val then
              Matrix.vecMulVec (Z (φ i) ω) (Z (φ i) ω) else 0) (U q)) →
          (∀ i, r ≤ self_normalized_energy (Z (φ i) ω) (U i.succ)) →
          (k : ℝ) ≤ 100 * (Real.sqrt ((n : ℝ) * (d : ℝ) / r) +
            Real.log (1 / η))} := by rfl

@[blueprint "lem:dyadic-leverage-sum"
  (statement := /-- For all (T,J\in\mathbb N) and every family of real
  numbers ((q_t)_{t<T}) satisfying (0\leq q_t\leq1), one has
  [
    \sum_{t<T}q_t\leq
      \frac{T}{2^J}
      +\sum_{j=0}^{J-1}2^{-(j+1)}
        \#\{t<T:q_t\geq2^{-(j+1)}\}.
  ] -/)
  (proof := /-- We first prove by induction on (J) that every
  (x\in[0,1]) satisfies
  [
    x\leq 2^{-J}+\sum_{j=0}^{J-1}
      2^{-(j+1)}\mathbf 1_{\{x\geq2^{-(j+1)}\}}.
  ]
  For (J=0), this is the hypothesis (x\leq1).  In the induction step,
  split according as (2^{-(J+1)}\leq x).  In the first case, the new
  indicator term equals (2^{-(J+1)}), and together with the new
  residual it equals the preceding residual (2^{-J}); hence the
  induction hypothesis applies.  In the second case,
  (x<2^{-(J+1)}), while every earlier indicator term is nonnegative,
  which proves the bound directly.  Apply this scalar inequality to
  each (q_t) and sum over (t).  Interchanging the two finite sums turns
  the sum of the indicators at each level into the cardinality of the
  corresponding filtered index set, yielding the claimed inequality. -/)
  (title := /-- Dyadic layer-cake bound for leverage sums -/)
  (latexEnv := "lemma")]
lemma dyadic_leverage_sum {T J : ℕ} (q : Fin T → ℝ)
    (hq : ∀ t, 0 ≤ q t ∧ q t ≤ 1) :
    (∑ t, q t) ≤ (T : ℝ) / (2 : ℝ) ^ J +
      ∑ j : Fin J, (1 / (2 : ℝ) ^ (j.val + 1)) *
        ((Finset.univ.filter fun t : Fin T =>
          1 / (2 : ℝ) ^ (j.val + 1) ≤ q t).card : ℝ) := by
  classical
  have hscalar : ∀ n : ℕ, ∀ x : ℝ, 0 ≤ x → x ≤ 1 →
      x ≤ 1 / (2 : ℝ) ^ n +
        ∑ j : Fin n, if 1 / (2 : ℝ) ^ (j.val + 1) ≤ x then
          1 / (2 : ℝ) ^ (j.val + 1) else 0 := by
    intro n
    induction n with
    | zero =>
        intro x hx0 hx1
        simpa using hx1
    | succ n ih =>
        intro x hx0 hx1
        rw [Fin.sum_univ_castSucc]
        simp only [Fin.val_castSucc, Fin.val_last]
        by_cases h : 1 / (2 : ℝ) ^ (n + 1) ≤ x
        · rw [if_pos h]
          calc
            x ≤ 1 / (2 : ℝ) ^ n +
                ∑ j : Fin n, if 1 / (2 : ℝ) ^ (j.val + 1) ≤ x then
                  1 / (2 : ℝ) ^ (j.val + 1) else 0 := ih x hx0 hx1
            _ = 1 / (2 : ℝ) ^ (n + 1) +
                ((∑ j : Fin n, if 1 / (2 : ℝ) ^ (j.val + 1) ≤ x then
                  1 / (2 : ℝ) ^ (j.val + 1) else 0) +
                1 / (2 : ℝ) ^ (n + 1)) := by
                  rw [pow_succ]
                  ring
        · rw [if_neg h]
          have hx : x ≤ 1 / (2 : ℝ) ^ (n + 1) :=
            le_of_lt (lt_of_not_ge h)
          have hs : 0 ≤
              ∑ j : Fin n, if 1 / (2 : ℝ) ^ (j.val + 1) ≤ x then
                1 / (2 : ℝ) ^ (j.val + 1) else 0 := by
            apply Finset.sum_nonneg
            intro j hj
            split <;> positivity
          linarith
  calc
    (∑ t, q t) ≤ ∑ t, (1 / (2 : ℝ) ^ J +
        ∑ j : Fin J, if 1 / (2 : ℝ) ^ (j.val + 1) ≤ q t then
          1 / (2 : ℝ) ^ (j.val + 1) else 0) := by
      apply Finset.sum_le_sum
      intro t ht
      exact hscalar J (q t) (hq t).1 (hq t).2
    _ = (T : ℝ) / (2 : ℝ) ^ J +
        ∑ j : Fin J, (1 / (2 : ℝ) ^ (j.val + 1)) *
          ((Finset.univ.filter fun t : Fin T =>
            1 / (2 : ℝ) ^ (j.val + 1) ≤ q t).card : ℝ) := by
      rw [Finset.sum_add_distrib, Finset.sum_comm]
      simp [Finset.sum_ite, mul_comm, div_eq_mul_inv]

@[blueprint "lem:iid-bad-subsequence-good-event-measurable-local"
  (statement := /-- Let (Z_0,\ldots,Z_{n-1}) be measurable
  (\mathbb R^d)-valued functions, let (B\geq0), let (r>0), and let
  (0<\eta<1).  The event on which every increasing subsequence whose
  prefix leverage scores are at least (r) has length at most
  [
    B\left(\sqrt{nd/r}+\log(1/\eta)\right)
  ]
  is measurable. -/)
  (proof := /-- Put
  (x=\sqrt{nd/r}+\log(1/\eta)) and
  (m=\lfloor Bx\rfloor+1).  For each increasing map
  (\phi:\operatorname{Fin}(m)\to\operatorname{Fin}(n)), let
  (E_\phi) be its bad-prefix event.  Each (E_\phi) is measurable by
  \cref{lem:iid-bad-selected-tuple-measurable-local}, hence so is
  (E=\bigcup_\phi E_\phi).

  The asserted event is exactly (E^c).  Indeed, a bad subsequence of
  length exceeding (Bx) restricts to its first (m) entries and
  therefore belongs to (E).  Conversely, a point of some (E_\phi)
  supplies a bad subsequence of length
  (m>Bx), contradicting the asserted universal bound. -/)
  (title := /-- Measurability of the iid subsequence good event -/)
  (latexEnv := "lemma")]
lemma iid_bad_subsequence_good_event_measurable_local
    (n d : ℕ) (Ω : Type*) [MeasurableSpace Ω]
    (Z : Fin n → Ω → Fin d → ℝ) (hZ : ∀ i, Measurable (Z i))
    (B r η : ℝ) (hB : 0 ≤ B) (hr : 0 < r) (hη : 0 < η) (hη1 : η < 1) :
    MeasurableSet {ω | ∀ (k : ℕ) (φ : Fin k → Fin n), StrictMono φ →
      ∀ U : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
        (∀ q, is_moore_penrose_inverse
          (∑ i, if i.val < q.val then
            Matrix.vecMulVec (Z (φ i) ω) (Z (φ i) ω) else 0) (U q)) →
        (∀ i, r ≤ self_normalized_energy (Z (φ i) ω) (U i.succ)) →
        (k : ℝ) ≤ B * (Real.sqrt ((n : ℝ) * (d : ℝ) / r) +
          Real.log (1 / η))} := by
  classical
  let x : ℝ := Real.sqrt ((n : ℝ) * (d : ℝ) / r) + Real.log (1 / η)
  have hx0 : 0 ≤ x := by
    dsimp [x]
    have hlog : 0 < Real.log (1 / η) := by
      apply Real.log_pos
      rw [one_div]
      exact (one_lt_inv₀ hη).2 hη1
    positivity
  let m : ℕ := ⌊B * x⌋₊ + 1
  have hmgt : B * x < (m : ℝ) := by
    simpa only [m, Nat.cast_add, Nat.cast_one] using
      (Nat.lt_floor_add_one (R := ℝ) (a := B * x))
  let Φ : Type := {φ : Fin m → Fin n // StrictMono φ}
  let Bad : Φ → Set Ω := fun φ =>
    {ω | ∃ U : Fin (m + 1) → Matrix (Fin d) (Fin d) ℝ,
      (∀ q, is_moore_penrose_inverse
        (∑ i, if i.val < q.val then
          Matrix.vecMulVec (Z (φ.1 i) ω) (Z (φ.1 i) ω) else 0) (U q)) ∧
      ∀ i, r ≤ self_normalized_energy (Z (φ.1 i) ω) (U i.succ)}
  let E : Set Ω := ⋃ φ : Φ, Bad φ
  have hE : MeasurableSet E := by
    dsimp only [E]
    apply MeasurableSet.iUnion
    intro φ
    exact iid_bad_selected_tuple_measurable_local n m d Ω Z hZ φ.1 r
  have heq : {ω | ∀ (k : ℕ) (φ : Fin k → Fin n), StrictMono φ →
      ∀ U : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
        (∀ q, is_moore_penrose_inverse
          (∑ i, if i.val < q.val then
            Matrix.vecMulVec (Z (φ i) ω) (Z (φ i) ω) else 0) (U q)) →
        (∀ i, r ≤ self_normalized_energy (Z (φ i) ω) (U i.succ)) →
        (k : ℝ) ≤ B * x} = Eᶜ := by
    ext ω
    constructor
    · intro hgood hωE
      rw [Set.mem_iUnion] at hωE
      obtain ⟨φ, U, hU, hlev⟩ := hωE
      have hbound := hgood m φ.1 φ.2 U hU hlev
      exact (not_le_of_gt hmgt) hbound
    · intro hω k φ hφ U hU hlev
      by_contra hk
      have hkgt : B * x < (k : ℝ) := lt_of_not_ge hk
      have hfloor : (⌊B * x⌋₊ : ℝ) ≤ B * x :=
        Nat.floor_le (mul_nonneg hB hx0)
      have hfloorlt : (⌊B * x⌋₊ : ℝ) < (k : ℝ) :=
        hfloor.trans_lt hkgt
      have hfloorlt' : ⌊B * x⌋₊ < k := by
        exact_mod_cast hfloorlt
      have hmk : m ≤ k := by
        dsimp only [m]
        omega
      let ψ : Fin m → Fin k := fun i =>
        ⟨i.val, lt_of_lt_of_le i.isLt hmk⟩
      have hψ : StrictMono ψ := by
        intro i j hij
        exact hij
      let φm : Φ := ⟨fun i => φ (ψ i), hφ.comp hψ⟩
      let χ : Fin (m + 1) → Fin (k + 1) := fun q =>
        ⟨q.val, by omega⟩
      have hsum (q : Fin (m + 1)) :
          (∑ i : Fin m, if i.val < q.val then
            Matrix.vecMulVec (Z (φm.1 i) ω) (Z (φm.1 i) ω) else 0) =
          ∑ i : Fin k, if i.val < q.val then
            Matrix.vecMulVec (Z (φ i) ω) (Z (φ i) ω) else 0 := by
        rw [← Finset.sum_filter, ← Finset.sum_filter]
        refine Finset.sum_bij (fun i _hi => ψ i) ?_ ?_ ?_ ?_
        · intro i hi
          rw [Finset.mem_filter] at hi ⊢
          exact ⟨Finset.mem_univ _, hi.2⟩
        · intro i hi j hj hij
          exact hψ.injective hij
        · intro j hj
          rw [Finset.mem_filter] at hj
          let i : Fin m := ⟨j.val, by omega⟩
          refine ⟨i, ?_, ?_⟩
          · rw [Finset.mem_filter]
            exact ⟨Finset.mem_univ _, hj.2⟩
          · apply Fin.ext
            rfl
        · intro i hi
          rfl
      have hmemBad : ω ∈ Bad φm := by
        refine ⟨fun q => U (χ q), ?_, ?_⟩
        · intro q
          have hq := hU (χ q)
          convert hq using 1
          simpa only [χ] using hsum q
        · intro i
          change r ≤ self_normalized_energy (Z (φ (ψ i)) ω) (U (χ i.succ))
          rw [show χ i.succ = (ψ i).succ by apply Fin.ext; rfl]
          exact hlev (ψ i)
      apply hω
      dsimp only [E]
      rw [Set.mem_iUnion]
      exact ⟨φm, hmemBad⟩
  rw [show {ω | ∀ (k : ℕ) (φ : Fin k → Fin n), StrictMono φ →
      ∀ U : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
        (∀ q, is_moore_penrose_inverse
          (∑ i, if i.val < q.val then
            Matrix.vecMulVec (Z (φ i) ω) (Z (φ i) ω) else 0) (U q)) →
        (∀ i, r ≤ self_normalized_energy (Z (φ i) ω) (U i.succ)) →
        (k : ℝ) ≤ B * (Real.sqrt ((n : ℝ) * (d : ℝ) / r) +
          Real.log (1 / η))} =
      {ω | ∀ (k : ℕ) (φ : Fin k → Fin n), StrictMono φ →
        ∀ U : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
          (∀ q, is_moore_penrose_inverse
            (∑ i, if i.val < q.val then
              Matrix.vecMulVec (Z (φ i) ω) (Z (φ i) ω) else 0) (U q)) →
          (∀ i, r ≤ self_normalized_energy (Z (φ i) ω) (U i.succ)) →
          (k : ℝ) ≤ B * x} by rfl, heq]
  exact hE.compl

@[blueprint "lem:smooth-coupling-match-event-measurable-local"
  (statement := /-- If ((\mathcal H_n^x)) is the earlier-covariate
  filtration of ((X_t)_{t<T}), then on the product of the original
  sample space with (TK) proposal vectors the event that the whole
  covariate path is an order-preserving proposal subsequence is
  measurable. -/)
  (proof := /-- The defining filtration identity makes each (X_t)
  measurable in the ambient measurable space.  For a fixed increasing
  map (\phi), all coordinate equalities
  (X_t(\omega)=z_{\phi(t)}) are therefore measurable.  The desired
  event is the finite union over (\phi) of the finite intersections
  of these equality events. -/)
  (title := /-- Measurability of the smooth coupling match event -/)
  (latexEnv := "lemma")]
lemma smooth_coupling_match_event_measurable_local
    {T d K : ℕ} {Ω : Type*} [mΩ : MeasurableSpace Ω]
    (ℋx : MeasureTheory.Filtration ℕ mΩ)
    (X : Fin T → Ω → Fin d → ℝ)
    (hℋ : covariate_history_filtration ℋx X) :
    MeasurableSet {z : Ω × (Fin (T * K) → Fin d → ℝ) |
      ∃ φ : Fin T → Fin (T * K), StrictMono φ ∧
        ∀ t, X t z.1 = z.2 (φ t)} := by
  classical
  have hX_hist (t : Fin T) :
      @Measurable Ω (Fin d → ℝ) (ℋx (t.val + 1)) inferInstance (X t) := by
    rw [hℋ (t.val + 1)]
    intro s hs
    exact MeasurableSpace.measurableSet_generateFrom
      ⟨t, Nat.lt_succ_self t.val, s, hs, rfl⟩
  have hX (t : Fin T) : Measurable (X t) :=
    (hX_hist t).mono (ℋx.le (t.val + 1)) le_rfl
  simp only [Set.setOf_exists]
  apply MeasurableSet.iUnion
  intro φ
  by_cases hφ : StrictMono φ
  · simp only [hφ, true_and]
    simp only [Set.setOf_forall]
    apply MeasurableSet.iInter
    intro t
    exact measurableSet_eq_fun ((hX t).comp measurable_fst) (by fun_prop)
  · simp [hφ]

@[blueprint "lem:gram-energy-antitone-of-quadratic-local"
  (statement := /-- Let
  (D=\sum_i z_i z_i^{\mathsf T}) and let (A) be a matrix whose
  quadratic form dominates that of (D).  If (DBx=x) and (ACx=x),
  then
  [
    x^{\mathsf T}Cx\leq x^{\mathsf T}Bx.
  ] -/)
  (proof := /-- Put (b=Bx) and (c=Cx).  Expanding the nonnegative
  Gram quadratic
  ((b-c)^{\mathsf T}D(b-c)) by
  \cref{lem:self-normalized-gram-quadratic-nonnegative} gives
  [
    0\leq x^{\mathsf T}Bx-2x^{\mathsf T}Cx+c^{\mathsf T}Dc.
  ]
  The assumed quadratic-form domination and (ACx=x) give
  (c^{\mathsf T}Dc\leq c^{\mathsf T}Ac=x^{\mathsf T}Cx).
  The two inequalities imply the result. -/)
  (title := /-- Antitonicity under quadratic-form domination -/)
  (latexEnv := "lemma")]
lemma gram_energy_antitone_of_quadratic_local
    {ι : Type*} [Fintype ι] {d : ℕ}
    (z : ι → Fin d → ℝ) (A : Matrix (Fin d) (Fin d) ℝ)
    (x : Fin d → ℝ) (B C : Matrix (Fin d) (Fin d) ℝ)
    (hquad : ∀ v, dotProduct v
      (Matrix.mulVec (∑ i, Matrix.vecMulVec (z i) (z i)) v) ≤
        dotProduct v (Matrix.mulVec A v))
    (hBx : Matrix.mulVec
      ((∑ i, Matrix.vecMulVec (z i) (z i)) * B) x = x)
    (hCx : Matrix.mulVec (A * C) x = x) :
    self_normalized_energy x C ≤ self_normalized_energy x B := by
  classical
  let D : Matrix (Fin d) (Fin d) ℝ :=
    ∑ i, Matrix.vecMulVec (z i) (z i)
  let b : Fin d → ℝ := Matrix.mulVec B x
  let c : Fin d → ℝ := Matrix.mulVec C x
  have hD : D.transpose = D := by
    ext p q
    simp only [D, Matrix.transpose_apply, Matrix.sum_apply,
      Matrix.vecMulVec_apply]
    apply Finset.sum_congr rfl
    intro i hi
    ring
  have hDb : Matrix.mulVec D b = x := by
    simpa only [D, b, Matrix.mulVec_mulVec] using hBx
  have hAc : Matrix.mulVec A c = x := by
    simpa only [c, Matrix.mulVec_mulVec] using hCx
  have hcross :
      dotProduct b (Matrix.mulVec D c) =
        dotProduct c (Matrix.mulVec D b) := by
    calc
      dotProduct b (Matrix.mulVec D c) =
          dotProduct b (Matrix.mulVec D.transpose c) := by rw [hD]
      _ = dotProduct c (Matrix.mulVec D b) :=
        Matrix.dotProduct_transpose_mulVec D b c
  have hDnonneg :
      0 ≤ dotProduct (b - c) (Matrix.mulVec D (b - c)) :=
    self_normalized_gram_quadratic_nonnegative z (b - c)
  have hDexpand :
      dotProduct (b - c) (Matrix.mulVec D (b - c)) =
        dotProduct b (Matrix.mulVec D b) -
          2 * dotProduct c (Matrix.mulVec D b) +
          dotProduct c (Matrix.mulVec D c) := by
    rw [Matrix.mulVec_sub, sub_dotProduct, dotProduct_sub,
      dotProduct_sub, hcross]
    ring
  have henergyB :
      self_normalized_energy x B = dotProduct b (Matrix.mulVec D b) := by
    calc
      self_normalized_energy x B = dotProduct x b := rfl
      _ = dotProduct b x := dotProduct_comm x b
      _ = dotProduct b (Matrix.mulVec D b) := by rw [hDb]
  have henergyC :
      self_normalized_energy x C = dotProduct c (Matrix.mulVec A c) := by
    calc
      self_normalized_energy x C = dotProduct x c := rfl
      _ = dotProduct c x := dotProduct_comm x c
      _ = dotProduct c (Matrix.mulVec A c) := by rw [hAc]
  have hcquad := hquad c
  change dotProduct c (Matrix.mulVec D c) ≤
    dotProduct c (Matrix.mulVec A c) at hcquad
  rw [hDexpand, ← henergyB, hDb] at hDnonneg
  have hcx :
      dotProduct c x = self_normalized_energy x C := by
    rw [dotProduct_comm]
    rfl
  rw [hcx] at hDnonneg
  rw [henergyC]
  linarith

@[blueprint "lem:gram-quadratic-sum-squares-local"
  (statement := /-- For every finite family ((z_i)) of real vectors
  and every real vector (v),
  [
    v^{\mathsf T}\left(\sum_i z_i z_i^{\mathsf T}\right)v
      =\sum_i(z_i^{\mathsf T}v)^2.
  ] -/)
  (proof := /-- Distribute matrix--vector multiplication over the
  finite sum.  Each rank-one term sends (v) to
  ((z_i^{\mathsf T}v)z_i); bilinearity and symmetry of the real dot
  product then give the sum of squares. -/)
  (title := /-- Gram quadratic as a sum of squares -/)
  (latexEnv := "lemma")]
lemma gram_quadratic_sum_squares_local
    {ι : Type*} [Fintype ι] {d : ℕ}
    (z : ι → Fin d → ℝ) (v : Fin d → ℝ) :
    dotProduct v
        (Matrix.mulVec (∑ i, Matrix.vecMulVec (z i) (z i)) v) =
      ∑ i, (dotProduct (z i) v) ^ 2 := by
  classical
  have houter (i : ι) :
      Matrix.mulVec (Matrix.vecMulVec (z i) (z i)) v =
        (dotProduct (z i) v) • z i := by
    ext j
    simp only [Matrix.mulVec, Matrix.vecMulVec_apply, dotProduct,
      Pi.smul_apply, smul_eq_mul, mul_assoc]
    rw [← Finset.mul_sum]
    ring
  rw [Matrix.sum_mulVec]
  simp_rw [houter]
  simp only [dotProduct_sum, dotProduct_smul, smul_eq_mul]
  apply Finset.sum_congr rfl
  intro i hi
  rw [dotProduct_comm v (z i)]
  ring

@[blueprint "lem:selected-prefix-leverage-domination-local"
  (statement := /-- Let ((X_t)_{t<T}) be vectors and let (U_n) be
  Moore--Penrose inverses of their full prefix Gram matrices.  For
  every strictly increasing selection
  (\phi:\operatorname{Fin}(k)\to\operatorname{Fin}(T)), there are
  Moore--Penrose inverses (W_m) of the selected prefix Gram matrices
  such that
  [
    X_{\phi(i)}^{\mathsf T}U_{\phi(i)+1}X_{\phi(i)}
      \leq X_{\phi(i)}^{\mathsf T}W_{i+1}X_{\phi(i)}
  ]
  for every (i<k). -/)
  (proof := /-- Choose (W_m) using
  \cref{lem:pos-semidef-moore-penrose-exists}.  The selected prefix
  Gram quadratic is bounded by the full prefix Gram quadratic,
  because strict monotonicity sends every selected index at most (i)
  to an original index at most (\phi(i)); by
  \cref{lem:gram-quadratic-sum-squares-local}, this is a comparison
  of sums of nonnegative squares.  Both Gram projectors fix
  (X_{\phi(i)}) by
  \cref{lem:self-normalized-gram-projection-fixes-generator}.
  Applying
  \cref{lem:gram-energy-antitone-of-quadratic-local} gives the stated
  energy comparison. -/)
  (title := /-- Selected-prefix leverage dominates full-prefix leverage -/)
  (latexEnv := "lemma")]
lemma selected_prefix_leverage_domination_local
    {T d k : ℕ} (X : Fin T → Fin d → ℝ)
    (U : Fin (T + 1) → Matrix (Fin d) (Fin d) ℝ)
    (hU : ∀ n, is_moore_penrose_inverse
      (∑ t, if t.val < n.val then
        Matrix.vecMulVec (X t) (X t) else 0) (U n))
    (φ : Fin k → Fin T) (hφ : StrictMono φ) :
    ∃ W : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
      (∀ q, is_moore_penrose_inverse
        (∑ i, if i.val < q.val then
          Matrix.vecMulVec (X (φ i)) (X (φ i)) else 0) (W q)) ∧
      ∀ i, self_normalized_energy (X (φ i)) (U (φ i).succ) ≤
        self_normalized_energy (X (φ i)) (W i.succ) := by
  classical
  let G : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ := fun q =>
    ∑ i, if i.val < q.val then
      Matrix.vecMulVec (X (φ i)) (X (φ i)) else 0
  have hG (q : Fin (k + 1)) : (G q).PosSemidef := by
    rw [Matrix.posSemidef_iff_eq_sum_vecMulVec]
    refine ⟨k, fun i => if i.val < q.val then X (φ i) else 0, ?_⟩
    dsimp only [G]
    apply Finset.sum_congr rfl
    intro i hi
    split <;> simp_all
  choose W hW using fun q => pos_semidef_moore_penrose_exists (G q) (hG q)
  refine ⟨W, ?_, ?_⟩
  · intro q
    simpa only [G] using hW q
  · intro i
    let zs : Fin k → Fin d → ℝ := fun a =>
      if a.val < i.succ.val then X (φ a) else 0
    let zf : Fin T → Fin d → ℝ := fun t =>
      if t.val < (φ i).succ.val then X t else 0
    have hsumsel :
        (∑ a, Matrix.vecMulVec (zs a) (zs a)) = G i.succ := by
      dsimp only [zs, G]
      apply Finset.sum_congr rfl
      intro a ha
      split <;> simp_all
    have hsumfull :
        (∑ t, Matrix.vecMulVec (zf t) (zf t)) =
          ∑ t, if t.val < (φ i).succ.val then
            Matrix.vecMulVec (X t) (X t) else 0 := by
      dsimp only [zf]
      apply Finset.sum_congr rfl
      intro t ht
      split <;> simp_all
    have hfixsel : Matrix.mulVec
        ((∑ a, Matrix.vecMulVec (zs a) (zs a)) * W i.succ)
        (X (φ i)) = X (φ i) := by
      have h := self_normalized_gram_projection_fixes_generator
        zs (W i.succ) (by simpa only [hsumsel] using hW i.succ) i
      simpa [zs] using h
    have hfixfull : Matrix.mulVec
        ((∑ t, Matrix.vecMulVec (zf t) (zf t)) * U (φ i).succ)
        (X (φ i)) = X (φ i) := by
      have h := self_normalized_gram_projection_fixes_generator
        zf (U (φ i).succ) (by simpa only [hsumfull] using hU (φ i).succ) (φ i)
      simpa [zf] using h
    have hquad (v : Fin d → ℝ) :
        dotProduct v
            (Matrix.mulVec (∑ a, Matrix.vecMulVec (zs a) (zs a)) v) ≤
          dotProduct v
            (Matrix.mulVec (∑ t, Matrix.vecMulVec (zf t) (zf t)) v) := by
      rw [gram_quadratic_sum_squares_local,
        gram_quadratic_sum_squares_local]
      let s : Finset (Fin k) :=
        Finset.univ.filter fun a => a.val < i.succ.val
      let t : Finset (Fin T) :=
        Finset.univ.filter fun u => u.val < (φ i).succ.val
      have hsub : s.image φ ⊆ t := by
        intro u hu
        rw [Finset.mem_image] at hu
        obtain ⟨a, ha, rfl⟩ := hu
        rw [Finset.mem_filter] at ha ⊢
        refine ⟨Finset.mem_univ _, ?_⟩
        have hai : a ≤ i := by
          exact Fin.le_iff_val_le_val.mpr (Nat.lt_succ_iff.mp ha.2)
        have hφai : φ a ≤ φ i := hφ.monotone hai
        exact Nat.lt_succ_iff.mpr (Fin.le_iff_val_le_val.mp hφai)
      calc
        (∑ a, (dotProduct (zs a) v) ^ 2) =
            ∑ a ∈ s, (dotProduct (X (φ a)) v) ^ 2 := by
              dsimp only [s]
              rw [Finset.sum_filter]
              apply Finset.sum_congr rfl
              intro a ha
              by_cases hai : a ≤ i <;>
                simp [s, zs, hai, Nat.lt_succ_iff]
        _ =
            ∑ u ∈ s.image φ, (dotProduct (X u) v) ^ 2 := by
              symm
              rw [Finset.sum_image]
              intro a ha b hb hab
              exact hφ.injective hab
        _ ≤ ∑ u ∈ t, (dotProduct (X u) v) ^ 2 :=
          Finset.sum_le_sum_of_subset_of_nonneg hsub
            (fun u hu hut => sq_nonneg (dotProduct (X u) v))
        _ = ∑ u, (dotProduct (zf u) v) ^ 2 := by
          dsimp only [t]
          rw [Finset.sum_filter]
          apply Finset.sum_congr rfl
          intro u hu
          by_cases hui : u ≤ φ i <;>
            simp [t, zf, hui, Nat.lt_succ_iff]
    exact gram_energy_antitone_of_quadratic_local zs
      (∑ t, Matrix.vecMulVec (zf t) (zf t)) (X (φ i))
      (W i.succ) (U (φ i).succ) hquad hfixsel hfixfull

@[blueprint "lem:quartic-leverage-sum-local"
  (statement := /-- For (T,J\in\mathbb N) and
  (0\leq q_t\leq1),
  [
    \sum_{t<T}q_t\leq \frac{T}{4^J}
      +\sum_{j<J}\frac{3}{4^{j+1}}
        \#\{t<T:q_t\geq4^{-(j+1)}\}.
  ] -/)
  (proof := /-- Induct on (J).  At the successor step split according
  as (4^{-(J+1)}\leq x).  In the positive case the new residual and
  indicator coefficient sum to the preceding residual, since
  (4^{-J}=4^{-(J+1)}+3\cdot4^{-(J+1)}); in the negative case the new
  residual already dominates (x).  Sum the resulting scalar
  inequality over (t) and interchange the finite sums.  In parallel,
  apply \cref{lem:dyadic-leverage-sum} at depth (2J).  Taking the
  minimum of the dyadic and quartic bounds and then retaining its
  quartic component gives the displayed inequality. -/)
  (title := /-- Quartic layer-cake bound -/)
  (latexEnv := "lemma")]
lemma quartic_leverage_sum_local {T J : ℕ} (q : Fin T → ℝ)
    (hq : ∀ t, 0 ≤ q t ∧ q t ≤ 1) :
    (∑ t, q t) ≤ (T : ℝ) / (4 : ℝ) ^ J +
      ∑ j : Fin J, (3 / (4 : ℝ) ^ (j.val + 1)) *
        ((Finset.univ.filter fun t : Fin T =>
          1 / (4 : ℝ) ^ (j.val + 1) ≤ q t).card : ℝ) := by
  classical
  have hscalar : ∀ n : ℕ, ∀ x : ℝ, 0 ≤ x → x ≤ 1 →
      x ≤ 1 / (4 : ℝ) ^ n +
        ∑ j : Fin n, if 1 / (4 : ℝ) ^ (j.val + 1) ≤ x then
          3 / (4 : ℝ) ^ (j.val + 1) else 0 := by
    intro n
    induction n with
    | zero =>
        intro x hx0 hx1
        simpa using hx1
    | succ n ih =>
        intro x hx0 hx1
        rw [Fin.sum_univ_castSucc]
        simp only [Fin.val_castSucc, Fin.val_last]
        by_cases h : 1 / (4 : ℝ) ^ (n + 1) ≤ x
        · rw [if_pos h]
          calc
            x ≤ 1 / (4 : ℝ) ^ n +
                ∑ j : Fin n, if 1 / (4 : ℝ) ^ (j.val + 1) ≤ x then
                  3 / (4 : ℝ) ^ (j.val + 1) else 0 := ih x hx0 hx1
            _ = 1 / (4 : ℝ) ^ (n + 1) +
                ((∑ j : Fin n, if 1 / (4 : ℝ) ^ (j.val + 1) ≤ x then
                  3 / (4 : ℝ) ^ (j.val + 1) else 0) +
                3 / (4 : ℝ) ^ (n + 1)) := by
                  rw [pow_succ]
                  ring
        · rw [if_neg h]
          have hx : x ≤ 1 / (4 : ℝ) ^ (n + 1) :=
            le_of_lt (lt_of_not_ge h)
          have hs : 0 ≤
              ∑ j : Fin n, if 1 / (4 : ℝ) ^ (j.val + 1) ≤ x then
                3 / (4 : ℝ) ^ (j.val + 1) else 0 := by
            apply Finset.sum_nonneg
            intro j hj
            split <;> positivity
          linarith
  have hquartic :
      (∑ t, q t) ≤ (T : ℝ) / (4 : ℝ) ^ J +
        ∑ j : Fin J, (3 / (4 : ℝ) ^ (j.val + 1)) *
          ((Finset.univ.filter fun t : Fin T =>
            1 / (4 : ℝ) ^ (j.val + 1) ≤ q t).card : ℝ) := by
    calc
      (∑ t, q t) ≤ ∑ t, (1 / (4 : ℝ) ^ J +
          ∑ j : Fin J, if 1 / (4 : ℝ) ^ (j.val + 1) ≤ q t then
            3 / (4 : ℝ) ^ (j.val + 1) else 0) := by
        apply Finset.sum_le_sum
        intro t ht
        exact hscalar J (q t) (hq t).1 (hq t).2
      _ = (T : ℝ) / (4 : ℝ) ^ J +
          ∑ j : Fin J, (3 / (4 : ℝ) ^ (j.val + 1)) *
            ((Finset.univ.filter fun t : Fin T =>
              1 / (4 : ℝ) ^ (j.val + 1) ≤ q t).card : ℝ) := by
        rw [Finset.sum_add_distrib, Finset.sum_comm]
        simp [Finset.sum_ite, mul_comm, div_eq_mul_inv]
  have hdyadic := dyadic_leverage_sum (J := 2 * J) q hq
  exact (le_min hdyadic hquartic).trans (min_le_right _ _)

@[blueprint "lem:quartic-leverage-rate-algebra-local"
  (statement := /-- Let (T,d,K) be positive, let (B\geq0),
  (C_{\mathrm{cov}}\geq1), and (0<\eta<1).  Put
  (L=\log(2T/\eta)).  Suppose
  (K\leq C_{\mathrm{cov}}L+1), and suppose that every quartic
  leverage level satisfies
  [
    \#\{t:q_t\geq4^{-(j+1)}\}
      \leq B\left(
        \sqrt{TKd\,4^{j+1}}+L\right).
  ]
  If (0\leq q_t\leq1), then
  [
    \sum_tq_t\leq
    10(B+1)\left(
      \sqrt{dC_{\mathrm{cov}}T L}+\log(2/\eta)\right).
  ] -/)
  (proof := /-- Apply
  \cref{lem:quartic-leverage-sum-local} with (J=T).
  The residual is at most one.  At level (j), multiplication by
  (3\cdot4^{-(j+1)}) changes the square-root term into
  (3\sqrt{TKd}\,2^{-(j+1)}); the resulting geometric series is at
  most (3\sqrt{TKd}).  The logarithmic coefficients sum to at most
  one.

  The ceiling-type bound on (K), together with
  (\log(2T/\eta)>\log2), gives
  (K\leq3C_{\mathrm{cov}}L), hence
  (\sqrt{TKd}\leq2\sqrt{dC_{\mathrm{cov}}TL}).
  Finally,
  (L=\log T+\log(2/\eta)) and
  (\log T\leq\sqrt{TL}) show that (L) is bounded by the displayed
  rate.  The numerical factor (10) absorbs the residual and all
  preceding constants. -/)
  (title := /-- Algebraic conversion of quartic level bounds -/)
  (latexEnv := "lemma")]
lemma quartic_leverage_rate_algebra_local
    {T d K : ℕ} (B Ccov η : ℝ)
    (hT : 0 < T) (hd : 0 < d) (hKpos : 0 < K)
    (hB : 0 ≤ B) (hC : 1 ≤ Ccov) (hη : 0 < η) (hη1 : η < 1)
    (hK : (K : ℝ) ≤
      Ccov * Real.log (2 * (T : ℝ) / η) + 1)
    (q : Fin T → ℝ) (hq : ∀ t, 0 ≤ q t ∧ q t ≤ 1)
    (hcard : ∀ j : Fin T,
      ((Finset.univ.filter fun t : Fin T =>
        1 / (4 : ℝ) ^ (j.val + 1) ≤ q t).card : ℝ) ≤
      B * (Real.sqrt ((T : ℝ) * (K : ℝ) * (d : ℝ) /
        (1 / (4 : ℝ) ^ (j.val + 1))) +
        Real.log (2 * (T : ℝ) / η))) :
    (∑ t, q t) ≤ 10 * (B + 1) *
      (Real.sqrt ((d : ℝ) * Ccov * (T : ℝ) *
        Real.log (2 * (T : ℝ) / η)) + Real.log (2 / η)) := by
  classical
  let L : ℝ := Real.log (2 * (T : ℝ) / η)
  let L0 : ℝ := Real.log (2 / η)
  let M : ℝ := (T : ℝ) * (K : ℝ) * (d : ℝ)
  let D : ℝ := (d : ℝ) * Ccov * (T : ℝ) * L
  have hL0pos : 0 < L0 := by
    dsimp only [L0]
    apply Real.log_pos
    have : 1 < 2 / η := by
      rw [lt_div_iff₀ hη]
      linarith
    exact this
  have harg : 1 < 2 * (T : ℝ) / η := by
    rw [lt_div_iff₀ hη]
    have hTc : (1 : ℝ) ≤ T := by exact_mod_cast hT
    nlinarith
  have hLpos : 0 < L := by
    dsimp only [L]
    exact Real.log_pos harg
  have hM0 : 0 ≤ M := by
    dsimp only [M]
    positivity
  have hD0 : 0 ≤ D := by
    dsimp only [D]
    positivity
  have hgeom2 : ∀ n : ℕ,
      (∑ j : Fin n, 1 / (2 : ℝ) ^ (j.val + 1)) =
        1 - 1 / (2 : ℝ) ^ n := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
        rw [Fin.sum_univ_castSucc]
        rw [show (∑ i : Fin n,
          1 / (2 : ℝ) ^ ((i.castSucc : Fin (n + 1)).val + 1)) =
            1 - 1 / (2 : ℝ) ^ n by simpa using ih]
        simp only [Fin.val_last]
        rw [pow_succ]
        ring
  have hgeom4 : ∀ n : ℕ,
      (∑ j : Fin n, 3 / (4 : ℝ) ^ (j.val + 1)) =
        1 - 1 / (4 : ℝ) ^ n := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
        rw [Fin.sum_univ_castSucc]
        rw [show (∑ i : Fin n,
          3 / (4 : ℝ) ^ ((i.castSucc : Fin (n + 1)).val + 1)) =
            1 - 1 / (4 : ℝ) ^ n by simpa using ih]
        simp only [Fin.val_last]
        rw [pow_succ]
        ring
  have hres : (T : ℝ) / (4 : ℝ) ^ T ≤ 1 := by
    have hp : ∀ n : ℕ, (n : ℝ) ≤ (2 : ℝ) ^ n := by
      intro n
      induction n with
      | zero => norm_num
      | succ n ih =>
          rw [Nat.cast_succ, pow_succ]
          have hone : 1 ≤ (2 : ℝ) ^ n := one_le_pow₀ (by norm_num)
          nlinarith
    have hp4 : (T : ℝ) ≤ (4 : ℝ) ^ T := by
      calc
        (T : ℝ) ≤ (2 : ℝ) ^ T := hp T
        _ ≤ (4 : ℝ) ^ T :=
          pow_le_pow_left₀ (by norm_num) (by norm_num) T
    exact (div_le_one (by positivity)).2 hp4
  have hsqrtlevel (j : Fin T) :
      Real.sqrt (M / (1 / (4 : ℝ) ^ (j.val + 1))) =
        (2 : ℝ) ^ (j.val + 1) * Real.sqrt M := by
    let n := j.val + 1
    have hfour : (4 : ℝ) ^ n = ((2 : ℝ) ^ n) ^ 2 := by
      rw [show (4 : ℝ) = 2 ^ 2 by norm_num, ← pow_mul, ← pow_mul]
      congr 1
      omega
    calc
      Real.sqrt (M / (1 / (4 : ℝ) ^ n)) =
          Real.sqrt (M * (4 : ℝ) ^ n) := by
            congr 1
            field_simp
      _ = Real.sqrt (M * ((2 : ℝ) ^ n) ^ 2) := by rw [hfour]
      _ = Real.sqrt M * Real.sqrt (((2 : ℝ) ^ n) ^ 2) := by
        rw [Real.sqrt_mul hM0]
      _ = (2 : ℝ) ^ n * Real.sqrt M := by
        rw [Real.sqrt_sq_eq_abs, abs_of_nonneg (by positivity)]
        ring
  have hlevels :
      ∑ j : Fin T, (3 / (4 : ℝ) ^ (j.val + 1)) *
          ((Finset.univ.filter fun t : Fin T =>
            1 / (4 : ℝ) ^ (j.val + 1) ≤ q t).card : ℝ) ≤
        B * (3 * Real.sqrt M + L) := by
    calc
      _ ≤ ∑ j : Fin T, (3 / (4 : ℝ) ^ (j.val + 1)) *
          (B * (Real.sqrt (M /
            (1 / (4 : ℝ) ^ (j.val + 1))) + L)) := by
        apply Finset.sum_le_sum
        intro j hj
        gcongr
        simpa only [M, L] using hcard j
      _ = ∑ j : Fin T, B *
          (3 * Real.sqrt M * (1 / (2 : ℝ) ^ (j.val + 1)) +
            L * (3 / (4 : ℝ) ^ (j.val + 1))) := by
        apply Finset.sum_congr rfl
        intro j hj
        have hpow :
            (4 : ℝ) ^ (j.val + 1) =
              ((2 : ℝ) ^ (j.val + 1)) ^ 2 := by
          rw [show (4 : ℝ) = 2 ^ 2 by norm_num, ← pow_mul, ← pow_mul]
          congr 1
          omega
        rw [hsqrtlevel]
        rw [hpow]
        field_simp
      _ = B * (3 * Real.sqrt M *
            (∑ j : Fin T, 1 / (2 : ℝ) ^ (j.val + 1)) +
          L * (∑ j : Fin T, 3 / (4 : ℝ) ^ (j.val + 1))) := by
        simp_rw [mul_add]
        rw [Finset.sum_add_distrib]
        rw [← Finset.mul_sum, ← Finset.mul_sum]
        congr 1
        rw [← Finset.mul_sum, ← Finset.mul_sum]
      _ ≤ B * (3 * Real.sqrt M + L) := by
        have h2 := hgeom2 T
        have h4 := hgeom4 T
        have hs2 : (∑ j : Fin T, 1 / (2 : ℝ) ^ (j.val + 1)) ≤ 1 := by
          rw [h2]
          have : 0 ≤ 1 / (2 : ℝ) ^ T := by positivity
          linarith
        have hs4 : (∑ j : Fin T, 3 / (4 : ℝ) ^ (j.val + 1)) ≤ 1 := by
          rw [h4]
          have : 0 ≤ 1 / (4 : ℝ) ^ T := by positivity
          linarith
        have hsqrt0 : 0 ≤ Real.sqrt M := Real.sqrt_nonneg _
        have hfirst :
            3 * Real.sqrt M *
                (∑ j : Fin T, 1 / (2 : ℝ) ^ (j.val + 1)) ≤
              3 * Real.sqrt M := by
          have hc0 : 0 ≤ 3 * Real.sqrt M :=
            mul_nonneg (by norm_num) hsqrt0
          simpa using mul_le_mul_of_nonneg_left hs2 hc0
        have hsecond :
            L * (∑ j : Fin T, 3 / (4 : ℝ) ^ (j.val + 1)) ≤ L := by
          simpa using mul_le_mul_of_nonneg_left hs4 hLpos.le
        exact mul_le_mul_of_nonneg_left (add_le_add hfirst hsecond) hB
  have hsum : (∑ t, q t) ≤ 1 + B * (3 * Real.sqrt M + L) := by
    calc
      (∑ t, q t) ≤ (T : ℝ) / (4 : ℝ) ^ T +
          ∑ j : Fin T, (3 / (4 : ℝ) ^ (j.val + 1)) *
            ((Finset.univ.filter fun t : Fin T =>
              1 / (4 : ℝ) ^ (j.val + 1) ≤ q t).card : ℝ) :=
        quartic_leverage_sum_local q hq
      _ ≤ 1 + B * (3 * Real.sqrt M + L) := add_le_add hres hlevels
  have hlog2 : (1 : ℝ) < 2 * Real.log 2 := by
    nlinarith [Real.log_two_gt_d9]
  have hLlog2 : Real.log 2 ≤ L := by
    dsimp only [L]
    apply le_of_lt
    apply Real.strictMonoOn_log
    · norm_num
    · exact Set.mem_Ioi.mpr (by positivity)
    · rw [lt_div_iff₀ hη]
      have hTc : (1 : ℝ) ≤ T := by exact_mod_cast hT
      nlinarith
  have hCL : 1 < 2 * Ccov * L := by
    have hC0 : 0 ≤ Ccov := by linarith
    have := mul_le_mul hC hLlog2 (Real.log_nonneg (by norm_num))
      hC0
    nlinarith
  have hK3 : (K : ℝ) ≤ 3 * Ccov * L := by
    change (K : ℝ) ≤ Ccov * L + 1 at hK
    nlinarith
  have hM4D : M ≤ 4 * D := by
    dsimp only [M, D]
    have hTd : 0 ≤ (T : ℝ) * (d : ℝ) := by positivity
    have := mul_le_mul_of_nonneg_left hK3 hTd
    nlinarith
  have hsqrtMD : Real.sqrt M ≤ 2 * Real.sqrt D := by
    calc
      Real.sqrt M ≤ Real.sqrt (4 * D) := Real.sqrt_le_sqrt hM4D
      _ = 2 * Real.sqrt D := by
        rw [Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 4)]
        norm_num
  have hLsplit : L = Real.log (T : ℝ) + L0 := by
    dsimp only [L, L0]
    rw [show 2 * (T : ℝ) / η = (T : ℝ) * (2 / η) by ring]
    rw [Real.log_mul (by positivity) (by positivity)]
  have hlogT0 : 0 ≤ Real.log (T : ℝ) :=
    Real.log_nonneg (by exact_mod_cast hT)
  have hlogTT : Real.log (T : ℝ) ≤ (T : ℝ) := by
    have h := Real.log_le_sub_one_of_pos (by positivity : (0 : ℝ) < T)
    linarith
  have hlogTL : Real.log (T : ℝ) ≤ L := by
    rw [hLsplit]
    linarith
  have hlogTsq : (Real.log (T : ℝ)) ^ 2 ≤ (T : ℝ) * L := by
    nlinarith [mul_le_mul hlogTT hlogTL hlogT0
      (by positivity : (0 : ℝ) ≤ (T : ℝ))]
  have hlogTsqrt : Real.log (T : ℝ) ≤ Real.sqrt ((T : ℝ) * L) :=
    Real.le_sqrt_of_sq_le hlogTsq
  have hTL_D : (T : ℝ) * L ≤ D := by
    dsimp only [D]
    have hdc : 1 ≤ (d : ℝ) * Ccov := by
      have hd1 : (1 : ℝ) ≤ d := by exact_mod_cast hd
      nlinarith [mul_le_mul hd1 hC (by norm_num : (0 : ℝ) ≤ 1)
        (by positivity : (0 : ℝ) ≤ (d : ℝ))]
    have hTL0 : 0 ≤ (T : ℝ) * L := by positivity
    nlinarith [mul_le_mul_of_nonneg_right hdc hTL0]
  have hLrate : L ≤ Real.sqrt D + L0 := by
    rw [hLsplit]
    have hs := Real.sqrt_le_sqrt hTL_D
    linarith
  have honeRate : 1 ≤ 2 * (Real.sqrt D + L0) := by
    have hL02 : Real.log 2 < L0 := by
      dsimp only [L0]
      apply Real.strictMonoOn_log
      · norm_num
      · exact Set.mem_Ioi.mpr (by positivity)
      · rw [lt_div_iff₀ hη]
        linarith
    have hs0 := Real.sqrt_nonneg D
    nlinarith [Real.log_two_gt_d9]
  calc
    (∑ t, q t) ≤ 1 + B * (3 * Real.sqrt M + L) := hsum
    _ ≤ 10 * (B + 1) * (Real.sqrt D + L0) := by
      have hrate0 : 0 ≤ Real.sqrt D + L0 := by positivity
      nlinarith
    _ = 10 * (B + 1) *
        (Real.sqrt ((d : ℝ) * Ccov * (T : ℝ) *
          Real.log (2 * (T : ℝ) / η)) + Real.log (2 / η)) := by
      rfl

@[blueprint "lem:smooth-leverage-bound-event-measurable-local"
  (statement := /-- Let ((X_t)) be measurable and let ((U_n)) be any
  pointwise family of Moore--Penrose inverses of the prefix Gram
  matrices.  For every real (a), the event
  [
    \left\{\omega:\sum_t
      X_t(\omega)^{\mathsf T}U_{t+1}(\omega)X_t(\omega)\leq a
    \right\}
  ]
  is measurable, even when the given family ((U_n)) is not assumed
  measurable. -/)
  (proof := /-- Apply
  \cref{lem:measurable-gram-moore-penrose} to the top filtration to
  obtain a measurable prefix inverse family ((W_n)).  Pointwise
  uniqueness from
  \cref{lem:local-moore-penrose-inverse-unique} gives (U_n=W_n) for
  every (n) and outcome.  Each leverage formed with (W_{t+1}) is a
  finite sum of products of measurable coordinate functions, so its
  finite sum is measurable.  Replacing (W) by the pointwise equal
  family (U) proves the assertion. -/)
  (title := /-- Measurability of leverage-sum bound events -/)
  (latexEnv := "lemma")]
lemma smooth_leverage_bound_event_measurable_local
    {T d : ℕ} {Ω : Type*} [mΩ : MeasurableSpace Ω]
    (X : Fin T → Ω → Fin d → ℝ) (hX : ∀ t, Measurable (X t))
    (U : Fin (T + 1) → Ω → Matrix (Fin d) (Fin d) ℝ)
    (hU : ∀ n ω, is_moore_penrose_inverse
      (partial_empirical_gram X n ω) (U n ω)) (a : ℝ) :
    MeasurableSet {ω | ∑ t, self_normalized_leverage X U t ω ≤ a} := by
  classical
  let ℱ : MeasureTheory.Filtration ℕ mΩ := ⊤
  have hpred : predictable_covariates ℱ X := by
    intro t
    change Measurable (X t)
    exact hX t
  obtain ⟨W, hW, _hWzero, hWsucc⟩ :=
    measurable_gram_moore_penrose ℱ X hpred
  have heq (n : Fin (T + 1)) (ω : Ω) : U n ω = W n ω :=
    local_moore_penrose_inverse_unique (hU n ω) (hW n ω)
  have hlev (t : Fin T) :
      self_normalized_leverage X U t =
        self_normalized_leverage X W t := by
    funext ω
    simp only [self_normalized_leverage, self_normalized_energy, heq]
  have hmeas (t : Fin T) :
      Measurable (self_normalized_leverage X W t) := by
    change Measurable (fun ω =>
      ∑ i, X t ω i * ∑ j, W t.succ ω i j * X t ω j)
    apply Finset.measurable_sum
    intro i hi
    apply ((hX t).eval (a := i)).mul
    apply Finset.measurable_sum
    intro j hj
    exact (hWsucc t i j).mul ((hX t).eval (a := j))
  have hsum : Measurable (fun ω =>
      ∑ t, self_normalized_leverage X W t ω) := by
    apply Finset.measurable_sum
    intro t ht
    exact hmeas t
  simpa only [hlev] using measurableSet_le hsum measurable_const

@[blueprint "lem:smooth-leverage-sum-control"
  (statement := /-- There is an absolute constant (A>0) with the
  following property.  Let (T,d) be positive integers, let
  ((\Omega,\mathcal F,\mu)) be a probability space, and let
  ((\mathcal H_n^x)_{n\geq0}) be the earlier-covariate filtration of
  a process ((X_t)_{t<T}) in (\mathbb R^d).  Suppose that the
  conditional law of (X_t) given (\mathcal H_t^x) is the probability
  kernel (P_t).  Let (\mu_0) be a probability measure on
  (\mathbb R^d).  Fix (C_{\mathrm{cov}}\geq1), and assume that
  (P_t(\omega,\cdot)\leq C_{\mathrm{cov}}\mu_0) for every
  (t<T) and (\omega\in\Omega).

  Let ((U_n)_{0\leq n\leq T}) be any, not necessarily measurable,
  family such that, for every (n) and (\omega), the matrix
  (U_n(\omega)) is a Moore--Penrose inverse of
  [
    \sum_{s<n}X_s(\omega)X_s(\omega)^{\mathsf T}.
  ]
  Then, for every (\eta\in(0,1)), with (\mu)-probability at least
  (1-\eta),
  [
    \sum_{t<T}X_t^{\mathsf T}U_{t+1}X_t
      \leq A\left(
        \sqrt{dC_{\mathrm{cov}}T\log(2T/\eta)}
        +\log(2/\eta)\right).
  ] -/)
  (proof := /-- Let (B>0) be supplied by
  \cref{lem:iid-bad-subsequence-tail}, and set (A=10(B+1)).  Put
  [
    L=\log(2T/\eta),\qquad
    K=\left\lceil C_{\mathrm{cov}}L\right\rceil .
  ]
  Then (K>0),
  (C_{\mathrm{cov}}\log(T/(\eta/2))\leq K), and
  (K\leq C_{\mathrm{cov}}L+1).  Thus
  \cref{lem:dominated-kernel-rejection-coupling} gives a coupling
  with (TK) independent (\mu_0)-distributed proposals and a matching
  event (E_0) of probability at least (1-\eta/2).
  The event (E_0) is measurable by
  \cref{lem:smooth-coupling-match-event-measurable-local}.

  For (j<T), set (r_j=4^{-(j+1)}) and
  (\varepsilon=\eta/(2T)).  Apply
  \cref{lem:iid-bad-subsequence-tail} to the proposal sequence with
  threshold (r_j) and failure probability (\varepsilon).  Its good
  event (G_j) has probability at least (1-\varepsilon), and
  \cref{lem:iid-bad-subsequence-good-event-measurable-local} shows
  that it is measurable.  A union bound over the complements gives
  [
    \mathbb P\left(E_0\cap\bigcap_{j<T}G_j\right)\geq1-\eta.
  ]

  Fix an outcome in this intersection.  By
  \cref{lem:prefix-gram-leverage-bounds}, all sequential leverages
  (q_t) lie in ([0,1]).  For a fixed (j), enumerate the set
  (\{t:q_t\geq r_j\}) increasingly and compose this enumeration
  with the matching map into the proposal sequence.  Removing the
  unselected earlier vectors does not preserve the prefix Gram
  matrix; instead,
  \cref{lem:selected-prefix-leverage-domination-local} supplies
  Moore--Penrose inverses of the selected prefix Grams and proves that
  every selected-prefix energy dominates the corresponding full-prefix
  leverage.  The defining property of (G_j) therefore yields
  [
    \#\{t:q_t\geq r_j\}\leq
    B\left(\sqrt{TKd/r_j}+\log(2T/\eta)\right).
  ]
  Applying \cref{lem:quartic-leverage-rate-algebra-local} to these
  level bounds gives the asserted estimate with (A=10(B+1)).

  Finally, the leverage-bound event is measurable by
  \cref{lem:smooth-leverage-bound-event-measurable-local}.  The
  intersection above is contained in its inverse image under the
  first projection, and the first marginal of the coupling is (\mu).
  Monotonicity and the map identity transfer the probability lower
  bound to the original sample space. -/)
  (title := /-- Smooth-covariate leverage concentration -/)
  (latexEnv := "lemma")]
lemma smooth_leverage_sum_control :
    ∃ A : ℝ, 0 < A ∧
      ∀ (T d : ℕ) (Ω : Type*) [mΩ : MeasurableSpace Ω]
        (μ : MeasureTheory.Measure Ω)
        [MeasureTheory.IsProbabilityMeasure μ]
        (ℋx : MeasureTheory.Filtration ℕ mΩ)
        (X : Fin T → Ω → Fin d → ℝ)
        (P : (t : Fin T) → @ProbabilityTheory.Kernel Ω (Fin d → ℝ)
          (ℋx t.val) inferInstance)
        (μ0 : MeasureTheory.Measure (Fin d → ℝ))
        [MeasureTheory.IsProbabilityMeasure μ0]
        (U : Fin (T + 1) → Ω → Matrix (Fin d) (Fin d) ℝ)
        (Ccov η : ℝ),
        0 < T → 0 < d → 1 ≤ Ccov → 0 < η → η < 1 →
        covariate_history_filtration ℋx X →
        conditional_covariate_law μ ℋx X P →
        smooth_covariates ℋx P μ0 Ccov →
        (∀ n ω, is_moore_penrose_inverse
          (partial_empirical_gram X n ω) (U n ω)) →
        μ {ω | ∑ t, self_normalized_leverage X U t ω ≤
          A * (Real.sqrt ((d : ℝ) * Ccov * (T : ℝ) *
            Real.log (2 * (T : ℝ) / η)) + Real.log (2 / η))}
          ≥ ENNReal.ofReal (1 - η) := by
  classical
  obtain ⟨B, hBpos, hBtail⟩ := iid_bad_subsequence_tail
  refine ⟨10 * (B + 1), by positivity, ?_⟩
  intro T d Ω mΩ μ hμ ℋx X P μ0 hμ0 U Ccov η hT hd hC hη hη1
    hℋ hP hsmooth hU
  let L : ℝ := Real.log (2 * (T : ℝ) / η)
  have hLpos : 0 < L := by
    dsimp only [L]
    apply Real.log_pos
    rw [one_lt_div hη]
    have hTc : (1 : ℝ) ≤ T := by exact_mod_cast hT
    nlinarith
  let K : ℕ := ⌈Ccov * L⌉₊
  have hKpos : 0 < K := by
    dsimp only [K]
    rw [Nat.ceil_pos]
    positivity
  have hηhalf : 0 < η / 2 ∧ η / 2 < 1 := by
    constructor <;> linarith
  have hsize :
      Ccov * Real.log ((T : ℝ) / (η / 2)) ≤ (K : ℝ) := by
    have hc := Nat.le_ceil (Ccov * L)
    change Ccov * L ≤ (K : ℝ) at hc
    convert hc using 1
    dsimp only [L]
    congr 2
    field_simp
  obtain ⟨γ, hγ, hmap, hind, hmarg, hmatch⟩ :=
    dominated_kernel_rejection_coupling T d K Ω μ ℋx X P μ0
      Ccov (η / 2) hT hKpos hC hηhalf.1 hηhalf.2 hsize hℋ hP hsmooth
  letI : MeasureTheory.IsProbabilityMeasure γ := hγ
  let Z : Fin (T * K) →
      (Ω × (Fin (T * K) → Fin d → ℝ)) → Fin d → ℝ :=
    fun i z => z.2 i
  have hZ : ∀ i, Measurable (Z i) := by
    intro i
    dsimp only [Z]
    fun_prop
  let eps : ℝ := η / (2 * (T : ℝ))
  have heps : 0 < eps := by
    dsimp only [eps]
    positivity
  have heps1 : eps < 1 := by
    dsimp only [eps]
    have hTc : (1 : ℝ) ≤ T := by exact_mod_cast hT
    rw [div_lt_one (by positivity)]
    nlinarith
  let r : Fin T → ℝ := fun j => 1 / (4 : ℝ) ^ (j.val + 1)
  have hr (j : Fin T) : 0 < r j := by
    dsimp only [r]
    positivity
  have hr1 (j : Fin T) : r j ≤ 1 := by
    dsimp only [r]
    exact (div_le_one (by positivity)).2 (one_le_pow₀ (by norm_num))
  let Good : Fin T → Set (Ω × (Fin (T * K) → Fin d → ℝ)) := fun j =>
    {z | ∀ (k : ℕ) (φ : Fin k → Fin (T * K)), StrictMono φ →
      ∀ W : Fin (k + 1) → Matrix (Fin d) (Fin d) ℝ,
        (∀ q, is_moore_penrose_inverse
          (∑ i, if i.val < q.val then
            Matrix.vecMulVec (Z (φ i) z) (Z (φ i) z) else 0) (W q)) →
        (∀ i, r j ≤ self_normalized_energy (Z (φ i) z) (W i.succ)) →
        (k : ℝ) ≤ B * (Real.sqrt (((T * K : ℕ) : ℝ) * (d : ℝ) / r j) +
          Real.log (1 / eps))}
  have hGoodMeas (j : Fin T) : MeasurableSet (Good j) := by
    dsimp only [Good]
    exact iid_bad_subsequence_good_event_measurable_local
      (T * K) d _ Z hZ B (r j) eps hBpos.le (hr j) heps heps1
  have hGoodProb (j : Fin T) :
      γ (Good j) ≥ ENNReal.ofReal (1 - eps) := by
    dsimp only [Good]
    exact hBtail (T * K) d _ γ Z μ0 (r j) eps
      (Nat.mul_pos hT hKpos) hd (hr j) (hr1 j) heps heps1
      hZ hind hmarg
  let Match : Set (Ω × (Fin (T * K) → Fin d → ℝ)) :=
    {z | ∃ φ : Fin T → Fin (T * K), StrictMono φ ∧
      ∀ t, X t z.1 = z.2 (φ t)}
  have hMatchMeas : MeasurableSet Match := by
    dsimp only [Match]
    exact smooth_coupling_match_event_measurable_local ℋx X hℋ
  have hMatchProb : γ Match ≥ ENNReal.ofReal (1 - η / 2) := by
    simpa only [Match] using hmatch
  let E : Set (Ω × (Fin (T * K) → Fin d → ℝ)) :=
    Match ∩ ⋂ j, Good j
  have hEmeas : MeasurableSet E :=
    hMatchMeas.inter (MeasurableSet.iInter hGoodMeas)
  have hMatchFail : γ Matchᶜ ≤ ENNReal.ofReal (η / 2) := by
    rw [MeasureTheory.prob_compl_eq_one_sub hMatchMeas]
    calc
      1 - γ Match ≤ 1 - ENNReal.ofReal (1 - η / 2) :=
        tsub_le_tsub_left hMatchProb 1
      _ = ENNReal.ofReal (η / 2) := by
        rw [ENNReal.ofReal_sub 1 (by linarith : 0 ≤ η / 2),
          ENNReal.ofReal_one]
        exact ENNReal.sub_sub_cancel ENNReal.one_ne_top
          (ENNReal.ofReal_le_one.mpr (by linarith))
  have hGoodFail (j : Fin T) :
      γ (Good j)ᶜ ≤ ENNReal.ofReal eps := by
    rw [MeasureTheory.prob_compl_eq_one_sub (hGoodMeas j)]
    calc
      1 - γ (Good j) ≤ 1 - ENNReal.ofReal (1 - eps) :=
        tsub_le_tsub_left (hGoodProb j) 1
      _ = ENNReal.ofReal eps := by
        rw [ENNReal.ofReal_sub 1 heps.le, ENNReal.ofReal_one]
        exact ENNReal.sub_sub_cancel ENNReal.one_ne_top
          (ENNReal.ofReal_le_one.mpr heps1.le)
  have hepssum : η / 2 + (T : ℝ) * eps = η := by
    dsimp only [eps]
    have hTne : (T : ℝ) ≠ 0 := by positivity
    field_simp
    norm_num
  have hEfail : γ Eᶜ ≤ ENNReal.ofReal η := by
    calc
      γ Eᶜ = γ (Matchᶜ ∪ ⋃ j, (Good j)ᶜ) := by
        apply congrArg γ
        ext z
        simp [E]
        tauto
      _ ≤ γ Matchᶜ + γ (⋃ j, (Good j)ᶜ) :=
        MeasureTheory.measure_union_le _ _
      _ ≤ γ Matchᶜ + ∑' j : Fin T, γ (Good j)ᶜ :=
        add_le_add_right (MeasureTheory.measure_iUnion_le _) _
      _ ≤ ENNReal.ofReal (η / 2) +
          ∑' _j : Fin T, ENNReal.ofReal eps :=
        add_le_add hMatchFail (ENNReal.tsum_le_tsum hGoodFail)
      _ = ENNReal.ofReal η := by
        rw [tsum_fintype]
        simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin,
          nsmul_eq_mul]
        rw [← ENNReal.ofReal_natCast,
          ← ENNReal.ofReal_mul (Nat.cast_nonneg T),
          ← ENNReal.ofReal_add (by positivity : 0 ≤ η / 2)
            (mul_nonneg (Nat.cast_nonneg T) heps.le), hepssum]
  have hEprob : γ E ≥ ENNReal.ofReal (1 - η) := by
    calc
      ENNReal.ofReal (1 - η) = 1 - ENNReal.ofReal η := by
        rw [ENNReal.ofReal_sub 1 hη.le, ENNReal.ofReal_one]
      _ ≤ 1 - γ Eᶜ := tsub_le_tsub_left hEfail 1
      _ = γ E := by
        have hc := MeasureTheory.prob_compl_eq_one_sub (μ := γ) hEmeas.compl
        simpa only [compl_compl] using hc.symm
  have hXhist (t : Fin T) :
      @Measurable Ω (Fin d → ℝ) (ℋx (t.val + 1)) inferInstance (X t) := by
    rw [hℋ (t.val + 1)]
    intro s hs
    exact MeasurableSpace.measurableSet_generateFrom
      ⟨t, Nat.lt_succ_self t.val, s, hs, rfl⟩
  have hXmeas (t : Fin T) : Measurable (X t) :=
    (hXhist t).mono (ℋx.le (t.val + 1)) le_rfl
  let Target : Set Ω :=
    {ω | ∑ t, self_normalized_leverage X U t ω ≤
      10 * (B + 1) * (Real.sqrt ((d : ℝ) * Ccov * (T : ℝ) *
        Real.log (2 * (T : ℝ) / η)) + Real.log (2 / η))}
  have hTargetMeas : MeasurableSet Target := by
    dsimp only [Target]
    exact smooth_leverage_bound_event_measurable_local X hXmeas U hU _
  have hKupper : (K : ℝ) ≤ Ccov * L + 1 := by
    have hc := Nat.ceil_lt_add_one (a := Ccov * L)
      (mul_nonneg (by linarith) hLpos.le)
    change (K : ℝ) < Ccov * L + 1 at hc
    linarith
  have hsubset : E ⊆ (fun z :
      Ω × (Fin (T * K) → Fin d → ℝ) => z.1) ⁻¹' Target := by
    intro z hz
    have hzMatch : z ∈ Match := hz.1
    have hzGood (j : Fin T) : z ∈ Good j := by
      exact Set.mem_iInter.mp hz.2 j
    obtain ⟨φ, hφ, hφmatch⟩ := hzMatch
    let qfun : Fin T → ℝ := fun t =>
      self_normalized_leverage X U t z.1
    have hqfun (t : Fin T) : 0 ≤ qfun t ∧ qfun t ≤ 1 := by
      dsimp only [qfun]
      exact prefix_gram_leverage_bounds X U hU t z.1
    have hcard (j : Fin T) :
        ((Finset.univ.filter fun t : Fin T =>
          1 / (4 : ℝ) ^ (j.val + 1) ≤ qfun t).card : ℝ) ≤
        B * (Real.sqrt ((T : ℝ) * (K : ℝ) * (d : ℝ) /
          (1 / (4 : ℝ) ^ (j.val + 1))) +
          Real.log (2 * (T : ℝ) / η)) := by
      let s : Finset (Fin T) := Finset.univ.filter fun t : Fin T =>
        1 / (4 : ℝ) ^ (j.val + 1) ≤ qfun t
      let φs : Fin s.card → Fin T := s.orderEmbOfFin rfl
      have hφs : StrictMono φs :=
        (s.orderEmbOfFin rfl).strictMono
      let ψ : Fin s.card → Fin (T * K) := fun i => φ (φs i)
      have hψ : StrictMono ψ := hφ.comp hφs
      have hUpoint (n : Fin (T + 1)) :
          is_moore_penrose_inverse
            (∑ t, if t.val < n.val then
              Matrix.vecMulVec (X t z.1) (X t z.1) else 0) (U n z.1) := by
        simpa only [partial_empirical_gram] using hU n z.1
      obtain ⟨W, hW, hdom⟩ :=
        selected_prefix_leverage_domination_local
          (fun t => X t z.1) (fun n => U n z.1) hUpoint φs hφs
      have hWproposal (m : Fin (s.card + 1)) :
          is_moore_penrose_inverse
            (∑ i, if i.val < m.val then
              Matrix.vecMulVec (Z (ψ i) z) (Z (ψ i) z) else 0) (W m) := by
        have hm := hW m
        convert hm using 1
        apply Finset.sum_congr rfl
        intro i hi
        by_cases him : i.val < m.val
        · simp only [if_pos him]
          have heq : Z (ψ i) z = X (φs i) z.1 := by
            dsimp only [Z, ψ]
            exact (hφmatch (φs i)).symm
          rw [heq]
