@[blueprint "def:mutual-information"
  (statement := /-- Let \(\mu\) be a finite measure on \(\Omega\), and let \(U:\Omega\to S\) and \(V:\Omega\to T\) be measurable random variables. Their mutual information is the extended nonnegative Kullback--Leibler divergence
  \[
    I(U;V):=D\!\left(\mathcal L(U,V)\,\middle\|\,
      \mathcal L(U)\otimes\mathcal L(V)\right).
  \]
  In particular, infinite mutual information retains the value \(+\infty\). -/)
  (title := /-- Mutual information -/)
  (latexEnv := "definition")]
noncomputable def mutual_information
    {Ω S T : Type*} [MeasurableSpace Ω] [MeasurableSpace S] [MeasurableSpace T]
    (μ : Measure Ω) (U : Ω → S) (V : Ω → T) : ENNReal :=
  (InformationTheory.klDiv
    (Measure.map (fun ω => (U ω, V ω)) μ)
    ((Measure.map U μ).prod (Measure.map V μ)))

@[blueprint "def:conditional-mutual-information"
  (statement := /-- Let \(U,V,W\) be measurable random variables on the same finite measure space, and suppose that the codomain of \(V\) is a nonempty standard Borel space. Let \(K(w,\cdot)=\mathcal L(V\mid W=w)\) be a regular conditional law. Their conditional mutual information is the extended nonnegative divergence
  \[
    I(U;V\mid W)
      :=D\!\left(\mathcal L((U,W),V)\,\middle\|\,
        \mathcal L(U,W)\otimes_W K\right).
  \]
  This direct conditional-KL definition remains meaningful when either side of a corresponding chain rule is infinite and never forms the indeterminate difference \(+\infty-+\infty\). -/)
  (title := /-- Conditional mutual information -/)
  (latexEnv := "definition")]
noncomputable def conditional_mutual_information
    {Ω S T R : Type*} [MeasurableSpace Ω] [MeasurableSpace S]
    [MeasurableSpace T] [StandardBorelSpace T] [Nonempty T]
    [MeasurableSpace R]
    (μ : Measure Ω) [IsFiniteMeasure μ]
    (U : Ω → S) (V : Ω → T) (W : Ω → R) : ENNReal :=
  InformationTheory.klDiv
    (Measure.map (fun ω => ((U ω, W ω), V ω)) μ)
    ((Measure.map (fun ω => (U ω, W ω)) μ).compProd
      (ProbabilityTheory.Kernel.prodMkLeft S
        (ProbabilityTheory.condDistrib V W μ)))

@[blueprint "def:conditional-independence-given"
  (statement := /-- Let \(U:\Omega\to S\), \(V:\Omega\to T\), and \(W:\Omega\to R\) be measurable random variables on a finite measure space. They are conditionally independent given \(W\) if, for every event \(E\) generated by \(U\) and every event \(F\) generated by \(V\),
  \[
    \mathbb E[\mathbf 1_{E\cap F}\mid\sigma(W)]
      =\mathbb E[\mathbf 1_E\mid\sigma(W)]
        \mathbb E[\mathbf 1_F\mid\sigma(W)]
    \quad\text{almost surely}.
  \]
  This is the measure-theoretic Markov condition and does not rely on subtracting mutual informations. -/)
  (title := /-- Conditional independence given a random variable -/)
  (latexEnv := "definition")]
def conditional_independence_given
    {Ω S T R : Type*} [MeasurableSpace Ω] [MeasurableSpace S]
    [MeasurableSpace T] [MeasurableSpace R]
    (μ : Measure Ω) [IsFiniteMeasure μ]
    (U : Ω → S) (V : Ω → T) (W : Ω → R) : Prop :=
  Measurable U ∧ Measurable V ∧ Measurable W ∧
    ∀ s t,
      MeasurableSet[MeasurableSpace.comap U ‹MeasurableSpace S›] s →
      MeasurableSet[MeasurableSpace.comap V ‹MeasurableSpace T›] t →
      (μ[(s ∩ t).indicator (fun _ => (1 : ℝ)) |
        MeasurableSpace.comap W ‹MeasurableSpace R›]) =ᵐ[μ]
        (μ[s.indicator (fun _ => (1 : ℝ)) |
          MeasurableSpace.comap W ‹MeasurableSpace R›]) *
          (μ[t.indicator (fun _ => (1 : ℝ)) |
            MeasurableSpace.comap W ‹MeasurableSpace R›])

@[blueprint "def:total-variation-distance"
  (statement := /-- For finite measures \(\nu\) and \(\xi\) on a measurable space \(S\), their total-variation distance is
  \[
    d_{\mathrm{TV}}(\nu,\xi)
      :=\sup_{E\in\mathcal S}|\nu(E)-\xi(E)|.
  \]
  In the applications below, both measures are conditional probability measures. -/)
  (title := /-- Total-variation distance -/)
  (latexEnv := "definition")]
noncomputable def total_variation_distance
    {S : Type*} [MeasurableSpace S] (ν ξ : Measure S) : ℝ :=
  sSup {r : ℝ | ∃ E : Set S, MeasurableSet E ∧
    r = |(ν E).toReal - (ξ E).toReal|}

@[blueprint "def:strong-data-processing-inequality"
  (statement := /-- Let \(A:\Omega\to S\) and \(B:\Omega\to T\) be measurable random variables on a finite measure space. They satisfy the \(\rho\)-strong data processing inequality if \(0\leq\rho\leq1\) and the following assertion holds for every measurable space \(N\) and every Markov kernel \(K:T\rightsquigarrow N\). On the induced measure
  \[
    \nu_K(d\omega,dz):=\mu(d\omega)K(B(\omega),dz),
  \]
  write \(Z(\omega,z)=z\), \(A'(\omega,z)=A(\omega)\), and \(B'(\omega,z)=B(\omega)\). Then
  \[
    I_{\nu_K}(Z;A')\leq \rho I_{\nu_K}(Z;B').
  \]
  Quantification over kernels includes every possibly randomized postprocessing of \(B\), independently of whether the original space \(\Omega\) carries auxiliary randomness. -/)
  (title := /-- Strong data processing inequality -/)
  (latexEnv := "definition")]
def strong_data_processing_inequality
    {Ω S T : Type*} [MeasurableSpace Ω] [MeasurableSpace S] [MeasurableSpace T]
    (μ : Measure Ω) [IsFiniteMeasure μ]
    (A : Ω → S) (B : Ω → T) (ρ : ℝ) : Prop :=
  Measurable A ∧ Measurable B ∧ 0 ≤ ρ ∧ ρ ≤ 1 ∧
      ∀ (N : Type) [MeasurableSpace N]
        (K : ProbabilityTheory.Kernel T N)
        [ProbabilityTheory.IsMarkovKernel K] (hB : Measurable B),
        let ν := μ.compProd (ProbabilityTheory.Kernel.comap K B hB)
        mutual_information ν Prod.snd (fun ωz => A ωz.1) ≤
          ENNReal.ofReal ρ *
            mutual_information ν Prod.snd (fun ωz => B ωz.1)

@[blueprint "def:approximate-strong-data-processing-inequality"
  (statement := /-- Let \(A:\Omega\to S\) and \(B:\Omega\to T\) be measurable random variables on a probability space. Assume that the topology on \(S\) is Hausdorff and second countable and that its Borel \(\sigma\)-algebra is the specified measurable structure. They satisfy the \((\rho,\delta)\)-approximate strong data processing inequality if \(0\leq\delta\leq1\), and there exists a probability measure \(\kappa\) on the coupling space \((S\times T)\times T\). Write \(A'\), \(B'\), and \(\widetilde B\) for its three coordinate variables. The first-coordinate marginal of \(\kappa\) must satisfy
  \[
    \mathcal L_\kappa(A',B')=\mathcal L_\mu(A,B),
  \]
  the pair \((A',\widetilde B)\) satisfies the \(\rho\)-strong data processing inequality, and
  \[
    d_{\mathrm{TV}}\bigl(\mathcal L_\kappa(\widetilde B\mid A'=a),
      \mathcal L_\kappa(B'\mid A'=a)\bigr)\leq\delta
  \]
  for every \(a\) in the topological support of the law of \(A'\). Thus the coupling law may contain randomness absent from the original space. The marginal identity is exactly the coupling condition, and the Borel compatibility and countability assumptions make the support part of the probabilistic structure rather than an independently chosen topology. -/)
  (title := /-- Approximate strong data processing inequality -/)
  (latexEnv := "definition")]
noncomputable def approximate_strong_data_processing_inequality
    {Ω S T : Type*} [MeasurableSpace Ω] [TopologicalSpace S]
    [MeasurableSpace S] [BorelSpace S] [SecondCountableTopology S] [T2Space S]
    [MeasurableSpace T] [StandardBorelSpace T] [Nonempty T]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (A : Ω → S) (B : Ω → T) (ρ δ : ℝ) : Prop :=
  Measurable A ∧ Measurable B ∧ 0 ≤ δ ∧ δ ≤ 1 ∧
    ∃ (κ : Measure ((S × T) × T)) (hκ : IsProbabilityMeasure κ),
      letI : IsProbabilityMeasure κ := hκ
      Measure.map Prod.fst κ =
          Measure.map (fun ω => (A ω, B ω)) μ ∧
        strong_data_processing_inequality κ
          (fun z => z.1.1) Prod.snd ρ ∧
        ∀ a ∈ (Measure.map (fun z => z.1.1) κ).support,
          total_variation_distance
            (ProbabilityTheory.condDistrib Prod.snd (fun z => z.1.1) κ a)
            (ProbabilityTheory.condDistrib (fun z => z.1.2)
              (fun z => z.1.1) κ a) ≤ δ

@[blueprint "def:information-error-penalty"
  (statement := /-- Let \(\mathcal M\) be an arbitrary model space and let \(\eta\geq0\). Define the extended-real information-error penalty by
  \[
    q_{\mathcal M}(\eta):=
    \begin{cases}
      0,&\eta=0,\\
      8\eta\log\!\left(\dfrac{|\mathcal M|}{\eta}\right),
        &\eta>0\text{ and }|\mathcal M|<\infty,\\
      +\infty,&\eta>0\text{ and }|\mathcal M|=\infty.
    \end{cases}
  \]
  In particular, this definition incorporates the source convention
  \(0\log(\infty/0)=0\). -/)
  (title := /-- Information-error penalty -/)
  (latexEnv := "definition")]
noncomputable def information_error_penalty (M : Type*) (η : ℝ) : EReal :=
  letI : Decidable (Finite M) := Classical.propDecidable (Finite M)
  if η = 0 then 0
  else if Finite M then
    ((8 * η * Real.log ((Nat.card M : ℝ) / η) : ℝ) : EReal)
  else ⊤

@[blueprint "def:learning-problem-sampling-law"
  (statement := /-- Fix a sample size \(n\), a probability measure \(\Psi\) on the parameter space \(\Theta\), and a Markov kernel \(\theta\mapsto\mathcal P_\theta\) from \(\Theta\) to the example space \(\mathcal X\). Measurable random variables
  \[
    \theta:\Omega\to\Theta,\qquad
    X_{1:n}:\Omega\to\mathcal X^n,\qquad
    X:\Omega\to\mathcal X
  \]
  obey the learning-problem sampling law when, for every measurable \(A\subseteq\Theta\), every family of measurable sets \(B_i\subseteq\mathcal X\), and every measurable \(C\subseteq\mathcal X\),
  \[
    \mu\{\theta\in A,\ X_i\in B_i\ (1\leq i\leq n),\ X\in C\}
      =\int_A\left(\prod_{i=1}^n\mathcal P_\vartheta(B_i)\right)
        \mathcal P_\vartheta(C)\,\Psi(d\vartheta).
  \]
  Thus \(\theta\) has law \(\Psi\); conditional on \(\theta=\vartheta\), the training coordinates are independent with common law \(\mathcal P_\vartheta\), and \(X\) is a fresh independent draw from that same law. -/)
  (title := /-- Sampling law of an average-case learning problem -/)
  (latexEnv := "definition")]
noncomputable def learning_problem_sampling_law
    {Ω Θ X : Type*} [MeasurableSpace Ω] [MeasurableSpace Θ] [MeasurableSpace X]
    (n : ℕ) (μ : Measure Ω) (Ψ : Measure Θ)
    (P : ProbabilityTheory.Kernel Θ X)
    (parameter : Ω → Θ) (training : Ω → Fin n → X) (test : Ω → X) : Prop :=
  IsProbabilityMeasure Ψ ∧ ProbabilityTheory.IsMarkovKernel P ∧
    Measurable parameter ∧ Measurable training ∧ Measurable test ∧
      ∀ (A : Set Θ) (B : Fin n → Set X) (C : Set X),
        MeasurableSet A → (∀ i, MeasurableSet (B i)) → MeasurableSet C →
          μ {ω |
              parameter ω ∈ A ∧
                (∀ i, training ω i ∈ B i) ∧ test ω ∈ C} =
            ∫⁻ θ in A, (∏ i, P θ (B i)) * P θ C ∂Ψ

@[blueprint "def:learning-algorithm"
  (statement := /-- Let \(\mathcal T\) be the training-sample space and \(\mathcal M\) the model space. A possibly randomized learning algorithm is a Markov kernel
  \[
    K:\mathcal T\rightsquigarrow\mathcal M.
  \]
  Thus \(K(t,\cdot)\) is a probability measure for every training sample \(t\), and the map \(t\mapsto K(t,E)\) is measurable for every measurable \(E\subseteq\mathcal M\). In particular, all randomization is private to the algorithm and its conditional output law depends jointly on the problem variables only through the training sample. -/)
  (title := /-- Randomized learning algorithm -/)
  (latexEnv := "definition")]
structure learning_algorithm
    (Train M : Type*) [MeasurableSpace Train] [MeasurableSpace M] where
  kernel : ProbabilityTheory.Kernel Train M
  markov : ProbabilityTheory.IsMarkovKernel kernel

@[blueprint "def:learning-algorithm-joint-measure"
  (statement := /-- Let \(\mu\) be the joint law of the problem variables on \(\Omega\), let \(T:\Omega\to\mathcal T\) be the measurable training sample, and let \(K:\mathcal T\rightsquigarrow\mathcal M\) be a randomized learning algorithm. The joint law of the original outcome and the algorithm output is
  \[
    \nu_K(d\omega,dz):=\mu(d\omega)K(T(\omega),dz).
  \]
  Under \(\nu_K\), the output coordinate is conditionally independent of the entire collection of non-training problem variables given \(T\); this is the joint postprocessing condition required of a randomized algorithm. -/)
  (title := /-- Joint law induced by a randomized learning algorithm -/)
  (latexEnv := "definition")]
noncomputable def learning_algorithm_joint_measure
    {Ω Train M : Type*} [MeasurableSpace Ω] [MeasurableSpace Train]
    [MeasurableSpace M]
    (μ : Measure Ω) (training : Ω → Train) (hTraining : Measurable training)
    (algorithm : learning_algorithm Train M) : Measure (Ω × M) :=
  μ.compProd (ProbabilityTheory.Kernel.comap algorithm.kernel training hTraining)

@[blueprint "def:classification-error"
  (statement := /-- Let \(Z:\Omega\to\mathcal M\) be the output of a learning algorithm, let \(X:\Omega\to\mathcal X\) be a fresh positive example, and let \(e:\mathcal M\to\mathcal X\to\{0,1\}\) be the model evaluation map, where \(1\) is the positive label. The source's balanced labeled test distribution draws a positive pair \((Z,X)\) from its joint law with probability \(1/2\), and draws a negative pair from the product of the marginals of \(Z\) and \(X\) with probability \(1/2\). Its average classification error is therefore
  \[
    \operatorname{err}(Z)
      :=\frac12\Pr[e(Z,X)=0]
        +\frac12\bigl(\mathcal L(Z)\otimes\mathcal L(X)\bigr)
          \{(z,x):e(z,x)=1\}.
  \] -/)
  (title := /-- Average classification error -/)
  (latexEnv := "definition")]
noncomputable def classification_error
    {Ω X M : Type*} [MeasurableSpace Ω] [MeasurableSpace X] [MeasurableSpace M]
    (μ : Measure Ω) (output : Ω → M) (test : Ω → X)
    (predict : M → X → Bool) : ℝ :=
  ((μ {ω | predict (output ω) (test ω) = false}).toReal +
    (((Measure.map output μ).prod (Measure.map test μ))
      {pair | predict pair.1 pair.2 = true}).toReal) / 2

@[blueprint "def:excess-memorization"
  (statement := /-- The average-case excess memorization of an algorithm \(\mathcal A\) is the conditional mutual information
  \[
    \operatorname{mem}_n(\mathcal A,\mathbf P)
      := I(\mathcal A(X_{1:n});X_{1:n}\mid\theta).
  \] -/)
  (title := /-- Average-case excess memorization -/)
  (latexEnv := "definition")]
noncomputable def excess_memorization
    {Ω Θ Train M : Type*} [MeasurableSpace Ω] [MeasurableSpace Θ]
    [MeasurableSpace Train] [StandardBorelSpace Train]
    [Nonempty Train] [MeasurableSpace M]
    (μ : Measure Ω) [IsFiniteMeasure μ]
    (parameter : Ω → Θ) (training : Ω → Train)
    (hTraining : Measurable training)
    (algorithm : learning_algorithm Train M) : ENNReal :=
  letI : ProbabilityTheory.IsMarkovKernel algorithm.kernel := algorithm.markov
  let κ := ProbabilityTheory.Kernel.comap algorithm.kernel training hTraining
  letI : ProbabilityTheory.IsMarkovKernel κ := inferInstance
  letI : ProbabilityTheory.IsFiniteKernel κ := inferInstance
  let ν := μ.compProd κ
  letI : IsFiniteMeasure ν := inferInstance
  conditional_mutual_information ν Prod.snd
    (fun ωz => training ωz.1) (fun ωz => parameter ωz.1)

@[blueprint "def:excess-memorization-correction"
  (statement := /-- For SDPI parameters \(\tau,\epsilon,\rho,\delta\), define
  \[
    \operatorname{neg}_n
      :=\frac{1-\tau}{\rho}q_{\mathcal M}(\delta)
        +q_{\mathcal M}(\epsilon).
  \]
  Thus this definition agrees with
  \(8\delta(1-\tau)\rho^{-1}\log(|\mathcal M|/\delta)
    +8\epsilon\log(|\mathcal M|/\epsilon)\). -/)
  (title := /-- Excess-memorization correction term -/)
  (latexEnv := "definition")]
noncomputable def excess_memorization_correction
    (M : Type*) (τ ε ρ δ : ℝ) : EReal :=
  (((1 - τ) / ρ : ℝ) : EReal) * information_error_penalty M δ +
    information_error_penalty M ε

@[blueprint "def:classification-capacity-constant"
  (statement := /-- Define the extended-real classification capacity constant by
  \[
    C_\alpha:=
    \begin{cases}
      +\infty,&\alpha\leq0,\\
      (1-2\alpha)\log\!\left(\dfrac{1-\alpha}{\alpha}\right),
        &\alpha>0.
    \end{cases}
  \]
  On \(0<\alpha<1/2\), this is the logarithmic capacity appearing in the binary Fano bound. The value \(+\infty\) at \(\alpha\leq0\) records that a strictly nonpositive classification error is impossible, with zero error forcing singularity. -/)
  (title := /-- Classification capacity constant -/)
  (latexEnv := "definition")]
noncomputable def classification_capacity_constant (α : ℝ) : EReal :=
  if α ≤ 0 then ⊤
  else (((1 - 2 * α) * Real.log ((1 - α) / α) : ℝ) : EReal)

@[blueprint "def:minimal-necessary-memorization"
  (statement := /-- Fix the balanced labeled fresh-test distribution of \cref{def:classification-error} and a measurable prediction map for the model space. For an error level \(\alpha\), the minimal necessary memorization is the infimum of the excess memorization over all Markov kernels from the training-sample space to the model space whose balanced average classification error is at most \(\alpha\):
  \[
    \operatorname{mem}_n(\mathbf P,\alpha)
      :=\inf_{\mathcal A:\,
        \operatorname{err}(\mathcal A,\mathbf P)\leq\alpha}
        \operatorname{mem}_n(\mathcal A,\mathbf P).
  \]
  The infimum is taken in the extended reals and hence equals \(+\infty\) if no admissible algorithm exists. -/)
  (title := /-- Minimal necessary memorization -/)
  (latexEnv := "definition")]
noncomputable def minimal_necessary_memorization
    {Ω Θ X Train M : Type*} [MeasurableSpace Ω] [MeasurableSpace Θ]
    [MeasurableSpace X] [MeasurableSpace Train] [StandardBorelSpace Train]
    [Nonempty Train] [MeasurableSpace M]
    (μ : Measure Ω) [IsFiniteMeasure μ]
    (parameter : Ω → Θ) (training : Ω → Train)
    (test : Ω → X) (hTraining : Measurable training) (hTest : Measurable test)
    (predict : M → X → Bool)
    (hPredict : Measurable (fun pair : M × X => predict pair.1 pair.2))
    (α : ℝ) : EReal :=
  ⨅ algorithm : learning_algorithm Train M,
    let ν := learning_algorithm_joint_measure μ training hTraining algorithm
    if classification_error ν Prod.snd (fun ωz => test ωz.1) predict ≤ α then
      (excess_memorization μ parameter training hTraining algorithm : EReal)
    else ⊤

@[blueprint "def:finite-output-shannon-entropy"
  (statement := /-- Let \(\nu\) be a finite measure on a finite measurable space \(\mathcal M\) whose singletons are measurable. Its finite-output Shannon entropy is
  \[
    H(\nu):=-\sum_{m\in\mathcal M}\nu(\{m\})
      \log \nu(\{m\}),
  \]
  where the convention \(0\log 0=0\) is implemented by the real logarithm. -/)
  (title := /-- Shannon entropy of a finite-output measure -/)
  (latexEnv := "definition")]
noncomputable def finite_output_shannon_entropy
    {M : Type*} [MeasurableSpace M] [MeasurableSingletonClass M] [Finite M]
    (ν : Measure M) : ℝ :=
  letI := Fintype.ofFinite M
  ∑ m : M, -(ν {m}).toReal * Real.log (ν {m}).toReal

@[blueprint "lem:finite-output-entropy-continuity"
  (statement := /-- Let \(\nu\) and \(\xi\) be probability measures on a finite measurable space \(\mathcal M\) whose singletons are measurable. If \(0\leq\delta\leq1\) and \(d_{\mathrm{TV}}(\nu,\xi)\leq\delta\), then
  \[
    |H(\nu)-H(\xi)|
      \leq4\delta\log\!\left(\frac{|\mathcal M|}{\delta}\right).
  \]
  At \(\delta=0\), the right-hand side is interpreted as zero. -/)
  (proof := /-- Put \(p_m=\nu(\{m\})\), \(q_m=\xi(\{m\})\), and
  \(d_m=|p_m-q_m|\).  The probability hypotheses give
  \(\sum_m p_m=\sum_m q_m=1\).  From
  \cref{def:total-variation-distance}, applied to the measurable set
  \(\{m:p_m\geq q_m\}\), one obtains
  \[
    s:=\sum_m d_m
      =2\sum_{p_m\geq q_m}(p_m-q_m)\leq2\delta.
  \]

  Write \(f(x)=-x\log x\).  If \(0\leq x\leq y\leq1\), the identity
  \(f(uv)=v f(u)+u f(v)\), nonnegativity of \(f\) on \([0,1]\), and
  \(f(u)\leq1-u\) imply
  \[
    f(y)-f(x)\leq f(y-x),\qquad f(x)-f(y)\leq y-x.
  \]
  Interchanging \(x\) and \(y\) therefore gives
  \[
    |f(x)-f(y)|\leq f(|x-y|)+|x-y|.
  \]
  The triangle inequality and concavity of \(f\), followed by Jensen's
  inequality with equal weights, now yield, with
  \(N=|\mathcal M|\),
  \[
    |H(\nu)-H(\xi)|
      \leq\sum_m f(d_m)+s
      \leq N f(s/N)+s.
  \]
  The probability hypotheses force \(N\geq1\).  For \(N=1\), the two
  mass functions coincide and the conclusion follows directly from
  \cref{def:finite-output-shannon-entropy}.  Suppose \(N\geq2\).
  The preceding scalar estimate also shows that
  \(x\mapsto Nf(x/N)+x\) is nondecreasing on \([0,2]\).  Hence
  \(s\leq2\delta\) gives
  \[
    Nf(s/N)+s\leq Nf(2\delta/N)+2\delta
      =2\delta\bigl(1+\log(N/\delta)-\log2\bigr)
      \leq4\delta\log(N/\delta).
  \]
  In the last step, \(N/\delta\geq2\) and
  \(2\log2\geq1\).  If \(\delta=0\), the bound \(s\leq0\) instead
  forces every \(d_m\) to vanish, so both sides of the desired
  inequality are zero. -/)
  (title := /-- Continuity of finite-output Shannon entropy -/)
  (latexEnv := "lemma")]
lemma finite_output_entropy_continuity
    {M : Type*} [MeasurableSpace M] [MeasurableSingletonClass M] [Finite M]
    (ν ξ : Measure M) [IsProbabilityMeasure ν] [IsProbabilityMeasure ξ]
    (δ : ℝ) (hδ : 0 ≤ δ ∧ δ ≤ 1)
    (hTV : total_variation_distance ν ξ ≤ δ) :
    |finite_output_shannon_entropy ν - finite_output_shannon_entropy ξ| ≤
      4 * δ * Real.log ((Nat.card M : ℝ) / δ) := by
  classical
  have hdir : ∀ x y : ℝ, 0 ≤ x → y ≤ 1 → x ≤ y →
      Real.negMulLog y - Real.negMulLog x ≤ Real.negMulLog (y - x) ∧
      Real.negMulLog x - Real.negMulLog y ≤ y - x := by
    intro x y hx0 hy1 hxy
    have hy0 : 0 ≤ y := hx0.trans hxy
    have hd0 : 0 ≤ y - x := sub_nonneg.mpr hxy
    have hdy : y - x ≤ y := by linarith
    by_cases hyz : y = 0
    · have hxz : x = 0 := by linarith
      simp [hyz, hxz]
    · let a : ℝ := x / y
      let b : ℝ := (y - x) / y
      have hypos : 0 < y := lt_of_le_of_ne hy0 (Ne.symm hyz)
      have ha0 : 0 ≤ a := div_nonneg hx0 hy0
      have ha1 : a ≤ 1 := (div_le_one hypos).mpr hxy
      have hb0 : 0 ≤ b := div_nonneg hd0 hy0
      have hb1 : b ≤ 1 := (div_le_one hypos).mpr hdy
      have hab : a + b = 1 := by
        dsimp [a, b]
        field_simp
        ring
      have hax : a * y = x := by
        dsimp [a]
        field_simp
      have hbd : b * y = y - x := by
        dsimp [b]
        field_simp
      have hfx : Real.negMulLog x =
          y * Real.negMulLog a + a * Real.negMulLog y := by
        rw [← hax, Real.negMulLog_mul]
      have hfd : Real.negMulLog (y - x) =
          y * Real.negMulLog b + b * Real.negMulLog y := by
        rw [← hbd, Real.negMulLog_mul]
      have hfa0 := Real.negMulLog_nonneg ha0 ha1
      have hfb0 := Real.negMulLog_nonneg hb0 hb1
      have hfy0 := Real.negMulLog_nonneg hy0 hy1
      have hsub : Real.negMulLog y - Real.negMulLog x ≤
          Real.negMulLog (y - x) := by
        nlinarith [mul_nonneg hy0 (add_nonneg hfa0 hfb0)]
      have hfa_le := Real.negMulLog_le_one_sub_self ha0
      have hmul : y * Real.negMulLog a ≤ y * (1 - a) :=
        mul_le_mul_of_nonneg_left hfa_le hy0
      have hyone : y * (1 - a) = y - x := by
        rw [mul_sub, mul_one]
        nlinarith [hax]
      have hrev : Real.negMulLog x - Real.negMulLog y ≤ y - x := by
        nlinarith [mul_nonneg (sub_nonneg.mpr ha1) hfy0]
      exact ⟨hsub, hrev⟩
  have hscalar : ∀ x y : ℝ, 0 ≤ x → x ≤ 1 → 0 ≤ y → y ≤ 1 →
      |Real.negMulLog x - Real.negMulLog y| ≤
        Real.negMulLog |x - y| + |x - y| := by
    intro x y hx0 hx1 hy0 hy1
    rcases le_total x y with hxy | hyx
    · have hd0 : 0 ≤ y - x := sub_nonneg.mpr hxy
      have hd1 : y - x ≤ 1 := by linarith
      have hnon := Real.negMulLog_nonneg hd0 hd1
      have h := hdir x y hx0 hy1 hxy
      rw [abs_of_nonpos (sub_nonpos.mpr hxy), neg_sub]
      apply abs_le.mpr
      constructor <;> nlinarith
    · have hd0 : 0 ≤ x - y := sub_nonneg.mpr hyx
      have hd1 : x - y ≤ 1 := by linarith
      have hnon := Real.negMulLog_nonneg hd0 hd1
      have h := hdir y x hy0 hx1 hyx
      rw [abs_of_nonneg (sub_nonneg.mpr hyx)]
      apply abs_le.mpr
      constructor <;> nlinarith
  have hlog_bound : ∀ N e : ℝ, 2 ≤ N → 0 < e → e ≤ 1 →
      N * Real.negMulLog (2 * e / N) + 2 * e ≤
        4 * e * Real.log (N / e) := by
    intro N e hN he he1
    have hNpos : 0 < N := lt_of_lt_of_le (by norm_num) hN
    have hN0 : N ≠ 0 := ne_of_gt hNpos
    have he0 : e ≠ 0 := ne_of_gt he
    have htwoe : 2 * e ≤ N := by nlinarith
    have hratio : 2 ≤ N / e := (le_div_iff₀ he).2 htwoe
    have hlogmono : Real.log 2 ≤ Real.log (N / e) :=
      Real.log_le_log (by norm_num) hratio
    have hhalf := Real.log_lt_sub_one_of_pos
      (x := (1 / 2 : ℝ)) (by norm_num) (by norm_num)
    have hloginv : Real.log (1 / 2 : ℝ) = -Real.log 2 := by
      rw [show (1 / 2 : ℝ) = (2 : ℝ)⁻¹ by norm_num, Real.log_inv]
    have hlogtwo : 1 ≤ 2 * Real.log 2 := by
      rw [hloginv] at hhalf
      linarith
    have hbase : 1 + Real.log (N / e) - Real.log 2 ≤
        2 * Real.log (N / e) := by linarith
    have harg : Real.log (2 * e / N) =
        Real.log 2 + Real.log e - Real.log N := by
      rw [Real.log_div (mul_ne_zero (by norm_num) he0) hN0,
        Real.log_mul (by norm_num) he0]
    have hquot : Real.log (N / e) = Real.log N - Real.log e :=
      Real.log_div hN0 he0
    calc
      N * Real.negMulLog (2 * e / N) + 2 * e =
          2 * e * (1 + Real.log (N / e) - Real.log 2) := by
            rw [Real.negMulLog_eq_neg]
            change N * (-(2 * e / N * Real.log (2 * e / N))) + 2 * e =
              2 * e * (1 + Real.log (N / e) - Real.log 2)
            rw [harg, hquot]
            field_simp
            ring
      _ ≤ 2 * e * (2 * Real.log (N / e)) :=
        mul_le_mul_of_nonneg_left hbase (by positivity)
      _ = 4 * e * Real.log (N / e) := by ring
  letI := Fintype.ofFinite M
  let p : M → ℝ := fun m => (ν {m}).toReal
  let q : M → ℝ := fun m => (ξ {m}).toReal
  have hp0 : ∀ m, 0 ≤ p m := fun _ => ENNReal.toReal_nonneg
  have hq0 : ∀ m, 0 ≤ q m := fun _ => ENNReal.toReal_nonneg
  have hp1 : ∀ m, p m ≤ 1 := fun _ => measureReal_le_one
  have hq1 : ∀ m, q m ≤ 1 := fun _ => measureReal_le_one
  have hpsum : ∑ m, p m = 1 := by
    simpa [p, Measure.real, measure_univ] using
      (sum_measureReal_singleton (μ := ν) (Finset.univ : Finset M))
  have hqsum : ∑ m, q m = 1 := by
    simpa [q, Measure.real, measure_univ] using
      (sum_measureReal_singleton (μ := ξ) (Finset.univ : Finset M))
  have hM : Nonempty M := by
    by_contra h
    haveI : IsEmpty M := not_nonempty_iff.mp h
    simpa using hpsum
  have hjensen : ∀ (f : M → ℝ), (∀ i, 0 ≤ f i) →
      (∑ i, Real.negMulLog (f i)) ≤
        (Fintype.card M : ℝ) *
          Real.negMulLog ((∑ i, f i) / (Fintype.card M : ℝ)) := by
    intro f hf
    let N : ℝ := Fintype.card M
    have hNpos : 0 < N := by
      dsimp [N]
      exact_mod_cast Fintype.card_pos
    have hN0 : N ≠ 0 := ne_of_gt hNpos
    have hw : ∑ _ : M, N⁻¹ = 1 := by
      simp [N, hN0]
    have hj : (∑ i, N⁻¹ * Real.negMulLog (f i)) ≤
        Real.negMulLog (∑ i, N⁻¹ * f i) := by
      simpa [smul_eq_mul, N] using
        (Real.concaveOn_negMulLog.le_map_sum
          (t := Finset.univ)
          (w := fun _ : M => N⁻¹)
          (p := f)
          (fun _ _ => inv_nonneg.mpr (Nat.cast_nonneg _))
          (by simpa using hw)
          (fun i _ => hf i))
    have hmul := mul_le_mul_of_nonneg_left hj (le_of_lt hNpos)
    calc
      (∑ i, Real.negMulLog (f i)) =
          N * ∑ i, N⁻¹ * Real.negMulLog (f i) := by
            rw [← Finset.mul_sum]
            field_simp
      _ ≤ N * Real.negMulLog (∑ i, N⁻¹ * f i) := hmul
      _ = N * Real.negMulLog ((∑ i, f i) / N) := by
            rw [← Finset.mul_sum]
            congr 2
            field_simp
  let d : M → ℝ := fun m => |p m - q m|
  let s : ℝ := ∑ m, d m
  have hd0 : ∀ m, 0 ≤ d m := fun _ => abs_nonneg _
  have hs0 : 0 ≤ s := Finset.sum_nonneg fun _ _ => abs_nonneg _
  have hbdd : BddAbove {r : ℝ | ∃ E : Set M, MeasurableSet E ∧
      r = |(ν E).toReal - (ξ E).toReal|} := by
    refine ⟨1, ?_⟩
    rintro r ⟨E, _, rfl⟩
    have hν0 : 0 ≤ (ν E).toReal := ENNReal.toReal_nonneg
    have hξ0 : 0 ≤ (ξ E).toReal := ENNReal.toReal_nonneg
    have hν1 : (ν E).toReal ≤ 1 := measureReal_le_one
    have hξ1 : (ξ E).toReal ≤ 1 := measureReal_le_one
    rw [abs_le]
    constructor <;> linarith
  have hevent : ∀ E : Set M, MeasurableSet E →
      |(ν E).toReal - (ξ E).toReal| ≤ δ := by
    intro E hE
    exact (le_csSup hbdd ⟨E, hE, rfl⟩).trans hTV
  let A : Finset M := Finset.univ.filter (fun m => 0 ≤ p m - q m)
  have hνA : (ν (A : Set M)).toReal = ∑ m ∈ A, p m := by
    symm
    simpa [p, Measure.real] using sum_measureReal_singleton (μ := ν) A
  have hξA : (ξ (A : Set M)).toReal = ∑ m ∈ A, q m := by
    symm
    simpa [q, Measure.real] using sum_measureReal_singleton (μ := ξ) A
  have hpos_le : ∑ m ∈ A, (p m - q m) ≤ δ := by
    have h := hevent (A : Set M) A.finite_toSet.measurableSet
    rw [hνA, hξA] at h
    rw [Finset.sum_sub_distrib]
    exact le_of_abs_le h
  have hdiffsum : ∑ m, (p m - q m) = 0 := by
    rw [Finset.sum_sub_distrib, hpsum, hqsum, sub_self]
  have hsum_abs : s = 2 * ∑ m ∈ A, (p m - q m) := by
    have hpoint : ∀ m, |p m - q m| =
        2 * (if 0 ≤ p m - q m then p m - q m else 0) -
          (p m - q m) := by
      intro m
      by_cases hm : 0 ≤ p m - q m
      · simp [hm, abs_of_nonneg hm]
        ring
      · have hm' : p m - q m ≤ 0 := le_of_not_ge hm
        simp [hm, abs_of_nonpos hm']
    dsimp [s, d]
    calc
      (∑ m, |p m - q m|) =
          ∑ m, (2 * (if 0 ≤ p m - q m then p m - q m else 0) -
            (p m - q m)) := by
              apply Finset.sum_congr rfl
              intro m _
              exact hpoint m
      _ = 2 * ∑ m, (if 0 ≤ p m - q m then p m - q m else 0) -
          ∑ m, (p m - q m) := by
            rw [Finset.sum_sub_distrib, Finset.mul_sum]
      _ = 2 * ∑ m ∈ A, (p m - q m) := by
            rw [hdiffsum, sub_zero]
            simp only [A, Finset.sum_filter]
  have hs_le : s ≤ 2 * δ := by
    rw [hsum_abs]
    gcongr
  by_cases hcard : Fintype.card M = 1
  · obtain ⟨m, hm⟩ := Fintype.card_eq_one_iff.mp hcard
    have huniv : (Finset.univ : Finset M) = {m} := by
      ext x
      simp [hm x]
    have hpm : p m = 1 := by
      simpa [huniv] using hpsum
    have hqm : q m = 1 := by
      simpa [huniv] using hqsum
    have hpq : p = q := by
      funext x
      rw [hm x, hpm, hqm]
    have hent_eq : finite_output_shannon_entropy ν =
        finite_output_shannon_entropy ξ := by
      simp only [finite_output_shannon_entropy]
      change (∑ x, Real.negMulLog (p x)) =
        ∑ x, Real.negMulLog (q x)
      rw [hpq]
    rw [hent_eq, sub_self, abs_zero]
    by_cases he : δ = 0
    · simp [he]
    · have hepos : 0 < δ := lt_of_le_of_ne hδ.1 (Ne.symm he)
      have hratio : 1 ≤ (Nat.card M : ℝ) / δ := by
        rw [Nat.card_eq_fintype_card, hcard]
        apply (le_div_iff₀ hepos).2
        simpa using hδ.2
      exact mul_nonneg (mul_nonneg (by positivity) hδ.1)
        (Real.log_nonneg hratio)
  · have hcardpos : 0 < Fintype.card M := Fintype.card_pos
    have hcard2nat : 2 ≤ Fintype.card M := by omega
    have hcard2 : (2 : ℝ) ≤ (Fintype.card M : ℝ) := by exact_mod_cast hcard2nat
    by_cases he : δ = 0
    · subst δ
      have hs_eq : s = 0 := by linarith
      have hd_fun : d = 0 :=
        (Fintype.sum_eq_zero_iff_of_nonneg hd0).mp hs_eq
      have hpq : p = q := by
        funext m
        have hm := congrFun hd_fun m
        dsimp [d] at hm
        exact sub_eq_zero.mp (abs_eq_zero.mp hm)
      have hent_eq : finite_output_shannon_entropy ν =
          finite_output_shannon_entropy ξ := by
        simp only [finite_output_shannon_entropy]
        change (∑ x, Real.negMulLog (p x)) =
          ∑ x, Real.negMulLog (q x)
        rw [hpq]
      simp [hent_eq]
    · have hepos : 0 < δ := lt_of_le_of_ne hδ.1 (Ne.symm he)
      have hent : |finite_output_shannon_entropy ν -
          finite_output_shannon_entropy ξ| ≤
          ∑ m, |Real.negMulLog (p m) - Real.negMulLog (q m)| := by
        simp only [finite_output_shannon_entropy]
        change |(∑ m, Real.negMulLog (p m)) -
          ∑ m, Real.negMulLog (q m)| ≤
            ∑ m, |Real.negMulLog (p m) - Real.negMulLog (q m)|
        rw [← Finset.sum_sub_distrib]
        simpa using Finset.abs_sum_le_sum_abs
          (fun m : M => Real.negMulLog (p m) - Real.negMulLog (q m))
          Finset.univ
      have hsum_scalar :
          (∑ m, |Real.negMulLog (p m) - Real.negMulLog (q m)|) ≤
            (∑ m, Real.negMulLog (d m)) + s := by
        calc
          (∑ m, |Real.negMulLog (p m) - Real.negMulLog (q m)|) ≤
              ∑ m, (Real.negMulLog (d m) + d m) := by
                apply Finset.sum_le_sum
                intro m _
                exact hscalar (p m) (q m) (hp0 m) (hp1 m) (hq0 m) (hq1 m)
          _ = (∑ m, Real.negMulLog (d m)) + s := by
                rw [Finset.sum_add_distrib]
      let N : ℝ := Fintype.card M
      have hNpos : 0 < N := by
        dsimp [N]
        exact_mod_cast hcardpos
      have hN0 : N ≠ 0 := ne_of_gt hNpos
      have hj : (∑ m, Real.negMulLog (d m)) ≤
          N * Real.negMulLog (s / N) := by
        simpa [N, s] using hjensen d hd0
      have hx0 : 0 ≤ s / N := div_nonneg hs0 (le_of_lt hNpos)
      have hy0 : 0 ≤ 2 * δ / N := by positivity
      have hy1 : 2 * δ / N ≤ 1 := by
        apply (div_le_one hNpos).2
        have : (2 : ℝ) ≤ N := by simpa [N] using hcard2
        nlinarith
      have hxy : s / N ≤ 2 * δ / N :=
        div_le_div_of_nonneg_right hs_le (le_of_lt hNpos)
      have hmono0 := (hdir (s / N) (2 * δ / N) hx0 hy1 hxy).2
      have hmono1 := mul_le_mul_of_nonneg_left hmono0 (le_of_lt hNpos)
      have hNs : N * (s / N) = s := by field_simp
      have hNδ : N * (2 * δ / N) = 2 * δ := by field_simp
      have hmono : N * Real.negMulLog (s / N) + s ≤
          N * Real.negMulLog (2 * δ / N) + 2 * δ := by
        nlinarith
      have hfinalN := hlog_bound N δ (by simpa [N] using hcard2) hepos hδ.2
      calc
        |finite_output_shannon_entropy ν -
            finite_output_shannon_entropy ξ| ≤
            ∑ m, |Real.negMulLog (p m) - Real.negMulLog (q m)| := hent
        _ ≤ (∑ m, Real.negMulLog (d m)) + s := hsum_scalar
        _ ≤ N * Real.negMulLog (s / N) + s := by
          simpa [add_comm] using add_le_add_right hj s
        _ ≤ N * Real.negMulLog (2 * δ / N) + 2 * δ := hmono
        _ ≤ 4 * δ * Real.log (N / δ) := hfinalN
        _ = 4 * δ * Real.log ((Nat.card M : ℝ) / δ) := by
          rw [Nat.card_eq_fintype_card]

@[blueprint "lem:finite-output-kl-div-map-measurable-equiv"
  (statement := /-- Let \(e:A\simeq B\) be a measurable equivalence and let \(P,Q\) be finite measures on \(A\). Then
  \[
    D(e_\#P\Vert e_\#Q)=D(P\Vert Q).
  \] -/)
  (proof := /-- If \(P\ll Q\), pushforward preserves absolute continuity. Express both divergences as integrals of the Kullback--Leibler generating function, use the Radon--Nikodym derivative formula for a measurable embedding, and change variables along the equivalence. If absolute continuity fails, applying the measurable inverse shows that it also fails after pushforward, so both divergences are infinite. -/)
  (title := /-- Invariance of Kullback--Leibler divergence under a measurable equivalence -/)
  (latexEnv := "lemma")]
lemma finite_output_kl_div_map_measurable_equiv
    {A B : Type*} [MeasurableSpace A] [MeasurableSpace B]
    (e : A ≃ᵐ B) (P Q : Measure A) [IsFiniteMeasure P] [IsFiniteMeasure Q] :
    InformationTheory.klDiv (Measure.map e P) (Measure.map e Q) =
      InformationTheory.klDiv P Q := by
  by_cases hPQ : P ≪ Q
  · have hMap : Measure.map e P ≪ Measure.map e Q :=
      e.measurableEmbedding.absolutelyContinuous_map hPQ
    rw [InformationTheory.klDiv_eq_lintegral_klFun_of_ac hMap,
      InformationTheory.klDiv_eq_lintegral_klFun_of_ac hPQ,
      lintegral_map_equiv]
    refine lintegral_congr_ae ?_
    filter_upwards [e.measurableEmbedding.rnDeriv_map P Q] with x hx
    rw [hx]
  · have hMap : ¬Measure.map e P ≪ Measure.map e Q := by
      intro h
      have hBack := e.symm.measurableEmbedding.absolutelyContinuous_map h
      apply hPQ
      simpa [Measure.map_map] using hBack
    simp [InformationTheory.klDiv_eq_lintegral_klFun, hPQ, hMap]

@[blueprint "lem:finite-output-rn-deriv-comp-prod"
  (statement := /-- Let \(\lambda\) be a finite measure and let \(K,L\) be finite kernels into a countably generated measurable space. The Radon--Nikodym derivative of the corresponding composition-product measures equals the kernel Radon--Nikodym derivative almost everywhere. -/)
  (proof := /-- Apply the kernel Lebesgue decomposition of \(K\) relative to \(L\). Composition-product distributes over the absolutely continuous and singular summands, the former is the composition-product with \(L\) weighted by the kernel Radon--Nikodym derivative, and the latter remains singular. Uniqueness of the measure Radon--Nikodym derivative proves the claim. -/)
  (title := /-- Radon--Nikodym derivative of composition-products with common base -/)
  (latexEnv := "lemma")]
lemma finite_output_rn_deriv_comp_prod
    {A C : Type*} [MeasurableSpace A] [MeasurableSpace C]
    [MeasurableSpace.CountablyGenerated C]
    (baseMeasure : Measure A) [IsFiniteMeasure baseMeasure]
    (K L : ProbabilityTheory.Kernel A C)
    [ProbabilityTheory.IsFiniteKernel K] [ProbabilityTheory.IsFiniteKernel L] :
    (baseMeasure.compProd K).rnDeriv
        (baseMeasure.compProd L) =ᵐ[baseMeasure.compProd L]
      fun p => ProbabilityTheory.Kernel.rnDeriv K L p.1 p.2 := by
  refine (Measure.eq_rnDeriv
    (s := baseMeasure.compProd
      (ProbabilityTheory.Kernel.singularPart K L))
    (ProbabilityTheory.Kernel.measurable_rnDeriv K L) ?_ ?_).symm
  · exact Measure.MutuallySingular.compProd_of_right baseMeasure baseMeasure
      (ae_of_all baseMeasure fun a =>
        ProbabilityTheory.Kernel.mutuallySingular_singularPart K L a)
  · calc
      baseMeasure.compProd K =
          baseMeasure.compProd
            (ProbabilityTheory.Kernel.withDensity L
              (ProbabilityTheory.Kernel.rnDeriv K L) +
                ProbabilityTheory.Kernel.singularPart K L) := by
        rw [ProbabilityTheory.Kernel.rnDeriv_add_singularPart]
      _ = baseMeasure.compProd
            (ProbabilityTheory.Kernel.withDensity L
              (ProbabilityTheory.Kernel.rnDeriv K L)) +
          baseMeasure.compProd (ProbabilityTheory.Kernel.singularPart K L) := by
        rw [Measure.compProd_add_right]
      _ = (baseMeasure.compProd L).withDensity
            (fun p => ProbabilityTheory.Kernel.rnDeriv K L p.1 p.2) +
          baseMeasure.compProd (ProbabilityTheory.Kernel.singularPart K L) := by
        rw [Measure.compProd_withDensity
          (ProbabilityTheory.Kernel.measurable_rnDeriv K L)]
      _ = baseMeasure.compProd (ProbabilityTheory.Kernel.singularPart K L) +
          (baseMeasure.compProd L).withDensity
            (fun p => ProbabilityTheory.Kernel.rnDeriv K L p.1 p.2) := by
        rw [add_comm]

@[blueprint "lem:finite-output-kernel-ac-marginal"
  (statement := /-- Let \(\mu\) be a finite measure and let \(K\) be a finite kernel into a finite measurable space with measurable singletons. Then \(K(s,\cdot)\) is absolutely continuous with respect to its \(\mu\)-mixture for \(\mu\)-almost every \(s\). -/)
  (proof := /-- For every output point \(m\), if the mixture assigns zero mass to \(\{m\}\), the integral formula for the mixture shows that \(K(s,\{m\})=0\) for almost every \(s\). Intersect these full-measure events over the finite output space. Every measurable set is a finite union of its singleton subsets, so vanishing of its mixture mass forces its conditional mass to vanish for every \(s\) in that common full-measure event. -/)
  (title := /-- Conditional laws are dominated by their finite-output mixture -/)
  (latexEnv := "lemma")]
lemma finite_output_kernel_ac_marginal
    {S M : Type*} [MeasurableSpace S] [MeasurableSpace M]
    [MeasurableSingletonClass M] [Finite M]
    (μ : Measure S) [IsFiniteMeasure μ]
    (K : ProbabilityTheory.Kernel S M) [ProbabilityTheory.IsFiniteKernel K] :
    ∀ᵐ s ∂μ, K s ≪ μ.bind K := by
  classical
  letI := Fintype.ofFinite M
  have hsingle (m : M) :
      ∀ᵐ s ∂μ, (μ.bind K) {m} = 0 → K s {m} = 0 := by
    by_cases hm : (μ.bind K) {m} = 0
    · have hz : ∫⁻ s, K s {m} ∂μ = 0 := by
        rw [← Measure.bind_apply (measurableSet_singleton m) K.aemeasurable, hm]
      have hae : (fun s => K s {m}) =ᵐ[μ] 0 :=
        (lintegral_eq_zero_iff (K.measurable_coe (measurableSet_singleton m))).mp hz
      filter_upwards [hae] with s hs
      intro
      exact hs
    · exact ae_of_all μ fun _ h => (hm h).elim
  have hall : ∀ᵐ s ∂μ, ∀ m : M,
      (μ.bind K) {m} = 0 → K s {m} = 0 := by
    rw [ae_all_iff]
    exact hsingle
  filter_upwards [hall] with s hs
  intro t hzero
  have hpoint : ∀ m ∈ t, K s {m} = 0 := by
    intro m hm
    exact hs m (measure_mono_null (Set.singleton_subset_iff.mpr hm) hzero)
  have ht : (↑t.toFinite.toFinset : Set M) = t := by
    ext m
    simp
  rw [← ht, ← MeasureTheory.sum_measure_singleton
    (μ := K s) (s := t.toFinite.toFinset)]
  exact Finset.sum_eq_zero fun m hm => hpoint m (ht ▸ hm)

@[blueprint "lem:finite-output-kl-div-sum"
  (statement := /-- If \(P\) and \(Q\) are probability measures on a finite measurable space with measurable singletons and \(P\ll Q\), then
  \[
    D(P\Vert Q)=\sum_m P(\{m\})\log P(\{m\})-
      \sum_m P(\{m\})\log Q(\{m\}).
  \] -/)
  (proof := /-- The log-likelihood ratio is integrable on the finite space. The Radon--Nikodym theorem evaluated on each measurable singleton identifies its density with the ratio of the two point masses whenever the reference mass is positive; absolute continuity handles zero reference mass. Expanding the resulting finite integral gives the stated sum, while the equal total masses cancel the correction terms in the definition of divergence. -/)
  (title := /-- Finite-space formula for Kullback--Leibler divergence -/)
  (latexEnv := "lemma")]
lemma finite_output_kl_div_sum
    {M : Type*} [MeasurableSpace M] [MeasurableSingletonClass M] [Finite M]
    (P Q : Measure M) [IsProbabilityMeasure P] [IsProbabilityMeasure Q]
    (hPQ : P ≪ Q) :
    letI := Fintype.ofFinite M
    (InformationTheory.klDiv P Q).toReal =
      ∑ m : M, ((P {m}).toReal * Real.log (P {m}).toReal -
        (P {m}).toReal * Real.log (Q {m}).toReal) := by
  classical
  letI := Fintype.ofFinite M
  have hInt : Integrable (llr P Q) P := Integrable.of_finite
  rw [InformationTheory.toReal_klDiv hPQ hInt]
  simp only [measureReal_def, measure_univ]
  norm_num
  rw [integral_fintype hInt]
  rw [← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl ?_
  intro m hm
  simp only [smul_eq_mul, measureReal_def, llr]
  have hd := congrArg (fun R : Measure M => R {m})
    (Measure.withDensity_rnDeriv_eq P Q hPQ)
  have hmass : Q {m} * P.rnDeriv Q m = P {m} := by
    simpa [MeasureTheory.withDensity_apply] using hd
  by_cases hq : Q {m} = 0
  · have hp : P {m} = 0 := hPQ hq
    simp [hp]
  have hreal : (Q {m}).toReal * (P.rnDeriv Q m).toReal =
      (P {m}).toReal := by
    simpa using congrArg ENNReal.toReal hmass
  by_cases hr : (P.rnDeriv Q m).toReal = 0
  · have hp : (P {m}).toReal = 0 := by simpa [hr] using hreal.symm
    simp [hp]
  have hqr : (Q {m}).toReal ≠ 0 := by
    rw [ENNReal.toReal_ne_zero]
    exact ⟨hq, measure_ne_top Q {m}⟩
  rw [← hreal, Real.log_mul hqr hr]
  ring

@[blueprint "lem:finite-output-entropy-integrable"
  (statement := /-- Let \(K\) be a Markov kernel into a finite measurable space with measurable singletons, and let \(\mu\) be a finite measure on its source. Then the finite-output Shannon entropy of \(K(s,\cdot)\) is integrable with respect to \(\mu\). -/)
  (proof := /-- Expand the entropy as a finite sum. For each output point, its conditional mass is a measurable function taking values in \([0,1]\). The continuous extension \(-x\log x\) is measurable and has absolute value at most one on this interval, so each summand is integrable against the finite measure. A finite sum of integrable functions is integrable. -/)
  (title := /-- Integrability of finite-output conditional entropy -/)
  (latexEnv := "lemma")]
lemma finite_output_entropy_integrable
    {S M : Type*} [MeasurableSpace S] [MeasurableSpace M]
    [MeasurableSingletonClass M] [Finite M]
    (μ : Measure S) [IsFiniteMeasure μ]
    (K : ProbabilityTheory.Kernel S M) [ProbabilityTheory.IsMarkovKernel K] :
    Integrable (fun s => finite_output_shannon_entropy (K s)) μ := by
  classical
  unfold finite_output_shannon_entropy
  apply integrable_finset_sum
  intro m hm
  apply Integrable.of_bound (C := 1)
  · have hmeas : Measurable (fun s => (K s {m}).toReal) :=
      (K.measurable_coe (measurableSet_singleton m)).ennreal_toReal
    simpa [Function.comp_def, Real.negMulLog, neg_mul] using
      (Real.continuous_negMulLog.measurable.comp hmeas).aestronglyMeasurable
  · filter_upwards [] with s
    simp only [norm_neg, Real.norm_eq_abs]
    by_cases hz : (K s {m}).toReal = 0
    · simp [hz]
    · have hpos : 0 < (K s {m}).toReal :=
        lt_of_le_of_ne ENNReal.toReal_nonneg (Ne.symm hz)
      have hle : (K s {m}).toReal ≤ 1 := by
        simpa using ENNReal.toReal_mono ENNReal.one_ne_top
          (prob_le_one : K s {m} ≤ 1)
      exact le_of_lt (by simpa [mul_comm] using Real.abs_log_mul_self_lt _ hpos hle)

@[blueprint "lem:finite-output-kl-div-comp-prod-const"
  (statement := /-- Let \(\mu\) be a probability measure, let \(K\) be a Markov kernel into a finite measurable space with measurable singletons, and let \(\nu\) be a probability measure dominating \(K(s,\cdot)\) for \(\mu\)-almost every \(s\). If the real-valued conditional divergences are integrable, then the joint divergence is finite and its real value satisfies
  \[
    D(\mu(ds)K(s,dm)\Vert\mu\otimes\nu)
      =\int D(K(s,\cdot)\Vert\nu)\,\mu(ds)
  \]
  as an equality of real values. -/)
  (proof := /-- Write the product reference measure as the composition-product with the constant kernel \(L(s,\cdot)=\nu\). Absolute continuity follows from the assumed almost-everywhere domination. By \cref{lem:finite-output-rn-deriv-comp-prod}, the Radon--Nikodym derivative of the two composition-products is the kernel Radon--Nikodym derivative. Tonelli's theorem and the almost-everywhere equality between kernel and measure Radon--Nikodym derivatives therefore identify the joint divergence with the lower integral of the conditional divergences. Each conditional divergence is finite because its log-likelihood ratio is integrable on the finite output space. The assumed integrability then converts this lower integral to the displayed real integral. -/)
  (title := /-- Conditional decomposition against a constant output law -/)
  (latexEnv := "lemma")]
lemma finite_output_kl_div_comp_prod_const
    {S M : Type*} [MeasurableSpace S] [MeasurableSpace M]
    [MeasurableSingletonClass M] [Finite M]
    (μ : Measure S) [IsProbabilityMeasure μ]
    (K : ProbabilityTheory.Kernel S M)
    [ProbabilityTheory.IsMarkovKernel K]
    (ν : Measure M) [IsProbabilityMeasure ν]
    (hAC : ∀ᵐ s ∂μ, K s ≪ ν)
    (hInt : Integrable
      (fun s => (InformationTheory.klDiv (K s) ν).toReal) μ) :
    InformationTheory.klDiv (μ.compProd K) (μ.prod ν) ≠ ⊤ ∧
      (InformationTheory.klDiv (μ.compProd K) (μ.prod ν)).toReal =
        ∫ s, (InformationTheory.klDiv (K s) ν).toReal ∂μ := by
  let L : ProbabilityTheory.Kernel S M :=
    ProbabilityTheory.Kernel.const S ν
  have hCompAC : μ.compProd K ≪ μ.compProd L :=
    Measure.AbsolutelyContinuous.rfl.compProd (by simpa [L] using hAC)
  have hProd : μ.compProd L = μ.prod ν := by
    simp [L]
  have hLIntegral :
      InformationTheory.klDiv (μ.compProd K) (μ.prod ν) =
        ∫⁻ s, InformationTheory.klDiv (K s) ν ∂μ := by
    rw [← hProd,
      InformationTheory.klDiv_eq_lintegral_klFun_of_ac hCompAC]
    calc
      ∫⁻ p, ENNReal.ofReal
          (InformationTheory.klFun
            ((μ.compProd K).rnDeriv (μ.compProd L) p).toReal)
          ∂(μ.compProd L) =
          ∫⁻ p, ENNReal.ofReal
            (InformationTheory.klFun
              (ProbabilityTheory.Kernel.rnDeriv K L p.1 p.2).toReal)
            ∂(μ.compProd L) := by
        refine lintegral_congr_ae ?_
        filter_upwards [finite_output_rn_deriv_comp_prod μ K L] with p hp
        rw [hp]
      _ = ∫⁻ s, ∫⁻ m, ENNReal.ofReal
            (InformationTheory.klFun
              (ProbabilityTheory.Kernel.rnDeriv K L s m).toReal)
            ∂(L s) ∂μ := by
        rw [Measure.lintegral_compProd (by fun_prop)]
      _ = ∫⁻ s, InformationTheory.klDiv (K s) ν ∂μ := by
        refine lintegral_congr_ae ?_
        filter_upwards [hAC] with s hs
        rw [InformationTheory.klDiv_eq_lintegral_klFun_of_ac hs]
        refine lintegral_congr_ae ?_
        filter_upwards [
          ProbabilityTheory.Kernel.rnDeriv_eq_rnDeriv_measure
            (κ := K) (η := L) (a := s)] with m hm
        simpa [L] using congrArg
          (fun x => ENNReal.ofReal
            (InformationTheory.klFun x.toReal)) hm
  have hNonneg :
      0 ≤ᵐ[μ] fun s => (InformationTheory.klDiv (K s) ν).toReal :=
    ae_of_all μ fun s => ENNReal.toReal_nonneg
  have hOfReal :
      ENNReal.ofReal
          (∫ s, (InformationTheory.klDiv (K s) ν).toReal ∂μ) =
        ∫⁻ s, InformationTheory.klDiv (K s) ν ∂μ := by
    rw [MeasureTheory.ofReal_integral_eq_lintegral_ofReal hInt hNonneg]
    refine lintegral_congr_ae ?_
    filter_upwards [hAC] with s hs
    rw [ENNReal.ofReal_toReal]
    exact InformationTheory.klDiv_ne_top hs Integrable.of_finite
  have hNonnegIntegral :
      0 ≤ ∫ s, (InformationTheory.klDiv (K s) ν).toReal ∂μ :=
    integral_nonneg_of_ae hNonneg
  have hEq :
      InformationTheory.klDiv (μ.compProd K) (μ.prod ν) =
        ENNReal.ofReal
          (∫ s, (InformationTheory.klDiv (K s) ν).toReal ∂μ) :=
    hLIntegral.trans hOfReal.symm
  refine ⟨?_, ?_⟩
  · rw [hEq]
    exact ENNReal.ofReal_ne_top
  · rw [hEq, ENNReal.toReal_ofReal hNonnegIntegral]

@[blueprint "lem:finite-output-integrable-conditional-kl-entropy"
  (statement := /-- Let \(\mu\) be a probability measure and let \(K\) be a Markov kernel into a finite measurable space with measurable singletons. If \(\nu=\mu K\), then the real-valued conditional divergences are integrable and
  \[
    \int D(K(s,\cdot)\Vert\nu)\,\mu(ds)
      =H(\nu)-\int H(K(s,\cdot))\,\mu(ds).
  \] -/)
  (proof := /-- By \cref{lem:finite-output-kernel-ac-marginal}, \(K(s,\cdot)\ll\nu\) for almost every \(s\). Apply \cref{lem:finite-output-kl-div-sum} pointwise. Its first finite sum is the negative entropy from \cref{def:finite-output-shannon-entropy}; the second is a finite sum of conditional point masses multiplied by the constants \(\log\nu(\{m\})\). The latter summands are integrable because conditional point masses are measurable and bounded by one, while conditional entropy is integrable by \cref{lem:finite-output-entropy-integrable}. Interchanging the finite sum and integral and using the defining mixture identity \(\nu(\{m\})=\int K(s,\{m\})\,\mu(ds)\) yields the displayed formula. -/)
  (title := /-- Integrated conditional divergence as an entropy difference -/)
  (latexEnv := "lemma")]
lemma finite_output_integrable_conditional_kl_entropy
    {S M : Type*} [MeasurableSpace S] [MeasurableSpace M]
    [MeasurableSingletonClass M] [Finite M]
    (μ : Measure S) [IsProbabilityMeasure μ]
    (K : ProbabilityTheory.Kernel S M)
    [ProbabilityTheory.IsMarkovKernel K] :
    let ν := μ.bind K
    Integrable (fun s => (InformationTheory.klDiv (K s) ν).toReal) μ ∧
      ∫ s, (InformationTheory.klDiv (K s) ν).toReal ∂μ =
        finite_output_shannon_entropy ν -
          ∫ s, finite_output_shannon_entropy (K s) ∂μ := by
  classical
  letI := Fintype.ofFinite M
  let ν : Measure M := μ.bind K
  letI : IsProbabilityMeasure ν := inferInstance
  have hAC : ∀ᵐ s ∂μ, K s ≪ ν := by
    simpa [ν] using finite_output_kernel_ac_marginal μ K
  have hMassInt (m : M) : Integrable (fun s => (K s {m}).toReal) μ := by
    apply Integrable.of_bound (C := 1)
    · exact (K.measurable_coe (measurableSet_singleton m)).ennreal_toReal.aestronglyMeasurable
    · filter_upwards [] with s
      simpa [Real.norm_eq_abs, abs_of_nonneg ENNReal.toReal_nonneg] using
        ENNReal.toReal_mono ENNReal.one_ne_top (prob_le_one : K s {m} ≤ 1)
  have hCrossInt : Integrable
      (fun s => ∑ m : M, (K s {m}).toReal * Real.log (ν {m}).toReal) μ := by
    apply integrable_finset_sum
    intro m hm
    exact (hMassInt m).mul_const _
  have hPointwise : (fun s => (InformationTheory.klDiv (K s) ν).toReal) =ᵐ[μ]
      fun s => -finite_output_shannon_entropy (K s) -
        ∑ m : M, (K s {m}).toReal * Real.log (ν {m}).toReal := by
    filter_upwards [hAC] with s hs
    rw [finite_output_kl_div_sum (K s) ν hs]
    unfold finite_output_shannon_entropy
    simp only [Finset.sum_sub_distrib]
    simpa only [neg_mul, Finset.sum_neg_distrib, neg_neg]
  have hEntropyInt := finite_output_entropy_integrable μ K
  have hConditionalInt :
      Integrable (fun s => (InformationTheory.klDiv (K s) ν).toReal) μ :=
    (hEntropyInt.neg.sub hCrossInt).congr hPointwise.symm
  refine ⟨hConditionalInt, ?_⟩
  rw [integral_congr_ae hPointwise]
  calc
    ∫ a, -finite_output_shannon_entropy (K a) -
        ∑ m : M, (K a {m}).toReal * Real.log (ν {m}).toReal ∂μ =
        ∫ a, -finite_output_shannon_entropy (K a) ∂μ -
          ∫ a, ∑ m : M, (K a {m}).toReal * Real.log (ν {m}).toReal ∂μ :=
      integral_sub hEntropyInt.neg hCrossInt
    _ = -(∫ a, finite_output_shannon_entropy (K a) ∂μ) -
          ∫ a, ∑ m : M, (K a {m}).toReal * Real.log (ν {m}).toReal ∂μ := by
      rw [integral_neg]
    _ = finite_output_shannon_entropy ν -
          ∫ a, finite_output_shannon_entropy (K a) ∂μ := by
      have hMass (m : M) :
          ∫ s, (K s {m}).toReal ∂μ = (ν {m}).toReal := by
        rw [MeasureTheory.integral_toReal
          (K.measurable_coe (measurableSet_singleton m)).aemeasurable]
        · rw [← Measure.bind_apply (measurableSet_singleton m) K.aemeasurable]
        · exact ae_of_all μ fun s => measure_lt_top (K s) {m}
      rw [integral_finset_sum _ fun m _ => (hMassInt m).mul_const _]
      simp_rw [integral_mul_const, hMass]
      unfold finite_output_shannon_entropy
      simp only [neg_mul, Finset.sum_neg_distrib, neg_neg]
      ring

@[blueprint "lem:finite-output-mutual-information-entropy-expansion"
  (statement := /-- Let \(\mu\) be a probability measure on \(S\), let \(K:S\rightsquigarrow\mathcal M\) be a Markov kernel, and suppose that \(\mathcal M\) is finite with measurable singletons. For the joint law \(\mu(ds)K(s,dm)\),
  \[
    I(M;S)=H(\mathcal L(M))-\int_S H(K(s,\cdot))\,\mu(ds).
  \]
  In particular, every term on the right is finite and its real value embeds canonically into the extended reals. -/)
  (proof := /-- The two marginals of the joint law are \(\mu\) and \(\nu=\mu K\). After swapping the coordinates in the definition from \cref{def:mutual-information}, invariance under that measurable equivalence from \cref{lem:finite-output-kl-div-map-measurable-equiv} identifies the mutual information with \(D(\mu(ds)K(s,dm)\Vert\mu\otimes\nu)\). By \cref{lem:finite-output-kernel-ac-marginal}, the conditional laws are dominated by \(\nu\) almost everywhere. The integrability and entropy identity in \cref{lem:finite-output-integrable-conditional-kl-entropy}, followed by the composition-product decomposition in \cref{lem:finite-output-kl-div-comp-prod-const}, show that this joint divergence is finite and that its real value is \(H(\nu)-\int H(K(s,\cdot))\,\mu(ds)\). The finite extended-nonnegative divergence therefore agrees with the canonical extended-real embedding of this real value. -/)
  (title := /-- Entropy expansion of finite-output mutual information -/)
  (latexEnv := "lemma")]
lemma finite_output_mutual_information_entropy_expansion
    {S M : Type*} [MeasurableSpace S] [MeasurableSpace M]
    [MeasurableSingletonClass M] [Finite M]
    (μ : Measure S) [IsProbabilityMeasure μ]
    (K : ProbabilityTheory.Kernel S M)
    [ProbabilityTheory.IsMarkovKernel K] :
    (mutual_information (μ.compProd K) Prod.snd Prod.fst : EReal) =
      ((finite_output_shannon_entropy
          (Measure.map Prod.snd (μ.compProd K)) -
        ∫ s, finite_output_shannon_entropy (K s) ∂μ : ℝ) : EReal) := by
  classical
  letI := Fintype.ofFinite M
  let ν : Measure M := μ.bind K
  letI : IsProbabilityMeasure ν := inferInstance
  have hOutput : Measure.map Prod.snd (μ.compProd K) = ν := by
    change (μ.compProd K).snd = ν
    simp [ν]
  have hInput : Measure.map Prod.fst (μ.compProd K) = μ := by
    change (μ.compProd K).fst = μ
    simp
  have hMI : mutual_information (μ.compProd K) Prod.snd Prod.fst =
      InformationTheory.klDiv (μ.compProd K) (μ.prod ν) := by
    unfold mutual_information
    rw [hOutput, hInput]
    change InformationTheory.klDiv (Measure.map Prod.swap (μ.compProd K))
      (ν.prod μ) = _
    rw [← Measure.prod_swap]
    exact finite_output_kl_div_map_measurable_equiv
      MeasurableEquiv.prodComm (μ.compProd K) (μ.prod ν)
  rw [hOutput, hMI]
  have hAC : ∀ᵐ s ∂μ, K s ≪ ν := by
    simpa [ν] using finite_output_kernel_ac_marginal μ K
  have hEntropy := finite_output_integrable_conditional_kl_entropy μ K
  have hKL := finite_output_kl_div_comp_prod_const μ K ν hAC hEntropy.1
  calc
    (InformationTheory.klDiv (μ.compProd K) (μ.prod ν) : EReal) =
        ((InformationTheory.klDiv (μ.compProd K) (μ.prod ν)).toReal : EReal) :=
      (EReal.coe_ennreal_toReal hKL.1).symm
    _ = ((finite_output_shannon_entropy ν -
          ∫ s, finite_output_shannon_entropy (K s) ∂μ : ℝ) : EReal) := by
      rw [hKL.2, hEntropy.2]

@[blueprint "lem:finite-output-learning-algorithm-pair-law"
  (statement := /-- Let \(\mu\) be a probability measure, let
  \(X:\Omega\to T\) be measurable, and let \(K:T\rightsquigarrow M\) be a
  Markov kernel. Under the joint law obtained by applying \(K\) to \(X\),
  the law of \((X,Z)\) is \((\mu X^{-1})(dt)K(t,dm)\). -/)
  (proof := /-- Expand the joint law from
  \cref{def:learning-algorithm-joint-measure}. Equality on measurable
  rectangles follows from the composition-product formula and the
  pushforward integral formula; finite-measure extensionality then gives
  equality of the two measures. -/)
  (title := /-- Pair law induced by a learning algorithm -/)
  (latexEnv := "lemma")]
lemma finite_output_learning_algorithm_pair_law
    {Ω T M : Type*} [MeasurableSpace Ω] [MeasurableSpace T]
    [MeasurableSpace M]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : Ω → T) (hX : Measurable X)
    (algorithm : learning_algorithm T M) :
    Measure.map (fun zm => (X zm.1, zm.2))
        (learning_algorithm_joint_measure μ X hX algorithm) =
      (Measure.map X μ).compProd algorithm.kernel := by
  letI : ProbabilityTheory.IsMarkovKernel algorithm.kernel := algorithm.markov
  letI : IsProbabilityMeasure
      (learning_algorithm_joint_measure μ X hX algorithm) := by
    unfold learning_algorithm_joint_measure
    infer_instance
  apply Measure.ext_prod
  intro s t hs ht
  rw [Measure.map_apply (by fun_prop) (hs.prod ht),
    Measure.compProd_apply_prod hs ht]
  simp only [learning_algorithm_joint_measure]
  rw [show (fun zm => (X zm.1, zm.2)) ⁻¹' (s ×ˢ t) =
      (X ⁻¹' s) ×ˢ t by ext z; simp]
  rw [Measure.compProd_apply_prod (hs.preimage hX) ht]
  simp only [ProbabilityTheory.Kernel.comap_apply]
  rw [MeasureTheory.setLIntegral_map hs
    (algorithm.kernel.measurable_coe ht) hX]

@[blueprint "lem:finite-output-learning-algorithm-mutual-information-law"
  (statement := /-- In the setting of
  \cref{lem:finite-output-learning-algorithm-pair-law}, the mutual information
  between the algorithm output and its input equals the mutual information of
  the two coordinate projections under
  \((\mu X^{-1})(dt)K(t,dm)\). -/)
  (proof := /-- Apply
  \cref{lem:finite-output-learning-algorithm-pair-law} and push its measure
  identity forward by the coordinate swap and by each coordinate projection.
  These are precisely the joint law and two marginal laws in
  \cref{def:mutual-information}. -/)
  (title := /-- Mutual information under the canonical algorithm pair law -/)
  (latexEnv := "lemma")]
lemma finite_output_learning_algorithm_mutual_information_law
    {Ω T M : Type*} [MeasurableSpace Ω] [MeasurableSpace T]
    [MeasurableSpace M]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : Ω → T) (hX : Measurable X)
    (algorithm : learning_algorithm T M) :
    mutual_information (learning_algorithm_joint_measure μ X hX algorithm)
        Prod.snd (fun zm => X zm.1) =
      mutual_information ((Measure.map X μ).compProd algorithm.kernel)
        Prod.snd Prod.fst := by
  letI : ProbabilityTheory.IsMarkovKernel algorithm.kernel := algorithm.markov
  let ν := learning_algorithm_joint_measure μ X hX algorithm
  let ξ := (Measure.map X μ).compProd algorithm.kernel
  have hν : IsProbabilityMeasure ν := by
    dsimp [ν, learning_algorithm_joint_measure]
    infer_instance
  letI : IsProbabilityMeasure ν := hν
  have hpair : Measure.map (fun zm => (X zm.1, zm.2)) ν = ξ := by
    simpa [ν, ξ] using
      finite_output_learning_algorithm_pair_law μ X hX algorithm
  have hjoint : Measure.map (fun zm => (zm.2, X zm.1)) ν =
      Measure.map (fun tm => (tm.2, tm.1)) ξ := by
    calc
      Measure.map (fun zm => (zm.2, X zm.1)) ν =
          Measure.map Prod.swap
            (Measure.map (fun zm => (X zm.1, zm.2)) ν) := by
        rw [Measure.map_map (by fun_prop) (by fun_prop)]
        rfl
      _ = Measure.map Prod.swap ξ := by rw [hpair]
  have houtput : Measure.map Prod.snd ν = Measure.map Prod.snd ξ := by
    calc
      Measure.map Prod.snd ν = Measure.map Prod.snd
          (Measure.map (fun zm => (X zm.1, zm.2)) ν) := by
        rw [Measure.map_map (by fun_prop) (by fun_prop)]
        rfl
      _ = Measure.map Prod.snd ξ := by rw [hpair]
  have hinput : Measure.map (fun zm => X zm.1) ν = Measure.map Prod.fst ξ := by
    calc
      Measure.map (fun zm => X zm.1) ν = Measure.map Prod.fst
          (Measure.map (fun zm => (X zm.1, zm.2)) ν) := by
        rw [Measure.map_map (by fun_prop) (by fun_prop)]
        rfl
      _ = Measure.map Prod.fst ξ := by rw [hpair]
  unfold mutual_information
  rw [hjoint, houtput, hinput]

@[blueprint "lem:finite-output-conditional-algorithm-pair-law"
  (statement := /-- Let \(X:\Omega\to S\) and \(Y:\Omega\to T\) be
  measurable on a probability space, with \(T\) nonempty and standard
  Borel, and let \(K:T\rightsquigarrow M\) be a Markov kernel. If \(Z\) is
  obtained by applying \(K\) to \(Y\), then the law of \((X,Z)\) is the
  composition-product of the law of \(X\) with the composite kernel
  \(a\mapsto\int K(t,\cdot)\,\mathcal L(Y\mid X=a)(dt)\). -/)
  (proof := /-- The disintegration identity for the regular conditional law
  of \(Y\) given \(X\) identifies the law of \((X,Y)\) with the corresponding
  composition-product. Expand the law from
  \cref{def:learning-algorithm-joint-measure} on measurable rectangles and
  use Tonelli's theorem to append the kernel \(K\). -/)
  (title := /-- Conditional pair law after an algorithm kernel -/)
  (latexEnv := "lemma")]
lemma finite_output_conditional_algorithm_pair_law
    {Ω S T M : Type*} [MeasurableSpace Ω] [MeasurableSpace S]
    [MeasurableSpace T] [StandardBorelSpace T] [Nonempty T]
    [MeasurableSpace M]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : Ω → S) (Y : Ω → T) (hX : Measurable X) (hY : Measurable Y)
    (algorithm : learning_algorithm T M) :
    Measure.map (fun zm => (X zm.1, zm.2))
        (learning_algorithm_joint_measure μ Y hY algorithm) =
      (Measure.map X μ).compProd
        (algorithm.kernel.comp (ProbabilityTheory.condDistrib Y X μ)) := by
  letI : ProbabilityTheory.IsMarkovKernel algorithm.kernel := algorithm.markov
  letI : IsProbabilityMeasure
      (learning_algorithm_joint_measure μ Y hY algorithm) := by
    unfold learning_algorithm_joint_measure
    infer_instance
  apply Measure.ext_prod
  intro s u hs hu
  rw [Measure.map_apply (by fun_prop) (hs.prod hu)]
  simp only [learning_algorithm_joint_measure]
  rw [show (fun zm => (X zm.1, zm.2)) ⁻¹' (s ×ˢ u) =
      (X ⁻¹' s) ×ˢ u by ext z; simp]
  rw [Measure.compProd_apply_prod (hs.preimage hX) hu]
  simp only [ProbabilityTheory.Kernel.comap_apply]
  rw [Measure.compProd_apply_prod hs hu]
  calc
    (∫⁻ ω in X ⁻¹' s, algorithm.kernel (Y ω) u ∂μ) =
        ∫⁻ p in s ×ˢ (Set.univ : Set T), algorithm.kernel p.2 u
          ∂((Measure.map X μ).compProd
            (ProbabilityTheory.condDistrib Y X μ)) := by
      rw [ProbabilityTheory.compProd_map_condDistrib hY.aemeasurable]
      symm
      calc
        (∫⁻ p in s ×ˢ (Set.univ : Set T), algorithm.kernel p.2 u
            ∂Measure.map (fun ω => (X ω, Y ω)) μ) =
            ∫⁻ ω in (fun ω => (X ω, Y ω)) ⁻¹'
              (s ×ˢ (Set.univ : Set T)), algorithm.kernel (Y ω) u ∂μ := by
          simpa [Function.comp_def] using
            (MeasureTheory.setLIntegral_map (μ := μ)
              (s := s ×ˢ (Set.univ : Set T))
              (f := fun p : S × T => algorithm.kernel p.2 u)
              (g := fun ω => (X ω, Y ω))
              (hs.prod MeasurableSet.univ)
              ((algorithm.kernel.measurable_coe hu).comp measurable_snd)
              (hX.prodMk hY))
        _ = ∫⁻ ω in X ⁻¹' s, algorithm.kernel (Y ω) u ∂μ := by
          rw [show (fun ω => (X ω, Y ω)) ⁻¹'
              (s ×ˢ (Set.univ : Set T)) = X ⁻¹' s by
            ext ω
            simp]
    _ = ∫⁻ a in s,
        ∫⁻ t, algorithm.kernel t u
          ∂(ProbabilityTheory.condDistrib Y X μ a) ∂Measure.map X μ := by
      simpa only [Measure.restrict_univ] using
        (Measure.setLIntegral_compProd
          (μ := Measure.map X μ)
          (κ := ProbabilityTheory.condDistrib Y X μ)
          (f := fun p : S × T => algorithm.kernel p.2 u)
          ((algorithm.kernel.measurable_coe hu).comp measurable_snd)
          hs MeasurableSet.univ)
  congr with a
  rw [ProbabilityTheory.Kernel.comp_apply' algorithm.kernel
    (ProbabilityTheory.condDistrib Y X μ) a hu]

@[blueprint "lem:finite-output-conditional-algorithm-mutual-information-law"
  (statement := /-- Under the hypotheses of
  \cref{lem:finite-output-conditional-algorithm-pair-law}, the mutual
  information between the algorithm output and \(X\) is the coordinate
  mutual information under the composition-product of the law of \(X\) and
  the postprocessed conditional law of \(Y\) given \(X\). -/)
  (proof := /-- Push the measure identity from
  \cref{lem:finite-output-conditional-algorithm-pair-law} forward by the
  coordinate swap and by the two coordinate projections. Substitution of
  these three identities in \cref{def:mutual-information} proves the claim. -/)
  (title := /-- Conditional algorithm mutual-information law -/)
  (latexEnv := "lemma")]
lemma finite_output_conditional_algorithm_mutual_information_law
    {Ω S T M : Type*} [MeasurableSpace Ω] [MeasurableSpace S]
    [MeasurableSpace T] [StandardBorelSpace T] [Nonempty T]
    [MeasurableSpace M]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : Ω → S) (Y : Ω → T) (hX : Measurable X) (hY : Measurable Y)
    (algorithm : learning_algorithm T M) :
    mutual_information (learning_algorithm_joint_measure μ Y hY algorithm)
        Prod.snd (fun zm => X zm.1) =
      mutual_information
        ((Measure.map X μ).compProd
          (algorithm.kernel.comp (ProbabilityTheory.condDistrib Y X μ)))
        Prod.snd Prod.fst := by
  letI : ProbabilityTheory.IsMarkovKernel algorithm.kernel := algorithm.markov
  let ν := learning_algorithm_joint_measure μ Y hY algorithm
  let ξ := (Measure.map X μ).compProd
    (algorithm.kernel.comp (ProbabilityTheory.condDistrib Y X μ))
  have hν : IsProbabilityMeasure ν := by
    dsimp [ν, learning_algorithm_joint_measure]
    infer_instance
  letI : IsProbabilityMeasure ν := hν
  have hpair : Measure.map (fun zm => (X zm.1, zm.2)) ν = ξ := by
    simpa [ν, ξ] using
      finite_output_conditional_algorithm_pair_law μ X Y hX hY algorithm
  have hjoint : Measure.map (fun zm => (zm.2, X zm.1)) ν =
      Measure.map (fun xm => (xm.2, xm.1)) ξ := by
    calc
      Measure.map (fun zm => (zm.2, X zm.1)) ν =
          Measure.map Prod.swap
            (Measure.map (fun zm => (X zm.1, zm.2)) ν) := by
        rw [Measure.map_map (by fun_prop) (by fun_prop)]
        rfl
      _ = Measure.map Prod.swap ξ := by rw [hpair]
  have houtput : Measure.map Prod.snd ν = Measure.map Prod.snd ξ := by
    calc
      Measure.map Prod.snd ν = Measure.map Prod.snd
          (Measure.map (fun zm => (X zm.1, zm.2)) ν) := by
        rw [Measure.map_map (by fun_prop) (by fun_prop)]
        rfl
      _ = Measure.map Prod.snd ξ := by rw [hpair]
  have hinput : Measure.map (fun zm => X zm.1) ν = Measure.map Prod.fst ξ := by
    calc
      Measure.map (fun zm => X zm.1) ν = Measure.map Prod.fst
          (Measure.map (fun zm => (X zm.1, zm.2)) ν) := by
        rw [Measure.map_map (by fun_prop) (by fun_prop)]
        rfl
      _ = Measure.map Prod.fst ξ := by rw [hpair]
  unfold mutual_information
  rw [hjoint, houtput, hinput]

@[blueprint "lem:finite-output-total-variation-symmetric"
  (statement := /-- Total-variation distance is symmetric:
  \(d_{\mathrm{TV}}(\nu,\xi)=d_{\mathrm{TV}}(\xi,\nu)\). -/)
  (proof := /-- In \cref{def:total-variation-distance}, interchange the two
  measures and use symmetry of the absolute value of a difference. -/)
  (title := /-- Symmetry of total variation -/)
  (latexEnv := "lemma")]
lemma finite_output_total_variation_symmetric
    {X : Type*} [MeasurableSpace X] (ν ξ : Measure X) :
    total_variation_distance ν ξ = total_variation_distance ξ ν := by
  unfold total_variation_distance
  congr 1
  ext r
  constructor
  · rintro ⟨E, hE, rfl⟩
    exact ⟨E, hE, by rw [abs_sub_comm]⟩
  · rintro ⟨E, hE, rfl⟩
    exact ⟨E, hE, by rw [abs_sub_comm]⟩

@[blueprint "lem:finite-output-total-variation-event-bound"
  (statement := /-- If \(\nu\) and \(\xi\) are probability measures and
  \(d_{\mathrm{TV}}(\nu,\xi)\leq\delta\), then every measurable set \(E\)
  satisfies \(|\nu(E)-\xi(E)|\leq\delta\). -/)
  (proof := /-- By \cref{def:total-variation-distance}, the displayed
  difference belongs to the set whose supremum defines total variation.
  All members of that set are at most one because both measures are
  probabilities, so the defining set is bounded above. The defining
  supremum and the assumed bound then give the result. -/)
  (title := /-- Event bound from total variation -/)
  (latexEnv := "lemma")]
lemma finite_output_total_variation_event_bound
    {X : Type*} [MeasurableSpace X]
    (ν ξ : Measure X) [IsProbabilityMeasure ν] [IsProbabilityMeasure ξ]
    (δ : ℝ) (hTV : total_variation_distance ν ξ ≤ δ)
    (E : Set X) (hE : MeasurableSet E) :
    |(ν E).toReal - (ξ E).toReal| ≤ δ := by
  have hbdd : BddAbove {r : ℝ | ∃ A : Set X, MeasurableSet A ∧
      r = |(ν A).toReal - (ξ A).toReal|} := by
    refine ⟨1, ?_⟩
    rintro r ⟨A, _, rfl⟩
    have hν0 : 0 ≤ (ν A).toReal := ENNReal.toReal_nonneg
    have hξ0 : 0 ≤ (ξ A).toReal := ENNReal.toReal_nonneg
    have hν1 : (ν A).toReal ≤ 1 := measureReal_le_one
    have hξ1 : (ξ A).toReal ≤ 1 := measureReal_le_one
    rw [abs_le]
    constructor <;> linarith
  exact (le_csSup hbdd ⟨E, hE, rfl⟩).trans hTV

@[blueprint "lem:finite-output-bounded-layer-cake-lintegral"
  (statement := /-- If \(f\) is measurable with \(0\leq f\leq C\) and
  \(C\geq0\), then its nonnegative integral equals the nonnegative integral
  over \((0,C]\) of the measures of its strict superlevel sets. -/)
  (proof := /-- Integrate the indicator of
  \(\{(x,t):0<t\leq C,\ t<f(x)\}\) in both orders. Each vertical section is
  the interval \((0,f(x))\), and each horizontal section is the strict
  superlevel set of \(f\). Tonelli's theorem gives the equality. -/)
  (title := /-- Nonnegative bounded layer-cake formula -/)
  (latexEnv := "lemma")]
lemma finite_output_bounded_layer_cake_lintegral
    {X : Type*} [MeasurableSpace X]
    (ρ : Measure X) [IsProbabilityMeasure ρ]
    (C : ℝ) (hC : 0 ≤ C)
    (f : X → ℝ) (hf : Measurable f)
    (hf0 : ∀ x, 0 ≤ f x) (hfC : ∀ x, f x ≤ C) :
    (∫⁻ x, ENNReal.ofReal (f x) ∂ρ) =
      ∫⁻ t in Set.Ioc 0 C,
        ENNReal.ofReal (ρ.real {x | t < f x}) := by
  let A : Set (X × ℝ) := {p | p.2 < f p.1}
  let G : X × ℝ → ENNReal := A.indicator (fun _ => 1)
  have hA : MeasurableSet A :=
    measurableSet_lt measurable_snd (hf.comp measurable_fst)
  have hG : Measurable G := measurable_const.indicator hA
  calc
    (∫⁻ x, ENNReal.ofReal (f x) ∂ρ) =
        ∫⁻ x, (∫⁻ t in Set.Ioc 0 C, G (x, t)) ∂ρ := by
      apply lintegral_congr
      intro x
      rw [show (fun t => G (x, t)) =
          (Set.Iio (f x)).indicator (fun _ => (1 : ENNReal)) by
        funext t
        simp [G, A, Set.indicator_apply]]
      rw [MeasureTheory.setLIntegral_indicator measurableSet_Iio]
      rw [show Set.Iio (f x) ∩ Set.Ioc 0 C = Set.Ioo 0 (f x) by
        ext t
        simp only [Set.mem_inter_iff, Set.mem_Iio, Set.mem_Ioc, Set.mem_Ioo]
        constructor
        · rintro ⟨htf, ht0, _⟩
          exact ⟨ht0, htf⟩
        · rintro ⟨ht0, htf⟩
          exact ⟨htf, ht0, le_trans (le_of_lt htf) (hfC x)⟩]
      simp [hf0 x]
    _ = ∫⁻ p, G p ∂(ρ.prod (volume.restrict (Set.Ioc 0 C))) :=
      (MeasureTheory.lintegral_prod G hG.aemeasurable).symm
    _ = ∫⁻ t in Set.Ioc 0 C, (∫⁻ x, G (x, t) ∂ρ) :=
      MeasureTheory.lintegral_prod_symm' G hG
    _ = ∫⁻ t in Set.Ioc 0 C,
        ENNReal.ofReal (ρ.real {x | t < f x}) := by
      apply lintegral_congr
      intro t
      rw [show (fun x => G (x, t)) =
          {x : X | t < f x}.indicator (fun _ => (1 : ENNReal)) by
        funext x
        simp [G, A, Set.indicator_apply]]
      simp [Measure.real, measurableSet_lt measurable_const hf,
        measure_ne_top]

@[blueprint "lem:finite-output-bounded-layer-cake"
  (statement := /-- If \(f\) is a measurable function with
  \(0\leq f\leq C\) on a probability space and \(C\geq0\), then
  \[
    \int f\,d\mu=\int_{(0,C]}\mu\{x:t<f(x)\}\,dt.
  \] -/)
  (proof := /-- Apply the nonnegative identity from
  \cref{lem:finite-output-bounded-layer-cake-lintegral}. Nonnegativity and
  measurability convert both lower integrals to real integrals, giving the
  displayed equality. -/)
  (title := /-- Bounded layer-cake formula -/)
  (latexEnv := "lemma")]
lemma finite_output_bounded_layer_cake
    {X : Type*} [MeasurableSpace X]
    (ρ : Measure X) [IsProbabilityMeasure ρ]
    (C : ℝ) (hC : 0 ≤ C)
    (f : X → ℝ) (hf : Measurable f)
    (hf0 : ∀ x, 0 ≤ f x) (hfC : ∀ x, f x ≤ C) :
    ∫ x, f x ∂ρ = ∫ t in Set.Ioc 0 C, ρ.real {x | t < f x} := by
  have hlin := finite_output_bounded_layer_cake_lintegral
    ρ C hC f hf hf0 hfC
  have hlevel_meas : Measurable
      (fun t : ℝ => ρ.real {x | t < f x}) := by
    apply Measurable.ennreal_toReal
    exact Antitone.measurable fun a b hab =>
      measure_mono fun x hx => lt_of_le_of_lt hab hx
  rw [integral_eq_lintegral_of_nonneg_ae (ae_of_all ρ hf0)
    hf.aestronglyMeasurable]
  calc
    (∫⁻ x, ENNReal.ofReal (f x) ∂ρ).toReal =
        (∫⁻ t in Set.Ioc 0 C,
          ENNReal.ofReal (ρ.real {x | t < f x})).toReal :=
      congrArg ENNReal.toReal hlin
    _ = ∫ t in Set.Ioc 0 C, ρ.real {x | t < f x} := by
      exact (integral_eq_lintegral_of_nonneg_ae
        (μ := volume.restrict (Set.Ioc 0 C))
        (f := fun t : ℝ => ρ.real {x | t < f x})
        (ae_of_all (volume.restrict (Set.Ioc 0 C))
          fun _ => ENNReal.toReal_nonneg)
        hlevel_meas.aestronglyMeasurable).symm

@[blueprint "lem:finite-output-total-variation-integral-bound"
  (statement := /-- Let \(\nu\) and \(\xi\) be probability measures with
  \(d_{\mathrm{TV}}(\nu,\xi)\leq\delta\). If a measurable real function
  \(f\) takes values in \([0,C]\), where \(C\geq0\), then
  \[
    \left|\int f\,d\nu-\int f\,d\xi\right|\leq C\delta.
  \] -/)
  (proof := /-- By \cref{lem:finite-output-bounded-layer-cake}, each integral
  is the integral over \(0<t\leq C\) of the measure of \(\{f>t\}\). These superlevel sets are
  measurable, so \cref{lem:finite-output-total-variation-event-bound} bounds
  the pointwise difference of the two layer-cake integrands by \(\delta\).
  Integrating this bound over an interval of length \(C\) proves the claim. -/)
  (title := /-- Bounded-integral estimate from total variation -/)
  (latexEnv := "lemma")]
lemma finite_output_total_variation_integral_bound
    {X : Type*} [MeasurableSpace X]
    (ν ξ : Measure X) [IsProbabilityMeasure ν] [IsProbabilityMeasure ξ]
    (δ C : ℝ) (hC : 0 ≤ C)
    (f : X → ℝ) (hf : Measurable f)
    (hf0 : ∀ x, 0 ≤ f x) (hfC : ∀ x, f x ≤ C)
    (hTV : total_variation_distance ν ξ ≤ δ) :
    |∫ x, f x ∂ν - ∫ x, f x ∂ξ| ≤ C * δ := by
  let gν : ℝ → ℝ := fun t => ν.real {x | t < f x}
  let gξ : ℝ → ℝ := fun t => ξ.real {x | t < f x}
  have hgν : Measurable gν := by
    dsimp [gν, Measure.real]
    apply Measurable.ennreal_toReal
    exact Antitone.measurable fun a b hab =>
      measure_mono fun x hx => lt_of_le_of_lt hab hx
  have hgξ : Measurable gξ := by
    dsimp [gξ, Measure.real]
    apply Measurable.ennreal_toReal
    exact Antitone.measurable fun a b hab =>
      measure_mono fun x hx => lt_of_le_of_lt hab hx
  have hgν_bound : ∀ t, ‖gν t‖ ≤ 1 := by
    intro t
    dsimp [gν, Measure.real]
    rw [abs_of_nonneg ENNReal.toReal_nonneg]
    exact measureReal_le_one
  have hgξ_bound : ∀ t, ‖gξ t‖ ≤ 1 := by
    intro t
    dsimp [gξ, Measure.real]
    rw [abs_of_nonneg ENNReal.toReal_nonneg]
    exact measureReal_le_one
  have hgν_int : IntegrableOn gν (Set.Ioc 0 C) :=
    IntegrableOn.of_bound (by simp) hgν.aestronglyMeasurable 1
      (ae_of_all _ hgν_bound)
  have hgξ_int : IntegrableOn gξ (Set.Ioc 0 C) :=
    IntegrableOn.of_bound (by simp) hgξ.aestronglyMeasurable 1
      (ae_of_all _ hgξ_bound)
  calc
    |∫ x, f x ∂ν - ∫ x, f x ∂ξ| =
        |(∫ t in Set.Ioc 0 C, gν t) -
          ∫ t in Set.Ioc 0 C, gξ t| := by
      rw [finite_output_bounded_layer_cake ν C hC f hf hf0 hfC,
        finite_output_bounded_layer_cake ξ C hC f hf hf0 hfC]
    _ = |∫ t in Set.Ioc 0 C, gν t - gξ t| := by
      rw [integral_sub hgν_int hgξ_int]
    _ ≤
        ∫ t in Set.Ioc 0 C, |gν t - gξ t| :=
      abs_integral_le_integral_abs
    _ ≤ ∫ _t in Set.Ioc 0 C, δ := by
      apply integral_mono_ae (hgν_int.sub hgξ_int).abs
        (integrableOn_const (μ := volume) (s := Set.Ioc 0 C) (C := δ)
          (hs := by rw [Real.volume_Ioc]; exact ENNReal.ofReal_ne_top)
          (hC := by simp))
      exact ae_of_all _ fun t => by
        simpa only [Pi.sub_apply, gν, gξ, Measure.real] using
          (finite_output_total_variation_event_bound ν ξ δ hTV
            {x | t < f x} (measurableSet_lt measurable_const hf))
    _ = C * δ := by
      simp [hC]

@[blueprint "lem:finite-output-total-variation-bind-contraction"
  (statement := /-- Total variation contracts under a common Markov kernel:
  if \(d_{\mathrm{TV}}(\nu,\xi)\leq\delta\), then
  \(d_{\mathrm{TV}}(\nu K,\xi K)\leq\delta\). -/)
  (proof := /-- For every measurable output event \(E\), the two output
  probabilities are the integrals of the same measurable function
  \(x\mapsto K(x,E)\), whose values lie in \([0,1]\). Apply
  \cref{lem:finite-output-total-variation-integral-bound} with \(C=1\),
  then take the supremum over measurable \(E\) as in
  \cref{def:total-variation-distance}. -/)
  (title := /-- Contraction of total variation under a kernel -/)
  (latexEnv := "lemma")]
lemma finite_output_total_variation_bind_contraction
    {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    (ν ξ : Measure X) [IsProbabilityMeasure ν] [IsProbabilityMeasure ξ]
    (K : ProbabilityTheory.Kernel X Y)
    [ProbabilityTheory.IsMarkovKernel K]
    (δ : ℝ) (hTV : total_variation_distance ν ξ ≤ δ) :
    total_variation_distance (ν.bind K) (ξ.bind K) ≤ δ := by
  unfold total_variation_distance
  apply csSup_le
  · exact ⟨0, ∅, MeasurableSet.empty, by simp⟩
  · rintro r ⟨E, hE, rfl⟩
    have hν : ((ν.bind K) E).toReal = ∫ x, (K x E).toReal ∂ν := by
      rw [MeasureTheory.integral_toReal (K.measurable_coe hE).aemeasurable]
      · rw [← Measure.bind_apply hE K.aemeasurable]
      · exact ae_of_all ν fun x => measure_lt_top (K x) E
    have hξ : ((ξ.bind K) E).toReal = ∫ x, (K x E).toReal ∂ξ := by
      rw [MeasureTheory.integral_toReal (K.measurable_coe hE).aemeasurable]
      · rw [← Measure.bind_apply hE K.aemeasurable]
      · exact ae_of_all ξ fun x => measure_lt_top (K x) E
    rw [hν, hξ]
    simpa using finite_output_total_variation_integral_bound ν ξ δ 1
      (by norm_num) (fun x => (K x E).toReal)
      (K.measurable_coe hE).ennreal_toReal
      (fun _ => ENNReal.toReal_nonneg)
      (fun x => by
        exact ENNReal.toReal_mono ENNReal.one_ne_top
          (prob_le_one : K x E ≤ 1)) hTV

@[blueprint "lem:finite-output-total-variation-mixture-bound"
  (statement := /-- Let \(P\) and \(Q\) be Markov kernels with a common
  probability input law \(\mu\). If
  \(d_{\mathrm{TV}}(P_x,Q_x)\leq\delta\) for \(\mu\)-almost every \(x\),
  then \(d_{\mathrm{TV}}(\mu P,\mu Q)\leq\delta\). -/)
  (proof := /-- For every measurable event, write the two mixture
  probabilities as integrals of the conditional event probabilities. The
  triangle inequality for the integral and
  \cref{lem:finite-output-total-variation-event-bound} bound their
  difference by the integral of the constant \(\delta\), which equals
  \(\delta\) because \(\mu\) is a probability measure. Taking the supremum
  over events gives the result. -/)
  (title := /-- Total variation of mixtures -/)
  (latexEnv := "lemma")]
lemma finite_output_total_variation_mixture_bound
    {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    (μ : Measure X) [IsProbabilityMeasure μ]
    (P Q : ProbabilityTheory.Kernel X Y)
    [ProbabilityTheory.IsMarkovKernel P] [ProbabilityTheory.IsMarkovKernel Q]
    (δ : ℝ)
    (hTV : ∀ᵐ x ∂μ, total_variation_distance (P x) (Q x) ≤ δ) :
    total_variation_distance (μ.bind P) (μ.bind Q) ≤ δ := by
  unfold total_variation_distance
  apply csSup_le
  · exact ⟨0, ∅, MeasurableSet.empty, by simp⟩
  · rintro r ⟨E, hE, rfl⟩
    have hPint : Integrable (fun x => (P x E).toReal) μ :=
      Integrable.of_bound (C := 1)
        (P.measurable_coe hE).ennreal_toReal.aestronglyMeasurable (by
          filter_upwards [] with x
          rw [Real.norm_eq_abs, abs_of_nonneg ENNReal.toReal_nonneg]
          simpa using ENNReal.toReal_mono ENNReal.one_ne_top
            (prob_le_one : P x E ≤ 1))
    have hQint : Integrable (fun x => (Q x E).toReal) μ :=
      Integrable.of_bound (C := 1)
        (Q.measurable_coe hE).ennreal_toReal.aestronglyMeasurable (by
          filter_upwards [] with x
          rw [Real.norm_eq_abs, abs_of_nonneg ENNReal.toReal_nonneg]
          simpa using ENNReal.toReal_mono ENNReal.one_ne_top
            (prob_le_one : Q x E ≤ 1))
    have hP : ((μ.bind P) E).toReal = ∫ x, (P x E).toReal ∂μ := by
      rw [MeasureTheory.integral_toReal (P.measurable_coe hE).aemeasurable]
      · rw [← Measure.bind_apply hE P.aemeasurable]
      · exact ae_of_all μ fun x => measure_lt_top (P x) E
    have hQ : ((μ.bind Q) E).toReal = ∫ x, (Q x E).toReal ∂μ := by
      rw [MeasureTheory.integral_toReal (Q.measurable_coe hE).aemeasurable]
      · rw [← Measure.bind_apply hE Q.aemeasurable]
      · exact ae_of_all μ fun x => measure_lt_top (Q x) E
    rw [hP, hQ, ← integral_sub hPint hQint]
    calc
      |∫ x, (P x E).toReal - (Q x E).toReal ∂μ| ≤
          ∫ x, |(P x E).toReal - (Q x E).toReal| ∂μ :=
        abs_integral_le_integral_abs
      _ ≤ ∫ _x, δ ∂μ := by
        apply integral_mono_ae (hPint.sub hQint).abs
          (integrable_const δ : Integrable (fun _ : X => δ) μ)
        filter_upwards [hTV] with x hx
        exact finite_output_total_variation_event_bound
          (P x) (Q x) δ hx E hE
      _ = δ := by simp

@[blueprint "lem:finite-output-shannon-entropy-bounds"
  (statement := /-- If \(\nu\) is a probability measure on a finite
  measurable space \(M\) with measurable singletons, then
  \[
    0\leq H(\nu)\leq\log |M|.
  \] -/)
  (proof := /-- Write the entropy as the sum of
  \(-p_m\log p_m\). Each summand is nonnegative because
  \(0\leq p_m\leq1\). Jensen's inequality for the concave function
  \(x\mapsto-x\log x\), with equal weights and \(\sum_m p_m=1\), gives
  the upper bound \(|M|[-|M|^{-1}\log(|M|^{-1})]=\log|M|\). -/)
  (title := /-- Bounds for finite-output Shannon entropy -/)
  (latexEnv := "lemma")]
lemma finite_output_shannon_entropy_bounds
    {M : Type*} [MeasurableSpace M] [MeasurableSingletonClass M] [Finite M]
    (ν : Measure M) [IsProbabilityMeasure ν] :
    0 ≤ finite_output_shannon_entropy ν ∧
      finite_output_shannon_entropy ν ≤ Real.log (Nat.card M) := by
  classical
  letI := Fintype.ofFinite M
  let p : M → ℝ := fun m => (ν {m}).toReal
  have hp0 : ∀ m, 0 ≤ p m := fun _ => ENNReal.toReal_nonneg
  have hp1 : ∀ m, p m ≤ 1 := fun _ => measureReal_le_one
  have hpsum : ∑ m, p m = 1 := by
    simpa [p, Measure.real, measure_univ] using
      (sum_measureReal_singleton (μ := ν) (Finset.univ : Finset M))
  have hM : Nonempty M := by
    by_contra h
    haveI : IsEmpty M := not_nonempty_iff.mp h
    simpa using hpsum
  let N : ℝ := Fintype.card M
  have hNpos : 0 < N := by
    dsimp [N]
    exact_mod_cast Fintype.card_pos
  have hN0 : N ≠ 0 := ne_of_gt hNpos
  have hw : ∑ _ : M, N⁻¹ = 1 := by
    simp [N, hN0]
  have hj : (∑ i, N⁻¹ * Real.negMulLog (p i)) ≤
      Real.negMulLog (∑ i, N⁻¹ * p i) := by
    simpa [smul_eq_mul, N] using
      (Real.concaveOn_negMulLog.le_map_sum
        (t := Finset.univ)
        (w := fun _ : M => N⁻¹)
        (p := p)
        (fun _ _ => inv_nonneg.mpr (Nat.cast_nonneg _))
        (by simpa using hw)
        (fun i _ => hp0 i))
  have hupper : (∑ i, Real.negMulLog (p i)) ≤ Real.log N := by
    have hmul := mul_le_mul_of_nonneg_left hj (le_of_lt hNpos)
    calc
      (∑ i, Real.negMulLog (p i)) =
          N * ∑ i, N⁻¹ * Real.negMulLog (p i) := by
        rw [← Finset.mul_sum]
        field_simp
      _ ≤ N * Real.negMulLog (∑ i, N⁻¹ * p i) := hmul
      _ = N * Real.negMulLog (1 / N) := by
        rw [← Finset.mul_sum, hpsum]
        congr 2
        field_simp
      _ = Real.log N := by
        rw [Real.negMulLog_eq_neg]
        change N * (-(1 / N * Real.log (1 / N))) = Real.log N
        rw [Real.log_div one_ne_zero hN0,
          Real.log_one]
        field_simp
        ring
  constructor
  · unfold finite_output_shannon_entropy
    exact Finset.sum_nonneg fun m _ =>
      Real.negMulLog_nonneg (hp0 m) (hp1 m)
  · unfold finite_output_shannon_entropy
    change (∑ m, Real.negMulLog (p m)) ≤ Real.log (Nat.card M)
    simpa [N, Nat.card_eq_fintype_card] using hupper

@[blueprint "lem:finite-output-entropy-one-sided-continuity"
  (statement := /-- Let \(\nu\) and \(\xi\) be probability measures on a
  finite measurable space \(M\) with measurable singletons. If
  \(0\leq\delta\leq1\), \(d_{\mathrm{TV}}(\nu,\xi)\leq\delta\), and
  \(1\leq\log(|M|/\delta)\), then
  \[
    H(\nu)-H(\xi)\leq
      \delta\bigl(\log(|M|/\delta)+1\bigr).
  \] -/)
  (proof := /-- The case \(\delta=0\) follows from
  \cref{lem:finite-output-entropy-continuity}, and the one-point case is
  immediate. Otherwise put \(p_m=\nu\{m\}\), \(q_m=\xi\{m\}\), and split
  \(p_m-q_m=u_m-v_m\) into its positive and negative parts. The event on
  which \(p_m\geq q_m\), together with
  \cref{lem:finite-output-total-variation-event-bound}, gives
  \(\sum_m u_m=\sum_m v_m=:r\leq\delta\). The elementary inequalities for
  \(x\mapsto-x\log x\) give
  \[
    H(\nu)-H(\xi)\leq\sum_m[-u_m\log u_m]+r.
  \]
  Concavity and Jensen's inequality bound the sum by
  \(|M|[-(r/|M|)\log(r/|M|)]\). The function obtained by adding \(r\) is
  increasing for \(0\leq r\leq\delta\leq1\), yielding the stated bound. -/)
  (title := /-- One-sided continuity of finite-output entropy -/)
  (latexEnv := "lemma")]
lemma finite_output_entropy_one_sided_continuity
    {M : Type*} [MeasurableSpace M] [MeasurableSingletonClass M] [Finite M]
    (ν ξ : Measure M) [IsProbabilityMeasure ν] [IsProbabilityMeasure ξ]
    (δ : ℝ) (hδ : 0 ≤ δ ∧ δ ≤ 1)
    (hTV : total_variation_distance ν ξ ≤ δ)
    (hlog : 1 ≤ Real.log ((Nat.card M : ℝ) / δ)) :
    finite_output_shannon_entropy ν - finite_output_shannon_entropy ξ ≤
      δ * (Real.log ((Nat.card M : ℝ) / δ) + 1) := by
  classical
  by_cases hδ0 : δ = 0
  · subst δ
    have h := finite_output_entropy_continuity ν ξ 0 ⟨le_rfl, by norm_num⟩ hTV
    have habs : |finite_output_shannon_entropy ν -
        finite_output_shannon_entropy ξ| ≤ 0 := by simpa using h
    simpa using (le_trans (le_abs_self _) habs)
  letI := Fintype.ofFinite M
  let p : M → ℝ := fun m => (ν {m}).toReal
  let q : M → ℝ := fun m => (ξ {m}).toReal
  have hp0 : ∀ m, 0 ≤ p m := fun _ => ENNReal.toReal_nonneg
  have hq0 : ∀ m, 0 ≤ q m := fun _ => ENNReal.toReal_nonneg
  have hp1 : ∀ m, p m ≤ 1 := fun _ => measureReal_le_one
  have hq1 : ∀ m, q m ≤ 1 := fun _ => measureReal_le_one
  have hpsum : ∑ m, p m = 1 := by
    simpa [p, Measure.real, measure_univ] using
      (sum_measureReal_singleton (μ := ν) (Finset.univ : Finset M))
  have hqsum : ∑ m, q m = 1 := by
    simpa [q, Measure.real, measure_univ] using
      (sum_measureReal_singleton (μ := ξ) (Finset.univ : Finset M))
  have hM : Nonempty M := by
    by_contra h
    haveI : IsEmpty M := not_nonempty_iff.mp h
    simpa using hpsum
  by_cases hcard : Fintype.card M = 1
  · obtain ⟨m, hm⟩ := Fintype.card_eq_one_iff.mp hcard
    have huniv : (Finset.univ : Finset M) = {m} := by
      ext x
      simp [hm x]
    have hpq : p = q := by
      funext x
      rw [hm x]
      have hp : p m = 1 := by simpa [huniv] using hpsum
      have hq : q m = 1 := by simpa [huniv] using hqsum
      rw [hp, hq]
    have hent : finite_output_shannon_entropy ν =
        finite_output_shannon_entropy ξ := by
      unfold finite_output_shannon_entropy
      change (∑ x, Real.negMulLog (p x)) =
        ∑ x, Real.negMulLog (q x)
      rw [hpq]
    rw [hent, sub_self]
    exact mul_nonneg hδ.1 (by linarith)
  have hδpos : 0 < δ := lt_of_le_of_ne hδ.1 (Ne.symm hδ0)
  let u : M → ℝ := fun m => if 0 ≤ p m - q m then p m - q m else 0
  let v : M → ℝ := fun m => if 0 ≤ p m - q m then 0 else q m - p m
  let r : ℝ := ∑ m, u m
  have hu0 : ∀ m, 0 ≤ u m := by
    intro m
    dsimp [u]
    split_ifs with h <;> linarith
  have hv0 : ∀ m, 0 ≤ v m := by
    intro m
    dsimp [v]
    split_ifs with h <;> linarith
  have hsplit : ∀ m, p m - q m = u m - v m := by
    intro m
    dsimp [u, v]
    split_ifs with h <;> linarith
  have huv : ∑ m, u m = ∑ m, v m := by
    have hzero : ∑ m, (p m - q m) = 0 := by
      rw [Finset.sum_sub_distrib, hpsum, hqsum, sub_self]
    have hrewrite : (∑ m, (p m - q m)) =
        (∑ m, u m) - ∑ m, v m := by
      calc
        (∑ m, (p m - q m)) = ∑ m, (u m - v m) := by
          apply Finset.sum_congr rfl
          intro m _
          exact hsplit m
        _ = (∑ m, u m) - ∑ m, v m := by
          simpa using (Finset.sum_sub_distrib u v (Finset.univ : Finset M))
    rw [hrewrite] at hzero
    linarith
  have hr0 : 0 ≤ r := Finset.sum_nonneg fun m _ => hu0 m
  let A : Finset M := Finset.univ.filter (fun m => 0 ≤ p m - q m)
  have hνA : (ν (A : Set M)).toReal = ∑ m ∈ A, p m := by
    symm
    simpa [p, Measure.real] using sum_measureReal_singleton (μ := ν) A
  have hξA : (ξ (A : Set M)).toReal = ∑ m ∈ A, q m := by
    symm
    simpa [q, Measure.real] using sum_measureReal_singleton (μ := ξ) A
  have hr_event : r = (ν (A : Set M)).toReal - (ξ (A : Set M)).toReal := by
    rw [hνA, hξA,
      ← Finset.sum_sub_distrib (s := A) p q]
    dsimp [r, u, A]
    simp only [Finset.sum_filter]
  have hrδ : r ≤ δ := by
    rw [hr_event]
    exact (le_abs_self _).trans
      (finite_output_total_variation_event_bound ν ξ δ hTV
        (A : Set M) A.finite_toSet.measurableSet)
  have hdir : ∀ x y : ℝ, 0 ≤ x → y ≤ 1 → x ≤ y →
      Real.negMulLog y - Real.negMulLog x ≤ Real.negMulLog (y - x) ∧
      Real.negMulLog x - Real.negMulLog y ≤ y - x := by
    intro x y hx0 hy1 hxy
    have hy0 : 0 ≤ y := hx0.trans hxy
    have hd0 : 0 ≤ y - x := sub_nonneg.mpr hxy
    have hdy : y - x ≤ y := by linarith
    by_cases hyz : y = 0
    · have hxz : x = 0 := by linarith
      simp [hyz, hxz]
    · let a : ℝ := x / y
      let b : ℝ := (y - x) / y
      have hypos : 0 < y := lt_of_le_of_ne hy0 (Ne.symm hyz)
      have ha0 : 0 ≤ a := div_nonneg hx0 hy0
      have ha1 : a ≤ 1 := (div_le_one hypos).mpr hxy
      have hb0 : 0 ≤ b := div_nonneg hd0 hy0
      have hb1 : b ≤ 1 := (div_le_one hypos).mpr hdy
      have hab : a + b = 1 := by
        dsimp [a, b]
        field_simp
        ring
      have hax : a * y = x := by
        dsimp [a]
        field_simp
      have hbd : b * y = y - x := by
        dsimp [b]
        field_simp
      have hfx : Real.negMulLog x =
          y * Real.negMulLog a + a * Real.negMulLog y := by
        rw [← hax, Real.negMulLog_mul]
      have hfd : Real.negMulLog (y - x) =
          y * Real.negMulLog b + b * Real.negMulLog y := by
        rw [← hbd, Real.negMulLog_mul]
      have hfa0 := Real.negMulLog_nonneg ha0 ha1
      have hfb0 := Real.negMulLog_nonneg hb0 hb1
      have hfy0 := Real.negMulLog_nonneg hy0 hy1
      have hsub : Real.negMulLog y - Real.negMulLog x ≤
          Real.negMulLog (y - x) := by
        nlinarith [mul_nonneg hy0 (add_nonneg hfa0 hfb0)]
      have hfa_le := Real.negMulLog_le_one_sub_self ha0
      have hmul : y * Real.negMulLog a ≤ y * (1 - a) :=
        mul_le_mul_of_nonneg_left hfa_le hy0
      have hyone : y * (1 - a) = y - x := by
        rw [mul_sub, mul_one]
        nlinarith [hax]
      have hrev : Real.negMulLog x - Real.negMulLog y ≤ y - x := by
        nlinarith [mul_nonneg (sub_nonneg.mpr ha1) hfy0]
      exact ⟨hsub, hrev⟩
  have hpoint : ∀ m, Real.negMulLog (p m) - Real.negMulLog (q m) ≤
      Real.negMulLog (u m) + v m := by
    intro m
    by_cases hm : 0 ≤ p m - q m
    · have hqp : q m ≤ p m := sub_nonneg.mp hm
      have hh := (hdir (q m) (p m) (hq0 m) (hp1 m) hqp).1
      simpa [u, v, hm, hqp] using hh
    · have hpq : p m ≤ q m := by linarith
      have hnqp : ¬q m ≤ p m := by linarith
      have hh := (hdir (p m) (q m) (hp0 m) (hq1 m) hpq).2
      simpa [u, v, hm, hnqp] using hh
  let N : ℝ := Fintype.card M
  have hNpos : 0 < N := by
    dsimp [N]
    exact_mod_cast Fintype.card_pos
  have hN0 : N ≠ 0 := ne_of_gt hNpos
  have hN1 : 1 ≤ N := by
    dsimp [N]
    exact_mod_cast Fintype.card_pos
  have hw : ∑ _ : M, N⁻¹ = 1 := by simp [N, hN0]
  have hj : (∑ i, Real.negMulLog (u i)) ≤
      N * Real.negMulLog (r / N) := by
    have hj' : (∑ i, N⁻¹ * Real.negMulLog (u i)) ≤
        Real.negMulLog (∑ i, N⁻¹ * u i) := by
      simpa [smul_eq_mul, N] using
        (Real.concaveOn_negMulLog.le_map_sum
          (t := Finset.univ) (w := fun _ : M => N⁻¹) (p := u)
          (fun _ _ => inv_nonneg.mpr (Nat.cast_nonneg _))
          (by simpa using hw) (fun i _ => hu0 i))
    have hmul := mul_le_mul_of_nonneg_left hj' (le_of_lt hNpos)
    calc
      (∑ i, Real.negMulLog (u i)) =
          N * ∑ i, N⁻¹ * Real.negMulLog (u i) := by
        rw [← Finset.mul_sum]
        field_simp
      _ ≤ N * Real.negMulLog (∑ i, N⁻¹ * u i) := hmul
      _ = N * Real.negMulLog (r / N) := by
        rw [← Finset.mul_sum]
        congr 2
        field_simp
        rfl
  have hrN0 : 0 ≤ r / N := div_nonneg hr0 (le_of_lt hNpos)
  have hδN0 : 0 ≤ δ / N := div_nonneg hδ.1 (le_of_lt hNpos)
  have hδN1 : δ / N ≤ 1 := (div_le_one hNpos).2 (hδ.2.trans hN1)
  have hrδN : r / N ≤ δ / N :=
    div_le_div_of_nonneg_right hrδ (le_of_lt hNpos)
  have hmono0 := (hdir (r / N) (δ / N) hrN0 hδN1 hrδN).2
  have hmono : N * Real.negMulLog (r / N) + r ≤
      N * Real.negMulLog (δ / N) + δ := by
    have hm := mul_le_mul_of_nonneg_left hmono0 (le_of_lt hNpos)
    have hrN : N * (r / N) = r := by field_simp
    have hδN : N * (δ / N) = δ := by field_simp
    nlinarith
  have halgebra : N * Real.negMulLog (δ / N) + δ =
      δ * (Real.log (N / δ) + 1) := by
    have hδne : δ ≠ 0 := ne_of_gt hδpos
    rw [Real.negMulLog_eq_neg]
    change N * (-(δ / N * Real.log (δ / N))) + δ =
      δ * (Real.log (N / δ) + 1)
    rw [Real.log_div hδne hN0, Real.log_div hN0 hδne]
    field_simp
    ring
  have hent : finite_output_shannon_entropy ν -
      finite_output_shannon_entropy ξ ≤
        (∑ m, Real.negMulLog (u m)) + r := by
    unfold finite_output_shannon_entropy
    change (∑ m, Real.negMulLog (p m)) -
        ∑ m, Real.negMulLog (q m) ≤ _
    rw [← Finset.sum_sub_distrib]
    calc
      (∑ m, (Real.negMulLog (p m) - Real.negMulLog (q m))) ≤
          ∑ m, (Real.negMulLog (u m) + v m) :=
        Finset.sum_le_sum fun m _ => hpoint m
      _ = (∑ m, Real.negMulLog (u m)) + ∑ m, v m :=
        Finset.sum_add_distrib
      _ = (∑ m, Real.negMulLog (u m)) + r := by rw [← huv]
  calc
    finite_output_shannon_entropy ν - finite_output_shannon_entropy ξ ≤
        (∑ m, Real.negMulLog (u m)) + r := hent
    _ ≤ N * Real.negMulLog (r / N) + r := by linarith
    _ ≤ N * Real.negMulLog (δ / N) + δ := hmono
    _ = δ * (Real.log (N / δ) + 1) := halgebra
    _ = δ * (Real.log ((Nat.card M : ℝ) / δ) + 1) := by
      rw [Nat.card_eq_fintype_card]

@[blueprint "lem:finite-output-conditional-kernel-information-transport"
  (statement := /-- Let \(P,Q:S\rightsquigarrow M\) be Markov kernels into
  a finite measurable space with measurable singletons, over a common
  probability input law \(\mu\). Suppose \(0\leq\delta\leq1\),
  \(d_{\mathrm{TV}}(P_s,Q_s)\leq\delta\) for \(\mu\)-almost every \(s\),
  and \(1\leq\log(|M|/\delta)\). Then
  \[
    I_{\mu Q}(Z;S)\leq I_{\mu P}(Z;S)
      +4\delta\log(|M|/\delta).
  \] -/)
  (proof := /-- Expand both mutual informations by
  \cref{lem:finite-output-mutual-information-entropy-expansion}. The output
  marginals are within total variation \(\delta\) by
  \cref{lem:finite-output-total-variation-mixture-bound}; symmetry follows
  from \cref{lem:finite-output-total-variation-symmetric}. Apply
  \cref{lem:finite-output-entropy-one-sided-continuity} to their entropies
  and pointwise to the conditional entropies. Integrability follows from
  \cref{lem:finite-output-entropy-integrable}, so the conditional estimates
  integrate. Each contribution is at most
  \(\delta(\log(|M|/\delta)+1)\), and
  \(1\leq\log(|M|/\delta)\) bounds their sum by the displayed error. -/)
  (title := /-- Conditional-kernel transport of finite-output information -/)
  (latexEnv := "lemma")]
lemma finite_output_conditional_kernel_information_transport
    {S M : Type*} [MeasurableSpace S] [MeasurableSpace M]
    [MeasurableSingletonClass M] [Finite M]
    (μ : Measure S) [IsProbabilityMeasure μ]
    (P Q : ProbabilityTheory.Kernel S M)
    [ProbabilityTheory.IsMarkovKernel P] [ProbabilityTheory.IsMarkovKernel Q]
    (δ : ℝ) (hδ : 0 ≤ δ ∧ δ ≤ 1)
    (hTV : ∀ᵐ s ∂μ, total_variation_distance (P s) (Q s) ≤ δ)
    (hlog : 1 ≤ Real.log ((Nat.card M : ℝ) / δ)) :
    (mutual_information (μ.compProd Q) Prod.snd Prod.fst : EReal) ≤
      (mutual_information (μ.compProd P) Prod.snd Prod.fst : EReal) +
        ((4 * δ * Real.log ((Nat.card M : ℝ) / δ) : ℝ) : EReal) := by
  let outP : Measure M := μ.bind P
  let outQ : Measure M := μ.bind Q
  letI : IsProbabilityMeasure outP := by dsimp [outP]; infer_instance
  letI : IsProbabilityMeasure outQ := by dsimp [outQ]; infer_instance
  have hPexp := finite_output_mutual_information_entropy_expansion μ P
  have hQexp := finite_output_mutual_information_entropy_expansion μ Q
  have hPout : Measure.map Prod.snd (μ.compProd P) = outP := by
    change (μ.compProd P).snd = outP
    simp [outP]
  have hQout : Measure.map Prod.snd (μ.compProd Q) = outQ := by
    change (μ.compProd Q).snd = outQ
    simp [outQ]
  rw [hPout] at hPexp
  rw [hQout] at hQexp
  have hOutTV0 : total_variation_distance outP outQ ≤ δ :=
    finite_output_total_variation_mixture_bound μ P Q δ hTV
  have hOutTV : total_variation_distance outQ outP ≤ δ := by
    rw [finite_output_total_variation_symmetric]
    exact hOutTV0
  have hOut := finite_output_entropy_one_sided_continuity
    outQ outP δ hδ hOutTV hlog
  have hPint := finite_output_entropy_integrable μ P
  have hQint := finite_output_entropy_integrable μ Q
  have hCond : (∫ s, finite_output_shannon_entropy (P s) ∂μ) -
      ∫ s, finite_output_shannon_entropy (Q s) ∂μ ≤
        δ * (Real.log ((Nat.card M : ℝ) / δ) + 1) := by
    rw [← integral_sub hPint hQint]
    calc
      (∫ s, finite_output_shannon_entropy (P s) -
          finite_output_shannon_entropy (Q s) ∂μ) ≤
          ∫ _s, δ * (Real.log ((Nat.card M : ℝ) / δ) + 1) ∂μ := by
        apply integral_mono_ae (hPint.sub hQint)
          (integrable_const
            (δ * (Real.log ((Nat.card M : ℝ) / δ) + 1)) :
              Integrable
                (fun _ : S => δ * (Real.log ((Nat.card M : ℝ) / δ) + 1)) μ)
        filter_upwards [hTV] with s hs
        exact finite_output_entropy_one_sided_continuity
          (P s) (Q s) δ hδ hs hlog
      _ = δ * (Real.log ((Nat.card M : ℝ) / δ) + 1) := by simp
  have hbudget : 2 * (δ * (Real.log ((Nat.card M : ℝ) / δ) + 1)) ≤
      4 * δ * Real.log ((Nat.card M : ℝ) / δ) := by
    nlinarith [mul_nonneg hδ.1 (sub_nonneg.mpr hlog)]
  have hreal :
      finite_output_shannon_entropy outQ -
          ∫ s, finite_output_shannon_entropy (Q s) ∂μ ≤
        (finite_output_shannon_entropy outP -
          ∫ s, finite_output_shannon_entropy (P s) ∂μ) +
          4 * δ * Real.log ((Nat.card M : ℝ) / δ) := by
    linarith
  rw [hQexp, hPexp]
  rw [← EReal.coe_add]
  exact EReal.coe_le_coe_iff.mpr hreal

@[blueprint "lem:finite-output-mutual-information-le-log-card"
  (statement := /-- For a Markov kernel \(K:S\rightsquigarrow M\) into a
  finite measurable space with measurable singletons and a probability input
  law \(\mu\),
  \[
    I_{\mu K}(M;S)\leq\log|M|.
  \] -/)
  (proof := /-- By
  \cref{lem:finite-output-mutual-information-entropy-expansion}, mutual
  information is the output entropy minus the mean conditional entropy.
  Both pointwise nonnegativity and the upper bound on output entropy are
  supplied by \cref{lem:finite-output-shannon-entropy-bounds}, while
  \cref{lem:finite-output-entropy-integrable} justifies the conditional
  entropy integral. Subtracting its nonnegative value proves the result. -/)
  (title := /-- Finite-output mutual information is bounded by log-cardinality -/)
  (latexEnv := "lemma")]
lemma finite_output_mutual_information_le_log_card
    {S M : Type*} [MeasurableSpace S] [MeasurableSpace M]
    [MeasurableSingletonClass M] [Finite M]
    (μ : Measure S) [IsProbabilityMeasure μ]
    (K : ProbabilityTheory.Kernel S M)
    [ProbabilityTheory.IsMarkovKernel K] :
    (mutual_information (μ.compProd K) Prod.snd Prod.fst : EReal) ≤
      ((Real.log (Nat.card M) : ℝ) : EReal) := by
  let out : Measure M := μ.bind K
  letI : IsProbabilityMeasure out := by dsimp [out]; infer_instance
  have hexp := finite_output_mutual_information_entropy_expansion μ K
  have hout : Measure.map Prod.snd (μ.compProd K) = out := by
    change (μ.compProd K).snd = out
    simp [out]
  rw [hout] at hexp
  have hInt := finite_output_entropy_integrable μ K
  have hInt0 : 0 ≤ ∫ s, finite_output_shannon_entropy (K s) ∂μ :=
    integral_nonneg_of_ae <| ae_of_all μ fun s =>
      (finite_output_shannon_entropy_bounds (K s)).1
  have hreal : finite_output_shannon_entropy out -
      ∫ s, finite_output_shannon_entropy (K s) ∂μ ≤
        Real.log (Nat.card M) := by
    linarith [finite_output_shannon_entropy_bounds out]
  rw [hexp]
  exact EReal.coe_le_coe_iff.mpr hreal

@[blueprint "lem:finite-output-kernel-information-transport-large-delta"
  (statement := /-- Let \(P,Q:S\rightsquigarrow M\) be Markov kernels into
  a finite measurable space with measurable singletons, and let \(\mu\) be
  a probability measure. If \(0<\delta\leq1\) and
  \(\log(|M|/\delta)<1\), then
  \[
    I_{\mu Q}(Z;S)\leq I_{\mu P}(Z;S)
      +4\delta\log(|M|/\delta).
  \] -/)
  (proof := /-- By
  \cref{lem:finite-output-mutual-information-le-log-card}, the left-hand
  side is at most \(\log|M|\). If \(|M|=1\), this is zero and the penalty is
  nonnegative. Otherwise \(|M|\geq2\). The hypothesis
  \(\log(|M|/\delta)<1\), together with \(e<3\), forces
  \(\delta>2/3\); also
  \(\log(|M|/\delta)\geq\log2>2/3\). Hence the penalty exceeds one, while
  \(\log|M|<1\), so it dominates the left-hand side. -/)
  (title := /-- Finite-output information transport in the large-error regime -/)
  (latexEnv := "lemma")]
lemma finite_output_kernel_information_transport_large_delta
    {S M : Type*} [MeasurableSpace S] [MeasurableSpace M]
    [MeasurableSingletonClass M] [Finite M]
    (μ : Measure S) [IsProbabilityMeasure μ]
    (P Q : ProbabilityTheory.Kernel S M)
    [ProbabilityTheory.IsMarkovKernel P] [ProbabilityTheory.IsMarkovKernel Q]
    (δ : ℝ) (hδpos : 0 < δ) (hδ1 : δ ≤ 1)
    (hlog : Real.log ((Nat.card M : ℝ) / δ) < 1) :
    (mutual_information (μ.compProd Q) Prod.snd Prod.fst : EReal) ≤
      (mutual_information (μ.compProd P) Prod.snd Prod.fst : EReal) +
        ((4 * δ * Real.log ((Nat.card M : ℝ) / δ) : ℝ) : EReal) := by
  let outQ : Measure M := μ.bind Q
  letI : IsProbabilityMeasure outQ := by dsimp [outQ]; infer_instance
  letI := Fintype.ofFinite M
  have hM : Nonempty M := by
    have hsum : ∑ m : M, (outQ {m}).toReal = 1 := by
      simpa [Measure.real, measure_univ] using
        (sum_measureReal_singleton (μ := outQ) (Finset.univ : Finset M))
    by_contra h
    haveI : IsEmpty M := not_nonempty_iff.mp h
    simpa using hsum
  let N : ℝ := Fintype.card M
  let L : ℝ := Real.log (N / δ)
  have hNpos : 0 < N := by
    dsimp [N]
    exact_mod_cast Fintype.card_pos
  have hN1 : 1 ≤ N := by
    dsimp [N]
    exact_mod_cast Fintype.card_pos
  have hratio : 1 ≤ N / δ := by
    apply (le_div_iff₀ hδpos).2
    nlinarith
  have hL0 : 0 ≤ L := Real.log_nonneg hratio
  have hpen : Real.log N ≤ 4 * δ * L := by
    by_cases hcard : Fintype.card M = 1
    · rw [show N = 1 by simp [N, hcard], Real.log_one]
      positivity
    · have hcardpos : 0 < Fintype.card M := Fintype.card_pos
      have hcard2nat : 2 ≤ Fintype.card M := by omega
      have hN2 : (2 : ℝ) ≤ N := by
        dsimp [N]
        exact_mod_cast hcard2nat
      have hlog8 : (1 : ℝ) < Real.log 8 := by
        calc
          (1 : ℝ) < (1 - (2 : ℝ)⁻¹) + (1 - (4 : ℝ)⁻¹) := by norm_num
          _ ≤ Real.log 2 + Real.log 4 := add_le_add
            (Real.one_sub_inv_le_log_of_pos (by norm_num))
            (Real.one_sub_inv_le_log_of_pos (by norm_num))
          _ = Real.log 8 := by
            rw [← Real.log_mul (by norm_num : (2 : ℝ) ≠ 0)
              (by norm_num : (4 : ℝ) ≠ 0)]
            norm_num
      have hδlarge : (1 / 4 : ℝ) < δ := by
        by_contra h
        have hδsmall : δ ≤ 1 / 4 := le_of_not_gt h
        have hratio8 : (8 : ℝ) ≤ N / δ := by
          apply (le_div_iff₀ hδpos).2
          nlinarith
        have hlogratio : Real.log 8 ≤ L := by
          dsimp [L]
          exact Real.log_le_log (by norm_num) hratio8
        have hlogL : L < 1 := by
          simpa [L, N, Nat.card_eq_fintype_card] using hlog
        linarith
      have hlogN : Real.log N ≤ L := by
        apply Real.log_le_log hNpos
        apply (le_div_iff₀ hδpos).2
        nlinarith [mul_nonneg hNpos.le (sub_nonneg.mpr hδ1)]
      have hscale : L ≤ 4 * δ * L := by
        nlinarith [mul_nonneg hL0 (sub_nonneg.mpr hδlarge.le)]
      exact hlogN.trans hscale
  have hIQ := finite_output_mutual_information_le_log_card μ Q
  have hcoe : ((Real.log (Nat.card M) : ℝ) : EReal) ≤
      ((4 * δ * Real.log ((Nat.card M : ℝ) / δ) : ℝ) : EReal) :=
    EReal.coe_le_coe_iff.mpr (by
      simpa [N, L, Nat.card_eq_fintype_card] using hpen)
  calc
    (mutual_information (μ.compProd Q) Prod.snd Prod.fst : EReal) ≤
        ((Real.log (Nat.card M) : ℝ) : EReal) := hIQ
    _ ≤ ((4 * δ * Real.log ((Nat.card M : ℝ) / δ) : ℝ) : EReal) := hcoe
    _ ≤ (mutual_information (μ.compProd P) Prod.snd Prod.fst : EReal) +
        ((4 * δ * Real.log ((Nat.card M : ℝ) / δ) : ℝ) : EReal) := by
      simpa only [zero_add, add_comm] using add_le_add_right
        (show (0 : EReal) ≤
          (mutual_information (μ.compProd P) Prod.snd Prod.fst : EReal) by
            positivity)
        ((4 * δ * Real.log ((Nat.card M : ℝ) / δ) : ℝ) : EReal)

@[blueprint "lem:finite-output-conditional-kernel-information-transport-all"
  (statement := /-- Let \(P,Q:S\rightsquigarrow M\) be Markov kernels into
  a finite measurable space with measurable singletons, over a common
  probability input law \(\mu\). If \(0\leq\delta\leq1\) and
  \(d_{\mathrm{TV}}(P_s,Q_s)\leq\delta\) for \(\mu\)-almost every \(s\),
  then
  \[
    I_{\mu Q}(Z;S)\leq I_{\mu P}(Z;S)
      +4\delta\log(|M|/\delta).
  \] -/)
  (proof := /-- If \(\delta>0\), split according as
  \(1\leq\log(|M|/\delta)\). The first case is
  \cref{lem:finite-output-conditional-kernel-information-transport}, and
  the complementary case is
  \cref{lem:finite-output-kernel-information-transport-large-delta}. If
  \(\delta=0\), expand both mutual informations using
  \cref{lem:finite-output-mutual-information-entropy-expansion}. The output
  entropies agree by \cref{lem:finite-output-total-variation-mixture-bound}
  and \cref{lem:finite-output-entropy-continuity}, while the conditional
  entropies agree almost everywhere by the same continuity estimate; hence
  the two mutual informations are equal. -/)
  (title := /-- Conditional-kernel transport of finite-output information -/)
  (latexEnv := "lemma")]
lemma finite_output_conditional_kernel_information_transport_all
    {S M : Type*} [MeasurableSpace S] [MeasurableSpace M]
    [MeasurableSingletonClass M] [Finite M]
    (μ : Measure S) [IsProbabilityMeasure μ]
    (P Q : ProbabilityTheory.Kernel S M)
    [ProbabilityTheory.IsMarkovKernel P] [ProbabilityTheory.IsMarkovKernel Q]
    (δ : ℝ) (hδ : 0 ≤ δ ∧ δ ≤ 1)
    (hTV : ∀ᵐ s ∂μ, total_variation_distance (P s) (Q s) ≤ δ) :
    (mutual_information (μ.compProd Q) Prod.snd Prod.fst : EReal) ≤
      (mutual_information (μ.compProd P) Prod.snd Prod.fst : EReal) +
        ((4 * δ * Real.log ((Nat.card M : ℝ) / δ) : ℝ) : EReal) := by
  by_cases hδzero : δ = 0
  · subst δ
    let outP : Measure M := μ.bind P
    let outQ : Measure M := μ.bind Q
    letI : IsProbabilityMeasure outP := by dsimp [outP]; infer_instance
    letI : IsProbabilityMeasure outQ := by dsimp [outQ]; infer_instance
    have hPexp := finite_output_mutual_information_entropy_expansion μ P
    have hQexp := finite_output_mutual_information_entropy_expansion μ Q
    have hPout : Measure.map Prod.snd (μ.compProd P) = outP := by
      change (μ.compProd P).snd = outP
      simp [outP]
    have hQout : Measure.map Prod.snd (μ.compProd Q) = outQ := by
      change (μ.compProd Q).snd = outQ
      simp [outQ]
    rw [hPout] at hPexp
    rw [hQout] at hQexp
    have hOutTV : total_variation_distance outP outQ ≤ 0 :=
      finite_output_total_variation_mixture_bound μ P Q 0 hTV
    have hOutBound := finite_output_entropy_continuity outP outQ 0
      ⟨le_rfl, zero_le_one⟩ hOutTV
    have hOutBound0 : |finite_output_shannon_entropy outP -
        finite_output_shannon_entropy outQ| ≤ 0 := by
      simpa using hOutBound
    have hOutEq : finite_output_shannon_entropy outP =
        finite_output_shannon_entropy outQ := by
      apply sub_eq_zero.mp
      apply abs_eq_zero.mp
      exact le_antisymm hOutBound0 (abs_nonneg _)
    have hCondEq : (∫ s, finite_output_shannon_entropy (P s) ∂μ) =
        ∫ s, finite_output_shannon_entropy (Q s) ∂μ := by
      apply integral_congr_ae
      filter_upwards [hTV] with s hs
      have hsBound := finite_output_entropy_continuity (P s) (Q s) 0
        ⟨le_rfl, zero_le_one⟩ hs
      have hsBound0 : |finite_output_shannon_entropy (P s) -
          finite_output_shannon_entropy (Q s)| ≤ 0 := by
        simpa using hsBound
      apply sub_eq_zero.mp
      apply abs_eq_zero.mp
      exact le_antisymm hsBound0 (abs_nonneg _)
    rw [hQexp, hPexp, ← hOutEq, ← hCondEq]
    simp
  · have hδpos : 0 < δ := lt_of_le_of_ne hδ.1 (Ne.symm hδzero)
    by_cases hlog : 1 ≤ Real.log ((Nat.card M : ℝ) / δ)
    · exact finite_output_conditional_kernel_information_transport
        μ P Q δ hδ hTV hlog
    · exact finite_output_kernel_information_transport_large_delta
        μ P Q δ hδpos hδ.2 (lt_of_not_ge hlog)

@[blueprint "lem:finite-output-input-law-information-transport"
  (statement := /-- Let \(K:S\rightsquigarrow M\) be a Markov kernel into
  a finite measurable space with measurable singletons, and let \(\mu,\nu\)
  be probability input laws. Suppose \(0\leq\delta\leq1\),
  \(d_{\mathrm{TV}}(\mu,\nu)\leq\delta\), and
  \(1\leq\log(|M|/\delta)\). Then
  \[
    I_{\nu K}(Z;S)\leq I_{\mu K}(Z;S)
      +4\delta\log(|M|/\delta).
  \] -/)
  (proof := /-- Expand both mutual informations by
  \cref{lem:finite-output-mutual-information-entropy-expansion}. Total
  variation of the output laws is at most \(\delta\) by
  \cref{lem:finite-output-total-variation-bind-contraction}, so
  \cref{lem:finite-output-total-variation-symmetric} gives the orientation
  required for \cref{lem:finite-output-entropy-one-sided-continuity} to
  control the output entropy difference. The conditional entropy function is measurable and,
  by \cref{lem:finite-output-shannon-entropy-bounds}, lies between zero and
  \(\log|M|\); hence
  \cref{lem:finite-output-total-variation-integral-bound} controls the
  change of its expectation. The logarithmic hypothesis absorbs the two
  resulting terms into the displayed error. -/)
  (title := /-- Input-law transport of finite-output information -/)
  (latexEnv := "lemma")]
lemma finite_output_input_law_information_transport
    {S M : Type*} [MeasurableSpace S] [MeasurableSpace M]
    [MeasurableSingletonClass M] [Finite M]
    (μ ν : Measure S) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (K : ProbabilityTheory.Kernel S M)
    [ProbabilityTheory.IsMarkovKernel K]
    (δ : ℝ) (hδ : 0 ≤ δ ∧ δ ≤ 1)
    (hTV : total_variation_distance μ ν ≤ δ)
    (hlog : 1 ≤ Real.log ((Nat.card M : ℝ) / δ)) :
    (mutual_information (ν.compProd K) Prod.snd Prod.fst : EReal) ≤
      (mutual_information (μ.compProd K) Prod.snd Prod.fst : EReal) +
        ((4 * δ * Real.log ((Nat.card M : ℝ) / δ) : ℝ) : EReal) := by
  let outμ : Measure M := μ.bind K
  let outν : Measure M := ν.bind K
  letI : IsProbabilityMeasure outμ := by dsimp [outμ]; infer_instance
  letI : IsProbabilityMeasure outν := by dsimp [outν]; infer_instance
  have hμexp := finite_output_mutual_information_entropy_expansion μ K
  have hνexp := finite_output_mutual_information_entropy_expansion ν K
  have hμout : Measure.map Prod.snd (μ.compProd K) = outμ := by
    change (μ.compProd K).snd = outμ
    simp [outμ]
  have hνout : Measure.map Prod.snd (ν.compProd K) = outν := by
    change (ν.compProd K).snd = outν
    simp [outν]
  rw [hμout] at hμexp
  rw [hνout] at hνexp
  have hOutTV0 : total_variation_distance outμ outν ≤ δ :=
    finite_output_total_variation_bind_contraction μ ν K δ hTV
  have hOutTV : total_variation_distance outν outμ ≤ δ := by
    rw [finite_output_total_variation_symmetric]
    exact hOutTV0
  have hOut := finite_output_entropy_one_sided_continuity
    outν outμ δ hδ hOutTV hlog
  have hlogcard0 : 0 ≤ Real.log (Nat.card M) := by
    linarith [finite_output_shannon_entropy_bounds outμ]
  have hKmeas : Measurable (fun s => finite_output_shannon_entropy (K s)) := by
    classical
    unfold finite_output_shannon_entropy
    apply Finset.measurable_sum
    intro m hm
    have hmeas : Measurable (fun s => (K s {m}).toReal) :=
      (K.measurable_coe (measurableSet_singleton m)).ennreal_toReal
    simpa [Function.comp_def, Real.negMulLog, neg_mul] using
      (Real.continuous_negMulLog.measurable.comp hmeas)
  have hInt := finite_output_total_variation_integral_bound μ ν δ
    (Real.log (Nat.card M)) hlogcard0
    (fun s => finite_output_shannon_entropy (K s)) hKmeas
    (fun s => (finite_output_shannon_entropy_bounds (K s)).1)
    (fun s => (finite_output_shannon_entropy_bounds (K s)).2) hTV
  have hM : Nonempty M := by
    letI := Fintype.ofFinite M
    have hsum : ∑ m : M, (outμ {m}).toReal = 1 := by
      simpa [Measure.real, measure_univ] using
        (sum_measureReal_singleton (μ := outμ) (Finset.univ : Finset M))
    by_contra h
    haveI : IsEmpty M := not_nonempty_iff.mp h
    simpa using hsum
  have hcardpos : (0 : ℝ) < Nat.card M := by
    exact_mod_cast Nat.card_pos
  have hδpos : 0 < δ := lt_of_le_of_ne hδ.1 (by
    intro hz
    subst δ
    norm_num at hlog)
  have hlogcard : Real.log (Nat.card M) ≤
      Real.log ((Nat.card M : ℝ) / δ) := by
    apply Real.log_le_log hcardpos
    apply (le_div_iff₀ hδpos).2
    nlinarith [mul_nonneg hcardpos.le (sub_nonneg.mpr hδ.2)]
  have hbudget : δ * (Real.log ((Nat.card M : ℝ) / δ) + 1) +
      Real.log (Nat.card M) * δ ≤
        4 * δ * Real.log ((Nat.card M : ℝ) / δ) := by
    nlinarith [mul_nonneg hδ.1 (sub_nonneg.mpr hlog),
      mul_nonneg hδ.1 (sub_nonneg.mpr hlogcard)]
  have hreal :
      finite_output_shannon_entropy outν -
          ∫ s, finite_output_shannon_entropy (K s) ∂ν ≤
        (finite_output_shannon_entropy outμ -
          ∫ s, finite_output_shannon_entropy (K s) ∂μ) +
          4 * δ * Real.log ((Nat.card M : ℝ) / δ) := by
    have hIntOne : (∫ s, finite_output_shannon_entropy (K s) ∂μ) -
        ∫ s, finite_output_shannon_entropy (K s) ∂ν ≤
          Real.log (Nat.card M) * δ := le_trans (le_abs_self _) hInt
    linarith
  rw [hνexp, hμexp, ← EReal.coe_add]
  exact EReal.coe_le_coe_iff.mpr hreal

@[blueprint "lem:finite-output-input-law-information-transport-zero"
  (statement := /-- Let \(K:S\rightsquigarrow M\) be a Markov kernel into
  a finite measurable space with measurable singletons, and let \(\mu,\nu\)
  be probability input laws at total-variation distance zero. Then
  \(I_{\nu K}(Z;S)\leq I_{\mu K}(Z;S)\). -/)
  (proof := /-- Expand both mutual informations with
  \cref{lem:finite-output-mutual-information-entropy-expansion}. By
  \cref{lem:finite-output-total-variation-bind-contraction} and
  \cref{lem:finite-output-total-variation-symmetric}, the output laws have
  zero total-variation distance in the required orientation; then
  \cref{lem:finite-output-entropy-continuity} shows that the output entropy
  cannot increase. The conditional entropy function lies in
  \([0,\log|M|]\) by
  \cref{lem:finite-output-shannon-entropy-bounds}, and
  \cref{lem:finite-output-total-variation-integral-bound} shows that its
  two expectations agree. Substitution gives the claim. -/)
  (title := /-- Zero-distance input-law transport of information -/)
  (latexEnv := "lemma")]
lemma finite_output_input_law_information_transport_zero
    {S M : Type*} [MeasurableSpace S] [MeasurableSpace M]
    [MeasurableSingletonClass M] [Finite M]
    (μ ν : Measure S) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (K : ProbabilityTheory.Kernel S M)
    [ProbabilityTheory.IsMarkovKernel K]
    (hTV : total_variation_distance μ ν ≤ 0) :
    (mutual_information (ν.compProd K) Prod.snd Prod.fst : EReal) ≤
      (mutual_information (μ.compProd K) Prod.snd Prod.fst : EReal) := by
  let outμ : Measure M := μ.bind K
  let outν : Measure M := ν.bind K
  letI : IsProbabilityMeasure outμ := by dsimp [outμ]; infer_instance
  letI : IsProbabilityMeasure outν := by dsimp [outν]; infer_instance
  have hμexp := finite_output_mutual_information_entropy_expansion μ K
  have hνexp := finite_output_mutual_information_entropy_expansion ν K
  have hμout : Measure.map Prod.snd (μ.compProd K) = outμ := by
    change (μ.compProd K).snd = outμ
    simp [outμ]
  have hνout : Measure.map Prod.snd (ν.compProd K) = outν := by
    change (ν.compProd K).snd = outν
    simp [outν]
  rw [hμout] at hμexp
  rw [hνout] at hνexp
  have hOutTV0 : total_variation_distance outμ outν ≤ 0 :=
    finite_output_total_variation_bind_contraction μ ν K 0 hTV
  have hOutTV : total_variation_distance outν outμ ≤ 0 := by
    rw [finite_output_total_variation_symmetric]
    exact hOutTV0
  have hOutBound := finite_output_entropy_continuity outν outμ 0
    ⟨le_rfl, zero_le_one⟩ hOutTV
  have hOut : finite_output_shannon_entropy outν ≤
      finite_output_shannon_entropy outμ := by
    have hzero : |finite_output_shannon_entropy outν -
        finite_output_shannon_entropy outμ| ≤ 0 := by simpa using hOutBound
    linarith [le_abs_self (finite_output_shannon_entropy outν -
      finite_output_shannon_entropy outμ)]
  have hlogcard0 : 0 ≤ Real.log (Nat.card M) := by
    linarith [finite_output_shannon_entropy_bounds outμ]
  have hKmeas : Measurable (fun s => finite_output_shannon_entropy (K s)) := by
    classical
    unfold finite_output_shannon_entropy
    apply Finset.measurable_sum
    intro m hm
    have hmeas : Measurable (fun s => (K s {m}).toReal) :=
      (K.measurable_coe (measurableSet_singleton m)).ennreal_toReal
    simpa [Function.comp_def, Real.negMulLog, neg_mul] using
      (Real.continuous_negMulLog.measurable.comp hmeas)
  have hIntBound := finite_output_total_variation_integral_bound μ ν 0
    (Real.log (Nat.card M)) hlogcard0
    (fun s => finite_output_shannon_entropy (K s)) hKmeas
    (fun s => (finite_output_shannon_entropy_bounds (K s)).1)
    (fun s => (finite_output_shannon_entropy_bounds (K s)).2) hTV
  have hInt : (∫ s, finite_output_shannon_entropy (K s) ∂μ) ≤
      ∫ s, finite_output_shannon_entropy (K s) ∂ν := by
    have hzero : |(∫ s, finite_output_shannon_entropy (K s) ∂μ) -
        ∫ s, finite_output_shannon_entropy (K s) ∂ν| ≤ 0 := by
      simpa using hIntBound
    linarith [le_abs_self ((∫ s, finite_output_shannon_entropy (K s) ∂μ) -
      ∫ s, finite_output_shannon_entropy (K s) ∂ν)]
  rw [hνexp, hμexp]
  exact EReal.coe_le_coe_iff.mpr (by linarith)

@[blueprint "lem:finite-output-input-law-information-transport-large-delta"
  (statement := /-- Let \(K:S\rightsquigarrow M\) be a Markov kernel into
  a finite measurable space with measurable singletons, and let \(\mu,\nu\)
  be probability input laws. If \(0<\delta\leq1\) and
  \(\log(|M|/\delta)<1\), then
  \[
    I_{\nu K}(Z;S)\leq I_{\mu K}(Z;S)
      +4\delta\log(|M|/\delta).
  \] -/)
  (proof := /-- By
  \cref{lem:finite-output-mutual-information-le-log-card}, the left side is
  at most \(\log|M|\). The probability output law makes \(M\) nonempty. If
  \(|M|=1\), the bound is immediate. Otherwise \(|M|\geq2\). The elementary
  estimate \(1<\log8\) shows that the logarithmic hypothesis forces
  \(\delta>1/4\), while \(\delta\leq1\) gives
  \(\log|M|\leq\log(|M|/\delta)\). Thus the displayed penalty dominates
  \(\log|M|\), and mutual information on the right is nonnegative. -/)
  (title := /-- Input-law information transport in the large-error regime -/)
  (latexEnv := "lemma")]
lemma finite_output_input_law_information_transport_large_delta
    {S M : Type*} [MeasurableSpace S] [MeasurableSpace M]
    [MeasurableSingletonClass M] [Finite M]
    (μ ν : Measure S) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (K : ProbabilityTheory.Kernel S M)
    [ProbabilityTheory.IsMarkovKernel K]
    (δ : ℝ) (hδpos : 0 < δ) (hδ1 : δ ≤ 1)
    (hlog : Real.log ((Nat.card M : ℝ) / δ) < 1) :
    (mutual_information (ν.compProd K) Prod.snd Prod.fst : EReal) ≤
      (mutual_information (μ.compProd K) Prod.snd Prod.fst : EReal) +
        ((4 * δ * Real.log ((Nat.card M : ℝ) / δ) : ℝ) : EReal) := by
  let outν : Measure M := ν.bind K
  letI : IsProbabilityMeasure outν := by dsimp [outν]; infer_instance
  letI := Fintype.ofFinite M
  have hM : Nonempty M := by
    have hsum : ∑ m : M, (outν {m}).toReal = 1 := by
      simpa [Measure.real, measure_univ] using
        (sum_measureReal_singleton (μ := outν) (Finset.univ : Finset M))
    by_contra h
    haveI : IsEmpty M := not_nonempty_iff.mp h
    simpa using hsum
  let N : ℝ := Fintype.card M
  let L : ℝ := Real.log (N / δ)
  have hNpos : 0 < N := by
    dsimp [N]
    exact_mod_cast Fintype.card_pos
  have hN1 : 1 ≤ N := by
    dsimp [N]
    exact_mod_cast Fintype.card_pos
  have hratio : 1 ≤ N / δ := by
    apply (le_div_iff₀ hδpos).2
    nlinarith
  have hL0 : 0 ≤ L := Real.log_nonneg hratio
  have hpen : Real.log N ≤ 4 * δ * L := by
    by_cases hcard : Fintype.card M = 1
    · rw [show N = 1 by simp [N, hcard], Real.log_one]
      positivity
    · have hcardpos : 0 < Fintype.card M := Fintype.card_pos
      have hcard2nat : 2 ≤ Fintype.card M := by omega
      have hN2 : (2 : ℝ) ≤ N := by
        dsimp [N]
        exact_mod_cast hcard2nat
      have hlog8 : (1 : ℝ) < Real.log 8 := by
        calc
          (1 : ℝ) < (1 - (2 : ℝ)⁻¹) + (1 - (4 : ℝ)⁻¹) := by norm_num
          _ ≤ Real.log 2 + Real.log 4 := add_le_add
            (Real.one_sub_inv_le_log_of_pos (by norm_num))
            (Real.one_sub_inv_le_log_of_pos (by norm_num))
          _ = Real.log 8 := by
            rw [← Real.log_mul (by norm_num : (2 : ℝ) ≠ 0)
              (by norm_num : (4 : ℝ) ≠ 0)]
            norm_num
      have hδlarge : (1 / 4 : ℝ) < δ := by
        by_contra h
        have hδsmall : δ ≤ 1 / 4 := le_of_not_gt h
        have hratio8 : (8 : ℝ) ≤ N / δ := by
          apply (le_div_iff₀ hδpos).2
          nlinarith
        have hlogratio : Real.log 8 ≤ L := by
          dsimp [L]
          exact Real.log_le_log (by norm_num) hratio8
        have hlogL : L < 1 := by
          simpa [L, N, Nat.card_eq_fintype_card] using hlog
        linarith
      have hlogN : Real.log N ≤ L := by
        apply Real.log_le_log hNpos
        apply (le_div_iff₀ hδpos).2
        nlinarith [mul_nonneg hNpos.le (sub_nonneg.mpr hδ1)]
      have hscale : L ≤ 4 * δ * L := by
        nlinarith [mul_nonneg hL0 (sub_nonneg.mpr hδlarge.le)]
      exact hlogN.trans hscale
  have hIν := finite_output_mutual_information_le_log_card ν K
  have hcoe : ((Real.log (Nat.card M) : ℝ) : EReal) ≤
      ((4 * δ * Real.log ((Nat.card M : ℝ) / δ) : ℝ) : EReal) :=
    EReal.coe_le_coe_iff.mpr (by
      simpa [N, L, Nat.card_eq_fintype_card] using hpen)
  calc
    (mutual_information (ν.compProd K) Prod.snd Prod.fst : EReal) ≤
        ((Real.log (Nat.card M) : ℝ) : EReal) := hIν
    _ ≤ ((4 * δ * Real.log ((Nat.card M : ℝ) / δ) : ℝ) : EReal) := hcoe
    _ ≤ (mutual_information (μ.compProd K) Prod.snd Prod.fst : EReal) +
        ((4 * δ * Real.log ((Nat.card M : ℝ) / δ) : ℝ) : EReal) := by
      simpa only [zero_add, add_comm] using add_le_add_right
        (show (0 : EReal) ≤
          (mutual_information (μ.compProd K) Prod.snd Prod.fst : EReal) by
            positivity)
        ((4 * δ * Real.log ((Nat.card M : ℝ) / δ) : ℝ) : EReal)

@[blueprint "lem:finite-output-input-law-information-transport-all"
  (statement := /-- Let \(K:S\rightsquigarrow M\) be a Markov kernel into
  a finite measurable space with measurable singletons, and let \(\mu,\nu\)
  be probability input laws. If \(0\leq\delta\leq1\) and
  \(d_{\mathrm{TV}}(\mu,\nu)\leq\delta\), then
  \[
    I_{\nu K}(Z;S)\leq I_{\mu K}(Z;S)
      +4\delta\log(|M|/\delta).
  \] -/)
  (proof := /-- If \(\delta=0\), use
  \cref{lem:finite-output-input-law-information-transport-zero}. Otherwise
  split according as \(1\leq\log(|M|/\delta)\), and apply respectively
  \cref{lem:finite-output-input-law-information-transport} or
  \cref{lem:finite-output-input-law-information-transport-large-delta}. -/)
  (title := /-- Input-law transport of finite-output information -/)
  (latexEnv := "lemma")]
lemma finite_output_input_law_information_transport_all
    {S M : Type*} [MeasurableSpace S] [MeasurableSpace M]
    [MeasurableSingletonClass M] [Finite M]
    (μ ν : Measure S) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (K : ProbabilityTheory.Kernel S M)
    [ProbabilityTheory.IsMarkovKernel K]
    (δ : ℝ) (hδ : 0 ≤ δ ∧ δ ≤ 1)
    (hTV : total_variation_distance μ ν ≤ δ) :
    (mutual_information (ν.compProd K) Prod.snd Prod.fst : EReal) ≤
      (mutual_information (μ.compProd K) Prod.snd Prod.fst : EReal) +
        ((4 * δ * Real.log ((Nat.card M : ℝ) / δ) : ℝ) : EReal) := by
  by_cases hδzero : δ = 0
  · subst δ
    simpa using finite_output_input_law_information_transport_zero μ ν K hTV
  · have hδpos : 0 < δ := lt_of_le_of_ne hδ.1 (Ne.symm hδzero)
    by_cases hlog : 1 ≤ Real.log ((Nat.card M : ℝ) / δ)
    · exact finite_output_input_law_information_transport
        μ ν K δ hδ hTV hlog
    · exact finite_output_input_law_information_transport_large_delta
        μ ν K δ hδpos hδ.2 (lt_of_not_ge hlog)

@[blueprint "lem:finite-output-conditional-tv-information-transport"
  (statement := /-- Let \(S\) be a second-countable Hausdorff space equipped
  with its Borel \(\sigma\)-algebra, let \(T\) be a nonempty standard Borel
  space, and let \(\kappa\) be a probability measure on
  \((S\times T)\times T\). Define the coordinate maps
  \(A'(s,t,\widetilde t)=s\), \(B'(s,t,\widetilde t)=t\), and
  \(\widetilde B(s,t,\widetilde t)=\widetilde t\), and assume that \(B'\)
  is measurable. Suppose
  \(0\leq\delta\leq1\) and
  \[
    d_{\mathrm{TV}}\!\left(\mathcal L(\widetilde B\mid A'=a),
      \mathcal L(B'\mid A'=a)\right)\leq\delta
  \]
  for every \(a\) in the support of the law of \(A'\). Let
  \(\mathcal M\) be finite with measurable singletons, and let
  \(K:T\rightsquigarrow\mathcal M\) be a Markov kernel. On the two
  probability spaces obtained by applying \(K\) respectively to \(B'\)
  and \(\widetilde B\), write \(Z'\) and \(\widetilde Z\) for the
  resulting outputs. Then
  \[
    I(Z';A')\leq I(\widetilde Z;A')
      +\frac12q_{\mathcal M}(\delta)
  \]
  and
  \[
    I(\widetilde Z;\widetilde B)\leq I(Z';B')
      +\frac12q_{\mathcal M}(\delta),
  \]
  where each mutual information is computed under its displayed induced
  probability law and \(q_{\mathcal M}\) is defined in
  \cref{def:information-error-penalty}. -/)
  (proof := /-- Let \(A',B',\widetilde B\) denote the three coordinate
  maps and disintegrate the laws of \(B'\) and \(\widetilde B\) over the
  law of \(A'\). The support of that law has full measure, so the assumed
  conditional total-variation estimate holds almost everywhere. Applying
  \cref{lem:finite-output-total-variation-bind-contraction} pointwise to the
  common algorithm kernel gives the same estimate for the two conditional
  output kernels. Hence
  \cref{lem:finite-output-conditional-kernel-information-transport-all}
  proves the first canonical information inequality. The identities in
  \cref{lem:finite-output-conditional-algorithm-mutual-information-law}
  identify its two sides with the mutual informations in the statement.

  Before postprocessing, integration of the conditional estimate by
  \cref{lem:finite-output-total-variation-mixture-bound} bounds the
  total-variation distance between the marginals of \(\widetilde B\) and
  \(B'\). Reorient this distance using
  \cref{lem:finite-output-total-variation-symmetric}, and apply
  \cref{lem:finite-output-input-law-information-transport-all} to the
  common algorithm kernel. Finally,
  \cref{lem:finite-output-learning-algorithm-mutual-information-law}
  identifies the resulting canonical mutual informations with the second
  pair in the statement. In both cases the displayed real error equals
  \(q_{\mathcal M}(\delta)/2\) by
  \cref{def:information-error-penalty}, including when \(\delta=0\). -/)
  (title := /-- Conditional-total-variation transport of finite-output information -/)
  (latexEnv := "lemma")]
lemma finite_output_conditional_tv_information_transport
    {S T : Type*} {M : Type} [TopologicalSpace S] [MeasurableSpace S]
    [BorelSpace S] [SecondCountableTopology S] [T2Space S]
    [MeasurableSpace T] [StandardBorelSpace T] [Nonempty T]
    [MeasurableSpace M] [MeasurableSingletonClass M] [Finite M]
    (κ : Measure ((S × T) × T)) [IsProbabilityMeasure κ]
    (δ : ℝ)
    (hδ : 0 ≤ δ ∧ δ ≤ 1)
    (hTV : ∀ a ∈ (Measure.map (fun z => z.1.1) κ).support,
      total_variation_distance
        (ProbabilityTheory.condDistrib Prod.snd (fun z => z.1.1) κ a)
        (ProbabilityTheory.condDistrib (fun z => z.1.2)
          (fun z => z.1.1) κ a) ≤ δ)
    (hB : Measurable (fun z : (S × T) × T => z.1.2))
    (algorithm : learning_algorithm T M) :
    (mutual_information
        (learning_algorithm_joint_measure κ (fun z => z.1.2) hB algorithm)
        Prod.snd (fun zm => zm.1.1.1) : EReal) ≤
        (mutual_information
          (learning_algorithm_joint_measure κ Prod.snd measurable_snd algorithm)
          Prod.snd (fun zm => zm.1.1.1) : EReal) +
          information_error_penalty M δ / 2 ∧
      (mutual_information
          (learning_algorithm_joint_measure κ Prod.snd measurable_snd algorithm)
          Prod.snd (fun zm => zm.1.2) : EReal) ≤
        (mutual_information
          (learning_algorithm_joint_measure κ (fun z => z.1.2) hB algorithm)
          Prod.snd (fun zm => zm.1.1.2) : EReal) +
          information_error_penalty M δ / 2 := by
  let A : (S × T) × T → S := fun z => z.1.1
  let B : (S × T) × T → T := fun z => z.1.2
  let Bt : (S × T) × T → T := Prod.snd
  have hA : Measurable A := by fun_prop
  have hBt : Measurable Bt := measurable_snd
  let μA : Measure S := Measure.map A κ
  let μB : Measure T := Measure.map B κ
  let μBt : Measure T := Measure.map Bt κ
  let P : ProbabilityTheory.Kernel S M := algorithm.kernel.comp
    (ProbabilityTheory.condDistrib Bt A κ)
  let Q : ProbabilityTheory.Kernel S M := algorithm.kernel.comp
    (ProbabilityTheory.condDistrib B A κ)
  letI : ProbabilityTheory.IsMarkovKernel algorithm.kernel := algorithm.markov
  letI : IsProbabilityMeasure μA := by
    refine ⟨?_⟩
    rw [Measure.map_apply_of_aemeasurable hA.aemeasurable MeasurableSet.univ]
    simp
  letI : IsProbabilityMeasure μB := by
    refine ⟨?_⟩
    rw [Measure.map_apply_of_aemeasurable hB.aemeasurable MeasurableSet.univ]
    simp
  letI : IsProbabilityMeasure μBt := by
    refine ⟨?_⟩
    rw [Measure.map_apply_of_aemeasurable hBt.aemeasurable MeasurableSet.univ]
    simp
  letI : ProbabilityTheory.IsMarkovKernel P := by dsimp [P]; infer_instance
  letI : ProbabilityTheory.IsMarkovKernel Q := by dsimp [Q]; infer_instance
  have hCondTV : ∀ᵐ a ∂μA,
      total_variation_distance
        (ProbabilityTheory.condDistrib Bt A κ a)
        (ProbabilityTheory.condDistrib B A κ a) ≤ δ := by
    filter_upwards [Measure.support_mem_ae (μ := μA)] with a ha
    exact hTV a ha
  have hPostTV : ∀ᵐ a ∂μA, total_variation_distance (P a) (Q a) ≤ δ := by
    filter_upwards [hCondTV] with a ha
    simpa only [P, Q, ProbabilityTheory.Kernel.comp_apply] using
      finite_output_total_variation_bind_contraction
      (ProbabilityTheory.condDistrib Bt A κ a)
      (ProbabilityTheory.condDistrib B A κ a) algorithm.kernel δ ha
  have hFirstCanonical :=
    finite_output_conditional_kernel_information_transport_all
      μA P Q δ hδ hPostTV
  have hBInfo := finite_output_conditional_algorithm_mutual_information_law
    κ A B hA hB algorithm
  have hBtInfo := finite_output_conditional_algorithm_mutual_information_law
    κ A Bt hA hBt algorithm
  have hBtBind : μA.bind (ProbabilityTheory.condDistrib Bt A κ) = μBt := by
    rw [← Measure.snd_compProd]
    rw [ProbabilityTheory.compProd_map_condDistrib hBt.aemeasurable]
    change Measure.map Prod.snd (Measure.map (fun z => (A z, Bt z)) κ) =
      Measure.map Bt κ
    rw [Measure.map_map measurable_snd (hA.prodMk hBt)]
    rfl
  have hBBind : μA.bind (ProbabilityTheory.condDistrib B A κ) = μB := by
    rw [← Measure.snd_compProd]
    rw [ProbabilityTheory.compProd_map_condDistrib hB.aemeasurable]
    change Measure.map Prod.snd (Measure.map (fun z => (A z, B z)) κ) =
      Measure.map B κ
    rw [Measure.map_map measurable_snd (hA.prodMk hB)]
    rfl
  have hMargTV0 : total_variation_distance μBt μB ≤ δ := by
    simpa [hBtBind, hBBind] using
      finite_output_total_variation_mixture_bound μA
        (ProbabilityTheory.condDistrib Bt A κ)
        (ProbabilityTheory.condDistrib B A κ) δ hCondTV
  have hMargTV : total_variation_distance μB μBt ≤ δ := by
    rw [finite_output_total_variation_symmetric]
    exact hMargTV0
  have hSecondCanonical := finite_output_input_law_information_transport_all
    μB μBt algorithm.kernel δ hδ hMargTV
  have hBInputInfo := finite_output_learning_algorithm_mutual_information_law
    κ B hB algorithm
  have hBtInputInfo := finite_output_learning_algorithm_mutual_information_law
    κ Bt hBt algorithm
  have hPenalty : information_error_penalty M δ / 2 =
      ((4 * δ * Real.log ((Nat.card M : ℝ) / δ) : ℝ) : EReal) := by
    by_cases hδzero : δ = 0
    · simp [information_error_penalty, hδzero]
    · simp only [information_error_penalty, hδzero, if_false,
        if_pos (by infer_instance : Finite M)]
      change ((8 * δ * Real.log ((Nat.card M : ℝ) / δ) : ℝ) : EReal) /
          ((2 : ℝ) : EReal) =
        ((4 * δ * Real.log ((Nat.card M : ℝ) / δ) : ℝ) : EReal)
      rw [← EReal.coe_div]
      congr 1
      ring
  constructor
  · rw [hBInfo, hBtInfo, hPenalty]
    exact hFirstCanonical
  · rw [hBtInputInfo, hBInputInfo, hPenalty]
    exact hSecondCanonical

@[blueprint "lem:finite-output-coupled-sdpi-bound"
  (statement := /-- Let \(S\) be a second-countable Hausdorff space equipped
  with its Borel \(\sigma\)-algebra, let \(T\) be a nonempty standard
  Borel space, and let \(\kappa\) be a probability measure on
  \((S\times T)\times T\). Define the coordinate maps
  \(A'(s,t,\widetilde t)=s\), \(B'(s,t,\widetilde t)=t\), and
  \(\widetilde B(s,t,\widetilde t)=\widetilde t\), and assume that
  \(B'\) is measurable. Let \(\rho,\delta\in\mathbb R\), with
  \(0\leq\delta\leq1\). Assume that \((A',\widetilde B)\) satisfies
  the \(\rho\)-strong data processing inequality and that, for every
  \(a\) in the support of the law of \(A'\),
  \[
    d_{\mathrm{TV}}\!\left(\mathcal L(\widetilde B\mid A'=a),
      \mathcal L(B'\mid A'=a)\right)\leq\delta.
  \]
  Let \(\mathcal M\) be a finite measurable space whose singletons are
  measurable, and let \(K:T\rightsquigarrow\mathcal M\) be a Markov
  kernel. On the induced probability measure
  \[
    \nu(d\omega,dz)=\kappa(d\omega)K(B'(\omega),dz),
  \]
  write \(Z(\omega,z)=z\). Then, as an inequality of extended real
  numbers,
  \[
    I_\nu(Z;A')\leq \rho I_\nu(Z;B')
      +q_{\mathcal M}(\delta),
  \]
  where \(q_{\mathcal M}\) is defined in
  \cref{def:information-error-penalty}. -/)
  (proof := /-- Equip the algorithm kernel with its Markov-kernel
  structure. Specialize the strong data processing inequality from
  \cref{def:strong-data-processing-inequality} to this kernel acting on
  \(\widetilde B\). By
  \cref{def:learning-algorithm-joint-measure}, and after coercing the
  resulting nonnegative extended-real inequality to extended reals, this
  gives
  \[
    I_\kappa(\mathcal A(\widetilde B);A')
      \leq \rho I_\kappa(\mathcal A(\widetilde B);\widetilde B).
  \]
  The same definition gives \(0\leq\rho\leq1\). Invoke
  \cref{lem:finite-output-conditional-tv-information-transport} with the
  pointwise conditional total-variation hypothesis. Its first conclusion
  bounds \(I(\mathcal A(B');A')\) by
  \(I(\mathcal A(\widetilde B);A')+q_{\mathcal M}(\delta)/2\), while its
  second bounds \(I(\mathcal A(\widetilde B);\widetilde B)\) by
  \(I(\mathcal A(B');B')+q_{\mathcal M}(\delta)/2\). Insert the exact
  contraction inequality between these two estimates.

  The existence of the Markov kernel, together with the nonemptiness of
  \(T\), forces \(\mathcal M\) to be nonempty. Consequently
  \(|\mathcal M|\geq1\), and \(0\leq\delta\leq1\) implies that
  \(q_{\mathcal M}(\delta)\geq0\) by
  \cref{def:information-error-penalty}; the case \(\delta=0\) is
  immediate, while for \(\delta>0\) one uses
  \(\log(|\mathcal M|/\delta)\geq0\). It follows from
  \(0\leq\rho\leq1\) that multiplication by \(\rho\) does not
  increase the second half-penalty. The two half-penalties sum to
  \(q_{\mathcal M}(\delta)\), yielding the asserted estimate. -/)
  (title := /-- Finite-output information estimate under a conditional coupling -/)
  (latexEnv := "lemma")]
lemma finite_output_coupled_sdpi_bound
    {S T : Type*} {M : Type} [TopologicalSpace S] [MeasurableSpace S] [BorelSpace S]
    [SecondCountableTopology S] [T2Space S] [MeasurableSpace T]
    [StandardBorelSpace T] [Nonempty T] [MeasurableSpace M]
    [MeasurableSingletonClass M] [Finite M]
    (κ : Measure ((S × T) × T)) [IsProbabilityMeasure κ]
    (ρ δ : ℝ)
    (hδ : 0 ≤ δ ∧ δ ≤ 1)
    (hSDPI : strong_data_processing_inequality κ
      (fun z => z.1.1) Prod.snd ρ)
    (hTV : ∀ a ∈ (Measure.map (fun z => z.1.1) κ).support,
      total_variation_distance
        (ProbabilityTheory.condDistrib Prod.snd (fun z => z.1.1) κ a)
        (ProbabilityTheory.condDistrib (fun z => z.1.2)
          (fun z => z.1.1) κ a) ≤ δ)
    (hB : Measurable (fun z : (S × T) × T => z.1.2))
    (algorithm : learning_algorithm T M) :
    (mutual_information
        (learning_algorithm_joint_measure κ (fun z => z.1.2) hB algorithm)
        Prod.snd (fun zm => zm.1.1.1) : EReal) ≤
      (ρ : EReal) *
        (mutual_information
          (learning_algorithm_joint_measure κ (fun z => z.1.2) hB algorithm)
          Prod.snd (fun zm => zm.1.1.2) : EReal) +
        information_error_penalty M δ := by
  letI : ProbabilityTheory.IsMarkovKernel algorithm.kernel := algorithm.markov
  rcases finite_output_conditional_tv_information_transport
      κ δ hδ hTV hB algorithm with ⟨h₁, h₂⟩
  have hExact := hSDPI.2.2.2.2 M algorithm.kernel hSDPI.2.1
  have hExactE :
      (↑(mutual_information
        (learning_algorithm_joint_measure κ Prod.snd measurable_snd algorithm)
        Prod.snd (fun zm => zm.1.1.1)) : EReal) ≤
        (ρ : EReal) *
          (↑(mutual_information
            (learning_algorithm_joint_measure κ Prod.snd measurable_snd algorithm)
            Prod.snd (fun zm => zm.1.2)) : EReal) := by
    simpa only [learning_algorithm_joint_measure, EReal.coe_ennreal_mul,
      EReal.coe_ennreal_ofReal, max_eq_left hSDPI.2.2.1] using
      EReal.coe_ennreal_le_coe_ennreal_iff.mpr hExact
  let X : EReal := ↑(mutual_information
    (learning_algorithm_joint_measure κ (fun z => z.1.2) hB algorithm)
    Prod.snd (fun zm => zm.1.1.1))
  let Y : EReal := ↑(mutual_information
    (learning_algorithm_joint_measure κ Prod.snd measurable_snd algorithm)
    Prod.snd (fun zm => zm.1.1.1))
  let Z : EReal := ↑(mutual_information
    (learning_algorithm_joint_measure κ Prod.snd measurable_snd algorithm)
    Prod.snd (fun zm => zm.1.2))
  let W : EReal := ↑(mutual_information
    (learning_algorithm_joint_measure κ (fun z => z.1.2) hB algorithm)
    Prod.snd (fun zm => zm.1.1.2))
  let Q : EReal := information_error_penalty M δ
  let R : EReal := ρ
  change X ≤ R * W + Q
  change X ≤ Y + Q / 2 at h₁
  change Z ≤ W + Q / 2 at h₂
  change Y ≤ R * Z at hExactE
  have hM : Nonempty M := by
    by_contra h
    haveI : IsEmpty M := not_nonempty_iff.mp h
    let t : T := Classical.choice (inferInstance : Nonempty T)
    haveI : IsProbabilityMeasure (algorithm.kernel t) :=
      ProbabilityTheory.IsMarkovKernel.isProbabilityMeasure t
    have hOne : algorithm.kernel t Set.univ = 1 := measure_univ
    have huniv : (Set.univ : Set M) = ∅ := Subsingleton.elim _ _
    rw [huniv, measure_empty] at hOne
    exact zero_ne_one hOne
  letI : Nonempty M := hM
  have hR0 : 0 ≤ R := by simpa [R] using hSDPI.2.2.1
  have hR1 : R ≤ 1 := by
    dsimp [R]
    exact EReal.coe_le_coe hSDPI.2.2.2.1
  have hW0 : 0 ≤ W := by
    dsimp [W]
    exact EReal.coe_ennreal_nonneg _
  have hQ0 : 0 ≤ Q := by
    by_cases hδzero : δ = 0
    · simp [Q, information_error_penalty, hδzero]
    · have hδpos : 0 < δ := lt_of_le_of_ne hδ.1 (Ne.symm hδzero)
      have hcardone : (1 : ℝ) ≤ Nat.card M := by
        exact_mod_cast (Nat.card_pos : 0 < Nat.card M)
      have hratio : 1 ≤ (Nat.card M : ℝ) / δ := by
        rw [le_div_iff₀ hδpos]
        simpa only [one_mul] using hδ.2.trans hcardone
      have hlog : 0 ≤ Real.log ((Nat.card M : ℝ) / δ) :=
        Real.log_nonneg hratio
      simp only [Q, information_error_penalty, hδzero, if_false,
        if_pos (by infer_instance : Finite M)]
      exact EReal.coe_nonneg.mpr
        (mul_nonneg (mul_nonneg (by positivity) hδ.1) hlog)
  have hAlg (w q r : ENNReal) (hr : r ≤ 1) :
      r * (w + q / 2) + q / 2 ≤ r * w + q := by
    calc
      r * (w + q / 2) + q / 2 =
          r * w + (r * (q / 2) + q / 2) := by ring
      _ ≤ r * w + (q / 2 + q / 2) := by
        gcongr
        simpa only [one_mul] using mul_le_mul_right' hr (q / 2)
      _ = r * w + q := by
        rw [← two_mul, mul_comm (2 : ENNReal) (q / 2),
          ENNReal.div_mul_cancel (by norm_num) (by norm_num)]
  calc
    X ≤ Y + Q / 2 := h₁
    _ ≤ R * Z + Q / 2 := add_le_add_left hExactE _
    _ ≤ R * (W + Q / 2) + Q / 2 := by
      gcongr
    _ ≤ R * W + Q := by
      rw [← EReal.coe_toENNReal hR0, ← EReal.coe_toENNReal hW0,
        ← EReal.coe_toENNReal hQ0]
      have hhalf :
          ((Q.toENNReal / 2 : ENNReal) : EReal) =
            (Q.toENNReal : EReal) / 2 := by
        rw [div_eq_mul_inv, div_eq_mul_inv, EReal.coe_ennreal_mul]
        congr 1
        rw [← ENNReal.coe_inv_two]
        change (((((2 : NNReal)⁻¹ : NNReal) : ℝ) : EReal)) =
          (2 : EReal)⁻¹
        trans ((((2 : ℝ)⁻¹ : ℝ) : EReal))
        · norm_num
        · exact EReal.coe_inv 2
      simpa only [EReal.coe_ennreal_mul, EReal.coe_ennreal_add, hhalf] using
        EReal.coe_ennreal_le_coe_ennreal_iff.mpr
        (hAlg W.toENNReal Q.toENNReal R.toENNReal
          (by
            apply EReal.coe_ennreal_le_coe_ennreal_iff.mp
            simpa only [EReal.coe_toENNReal hR0,
              EReal.coe_ennreal_one] using hR1))

@[blueprint "lem:approximate-sdpi-postprocessing-measure-eq-of-total-variation-zero"
  (statement := /-- Let \(\nu\) and \(\xi\) be probability measures on the same measurable space. If
  \[
    d_{\mathrm{TV}}(\nu,\xi)\leq0,
  \]
  then \(\nu=\xi\). -/)
  (proof := /-- For each measurable set, \cref{lem:finite-output-total-variation-event-bound} shows that the absolute difference of its two probabilities is at most zero. Hence their real values agree. Since both measures are finite, equality of these real values implies equality of the measures. -/)
  (title := /-- Equality at zero total-variation distance -/)
  (latexEnv := "lemma")]
lemma approximate_sdpi_postprocessing_measure_eq_of_total_variation_zero
    {X : Type*} [MeasurableSpace X]
    (ν ξ : Measure X) [IsProbabilityMeasure ν] [IsProbabilityMeasure ξ]
    (hTV : total_variation_distance ν ξ ≤ 0) :
    ν = ξ := by
  ext E hE
  have hBound :=
    finite_output_total_variation_event_bound ν ξ 0 hTV E hE
  have hReal : (ν E).toReal = (ξ E).toReal := by
    have hAbs :
        |(ν E).toReal - (ξ E).toReal| = 0 :=
      le_antisymm hBound (abs_nonneg _)
    exact sub_eq_zero.mp (abs_eq_zero.mp hAbs)
  exact (ENNReal.toReal_eq_toReal_iff'
    (measure_ne_top ν E) (measure_ne_top ξ E)).mp hReal

@[blueprint "lem:approximate-sdpi-postprocessing-output-pair-law-congr"
  (statement := /-- Let \((A_1,B_1)\) and \((A_2,B_2)\) be measurable pairs on two probability spaces with the same joint law. For every Markov kernel \(K:T\rightsquigarrow\mathcal M\), the pairs \((A_1,Z_1)\) and \((A_2,Z_2)\), obtained by applying \(K\) respectively to \(B_1\) and \(B_2\), also have the same law. -/)
  (proof := /-- Expand both induced measures using \cref{def:learning-algorithm-joint-measure}. On a measurable rectangle \(C\times D\), each output-pair law is the integral of \(K(B_i(\omega),D)\) over \(A_i^{-1}(C)\). The pushforward integral formula rewrites this as the integral of \(K(t,D)\) over \(C\times T\) against the law of \((A_i,B_i)\). The assumed equality of those laws identifies the integrals, and finite-measure extensionality gives the result. -/)
  (title := /-- Postprocessing preserves equality of pair laws -/)
  (latexEnv := "lemma")]
lemma approximate_sdpi_postprocessing_output_pair_law_congr
    {Ω₁ Ω₂ S T : Type*} {M : Type}
    [MeasurableSpace Ω₁] [MeasurableSpace Ω₂] [MeasurableSpace S]
    [MeasurableSpace T] [MeasurableSpace M]
    (μ₁ : Measure Ω₁) [IsProbabilityMeasure μ₁]
    (μ₂ : Measure Ω₂) [IsProbabilityMeasure μ₂]
    (A₁ : Ω₁ → S) (B₁ : Ω₁ → T)
    (A₂ : Ω₂ → S) (B₂ : Ω₂ → T)
    (hA₁ : Measurable A₁) (hB₁ : Measurable B₁)
    (hA₂ : Measurable A₂) (hB₂ : Measurable B₂)
    (hLaw : Measure.map (fun ω => (A₁ ω, B₁ ω)) μ₁ =
      Measure.map (fun ω => (A₂ ω, B₂ ω)) μ₂)
    (algorithm : learning_algorithm T M) :
    Measure.map (fun zm => (A₁ zm.1, zm.2))
        (learning_algorithm_joint_measure μ₁ B₁ hB₁ algorithm) =
      Measure.map (fun zm => (A₂ zm.1, zm.2))
        (learning_algorithm_joint_measure μ₂ B₂ hB₂ algorithm) := by
  letI : ProbabilityTheory.IsMarkovKernel algorithm.kernel := algorithm.markov
  letI : IsProbabilityMeasure
      (learning_algorithm_joint_measure μ₁ B₁ hB₁ algorithm) := by
    unfold learning_algorithm_joint_measure
    infer_instance
  letI : IsProbabilityMeasure
      (learning_algorithm_joint_measure μ₂ B₂ hB₂ algorithm) := by
    unfold learning_algorithm_joint_measure
    infer_instance
  apply Measure.ext_prod
  intro s u hs hu
  rw [Measure.map_apply (by fun_prop) (hs.prod hu),
    Measure.map_apply (by fun_prop) (hs.prod hu)]
  simp only [learning_algorithm_joint_measure]
  rw [show (fun zm => (A₁ zm.1, zm.2)) ⁻¹' (s ×ˢ u) =
      (A₁ ⁻¹' s) ×ˢ u by ext z; simp]
  rw [show (fun zm => (A₂ zm.1, zm.2)) ⁻¹' (s ×ˢ u) =
      (A₂ ⁻¹' s) ×ˢ u by ext z; simp]
  rw [Measure.compProd_apply_prod (hs.preimage hA₁) hu,
    Measure.compProd_apply_prod (hs.preimage hA₂) hu]
  simp only [ProbabilityTheory.Kernel.comap_apply]
  calc
    (∫⁻ ω in A₁ ⁻¹' s, algorithm.kernel (B₁ ω) u ∂μ₁) =
        ∫⁻ p in s ×ˢ (Set.univ : Set T), algorithm.kernel p.2 u
          ∂Measure.map (fun ω => (A₁ ω, B₁ ω)) μ₁ := by
      symm
      calc
        (∫⁻ p in s ×ˢ (Set.univ : Set T), algorithm.kernel p.2 u
            ∂Measure.map (fun ω => (A₁ ω, B₁ ω)) μ₁) =
            ∫⁻ ω in (fun ω => (A₁ ω, B₁ ω)) ⁻¹'
              (s ×ˢ (Set.univ : Set T)), algorithm.kernel (B₁ ω) u ∂μ₁ := by
          simpa [Function.comp_def] using
            (MeasureTheory.setLIntegral_map (μ := μ₁)
              (s := s ×ˢ (Set.univ : Set T))
              (f := fun p : S × T => algorithm.kernel p.2 u)
              (g := fun ω => (A₁ ω, B₁ ω))
              (hs.prod MeasurableSet.univ)
              ((algorithm.kernel.measurable_coe hu).comp measurable_snd)
              (hA₁.prodMk hB₁))
        _ = ∫⁻ ω in A₁ ⁻¹' s, algorithm.kernel (B₁ ω) u ∂μ₁ := by
          rw [show (fun ω => (A₁ ω, B₁ ω)) ⁻¹'
              (s ×ˢ (Set.univ : Set T)) = A₁ ⁻¹' s by
            ext ω
            simp]
    _ = ∫⁻ p in s ×ˢ (Set.univ : Set T), algorithm.kernel p.2 u
          ∂Measure.map (fun ω => (A₂ ω, B₂ ω)) μ₂ := by rw [hLaw]
    _ = ∫⁻ ω in A₂ ⁻¹' s, algorithm.kernel (B₂ ω) u ∂μ₂ := by
      calc
        (∫⁻ p in s ×ˢ (Set.univ : Set T), algorithm.kernel p.2 u
            ∂Measure.map (fun ω => (A₂ ω, B₂ ω)) μ₂) =
            ∫⁻ ω in (fun ω => (A₂ ω, B₂ ω)) ⁻¹'
              (s ×ˢ (Set.univ : Set T)), algorithm.kernel (B₂ ω) u ∂μ₂ := by
          simpa [Function.comp_def] using
            (MeasureTheory.setLIntegral_map (μ := μ₂)
              (s := s ×ˢ (Set.univ : Set T))
              (f := fun p : S × T => algorithm.kernel p.2 u)
              (g := fun ω => (A₂ ω, B₂ ω))
              (hs.prod MeasurableSet.univ)
              ((algorithm.kernel.measurable_coe hu).comp measurable_snd)
              (hA₂.prodMk hB₂))
        _ = ∫⁻ ω in A₂ ⁻¹' s, algorithm.kernel (B₂ ω) u ∂μ₂ := by
          rw [show (fun ω => (A₂ ω, B₂ ω)) ⁻¹'
              (s ×ˢ (Set.univ : Set T)) = A₂ ⁻¹' s by
            ext ω
            simp]

@[blueprint "lem:approximate-sdpi-postprocessing-mutual-information-congr"
  (statement := /-- Under the hypotheses of \cref{lem:approximate-sdpi-postprocessing-output-pair-law-congr}, applying the same Markov kernel to the second coordinate preserves both corresponding mutual informations:
  \[
    I(Z_1;A_1)=I(Z_2;A_2)
    \quad\text{and}\quad
    I(Z_1;B_1)=I(Z_2;B_2).
  \] -/)
  (proof := /-- Apply \cref{lem:approximate-sdpi-postprocessing-output-pair-law-congr} first to \((A_1,B_1)\) and \((A_2,B_2)\). Push the resulting equality forward by the coordinate swap and by both projections; substitution in \cref{def:mutual-information} gives the first identity. Push the assumed pair-law equality forward by \((s,t)\mapsto(t,t)\), apply the same lemma to \((B_1,B_1)\) and \((B_2,B_2)\), and repeat the argument for the second identity. -/)
  (title := /-- Mutual information is determined by the input pair law -/)
  (latexEnv := "lemma")]
lemma approximate_sdpi_postprocessing_mutual_information_congr
    {Ω₁ Ω₂ S T : Type*} {M : Type}
    [MeasurableSpace Ω₁] [MeasurableSpace Ω₂] [MeasurableSpace S]
    [MeasurableSpace T] [MeasurableSpace M]
    (μ₁ : Measure Ω₁) [IsProbabilityMeasure μ₁]
    (μ₂ : Measure Ω₂) [IsProbabilityMeasure μ₂]
    (A₁ : Ω₁ → S) (B₁ : Ω₁ → T)
    (A₂ : Ω₂ → S) (B₂ : Ω₂ → T)
    (hA₁ : Measurable A₁) (hB₁ : Measurable B₁)
    (hA₂ : Measurable A₂) (hB₂ : Measurable B₂)
    (hLaw : Measure.map (fun ω => (A₁ ω, B₁ ω)) μ₁ =
      Measure.map (fun ω => (A₂ ω, B₂ ω)) μ₂)
    (algorithm : learning_algorithm T M) :
    mutual_information (learning_algorithm_joint_measure μ₁ B₁ hB₁ algorithm)
        Prod.snd (fun zm => A₁ zm.1) =
        mutual_information
          (learning_algorithm_joint_measure μ₂ B₂ hB₂ algorithm)
          Prod.snd (fun zm => A₂ zm.1) ∧
      mutual_information
          (learning_algorithm_joint_measure μ₁ B₁ hB₁ algorithm)
          Prod.snd (fun zm => B₁ zm.1) =
        mutual_information
          (learning_algorithm_joint_measure μ₂ B₂ hB₂ algorithm)
          Prod.snd (fun zm => B₂ zm.1) := by
  let ν₁ := learning_algorithm_joint_measure μ₁ B₁ hB₁ algorithm
  let ν₂ := learning_algorithm_joint_measure μ₂ B₂ hB₂ algorithm
  have hAZ : Measure.map (fun zm => (A₁ zm.1, zm.2)) ν₁ =
      Measure.map (fun zm => (A₂ zm.1, zm.2)) ν₂ := by
    simpa [ν₁, ν₂] using
      approximate_sdpi_postprocessing_output_pair_law_congr
        μ₁ μ₂ A₁ B₁ A₂ B₂ hA₁ hB₁ hA₂ hB₂ hLaw algorithm
  have hBB : Measure.map (fun ω => (B₁ ω, B₁ ω)) μ₁ =
      Measure.map (fun ω => (B₂ ω, B₂ ω)) μ₂ := by
    calc
      Measure.map (fun ω => (B₁ ω, B₁ ω)) μ₁ =
          Measure.map (fun p : S × T => (p.2, p.2))
            (Measure.map (fun ω => (A₁ ω, B₁ ω)) μ₁) := by
        rw [Measure.map_map (by fun_prop) (hA₁.prodMk hB₁)]
        rfl
      _ = Measure.map (fun p : S × T => (p.2, p.2))
            (Measure.map (fun ω => (A₂ ω, B₂ ω)) μ₂) := by rw [hLaw]
      _ = Measure.map (fun ω => (B₂ ω, B₂ ω)) μ₂ := by
        rw [Measure.map_map (by fun_prop) (hA₂.prodMk hB₂)]
        rfl
  have hBZ : Measure.map (fun zm => (B₁ zm.1, zm.2)) ν₁ =
      Measure.map (fun zm => (B₂ zm.1, zm.2)) ν₂ := by
    simpa [ν₁, ν₂] using
      approximate_sdpi_postprocessing_output_pair_law_congr
        μ₁ μ₂ B₁ B₁ B₂ B₂ hB₁ hB₁ hB₂ hB₂ hBB algorithm
  have hOutput : Measure.map Prod.snd ν₁ = Measure.map Prod.snd ν₂ := by
    calc
      Measure.map Prod.snd ν₁ =
          Measure.map Prod.snd
            (Measure.map (fun zm => (A₁ zm.1, zm.2)) ν₁) := by
        rw [Measure.map_map (by fun_prop) (by fun_prop)]
        rfl
      _ = Measure.map Prod.snd
            (Measure.map (fun zm => (A₂ zm.1, zm.2)) ν₂) := by rw [hAZ]
      _ = Measure.map Prod.snd ν₂ := by
        rw [Measure.map_map (by fun_prop) (by fun_prop)]
        rfl
  have hAJoint : Measure.map (fun zm => (zm.2, A₁ zm.1)) ν₁ =
      Measure.map (fun zm => (zm.2, A₂ zm.1)) ν₂ := by
    calc
      Measure.map (fun zm => (zm.2, A₁ zm.1)) ν₁ =
          Measure.map Prod.swap
            (Measure.map (fun zm => (A₁ zm.1, zm.2)) ν₁) := by
        rw [Measure.map_map (by fun_prop) (by fun_prop)]
        rfl
      _ = Measure.map Prod.swap
            (Measure.map (fun zm => (A₂ zm.1, zm.2)) ν₂) := by rw [hAZ]
      _ = Measure.map (fun zm => (zm.2, A₂ zm.1)) ν₂ := by
        rw [Measure.map_map (by fun_prop) (by fun_prop)]
        rfl
  have hAMarginal : Measure.map (fun zm => A₁ zm.1) ν₁ =
      Measure.map (fun zm => A₂ zm.1) ν₂ := by
    calc
      Measure.map (fun zm => A₁ zm.1) ν₁ =
          Measure.map Prod.fst
            (Measure.map (fun zm => (A₁ zm.1, zm.2)) ν₁) := by
        rw [Measure.map_map (by fun_prop) (by fun_prop)]
        rfl
      _ = Measure.map Prod.fst
            (Measure.map (fun zm => (A₂ zm.1, zm.2)) ν₂) := by rw [hAZ]
      _ = Measure.map (fun zm => A₂ zm.1) ν₂ := by
        rw [Measure.map_map (by fun_prop) (by fun_prop)]
        rfl
  have hBJoint : Measure.map (fun zm => (zm.2, B₁ zm.1)) ν₁ =
      Measure.map (fun zm => (zm.2, B₂ zm.1)) ν₂ := by
    calc
      Measure.map (fun zm => (zm.2, B₁ zm.1)) ν₁ =
          Measure.map Prod.swap
            (Measure.map (fun zm => (B₁ zm.1, zm.2)) ν₁) := by
        rw [Measure.map_map (by fun_prop) (by fun_prop)]
        rfl
      _ = Measure.map Prod.swap
            (Measure.map (fun zm => (B₂ zm.1, zm.2)) ν₂) := by rw [hBZ]
      _ = Measure.map (fun zm => (zm.2, B₂ zm.1)) ν₂ := by
        rw [Measure.map_map (by fun_prop) (by fun_prop)]
        rfl
  have hBMarginal : Measure.map (fun zm => B₁ zm.1) ν₁ =
      Measure.map (fun zm => B₂ zm.1) ν₂ := by
    calc
      Measure.map (fun zm => B₁ zm.1) ν₁ =
          Measure.map Prod.fst
            (Measure.map (fun zm => (B₁ zm.1, zm.2)) ν₁) := by
        rw [Measure.map_map (by fun_prop) (by fun_prop)]
        rfl
      _ = Measure.map Prod.fst
            (Measure.map (fun zm => (B₂ zm.1, zm.2)) ν₂) := by rw [hBZ]
      _ = Measure.map (fun zm => B₂ zm.1) ν₂ := by
        rw [Measure.map_map (by fun_prop) (by fun_prop)]
        rfl
  constructor <;> unfold mutual_information <;>
    simp only [ν₁, ν₂] at hAJoint hAMarginal hBJoint hBMarginal hOutput ⊢
  · rw [hAJoint, hOutput, hAMarginal]
  · rw [hBJoint, hOutput, hBMarginal]

@[blueprint "lem:approximate-sdpi-postprocessing-bound"
  (statement := /-- Let \((\Omega,\mu)\) be a probability space, let \(S\) be a second-countable Hausdorff space equipped with its Borel \(\sigma\)-algebra, and let \(T\) be a nonempty standard Borel space. Let \(A:\Omega\to S\) and \(B:\Omega\to T\) satisfy the coupling-based \((\rho,\delta)\)-approximate strong data processing inequality for some \(\rho,\delta\in\mathbb R\). Let \(\mathcal M\) be a measurable space whose singletons are measurable, and let \(K:T\rightsquigarrow\mathcal M\) be an arbitrary randomized postprocessing. On the induced law
  \[
    \nu(d\omega,dz)=\mu(d\omega)K(B(\omega),dz),
  \]
  let \(Z(\omega,z)=z\), \(A'(\omega,z)=A(\omega)\), and \(B'(\omega,z)=B(\omega)\). Then, as an inequality of extended real numbers,
  \[
    I_\nu(Z;A')\leq \rho I_\nu(Z;B')
      +q_{\mathcal M}(\delta).
  \] -/)
  (proof := /-- Choose the coupling law \(\kappa\) and its coordinate variables \((A',B',\widetilde B)\) supplied by \cref{def:approximate-strong-data-processing-inequality}. The marginal identity \(\mathcal L_\kappa(A',B')=\mathcal L_\mu(A,B)\) and \cref{lem:approximate-sdpi-postprocessing-mutual-information-congr} identify the mutual informations obtained by applying the algorithm kernel to \(B'\) with their counterparts formed from \(A\) and \(B\). If \(\mathcal M\) is finite, apply \cref{lem:finite-output-coupled-sdpi-bound} to the exact SDPI pair \((A',\widetilde B)\), the pointwise conditional total-variation estimate, and the kernel of the algorithm. It gives
  \[
    I(\mathcal A(B');A')\leq
      \rho I(\mathcal A(B');B')+q_{\mathcal M}(\delta)
  \]
  and transport gives the asserted inequality. If \(\mathcal M\) is infinite and \(\delta=0\), \cref{lem:approximate-sdpi-postprocessing-measure-eq-of-total-variation-zero} identifies the conditional laws of \(\widetilde B\) and \(B'\) at every point in the support of \(A'\). That support has full marginal measure, so disintegration and congruence of composition-products identify the joint laws of \((A',\widetilde B)\) and \((A',B')\). A second application of \cref{lem:approximate-sdpi-postprocessing-mutual-information-congr}, followed by the exact strong data processing inequality, gives the conclusion with zero penalty. Finally, if \(\delta>0\) and \(\mathcal M\) is infinite, \cref{def:information-error-penalty} gives \(q_{\mathcal M}(\delta)=+\infty\), so the extended-real inequality is automatic. -/)
  (title := /-- Postprocessing consequence of approximate SDPI -/)
  (latexEnv := "lemma")]
lemma approximate_sdpi_postprocessing_bound
    {Ω S T : Type*} {M : Type} [MeasurableSpace Ω] [TopologicalSpace S]
    [MeasurableSpace S] [BorelSpace S] [SecondCountableTopology S] [T2Space S]
    [MeasurableSpace T] [StandardBorelSpace T] [Nonempty T]
    [MeasurableSpace M] [MeasurableSingletonClass M]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (A : Ω → S) (B : Ω → T) (ρ δ : ℝ)
    (hSDPI : approximate_strong_data_processing_inequality μ A B ρ δ)
    (algorithm : learning_algorithm T M) :
    (mutual_information
        (learning_algorithm_joint_measure μ B hSDPI.2.1 algorithm)
        Prod.snd (fun ωz => A ωz.1) : EReal) ≤
      (ρ : EReal) *
        (mutual_information
          (learning_algorithm_joint_measure μ B hSDPI.2.1 algorithm)
          Prod.snd (fun ωz => B ωz.1) : EReal) +
        information_error_penalty M δ := by
  classical
  unfold approximate_strong_data_processing_inequality at hSDPI
  rcases hSDPI with
    ⟨hA, hB, hδ0, hδ1, κ, hκ, hLaw, hExact, hTV⟩
  letI : IsProbabilityMeasure κ := hκ
  letI : ProbabilityTheory.IsMarkovKernel algorithm.kernel := algorithm.markov
  let A' : (S × T) × T → S := fun z => z.1.1
  let B' : (S × T) × T → T := fun z => z.1.2
  let Bt : (S × T) × T → T := Prod.snd
  have hA' : Measurable A' := by fun_prop
  have hB' : Measurable B' := by fun_prop
  have hBt : Measurable Bt := measurable_snd
  have hTransport :=
    approximate_sdpi_postprocessing_mutual_information_congr
      μ κ A B A' B' hA hB hA' hB' hLaw.symm algorithm
  by_cases hM : Finite M
  · letI : Finite M := hM
    have hBound := finite_output_coupled_sdpi_bound
      κ ρ δ ⟨hδ0, hδ1⟩ hExact hTV hB' algorithm
    calc
      (mutual_information
          (learning_algorithm_joint_measure μ B hB algorithm)
          Prod.snd (fun ωz => A ωz.1) : EReal) =
          (mutual_information
            (learning_algorithm_joint_measure κ B' hB' algorithm)
            Prod.snd (fun zm => A' zm.1) : EReal) := by
        exact_mod_cast hTransport.1
      _ ≤ (ρ : EReal) *
          (mutual_information
            (learning_algorithm_joint_measure κ B' hB' algorithm)
            Prod.snd (fun zm => B' zm.1) : EReal) +
          information_error_penalty M δ := hBound
      _ = (ρ : EReal) *
          (mutual_information
            (learning_algorithm_joint_measure μ B hB algorithm)
            Prod.snd (fun ωz => B ωz.1) : EReal) +
          information_error_penalty M δ := by rw [← hTransport.2]
  · by_cases hδzero : δ = 0
    · subst δ
      let μA : Measure S := Measure.map A' κ
      have hCondEq :
          ProbabilityTheory.condDistrib Bt A' κ =ᵐ[μA]
            ProbabilityTheory.condDistrib B' A' κ := by
        filter_upwards [Measure.support_mem_ae (μ := μA)] with a ha
        apply
          approximate_sdpi_postprocessing_measure_eq_of_total_variation_zero
        simpa [μA, A', B', Bt] using hTV a ha
      have hPair :
          Measure.map (fun z => (A' z, Bt z)) κ =
            Measure.map (fun z => (A' z, B' z)) κ := by
        calc
          Measure.map (fun z => (A' z, Bt z)) κ =
              μA.compProd
                (ProbabilityTheory.condDistrib Bt A' κ) := by
            dsimp [μA]
            rw [ProbabilityTheory.compProd_map_condDistrib hBt.aemeasurable]
          _ = μA.compProd
                (ProbabilityTheory.condDistrib B' A' κ) :=
            Measure.compProd_congr hCondEq
          _ = Measure.map (fun z => (A' z, B' z)) κ := by
            dsimp [μA]
            rw [ProbabilityTheory.compProd_map_condDistrib hB'.aemeasurable]
      have hZeroTransport :=
        approximate_sdpi_postprocessing_mutual_information_congr
          κ κ A' Bt A' B' hA' hBt hA' hB' hPair algorithm
      have hExactRaw :=
        hExact.2.2.2.2 M algorithm.kernel hExact.2.1
      have hExactE :
          (mutual_information
              (learning_algorithm_joint_measure κ Bt hBt algorithm)
              Prod.snd (fun zm => A' zm.1) : EReal) ≤
            (ρ : EReal) *
              (mutual_information
                (learning_algorithm_joint_measure κ Bt hBt algorithm)
                Prod.snd (fun zm => Bt zm.1) : EReal) := by
        simpa only [learning_algorithm_joint_measure,
          EReal.coe_ennreal_mul, EReal.coe_ennreal_ofReal,
          max_eq_left hExact.2.2.1] using
          EReal.coe_ennreal_le_coe_ennreal_iff.mpr hExactRaw
      calc
        (mutual_information
            (learning_algorithm_joint_measure μ B hB algorithm)
            Prod.snd (fun ωz => A ωz.1) : EReal) =
            (mutual_information
              (learning_algorithm_joint_measure κ B' hB' algorithm)
              Prod.snd (fun zm => A' zm.1) : EReal) := by
          exact_mod_cast hTransport.1
        _ = (mutual_information
              (learning_algorithm_joint_measure κ Bt hBt algorithm)
              Prod.snd (fun zm => A' zm.1) : EReal) := by
          exact_mod_cast hZeroTransport.1.symm
        _ ≤ (ρ : EReal) *
              (mutual_information
                (learning_algorithm_joint_measure κ Bt hBt algorithm)
                Prod.snd (fun zm => Bt zm.1) : EReal) := hExactE
        _ = (ρ : EReal) *
              (mutual_information
                (learning_algorithm_joint_measure κ B' hB' algorithm)
                Prod.snd (fun zm => B' zm.1) : EReal) := by
          rw [hZeroTransport.2]
        _ = (ρ : EReal) *
              (mutual_information
                (learning_algorithm_joint_measure μ B hB algorithm)
                Prod.snd (fun ωz => B ωz.1) : EReal) +
              information_error_penalty M 0 := by
          rw [← hTransport.2]
          simp [information_error_penalty]
    · simp [information_error_penalty, hδzero, hM]
      have hρE : (0 : EReal) ≤ (ρ : EReal) :=
        EReal.coe_nonneg.mpr hExact.2.2.1
      rw [EReal.add_top_of_ne_bot
        ((EReal.mul_ne_bot _ _).2
          ⟨by simp, by simp, by simp, Or.inl hρE⟩)]
      exact le_top

@[blueprint "lem:data-generation-information-bound"
  (statement := /-- Let \((\Omega,\mu)\) be a probability space, let \(\Theta\) be a second-countable Hausdorff space equipped with its Borel \(\sigma\)-algebra, and let \(\mathcal T\) be a nonempty standard Borel space. Let \(\theta:\Omega\to\Theta\) and \(X_{1:n}:\Omega\to\mathcal T\) satisfy the coupling-based \((\tau_n,\epsilon_n)\)-approximate strong data processing inequality, where \(\tau_n,\epsilon_n\in\mathbb R\). Also fix a measurable space \(\mathcal X\) and a map \(X:\Omega\to\mathcal X\); these auxiliary data do not enter the conclusion. Let \(\mathcal M\) be a measurable space whose singletons are measurable, and let \(\mathcal A:\mathcal T\rightsquigarrow\mathcal M\) be an arbitrary randomized learning algorithm. On the induced probability law
  \[
    \nu(d\omega,dz)=\mu(d\omega)\mathcal A(X_{1:n}(\omega),dz),
  \]
  the output coordinate \(Z(\omega,z)=z\) satisfies the extended-real inequality
  \[
    I_\nu(Z;\theta)
      \leq \tau_n I_\nu(Z;X_{1:n})
        +q_{\mathcal M}(\epsilon_n)
  \] -/)
  (proof := /-- Apply \cref{lem:approximate-sdpi-postprocessing-bound} with \(A=\theta\), \(B=X_{1:n}\), and the Markov kernel of \(\mathcal A\). By \cref{def:learning-algorithm-joint-measure}, the output coordinate under the induced law is the required randomized postprocessing of the training sample. -/)
  (title := /-- Data-generation information estimate -/)
  (latexEnv := "lemma")]
lemma data_generation_information_bound
    {Ω Θ X Train : Type*} {M : Type} [MeasurableSpace Ω] [TopologicalSpace Θ]
    [MeasurableSpace Θ] [BorelSpace Θ] [SecondCountableTopology Θ] [T2Space Θ]
    [MeasurableSpace X] [MeasurableSpace Train]
    [StandardBorelSpace Train] [Nonempty Train] [MeasurableSpace M]
    [MeasurableSingletonClass M]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (parameter : Ω → Θ) (training : Ω → Train) (test : Ω → X)
    (τ ε : ℝ)
    (hSDPI : approximate_strong_data_processing_inequality
      μ parameter training τ ε)
    (algorithm : learning_algorithm Train M) :
    (mutual_information
        (learning_algorithm_joint_measure μ training hSDPI.2.1 algorithm)
        Prod.snd (fun ωz => parameter ωz.1) : EReal) ≤
      (τ : EReal) *
        (mutual_information
          (learning_algorithm_joint_measure μ training hSDPI.2.1 algorithm)
          Prod.snd (fun ωz => training ωz.1) : EReal) +
        information_error_penalty M ε := by
  exact approximate_sdpi_postprocessing_bound μ parameter training τ ε hSDPI algorithm

@[blueprint "lem:test-train-information-bound"
  (statement := /-- Let \((\Omega,\mu)\) be a probability space, let \(\Theta\) be a measurable space, let \(\mathcal X\) be a Hausdorff second-countable space equipped with its Borel \(\sigma\)-algebra, and let \(\mathcal T\) be a nonempty standard Borel space. Let \(\vartheta:\Omega\to\Theta\), \(X_{1:n}:\Omega\to\mathcal T\), and \(X:\Omega\to\mathcal X\) be maps such that \((X,X_{1:n})\) satisfies the \((\rho_n,\delta_n)\)-approximate strong data processing inequality, where \(\rho_n,\delta_n\in\mathbb R\) and \(0<\rho_n\). Let \(\mathcal M\) be a measurable space whose singletons are measurable, and let \(\mathcal A:\mathcal T\rightsquigarrow\mathcal M\) be a learning algorithm. Under the induced probability law
  \[
    \nu(d\omega,dm)=\mu(d\omega)\mathcal A(X_{1:n}(\omega),dm),
  \]
  one has
  \[
    I(\mathcal A(X_{1:n});X_{1:n})
      \geq \frac{1}{\rho_n}I(\mathcal A(X_{1:n});X)
        -\frac{q_{\mathcal M}(\delta_n)}{\rho_n}.
  \]
  The auxiliary map \(\vartheta\) is arbitrary and does not enter the inequality. The displayed inequality is interpreted in the extended real numbers. -/)
  (proof := /-- Write \(I_{\mathrm{tr}}=I(\mathcal A(X_{1:n});X_{1:n})\), \(I_{\mathrm{te}}=I(\mathcal A(X_{1:n});X)\), and \(q=q_{\mathcal M}(\delta_n)\). By \cref{lem:approximate-sdpi-postprocessing-bound},
  \[
    I_{\mathrm{te}}\leq \rho_n I_{\mathrm{tr}}+q.
  \]
  The definition in \cref{def:information-error-penalty} shows that \(q\neq-\infty\). If \(q=+\infty\), then \(q/\rho_n=+\infty\), and the claimed lower bound is \(-\infty\leq I_{\mathrm{tr}}\). Otherwise \(q\) is finite. If \(I_{\mathrm{tr}}=+\infty\), the conclusion is immediate. In the remaining case both \(q\) and \(I_{\mathrm{tr}}\) are finite; represent them by real numbers. Since \(0<\rho_n\), division by \(\rho_n\) preserves order, and the real identity
  \[
    \rho_n I_{\mathrm{tr}}+q
      =\rho_n\left(I_{\mathrm{tr}}+\frac{q}{\rho_n}\right)
  \]
  transforms the preceding inequality into
  \(I_{\mathrm{te}}/\rho_n\leq I_{\mathrm{tr}}+q/\rho_n\). Subtracting the finite term \(q/\rho_n\) proves the result. -/)
  (title := /-- Test--train information estimate -/)
  (latexEnv := "lemma")]
lemma test_train_information_bound
    {Ω Θ X Train : Type*} {M : Type} [MeasurableSpace Ω] [MeasurableSpace Θ]
    [TopologicalSpace X] [MeasurableSpace X] [BorelSpace X]
    [SecondCountableTopology X] [T2Space X] [MeasurableSpace Train]
    [StandardBorelSpace Train] [Nonempty Train] [MeasurableSpace M]
    [MeasurableSingletonClass M]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (parameter : Ω → Θ) (training : Ω → Train) (test : Ω → X)
    (ρ δ : ℝ)
    (hSDPI : approximate_strong_data_processing_inequality μ test training ρ δ)
    (hρ : 0 < ρ)
    (algorithm : learning_algorithm Train M) :
    (mutual_information
        (learning_algorithm_joint_measure μ training hSDPI.2.1 algorithm)
        Prod.snd (fun ωz => training ωz.1) : EReal) ≥
      (mutual_information
          (learning_algorithm_joint_measure μ training hSDPI.2.1 algorithm)
          Prod.snd (fun ωz => test ωz.1) : EReal) /
          (ρ : EReal) -
        information_error_penalty M δ / (ρ : EReal) := by
  let Itrain : ENNReal := mutual_information
    (learning_algorithm_joint_measure μ training hSDPI.2.1 algorithm)
    Prod.snd (fun ωz => training ωz.1)
  let Itest : ENNReal := mutual_information
    (learning_algorithm_joint_measure μ training hSDPI.2.1 algorithm)
    Prod.snd (fun ωz => test ωz.1)
  let q : EReal := information_error_penalty M δ
  change (Itest : EReal) / (ρ : EReal) - q / (ρ : EReal) ≤ (Itrain : EReal)
  have hbound : (Itest : EReal) ≤ (ρ : EReal) * (Itrain : EReal) + q := by
    simpa [Itrain, Itest, q] using
      approximate_sdpi_postprocessing_bound μ test training ρ δ hSDPI algorithm
  have hρE : (0 : EReal) < (ρ : EReal) := EReal.coe_pos.mpr hρ
  have hqbot : q ≠ ⊥ := by
    unfold q information_error_penalty
    split_ifs <;> norm_num [← EReal.coe_mul]
  by_cases hqtop : q = ⊤
  · rw [hqtop, EReal.top_div_of_pos_ne_top hρE (EReal.coe_ne_top ρ),
      EReal.sub_top]
    exact bot_le
  · rw [← EReal.coe_toReal hqtop hqbot] at hbound ⊢
    by_cases hI : Itrain = ⊤
    · rw [hI, EReal.coe_ennreal_top]
      exact le_top
    · rw [← ENNReal.coe_toNNReal hI, EReal.coe_nnreal_eq_coe_real] at hbound ⊢
      apply EReal.sub_le_of_le_add
      apply (EReal.div_le_iff_le_mul hρE (EReal.coe_ne_top ρ)).2
      have halg : ρ * (Itrain.toNNReal : ℝ) + q.toReal =
          ρ * ((Itrain.toNNReal : ℝ) + q.toReal / ρ) := by
        field_simp
      calc
        (Itest : EReal) ≤
            ((ρ * (Itrain.toNNReal : ℝ) + q.toReal : ℝ) : EReal) := by
          simpa only [EReal.coe_mul, EReal.coe_add] using hbound
        _ = ((ρ * ((Itrain.toNNReal : ℝ) + q.toReal / ρ) : ℝ) : EReal) :=
          congrArg (fun x : ℝ => (x : EReal)) halg
        _ = (ρ : EReal) * (((Itrain.toNNReal : ℝ) : EReal) +
            ((q.toReal / ρ : ℝ) : EReal)) := by
          rw [EReal.coe_mul, EReal.coe_add]

@[blueprint "lem:kl-div-map-measurable-equiv"
  (statement := /-- Let \(e:A\simeq B\) be a measurable equivalence of measurable spaces and let \(P,Q\) be finite measures on \(A\). Then Kullback--Leibler divergence is invariant under simultaneous pushforward:
  \[
    D(e_\#P\Vert e_\#Q)=D(P\Vert Q).
  \] -/)
  (proof := /-- If \(P\ll Q\), pushforward preserves absolute continuity. Express both divergences through the integral of the Kullback--Leibler generating function, use the Radon--Nikodym derivative formula for a measurable embedding, and change variables along \(e\). If absolute continuity fails, it also fails after pushforward, since applying the measurable inverse would otherwise imply \(P\ll Q\); both divergences are then infinite. -/)
  (title := /-- Invariance of Kullback--Leibler divergence under measurable equivalence -/)
  (latexEnv := "lemma")]
lemma kl_div_map_measurable_equiv
    {A B : Type*} [MeasurableSpace A] [MeasurableSpace B]
    (e : A ≃ᵐ B) (P Q : Measure A) [IsFiniteMeasure P] [IsFiniteMeasure Q] :
    InformationTheory.klDiv (Measure.map e P) (Measure.map e Q) =
      InformationTheory.klDiv P Q := by
  by_cases hPQ : P ≪ Q
  · have hMap : Measure.map e P ≪ Measure.map e Q :=
      e.measurableEmbedding.absolutelyContinuous_map hPQ
    rw [InformationTheory.klDiv_eq_lintegral_klFun_of_ac hMap,
      InformationTheory.klDiv_eq_lintegral_klFun_of_ac hPQ,
      lintegral_map_equiv]
    refine lintegral_congr_ae ?_
    filter_upwards [e.measurableEmbedding.rnDeriv_map P Q] with x hx
    rw [hx]
  · have hMap : ¬Measure.map e P ≪ Measure.map e Q := by
      intro h
      have hBack := e.symm.measurableEmbedding.absolutelyContinuous_map h
      apply hPQ
      simpa [Measure.map_map] using hBack
    simp [InformationTheory.klDiv_eq_lintegral_klFun, hPQ, hMap]

@[blueprint "lem:rn-deriv-comp-prod-eq-kernel-rn-deriv"
  (statement := /-- Let \(\lambda\) be a finite measure and let \(K,L\) be finite kernels into a countably generated measurable space. The Radon--Nikodym derivative of the two composition-product measures agrees almost everywhere with the kernel Radon--Nikodym derivative:
  \[
    \frac{d(\lambda\otimes K)}{d(\lambda\otimes L)}(a,c)
      =\frac{dK(a)}{dL(a)}(c).
  \] -/)
  (proof := /-- Use the kernel Lebesgue decomposition of \(K\) relative to \(L\). Composition-product distributes over its absolutely continuous and singular summands; the absolutely continuous summand is the composition-product with \(L\), weighted by the kernel Radon--Nikodym derivative. The singular kernel summand remains singular after forming the composition-product. Uniqueness of the measure Radon--Nikodym derivative gives the asserted almost-everywhere identity. -/)
  (title := /-- Radon--Nikodym derivative of composition-products with common base -/)
  (latexEnv := "lemma")]
lemma rn_deriv_comp_prod_eq_kernel_rn_deriv
    {A C : Type*} [MeasurableSpace A] [MeasurableSpace C]
    [MeasurableSpace.CountablyGenerated C]
    (baseMeasure : Measure A) [IsFiniteMeasure baseMeasure]
    (K L : ProbabilityTheory.Kernel A C)
    [ProbabilityTheory.IsFiniteKernel K] [ProbabilityTheory.IsFiniteKernel L] :
    (baseMeasure.compProd K).rnDeriv
        (baseMeasure.compProd L) =ᵐ[baseMeasure.compProd L]
      fun p => ProbabilityTheory.Kernel.rnDeriv K L p.1 p.2 := by
  refine (Measure.eq_rnDeriv
    (s := baseMeasure.compProd
      (ProbabilityTheory.Kernel.singularPart K L))
    (ProbabilityTheory.Kernel.measurable_rnDeriv K L) ?_ ?_).symm
  · exact Measure.MutuallySingular.compProd_of_right baseMeasure baseMeasure
      (ae_of_all baseMeasure fun a =>
        ProbabilityTheory.Kernel.mutuallySingular_singularPart K L a)
  · calc
      baseMeasure.compProd K =
          baseMeasure.compProd
            (ProbabilityTheory.Kernel.withDensity L
              (ProbabilityTheory.Kernel.rnDeriv K L) +
                ProbabilityTheory.Kernel.singularPart K L) := by
        rw [ProbabilityTheory.Kernel.rnDeriv_add_singularPart]
      _ = baseMeasure.compProd
            (ProbabilityTheory.Kernel.withDensity L
              (ProbabilityTheory.Kernel.rnDeriv K L)) +
          baseMeasure.compProd (ProbabilityTheory.Kernel.singularPart K L) := by
        rw [Measure.compProd_add_right]
      _ = (baseMeasure.compProd L).withDensity
            (fun p => ProbabilityTheory.Kernel.rnDeriv K L p.1 p.2) +
          baseMeasure.compProd (ProbabilityTheory.Kernel.singularPart K L) := by
        rw [Measure.compProd_withDensity
          (ProbabilityTheory.Kernel.measurable_rnDeriv K L)]
      _ = baseMeasure.compProd (ProbabilityTheory.Kernel.singularPart K L) +
          (baseMeasure.compProd L).withDensity
            (fun p => ProbabilityTheory.Kernel.rnDeriv K L p.1 p.2) := by
        rw [add_comm]

@[blueprint "lem:kl-div-comp-prod-comap"
  (statement := /-- Let \(f:A\to B\) be measurable, let \(\lambda\) be a finite measure on \(A\), and let \(K,L:B\rightsquigarrow C\) be finite kernels into a countably generated measurable space. Then
  \[
    D\bigl(\lambda\otimes(K\circ f)\,\Vert\,
      \lambda\otimes(L\circ f)\bigr)
      =
    D\bigl(f_\#\lambda\otimes K\,\Vert\,
      f_\#\lambda\otimes L\bigr).
  \] -/)
  (proof := /-- By \cref{lem:rn-deriv-comp-prod-eq-kernel-rn-deriv}, each divergence is the integral of the Kullback--Leibler generating function applied to the same kernel Radon--Nikodym derivative. Absolute continuity of the two composition-products is equivalent on both sides because almost-everywhere statements under \(f_\#\lambda\) pull back along \(f\). Finally, pushforward of \(\lambda\otimes(L\circ f)\) by \((a,c)\mapsto(f(a),c)\) is \(f_\#\lambda\otimes L\), so change of variables identifies the two integrals. -/)
  (title := /-- Kullback--Leibler divergence under a common kernel comap -/)
  (latexEnv := "lemma")]
lemma kl_div_comp_prod_comap
    {A B C : Type*} [MeasurableSpace A] [MeasurableSpace B]
    [MeasurableSpace C] [MeasurableSpace.CountablyGenerated C]
    (baseMeasure : Measure A) [IsFiniteMeasure baseMeasure]
    (f : A → B) (hf : Measurable f)
    (K L : ProbabilityTheory.Kernel B C)
    [ProbabilityTheory.IsFiniteKernel K] [ProbabilityTheory.IsFiniteKernel L] :
    InformationTheory.klDiv
        (baseMeasure.compProd (K.comap f hf))
        (baseMeasure.compProd (L.comap f hf)) =
      InformationTheory.klDiv
        ((Measure.map f baseMeasure).compProd K)
        ((Measure.map f baseMeasure).compProd L) := by
  let Kf := K.comap f hf
  let Lf := L.comap f hf
  let g : A × C → B × C := fun p => (f p.1, p.2)
  have hg : Measurable g := (hf.comp measurable_fst).prodMk measurable_snd
  have hMapL :
      Measure.map g (baseMeasure.compProd Lf) =
        (Measure.map f baseMeasure).compProd L := by
    refine Measure.ext_prod ?_
    intro s t hs ht
    rw [Measure.map_apply hg (hs.prod ht)]
    change (baseMeasure.compProd Lf) ((f ⁻¹' s) ×ˢ t) = _
    rw [Measure.compProd_apply_prod (hs.preimage hf) ht,
      Measure.compProd_apply_prod hs ht,
      MeasureTheory.setLIntegral_map hs (L.measurable_coe ht) hf]
    rfl
  have hAC :
      baseMeasure.compProd Kf ≪ baseMeasure.compProd Lf ↔
        (Measure.map f baseMeasure).compProd K ≪
          (Measure.map f baseMeasure).compProd L := by
    rw [Measure.absolutelyContinuous_compProd_right_iff,
      Measure.absolutelyContinuous_compProd_right_iff,
      MeasureTheory.ae_map_iff hf.aemeasurable
        (ProbabilityTheory.Kernel.measurableSet_absolutelyContinuous K L)]
    rfl
  rw [InformationTheory.klDiv_eq_lintegral_klFun,
    InformationTheory.klDiv_eq_lintegral_klFun]
  by_cases h : baseMeasure.compProd Kf ≪ baseMeasure.compProd Lf
  · rw [if_pos h, if_pos (hAC.mp h)]
    have hRNLeft := rn_deriv_comp_prod_eq_kernel_rn_deriv
      baseMeasure Kf Lf
    have hRNRight := rn_deriv_comp_prod_eq_kernel_rn_deriv
      (Measure.map f baseMeasure) K L
    have hKernelPoint (a : A) :
        ProbabilityTheory.Kernel.rnDeriv Kf Lf a =ᵐ[Lf a]
          ProbabilityTheory.Kernel.rnDeriv K L (f a) := by
      filter_upwards [
        ProbabilityTheory.Kernel.rnDeriv_eq_rnDeriv_measure
          (κ := Kf) (η := Lf) (a := a),
        ProbabilityTheory.Kernel.rnDeriv_eq_rnDeriv_measure
          (κ := K) (η := L) (a := f a)] with c hc₁ hc₂
      simpa [Kf, Lf] using hc₁.trans hc₂.symm
    have hKernel :
        (fun p => ProbabilityTheory.Kernel.rnDeriv Kf Lf p.1 p.2) =ᵐ[
          baseMeasure.compProd Lf]
          fun p => ProbabilityTheory.Kernel.rnDeriv K L (f p.1) p.2 := by
      apply Measure.ae_compProd_of_ae_ae
      · exact measurableSet_eq_fun
          (ProbabilityTheory.Kernel.measurable_rnDeriv Kf Lf)
          ((ProbabilityTheory.Kernel.measurable_rnDeriv K L).comp hg)
      · exact ae_of_all baseMeasure hKernelPoint
    have hIntegrand :
        Measurable (fun p : B × C =>
          ENNReal.ofReal (InformationTheory.klFun
            ((ProbabilityTheory.Kernel.rnDeriv K L p.1 p.2).toReal))) := by
      fun_prop
    calc
      (∫⁻ p, ENNReal.ofReal (InformationTheory.klFun
          (((baseMeasure.compProd Kf).rnDeriv
            (baseMeasure.compProd Lf) p).toReal))
          ∂(baseMeasure.compProd Lf)) =
          ∫⁻ p, ENNReal.ofReal (InformationTheory.klFun
            ((ProbabilityTheory.Kernel.rnDeriv Kf Lf p.1 p.2).toReal))
            ∂(baseMeasure.compProd Lf) := by
        refine lintegral_congr_ae ?_
        filter_upwards [hRNLeft] with p hp
        rw [hp]
      _ = ∫⁻ p, ENNReal.ofReal (InformationTheory.klFun
            ((ProbabilityTheory.Kernel.rnDeriv K L (f p.1) p.2).toReal))
            ∂(baseMeasure.compProd Lf) := by
        refine lintegral_congr_ae ?_
        filter_upwards [hKernel] with p hp
        rw [hp]
      _ = ∫⁻ p, ENNReal.ofReal (InformationTheory.klFun
            ((ProbabilityTheory.Kernel.rnDeriv K L p.1 p.2).toReal))
            ∂((Measure.map f baseMeasure).compProd L) := by
        rw [← hMapL, MeasureTheory.lintegral_map hIntegrand hg]
      _ = ∫⁻ p, ENNReal.ofReal (InformationTheory.klFun
          ((((Measure.map f baseMeasure).compProd K).rnDeriv
            ((Measure.map f baseMeasure).compProd L) p).toReal))
          ∂((Measure.map f baseMeasure).compProd L) := by
        refine lintegral_congr_ae ?_
        filter_upwards [hRNRight] with p hp
        rw [hp]
  · rw [if_neg h, if_neg (not_congr hAC |>.mp h)]

@[blueprint "lem:excess-memorization-chain-identity"
  (statement := /-- Let \(\mu\) be a finite measure on a measurable space \(\Omega\), and let \(\theta:\Omega\to\Theta\) and \(X_{1:n}:\Omega\to\mathcal T\) be measurable maps. Assume that the nonempty training-sample space \(\mathcal T\) is standard Borel and that the model-output measurable space \(\mathcal M\) is countably generated. For every possibly randomized learning algorithm \(\mathcal A:\mathcal T\rightsquigarrow\mathcal M\), under the joint law induced by \(\mu\) and \(\mathcal A\),
  \[
    I(\mathcal A(X_{1:n});X_{1:n})
      =I(\mathcal A(X_{1:n});\theta)
        +\operatorname{mem}_n(\mathcal A,\mathbf P).
  \]
  This addition-form identity is meaningful in the extended nonnegative reals even when one of its terms is infinite. -/)
  (proof := /-- Unfold \cref{def:learning-algorithm-joint-measure}, \cref{def:mutual-information}, \cref{def:conditional-mutual-information}, and \cref{def:excess-memorization}, and denote the induced law by \(\nu\). Its training--output marginal is the composition-product of the training marginal with the algorithm kernel. After swapping the two coordinates, \cref{lem:kl-div-map-measurable-equiv} therefore identifies the left-hand divergence with the divergence between this composition-product and the corresponding composition-product with the constant output kernel. Apply the relative-entropy chain rule to the output--parameter marginal and the regular conditional law of the training sample given the output and parameter. The regular conditional law of the training sample given the parameter, extended trivially across the output coordinate, supplies the comparison kernel. Associativity of composition-products, reconstruction by the regular conditional law, and a measurable permutation of the three coordinates identify the resulting full divergence with the analogous divergence based on the joint parameter--training marginal. Both its algorithm and constant-output kernels are pullbacks along the training projection, so \cref{lem:kl-div-comp-prod-comap} identifies this full divergence with the left-hand divergence above. The two remaining chain-rule terms are precisely the parameter mutual information and the conditional mutual information defining excess memorization, which gives the asserted addition-form identity without subtracting extended values. -/)
  (title := /-- Chain identity for excess memorization -/)
  (latexEnv := "lemma")]
lemma excess_memorization_chain_identity
    {Ω Θ X Train M : Type*} [MeasurableSpace Ω] [MeasurableSpace Θ]
    [MeasurableSpace X] [MeasurableSpace Train] [StandardBorelSpace Train]
    [Nonempty Train] [MeasurableSpace M] [MeasurableSpace.CountablyGenerated M]
    (μ : Measure Ω) [IsFiniteMeasure μ]
    (parameter : Ω → Θ) (training : Ω → Train)
    (hParameter : Measurable parameter) (hTraining : Measurable training)
    (algorithm : learning_algorithm Train M) :
    mutual_information
        (learning_algorithm_joint_measure μ training hTraining algorithm)
        Prod.snd (fun ωz => training ωz.1) =
      mutual_information
          (learning_algorithm_joint_measure μ training hTraining algorithm)
          Prod.snd (fun ωz => parameter ωz.1) +
        excess_memorization μ parameter training hTraining algorithm := by
  letI : ProbabilityTheory.IsMarkovKernel algorithm.kernel := algorithm.markov
  let κ := ProbabilityTheory.Kernel.comap algorithm.kernel training hTraining
  letI : ProbabilityTheory.IsMarkovKernel κ := inferInstance
  letI : ProbabilityTheory.IsFiniteKernel κ := inferInstance
  let ν := μ.compProd κ
  letI : IsFiniteMeasure ν := inferInstance
  change mutual_information ν Prod.snd (fun ωz => training ωz.1) =
    mutual_information ν Prod.snd (fun ωz => parameter ωz.1) +
      conditional_mutual_information ν Prod.snd
        (fun ωz => training ωz.1) (fun ωz => parameter ωz.1)
  unfold mutual_information conditional_mutual_information
  have hTrainingν : Measurable (fun ωz : Ω × M => training ωz.1) :=
    hTraining.comp measurable_fst
  have hPairν : Measurable (fun ωz : Ω × M => (ωz.2, parameter ωz.1)) :=
    measurable_snd.prodMk (hParameter.comp measurable_fst)
  have hJointTrain : Measure.map (fun ωz : Ω × M => (training ωz.1, ωz.2)) ν =
      (Measure.map training μ).compProd algorithm.kernel := by
    refine Measure.ext_prod ?_
    intro s t hs ht
    rw [Measure.map_apply (hTrainingν.prodMk measurable_snd) (hs.prod ht)]
    change ν ((training ⁻¹' s) ×ˢ t) = _
    rw [show ν = μ.compProd κ by rfl,
      Measure.compProd_apply_prod (hs.preimage hTraining) ht,
      Measure.compProd_apply_prod hs ht,
      MeasureTheory.setLIntegral_map hs
        (algorithm.kernel.measurable_coe ht) hTraining]
    rfl
  have hTrainingMarginal : Measure.map (fun ωz : Ω × M => training ωz.1) ν =
      Measure.map training μ := by
    convert congrArg (Measure.map training) (Measure.fst_compProd μ κ) using 1 <;>
      simp only [ν, Measure.fst, Measure.map_map hTraining measurable_fst,
        Function.comp_apply] <;> rfl
  have hParameterTrainingMarginal :
      Measure.map (fun ωz : Ω × M => (parameter ωz.1, training ωz.1)) ν =
        Measure.map (fun ω => (parameter ω, training ω)) μ := by
    convert congrArg (Measure.map (fun ω => (parameter ω, training ω)))
      (Measure.fst_compProd μ κ) using 1 <;>
      simp only [ν, Measure.fst,
        Measure.map_map (hParameter.prodMk hTraining) measurable_fst,
        Function.comp_apply] <;> rfl
  let outputMeasure := Measure.map Prod.snd ν
  let parameterTrainingMeasure :=
    Measure.map (fun ω => (parameter ω, training ω)) μ
  let outputKernel :=
    ProbabilityTheory.Kernel.const Train outputMeasure
  let fullOutputKernel :=
    ProbabilityTheory.Kernel.const (Θ × Train) outputMeasure
  let fullAlgorithmKernel : ProbabilityTheory.Kernel (Θ × Train) M :=
    ProbabilityTheory.Kernel.comap algorithm.kernel
      (fun p : Θ × Train => p.2) measurable_snd
  letI : IsFiniteMeasure outputMeasure := inferInstance
  letI : IsFiniteMeasure parameterTrainingMeasure := inferInstance
  letI : ProbabilityTheory.IsFiniteKernel outputKernel := inferInstance
  letI : ProbabilityTheory.IsFiniteKernel fullOutputKernel := inferInstance
  letI : ProbabilityTheory.IsFiniteKernel fullAlgorithmKernel := inferInstance
  let eTrain : (M × Train) ≃ᵐ (Train × M) :=
    MeasurableEquiv.prodComm
  let eFull : ((M × Θ) × Train) ≃ᵐ ((Θ × Train) × M) :=
    (MeasurableEquiv.prodAssoc : ((M × Θ) × Train) ≃ᵐ
      (M × (Θ × Train))).trans MeasurableEquiv.prodComm
  have hFullJoint :
      Measure.map
          (fun ωz : Ω × M => ((parameter ωz.1, training ωz.1), ωz.2)) ν =
        parameterTrainingMeasure.compProd fullAlgorithmKernel := by
    refine Measure.ext_prod ?_
    intro s t hs ht
    rw [Measure.map_apply (by fun_prop) (hs.prod ht)]
    change ν (((fun ω => (parameter ω, training ω)) ⁻¹' s) ×ˢ t) = _
    rw [show ν = μ.compProd κ by rfl,
      Measure.compProd_apply_prod
        (hs.preimage (hParameter.prodMk hTraining)) ht,
      Measure.compProd_apply_prod hs ht,
      MeasureTheory.setLIntegral_map hs
        (fullAlgorithmKernel.measurable_coe ht)
        (hParameter.prodMk hTraining)]
    rfl
  have hTargetNumerator :
      Measure.map eTrain
          (Measure.map (fun ωz : Ω × M => (ωz.2, training ωz.1)) ν) =
        (Measure.map training μ).compProd algorithm.kernel := by
    rw [← hJointTrain,
      Measure.map_map eTrain.measurable (measurable_snd.prodMk hTrainingν)]
    rfl
  have hTargetDenominator :
      Measure.map eTrain
          (outputMeasure.prod
            (Measure.map (fun ωz : Ω × M => training ωz.1) ν)) =
        (Measure.map training μ).compProd outputKernel := by
    rw [hTrainingMarginal]
    simp only [outputKernel, Measure.compProd_const]
    change Measure.map eTrain
      (outputMeasure.prod (Measure.map training μ)) =
        (Measure.map training μ).prod outputMeasure
    convert (Measure.prod_swap
      (μ := outputMeasure) (ν := Measure.map training μ)) using 1 <;> rfl
  have hTargetKL :
      InformationTheory.klDiv
          (Measure.map (fun ωz : Ω × M => (ωz.2, training ωz.1)) ν)
          (outputMeasure.prod
            (Measure.map (fun ωz : Ω × M => training ωz.1) ν)) =
        InformationTheory.klDiv
          ((Measure.map training μ).compProd algorithm.kernel)
          ((Measure.map training μ).compProd outputKernel) := by
    rw [← hTargetNumerator, ← hTargetDenominator]
    exact (kl_div_map_measurable_equiv eTrain _ _).symm
  have hFullNumerator :
      Measure.map eFull
          (Measure.map
            (fun ωz : Ω × M => ((ωz.2, parameter ωz.1), training ωz.1)) ν) =
        parameterTrainingMeasure.compProd fullAlgorithmKernel := by
    rw [Measure.map_map eFull.measurable (by fun_prop)]
    change Measure.map
      (fun ωz : Ω × M => ((parameter ωz.1, training ωz.1), ωz.2)) ν =
        parameterTrainingMeasure.compProd fullAlgorithmKernel
    exact hFullJoint
  have hFullDenominator :
      Measure.map eFull
          ((outputMeasure.prod
              (Measure.map (fun ωz : Ω × M => parameter ωz.1) ν)).compProd
            (ProbabilityTheory.Kernel.prodMkLeft M
              (ProbabilityTheory.condDistrib
                (fun ωz : Ω × M => training ωz.1)
                (fun ωz : Ω × M => parameter ωz.1) ν))) =
        parameterTrainingMeasure.compProd fullOutputKernel := by
    let parameterMeasure :=
      Measure.map (fun ωz : Ω × M => parameter ωz.1) ν
    let conditionalKernel := ProbabilityTheory.condDistrib
      (fun ωz : Ω × M => training ωz.1)
      (fun ωz : Ω × M => parameter ωz.1) ν
    let parameterKernel :=
      ProbabilityTheory.Kernel.const M parameterMeasure
    have hKernel :
        parameterKernel.compProd
            (ProbabilityTheory.Kernel.prodMkLeft M conditionalKernel) =
          ProbabilityTheory.Kernel.const M
            (parameterMeasure.compProd conditionalKernel) := by
      ext m s hs
      rw [ProbabilityTheory.Kernel.compProd_apply hs]
      simp only [ProbabilityTheory.Kernel.prodMkLeft_apply,
        ProbabilityTheory.Kernel.const_apply]
      rw [Measure.compProd_apply hs]
      simp [parameterKernel]
    have hBase : outputMeasure.prod parameterMeasure =
        outputMeasure.compProd parameterKernel := by
      simp [parameterKernel]
    have hAssoc :
        Measure.map MeasurableEquiv.prodAssoc
            ((outputMeasure.prod parameterMeasure).compProd
              (ProbabilityTheory.Kernel.prodMkLeft M conditionalKernel)) =
          outputMeasure.prod
            (parameterMeasure.compProd conditionalKernel) := by
      rw [hBase, Measure.compProd_assoc', hKernel, Measure.compProd_const]
    rw [Measure.compProd_const]
    calc
      Measure.map eFull
          ((outputMeasure.prod parameterMeasure).compProd
            (ProbabilityTheory.Kernel.prodMkLeft M conditionalKernel)) =
          Measure.map MeasurableEquiv.prodComm
            (Measure.map MeasurableEquiv.prodAssoc
              ((outputMeasure.prod parameterMeasure).compProd
                (ProbabilityTheory.Kernel.prodMkLeft M conditionalKernel))) := by
        rw [Measure.map_map MeasurableEquiv.prodComm.measurable
          MeasurableEquiv.prodAssoc.measurable]
        rfl
      _ = Measure.map MeasurableEquiv.prodComm
          (outputMeasure.prod
            (parameterMeasure.compProd conditionalKernel)) := by
        rw [hAssoc]
      _ = Measure.map MeasurableEquiv.prodComm
          (outputMeasure.prod parameterTrainingMeasure) := by
        rw [show parameterMeasure.compProd conditionalKernel =
          parameterTrainingMeasure by
            simp [parameterMeasure, conditionalKernel,
              parameterTrainingMeasure,
              ProbabilityTheory.compProd_map_condDistrib
                hTrainingν.aemeasurable,
              hParameterTrainingMarginal]]
      _ = parameterTrainingMeasure.prod outputMeasure := by
        convert (Measure.prod_swap
          (μ := outputMeasure) (ν := parameterTrainingMeasure)) using 1 <;> rfl
  have hFullKL :
      InformationTheory.klDiv
          (Measure.map
            (fun ωz : Ω × M => ((ωz.2, parameter ωz.1), training ωz.1)) ν)
          ((outputMeasure.prod
              (Measure.map (fun ωz : Ω × M => parameter ωz.1) ν)).compProd
            (ProbabilityTheory.Kernel.prodMkLeft M
              (ProbabilityTheory.condDistrib
                (fun ωz : Ω × M => training ωz.1)
                (fun ωz : Ω × M => parameter ωz.1) ν))) =
        InformationTheory.klDiv
          (parameterTrainingMeasure.compProd fullAlgorithmKernel)
          (parameterTrainingMeasure.compProd fullOutputKernel) := by
    rw [← hFullNumerator, ← hFullDenominator]
    exact (kl_div_map_measurable_equiv eFull _ _).symm
  have hMapTraining :
      Measure.map Prod.snd parameterTrainingMeasure =
        Measure.map training μ := by
    change Measure.map Prod.snd
      (Measure.map (fun ω => (parameter ω, training ω)) μ) =
        Measure.map training μ
    rw [Measure.map_map measurable_snd (hParameter.prodMk hTraining)]
    rfl
  have hOutputComap :
      ProbabilityTheory.Kernel.comap outputKernel
          (fun p : Θ × Train => p.2) measurable_snd =
        fullOutputKernel := by
    ext p s hs
    rfl
  have hComapKL :
      InformationTheory.klDiv
          (parameterTrainingMeasure.compProd fullAlgorithmKernel)
          (parameterTrainingMeasure.compProd fullOutputKernel) =
        InformationTheory.klDiv
          ((Measure.map training μ).compProd algorithm.kernel)
          ((Measure.map training μ).compProd outputKernel) := by
    rw [← hOutputComap]
    simpa only [fullAlgorithmKernel, hMapTraining] using
      (kl_div_comp_prod_comap parameterTrainingMeasure
        (fun p : Θ × Train => p.2) measurable_snd
        algorithm.kernel outputKernel)
  have hChain := InformationTheory.klDiv_compProd_eq_add
    (μ := Measure.map (fun ωz : Ω × M => (ωz.2, parameter ωz.1)) ν)
    (ν := (Measure.map Prod.snd ν).prod
      (Measure.map (fun ωz : Ω × M => parameter ωz.1) ν))
    (κ := ProbabilityTheory.condDistrib (fun ωz : Ω × M => training ωz.1)
      (fun ωz : Ω × M => (ωz.2, parameter ωz.1)) ν)
    (η := ProbabilityTheory.Kernel.prodMkLeft M
      (ProbabilityTheory.condDistrib (fun ωz : Ω × M => training ωz.1)
        (fun ωz : Ω × M => parameter ωz.1) ν))
  rw [ProbabilityTheory.compProd_map_condDistrib hTrainingν.aemeasurable] at hChain
  calc
    InformationTheory.klDiv
        (Measure.map (fun ωz : Ω × M => (ωz.2, training ωz.1)) ν)
        (outputMeasure.prod
          (Measure.map (fun ωz : Ω × M => training ωz.1) ν)) =
      InformationTheory.klDiv
        ((Measure.map training μ).compProd algorithm.kernel)
        ((Measure.map training μ).compProd outputKernel) := hTargetKL
    _ = InformationTheory.klDiv
        (parameterTrainingMeasure.compProd fullAlgorithmKernel)
        (parameterTrainingMeasure.compProd fullOutputKernel) := hComapKL.symm
    _ = InformationTheory.klDiv
        (Measure.map
          (fun ωz : Ω × M => ((ωz.2, parameter ωz.1), training ωz.1)) ν)
        ((outputMeasure.prod
            (Measure.map (fun ωz : Ω × M => parameter ωz.1) ν)).compProd
          (ProbabilityTheory.Kernel.prodMkLeft M
            (ProbabilityTheory.condDistrib
              (fun ωz : Ω × M => training ωz.1)
              (fun ωz : Ω × M => parameter ωz.1) ν))) := hFullKL.symm
    _ = _ := hChain

@[blueprint "thm:excess-memorization-lower-bound"
  (statement := /-- Fix \(n\in\mathbb N\), a parameter law \(\Psi\), and a conditional example kernel \(\theta\mapsto\mathcal P_\theta\). Let \((\Omega,\mu)\) be a probability space. Assume that \(\Theta\) and \(\mathcal X\) are Hausdorff second-countable Borel spaces, that \(\mathcal X\) is nonempty, and that \(\mathcal X^n\), equipped with its product measurable structure, is standard Borel. Let the measurable maps \(\theta:\Omega\to\Theta\), \(X_{1:n}:\Omega\to\mathcal X^n\), and \(X:\Omega\to\mathcal X\) obey the sampling law of \cref{def:learning-problem-sampling-law}; in particular, conditional on \(\theta\), the training sample consists of \(n\) independent draws from \(\mathcal P_\theta\), and \(X\) is a fresh independent draw from the same law. Suppose that \((\theta,X_{1:n})\) satisfies the coupling-based \((\tau_n,\epsilon_n)\)-approximate SDPI of \cref{def:approximate-strong-data-processing-inequality} and that \((X,X_{1:n})\) satisfies the coupling-based \((\rho_n,\delta_n)\)-approximate SDPI of the same definition, where \(0<\rho_n\). Assume in addition that the model-output space \(\mathcal M\) is finite. Then every possibly randomized algorithm \(\mathcal A:\mathcal X^n\rightsquigarrow\mathcal M\), represented by a Markov kernel into a countably generated measurable space whose singletons are measurable, satisfies the extended-real inequality
  \[
    \operatorname{mem}_n(\mathcal A,\mathbf P)
      \geq \frac{1-\tau_n}{\rho_n}
        I(\mathcal A(X_{1:n});X)-\operatorname{neg}_n,
  \]
  where
  \[
    \operatorname{neg}_n
      =\frac{1-\tau_n}{\rho_n}q_{\mathcal M}(\delta_n)
       +q_{\mathcal M}(\epsilon_n).
  \] -/)
  (proof := /-- Use \cref{lem:finite-output-learning-algorithm-mutual-information-law} to identify the training mutual information with its canonical kernel form, and then apply \cref{lem:finite-output-mutual-information-le-log-card}. This bounds \(I(\mathcal A(X_{1:n});X_{1:n})\) by the finite number \(\log|\mathcal M|\). The addition-form identity in \cref{lem:excess-memorization-chain-identity} then also makes the parameter mutual information and excess memorization finite. Since \(\mathcal M\) is finite, both error penalties in \cref{def:information-error-penalty} are finite; moreover, \cref{lem:approximate-sdpi-postprocessing-bound} applied to the test/train SDPI makes \(I(\mathcal A(X_{1:n});X)\) finite. Hence all relevant extended-real quantities may be represented by real numbers. Combining the chain identity with the parameter-information estimate in \cref{lem:data-generation-information-bound} gives
  \[
    \operatorname{mem}_n(\mathcal A,\mathbf P)
      \geq (1-\tau_n)I(\mathcal A(X_{1:n});X_{1:n})
        -q_{\mathcal M}(\epsilon_n).
  \]
  The data-generation SDPI in \cref{def:approximate-strong-data-processing-inequality} gives \(\tau_n\leq1\), so \(1-\tau_n\) is nonnegative. Substitute the lower bound of \cref{lem:test-train-information-bound} for the remaining training-sample mutual information, distribute this nonnegative factor, and collect the two error terms according to \cref{def:excess-memorization-correction}. This yields the stated inequality. -/)
  (title := /-- Excess memorization from strong data processing -/)
  (latexEnv := "theorem")]
theorem excess_memorization_lower_bound
    {Ω Θ X : Type*} {M : Type} (n : ℕ) [MeasurableSpace Ω] [TopologicalSpace Θ]
    [MeasurableSpace Θ] [BorelSpace Θ] [SecondCountableTopology Θ] [T2Space Θ]
    [TopologicalSpace X] [MeasurableSpace X] [BorelSpace X]
    [SecondCountableTopology X] [T2Space X] [Nonempty X]
    [StandardBorelSpace (Fin n → X)] [MeasurableSpace M]
    [MeasurableSingletonClass M]
    [Finite M]
    [MeasurableSpace.CountablyGenerated M]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (Ψ : Measure Θ) (P : ProbabilityTheory.Kernel Θ X)
    (parameter : Ω → Θ) (training : Ω → Fin n → X) (test : Ω → X)
    (hSampling : learning_problem_sampling_law
      n μ Ψ P parameter training test)
    (τ ε ρ δ : ℝ)
    (hData : approximate_strong_data_processing_inequality
      μ parameter training τ ε)
    (hTest : approximate_strong_data_processing_inequality
      μ test training ρ δ)
    (hρ : 0 < ρ)
    (algorithm : learning_algorithm (Fin n → X) M) :
    (excess_memorization μ parameter training hData.2.1 algorithm : EReal) ≥
      (((1 - τ) / ρ : ℝ) : EReal) *
        (mutual_information
          (learning_algorithm_joint_measure μ training hData.2.1 algorithm)
          Prod.snd (fun ωz => test ωz.1) : EReal) -
        excess_memorization_correction M τ ε ρ δ := by
  classical
  letI : ProbabilityTheory.IsMarkovKernel algorithm.kernel := algorithm.markov
  let Itrain : ENNReal := mutual_information
    (learning_algorithm_joint_measure μ training hData.2.1 algorithm)
    Prod.snd (fun ωz => training ωz.1)
  let Iparam : ENNReal := mutual_information
    (learning_algorithm_joint_measure μ training hData.2.1 algorithm)
    Prod.snd (fun ωz => parameter ωz.1)
  let Itest : ENNReal := mutual_information
    (learning_algorithm_joint_measure μ training hData.2.1 algorithm)
    Prod.snd (fun ωz => test ωz.1)
  let mem : ENNReal :=
    excess_memorization μ parameter training hData.2.1 algorithm
  let qε : ℝ := if ε = 0 then 0 else
    8 * ε * Real.log ((Nat.card M : ℝ) / ε)
  let qδ : ℝ := if δ = 0 then 0 else
    8 * δ * Real.log ((Nat.card M : ℝ) / δ)
  have hqε : information_error_penalty M ε = (qε : EReal) := by
    unfold information_error_penalty qε
    split_ifs <;> norm_num [← EReal.coe_mul]
  have hqδ : information_error_penalty M δ = (qδ : EReal) := by
    unfold information_error_penalty qδ
    split_ifs <;> norm_num [← EReal.coe_mul]
  let μtrain : Measure (Fin n → X) := Measure.map training μ
  letI : IsProbabilityMeasure μtrain := ⟨by
    dsimp [μtrain]
    rw [Measure.map_apply_of_aemeasurable hData.2.1.aemeasurable
      MeasurableSet.univ]
    simp⟩
  have hTrainBound :
      (Itrain : EReal) ≤ ((Real.log (Nat.card M) : ℝ) : EReal) := by
    rw [show Itrain = mutual_information
      (learning_algorithm_joint_measure μ training hData.2.1 algorithm)
      Prod.snd (fun ωz => training ωz.1) by rfl]
    rw [finite_output_learning_algorithm_mutual_information_law
      μ training hData.2.1 algorithm]
    exact finite_output_mutual_information_le_log_card μtrain algorithm.kernel
  have hItrain : Itrain ≠ ⊤ := by
    intro h
    rw [h, EReal.coe_ennreal_top] at hTrainBound
    exact (not_le_of_gt (EReal.coe_lt_top _)) hTrainBound
  have hChain : Itrain = Iparam + mem := by
    simpa [Itrain, Iparam, mem] using
      excess_memorization_chain_identity (X := X) μ parameter training
        hData.1 hData.2.1 algorithm
  have hSum : Iparam + mem ≠ ⊤ := by
    rw [← hChain]
    exact hItrain
  have hIparam : Iparam ≠ ⊤ := (ENNReal.add_ne_top.mp hSum).1
  have hMem : mem ≠ ⊤ := (ENNReal.add_ne_top.mp hSum).2
  have hChainReal :
      Itrain.toReal = Iparam.toReal + mem.toReal := by
    rw [hChain, ENNReal.toReal_add hIparam hMem]
  have hDataBound :
      (Iparam : EReal) ≤
        (τ : EReal) * (Itrain : EReal) + (qε : EReal) := by
    simpa [Itrain, Iparam, hqε] using
      data_generation_information_bound
        μ parameter training test τ ε hData algorithm
  rw [← EReal.coe_ennreal_toReal hIparam,
    ← EReal.coe_ennreal_toReal hItrain,
    ← EReal.coe_mul, ← EReal.coe_add] at hDataBound
  have hDataReal :
      Iparam.toReal ≤ τ * Itrain.toReal + qε :=
    EReal.coe_le_coe_iff.mp hDataBound
  have hTestUpper :
      (Itest : EReal) ≤
        (ρ : EReal) * (Itrain : EReal) + (qδ : EReal) := by
    simpa [Itest, Itrain, hqδ] using
      approximate_sdpi_postprocessing_bound
        μ test training ρ δ hTest algorithm
  rw [← EReal.coe_ennreal_toReal hItrain,
    ← EReal.coe_mul, ← EReal.coe_add] at hTestUpper
  have hItest : Itest ≠ ⊤ := by
    intro h
    rw [h, EReal.coe_ennreal_top] at hTestUpper
    exact (not_le_of_gt (EReal.coe_lt_top _)) hTestUpper
  have hTestBound :
      (Itest : EReal) / (ρ : EReal) -
          (qδ : EReal) / (ρ : EReal) ≤ (Itrain : EReal) := by
    simpa [Itest, Itrain, hqδ] using
      test_train_information_bound
        μ parameter training test ρ δ hTest hρ algorithm
  rw [← EReal.coe_ennreal_toReal hItest,
    ← EReal.coe_ennreal_toReal hItrain,
    ← EReal.coe_div, ← EReal.coe_div, ← EReal.coe_sub] at hTestBound
  have hTestReal :
      Itest.toReal / ρ - qδ / ρ ≤ Itrain.toReal :=
    EReal.coe_le_coe_iff.mp hTestBound
  obtain ⟨κ, hκ, hLaw, hExact, hTV⟩ := hData.2.2.2.2
  have hτle : τ ≤ 1 := hExact.2.2.2.1
  have hMemLower :
      (1 - τ) * Itrain.toReal - qε ≤ mem.toReal := by
    linarith
  have hScaled :
      (1 - τ) * (Itest.toReal / ρ - qδ / ρ) ≤
        (1 - τ) * Itrain.toReal :=
    mul_le_mul_of_nonneg_left hTestReal (sub_nonneg.mpr hτle)
  have hFinalReal :
      (1 - τ) / ρ * Itest.toReal -
          ((1 - τ) / ρ * qδ + qε) ≤ mem.toReal := by
    have hAlg :
        (1 - τ) / ρ * Itest.toReal -
            ((1 - τ) / ρ * qδ + qε) =
          (1 - τ) * (Itest.toReal / ρ - qδ / ρ) - qε := by
      ring
    rw [hAlg]
    linarith
  unfold excess_memorization_correction
  change ((((1 - τ) / ρ : ℝ) : EReal) * (Itest : EReal) -
      (((((1 - τ) / ρ : ℝ) : EReal) *
        information_error_penalty M δ) +
        information_error_penalty M ε) ≤ (mem : EReal))
  rw [hqδ, hqε, ← EReal.coe_ennreal_toReal hItest,
    ← EReal.coe_ennreal_toReal hMem,
    ← EReal.coe_mul, ← EReal.coe_mul, ← EReal.coe_add, ← EReal.coe_sub]
  exact_mod_cast hFinalReal

@[blueprint "lem:binary-event-kl-divergence-lower-bound"
  (statement := /-- Let \(\mu\) and \(\nu\) be finite measures of equal
  total mass with \(\mu\ll\nu\), and suppose that their log-likelihood ratio is
  \(\mu\)-integrable. If \(A\) is measurable and both \(\nu(A)\) and
  \(\nu(A^{\mathsf c})\) are nonzero, then
  \[
    D(\mu\Vert\nu)\geq
      \mu(A)\log\!\frac{\mu(A)}{\nu(A)}
      +\mu(A^{\mathsf c})\log\!\frac{\mu(A^{\mathsf c})}
        {\nu(A^{\mathsf c})}.
  \] -/)
  (proof := /-- Write the divergence as the integral, with respect to
  \(\nu\), of the Kullback--Leibler generating function evaluated at
  \(d\mu/d\nu\). Its integrability follows from the assumed integrability
  of the log-likelihood ratio. Jensen's inequality on \(A\) gives
  \[
    \nu(A)\,\mathrm{kl}\!\left(\frac{\mu(A)}{\nu(A)}\right)
      \leq \int_A \mathrm{kl}\!\left(\frac{d\mu}{d\nu}\right)d\nu,
  \]
  and the same argument applies on \(A^{\mathsf c}\). Add these
  inequalities and decompose the integral over the two complementary sets.
  Expanding the generating function, the affine terms cancel because
  \(\mu\) and \(\nu\) have equal total mass, leaving precisely the
  asserted two logarithmic terms. -/)
  (title := /-- Binary-event lower bound for Kullback--Leibler divergence -/)
  (latexEnv := "lemma")]
lemma binary_event_kl_divergence_lower_bound
    {S : Type*} [MeasurableSpace S]
    (μ ν : Measure S) [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    (A : Set S) (hA : MeasurableSet A)
    (hμν : μ ≪ ν) (hInt : Integrable (llr μ ν) μ)
    (hMass : μ.real Set.univ = ν.real Set.univ)
    (hνA : ν A ≠ 0) (hνAc : ν Aᶜ ≠ 0) :
    μ.real A * Real.log (μ.real A / ν.real A) +
        μ.real Aᶜ * Real.log (μ.real Aᶜ / ν.real Aᶜ) ≤
      (InformationTheory.klDiv μ ν).toReal := by
  have hKLInt :
      Integrable
        (fun x => InformationTheory.klFun (μ.rnDeriv ν x).toReal) ν :=
    (InformationTheory.integrable_klFun_rnDeriv_iff hμν).2 hInt
  have hRNDInt : Integrable (fun x => (μ.rnDeriv ν x).toReal) ν :=
    Measure.integrable_toReal_rnDeriv
  have hνAfin : ν A ≠ ⊤ := measure_ne_top ν A
  have hνAcfin : ν Aᶜ ≠ ⊤ := measure_ne_top ν Aᶜ
  have hνAreal : ν.real A ≠ 0 :=
    (measureReal_ne_zero_iff hνAfin).2 hνA
  have hνAcreal : ν.real Aᶜ ≠ 0 :=
    (measureReal_ne_zero_iff hνAcfin).2 hνAc
  have hνApos : 0 < ν.real A := lt_of_le_of_ne (measureReal_nonneg) (Ne.symm hνAreal)
  have hνAcpos : 0 < ν.real Aᶜ :=
    lt_of_le_of_ne (measureReal_nonneg) (Ne.symm hνAcreal)
  have hJensenA := InformationTheory.convexOn_klFun.map_set_average_le
    InformationTheory.continuous_klFun.continuousOn isClosed_Ici
    hνA hνAfin
    (ae_of_all _ fun _ => ENNReal.toReal_nonneg)
    hRNDInt.integrableOn hKLInt.integrableOn
  have hJensenAc := InformationTheory.convexOn_klFun.map_set_average_le
    InformationTheory.continuous_klFun.continuousOn isClosed_Ici
    hνAc hνAcfin
    (ae_of_all _ fun _ => ENNReal.toReal_nonneg)
    hRNDInt.integrableOn hKLInt.integrableOn
  simp only [MeasureTheory.setAverage_eq,
    Measure.setIntegral_toReal_rnDeriv hμν A, smul_eq_mul,
    Function.comp_apply] at hJensenA
  simp only [MeasureTheory.setAverage_eq,
    Measure.setIntegral_toReal_rnDeriv hμν Aᶜ, smul_eq_mul,
    Function.comp_apply] at hJensenAc
  have hBoundA := mul_le_mul_of_nonneg_left hJensenA (le_of_lt hνApos)
  field_simp [hνAreal] at hBoundA
  have hBoundAc := mul_le_mul_of_nonneg_left hJensenAc (le_of_lt hνAcpos)
  field_simp [hνAcreal] at hBoundAc
  have hSum := add_le_add hBoundA hBoundAc
  rw [MeasureTheory.integral_add_compl hA hKLInt] at hSum
  rw [InformationTheory.toReal_klDiv_eq_integral_klFun hμν]
  calc
    μ.real A * Real.log (μ.real A / ν.real A) +
        μ.real Aᶜ * Real.log (μ.real Aᶜ / ν.real Aᶜ) =
        ν.real A * InformationTheory.klFun (μ.real A / ν.real A) +
          ν.real Aᶜ * InformationTheory.klFun (μ.real Aᶜ / ν.real Aᶜ) := by
      rw [InformationTheory.klFun, InformationTheory.klFun]
      have hμTotal := measureReal_add_measureReal_compl (μ := μ) hA
      have hνTotal := measureReal_add_measureReal_compl (μ := ν) hA
      field_simp [hνAreal, hνAcreal]
      nlinarith [hμTotal, hνTotal]
    _ ≤ _ := hSum

@[blueprint "lem:balanced-error-mutual-information-lower-bound"
  (statement := /-- Let \(P\) be a probability measure on \(\mathcal M\times\mathcal X\), let \(Q=P_{\mathcal M}\otimes P_{\mathcal X}\) be the product of its marginals, let \(E\subseteq\mathcal M\times\mathcal X\) be measurable, and give \(P\) and \(Q\) equal prior probability in the associated binary testing problem. If the balanced average error satisfies
  \[
    \frac{P(E^{\mathsf c})+Q(E)}2\leq\alpha<\frac12,
  \]
  and the two directional errors are symmetric, in the sense that
  \[
    P(E^{\mathsf c})=Q(E),
  \]
  then
  \[
    D(P\Vert Q)\geq C_\alpha,
  \]
  where \(C_\alpha\) is the logarithmic classification capacity constant in
  \cref{def:classification-capacity-constant}. -/)
  (proof := /-- Put \(Q=P_{\mathcal M}\otimes P_{\mathcal X}\), and denote the common value \(P(E^{\mathsf c})=Q(E)\) by \(e\). The balanced-error hypothesis gives \(e\leq\alpha\). If \(\alpha<0\), this contradicts \(e\geq0\). If \(\alpha=0\), then \(e=0\), so \(P(E)=1\) and \(Q(E)=0\). Hence \(P\) is not absolutely continuous with respect to \(Q\), and therefore \(D(P\Vert Q)=+\infty=C_\alpha\) by \cref{def:classification-capacity-constant}.

  It remains to consider \(0<\alpha<1/2\). The binary-event
  Kullback--Leibler bound \cref{lem:binary-event-kl-divergence-lower-bound}
  applied to \(E\) and \(E^{\mathsf c}\) gives
  \[
    D(P\Vert Q)
      \geq D\bigl(\operatorname{Bernoulli}(1-e)
        \Vert\operatorname{Bernoulli}(e)\bigr)
      =(1-2e)\log\!\left(\frac{1-e}{e}\right).
  \]
  On \((0,1/2)\), the function
  \(t\mapsto(1-2t)\log((1-t)/t)\) is decreasing. Since
  \(e\leq\alpha<1/2\), with the case \(e=0\) again giving infinite
  divergence, the last display is at least
  \((1-2\alpha)\log((1-\alpha)/\alpha)=C_\alpha\) by
  \cref{def:classification-capacity-constant}. -/)
  (title := /-- Directed information bound under symmetric binary testing error -/)
  (latexEnv := "lemma")]
lemma balanced_error_mutual_information_lower_bound
    {M X : Type*} [MeasurableSpace M] [MeasurableSpace X]
    (P : Measure (M × X)) [IsProbabilityMeasure P]
    (E : Set (M × X)) (hE : MeasurableSet E) (α : ℝ) (hα : α < 1 / 2)
    (hSymmetricError :
      P Eᶜ = ((Measure.map Prod.fst P).prod (Measure.map Prod.snd P)) E)
    (hError : ((P Eᶜ).toReal +
      (((Measure.map Prod.fst P).prod (Measure.map Prod.snd P)) E).toReal) /
        2 ≤ α) :
    (InformationTheory.klDiv P
        ((Measure.map Prod.fst P).prod (Measure.map Prod.snd P)) : EReal) ≥
      classification_capacity_constant α := by
  let Q : Measure (M × X) :=
    (Measure.map Prod.fst P).prod (Measure.map Prod.snd P)
  letI : IsFiniteMeasure Q := by
    dsimp [Q]
    infer_instance
  have hFst : Measure.map Prod.fst P Set.univ = 1 := by
    rw [Measure.map_apply_of_aemeasurable (by fun_prop) MeasurableSet.univ]
    simp
  have hSnd : Measure.map Prod.snd P Set.univ = 1 := by
    rw [Measure.map_apply_of_aemeasurable (by fun_prop) MeasurableSet.univ]
    simp
  have hQUniv : Q Set.univ = 1 := by
    dsimp [Q]
    rw [Measure.prod_apply MeasurableSet.univ]
    simp [hFst, hSnd]
  letI : IsProbabilityMeasure Q := ⟨hQUniv⟩
  change (InformationTheory.klDiv P Q : EReal) ≥
    classification_capacity_constant α
  change P Eᶜ = Q E at hSymmetricError
  change ((P Eᶜ).toReal + (Q E).toReal) / 2 ≤ α at hError
  have hSymmetricReal : P.real Eᶜ = Q.real E :=
    congrArg ENNReal.toReal hSymmetricError
  have hError' : Q.real E ≤ α := by
    change P.real Eᶜ = Q.real E at hSymmetricReal
    change ((P.real Eᶜ + Q.real E) / 2 : ℝ) ≤ α at hError
    nlinarith
  by_cases hαNonpos : α ≤ 0
  · have hQEReal : Q.real E = 0 :=
      le_antisymm (hError'.trans hαNonpos) measureReal_nonneg
    have hQE : Q E = 0 :=
      (measureReal_eq_zero_iff (measure_ne_top Q E)).mp hQEReal
    have hPEc : P Eᶜ = 0 := hSymmetricError.trans hQE
    have hPE : P E = 1 := by
      have h := prob_add_prob_compl (μ := P) hE
      rwa [hPEc, add_zero] at h
    have hNotAC : ¬ P ≪ Q := by
      intro hAC
      have hPEZero := hAC hQE
      rw [hPE] at hPEZero
      exact one_ne_zero hPEZero
    rw [classification_capacity_constant, if_pos hαNonpos,
      InformationTheory.klDiv_of_not_ac hNotAC]
    simp
  · have hαPos : 0 < α := lt_of_not_ge hαNonpos
    rw [classification_capacity_constant, if_neg hαNonpos]
    by_cases hKLTop : InformationTheory.klDiv P Q = ⊤
    · simp [hKLTop]
    have hKLData := InformationTheory.klDiv_ne_top_iff.mp hKLTop
    have hQE : Q E ≠ 0 := by
      intro hQE
      have hPEc : P Eᶜ = 0 := hSymmetricError.trans hQE
      have hPE : P E = 1 := by
        have h := prob_add_prob_compl (μ := P) hE
        rwa [hPEc, add_zero] at h
      have hPEZero := hKLData.1 hQE
      rw [hPE] at hPEZero
      exact one_ne_zero hPEZero
    have hQEc : Q Eᶜ ≠ 0 := by
      intro hQEc
      have h := prob_add_prob_compl (μ := Q) hE
      rw [hQEc, add_zero] at h
      have hQEReal : Q.real E = 1 := by
        rw [measureReal_def, h]
        simp
      linarith
    have hBinary := binary_event_kl_divergence_lower_bound P Q E hE
      hKLData.1 hKLData.2 (by simp) hQE hQEc
    have hPEReal : P.real E = 1 - Q.real E := by
      have h := probReal_compl_eq_one_sub (μ := P) hE
      linarith
    have hQEcReal : Q.real Eᶜ = 1 - Q.real E :=
      probReal_compl_eq_one_sub hE
    rw [hPEReal, hSymmetricReal, hQEcReal] at hBinary
    have hQEPos : 0 < Q.real E := lt_of_le_of_ne measureReal_nonneg
      (Ne.symm ((measureReal_ne_zero_iff (measure_ne_top Q E)).2 hQE))
    have hQEcPos : 0 < 1 - Q.real E := by
      rw [← hQEcReal]
      exact lt_of_le_of_ne measureReal_nonneg
        (Ne.symm ((measureReal_ne_zero_iff (measure_ne_top Q Eᶜ)).2 hQEc))
    have hBinary' :
        (1 - 2 * Q.real E) *
            Real.log ((1 - Q.real E) / Q.real E) ≤
          (InformationTheory.klDiv P Q).toReal := by
      calc
        (1 - 2 * Q.real E) *
            Real.log ((1 - Q.real E) / Q.real E) =
            (1 - Q.real E) *
                Real.log ((1 - Q.real E) / Q.real E) +
              Q.real E * Real.log (Q.real E / (1 - Q.real E)) := by
          rw [Real.log_div (ne_of_gt hQEcPos) (ne_of_gt hQEPos),
            Real.log_div (ne_of_gt hQEPos) (ne_of_gt hQEcPos)]
          ring
        _ ≤ _ := hBinary
    have hRatioPos : 0 < (1 - α) / α := div_pos (by linarith) hαPos
    have hRatioEPos : 0 < (1 - Q.real E) / Q.real E :=
      div_pos hQEcPos hQEPos
    have hRatio :
        (1 - α) / α ≤ (1 - Q.real E) / Q.real E := by
      rw [div_le_div_iff₀ hαPos hQEPos]
      nlinarith
    have hLog :=
      Real.log_le_log hRatioPos hRatio
    have hLogENonneg :
        0 ≤ Real.log ((1 - Q.real E) / Q.real E) :=
      Real.log_nonneg ((one_le_div hQEPos).2 (by linarith))
    have hCoeffNonneg : 0 ≤ 1 - 2 * α := by linarith
    have hCoeff : 1 - 2 * α ≤ 1 - 2 * Q.real E := by linarith
    have hCapacity :
        (1 - 2 * α) * Real.log ((1 - α) / α) ≤
          (1 - 2 * Q.real E) *
            Real.log ((1 - Q.real E) / Q.real E) := by
      calc
        (1 - 2 * α) * Real.log ((1 - α) / α) ≤
            (1 - 2 * α) *
              Real.log ((1 - Q.real E) / Q.real E) :=
          mul_le_mul_of_nonneg_left hLog hCoeffNonneg
        _ ≤ _ := mul_le_mul_of_nonneg_right hCoeff hLogENonneg
    rw [show (InformationTheory.klDiv P Q : EReal) =
        ((InformationTheory.klDiv P Q).toReal : EReal) from
      (EReal.coe_ennreal_toReal hKLTop).symm]
    exact_mod_cast hCapacity.trans hBinary'

@[blueprint "lem:classification-error-information-bound"
  (statement := /-- Let \((\Omega,\mu)\) be a probability space, let \(\Theta\), \(\mathcal X\), \(\mathcal T\), and \(\mathcal M\) be measurable spaces, and fix an arbitrary map \(\vartheta:\Omega\to\Theta\). Let \(T:\Omega\to\mathcal T\) and \(X:\Omega\to\mathcal X\) be measurable, let \(\mathcal A:\mathcal T\rightsquigarrow\mathcal M\) be a learning algorithm, and let \(e:\mathcal M\to\mathcal X\to\{0,1\}\) have measurable uncurried evaluation map. Write \(\nu\) for the joint law of the original outcome and the output of \(\mathcal A\), as in \cref{def:learning-algorithm-joint-measure}. Suppose that \(\alpha<1/2\), that the balanced average classification error from \cref{def:classification-error} is at most \(\alpha\), and that
  \[
    \nu\{(\omega,z):e(z,X(\omega))=0\}
      =\bigl(\mathcal L_\nu(z)\otimes\mathcal L_\nu(X(\omega))\bigr)
        \{(z,x):e(z,x)=1\}.
  \]
  Then
  \[
    I_\nu(z;X(\omega))\geq C_\alpha,
  \]
  where \(C_\alpha=+\infty\) for \(\alpha\leq0\), while
  \[
    C_\alpha=(1-2\alpha)\log\!\left(\frac{1-\alpha}{\alpha}\right)
  \]
  for \(0<\alpha<1/2\). -/)
  (proof := /-- Let \(\nu\) be the probability measure from \cref{def:learning-algorithm-joint-measure}, define \(f(\omega,z)=(z,X(\omega))\), and let \(P=f_\#\nu\). The measurability hypotheses imply that \(f\) is measurable, so \(P\) is a probability measure. Set \(E=\{(z,x):e(z,x)=1\}\), which is measurable because the uncurried evaluation map is measurable. Composition of pushforwards identifies the two marginals of \(P\) with the \(z\)- and \(X(\omega)\)-marginals of \(\nu\), and pulling \(E^{\mathsf c}\) back through \(f\) identifies it with \(\{(\omega,z):e(z,X(\omega))=0\}\). Consequently, \cref{def:classification-error} turns the error hypothesis into
  \[
    \frac{P(E^{\mathsf c})+Q(E)}2\leq\alpha,
    \qquad Q=P_{\mathcal M}\otimes P_{\mathcal X},
  \]
  and the symmetry hypothesis becomes \(P(E^{\mathsf c})=Q(E)\). Thus \cref{lem:balanced-error-mutual-information-lower-bound} gives \(D(P\Vert Q)\geq C_\alpha\). This is the claimed inequality by \cref{def:mutual-information}. -/)
  (title := /-- Symmetric classification error forces test information -/)
  (latexEnv := "lemma")]
lemma classification_error_information_bound
    {Ω Θ X Train M : Type*} [MeasurableSpace Ω] [MeasurableSpace Θ]
    [MeasurableSpace X] [MeasurableSpace Train] [MeasurableSpace M]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (parameter : Ω → Θ) (training : Ω → Train)
    (test : Ω → X) (predict : M → X → Bool)
    (hTraining : Measurable training)
    (hTest : Measurable test)
    (hPredict : Measurable (fun pair : M × X => predict pair.1 pair.2))
    (algorithm : learning_algorithm Train M)
    (α : ℝ) (hα : α < 1 / 2)
    (hSymmetricError :
      let ν := learning_algorithm_joint_measure μ training hTraining algorithm
      ν {ωz | predict (Prod.snd ωz) (test ωz.1) = false} =
        ((Measure.map Prod.snd ν).prod
          (Measure.map (fun ωz => test ωz.1) ν))
            {pair | predict pair.1 pair.2 = true})
    (hError : classification_error
      (learning_algorithm_joint_measure μ training hTraining algorithm)
      Prod.snd (fun ωz => test ωz.1) predict ≤ α) :
    (mutual_information
        (learning_algorithm_joint_measure μ training hTraining algorithm)
        Prod.snd (fun ωz => test ωz.1) : EReal) ≥
      classification_capacity_constant α := by
  letI : ProbabilityTheory.IsMarkovKernel algorithm.kernel := algorithm.markov
  let ν : Measure (Ω × M) :=
    learning_algorithm_joint_measure μ training hTraining algorithm
  let f : Ω × M → M × X := fun ωz => (ωz.2, test ωz.1)
  have hf : Measurable f := by
    fun_prop
  let P : Measure (M × X) := Measure.map f ν
  letI : IsProbabilityMeasure ν := by
    dsimp [ν, learning_algorithm_joint_measure]
    infer_instance
  letI : IsProbabilityMeasure P := ⟨by
    dsimp [P]
    rw [Measure.map_apply_of_aemeasurable hf.aemeasurable MeasurableSet.univ]
    simp⟩
  let E : Set (M × X) := {pair | predict pair.1 pair.2 = true}
  have hE : MeasurableSet E := by
    dsimp [E]
    exact hPredict (MeasurableSet.singleton true)
  have hMapFst : Measure.map Prod.fst P = Measure.map Prod.snd ν := by
    dsimp [P]
    rw [Measure.map_map measurable_fst hf]
    rfl
  have hMapSnd : Measure.map Prod.snd P =
      Measure.map (fun ωz => test ωz.1) ν := by
    dsimp [P]
    rw [Measure.map_map measurable_snd hf]
    rfl
  have hPreimage : f ⁻¹' Eᶜ =
      {ωz | predict ωz.2 (test ωz.1) = false} := by
    ext ωz
    simp [E, f]
  have hPECompl : P Eᶜ =
      ν {ωz | predict ωz.2 (test ωz.1) = false} := by
    dsimp [P]
    rw [Measure.map_apply hf hE.compl, hPreimage]
  have hSymmetricErrorP :
      P Eᶜ = ((Measure.map Prod.fst P).prod (Measure.map Prod.snd P)) E := by
    rw [hPECompl, hMapFst, hMapSnd]
    simpa [ν, E] using hSymmetricError
  have hErrorP : ((P Eᶜ).toReal +
      (((Measure.map Prod.fst P).prod (Measure.map Prod.snd P)) E).toReal) /
        2 ≤ α := by
    rw [hPECompl, hMapFst, hMapSnd]
    simpa [classification_error, ν, E] using hError
  have hBound := balanced_error_mutual_information_lower_bound
    P E hE α hα hSymmetricErrorP hErrorP
  rw [hMapFst, hMapSnd] at hBound
  simpa [mutual_information, P, f, ν] using hBound

@[blueprint "lem:admissible-algorithm-memorization-bound"
  (statement := /-- Fix \(n\), \(\Psi\), and \(\theta\mapsto\mathcal P_\theta\). Assume that \(\Theta\) and \(\mathcal X\) are Hausdorff second-countable Borel spaces, that \(\mathcal X\) is nonempty, that \(\mathcal X^n\) is standard Borel, and that the finite measurable model-output space \(\mathcal M\) is countably generated and has measurable singletons. Let \((\theta,X_{1:n},X)\) obey \cref{def:learning-problem-sampling-law}. Under the two approximate-SDPI assumptions with \(0<\rho_n\), fix a measurable model evaluation map for the balanced binary classification experiment of the source. Let \(\alpha<1/2\), and let \(\mathcal A:\mathcal X^n\rightsquigarrow\mathcal M\) have balanced average classification error at most \(\alpha\), in the sense of \cref{def:classification-error}. Assume also that the false-negative probability of \(\mathcal A\) under the joint model--test law equals its false-positive probability under the product of the two marginals. Then, in the extended reals,
  \[
    \operatorname{mem}_n(\mathcal A,\mathbf P)
      \geq \frac{1-\tau_n}{\rho_n}C_\alpha
        -\operatorname{neg}_n.
  \]
  Here \(C_\alpha=+\infty\) for \(\alpha\leq0\), and
  \[
    C_\alpha=(1-2\alpha)\log\!\left(\frac{1-\alpha}{\alpha}\right)
  \]
  for \(0<\alpha<1/2\). -/)
  (proof := /-- Apply \cref{thm:excess-memorization-lower-bound} to \(\mathcal A\). The assumed equality of the two directional errors permits the application of \cref{lem:classification-error-information-bound}, which shows that the test-sample mutual information is at least \(C_\alpha\). The data-generation SDPI gives \(\tau_n\leq1\), and \(0<\rho_n\), so \((1-\tau_n)/\rho_n\) is nonnegative. Multiplication therefore preserves the information lower bound, and substitution gives the claimed pointwise estimate. -/)
  (title := /-- Pointwise bound for an admissible algorithm -/)
  (latexEnv := "lemma")]
lemma admissible_algorithm_memorization_bound
    {Ω Θ X : Type*} {M : Type} (n : ℕ) [MeasurableSpace Ω] [TopologicalSpace Θ]
    [MeasurableSpace Θ] [BorelSpace Θ] [SecondCountableTopology Θ] [T2Space Θ]
    [TopologicalSpace X] [MeasurableSpace X] [BorelSpace X]
    [SecondCountableTopology X] [T2Space X] [Nonempty X]
    [StandardBorelSpace (Fin n → X)] [MeasurableSpace M]
    [MeasurableSingletonClass M]
    [Finite M]
    [MeasurableSpace.CountablyGenerated M]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (Ψ : Measure Θ) (P : ProbabilityTheory.Kernel Θ X)
    (parameter : Ω → Θ) (training : Ω → Fin n → X) (test : Ω → X)
    (hSampling : learning_problem_sampling_law
      n μ Ψ P parameter training test)
    (predict : M → X → Bool)
    (hPredict : Measurable (fun pair : M × X => predict pair.1 pair.2))
    (τ ε ρ δ α : ℝ)
    (hData : approximate_strong_data_processing_inequality
      μ parameter training τ ε)
    (hTest : approximate_strong_data_processing_inequality
      μ test training ρ δ)
    (hρ : 0 < ρ)
    (hα : α < 1 / 2)
    (algorithm : learning_algorithm (Fin n → X) M)
    (hSymmetricError :
      let ν := learning_algorithm_joint_measure μ training hData.2.1 algorithm
      ν {ωz | predict (Prod.snd ωz) (test ωz.1) = false} =
        ((Measure.map Prod.snd ν).prod
          (Measure.map (fun ωz => test ωz.1) ν))
            {pair | predict pair.1 pair.2 = true})
    (hError : classification_error
      (learning_algorithm_joint_measure μ training hData.2.1 algorithm)
      Prod.snd (fun ωz => test ωz.1) predict ≤ α) :
    (excess_memorization μ parameter training hData.2.1 algorithm : EReal) ≥
      (((1 - τ) / ρ : ℝ) : EReal) *
        classification_capacity_constant α -
        excess_memorization_correction M τ ε ρ δ := by
  obtain ⟨κ, hκ, hLaw, hExact, hTV⟩ := hData.2.2.2.2
  have hτle : τ ≤ 1 := hExact.2.2.2.1
  have hCoeff : (0 : ℝ) ≤ (1 - τ) / ρ := div_nonneg (by linarith) hρ.le
  have hInfo := classification_error_information_bound (Θ := Θ)
    μ parameter training test predict hData.2.1 hTest.1 hPredict algorithm α hα
    hSymmetricError hError
  have hMem := excess_memorization_lower_bound n μ Ψ P parameter training test
    hSampling τ ε ρ δ hData hTest hρ algorithm
  refine le_trans (EReal.sub_le_sub ?_ le_rfl) hMem
  exact mul_le_mul_of_nonneg_left hInfo (EReal.coe_nonneg.mpr hCoeff)

@[blueprint "thm:minimal-necessary-memorization-lower-bound"
  (statement := /-- Fix \(n\in\mathbb N\), a parameter law \(\Psi\), and a conditional example kernel \(\theta\mapsto\mathcal P_\theta\). Assume that \(\Theta\) and \(\mathcal X\) are Hausdorff second-countable Borel spaces, that \(\mathcal X\) is nonempty, and that \(\mathcal X^n\) is standard Borel. Let \((\theta,X_{1:n},X)\) obey \cref{def:learning-problem-sampling-law}. Assume the coupling-based data-generation \((\tau_n,\epsilon_n)\)-approximate SDPI of \cref{def:approximate-strong-data-processing-inequality} and the coupling-based test/train \((\rho_n,\delta_n)\)-approximate SDPI of the same definition, with \(0<\rho_n\). Fix a measurable evaluation map for a finite, countably generated measurable model-output space \(\mathcal M\) whose singletons are measurable, and use the balanced labeled test distribution of the source. Assume that every possibly randomized algorithm \(\mathcal A:\mathcal X^n\rightsquigarrow\mathcal M\) whose balanced average classification error from \cref{def:classification-error} is at most \(\alpha\) has equal false-negative probability under the joint model--test law and false-positive probability under the product of its marginals. Take the infimum over all algorithms satisfying the error bound. For every \(\alpha<1/2\), the resulting minimal necessary memorization satisfies the extended-real bound
  \[
    \operatorname{mem}_n(\mathbf P,\alpha)
      \geq \frac{1-\tau_n}{\rho_n}C_\alpha
        -\operatorname{neg}_n.
  \]
  Here \(C_\alpha\) is the extended-real logarithmic capacity constant from
  \cref{def:classification-capacity-constant}: it equals \(+\infty\) for
  \(\alpha\leq0\), and
  \[
    (1-2\alpha)\log\!\left(\frac{1-\alpha}{\alpha}\right)
  \]
  for \(0<\alpha<1/2\). -/)
  (proof := /-- Expand the infimum in \cref{def:minimal-necessary-memorization}. For an algorithm whose balanced average classification error is at most \(\alpha\), the uniform symmetry hypothesis gives equality of its two directional testing errors. Hence \cref{lem:admissible-algorithm-memorization-bound} supplies the displayed common lower bound. For every other algorithm, the corresponding term of the infimum is \(+\infty\), which satisfies the same bound. Thus every term is bounded below by the displayed quantity, and taking their infimum proves the assertion. -/)
  (title := /-- Minimal necessary memorization from strong data processing -/)
  (latexEnv := "theorem")]
theorem minimal_necessary_memorization_lower_bound
    {Ω Θ X : Type*} {M : Type} (n : ℕ) [MeasurableSpace Ω] [TopologicalSpace Θ]
    [MeasurableSpace Θ] [BorelSpace Θ] [SecondCountableTopology Θ] [T2Space Θ]
    [TopologicalSpace X] [MeasurableSpace X] [BorelSpace X]
    [SecondCountableTopology X] [T2Space X] [Nonempty X]
    [StandardBorelSpace (Fin n → X)] [MeasurableSpace M]
    [MeasurableSingletonClass M]
    [Finite M]
    [MeasurableSpace.CountablyGenerated M]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (Ψ : Measure Θ) (P : ProbabilityTheory.Kernel Θ X)
    (parameter : Ω → Θ) (training : Ω → Fin n → X) (test : Ω → X)
    (hSampling : learning_problem_sampling_law
      n μ Ψ P parameter training test)
    (predict : M → X → Bool)
    (hPredict : Measurable (fun pair : M × X => predict pair.1 pair.2))
    (τ ε ρ δ α : ℝ)
    (hData : approximate_strong_data_processing_inequality
      μ parameter training τ ε)
    (hTest : approximate_strong_data_processing_inequality
      μ test training ρ δ)
    (hρ : 0 < ρ)
    (hα : α < 1 / 2)
    (hSymmetricError :
      ∀ algorithm : learning_algorithm (Fin n → X) M,
        let ν := learning_algorithm_joint_measure μ training hData.2.1 algorithm
        classification_error ν Prod.snd (fun ωz => test ωz.1) predict ≤ α →
          ν {ωz | predict (Prod.snd ωz) (test ωz.1) = false} =
            ((Measure.map Prod.snd ν).prod
              (Measure.map (fun ωz => test ωz.1) ν))
                {pair | predict pair.1 pair.2 = true}) :
    minimal_necessary_memorization (M := M) μ parameter training test
        hData.2.1 hTest.1 predict hPredict α ≥
      (((1 - τ) / ρ : ℝ) : EReal) *
        classification_capacity_constant α -
        excess_memorization_correction M τ ε ρ δ := by
  rw [ge_iff_le, minimal_necessary_memorization, le_iInf_iff]
  intro algorithm
  dsimp only
  split_ifs with hErr
  · exact admissible_algorithm_memorization_bound n μ Ψ P parameter training test
      hSampling predict hPredict τ ε ρ δ α hData hTest hρ hα algorithm
      (hSymmetricError algorithm hErr) hErr
  · exact le_top
