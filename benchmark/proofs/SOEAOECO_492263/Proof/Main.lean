        gamma_prime P * P.epsilon * P.diameter ^ 2 / 8 :=
      hsum_potential
    _ ≤ (P.dimension : ℝ) / (2 * gamma_prime P) *
          Real.log ratio +
        gamma_prime P * P.epsilon * P.diameter ^ 2 / 8 :=
      add_le_add hq_div_bound (le_refl _)
    _ = (P.dimension : ℝ) / (2 * gamma_prime P) *
          Real.log (1 +
            (P.conversionLoss ^ 2 * P.conversionGradient ^ 2 *
              P.gradientBound ^ 2 /
              ((P.dimension : ℝ) * P.epsilon)) * (T : ℝ)) +
        gamma_prime P * P.epsilon * P.diameter ^ 2 / 8 := by
      rfl

@[blueprint "lem:lightons-regret-missing"
  (statement := /-- Let $P$ satisfy every bounded-domain, bounded-gradient, exp-concavity, and parameter hypothesis in \cref{def:lightons-problem}; in particular, assume that the chosen within-domain gradient satisfies $\|\nabla f_t(x)\|\leq G$ for every $t\in\mathbb N$ and $x\in\mathcal X$.  Let $R$ satisfy the observable side conditions of \cref{def:lightons-run} and the LightONS initialization, update, output, and cost invariant \cref{def:is-lightons-run}.  Then, for every horizon $T\in\mathbb N$ and every comparator $u\in\mathcal X$,
  \[
    \operatorname{Reg}_T(u)\leq
    \frac{d}{2\gamma'}\log\left(1+
      \frac{c_f^2c_g^2G^2}{d\varepsilon}T\right)
      +\frac{\gamma'\varepsilon D^2}{8}.
  \] -/)
  (proof := /-- Apply the one-step exp-concave estimate \cref{lem:lightons-loss-step} at every round and sum it over $t<T$.  The resulting sum of surrogate linear losses minus their curvature corrections is bounded by \cref{lem:lightons-surrogate-regret}, which gives exactly the asserted expression from \cref{def:lightons-regret-bound}. -/)
  (title := /-- Missing LightONS regret derivation -/)
  (latexEnv := "lemma")]
lemma lightons_regret_missing (P : lightons_problem) (run : lightons_run P)
    (run_is_lightons : is_lightons_run P run) :
    ∀ (T : ℕ) (u : online_point P.dimension), u ∈ P.domain →
      online_regret P run T u ≤ lightons_regret_bound P T := by
  intro T u hu
  unfold online_regret
  calc
    ∑ t ∈ Finset.range T, (P.loss t (run.decision t) - P.loss t u) ≤
        ∑ t ∈ Finset.range T,
          (inner ℝ (P.conversionLoss • run.surrogateGradient t)
              (run.surrogatePoint t - u) -
            gamma_prime P / 2 *
              inner ℝ (P.conversionLoss • run.surrogateGradient t)
                (run.surrogatePoint t - u) ^ 2) := by
      exact Finset.sum_le_sum fun t ht => lightons_loss_step P run t u hu
    _ ≤ lightons_regret_bound P T :=
      lightons_surrogate_regret P run run_is_lightons T u hu

@[blueprint "lem:lightons-deferred-projection-cost"
  (statement := /-- Fix a problem $P$ satisfying \cref{def:lightons-problem}.  There is a constant $C_{\mathrm{proj}}(P)\geq0$, which may depend on the fixed fields of $P$, such that the following holds for every observable run $R$ as in \cref{def:lightons-run} satisfying the LightONS invariant \cref{def:is-lightons-run}.  For every integer $T\geq2$,
  \[
    \operatorname{runtime}(T)\leq
      \sum_{t<T}\bigl(\operatorname{cost}(\nabla g_t)
        +\mathrm{EP}_{\mathcal X}+d^2\bigr)
      +C_{\mathrm{proj}}(P)(k-1)^{-1}d^{\omega+1/2}
        \sqrt{T/\varepsilon}\log T.
  \]
  The witness is uniform in $R$ and $T$ once $P$ is fixed; its permitted dependence on $P$ includes dependence on $\gamma'$. -/)
  (proof := /-- Fix $P$ and unpack the update and cumulative-cost identities in \cref{def:is-lightons-run}.  For a run and time $t$, let $e_t$ be one when the unconstrained proposal $z_{t+1}$ lies outside $B(kD/2)$ and zero otherwise.  The update rule, the inclusion $\mathcal X\subseteq B(D/2)$, and the triangle inequality give
  \[
    \frac{(k-1)D}{2}e_t
      \leq \|z_{t+1}-y_t\|+\|y_t\|-\|y_{t+1}\|.
  \]
  Summing and using $y_0=0$ telescopes the radial terms, so the number of metric projections times $(k-1)D/2$ is at most the total proposal displacement.  Reconstruct the matrices $A_t$ from the metric recursion.  Completing the square in the proposal objective shows that
  $z_{t+1}-y_t=-(\gamma')^{-1}A_{t+1}^{-1}\bar g_t$; here positivity of $\gamma'$ is \cref{lem:lightons-gamma-prime-pos}.  Since $A_{t+1}\succeq\varepsilon I$, the squared displacement is at most $(\gamma')^{-2}\varepsilon^{-1}$ times the leverage score $\bar g_t^{\mathsf T}A_{t+1}^{-1}\bar g_t$.  Cauchy--Schwarz over $t<T$ then bounds total displacement by the square root of $T$ times the sum of these squared bounds.

  Apply the rank-one determinant identity \cref{lem:lightons-det-rank-one-sub} to the recursion $A_{t+1}=A_t+\bar g_t\bar g_t^{\mathsf T}$.  The resulting determinant potential telescopes, while the trace--determinant inequality and $\|\bar g_t\|\leq c_fc_gG$ bound the leverage-score sum through time $T$ by
  \[
    d\log\!\left(1+\frac{c_f^2c_g^2G^2}{d\varepsilon}T\right).
  \]
  Put $a=c_f^2c_g^2G^2/(d\varepsilon)$.  For $T\geq2$, one has
  \[
    \log(1+aT)\leq
      \left(1+\frac{\log(1+a)}{\log 2}\right)\log T
  \]
  and $\sqrt{\log T}\leq(\log T)/\sqrt{\log 2}$.  Combining these estimates with the telescoping radial charge yields
  \[
    \#\{t<T:\text{a metric projection occurs at }t\}
      \leq C_{\mathrm{proj}}(P)(k-1)^{-1}d^{1/2}
        \sqrt{T/\varepsilon}\log T
  \]
  for a finite nonnegative $C_{\mathrm{proj}}(P)$, with all factors involving the fixed positive quantities $D$ and $\gamma'$ absorbed into this witness.  Each such round contributes exactly $d^\omega$ beyond the baseline cost in the cumulative-cost identity of \cref{def:is-lightons-run}.  Multiplication by $d^\omega$ and addition of the baseline costs prove the asserted inequality, uniformly over $R$ and $T$. -/)
  (title := /-- Cost of deferred metric projections for fixed problem data -/)
  (latexEnv := "lemma")]
lemma lightons_deferred_projection_cost (P : lightons_problem) :
    ∃ C_projection : ℝ, 0 ≤ C_projection ∧
      ∀ run : lightons_run P,
        is_lightons_run P run →
        ∀ T : ℕ, 2 ≤ T →
          run.runtime T ≤
            (∑ t ∈ Finset.range T,
              (run.surrogateGradientRuntime t + P.projectionCost +
                (P.dimension : ℝ) ^ 2)) +
            C_projection * ((P.deferral - 1)⁻¹ *
              Real.rpow (P.dimension : ℝ) (P.matrixExponent + 0.5) *
              Real.sqrt ((T : ℝ) / P.epsilon) * Real.log (T : ℝ)) := by
  classical
  let a : ℝ :=
    P.conversionLoss ^ 2 * P.conversionGradient ^ 2 *
      P.gradientBound ^ 2 / ((P.dimension : ℝ) * P.epsilon)
  have hdimension_real_base : 0 < (P.dimension : ℝ) := by
    exact_mod_cast P.dimension_pos
  have ha_pos : 0 < a := by
    dsimp [a]
    exact div_pos
      (mul_pos
        (mul_pos
          (sq_pos_of_pos (lt_of_lt_of_le zero_lt_one P.one_le_conversionLoss))
          (sq_pos_of_pos (lt_of_lt_of_le zero_lt_one P.one_le_conversionGradient)))
        (sq_pos_of_pos P.gradientBound_pos))
      (mul_pos hdimension_real_base P.epsilon_pos)
  have hlog_two_pos : 0 < Real.log (2 : ℝ) := Real.log_pos (by norm_num)
  have hlog_one_add_a_pos : 0 < Real.log (1 + a) :=
    Real.log_pos (by linarith)
  let L : ℝ := 1 + Real.log (1 + a) / Real.log (2 : ℝ)
  have hL_pos : 0 < L := by
    dsimp [L]
    positivity
  let B : ℝ := L / Real.log (2 : ℝ)
  have hB_pos : 0 < B := by
    dsimp [B]
    positivity
  let K : ℝ := B + 1
  have hK_pos : 0 < K := by
    dsimp [K]
    linarith
  let C_projection : ℝ :=
    2 * K / (P.diameter * gamma_prime P)
  have hC_projection_nonneg : 0 ≤ C_projection := by
    dsimp [C_projection]
    exact (div_pos (mul_pos (by norm_num) hK_pos)
      (mul_pos P.diameter_pos (lightons_gamma_prime_pos P))).le
  refine ⟨C_projection, hC_projection_nonneg, ?_⟩
  intro run run_is_lightons T hT
  rcases run_is_lightons with ⟨metric, proposal, hy0, hmetric0, hmetric_succ,
    hproposal_min, hprojection, hdecision_projection, hruntime⟩
  let gv : ℕ → online_point P.dimension :=
    fun t => P.conversionLoss • run.surrogateGradient t
  let g : ℕ → Fin P.dimension → ℝ := fun t i => (gv t) i
  let A : ℕ → Matrix (Fin P.dimension) (Fin P.dimension) ℝ :=
    fun n => P.epsilon • 1 +
      ∑ t ∈ Finset.range n, Matrix.vecMulVec (g t) (g t)
  have hinner (v w : online_point P.dimension) :
      inner ℝ v w = (fun i => v i) ⬝ᵥ (fun i => w i) := by
    rw [EuclideanSpace.inner_eq_star_dotProduct]
    simp [dotProduct, mul_comm]
  have hA_succ (n : ℕ) :
      A (n + 1) = A n + Matrix.vecMulVec (g n) (g n) := by
    simp [A, Finset.sum_range_succ, add_assoc]
  have hdot_add (M N : Matrix (Fin P.dimension) (Fin P.dimension) ℝ)
      (v w : Fin P.dimension → ℝ) :
      v ⬝ᵥ ((M + N).mulVec w) =
        v ⬝ᵥ (M.mulVec w) + v ⬝ᵥ (N.mulVec w) := by
    simp [dotProduct, Matrix.mulVec, Finset.sum_add_distrib, mul_add, add_mul]
  have houter_dot (x v w : Fin P.dimension → ℝ) :
      v ⬝ᵥ ((Matrix.vecMulVec x x).mulVec w) =
        (x ⬝ᵥ v) * (x ⬝ᵥ w) := by
    rw [Matrix.dotProduct_mulVec, Matrix.vecMul_vecMulVec, smul_dotProduct]
    rw [dotProduct_comm v x]
    simp
  have hmetricA (n : ℕ) (v w : online_point P.dimension) :
      metric n v w =
        (fun i => v i) ⬝ᵥ ((A n).mulVec (fun i => w i)) := by
    induction n with
    | zero =>
        rw [hmetric0]
        simp [A, hinner, dotProduct, Matrix.mulVec, Matrix.one_apply,
          Finset.mul_sum, mul_comm]
        apply Finset.sum_congr rfl
        intro i hi
        ring
    | succ n ih =>
        rw [hmetric_succ n, ih, hA_succ]
        rw [hdot_add (A n) (Matrix.vecMulVec (g n) (g n))
          (fun i => v i) (fun i => w i)]
        rw [houter_dot]
        simp only [g]
        rw [← hinner, ← hinner]
  have houter_posSemidef (t : ℕ) :
      (Matrix.vecMulVec (g t) (g t)).PosSemidef := by
    apply Matrix.PosSemidef.of_dotProduct_mulVec_nonneg
    · ext i j
      simp [Matrix.IsHermitian, Matrix.conjTranspose_apply,
        Matrix.vecMulVec, mul_comm]
    · intro x
      simp only [star_trivial, dotProduct, Matrix.mulVec, Matrix.vecMulVec,
        Matrix.of_apply]
      have hs := sq_nonneg (∑ i, g t i * x i)
      convert hs using 1
      simp only [pow_two, Finset.sum_mul, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i hi
      apply Finset.sum_congr rfl
      intro j hj
      ring
  have hbase_posDef :
      (P.epsilon • (1 :
        Matrix (Fin P.dimension) (Fin P.dimension) ℝ)).PosDef := by
    apply Matrix.PosDef.of_dotProduct_mulVec_pos
    · ext i j
      simp [Matrix.IsHermitian, Matrix.conjTranspose_apply, Matrix.one_apply]
      by_cases hij : i = j
      · subst j
        simp
      · simp [hij, Ne.symm hij]
    · intro x hx
      obtain ⟨i, hi⟩ : ∃ i, x i ≠ 0 := by
        by_contra h
        push Not at h
        exact hx (funext h)
      simp [dotProduct, Matrix.mulVec, Matrix.smul_apply, Matrix.one_apply]
      have hterm : 0 < P.epsilon * x i ^ 2 :=
        mul_pos P.epsilon_pos (sq_pos_of_ne_zero hi)
      have hsum : 0 < ∑ j, P.epsilon * x j ^ 2 :=
        Finset.sum_pos' (fun j hj =>
          mul_nonneg P.epsilon_pos.le (sq_nonneg _))
          ⟨i, Finset.mem_univ i, hterm⟩
      rw [show (∑ j, x j * (P.epsilon * x j)) =
          ∑ j, P.epsilon * x j ^ 2 by
        apply Finset.sum_congr rfl
        intro j hj
        ring]
      exact hsum
  have hApos (n : ℕ) : (A n).PosDef := by
    dsimp [A]
    apply hbase_posDef.add_posSemidef
    apply Matrix.posSemidef_sum
    intro t ht
    exact houter_posSemidef t
  have hmetric_sum (n : ℕ) (v w : online_point P.dimension) :
      metric n v w = P.epsilon * inner ℝ v w +
        ∑ t ∈ Finset.range n, inner ℝ (gv t) v * inner ℝ (gv t) w := by
    induction n with
    | zero => simp [hmetric0]
    | succ n ih =>
        rw [hmetric_succ n, ih]
        simp [gv, Finset.sum_range_succ]
        ring
  have hmetric_sym (n : ℕ) (v w : online_point P.dimension) :
      metric n v w = metric n w v := by
    rw [hmetric_sum, hmetric_sum, real_inner_comm v w]
    congr 1
    apply Finset.sum_congr rfl
    intro t ht
    ring
  have hmetric_add_left (n : ℕ) (v w z : online_point P.dimension) :
      metric n (v + w) z = metric n v z + metric n w z := by
    simp [hmetric_sum, inner_add_left, inner_add_right,
      Finset.sum_add_distrib, add_mul]
    ring
  have hmetric_smul_left (n : ℕ) (c : ℝ) (v w : online_point P.dimension) :
      metric n (c • v) w = c * metric n v w := by
    rw [hmetric_sum, hmetric_sum, real_inner_smul_left]
    simp_rw [real_inner_smul_right]
    rw [mul_add, Finset.mul_sum]
    ring_nf
  have hmetric_add_right (n : ℕ) (v w z : online_point P.dimension) :
      metric n v (w + z) = metric n v w + metric n v z := by
    rw [hmetric_sym n v, hmetric_add_left,
      hmetric_sym n w v, hmetric_sym n z v]
  have hmetric_smul_right (n : ℕ) (c : ℝ) (v w : online_point P.dimension) :
      metric n v (c • w) = c * metric n v w := by
    rw [hmetric_sym n v, hmetric_smul_left, hmetric_sym n w v]
  have hmetric_neg_left (n : ℕ) (v w : online_point P.dimension) :
      metric n (-v) w = -metric n v w := by
    simpa using hmetric_smul_left n (-1) v w
  have hmetric_neg_right (n : ℕ) (v w : online_point P.dimension) :
      metric n v (-w) = -metric n v w := by
    simpa using hmetric_smul_right n (-1) v w
  have hmetric_sub_left (n : ℕ) (v w z : online_point P.dimension) :
      metric n (v - w) z = metric n v z - metric n w z := by
    rw [sub_eq_add_neg, hmetric_add_left, hmetric_neg_left, sub_eq_add_neg]
  have hmetric_sub_right (n : ℕ) (v w z : online_point P.dimension) :
      metric n v (w - z) = metric n v w - metric n v z := by
    rw [sub_eq_add_neg, hmetric_add_right, hmetric_neg_right, sub_eq_add_neg]
  have hmetric_square_sub (n : ℕ) (v w : online_point P.dimension) :
      metric n (v - w) (v - w) =
        metric n v v - 2 * metric n v w + metric n w w := by
    rw [hmetric_sub_left, hmetric_sub_right, hmetric_sub_right,
      hmetric_sym n w v]
    ring
  have hmetric_pos (n : ℕ) (v : online_point P.dimension) (hv : v ≠ 0) :
      0 < metric n v v := by
    rw [hmetric_sum]
    have hvv : 0 < inner ℝ v v := real_inner_self_pos.mpr hv
    have hs : 0 ≤ ∑ t ∈ Finset.range n,
        inner ℝ (gv t) v * inner ℝ (gv t) v :=
      Finset.sum_nonneg fun t ht => mul_self_nonneg _
    nlinarith [P.epsilon_pos]
  have hmetric_nonneg (n : ℕ) (v : online_point P.dimension) :
      0 ≤ metric n v v := by
    by_cases hv : v = 0
    · subst v
      simp [hmetric_sum]
    · exact (hmetric_pos n v hv).le
  let invg : ℕ → online_point P.dimension :=
    fun t => WithLp.toLp 2 ((A (t + 1))⁻¹.mulVec (g t))
  have hA_invg (t : ℕ) :
      (A (t + 1)).mulVec (fun i => (invg t) i) = g t := by
    simp only [invg]
    rw [Matrix.mulVec_mulVec]
    rw [Matrix.mul_nonsing_inv (A (t + 1))
      (isUnit_iff_ne_zero.mpr (ne_of_gt (hApos (t + 1)).det_pos))]
    simp
  have hmetric_invg (t : ℕ) (v : online_point P.dimension) :
      metric (t + 1) (invg t) v = inner ℝ (gv t) v := by
    rw [hmetric_sym, hmetricA, hA_invg]
    rw [hinner]
    simp [g]
    rw [dotProduct_comm]
  have hgamma_pos : 0 < gamma_prime P := lightons_gamma_prime_pos P
  have hgamma : gamma_prime P ≠ 0 := ne_of_gt hgamma_pos
  let zstar : ℕ → online_point P.dimension :=
    fun t => run.surrogatePoint t - (gamma_prime P)⁻¹ • invg t
  have hcomplete (t : ℕ) (z : online_point P.dimension) :
      inner ℝ (gv t) (z - run.surrogatePoint t) +
          gamma_prime P / 2 *
            metric (t + 1) (z - run.surrogatePoint t)
              (z - run.surrogatePoint t) =
        -(inner ℝ (gv t) (invg t)) / (2 * gamma_prime P) +
          gamma_prime P / 2 *
            metric (t + 1) (z - zstar t) (z - zstar t) := by
    have hz :
        z - run.surrogatePoint t =
          (z - zstar t) - (gamma_prime P)⁻¹ • invg t := by
      dsimp [zstar]
      module
    rw [hz, inner_sub_right, hmetric_square_sub]
    rw [real_inner_smul_right, hmetric_smul_right, hmetric_smul_left,
      hmetric_smul_right, hmetric_invg]
    rw [hmetric_sym (t + 1) (z - zstar t) (invg t), hmetric_invg]
    field_simp
    ring
  have hproposal_eq (t : ℕ) : proposal t = zstar t := by
    have hmin :
        inner ℝ (gv t) (proposal t - run.surrogatePoint t) +
            gamma_prime P / 2 *
              metric (t + 1) (proposal t - run.surrogatePoint t)
                (proposal t - run.surrogatePoint t) ≤
          inner ℝ (gv t) (zstar t - run.surrogatePoint t) +
            gamma_prime P / 2 *
              metric (t + 1) (zstar t - run.surrogatePoint t)
                (zstar t - run.surrogatePoint t) := by
      simpa [gv] using hproposal_min t (zstar t)
    rw [hcomplete, hcomplete] at hmin
    have hmin' :
        gamma_prime P / 2 *
          metric (t + 1) (proposal t - zstar t)
            (proposal t - zstar t) ≤ 0 := by
      simpa [hmetric_sum] using hmin
    have hmle :
        metric (t + 1) (proposal t - zstar t)
            (proposal t - zstar t) ≤ 0 := by
      exact nonpos_of_mul_nonpos_right hmin'
        (div_pos hgamma_pos (by norm_num))
    by_contra hne
    have hpos := hmetric_pos (t + 1) (proposal t - zstar t)
      (sub_ne_zero.mpr hne)
    linarith
  let q : ℕ → ℝ := fun t => inner ℝ (gv t) (invg t)
  have hq_nonneg (t : ℕ) : 0 ≤ q t := by
    dsimp [q]
    rw [← hmetric_invg t (invg t)]
    exact hmetric_nonneg (t + 1) (invg t)
  have hq_coord (t : ℕ) :
      q t = g t ⬝ᵥ ((A (t + 1))⁻¹.mulVec (g t)) := by
    dsimp [q, invg]
    rw [hinner]
  have hdet_step (t : ℕ) :
      (A t).det = (A (t + 1)).det * (1 - q t) := by
    have hsub :
        A t = A (t + 1) - Matrix.vecMulVec (g t) (g t) := by
      rw [hA_succ]
      abel
    rw [hsub, lightons_det_rank_one_sub (A (t + 1)) (hApos (t + 1))]
    rw [hq_coord]
  have hq_log (t : ℕ) :
      q t ≤ Real.log (A (t + 1)).det - Real.log (A t).det := by
    have hdet_t := (hApos t).det_pos
    have hdet_next := (hApos (t + 1)).det_pos
    have hstep_det := hdet_step t
    have hone : 0 < 1 - q t := by
      nlinarith
    have hlog := Real.log_le_sub_one_of_pos hone
    have hlog_step :
        Real.log (A t).det =
          Real.log (A (t + 1)).det + Real.log (1 - q t) := by
      rw [hstep_det, Real.log_mul (ne_of_gt hdet_next) (ne_of_gt hone)]
    linarith
  have hq_sum :
      (∑ t ∈ Finset.range T, q t) ≤
        Real.log (A T).det - Real.log (A 0).det := by
    calc
      (∑ t ∈ Finset.range T, q t) ≤
          ∑ t ∈ Finset.range T,
            (Real.log (A (t + 1)).det - Real.log (A t).det) := by
        apply Finset.sum_le_sum
        intro t ht
        exact hq_log t
      _ = Real.log (A T).det - Real.log (A 0).det := by
        exact Finset.sum_range_sub (fun n => Real.log (A n).det) T
  have hgv_norm (t : ℕ) :
      ‖gv t‖ ≤
        P.conversionLoss * P.conversionGradient * P.gradientBound := by
    have hcf : 0 ≤ P.conversionLoss :=
      le_trans zero_le_one P.one_le_conversionLoss
    have hcg : 0 ≤ P.conversionGradient :=
      le_trans zero_le_one P.one_le_conversionGradient
    have hlossgrad :=
      P.lossGradient_norm t (run.decision t) (run.decision_mem t)
    dsimp [gv]
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hcf]
    calc
      P.conversionLoss * ‖run.surrogateGradient t‖ ≤
          P.conversionLoss *
            (P.conversionGradient *
              ‖P.lossGradient t (run.decision t)‖) :=
        mul_le_mul_of_nonneg_left (run.surrogateGradient_norm t) hcf
      _ ≤ P.conversionLoss *
            (P.conversionGradient * P.gradientBound) := by
        gcongr
      _ = P.conversionLoss * P.conversionGradient *
            P.gradientBound := by ring
  have hg_sq (t : ℕ) :
      g t ⬝ᵥ g t ≤
        (P.conversionLoss * P.conversionGradient *
          P.gradientBound) ^ 2 := by
    have hbound_nonneg :
        0 ≤ P.conversionLoss * P.conversionGradient *
          P.gradientBound :=
      mul_nonneg
        (mul_nonneg
          (le_trans zero_le_one P.one_le_conversionLoss)
          (le_trans zero_le_one P.one_le_conversionGradient))
        P.gradientBound_pos.le
    have hsq :=
      (sq_le_sq₀ (norm_nonneg (gv t)) hbound_nonneg).mpr (hgv_norm t)
    rw [← real_inner_self_eq_norm_sq, hinner] at hsq
    exact hsq
  have htraceA :
      (A T).trace =
        (P.dimension : ℝ) * P.epsilon +
          ∑ t ∈ Finset.range T, g t ⬝ᵥ g t := by
    simp [A, Matrix.trace_add, Matrix.trace_smul, Matrix.trace_one,
      Matrix.trace_vecMulVec, Finset.sum_add_distrib]
    ring
  have htrace_bound :
      (A T).trace ≤
        (P.dimension : ℝ) * P.epsilon +
          (T : ℝ) *
            (P.conversionLoss * P.conversionGradient *
              P.gradientBound) ^ 2 := by
    rw [htraceA]
    gcongr
    calc
      (∑ t ∈ Finset.range T, g t ⬝ᵥ g t) ≤
          ∑ _t ∈ Finset.range T,
            (P.conversionLoss * P.conversionGradient *
              P.gradientBound) ^ 2 :=
        Finset.sum_le_sum fun t ht => hg_sq t
      _ = (T : ℝ) *
          (P.conversionLoss * P.conversionGradient *
            P.gradientBound) ^ 2 := by
        simp
  letI : Nonempty (Fin P.dimension) :=
    ⟨⟨0, P.dimension_pos⟩⟩
  let lambda : Fin P.dimension → ℝ :=
    (hApos T).isHermitian.eigenvalues
  have hlambda_pos (i : Fin P.dimension) : 0 < lambda i := by
    exact (hApos T).eigenvalues_pos i
  have hweight_pos :
      0 < ∑ i ∈ (Finset.univ : Finset (Fin P.dimension)), (1 : ℝ) := by
    simp
    exact_mod_cast P.dimension_pos
  have hamgm :
      (∏ i : Fin P.dimension, (lambda i) ^ (1 : ℝ)) ^
          ((P.dimension : ℝ)⁻¹) ≤
        (∑ i : Fin P.dimension, lambda i) / (P.dimension : ℝ) := by
    have hraw := Real.geom_mean_le_arith_mean
      (Finset.univ : Finset (Fin P.dimension))
      (fun _ : Fin P.dimension => (1 : ℝ)) lambda
      (fun i hi => zero_le_one) hweight_pos
      (fun i hi => (hlambda_pos i).le)
    simpa using hraw
  have hdet_lambda :
      (A T).det = ∏ i : Fin P.dimension, lambda i := by
    simpa [lambda] using (hApos T).isHermitian.det_eq_prod_eigenvalues
  have htrace_lambda :
      (A T).trace = ∑ i : Fin P.dimension, lambda i := by
    simpa [lambda] using
      (hApos T).isHermitian.trace_eq_sum_eigenvalues
  have hamgm_matrix :
      (A T).det ^ ((P.dimension : ℝ)⁻¹) ≤
        (A T).trace / (P.dimension : ℝ) := by
    rw [hdet_lambda, htrace_lambda]
    simpa using hamgm
  have hdimension_real : 0 < (P.dimension : ℝ) := by
    exact_mod_cast P.dimension_pos
  have haverage_pos :
      0 < (A T).trace / (P.dimension : ℝ) :=
    div_pos (hApos T).trace_pos hdimension_real
  have hlog_amgm :
      (P.dimension : ℝ)⁻¹ * Real.log (A T).det ≤
        Real.log ((A T).trace / (P.dimension : ℝ)) := by
    have hlog := (Real.log_le_log_iff
      (Real.rpow_pos_of_pos (hApos T).det_pos _) haverage_pos).mpr
      hamgm_matrix
    rw [Real.log_rpow (hApos T).det_pos] at hlog
    exact hlog
  let average : ℝ :=
    P.epsilon +
      (T : ℝ) *
        (P.conversionLoss * P.conversionGradient *
          P.gradientBound) ^ 2 / (P.dimension : ℝ)
  have haverage_bound :
      (A T).trace / (P.dimension : ℝ) ≤ average := by
    rw [div_le_iff₀ hdimension_real]
    dsimp [average]
    calc
      (A T).trace ≤
          (P.dimension : ℝ) * P.epsilon +
            (T : ℝ) *
              (P.conversionLoss * P.conversionGradient *
                P.gradientBound) ^ 2 := htrace_bound
      _ = (P.epsilon +
            (T : ℝ) *
              (P.conversionLoss * P.conversionGradient *
                P.gradientBound) ^ 2 / (P.dimension : ℝ)) *
          (P.dimension : ℝ) := by
        field_simp
  have haverage_target_pos : 0 < average := by
    dsimp [average]
    have hsecond : 0 ≤
        (T : ℝ) *
          (P.conversionLoss * P.conversionGradient *
            P.gradientBound) ^ 2 / (P.dimension : ℝ) := by positivity
    linarith [P.epsilon_pos]
  have hlog_average :
      Real.log ((A T).trace / (P.dimension : ℝ)) ≤
        Real.log average :=
    (Real.log_le_log_iff haverage_pos haverage_target_pos).mpr haverage_bound
  have hlogdet_upper :
      Real.log (A T).det ≤
        (P.dimension : ℝ) * Real.log average := by
    calc
      Real.log (A T).det =
          (P.dimension : ℝ) *
            ((P.dimension : ℝ)⁻¹ * Real.log (A T).det) := by
        field_simp
      _ ≤ (P.dimension : ℝ) *
          Real.log ((A T).trace / (P.dimension : ℝ)) :=
        mul_le_mul_of_nonneg_left hlog_amgm hdimension_real.le
      _ ≤ (P.dimension : ℝ) * Real.log average :=
        mul_le_mul_of_nonneg_left hlog_average hdimension_real.le
  have hdet_zero :
      (A 0).det = P.epsilon ^ P.dimension := by
    simp [A]
  have hlogdet_zero :
      Real.log (A 0).det =
        (P.dimension : ℝ) * Real.log P.epsilon := by
    rw [hdet_zero, Real.log_pow]
  let ratio : ℝ := 1 + a * (T : ℝ)
  have hratio_pos : 0 < ratio := by
    dsimp [ratio]
    positivity
  have haverage_eq : average = P.epsilon * ratio := by
    dsimp [average, ratio, a]
    field_simp [ne_of_gt P.epsilon_pos, ne_of_gt hdimension_real]
  have hlog_average_eq :
      Real.log average = Real.log P.epsilon + Real.log ratio := by
    rw [haverage_eq, Real.log_mul (ne_of_gt P.epsilon_pos)
      (ne_of_gt hratio_pos)]
  have hlogdet_ratio :
      Real.log (A T).det - Real.log (A 0).det ≤
        (P.dimension : ℝ) * Real.log ratio := by
    rw [hlogdet_zero]
    rw [hlog_average_eq] at hlogdet_upper
    linarith
  have hq_bound :
      (∑ t ∈ Finset.range T, q t) ≤
        (P.dimension : ℝ) * Real.log ratio :=
    hq_sum.trans hlogdet_ratio
  have hT_real : (2 : ℝ) ≤ (T : ℝ) := by
    exact_mod_cast hT
  have hlogT_ge_two :
      Real.log (2 : ℝ) ≤ Real.log (T : ℝ) :=
    Real.log_le_log (by norm_num) hT_real
  have hlogT_nonneg : 0 ≤ Real.log (T : ℝ) :=
    le_trans hlog_two_pos.le hlogT_ge_two
  have hratio_le :
      ratio ≤ (1 + a) * (T : ℝ) := by
    dsimp [ratio]
    nlinarith
  have hlog_ratio_add :
      Real.log ratio ≤ Real.log (1 + a) + Real.log (T : ℝ) := by
    calc
      Real.log ratio ≤ Real.log ((1 + a) * (T : ℝ)) :=
        Real.log_le_log hratio_pos hratio_le
      _ = Real.log (1 + a) + Real.log (T : ℝ) := by
        rw [Real.log_mul (by positivity) (by positivity)]
  have hlog_scaled :
      Real.log (1 + a) ≤
        Real.log (1 + a) / Real.log (2 : ℝ) * Real.log (T : ℝ) := by
    calc
      Real.log (1 + a) =
          (Real.log (1 + a) * Real.log (2 : ℝ)) /
            Real.log (2 : ℝ) := by field_simp
      _ ≤ (Real.log (1 + a) * Real.log (T : ℝ)) /
            Real.log (2 : ℝ) := by
        gcongr
      _ = Real.log (1 + a) / Real.log (2 : ℝ) *
            Real.log (T : ℝ) := by ring
  have hlog_ratio_bound :
      Real.log ratio ≤ L * Real.log (T : ℝ) := by
    calc
      Real.log ratio ≤
          Real.log (1 + a) + Real.log (T : ℝ) := hlog_ratio_add
      _ ≤ Real.log (1 + a) / Real.log (2 : ℝ) *
            Real.log (T : ℝ) + Real.log (T : ℝ) :=
        by linarith
      _ = L * Real.log (T : ℝ) := by
        dsimp [L]
        ring
  have hq_bound_log :
      (∑ t ∈ Finset.range T, q t) ≤
        (P.dimension : ℝ) * L * Real.log (T : ℝ) := by
    calc
      (∑ t ∈ Finset.range T, q t) ≤
          (P.dimension : ℝ) * Real.log ratio := hq_bound
      _ ≤ (P.dimension : ℝ) * (L * Real.log (T : ℝ)) :=
        mul_le_mul_of_nonneg_left hlog_ratio_bound hdimension_real.le
      _ = (P.dimension : ℝ) * L * Real.log (T : ℝ) := by ring
  let step : ℕ → ℝ :=
    fun t => ‖proposal t - run.surrogatePoint t‖
  have hstep_nonneg (t : ℕ) : 0 ≤ step t := norm_nonneg _
  have hstep_eq (t : ℕ) :
      step t = (gamma_prime P)⁻¹ * ‖invg t‖ := by
    dsimp [step]
    rw [hproposal_eq]
    dsimp [zstar]
    rw [show
      run.surrogatePoint t - (gamma_prime P)⁻¹ • invg t -
          run.surrogatePoint t =
        -((gamma_prime P)⁻¹ • invg t) by module]
    rw [norm_neg, norm_smul, Real.norm_eq_abs,
      abs_of_pos (inv_pos.mpr hgamma_pos)]
  have hepsilon_norm_le (t : ℕ) :
      P.epsilon * ‖invg t‖ ^ 2 ≤ q t := by
    calc
      P.epsilon * ‖invg t‖ ^ 2 =
          P.epsilon * inner ℝ (invg t) (invg t) := by
        rw [real_inner_self_eq_norm_sq]
      _ ≤ metric (t + 1) (invg t) (invg t) := by
        rw [hmetric_sum]
        exact le_add_of_nonneg_right
          (Finset.sum_nonneg fun s hs => mul_self_nonneg _)
      _ = q t := by
        rw [hmetric_invg]
  have hstep_sq (t : ℕ) :
      step t ^ 2 ≤
        (gamma_prime P)⁻¹ ^ 2 * (q t / P.epsilon) := by
    have hinvg_sq : ‖invg t‖ ^ 2 ≤ q t / P.epsilon :=
      (le_div_iff₀ P.epsilon_pos).2 (by
        simpa [mul_comm] using hepsilon_norm_le t)
    rw [hstep_eq]
    rw [mul_pow]
    exact mul_le_mul_of_nonneg_left hinvg_sq (sq_nonneg _)
  have hstep_sq_sum :
      (∑ t ∈ Finset.range T, step t ^ 2) ≤
        (gamma_prime P)⁻¹ ^ 2 / P.epsilon *
          ∑ t ∈ Finset.range T, q t := by
    calc
      (∑ t ∈ Finset.range T, step t ^ 2) ≤
          ∑ t ∈ Finset.range T,
            (gamma_prime P)⁻¹ ^ 2 * (q t / P.epsilon) :=
        Finset.sum_le_sum fun t ht => hstep_sq t
      _ = (gamma_prime P)⁻¹ ^ 2 / P.epsilon *
          ∑ t ∈ Finset.range T, q t := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro t ht
        ring
  have hcauchy :
      (∑ t ∈ Finset.range T, step t) ^ 2 ≤
        (T : ℝ) * ∑ t ∈ Finset.range T, step t ^ 2 := by
    simpa using
      (Finset.sum_mul_sq_le_sq_mul_sq
        (Finset.range T) (fun _ => (1 : ℝ)) step)
  have hL_log_sq :
      L * Real.log (T : ℝ) ≤
        B * Real.log (T : ℝ) ^ 2 := by
    have hmul :
        Real.log (2 : ℝ) * Real.log (T : ℝ) ≤
          Real.log (T : ℝ) * Real.log (T : ℝ) :=
      mul_le_mul_of_nonneg_right hlogT_ge_two hlogT_nonneg
    calc
      L * Real.log (T : ℝ) =
          (L / Real.log (2 : ℝ)) *
            (Real.log (2 : ℝ) * Real.log (T : ℝ)) := by
        field_simp
      _ ≤ (L / Real.log (2 : ℝ)) *
            (Real.log (T : ℝ) * Real.log (T : ℝ)) :=
        mul_le_mul_of_nonneg_left hmul (by positivity)
      _ = B * Real.log (T : ℝ) ^ 2 := by
        dsimp [B]
        ring
  have hB_le_K_sq : B ≤ K ^ 2 := by
    dsimp [K]
    nlinarith [sq_nonneg B]
  have hT_epsilon_nonneg : 0 ≤ (T : ℝ) / P.epsilon :=
    div_nonneg (Nat.cast_nonneg T) P.epsilon_pos.le
  have hdimension_nonneg : 0 ≤ (P.dimension : ℝ) :=
    hdimension_real.le
  have hsum_step_sq :
      (∑ t ∈ Finset.range T, step t) ^ 2 ≤
        ((gamma_prime P)⁻¹ * K * Real.sqrt (P.dimension : ℝ) *
          Real.sqrt ((T : ℝ) / P.epsilon) * Real.log (T : ℝ)) ^ 2 := by
    calc
      (∑ t ∈ Finset.range T, step t) ^ 2 ≤
          (T : ℝ) * ∑ t ∈ Finset.range T, step t ^ 2 := hcauchy
      _ ≤ (T : ℝ) *
          ((gamma_prime P)⁻¹ ^ 2 / P.epsilon *
            ∑ t ∈ Finset.range T, q t) :=
        mul_le_mul_of_nonneg_left hstep_sq_sum (Nat.cast_nonneg T)
      _ ≤ (T : ℝ) *
          ((gamma_prime P)⁻¹ ^ 2 / P.epsilon *
            ((P.dimension : ℝ) * L * Real.log (T : ℝ))) := by
        exact mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_left hq_bound_log
            (div_nonneg (sq_nonneg _) P.epsilon_pos.le))
          (Nat.cast_nonneg T)
      _ = ((gamma_prime P)⁻¹ ^ 2 *
          ((P.dimension : ℝ) * ((T : ℝ) / P.epsilon))) *
            (L * Real.log (T : ℝ)) := by ring
      _ ≤ ((gamma_prime P)⁻¹ ^ 2 *
          ((P.dimension : ℝ) * ((T : ℝ) / P.epsilon))) *
            (B * Real.log (T : ℝ) ^ 2) :=
        mul_le_mul_of_nonneg_left hL_log_sq (by positivity)
      _ ≤ ((gamma_prime P)⁻¹ ^ 2 *
          ((P.dimension : ℝ) * ((T : ℝ) / P.epsilon))) *
            (K ^ 2 * Real.log (T : ℝ) ^ 2) := by
        gcongr
      _ = ((gamma_prime P)⁻¹ * K * Real.sqrt (P.dimension : ℝ) *
          Real.sqrt ((T : ℝ) / P.epsilon) * Real.log (T : ℝ)) ^ 2 := by
        rw [show
          ((gamma_prime P)⁻¹ * K * Real.sqrt (P.dimension : ℝ) *
            Real.sqrt ((T : ℝ) / P.epsilon) * Real.log (T : ℝ)) ^ 2 =
            (gamma_prime P)⁻¹ ^ 2 * K ^ 2 *
              Real.sqrt (P.dimension : ℝ) ^ 2 *
              Real.sqrt ((T : ℝ) / P.epsilon) ^ 2 *
              Real.log (T : ℝ) ^ 2 by ring]
        rw [Real.sq_sqrt hdimension_nonneg, Real.sq_sqrt hT_epsilon_nonneg]
        ring
  have hsum_step_nonneg :
      0 ≤ ∑ t ∈ Finset.range T, step t :=
    Finset.sum_nonneg fun t ht => hstep_nonneg t
  have hstep_bound_nonneg :
      0 ≤ (gamma_prime P)⁻¹ * K * Real.sqrt (P.dimension : ℝ) *
        Real.sqrt ((T : ℝ) / P.epsilon) * Real.log (T : ℝ) := by
    positivity
  have hsum_step :
      (∑ t ∈ Finset.range T, step t) ≤
        (gamma_prime P)⁻¹ * K * Real.sqrt (P.dimension : ℝ) *
          Real.sqrt ((T : ℝ) / P.epsilon) * Real.log (T : ℝ) := by
    exact (sq_le_sq₀ hsum_step_nonneg hstep_bound_nonneg).mp hsum_step_sq
  let delta : ℝ := (P.deferral - 1) * P.diameter / 2
  have hdelta_pos : 0 < delta := by
    dsimp [delta]
    exact div_pos
      (mul_pos (sub_pos.mpr P.one_lt_deferral) P.diameter_pos)
      (by norm_num)
  let indicator : ℕ → ℝ := fun t =>
    if ‖proposal t‖ ≤ P.deferral * P.diameter / 2 then 0 else 1
  have hcharge (t : ℕ) :
      delta * indicator t ≤
        step t +
          (‖run.surrogatePoint t‖ - ‖run.surrogatePoint (t + 1)‖) := by
    by_cases hinside :
        ‖proposal t‖ ≤ P.deferral * P.diameter / 2
    · have hnext : run.surrogatePoint (t + 1) = proposal t := by
        simpa [hinside] using hprojection t
      have htriangle :=
        norm_add_le (proposal t - run.surrogatePoint t)
          (run.surrogatePoint t)
      rw [show proposal t - run.surrogatePoint t +
          run.surrogatePoint t = proposal t by module] at htriangle
      dsimp [indicator]
      rw [if_pos hinside, mul_zero, hnext]
      dsimp [step]
      linarith
    · obtain ⟨hnext_mem, hproj⟩ := by
        simpa [hinside] using hprojection t
      have hproposal_out :
          P.deferral * P.diameter / 2 < ‖proposal t‖ :=
        lt_of_not_ge hinside
      have hnext_norm :=
        P.domain_radius (run.surrogatePoint (t + 1)) hnext_mem
      have htriangle :=
        norm_add_le (proposal t - run.surrogatePoint t)
          (run.surrogatePoint t)
      rw [show proposal t - run.surrogatePoint t +
          run.surrogatePoint t = proposal t by module] at htriangle
      dsimp [indicator]
      rw [if_neg hinside, mul_one]
      dsimp [delta, step]
      linarith
  have hcharge_sum :
      delta * (∑ t ∈ Finset.range T, indicator t) ≤
        ∑ t ∈ Finset.range T, step t := by
    calc
      delta * (∑ t ∈ Finset.range T, indicator t) =
          ∑ t ∈ Finset.range T, delta * indicator t := by
        rw [Finset.mul_sum]
      _ ≤ ∑ t ∈ Finset.range T,
          (step t +
            (‖run.surrogatePoint t‖ -
              ‖run.surrogatePoint (t + 1)‖)) :=
        Finset.sum_le_sum fun t ht => hcharge t
      _ = (∑ t ∈ Finset.range T, step t) +
          (‖run.surrogatePoint 0‖ - ‖run.surrogatePoint T‖) := by
        rw [Finset.sum_add_distrib, Finset.sum_range_sub']
      _ ≤ ∑ t ∈ Finset.range T, step t := by
        rw [hy0, norm_zero]
        linarith [norm_nonneg (run.surrogatePoint T)]
  have hindicator_bound :
      (∑ t ∈ Finset.range T, indicator t) ≤
        delta⁻¹ * ∑ t ∈ Finset.range T, step t := by
    have hdiv :
        (∑ t ∈ Finset.range T, indicator t) ≤
          (∑ t ∈ Finset.range T, step t) / delta :=
      (le_div_iff₀ hdelta_pos).2 (by
        simpa [mul_comm] using hcharge_sum)
    calc
      (∑ t ∈ Finset.range T, indicator t) ≤
          (∑ t ∈ Finset.range T, step t) / delta := hdiv
      _ = delta⁻¹ * ∑ t ∈ Finset.range T, step t := by
        rw [div_eq_mul_inv]
        ring
  let matrixCost : ℝ :=
    Real.rpow (P.dimension : ℝ) P.matrixExponent
  have hmatrixCost_nonneg : 0 ≤ matrixCost := by
    dsimp [matrixCost]
    positivity
  have hextra_eq :
      (∑ t ∈ Finset.range T,
        if ‖proposal t‖ ≤ P.deferral * P.diameter / 2 then 0
        else Real.rpow (P.dimension : ℝ) P.matrixExponent) =
        matrixCost * ∑ t ∈ Finset.range T, indicator t := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro t ht
    by_cases hinside :
        ‖proposal t‖ ≤ P.deferral * P.diameter / 2
    · simp [indicator, matrixCost, hinside]
    · simp [indicator, matrixCost, hinside]
  have hsqrt_dimension :
      Real.sqrt (P.dimension : ℝ) =
        Real.rpow (P.dimension : ℝ) 0.5 := by
    rw [Real.sqrt_eq_rpow]
    norm_num
  have hextra :
      (∑ t ∈ Finset.range T,
        if ‖proposal t‖ ≤ P.deferral * P.diameter / 2 then 0
        else Real.rpow (P.dimension : ℝ) P.matrixExponent) ≤
        C_projection * ((P.deferral - 1)⁻¹ *
          Real.rpow (P.dimension : ℝ) (P.matrixExponent + 0.5) *
          Real.sqrt ((T : ℝ) / P.epsilon) * Real.log (T : ℝ)) := by
    calc
      (∑ t ∈ Finset.range T,
        if ‖proposal t‖ ≤ P.deferral * P.diameter / 2 then 0
        else Real.rpow (P.dimension : ℝ) P.matrixExponent) =
          matrixCost * ∑ t ∈ Finset.range T, indicator t := hextra_eq
      _ ≤ matrixCost *
          (delta⁻¹ * ∑ t ∈ Finset.range T, step t) :=
        mul_le_mul_of_nonneg_left hindicator_bound hmatrixCost_nonneg
      _ ≤ matrixCost *
          (delta⁻¹ *
            ((gamma_prime P)⁻¹ * K * Real.sqrt (P.dimension : ℝ) *
              Real.sqrt ((T : ℝ) / P.epsilon) *
                Real.log (T : ℝ))) := by
        gcongr
      _ = C_projection * ((P.deferral - 1)⁻¹ *
          Real.rpow (P.dimension : ℝ) (P.matrixExponent + 0.5) *
          Real.sqrt ((T : ℝ) / P.epsilon) *
            Real.log (T : ℝ)) := by
        dsimp [matrixCost, delta, C_projection]
        rw [Real.rpow_add hdimension_real,
          hsqrt_dimension]
        field_simp [ne_of_gt P.diameter_pos, hgamma,
          ne_of_gt (sub_pos.mpr P.one_lt_deferral)]
        ac_rfl
  rw [hruntime T]
  calc
    (∑ t ∈ Finset.range T,
      (run.surrogateGradientRuntime t + P.projectionCost +
        (P.dimension : ℝ) ^ 2 +
        if ‖proposal t‖ ≤ P.deferral * P.diameter / 2 then 0
        else Real.rpow (P.dimension : ℝ) P.matrixExponent)) =
        (∑ t ∈ Finset.range T,
          (run.surrogateGradientRuntime t + P.projectionCost +
            (P.dimension : ℝ) ^ 2)) +
          (∑ t ∈ Finset.range T,
            if ‖proposal t‖ ≤ P.deferral * P.diameter / 2 then 0
            else Real.rpow (P.dimension : ℝ) P.matrixExponent) := by
      rw [Finset.sum_add_distrib]
    _ ≤ (∑ t ∈ Finset.range T,
          (run.surrogateGradientRuntime t + P.projectionCost +
            (P.dimension : ℝ) ^ 2)) +
        C_projection * ((P.deferral - 1)⁻¹ *
          Real.rpow (P.dimension : ℝ) (P.matrixExponent + 0.5) *
          Real.sqrt ((T : ℝ) / P.epsilon) *
            Real.log (T : ℝ)) :=
      add_le_add (le_refl _) hextra

@[blueprint "lem:lightons-runtime-missing"
  (statement := /-- Fix a surrogate-gradient cost factor $C_{\mathrm{grad}}\geq0$ and a problem $P$ satisfying \cref{def:lightons-problem}.  There exists a constant $C_{\mathrm{proj}}(P)\geq0$, which may depend on $P$ but not on the run or horizon, with the following property.  For every observable run $R$ as in \cref{def:lightons-run} for which
  \[
    \operatorname{cost}(\nabla g_t)
      \leq C_{\mathrm{grad}}(\mathrm{EP}_{\mathcal X}+d)
      \qquad(t\in\mathbb N),
  \]
  and every LightONS invariant \cref{def:is-lightons-run}, one has, for every integer $T\geq2$,
  \[
    \operatorname{runtime}(T)\leq
      (C_{\mathrm{grad}}+C_{\mathrm{proj}}(P)+1)
      \left((\mathrm{EP}_{\mathcal X}+d^2)T
        +(k-1)^{-1}d^{\omega+1/2}
          \sqrt{T/\varepsilon}\log T\right).
  \]
  Here $C_{\mathrm{grad}}$ remains fixed before $P$, whereas $C_{\mathrm{proj}}(P)$ is chosen after the problem data. -/)
  (proof := /-- Fix $C_{\mathrm{grad}}\geq0$ and $P$, and choose $C_{\mathrm{proj}}(P)$ from \cref{lem:lightons-deferred-projection-cost}.  Now fix $R$.  Since $d\geq1$ and $\mathrm{EP}_{\mathcal X}\geq0$, one has
  \[
    C_{\mathrm{grad}}(\mathrm{EP}_{\mathcal X}+d)
      +\mathrm{EP}_{\mathcal X}+d^2
      \leq (C_{\mathrm{grad}}+1)
        (\mathrm{EP}_{\mathcal X}+d^2).
  \]
  Summing this inequality over $t<T$ bounds the baseline sum in \cref{lem:lightons-deferred-projection-cost}.  Its deferred-projection term is at most $C_{\mathrm{proj}}$ times the second summand of \cref{def:lightons-runtime-scale}.  Both summands of that scale are nonnegative for $T\geq2$.  Adding the two estimates and enlarging their coefficients to the common value $C_{\mathrm{grad}}+C_{\mathrm{proj}}+1$ gives the claimed bound. -/)
  (title := /-- LightONS runtime bound from deferred projections -/)
  (latexEnv := "lemma")]
lemma lightons_runtime_missing :
    ∀ C_gradient : ℝ, 0 ≤ C_gradient →
      ∀ P : lightons_problem,
        ∃ C_projection : ℝ, 0 ≤ C_projection ∧
          ∀ run : lightons_run P,
          (∀ t : ℕ, run.surrogateGradientRuntime t ≤
            C_gradient * (P.projectionCost + (P.dimension : ℝ))) →
          is_lightons_run P run →
          ∀ T : ℕ, 2 ≤ T →
            run.runtime T ≤
              (C_gradient + C_projection + 1) * lightons_runtime_scale P T := by
  intro C_gradient hC_gradient P
  obtain ⟨C_projection, hC_projection, hprojection⟩ :=
    lightons_deferred_projection_cost P
  refine ⟨C_projection, hC_projection, ?_⟩
  intro run hgradient hrun T hT
  have hdimension : (1 : ℝ) ≤ (P.dimension : ℝ) := by
    exact_mod_cast P.dimension_pos
  have hdimension_sq :
      (P.dimension : ℝ) ≤ (P.dimension : ℝ) ^ 2 := by
    nlinarith
  have hterm (t : ℕ) :
      run.surrogateGradientRuntime t + P.projectionCost +
            (P.dimension : ℝ) ^ 2 ≤
        (C_gradient + 1) *
          (P.projectionCost + (P.dimension : ℝ) ^ 2) := by
    have ht := hgradient t
    have hproduct :
        0 ≤ C_gradient *
          ((P.dimension : ℝ) ^ 2 - (P.dimension : ℝ)) :=
      mul_nonneg hC_gradient (sub_nonneg.mpr hdimension_sq)
    nlinarith
  have hbaseline :
      (∑ t ∈ Finset.range T,
        (run.surrogateGradientRuntime t + P.projectionCost +
          (P.dimension : ℝ) ^ 2)) ≤
        (C_gradient + 1) *
          ((P.projectionCost + (P.dimension : ℝ) ^ 2) * (T : ℝ)) := by
    calc
      _ ≤ ∑ t ∈ Finset.range T,
          ((C_gradient + 1) *
            (P.projectionCost + (P.dimension : ℝ) ^ 2)) :=
        Finset.sum_le_sum fun t _ => hterm t
      _ = _ := by
        simp
        ring
  have hT_one : (1 : ℝ) ≤ (T : ℝ) := by
    exact_mod_cast (le_trans (by omega : 1 ≤ 2) hT)
  have hlog : 0 ≤ Real.log (T : ℝ) := Real.log_nonneg hT_one
  have hbase_factor_nonneg :
      0 ≤ P.projectionCost + (P.dimension : ℝ) ^ 2 :=
    add_nonneg P.projectionCost_nonneg (sq_nonneg _)
  have hbase_nonneg :
      0 ≤ (P.projectionCost + (P.dimension : ℝ) ^ 2) * (T : ℝ) :=
    mul_nonneg hbase_factor_nonneg (Nat.cast_nonneg T)
  have hdeferral_inv : 0 ≤ (P.deferral - 1)⁻¹ :=
    inv_nonneg.mpr (sub_nonneg.mpr P.one_lt_deferral.le)
  have hdimension_nonneg : 0 ≤ (P.dimension : ℝ) := by
    linarith
  have hdimension_rpow :
      0 ≤ Real.rpow (P.dimension : ℝ) (P.matrixExponent + 0.5) :=
    Real.rpow_nonneg hdimension_nonneg _
  have hsqrt : 0 ≤ Real.sqrt ((T : ℝ) / P.epsilon) :=
    Real.sqrt_nonneg _
  have hdeferred_nonneg :
      0 ≤ (P.deferral - 1)⁻¹ *
        Real.rpow (P.dimension : ℝ) (P.matrixExponent + 0.5) *
        Real.sqrt ((T : ℝ) / P.epsilon) * Real.log (T : ℝ) :=
    mul_nonneg
      (mul_nonneg (mul_nonneg hdeferral_inv hdimension_rpow) hsqrt) hlog
  have hruntime := hprojection run hrun T hT
  rw [lightons_runtime_scale]
  calc
    run.runtime T ≤
        (∑ t ∈ Finset.range T,
          (run.surrogateGradientRuntime t + P.projectionCost +
            (P.dimension : ℝ) ^ 2)) +
          C_projection * ((P.deferral - 1)⁻¹ *
            Real.rpow (P.dimension : ℝ) (P.matrixExponent + 0.5) *
            Real.sqrt ((T : ℝ) / P.epsilon) * Real.log (T : ℝ)) := hruntime
    _ ≤ (C_gradient + 1) *
          ((P.projectionCost + (P.dimension : ℝ) ^ 2) * (T : ℝ)) +
        C_projection * ((P.deferral - 1)⁻¹ *
          Real.rpow (P.dimension : ℝ) (P.matrixExponent + 0.5) *
          Real.sqrt ((T : ℝ) / P.epsilon) * Real.log (T : ℝ)) :=
      add_le_add hbaseline (le_refl _)
    _ ≤ (C_gradient + 1) *
          (((P.projectionCost + (P.dimension : ℝ) ^ 2) * (T : ℝ)) +
            ((P.deferral - 1)⁻¹ *
              Real.rpow (P.dimension : ℝ) (P.matrixExponent + 0.5) *
              Real.sqrt ((T : ℝ) / P.epsilon) * Real.log (T : ℝ))) +
        C_projection *
          (((P.projectionCost + (P.dimension : ℝ) ^ 2) * (T : ℝ)) +
            ((P.deferral - 1)⁻¹ *
              Real.rpow (P.dimension : ℝ) (P.matrixExponent + 0.5) *
              Real.sqrt ((T : ℝ) / P.epsilon) * Real.log (T : ℝ))) := by
      exact add_le_add
        (mul_le_mul_of_nonneg_left
          (le_add_of_nonneg_right hdeferred_nonneg) (by linarith))
        (mul_le_mul_of_nonneg_left
          (le_add_of_nonneg_left hbase_nonneg) hC_projection)
    _ = (C_gradient + C_projection + 1) *
        (((P.projectionCost + (P.dimension : ℝ) ^ 2) * (T : ℝ)) +
          (P.deferral - 1)⁻¹ *
            Real.rpow (P.dimension : ℝ) (P.matrixExponent + 0.5) *
            Real.sqrt ((T : ℝ) / P.epsilon) * Real.log (T : ℝ)) := by
      ring

@[blueprint "thm:lightons"
  (statement := /-- Fix a surrogate-gradient cost factor $C_{\mathrm{grad}}\geq0$ and a problem $P$ satisfying all the hypotheses in \cref{def:lightons-problem}.  There exists a constant $C_{\mathrm{proj}}\geq0$, which may depend on $C_{\mathrm{grad}}$ and $P$ but not on the run or horizon, with the following property.  For every observable run $R$ as in \cref{def:lightons-run}, assume the uniform cost bound
  \[
    \operatorname{cost}(\nabla g_t)
      \leq C_{\mathrm{grad}}(\mathrm{EP}_{\mathcal X}+d)
      \qquad(t\in\mathbb N),
  \]
  and the LightONS initialization, update, output, and cost invariant in \cref{def:is-lightons-run}.  Then, with $\gamma'$ defined by \cref{def:gamma-prime}, for every $T\in\mathbb N$ and every $u\in\mathcal X$,
  \[
    \operatorname{Reg}_T(u)\leq
      \frac{d}{2\gamma'}\log\left(1+
        \frac{c_f^2c_g^2G^2}{d\varepsilon}T\right)
        +\frac{\gamma'\varepsilon D^2}{8},
  \]
  and, for every integer $T\geq2$, its cumulative arithmetic runtime satisfies
  \[
    \operatorname{runtime}(T)\leq
      (C_{\mathrm{grad}}+C_{\mathrm{proj}}+1)
      \left((\mathrm{EP}_{\mathcal X}+d^2)T
        +(k-1)^{-1}d^{\omega+1/2}
          \sqrt{T/\varepsilon}\log T\right).
  \] -/)
  (proof := /-- Fix $C_{\mathrm{grad}}\geq0$ and $P$, and choose the nonnegative constant $C_{\mathrm{proj}}$ supplied by \cref{lem:lightons-runtime-missing}; this choice is made before the run and horizon.  For any run satisfying the uniform surrogate-gradient cost hypothesis and the LightONS invariant, \cref{lem:lightons-regret-missing} gives the regret inequality for every horizon and comparator, and \cref{lem:lightons-runtime-missing}, with the same constant $C_{\mathrm{proj}}$, gives the runtime inequality for every $T\geq2$.  Combining these two conclusions proves the required conjunction. -/)
  (title := /-- LightONS regret and runtime guarantee -/)
  (latexEnv := "theorem")]
theorem lightons :
    ∀ C_gradient : ℝ, 0 ≤ C_gradient →
      ∀ P : lightons_problem,
        ∃ C_projection : ℝ, 0 ≤ C_projection ∧
          ∀ run : lightons_run P,
          (∀ t : ℕ, run.surrogateGradientRuntime t ≤
            C_gradient * (P.projectionCost + (P.dimension : ℝ))) →
          is_lightons_run P run →
          (∀ (T : ℕ) (u : online_point P.dimension), u ∈ P.domain →
            online_regret P run T u ≤ lightons_regret_bound P T) ∧
          ∀ T : ℕ, 2 ≤ T →
            run.runtime T ≤
              (C_gradient + C_projection + 1) * lightons_runtime_scale P T := by
  intro C_gradient hC_gradient P
  obtain ⟨C_projection, hC_projection, hruntime⟩ :=
    lightons_runtime_missing C_gradient hC_gradient P
  refine ⟨C_projection, hC_projection, ?_⟩
  intro run hgradient hrun
  exact ⟨lightons_regret_missing P run hrun, hruntime run hgradient hrun⟩
