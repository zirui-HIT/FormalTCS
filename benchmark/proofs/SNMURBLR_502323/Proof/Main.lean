    have hnum := quartic_leverage_rate_algebra_local B Ccov η
      hT hd hKpos hBpos.le hC hη hη1 hKupper qfun hqfun hcard
    change (∑ t, self_normalized_leverage X U t z.1) ≤
      10 * (B + 1) * (Real.sqrt ((d : ℝ) * Ccov * (T : ℝ) *
        Real.log (2 * (T : ℝ) / η)) + Real.log (2 / η))
    simpa only [qfun] using hnum
  change ENNReal.ofReal (1 - η) ≤ μ Target
  calc
    ENNReal.ofReal (1 - η) ≤ γ E := hEprob
    _ ≤ γ ((fun z : Ω × (Fin (T * K) → Fin d → ℝ) => z.1) ⁻¹' Target) :=
      MeasureTheory.measure_mono hsubset
    _ = MeasureTheory.Measure.map
        (fun z : Ω × (Fin (T * K) → Fin d → ℝ) => z.1) γ Target := by
      rw [MeasureTheory.Measure.map_apply measurable_fst hTargetMeas]
    _ = μ Target := by rw [hmap]

@[blueprint "lem:self-normalized-smoothness-source-gap"
  (statement := /-- There is an absolute constant (C>0) such that the
  following holds.  Let (T,d\in\mathbb N) be positive, let
  ((\Omega,\mathcal F,\mu)) be a probability space, and let
  ((\mathcal F_n)_{n\geq0}) be a filtration.  Let
  (X_t:\Omega\to\mathbb R^d) be (\mathcal F_t)-measurable and let
  (Y_t:\Omega\to\mathbb R) be (\mathcal F_{t+1})-measurable for every
  (t<T).  Suppose that ((Y_t)_{t<T}) is conditionally sub-Gaussian with
  parameter (\sigma>0) relative to ((\mathcal F_n)_{n\geq0}), in the
  sense of \cref{def:conditionally-subgaussian-noise}.

  Let ((\mathcal H_n^x)_{n\geq0}) be the filtration generated at time
  (n) by ((X_s)_{s<n}), and assume
  (\mathcal H_n^x\subseteq\mathcal F_n) for every (n).  For each
  (t<T), let (P_t) be a probability kernel giving the conditional law
  of (X_t) given (\mathcal H_t^x).  Suppose that, for a probability
  measure (\mu_0) on (\mathbb R^d) and a constant
  (C_{\mathrm{cov}}\geq1),
  (P_t(\omega,\cdot)\leq C_{\mathrm{cov}}\mu_0) for every (t<T) and
  (\omega\in\Omega).

  For any pointwise Moore--Penrose inverse (V_T^\dagger) of
  (V_T=\sum_{t<T}X_tX_t^{\mathsf T}) and every
  (\delta\in(0,1)), one has
  [
    \mu\!\left\{\omega:
      \lVert S_T(\omega)\rVert_{V_T^\dagger(\omega)}^2
      \leq C\sigma^2\left(
        \sqrt{dC_{\mathrm{cov}}T\log(2T/\delta)}
        +\log(2/\delta)\right)\right\}\geq1-\delta,
  ]
  where (S_T=\sum_{t<T}X_tY_t). -/)
  (proof := /-- Let (A>0) be the absolute constant supplied by
  \cref{lem:smooth-leverage-sum-control}, and set (C=24(A+1)).
  Fix admissible data as in
  \cref{def:self-normalized-smoothness-claim}.  By
  \cref{lem:finite-gram-moore-penrose-family}, choose Moore--Penrose
  inverses ((U_n)_{0\leq n\leq T}) of the prefix Gram matrices such
  that (U_T=V_T^\dagger).  For (t<T), write
  [
    a_t=X_t^{\mathsf T}U_{t+1}S_t,\qquad
    q_t=X_t^{\mathsf T}U_{t+1}X_t.
  ]
  This lemma also gives the (\mathcal F_t)-measurability of (a_t) and
  (q_t), as well as (0\leq q_t\leq1).

  Apply \cref{lem:predictable-subgaussian-linear-control} with failure
  probability (\delta/3).  The resulting measurable event (L) has
  probability at least (1-\delta/3), and on (L),
  [
    \sum_{t<T}(2a_tY_t-a_t^2)
      \leq2\sigma^2\log(3/\delta).
  ]
  Likewise, \cref{lem:predictable-subgaussian-quadratic-control}
  supplies a measurable event (Q), again of probability at least
  (1-\delta/3), on which
  [
    \sum_{t<T}q_tY_t^2
      \leq4\sigma^2\left(\sum_{t<T}q_t+\log(3/\delta)\right).
  ]
  Finally, \cref{lem:smooth-leverage-sum-control} gives a measurable
  event (R) of probability at least (1-\delta/3) such that
  [
    \sum_{t<T}q_t\leq
      A\left(\sqrt{dC_{\mathrm{cov}}T\log(6T/\delta)}
        +\log(6/\delta)\right).
  ]
  The union bound applied to (L^c\cup Q^c\cup R^c) shows that
  (\mu(L\cap Q\cap R)\geq1-\delta).

  Put
  [
    B_2=\sqrt{dC_{\mathrm{cov}}T\log(2T/\delta)}
      +\log(2/\delta),\qquad
    B_6=\sqrt{dC_{\mathrm{cov}}T\log(6T/\delta)}
      +\log(6/\delta).
  ]
  Since (T\geq1) and (0<\delta<1), both (2T/\delta) and
  (2/\delta) are at least (2).  For every (x\geq2),
  [
    \log(3x)=\log3+\log x\leq3\log x.
  ]
  Consequently,
  [
    \log(6T/\delta)\leq3\log(2T/\delta),\qquad
    \log(6/\delta)\leq3\log(2/\delta).
  ]
  Nonnegativity of the remaining factors and monotonicity of the square
  root yield
  [
    \sqrt{dC_{\mathrm{cov}}T\log(6T/\delta)}
      \leq2\sqrt{dC_{\mathrm{cov}}T\log(2T/\delta)},
    \qquad B_6\leq3B_2.
  ]
  Moreover, (\log(3/\delta)\leq3\log(2/\delta)\leq3B_2).

  On (L\cap Q\cap R),
  \cref{lem:self-normalized-deterministic-decomposition} and the three
  bounds above give
  [
  \begin{aligned}
    \lVert S_T\rVert_{V_T^\dagger}^2
    &\leq \sum_{t<T}(2a_tY_t-a_t^2)
       +\sum_{t<T}q_tY_t^2\\
    &\leq 12\sigma^2 A B_2+18\sigma^2B_2\\
    &\leq24(A+1)\sigma^2B_2.
  \end{aligned}
  ]
  By \cref{def:self-normalized-smooth-rate}, the last quantity is
  (C\,r(T,d,\sigma,C_{\mathrm{cov}},\delta)).  Thus the event in
  \cref{def:self-normalized-smoothness-claim} contains
  (L\cap Q\cap R), so its probability is at least (1-\delta).
  The constant (C=24(A+1)>0) is independent of all admissible data. -/)
  (title := /-- Self-normalized concentration under smoothness -/)
  (latexEnv := "lemma")]
lemma self_normalized_smoothness_source_gap :
    self_normalized_smoothness_claim := by
  classical
  unfold self_normalized_smoothness_claim
  rcases smooth_leverage_sum_control with ⟨A, hApos, hA⟩
  refine ⟨24 * (A + 1), ?_⟩
  constructor
  · positivity
  · intro T d Ω mΩ μ hμ ℱ ℋx X Y P μ0 hμ0 Vdagger σ Ccov δ
      hT hd hσ hCcov hδ0 hδ1 hℋx hℋxℱ hX hY hP hsmooth hVdagger
    obtain ⟨U, hU, hterminal, hpred, hqmeas, hq⟩ :=
      finite_gram_moore_penrose_family ℱ X Y Vdagger hX hY.1 hVdagger
    have hdet := self_normalized_deterministic_decomposition
      X Y U Vdagger hU hterminal
    have hη0 : 0 < δ / 3 := by positivity
    have hη1 : δ / 3 < 1 := by linarith
    let a : Fin T → Ω → ℝ := self_normalized_prediction X Y U
    let q : Fin T → Ω → ℝ := self_normalized_leverage X U
    let ell3 : ℝ := Real.log (1 / (δ / 3))
    let B2 : ℝ := Real.sqrt ((d : ℝ) * Ccov * (T : ℝ) *
      Real.log (2 * (T : ℝ) / δ)) + Real.log (2 / δ)
    let B6 : ℝ := Real.sqrt ((d : ℝ) * Ccov * (T : ℝ) *
      Real.log (2 * (T : ℝ) / (δ / 3))) + Real.log (2 / (δ / 3))
    let L : Set Ω := {ω | ∑ t, (2 * a t ω * Y t ω - (a t ω) ^ 2) ≤
      2 * σ ^ 2 * ell3}
    let Q : Set Ω := {ω | ∑ t, q t ω * (Y t ω) ^ 2 ≤
      4 * σ ^ 2 * (∑ t, q t ω) + 4 * σ ^ 2 * ell3}
    let R : Set Ω := {ω | ∑ t, q t ω ≤ A * B6}
    have hLprob : μ L ≥ ENNReal.ofReal (1 - δ / 3) := by
      dsimp only [L, a, ell3]
      exact predictable_subgaussian_linear_control μ ℱ Y
        (self_normalized_prediction X Y U) σ (δ / 3)
        hσ hη0 hη1 hY hpred
    have hQprob : μ Q ≥ ENNReal.ofReal (1 - δ / 3) := by
      dsimp only [Q, q, ell3]
      exact predictable_subgaussian_quadratic_control μ ℱ Y
        (self_normalized_leverage X U) σ (δ / 3)
        hσ hη0 hη1 hY hqmeas hq
    have hRprob : μ R ≥ ENNReal.ofReal (1 - δ / 3) := by
      dsimp only [R, q, B6]
      exact hA T d Ω μ ℋx X P μ0 U Ccov (δ / 3)
        hT hd hCcov hη0 hη1 hℋx hP hsmooth hU
    have ha (t : Fin T) : Measurable (a t) :=
      (hpred t).mono (ℱ.le t.val) le_rfl
    have hqa (t : Fin T) : Measurable (q t) :=
      (hqmeas t).mono (ℱ.le t.val) le_rfl
    have hYa (t : Fin T) : Measurable (Y t) :=
      (hY.1 t).mono (ℱ.le (t.val + 1)) le_rfl
    have hLmeas : MeasurableSet L := by
      apply measurableSet_le
      · apply Finset.measurable_sum
        intro t ht
        exact (((ha t).const_mul 2).mul (hYa t)).sub ((ha t).pow_const 2)
      · exact measurable_const
    have hQmeas : MeasurableSet Q := by
      apply measurableSet_le
      · apply Finset.measurable_sum
        intro t ht
        exact (hqa t).mul ((hYa t).pow_const 2)
      · exact ((Finset.measurable_sum _ fun t _ => hqa t).const_mul
          (4 * σ ^ 2)).add measurable_const
    have hRmeas : MeasurableSet R := by
      exact measurableSet_le
        (Finset.measurable_sum _ fun t _ => hqa t) measurable_const
    have hLfail : μ Lᶜ ≤ ENNReal.ofReal (δ / 3) := by
      rw [MeasureTheory.prob_compl_eq_one_sub hLmeas]
      calc
        1 - μ L ≤ 1 - ENNReal.ofReal (1 - δ / 3) :=
          tsub_le_tsub_left hLprob 1
        _ = ENNReal.ofReal (δ / 3) := by
          rw [ENNReal.ofReal_sub 1 hη0.le, ENNReal.ofReal_one]
          exact ENNReal.sub_sub_cancel ENNReal.one_ne_top
            (ENNReal.ofReal_le_one.mpr hη1.le)
    have hQfail : μ Qᶜ ≤ ENNReal.ofReal (δ / 3) := by
      rw [MeasureTheory.prob_compl_eq_one_sub hQmeas]
      calc
        1 - μ Q ≤ 1 - ENNReal.ofReal (1 - δ / 3) :=
          tsub_le_tsub_left hQprob 1
        _ = ENNReal.ofReal (δ / 3) := by
          rw [ENNReal.ofReal_sub 1 hη0.le, ENNReal.ofReal_one]
          exact ENNReal.sub_sub_cancel ENNReal.one_ne_top
            (ENNReal.ofReal_le_one.mpr hη1.le)
    have hRfail : μ Rᶜ ≤ ENNReal.ofReal (δ / 3) := by
      rw [MeasureTheory.prob_compl_eq_one_sub hRmeas]
      calc
        1 - μ R ≤ 1 - ENNReal.ofReal (1 - δ / 3) :=
          tsub_le_tsub_left hRprob 1
        _ = ENNReal.ofReal (δ / 3) := by
          rw [ENNReal.ofReal_sub 1 hη0.le, ENNReal.ofReal_one]
          exact ENNReal.sub_sub_cancel ENNReal.one_ne_top
            (ENNReal.ofReal_le_one.mpr hη1.le)
    let E : Set Ω := (L ∩ Q) ∩ R
    have hEmeas : MeasurableSet E := (hLmeas.inter hQmeas).inter hRmeas
    have hEfail : μ Eᶜ ≤ ENNReal.ofReal δ := by
      calc
        μ Eᶜ = μ (Lᶜ ∪ Qᶜ ∪ Rᶜ) := by
          apply congrArg μ
          ext ω
          simp [E]
          tauto
        _ ≤ μ Lᶜ + μ Qᶜ + μ Rᶜ := by
          calc
            μ (Lᶜ ∪ Qᶜ ∪ Rᶜ) ≤ μ (Lᶜ ∪ Qᶜ) + μ Rᶜ :=
              MeasureTheory.measure_union_le _ _
            _ ≤ μ Lᶜ + μ Qᶜ + μ Rᶜ :=
              add_le_add (MeasureTheory.measure_union_le _ _) le_rfl
        _ ≤ ENNReal.ofReal (δ / 3) + ENNReal.ofReal (δ / 3) +
            ENNReal.ofReal (δ / 3) := by gcongr
        _ = ENNReal.ofReal δ := by
          rw [← ENNReal.ofReal_add hη0.le hη0.le,
            ← ENNReal.ofReal_add (by positivity : 0 ≤ δ / 3 + δ / 3) hη0.le]
          congr 1
          ring
    have hEprob : μ E ≥ ENNReal.ofReal (1 - δ) := by
      calc
        ENNReal.ofReal (1 - δ) = 1 - ENNReal.ofReal δ := by
          rw [ENNReal.ofReal_sub 1 hδ0.le, ENNReal.ofReal_one]
        _ ≤ 1 - μ Eᶜ := tsub_le_tsub_left hEfail 1
        _ = μ E := by
          have hc := MeasureTheory.prob_compl_eq_one_sub (μ := μ) hEmeas.compl
          simpa only [compl_compl] using hc.symm
    have hTreal : (1 : ℝ) ≤ T := by exact_mod_cast hT
    have hdreal : (1 : ℝ) ≤ d := by exact_mod_cast hd
    have hxT : 2 ≤ 2 * (T : ℝ) / δ := by
      rw [le_div_iff₀ hδ0]
      nlinarith
    have hx1 : 2 ≤ 2 / δ := by
      rw [le_div_iff₀ hδ0]
      nlinarith
    have hlog_scale (x : ℝ) (hx : 2 ≤ x) :
        Real.log (3 * x) ≤ 3 * Real.log x := by
      have hxpos : 0 < x := by linarith
      have hthree : (3 : ℝ) ≤ x * x := by nlinarith
      calc
        Real.log (3 * x) = Real.log 3 + Real.log x := by
          rw [Real.log_mul (by norm_num) (ne_of_gt hxpos)]
        _ ≤ 2 * Real.log x + Real.log x := by
          gcongr
          calc
            Real.log 3 ≤ Real.log (x * x) :=
              (Real.log_le_log_iff (by norm_num) (mul_pos hxpos hxpos)).2 hthree
            _ = 2 * Real.log x := by
              rw [Real.log_mul (ne_of_gt hxpos) (ne_of_gt hxpos)]
              ring
        _ = 3 * Real.log x := by ring
    have hargT : 2 * (T : ℝ) / (δ / 3) =
        3 * (2 * (T : ℝ) / δ) := by
      field_simp [ne_of_gt hδ0]
    have harg1 : 2 / (δ / 3) = 3 * (2 / δ) := by
      field_simp [ne_of_gt hδ0]
    have harg3 : 1 / (δ / 3) = 3 / δ := by
      field_simp [ne_of_gt hδ0]
    have hlogT : Real.log (2 * (T : ℝ) / (δ / 3)) ≤
        3 * Real.log (2 * (T : ℝ) / δ) := by
      rw [hargT]
      exact hlog_scale _ hxT
    have hlog1 : Real.log (2 / (δ / 3)) ≤
        3 * Real.log (2 / δ) := by
      rw [harg1]
      exact hlog_scale _ hx1
    have hlog3 : ell3 ≤ 3 * Real.log (2 / δ) := by
      dsimp only [ell3]
      rw [harg3]
      calc
        Real.log (3 / δ) ≤ Real.log (6 / δ) := by
          apply (Real.log_le_log_iff (by positivity) (by positivity)).2
          rw [div_le_div_iff_of_pos_right hδ0]
          norm_num
        _ = Real.log (2 / (δ / 3)) := by
          rw [harg1]
          congr 1
          ring
        _ ≤ 3 * Real.log (2 / δ) := hlog1
    have hscale : 0 ≤ (d : ℝ) * Ccov * (T : ℝ) := by positivity
    have hlog2T : 0 ≤ Real.log (2 * (T : ℝ) / δ) :=
      Real.log_nonneg (by linarith)
    have hlog6T : 0 ≤ Real.log (2 * (T : ℝ) / (δ / 3)) := by
      apply Real.log_nonneg
      rw [hargT]
      nlinarith
    have hbase : 0 ≤ (d : ℝ) * Ccov * (T : ℝ) *
        Real.log (2 * (T : ℝ) / δ) := mul_nonneg hscale hlog2T
    have hlarge : 0 ≤ (d : ℝ) * Ccov * (T : ℝ) *
        Real.log (2 * (T : ℝ) / (δ / 3)) := mul_nonneg hscale hlog6T
    have hrad : (d : ℝ) * Ccov * (T : ℝ) *
        Real.log (2 * (T : ℝ) / (δ / 3)) ≤
        3 * ((d : ℝ) * Ccov * (T : ℝ) *
          Real.log (2 * (T : ℝ) / δ)) := by
      have hm := mul_le_mul_of_nonneg_left hlogT hscale
      nlinarith
    have hsqrt : Real.sqrt ((d : ℝ) * Ccov * (T : ℝ) *
        Real.log (2 * (T : ℝ) / (δ / 3))) ≤
        2 * Real.sqrt ((d : ℝ) * Ccov * (T : ℝ) *
          Real.log (2 * (T : ℝ) / δ)) := by
      nlinarith [Real.sq_sqrt hlarge, Real.sq_sqrt hbase,
        Real.sqrt_nonneg ((d : ℝ) * Ccov * (T : ℝ) *
          Real.log (2 * (T : ℝ) / (δ / 3))),
        Real.sqrt_nonneg ((d : ℝ) * Ccov * (T : ℝ) *
          Real.log (2 * (T : ℝ) / δ))]
    have hB2nonneg : 0 ≤ B2 := by
      dsimp only [B2]
      exact add_nonneg (Real.sqrt_nonneg _) (Real.log_nonneg (by linarith))
    have hB6le : B6 ≤ 3 * B2 := by
      dsimp only [B6, B2]
      nlinarith [Real.sqrt_nonneg ((d : ℝ) * Ccov * (T : ℝ) *
        Real.log (2 * (T : ℝ) / δ))]
    have hsubset : E ⊆ {ω |
        self_normalized_energy (cumulative_score X Y ω) (Vdagger ω) ≤
          24 * (A + 1) * self_normalized_smooth_rate T d σ Ccov δ} := by
      intro ω hω
      rcases hω with ⟨⟨hLω, hQω⟩, hRω⟩
      simp only [L, Set.mem_setOf_eq] at hLω
      simp only [Q, Set.mem_setOf_eq] at hQω
      simp only [R, Set.mem_setOf_eq] at hRω
      have hσsq : 0 ≤ σ ^ 2 := sq_nonneg σ
      have hRbound : ∑ t, q t ω ≤ 3 * A * B2 := by
        calc
          ∑ t, q t ω ≤ A * B6 := hRω
          _ ≤ A * (3 * B2) := mul_le_mul_of_nonneg_left hB6le hApos.le
          _ = 3 * A * B2 := by ring
      have hlinear : 2 * σ ^ 2 * ell3 ≤ 6 * σ ^ 2 * B2 := by
        have hlogB : ell3 ≤ 3 * B2 := by
          dsimp only [B2]
          nlinarith [Real.sqrt_nonneg ((d : ℝ) * Ccov * (T : ℝ) *
            Real.log (2 * (T : ℝ) / δ))]
        nlinarith
      have hquadratic :
          4 * σ ^ 2 * (∑ t, q t ω) + 4 * σ ^ 2 * ell3 ≤
            12 * σ ^ 2 * A * B2 + 12 * σ ^ 2 * B2 := by
        have hlogB : ell3 ≤ 3 * B2 := by
          dsimp only [B2]
          nlinarith [Real.sqrt_nonneg ((d : ℝ) * Ccov * (T : ℝ) *
            Real.log (2 * (T : ℝ) / δ))]
        nlinarith
      have henergy :
          self_normalized_energy (cumulative_score X Y ω) (Vdagger ω) ≤
            12 * σ ^ 2 * A * B2 + 18 * σ ^ 2 * B2 := by
        have hdω := hdet ω
        dsimp only [a, q] at hLω hQω ⊢
        rw [Finset.sum_add_distrib] at hdω
        nlinarith
      rw [self_normalized_smooth_rate]
      change self_normalized_energy (cumulative_score X Y ω) (Vdagger ω) ≤
        24 * (A + 1) * (σ ^ 2 * B2)
      have hrate : 0 ≤ σ ^ 2 * B2 := mul_nonneg hσsq hB2nonneg
      calc
        self_normalized_energy (cumulative_score X Y ω) (Vdagger ω) ≤
            12 * σ ^ 2 * A * B2 + 18 * σ ^ 2 * B2 := henergy
        _ = (12 * A + 18) * (σ ^ 2 * B2) := by ring
        _ ≤ 24 * (A + 1) * (σ ^ 2 * B2) := by
          apply mul_le_mul_of_nonneg_right _ hrate
          nlinarith
    calc
      μ {ω | self_normalized_energy (cumulative_score X Y ω) (Vdagger ω) ≤
          24 * (A + 1) * self_normalized_smooth_rate T d σ Ccov δ} ≥ μ E :=
        MeasureTheory.measure_mono hsubset
      _ ≥ ENNReal.ofReal (1 - δ) := hEprob

@[blueprint "thm:self-normalized-martingales-under-smoothness"
  (statement := /-- There exists an absolute constant (C>0) with the
