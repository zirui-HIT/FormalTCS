import Architect
import Mathlib.Probability.IdentDistrib
import Mathlib.Probability.Independence.Basic
import Mathlib.Probability.Martingale.Convergence
import Mathlib.MeasureTheory.Measure.Typeclasses.Probability
import Mathlib.Topology.Algebra.InfiniteSum.Defs

set_option linter.all false
set_option maxHeartbeats 500000

open Filter MeasureTheory ProbabilityTheory
open scoped BigOperators Topology

@[blueprint "def:betting-null-model"
  (statement := /-- A betting null model consists of a probability space carrying independent
  real-valued observations with common non-degenerate law \(P\), where \(P\) is supported on
  \([0,1]\) and has mean \(m\). -/)
  (title := /-- Betting null model -/)
  (latexEnv := "definition")]
structure betting_null_model {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X : ℕ → Ω → ℝ) : Prop where
  independent : iIndepFun X μ
  commonLaw : ∀ n, IdentDistrib (X n) id μ P
  support : ∀ᵐ x ∂P, x ∈ Set.Icc (0 : ℝ) 1
  mean : ∫ x, x ∂P = m
  nondegenerate : P ≠ Measure.dirac m

@[reducible, blueprint "def:betting-history"
  (statement := /-- For observations \(X_0,X_1,\ldots\), the history strictly before time \(n\)
  is the sigma-algebra generated by \(X_k\) for \(k<n\). -/)
  (title := /-- Strict-past observation history -/)
  (latexEnv := "definition")]
def betting_history {Ω : Type*} [MeasurableSpace Ω]
    (X : ℕ → Ω → ℝ) (n : ℕ) : MeasurableSpace Ω :=
  ⨆ k : Fin n, MeasurableSpace.comap (X (k : ℕ)) inferInstance

@[blueprint "def:is-predictable-bet"
  (statement := /-- A bet process \(\lambda\) is predictable relative to \(X\) if, for every
  \(n\), the random variable \(\lambda_n\) is measurable with respect to the history generated
  by the observations at times strictly smaller than \(n\). -/)
  (title := /-- Predictable bet process -/)
  (latexEnv := "definition")]
def is_predictable_bet {Ω : Type*} [MeasurableSpace Ω]
    (X lam : ℕ → Ω → ℝ) : Prop :=
  ∀ n, @Measurable Ω ℝ (betting_history X n) inferInstance (lam n)

@[blueprint "def:is-admissible-bet"
  (statement := /-- A predictable bet process is admissible at mean \(m\) if every value
  \(\lambda_n(\omega)\) belongs to
  \([-(1-m)^{-1},m^{-1}]\). -/)
  (title := /-- Admissible predictable bets -/)
  (latexEnv := "definition")]
def is_admissible_bet {Ω : Type*} [MeasurableSpace Ω]
    (X : ℕ → Ω → ℝ) (m : ℝ) (lam : ℕ → Ω → ℝ) : Prop :=
  is_predictable_bet X lam ∧
    ∀ n ω, -(1 / (1 - m)) ≤ lam n ω ∧ lam n ω ≤ 1 / m

@[blueprint "def:betting-wealth"
  (statement := /-- The wealth after \(n\) bets is
  \[
    W_n^\lambda(\omega)=\prod_{k=0}^{n-1}
      \bigl(1+\lambda_k(\omega)(X_k(\omega)-m)\bigr).
  \] -/)
  (title := /-- Predictable betting wealth -/)
  (latexEnv := "definition")]
def betting_wealth {Ω : Type*} (m : ℝ)
    (X lam : ℕ → Ω → ℝ) (n : ℕ) (ω : Ω) : ℝ :=
  ∏ k ∈ Finset.range n, (1 + lam k ω * (X k ω - m))

@[blueprint "def:betting-transform"
  (statement := /-- The centered martingale transform associated with the bets is
  \[
    S_n(\omega)=\sum_{k=0}^{n-1}\lambda_k(\omega)(X_k(\omega)-m).
  \] -/)
  (title := /-- Centered betting transform -/)
  (latexEnv := "definition")]
def betting_transform {Ω : Type*} (m : ℝ)
    (X lam : ℕ → Ω → ℝ) (n : ℕ) (ω : Ω) : ℝ :=
  ∑ k ∈ Finset.range n, lam k ω * (X k ω - m)

@[blueprint "lem:null-mean-mem-unit-interval"
  (statement := /-- Let \((\Omega,\mu)\) be a probability space, let \(P\) be a probability
  measure on \(\mathbb R\), let \(m\in\mathbb R\), and let \(X=(X_n)_{n\geq0}\) be a sequence
  of real-valued observations. If \((\mu,P,m,X)\) is a betting null model, then
  \(m\in[0,1]\). -/)
  (proof := /-- By \cref{def:betting-null-model}, \(P\) is a probability measure,
  \(0\leq x\leq 1\) for \(P\)-almost every \(x\), and \(\int x\,dP=m\). The identity
  function is integrable because it is bounded in norm by \(1\) almost everywhere under the
  finite measure \(P\). Positivity and monotonicity of the integral therefore give
  \[
    0=\int 0\,dP\leq\int x\,dP=m\leq\int 1\,dP=1.
  \]
  The last equality again uses that \(P\) is a probability measure. -/)
  (title := /-- The null mean lies in the unit interval -/)
  (latexEnv := "lemma")]
lemma null_mean_mem_unit_interval {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X) :
    m ∈ Set.Icc (0 : ℝ) 1 := by
  rw [Set.mem_Icc, ← hmodel.mean]
  have hid : Integrable (fun x : ℝ => x) P :=
    Integrable.of_bound continuous_id.aestronglyMeasurable 1
      (hmodel.support.mono fun x hx => by
        simpa [Real.norm_eq_abs, abs_of_nonneg hx.1] using hx.2)
  exact ⟨integral_nonneg_of_ae (hmodel.support.mono fun x hx => hx.1), by
    simpa using
      integral_mono_ae hid (integrable_const 1) (hmodel.support.mono fun x hx => hx.2)⟩

@[blueprint "lem:cond-exp-indep-eq-for-wealth-limit"
  (statement := /-- Let \(\mathcal A\) and \(\mathcal B\) be independent sub-\(\sigma\)-algebras
  of a measure space. If \(f\) is a real-valued, strongly \(\mathcal A\)-measurable function,
  then the conditional expectation of \(f\) given \(\mathcal B\) is almost everywhere equal
  to the constant \(\int f\). -/)
  (proof := /-- If \(f\) is not integrable, both its conditional expectation and its integral
  use the convention zero. For integrable \(f\), the defining set-integral identity is first
  verified for indicators of \(\mathcal A\)-measurable sets by independence. It is preserved
  by addition and by \(L^1\)-limits, so strong-measurable simple-function approximation extends
  it to \(f\). The characterization of conditional expectation by these set integrals then
  yields the asserted almost-everywhere equality. -/)
  (title := /-- Conditional expectation under independence -/)
  (latexEnv := "lemma")]
lemma cond_exp_indep_eq_for_wealth_limit
    {Ω : Type*} [mΩ : MeasurableSpace Ω] (μ : Measure Ω)
    {m₁ m₂ : MeasurableSpace Ω} {f : Ω → ℝ}
    (hle₁ : m₁ ≤ mΩ)
    (hle₂ : m₂ ≤ mΩ)
    [SigmaFinite (μ.trim hle₂)]
    (hf : StronglyMeasurable[m₁] f) (hindp : Indep m₁ m₂ μ) :
    μ[f | m₂] =ᵐ[μ] fun _ => μ[f] := by
  by_cases hfint : Integrable f μ
  swap
  · rw [condExp_of_not_integrable hfint, integral_undef hfint]
    rfl
  refine (ae_eq_condExp_of_forall_setIntegral_eq hle₂ hfint
    (fun s _ hs => integrableOn_const hs.ne) (fun s hms hs => ?_)
      stronglyMeasurable_const.aestronglyMeasurable).symm
  rw [setIntegral_const]
  rw [← memLp_one_iff_integrable] at hfint
  refine MemLp.induction_stronglyMeasurable hle₁ ENNReal.one_ne_top _ ?_ ?_ ?_ ?_ hfint ?_
  · exact ⟨f, hf, EventuallyEq.rfl⟩
  · intro c t hmt _
    rw [Indep_iff] at hindp
    rw [integral_indicator (hle₁ _ hmt), setIntegral_const, smul_smul, measureReal_def,
      measureReal_def, ← ENNReal.toReal_mul, mul_comm, ← hindp _ _ hmt hms,
      setIntegral_indicator (hle₁ _ hmt), setIntegral_const, Set.inter_comm, measureReal_def]
  · intro u v _ huint hvint hu hv hu_eq hv_eq
    rw [memLp_one_iff_integrable] at huint hvint
    rw [integral_add' huint hvint, smul_add, hu_eq, hv_eq,
      integral_add' huint.integrableOn hvint.integrableOn]
  · letI : MeasurableSpace Ω := mΩ
    have h_integral : Continuous fun f : lpMeas ℝ ℝ m₁ 1 μ => ∫ x, (f : Ω → ℝ) x ∂μ := by
      simpa using! continuous_integral.comp (ContinuousLinearMap.continuous (Submodule.subtypeL _))
    have h_setIntegral : Continuous fun f : lpMeas ℝ ℝ m₁ 1 μ =>
        ∫ x in s, (f : Ω → ℝ) x ∂μ := by
      simpa using! (continuous_setIntegral s).comp
        (ContinuousLinearMap.continuous (Submodule.subtypeL _))
    exact isClosed_eq (Continuous.const_smul h_integral (μ.real s)) h_setIntegral
  · intro u v huv _ hueq
    rwa [← integral_congr_ae huv, ←
      (setIntegral_congr_ae (hle₂ _ hms) _ : ∫ x in s, u x ∂μ = ∫ x in s, v x ∂μ)]
    filter_upwards [huv] with x hx _ using hx

@[blueprint "lem:null-mean-strict-unit-interval-for-wealth-limit"
  (statement := /-- In a non-degenerate betting null model supported on \([0,1]\), the mean
  satisfies \(0<m<1\). -/)
  (proof := /-- By \cref{lem:null-mean-mem-unit-interval}, it remains to exclude the two
  endpoints. If \(m=0\), nonnegativity on the support and the vanishing integral imply that
  the identity function is zero \(P\)-almost everywhere, so \(P=\delta_0\). If \(m=1\), the
  same argument applied to \(1-x\) gives \(P=\delta_1\). Each conclusion contradicts the
  nondegeneracy condition in \cref{def:betting-null-model}. -/)
  (title := /-- The null mean is strictly between zero and one -/)
  (latexEnv := "lemma")]
lemma null_mean_strict_unit_interval_for_wealth_limit
    {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X) :
    0 < m ∧ m < 1 := by
  have hm := null_mean_mem_unit_interval μ P m X hmodel
  have hid : Integrable (fun x : ℝ => x) P := by
    apply Integrable.of_bound continuous_id.aestronglyMeasurable 1
    filter_upwards [hmodel.support] with x hx
    simpa [Real.norm_eq_abs, abs_of_nonneg hx.1] using hx.2
  constructor
  · refine lt_of_le_of_ne hm.1 ?_
    intro hmeq
    have hm0 : m = 0 := hmeq.symm
    have hae : (fun x : ℝ => x) =ᵐ[P] 0 := by
      have hnonneg : 0 ≤ᵐ[P] fun x : ℝ => x := by
        filter_upwards [hmodel.support] with x hx
        exact hx.1
      exact (integral_eq_zero_iff_of_nonneg_ae hnonneg hid).mp (by
        simpa [hm0] using hmodel.mean)
    apply hmodel.nondegenerate
    subst m
    calc
      P = Measure.map (fun x : ℝ => x) P := by simp
      _ = Measure.map (fun _ : ℝ => (0 : ℝ)) P := Measure.map_congr hae
      _ = Measure.dirac 0 := by simp
  · refine lt_of_le_of_ne hm.2 ?_
    intro hmeq
    have hm1 : m = 1 := hmeq
    have hone : Integrable (fun _ : ℝ => (1 : ℝ)) P := integrable_const 1
    have hsub : Integrable (fun x : ℝ => 1 - x) P := hone.sub hid
    have hae_sub : (fun x : ℝ => 1 - x) =ᵐ[P] 0 := by
      have hnonneg : 0 ≤ᵐ[P] fun x : ℝ => 1 - x := by
        filter_upwards [hmodel.support] with x hx
        exact sub_nonneg.mpr hx.2
      exact (integral_eq_zero_iff_of_nonneg_ae hnonneg hsub).mp (by
        rw [integral_sub hone hid]
        simp [hmodel.mean, hm1])
    have hae : (fun x : ℝ => x) =ᵐ[P] fun _ => (1 : ℝ) := by
      filter_upwards [hae_sub] with x hx
      dsimp at hx ⊢
      linarith
    apply hmodel.nondegenerate
    subst m
    calc
      P = Measure.map (fun x : ℝ => x) P := by simp
      _ = Measure.map (fun _ : ℝ => (1 : ℝ)) P := Measure.map_congr hae
      _ = Measure.dirac 1 := by simp

@[blueprint "lem:betting-wealth-has-ae-limit"
  (statement := /-- Let \((\Omega,\mu)\) be a probability space, let \(P\) be a probability
  measure on \(\mathbb R\), let \(m\in\mathbb R\), and let \(X\) and \(\lambda\) be
  real-valued processes indexed by \(\mathbb N\). If \((\mu,P,m,X)\) is a betting null model
  and \(\lambda\) is an admissible bet process for \(X\) at mean \(m\), then there exists a
  function \(W_\infty:\Omega\to\mathbb R\) such that
  \(W_n^\lambda(\omega)\to W_\infty(\omega)\) for \(\mu\)-almost every \(\omega\). -/)
  (proof := /-- Work on the null-measurable completion of \((\Omega,\mu)\), which has the
  same almost-everywhere filter as \(\mu\). The almost-everywhere measurable observations in
  \cref{def:betting-null-model} are measurable there. Their strict-past spaces from
  \cref{def:betting-history} form a filtration, and the predictability condition in
  \cref{def:is-admissible-bet} makes each wealth value history-measurable. Mutual independence
  implies independence of the finite tuple \((X_0,\ldots,X_{n-1})\) and \(X_n\). Hence
  \cref{lem:cond-exp-indep-eq-for-wealth-limit}, together with the common mean \(m\), shows
  that the centered increment \(X_n-m\) has conditional expectation zero. Expanding the
  product in \cref{def:betting-wealth} by its final factor then proves that
  \((W_n^\lambda)_{n\geq0}\) is a martingale.

  By \cref{lem:null-mean-strict-unit-interval-for-wealth-limit}, one has \(0<m<1\). The
  support and admissibility bounds therefore make every wealth factor nonnegative almost
  surely. They also give an integrable bound for each finite product. Consequently
  \(\lVert W_n^\lambda\rVert_{L^1}=\mathbb E[W_n^\lambda]=1\) for every \(n\), since the
  martingale starts at one. The almost-everywhere convergence theorem for \(L^1\)-bounded
  submartingales supplies a finite real-valued limit on the completion; equality of the two
  almost-everywhere filters yields the asserted function \(W_\infty:\Omega\to\mathbb R\). -/)
  (title := /-- Almost-sure convergence of betting wealth -/)
  (latexEnv := "lemma")]
lemma betting_wealth_has_ae_limit {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X lam : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X)
    (hbet : is_admissible_bet X m lam) :
    ∃ Wlim : Ω → ℝ,
      ∀ᵐ ω ∂μ, Tendsto (fun n => betting_wealth m X lam n ω) atTop (𝓝 (Wlim ω)) := by
  let Ωc := NullMeasurableSpace Ω μ
  let μc : Measure Ωc := μ.completion
  let Xc : ℕ → Ωc → ℝ := fun n ω => X n ω
  let lamc : ℕ → Ωc → ℝ := fun n ω => lam n ω
  let W : ℕ → Ωc → ℝ := fun n ω => betting_wealth m Xc lamc n ω
  letI : IsProbabilityMeasure μc := ⟨by
    change μ Set.univ = 1
    simp⟩
  have hXm : ∀ n, Measurable (Xc n) := by
    intro n s hs
    exact (hmodel.commonLaw n).aemeasurable_fst.nullMeasurable hs
  have hcommon : ∀ n, IdentDistrib (Xc n) id μc P := by
    intro n
    refine ⟨(hXm n).aemeasurable, (hmodel.commonLaw n).aemeasurable_snd, ?_⟩
    rw [← (hmodel.commonLaw n).map_eq]
    ext s hs
    rw [Measure.map_apply (hXm n) hs,
      Measure.map_apply_of_aemeasurable (hmodel.commonLaw n).aemeasurable_fst hs]
    change μ (X n ⁻¹' s) = μ (X n ⁻¹' s)
    rfl
  have hindep : iIndepFun Xc μc := by
    exact hmodel.independent
  have hbetc : is_admissible_bet Xc m lamc := by
    exact hbet
  have hm := null_mean_strict_unit_interval_for_wealth_limit μ P m X hmodel
  let L : ℝ := max |-(1 / (1 - m))| |1 / m|
  have hL0 : 0 ≤ L := (abs_nonneg _).trans (le_max_left _ _)
  have hlam_bound : ∀ n ω, ‖lamc n ω‖ ≤ L := by
    intro n ω
    rw [Real.norm_eq_abs, abs_le]
    have hb := hbetc.2 n ω
    constructor
    · exact (neg_le_neg (le_max_left |-(1 / (1 - m))| |1 / m|)).trans
        ((neg_abs_le _).trans hb.1)
    · exact hb.2.trans ((le_abs_self _).trans (le_max_right _ _))
  have hsupport : ∀ᵐ ω ∂μc, ∀ n, Xc n ω ∈ Set.Icc (0 : ℝ) 1 := by
    rw [ae_all_iff]
    intro n
    exact (hcommon n).symm.ae_mem_snd measurableSet_Icc hmodel.support
  have hfactor_nonneg : ∀ n ω, Xc n ω ∈ Set.Icc (0 : ℝ) 1 →
      0 ≤ 1 + lamc n ω * (Xc n ω - m) := by
    intro n ω hx
    by_cases hlam : 0 ≤ lamc n ω
    · have hub := (hbetc.2 n ω).2
      have hmul : lamc n ω * m ≤ 1 := by
        calc
          lamc n ω * m ≤ (1 / m) * m := mul_le_mul_of_nonneg_right hub hm.1.le
          _ = 1 := by field_simp [ne_of_gt hm.1]
      have hcenter : -m ≤ Xc n ω - m := by linarith [hx.1]
      have := mul_le_mul_of_nonneg_left hcenter hlam
      nlinarith
    · have hlam' : lamc n ω < 0 := lt_of_not_ge hlam
      have hlower := (hbetc.2 n ω).1
      have hmul : -1 ≤ lamc n ω * (1 - m) := by
        calc
          -1 = (-(1 / (1 - m))) * (1 - m) := by
            field_simp [ne_of_gt (sub_pos.mpr hm.2)]
          _ ≤ lamc n ω * (1 - m) :=
            mul_le_mul_of_nonneg_right hlower (sub_nonneg.mpr hm.2.le)
      have hcenter : Xc n ω - m ≤ 1 - m := by linarith [hx.2]
      have := mul_le_mul_of_nonpos_left hcenter hlam'.le
      nlinarith
  have hfactor_bound : ∀ n ω, Xc n ω ∈ Set.Icc (0 : ℝ) 1 →
      ‖1 + lamc n ω * (Xc n ω - m)‖ ≤ 1 + L := by
    intro n ω hx
    rw [Real.norm_eq_abs, abs_of_nonneg (hfactor_nonneg n ω hx)]
    have hcenter : |Xc n ω - m| ≤ 1 := by
      rw [abs_le]
      constructor <;> linarith [hx.1, hx.2, hm.1, hm.2]
    calc
      1 + lamc n ω * (Xc n ω - m) ≤
          1 + |lamc n ω * (Xc n ω - m)| := by
            linarith [le_abs_self (lamc n ω * (Xc n ω - m))]
      _ = 1 + |lamc n ω| * |Xc n ω - m| := by rw [abs_mul]
      _ ≤ 1 + L * 1 := by
        gcongr
        simpa [Real.norm_eq_abs] using hlam_bound n ω
      _ = 1 + L := by ring
  have hhistory_mono : Monotone (betting_history Xc) := by
    intro i j hij
    unfold betting_history
    refine iSup_le fun k => ?_
    let l : Fin j := ⟨k, lt_of_lt_of_le k.isLt hij⟩
    simpa [l] using
      (le_iSup (fun q : Fin j => MeasurableSpace.comap (Xc (q : ℕ)) inferInstance) l)
  have hhistory_le : ∀ n, betting_history Xc n ≤ (inferInstance : MeasurableSpace Ωc) := by
    intro n
    unfold betting_history
    exact iSup_le fun k => (hXm k).comap_le
  let ℱ : Filtration ℕ (inferInstance : MeasurableSpace Ωc) :=
    ⟨betting_history Xc, hhistory_mono, hhistory_le⟩
  have hwealth_meas : ∀ n,
      @Measurable Ωc ℝ (betting_history Xc n) inferInstance (W n) := by
    intro n
    apply Finset.measurable_prod
    intro k hk
    have hklt : k < n := Finset.mem_range.mp hk
    have hlamk : @Measurable Ωc ℝ (betting_history Xc n) inferInstance (lamc k) :=
      (hbetc.1 k).mono (hhistory_mono hklt.le) le_rfl
    have hXk : @Measurable Ωc ℝ (betting_history Xc n) inferInstance (Xc k) := by
      apply Measurable.of_comap_le
      let q : Fin n := ⟨k, hklt⟩
      simpa [betting_history, q] using
        (le_iSup (fun r : Fin n => MeasurableSpace.comap (Xc (r : ℕ)) inferInstance) q)
    exact measurable_const.add (hlamk.mul (hXk.sub measurable_const))
  have hwealth_bound : ∀ n, ∀ᵐ ω ∂μc, ‖W n ω‖ ≤ (1 + L) ^ n := by
    intro n
    filter_upwards [hsupport] with ω hω
    simp only [W, betting_wealth, norm_prod]
    calc
      ∏ k ∈ Finset.range n, ‖1 + lamc k ω * (Xc k ω - m)‖ ≤
          ∏ k ∈ Finset.range n, (1 + L) := by
            gcongr with k hk
            exact hfactor_bound k ω (hω k)
      _ = (1 + L) ^ n := by simp
  have hwealth_int : ∀ n, Integrable (W n) μc := by
    intro n
    apply Integrable.of_bound
      ((hwealth_meas n).mono (hhistory_le n) le_rfl).aestronglyMeasurable
      ((1 + L) ^ n)
    exact hwealth_bound n
  have hstrong : StronglyAdapted ℱ W := by
    intro n
    exact (hwealth_meas n).stronglyMeasurable
  have hid : Integrable (fun x : ℝ => x) P := by
    apply Integrable.of_bound continuous_id.aestronglyMeasurable 1
    filter_upwards [hmodel.support] with x hx
    simpa [Real.norm_eq_abs, abs_of_nonneg hx.1] using hx.2
  have hcenter_int : ∀ n, Integrable (fun ω => Xc n ω - m) μc := by
    intro n
    exact ((hcommon n).integrable_iff.mpr hid).sub (integrable_const m)
  have hcenter_mean : ∀ n, ∫ ω, (Xc n ω - m) ∂μc = 0 := by
    intro n
    rw [integral_sub ((hcommon n).integrable_iff.mpr hid) (integrable_const m)]
    rw [(hcommon n).integral_eq]
    simpa only [id_eq, integral_const, probReal_univ, one_smul, hmodel.mean, sub_self]
  have hstep : ∀ n, W n =ᵐ[μc] μc[W (n + 1) | ℱ n] := by
    intro n
    change W n =ᵐ[μc] μc[W (n + 1) | betting_history Xc n]
    let S := Finset.range n
    let T : Finset ℕ := {n}
    let past : Ωc → S → ℝ := fun ω k => Xc k ω
    let current : Ωc → T → ℝ := fun ω k => Xc k ω
    have htuples : IndepFun past current μc := by
      exact hindep.indepFun_finset S T (by simp [S, T]) hXm
    have hpast : MeasurableSpace.comap past inferInstance = betting_history Xc n := by
      rw [MeasurableSpace.comap_process_pi]
      apply le_antisymm
      · refine iSup_le fun k => ?_
        have hklt : (k : ℕ) < n := Finset.mem_range.mp k.property
        let q : Fin n := ⟨k, hklt⟩
        exact le_iSup_of_le q (by simp [past, q])
      · unfold betting_history
        refine iSup_le fun k => ?_
        have hkS : (k : ℕ) ∈ S := by simpa [S] using k.isLt
        let q : S := ⟨k, hkS⟩
        exact le_iSup_of_le q (by simp [past, q])
    have hcurrent : MeasurableSpace.comap current inferInstance =
        MeasurableSpace.comap (Xc n) inferInstance := by
      rw [MeasurableSpace.comap_process_pi]
      apply le_antisymm
      · refine iSup_le fun k => ?_
        have hk : (k : ℕ) = n := Finset.mem_singleton.mp k.property
        simpa [hk]
      · have hnT : n ∈ T := by simp [T]
        let q : T := ⟨n, hnT⟩
        exact le_iSup_of_le q (by simp [current, q])
    have hsep : Indep (MeasurableSpace.comap past inferInstance)
        (MeasurableSpace.comap current inferInstance) μc := htuples
    have hind : Indep (MeasurableSpace.comap (Xc n) inferInstance)
        (betting_history Xc n) μc := by
      rw [hpast, hcurrent] at hsep
      exact hsep.symm
    have hcenter_strong : StronglyMeasurable[MeasurableSpace.comap (Xc n) inferInstance]
        (fun ω => Xc n ω - m) :=
      ((comap_measurable (Xc n)).sub measurable_const).stronglyMeasurable
    have hcenter_cond : μc[fun ω => Xc n ω - m | betting_history Xc n] =ᵐ[μc]
        fun _ => 0 := by
      refine (cond_exp_indep_eq_for_wealth_limit μc (hXm n).comap_le
        (hhistory_le n) hcenter_strong hind).trans ?_
      rw [hcenter_mean n]
    let A : Ωc → ℝ := fun ω => W n ω * lamc n ω
    have hA_strong : StronglyMeasurable[betting_history Xc n] A :=
      ((hwealth_meas n).mul (hbetc.1 n)).stronglyMeasurable
    have hA_bound : ∀ᵐ ω ∂μc, ‖A ω‖ ≤ (1 + L) ^ n * L := by
      filter_upwards [hwealth_bound n] with ω hw
      simp only [A, norm_mul]
      exact mul_le_mul hw (hlam_bound n ω) (norm_nonneg _) (by positivity)
    have hinc_int : Integrable (fun ω => A ω * (Xc n ω - m)) μc :=
      (hcenter_int n).bdd_mul
        (hA_strong.mono (hhistory_le n)).aestronglyMeasurable hA_bound
    have hpull : μc[fun ω => A ω * (Xc n ω - m) | betting_history Xc n] =ᵐ[μc]
        A * μc[fun ω => Xc n ω - m | betting_history Xc n] :=
      condExp_stronglyMeasurable_mul_of_bound (hhistory_le n) hA_strong
        (hcenter_int n) ((1 + L) ^ n * L) hA_bound
    have hsucc : W (n + 1) = fun ω => W n ω + A ω * (Xc n ω - m) := by
      funext ω
      simp [W, A, betting_wealth, Finset.prod_range_succ]
      ring
    rw [hsucc]
    filter_upwards [condExp_add (hwealth_int n) hinc_int (betting_history Xc n),
      hpull, hcenter_cond] with ω hadd hp hc
    change W n ω = μc[W n + (fun ω => A ω * (Xc n ω - m)) |
      betting_history Xc n] ω
    rw [hadd, condExp_of_stronglyMeasurable (hhistory_le n)
      (hwealth_meas n).stronglyMeasurable (hwealth_int n)]
    change W n ω = W n ω + μc[fun ω => A ω * (Xc n ω - m) |
      betting_history Xc n] ω
    rw [hp]
    change W n ω = W n ω + A ω * μc[fun ω => Xc n ω - m |
      betting_history Xc n] ω
    rw [hc]
    ring
  have hmart : Martingale W ℱ μc := martingale_nat hstrong hwealth_int hstep
  have hnonneg : ∀ n, 0 ≤ᵐ[μc] W n := by
    intro n
    filter_upwards [hsupport] with ω hω
    simp only [W, betting_wealth]
    exact Finset.prod_nonneg fun k hk => hfactor_nonneg k ω (hω k)
  have hintegral : ∀ n, ∫ ω, W n ω ∂μc = 1 := by
    intro n
    have h := hmart.setIntegral_eq (Nat.zero_le n) (s := Set.univ) MeasurableSet.univ
    simpa [W, betting_wealth] using h.symm
  have hbdd : ∀ n, eLpNorm (W n) 1 μc ≤ 1 := by
    intro n
    rw [MemLp.eLpNorm_eq_integral_rpow_norm one_ne_zero ENNReal.one_ne_top
      (memLp_one_iff_integrable.mpr (hwealth_int n))]
    simp only [ENNReal.toReal_one, Real.rpow_one, inv_one]
    have hnorm : (fun ω => ‖W n ω‖) =ᵐ[μc] W n := by
      filter_upwards [hnonneg n] with ω hω
      simp [Real.norm_eq_abs, abs_of_nonneg hω]
    rw [integral_congr_ae hnorm, hintegral n]
    simp
  refine ⟨fun ω => ℱ.limitProcess W μc ω, ?_⟩
  change ∀ᵐ ω : Ωc ∂μc, Tendsto (fun n => W n ω) atTop
    (𝓝 (ℱ.limitProcess W μc ω))
  exact hmart.submartingale.ae_tendsto_limitProcess hbdd

@[blueprint "lem:betting-history-mono-for-oscillation"
  (statement := /-- For any observation process, the strict-past history at time \(i\) is
  contained in the strict-past history at time \(j\) whenever \(i\leq j\). -/)
  (proof := /-- By \cref{def:betting-history}, the history at time \(i\) is the supremum of
  the pullback measurable spaces indexed by \(k<i\).  The inclusion \(i\leq j\) sends every
  such index to an index below \(j\), so every term in the first supremum is bounded by the
  corresponding term in the second. -/)
  (title := /-- Monotonicity of strict-past histories -/)
  (latexEnv := "lemma")]
lemma betting_history_mono_for_oscillation {Ω : Type*} [MeasurableSpace Ω]
    (X : ℕ → Ω → ℝ) {i j : ℕ} (hij : i ≤ j) :
    betting_history X i ≤ betting_history X j := by
  unfold betting_history
  refine iSup_le fun k => ?_
  let l : Fin j := ⟨k, lt_of_lt_of_le k.isLt hij⟩
  simpa [l] using
    (le_iSup (fun q : Fin j => MeasurableSpace.comap (X (q : ℕ)) inferInstance) l)

@[blueprint "lem:betting-history-observation-measurable-for-oscillation"
  (statement := /-- If \(k<n\), then the observation \(X_k\) is measurable with respect to
  the strict-past history at time \(n\). -/)
  (proof := /-- The pullback measurable space generated by \(X_k\) is one of the terms in
  the supremum defining the time-\(n\) history in \cref{def:betting-history}; hence its
  pullback is bounded by that history, which is exactly measurability. -/)
  (title := /-- Past observations are history-measurable -/)
  (latexEnv := "lemma")]
lemma betting_history_observation_measurable_for_oscillation
    {Ω : Type*} [MeasurableSpace Ω] (X : ℕ → Ω → ℝ) {k n : ℕ} (hkn : k < n) :
    @Measurable Ω ℝ (betting_history X n) inferInstance (X k) := by
  apply Measurable.of_comap_le
  unfold betting_history
  let l : Fin n := ⟨k, hkn⟩
  simpa [l] using
    (le_iSup (fun q : Fin n => MeasurableSpace.comap (X (q : ℕ)) inferInstance) l)

@[blueprint "lem:betting-history-bet-measurable-for-oscillation"
  (statement := /-- If \(\lambda\) is predictable and \(k\leq n\), then \(\lambda_k\) is
  measurable with respect to the strict-past history at time \(n\). -/)
  (proof := /-- Predictability makes \(\lambda_k\) measurable with respect to the history at
  time \(k\).  The history inclusion from
  \cref{lem:betting-history-mono-for-oscillation} for \(k\leq n\) then preserves
  measurability. -/)
  (title := /-- Past predictable bets are history-measurable -/)
  (latexEnv := "lemma")]
lemma betting_history_bet_measurable_for_oscillation
    {Ω : Type*} [MeasurableSpace Ω] (X lam : ℕ → Ω → ℝ)
    (hpred : is_predictable_bet X lam) {k n : ℕ} (hkn : k ≤ n) :
    @Measurable Ω ℝ (betting_history X n) inferInstance (lam k) := by
  exact (hpred k).mono (betting_history_mono_for_oscillation X hkn) le_rfl

@[blueprint "lem:betting-transform-history-measurable-for-oscillation"
  (statement := /-- For a predictable bet process, its centered transform through time
  \(n\) is measurable with respect to the strict-past history at time \(n\). -/)
  (proof := /-- Expand the transform using \cref{def:betting-transform}.  For every
  \(k<n\), \cref{lem:betting-history-bet-measurable-for-oscillation} makes \(\lambda_k\)
  history-measurable, while
  \cref{lem:betting-history-observation-measurable-for-oscillation} does the same for
  \(X_k\).  Closure under subtraction, multiplication, and finite sums proves the claim. -/)
  (title := /-- The betting transform is history-measurable -/)
  (latexEnv := "lemma")]
lemma betting_transform_history_measurable_for_oscillation
    {Ω : Type*} [MeasurableSpace Ω] (m : ℝ) (X lam : ℕ → Ω → ℝ)
    (hpred : is_predictable_bet X lam) (n : ℕ) :
    @Measurable Ω ℝ (betting_history X n) inferInstance
      (fun ω => betting_transform m X lam n ω) := by
  unfold betting_transform
  apply Finset.measurable_sum
  intro k hk
  have hklt : k < n := Finset.mem_range.mp hk
  exact (betting_history_bet_measurable_for_oscillation X lam hpred hklt.le).mul
    ((betting_history_observation_measurable_for_oscillation X hklt).sub measurable_const)

@[blueprint "lem:betting-realized-square-history-measurable-for-oscillation"
  (statement := /-- For a predictable bet process, the accumulated squared realized
  increments through time \(n\) are measurable with respect to the time-\(n\) history. -/)
  (proof := /-- For each \(k<n\), the product \(\lambda_k(X_k-m)\) is history-measurable by
  \cref{lem:betting-history-bet-measurable-for-oscillation} and
  \cref{lem:betting-history-observation-measurable-for-oscillation}.  Squaring and summing
  finitely many such products preserves measurability. -/)
  (title := /-- Realized squared increments are history-measurable -/)
  (latexEnv := "lemma")]
lemma betting_realized_square_history_measurable_for_oscillation
    {Ω : Type*} [MeasurableSpace Ω] (m : ℝ) (X lam : ℕ → Ω → ℝ)
    (hpred : is_predictable_bet X lam) (n : ℕ) :
    @Measurable Ω ℝ (betting_history X n) inferInstance
      (fun ω => ∑ k ∈ Finset.range n, (lam k ω * (X k ω - m)) ^ 2) := by
  apply Finset.measurable_sum
  intro k hk
  have hklt : k < n := Finset.mem_range.mp hk
  exact ((betting_history_bet_measurable_for_oscillation X lam hpred hklt.le).mul
    ((betting_history_observation_measurable_for_oscillation X hklt).sub
      measurable_const)).pow_const 2

@[blueprint "lem:null-mean-strict-unit-interval-for-oscillation"
  (statement := /-- In a non-degenerate betting null model supported on \([0,1]\), the mean
  satisfies \(0<m<1\). -/)
  (proof := /-- By \cref{lem:null-mean-mem-unit-interval}, it remains to exclude the two
  endpoints.  If \(m=0\), non-negativity on the support and vanishing integral force the
  identity function to vanish \(P\)-almost everywhere, so \(P=\delta_0\).  If \(m=1\), the
  same argument applied to \(1-x\) gives \(P=\delta_1\).  Both conclusions contradict the
  non-degeneracy field of \cref{def:betting-null-model}. -/)
  (title := /-- The non-degenerate null mean is interior -/)
  (latexEnv := "lemma")]
lemma null_mean_strict_unit_interval_for_oscillation
    {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X) :
    0 < m ∧ m < 1 := by
  have hm := null_mean_mem_unit_interval μ P m X hmodel
  have hid : Integrable (fun x : ℝ => x) P := by
    apply Integrable.of_bound continuous_id.aestronglyMeasurable 1
    filter_upwards [hmodel.support] with x hx
    simpa [Real.norm_eq_abs, abs_of_nonneg hx.1] using hx.2
  constructor
  · refine lt_of_le_of_ne hm.1 ?_
    intro hmeq
    have hm0 : m = 0 := hmeq.symm
    have hae : (fun x : ℝ => x) =ᵐ[P] 0 := by
      have hnonneg : 0 ≤ᵐ[P] fun x : ℝ => x := by
        filter_upwards [hmodel.support] with x hx
        exact hx.1
      exact (integral_eq_zero_iff_of_nonneg_ae hnonneg hid).mp (by
        simpa [hm0] using hmodel.mean)
    apply hmodel.nondegenerate
    subst m
    calc
      P = Measure.map (fun x : ℝ => x) P := by simp
      _ = Measure.map (fun _ : ℝ => (0 : ℝ)) P := Measure.map_congr hae
      _ = Measure.dirac 0 := by simp
  · refine lt_of_le_of_ne hm.2 ?_
    intro hmeq
    have hm1 : m = 1 := hmeq
    have hone : Integrable (fun _ : ℝ => (1 : ℝ)) P := integrable_const 1
    have hsub : Integrable (fun x : ℝ => 1 - x) P := hone.sub hid
    have hae_sub : (fun x : ℝ => 1 - x) =ᵐ[P] 0 := by
      have hnonneg : 0 ≤ᵐ[P] fun x : ℝ => 1 - x := by
        filter_upwards [hmodel.support] with x hx
        exact sub_nonneg.mpr hx.2
      exact (integral_eq_zero_iff_of_nonneg_ae hnonneg hsub).mp (by
        rw [integral_sub hone hid]
        simp [hmodel.mean, hm1])
    have hae : (fun x : ℝ => x) =ᵐ[P] fun _ => (1 : ℝ) := by
      filter_upwards [hae_sub] with x hx
      dsimp at hx ⊢
      linarith
    apply hmodel.nondegenerate
    subst m
    calc
      P = Measure.map (fun x : ℝ => x) P := by simp
      _ = Measure.map (fun _ : ℝ => (1 : ℝ)) P := Measure.map_congr hae
      _ = Measure.dirac 1 := by simp

@[blueprint "lem:betting-damped-transform-bet-admissible-for-oscillation"
  (statement := /-- For every positive integer offset \(C=c+1\), dividing an admissible bet
  \(\lambda_n\) by \(\max\{1,C+S_n\}\) defines another admissible predictable bet. -/)
  (proof := /-- The transform \(S_n\) is history-measurable by
  \cref{lem:betting-transform-history-measurable-for-oscillation}, so the displayed
  denominator and quotient are predictable.  By
  \cref{lem:null-mean-strict-unit-interval-for-oscillation}, both admissibility endpoints
  have the expected signs.  The reciprocal of the denominator belongs to \([0,1]\), and
  multiplying an element of the admissibility interval by such a scalar preserves that
  interval. -/)
  (title := /-- Admissibility of the damped transform bet -/)
  (latexEnv := "lemma")]
lemma betting_damped_transform_bet_admissible_for_oscillation
    {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X lam : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X)
    (hbet : is_admissible_bet X m lam) (c : ℕ) :
    is_admissible_bet X m (fun n ω =>
      lam n ω / max 1 ((c : ℝ) + 1 + betting_transform m X lam n ω)) := by
  have hm := null_mean_strict_unit_interval_for_oscillation μ P m X hmodel
  constructor
  · intro n
    exact (hbet.1 n).div (measurable_const.max
      (measurable_const.add
        (betting_transform_history_measurable_for_oscillation m X lam hbet.1 n)))
  · intro n ω
    let d := max 1 ((c : ℝ) + 1 + betting_transform m X lam n ω)
    have hd : 1 ≤ d := le_max_left _ _
    have hdpos : 0 < d := lt_of_lt_of_le zero_lt_one hd
    have ht0 : 0 ≤ d⁻¹ := le_of_lt (inv_pos.mpr hdpos)
    have ht1 : d⁻¹ ≤ 1 := (inv_le_one₀ hdpos).mpr hd
    have hleft : -(1 / (1 - m)) ≤ 0 := by
      have : 0 < 1 / (1 - m) := one_div_pos.mpr (sub_pos.mpr hm.2)
      linarith
    have hright : 0 ≤ 1 / m := le_of_lt (one_div_pos.mpr hm.1)
    have hlam := hbet.2 n ω
    change -(1 / (1 - m)) ≤ lam n ω / d ∧ lam n ω / d ≤ 1 / m
    rw [div_eq_mul_inv]
    constructor
    · by_cases hnonneg : 0 ≤ lam n ω
      · exact hleft.trans (mul_nonneg hnonneg ht0)
      · have hneg : lam n ω < 0 := lt_of_not_ge hnonneg
        have hscale : lam n ω ≤ lam n ω * d⁻¹ := by nlinarith
        exact hlam.1.trans hscale
    · by_cases hnonneg : 0 ≤ lam n ω
      · have hscale : lam n ω * d⁻¹ ≤ lam n ω := by nlinarith
        exact hscale.trans hlam.2
      · have hneg : lam n ω < 0 := lt_of_not_ge hnonneg
        exact (mul_nonpos_of_nonpos_of_nonneg (le_of_lt hneg) ht0).trans hright

@[blueprint "lem:betting-transform-converges-if-eventually-lower-bounded"
  (statement := /-- In a betting null model, for almost every sample path, if an admissible
  betting transform is eventually bounded below, then it converges to a finite real limit. -/)
  (proof := /-- For each integer \(c\geq0\), use the admissible damped strategy from
  \cref{lem:betting-damped-transform-bet-admissible-for-oscillation}.  Its wealth converges
  almost surely by \cref{lem:betting-wealth-has-ae-limit}; countability gives one full-measure
  event on which this holds for every \(c\).  An eventually lower-bounded path is globally
  lower-bounded after incorporating its finitely many initial values.  Choose \(C=c+1\) so
  that \(C+S_n\geq1\) for every \(n\).  The maximum in the damped strategy is then inactive,
  and the wealth product telescopes to \((C+S_n)/C\).  Convergence of this affine rescaling
  is equivalent to convergence of \(S_n\). -/)
  (title := /-- One-sided bounded transforms converge -/)
  (latexEnv := "lemma")]
lemma betting_transform_converges_if_eventually_lower_bounded
    {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X lam : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X)
    (hbet : is_admissible_bet X m lam) :
    ∀ᵐ ω ∂μ, (∃ a : ℝ, ∃ N : ℕ, ∀ n ≥ N, a ≤ betting_transform m X lam n ω) →
      ∃ s : ℝ, Tendsto (fun n => betting_transform m X lam n ω) atTop (𝓝 s) := by
  let theta : ℕ → ℕ → Ω → ℝ := fun c n ω =>
    lam n ω / max 1 ((c : ℝ) + 1 + betting_transform m X lam n ω)
  have hlimits : ∀ c : ℕ, ∃ Wlim : Ω → ℝ,
      ∀ᵐ ω ∂μ, Tendsto (fun n => betting_wealth m X (theta c) n ω)
        atTop (𝓝 (Wlim ω)) := by
    intro c
    exact betting_wealth_has_ae_limit μ P m X (theta c) hmodel
      (betting_damped_transform_bet_admissible_for_oscillation μ P m X lam hmodel hbet c)
  choose Wlim hWlim using hlimits
  have hWlim_all : ∀ᵐ ω ∂μ, ∀ c : ℕ,
      Tendsto (fun n => betting_wealth m X (theta c) n ω) atTop (𝓝 (Wlim c ω)) :=
    ae_all_iff.mpr hWlim
  filter_upwards [hWlim_all] with ω hω
  rintro ⟨a, N, hlow⟩
  let R : ℝ := ∑ k ∈ Finset.range N, |betting_transform m X lam k ω|
  let b : ℝ := min a (-R)
  have hglobal : ∀ n : ℕ, b ≤ betting_transform m X lam n ω := by
    intro n
    by_cases hn : N ≤ n
    · exact (min_le_left _ _).trans (hlow n hn)
    · have hnmem : n ∈ Finset.range N := Finset.mem_range.mpr (lt_of_not_ge hn)
      have habs_le : |betting_transform m X lam n ω| ≤ R := by
        unfold R
        exact Finset.single_le_sum (fun i _ => abs_nonneg (betting_transform m X lam i ω)) hnmem
      have hneg : -R ≤ betting_transform m X lam n ω := by
        have := neg_abs_le (betting_transform m X lam n ω)
        linarith
      exact (min_le_right _ _).trans hneg
  obtain ⟨c : ℕ, hc⟩ := exists_nat_ge (1 - b)
  let C : ℝ := (c : ℝ) + 1
  have hCpos : 0 < C := by positivity
  have hCne : C ≠ 0 := ne_of_gt hCpos
  have hdenom : ∀ n : ℕ, 1 ≤ C + betting_transform m X lam n ω := by
    intro n
    have := hglobal n
    dsimp [C]
    exact_mod_cast (by linarith : 1 ≤ (c : ℝ) + 1 + betting_transform m X lam n ω)
  have hwealth : ∀ n : ℕ,
      betting_wealth m X (theta c) n ω =
        (C + betting_transform m X lam n ω) / C := by
    intro n
    induction n with
    | zero => simp [betting_wealth, betting_transform, C, hCne]
    | succ n ih =>
        have hdn : max 1 (C + betting_transform m X lam n ω) =
            C + betting_transform m X lam n ω := max_eq_right (hdenom n)
        have hdnne : C + betting_transform m X lam n ω ≠ 0 :=
          ne_of_gt (lt_of_lt_of_le zero_lt_one (hdenom n))
        rw [betting_wealth, Finset.prod_range_succ]
        rw [show theta c n ω = lam n ω /
            (C + betting_transform m X lam n ω) by simp [theta, C, hdn]]
        rw [show Finset.prod (Finset.range n)
              (fun k => 1 + theta c k ω * (X k ω - m)) =
            (C + betting_transform m X lam n ω) / C by
          simpa [betting_wealth] using ih]
        rw [show betting_transform m X lam (n + 1) ω =
            betting_transform m X lam n ω + lam n ω * (X n ω - m) by
          simp [betting_transform, Finset.sum_range_succ]]
        field_simp
        ring
  have hratio : Tendsto
      (fun n => (C + betting_transform m X lam n ω) / C) atTop (𝓝 (Wlim c ω)) :=
    (hω c).congr' (Filter.Eventually.of_forall fun n => hwealth n)
  refine ⟨C * Wlim c ω - C, ?_⟩
  have hscaled : Tendsto
      (fun n => C * ((C + betting_transform m X lam n ω) / C) - C)
      atTop (𝓝 (C * Wlim c ω - C)) :=
    (tendsto_const_nhds.mul hratio).sub_const C
  refine hscaled.congr' (Filter.Eventually.of_forall fun n => ?_)
  field_simp
  ring

@[blueprint "lem:betting-quadratic-trading-bet-admissible-for-oscillation"
  (statement := /-- Fix \(C=c+1>0\), write
  \(S_n=\sum_{k<n}\lambda_k(X_k-m)\) and
  \(B_n=\sum_{k<n}(\lambda_k(X_k-m))^2\), and set
  \(K_n=C+B_n-S_n^2\).  Clamping the predictable fraction
  \(-2S_n\lambda_n/K_n\) to the admissibility interval produces an admissible predictable
  bet process. -/)
  (proof := /-- Both \(S_n\) and \(B_n\) are history-measurable by
  \cref{lem:betting-transform-history-measurable-for-oscillation} and
  \cref{lem:betting-realized-square-history-measurable-for-oscillation}; hence so are
  \(K_n\), the quotient, and its clamp.  The strict endpoint inequalities from
  \cref{lem:null-mean-strict-unit-interval-for-oscillation} show that the lower endpoint is
  at most the upper endpoint.  The elementary bounds for maximum and minimum then place the
  clamp in the admissibility interval pointwise. -/)
  (title := /-- Admissibility of the quadratic trading strategy -/)
  (latexEnv := "lemma")]
lemma betting_quadratic_trading_bet_admissible_for_oscillation
    {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X lam : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X)
    (hbet : is_admissible_bet X m lam) (c : ℕ) :
    is_admissible_bet X m (fun n ω =>
      max (-(1 / (1 - m))) (min (1 / m)
        ((-2 * betting_transform m X lam n ω * lam n ω) /
          ((c : ℝ) + 1 +
            (∑ k ∈ Finset.range n, (lam k ω * (X k ω - m)) ^ 2) -
            (betting_transform m X lam n ω) ^ 2)))) := by
  have hm := null_mean_strict_unit_interval_for_oscillation μ P m X hmodel
  have hleft : -(1 / (1 - m)) ≤ 0 := by
    have : 0 < 1 / (1 - m) := one_div_pos.mpr (sub_pos.mpr hm.2)
    linarith
  have hright : 0 ≤ 1 / m := le_of_lt (one_div_pos.mpr hm.1)
  constructor
  · intro n
    have hS := betting_transform_history_measurable_for_oscillation m X lam hbet.1 n
    have hB := betting_realized_square_history_measurable_for_oscillation m X lam hbet.1 n
    have hK : @Measurable Ω ℝ (betting_history X n) inferInstance (fun ω =>
        (c : ℝ) + 1 + (∑ k ∈ Finset.range n, (lam k ω * (X k ω - m)) ^ 2) -
          (betting_transform m X lam n ω) ^ 2) :=
      ((measurable_const.add hB).sub (hS.pow_const 2))
    exact measurable_const.max (measurable_const.min
      (((measurable_const.mul hS).mul (hbet.1 n)).div hK))
  · intro n ω
    constructor
    · exact le_max_left _ _
    · apply max_le
      · exact hleft.trans hright
      · exact min_le_left _ _

@[blueprint "lem:betting-realized-squares-summable-if-transform-converges"
  (statement := /-- In a non-degenerate betting null model, almost every path on which the
  centered betting transform converges has summable squared realized increments
  \(\sum_n(\lambda_n(X_n-m))^2<\infty\). -/)
  (proof := /-- Apply \cref{lem:betting-wealth-has-ae-limit} simultaneously to the countable
  family of admissible quadratic strategies from
  \cref{lem:betting-quadratic-trading-bet-admissible-for-oscillation}.  On a path where
  \(S_n\) converges, use \cref{lem:null-mean-strict-unit-interval-for-oscillation} to choose
  a uniform bound \(|S_n|\leq R\) and a uniform admissibility bound
  \(|\lambda_n|\leq L\).  If the realized square sum \(B_n\) diverged, choose \(C=c+1\) so
  large that \(K_n=C+B_n-S_n^2\) stays positive and the unclamped fraction
  \(-2S_n\lambda_n/K_n\) lies strictly inside the admissibility interval.  The clamp is then
  inactive.  Since
  \[
    K_{n+1}-K_n=-2S_n\lambda_n(X_n-m),
  \]
  the corresponding wealth telescopes to \(K_n/C\), which tends to \(+\infty\) as
  \(B_n\to+\infty\).  This contradicts its finite almost-sure limit. -/)
  (title := /-- Convergent transforms have finite realized quadratic variation -/)
  (latexEnv := "lemma")]
lemma betting_realized_squares_summable_if_transform_converges
    {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X lam : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X)
    (hbet : is_admissible_bet X m lam) :
    ∀ᵐ ω ∂μ, (∃ s : ℝ,
      Tendsto (fun n => betting_transform m X lam n ω) atTop (𝓝 s)) →
      Summable (fun n => (lam n ω * (X n ω - m)) ^ 2) := by
  let quadBet : ℕ → ℕ → Ω → ℝ := fun c n ω =>
    max (-(1 / (1 - m))) (min (1 / m)
      ((-2 * betting_transform m X lam n ω * lam n ω) /
        ((c : ℝ) + 1 +
          (∑ k ∈ Finset.range n, (lam k ω * (X k ω - m)) ^ 2) -
          (betting_transform m X lam n ω) ^ 2)))
  have hlimits : ∀ c : ℕ, ∃ Wlim : Ω → ℝ,
      ∀ᵐ ω ∂μ, Tendsto (fun n => betting_wealth m X (quadBet c) n ω)
        atTop (𝓝 (Wlim ω)) := by
    intro c
    exact betting_wealth_has_ae_limit μ P m X (quadBet c) hmodel
      (betting_quadratic_trading_bet_admissible_for_oscillation μ P m X lam hmodel hbet c)
  choose Wlim hWlim using hlimits
  have hWlim_all : ∀ᵐ ω ∂μ, ∀ c : ℕ,
      Tendsto (fun n => betting_wealth m X (quadBet c) n ω) atTop (𝓝 (Wlim c ω)) :=
    ae_all_iff.mpr hWlim
  filter_upwards [hWlim_all] with ω hω
  rintro ⟨s, hS⟩
  by_contra hsum
  have hm := null_mean_strict_unit_interval_for_oscillation μ P m X hmodel
  obtain ⟨u, hu⟩ := hS.bddAbove_range
  obtain ⟨l, hl⟩ := hS.bddBelow_range
  let R : ℝ := max |l| |u|
  have hR0 : 0 ≤ R := le_max_of_le_left (abs_nonneg l)
  have hSabs : ∀ n : ℕ, |betting_transform m X lam n ω| ≤ R := by
    intro n
    apply abs_le.mpr
    constructor
    · have hln : l ≤ betting_transform m X lam n ω := hl ⟨n, rfl⟩
      have : -R ≤ l := by
        have := neg_abs_le l
        exact (neg_le_neg (le_max_left |l| |u|)).trans this
      exact this.trans hln
    · have hun : betting_transform m X lam n ω ≤ u := hu ⟨n, rfl⟩
      exact hun.trans (le_trans (le_abs_self u) (le_max_right |l| |u|))
  let A : ℝ := 1 / (1 - m)
  let U : ℝ := 1 / m
  let L : ℝ := max A U
  let d : ℝ := min A U
  have hA : 0 < A := one_div_pos.mpr (sub_pos.mpr hm.2)
  have hU : 0 < U := one_div_pos.mpr hm.1
  have hL0 : 0 ≤ L := le_trans (le_of_lt hA) (le_max_left _ _)
  have hd : 0 < d := lt_min hA hU
  have hlamabs : ∀ n : ℕ, |lam n ω| ≤ L := by
    intro n
    apply abs_le.mpr
    constructor
    · exact (neg_le_neg (le_max_left A U)).trans (hbet.2 n ω).1
    · exact (hbet.2 n ω).2.trans (le_max_right A U)
  obtain ⟨c : ℕ, hc⟩ := exists_nat_ge (R ^ 2 + 2 * R * L / d + 1)
  let C : ℝ := (c : ℝ) + 1
  have hCpos : 0 < C := by positivity
  have hCne : C ≠ 0 := ne_of_gt hCpos
  let B : ℕ → ℝ := fun n =>
    ∑ k ∈ Finset.range n, (lam k ω * (X k ω - m)) ^ 2
  let K : ℕ → ℝ := fun n => C + B n - (betting_transform m X lam n ω) ^ 2
  have hB0 : ∀ n : ℕ, 0 ≤ B n := by
    intro n
    exact Finset.sum_nonneg fun _ _ => sq_nonneg _
  have hKlower : ∀ n : ℕ, 2 * R * L / d + 1 ≤ K n := by
    intro n
    have hsquare : (betting_transform m X lam n ω) ^ 2 ≤ R ^ 2 := by
      simpa [sq_abs] using
        ((sq_le_sq₀ (abs_nonneg (betting_transform m X lam n ω)) hR0).mpr (hSabs n))
    dsimp [K, C]
    have hcast : R ^ 2 + 2 * R * L / d + 1 ≤ (c : ℝ) := hc
    nlinarith [hB0 n]
  have hKpos : ∀ n : ℕ, 0 < K n := by
    intro n
    have hfrac : 0 ≤ 2 * R * L / d := div_nonneg (mul_nonneg (mul_nonneg (by norm_num) hR0) hL0)
      (le_of_lt hd)
    linarith [hKlower n]
  have hrawabs : ∀ n : ℕ,
      |(-2 * betting_transform m X lam n ω * lam n ω) / K n| ≤ d := by
    intro n
    have hnum : |-2 * betting_transform m X lam n ω * lam n ω| ≤ 2 * R * L := by
      rw [abs_mul, abs_mul]
      norm_num
      gcongr
      · exact hSabs n
      · exact hlamabs n
    rw [abs_div, abs_of_pos (hKpos n)]
    apply (div_le_iff₀ (hKpos n)).mpr
    have hgap := hKlower n
    have hmul : d * (2 * R * L / d + 1) ≤ d * K n :=
      mul_le_mul_of_nonneg_left hgap (le_of_lt hd)
    have hbase : 2 * R * L ≤ d * (2 * R * L / d + 1) := by
      field_simp
      nlinarith [hR0, hL0, le_of_lt hd]
    exact hnum.trans (hbase.trans hmul)
  have hquad_eq : ∀ n : ℕ, quadBet c n ω =
      (-2 * betting_transform m X lam n ω * lam n ω) / K n := by
    intro n
    have hlower : -A ≤ (-2 * betting_transform m X lam n ω * lam n ω) / K n := by
      have hda : d ≤ A := min_le_left _ _
      have := (abs_le.mp (hrawabs n)).1
      linarith
    have hupper : (-2 * betting_transform m X lam n ω * lam n ω) / K n ≤ U := by
      have hdu : d ≤ U := min_le_right _ _
      have := (abs_le.mp (hrawabs n)).2
      linarith
    change max (-A) (min U
      ((-2 * betting_transform m X lam n ω * lam n ω) / K n)) =
        (-2 * betting_transform m X lam n ω * lam n ω) / K n
    rw [min_eq_right hupper, max_eq_right hlower]
  have hwealth : ∀ n : ℕ,
      betting_wealth m X (quadBet c) n ω = K n / C := by
    intro n
    induction n with
    | zero => simp [betting_wealth, betting_transform, B, K, C, hCne]
    | succ n ih =>
        rw [betting_wealth, Finset.prod_range_succ]
        rw [show Finset.prod (Finset.range n)
              (fun k => 1 + quadBet c k ω * (X k ω - m)) = K n / C by
          simpa [betting_wealth] using ih]
        rw [hquad_eq n]
        have hSsucc : betting_transform m X lam (n + 1) ω =
            betting_transform m X lam n ω + lam n ω * (X n ω - m) := by
          simp [betting_transform, Finset.sum_range_succ]
        have hBsucc : B (n + 1) = B n + (lam n ω * (X n ω - m)) ^ 2 := by
          simp [B, Finset.sum_range_succ]
        rw [show K (n + 1) = K n -
            2 * betting_transform m X lam n ω * lam n ω * (X n ω - m) by
          simp only [K, hSsucc, hBsucc]
          ring]
        field_simp [ne_of_gt (hKpos n)]
        ring
  have hBtop : Tendsto B atTop atTop := by
    apply (not_summable_iff_tendsto_nat_atTop_of_nonneg
      (fun n => sq_nonneg (lam n ω * (X n ω - m)))).mp at hsum
    simpa [B] using hsum
  have hKtop : Tendsto K atTop atTop := by
    rw [Filter.tendsto_atTop]
    intro z
    have hevent := (Filter.tendsto_atTop.1 hBtop (z - (C - R ^ 2)))
    filter_upwards [hevent] with n hn
    have hsquare : (betting_transform m X lam n ω) ^ 2 ≤ R ^ 2 := by
      simpa [sq_abs] using
        ((sq_le_sq₀ (abs_nonneg (betting_transform m X lam n ω)) hR0).mpr (hSabs n))
    dsimp [K]
    linarith
  have hwealth_top : Tendsto (fun n => betting_wealth m X (quadBet c) n ω)
      atTop atTop := by
    have hdiv : Tendsto (fun n => K n / C) atTop atTop := hKtop.atTop_div_const hCpos
    exact hdiv.congr' (Filter.Eventually.of_forall fun n => (hwealth n).symm)
  exact (not_tendsto_nhds_of_tendsto_atTop hwealth_top (Wlim c ω)) (hω c)

@[blueprint "lem:null-exp-mean-strictly-exceeds-exp-mean"
  (statement := /-- In a non-degenerate betting null model,
  \(e^m<\int e^x\,dP(x)\). -/)
  (proof := /-- The tangent inequality
  \(e^x\geq e^m(1+x-m)\) follows from \(1+t\leq e^t\), and is strict unless \(x=m\).
  Its non-negative gap is integrable because \cref{def:betting-null-model} supports \(P\)
  on \([0,1]\).  If the gap had zero integral, it would vanish almost everywhere; strictness
  would then give \(x=m\) almost everywhere and hence \(P=\delta_m\), contradicting
  non-degeneracy.  Thus the gap has positive integral.  Finally, the mean identity
  \(\int x\,dP=m\) reduces that integral to \(\int e^x\,dP-e^m\). -/)
  (title := /-- Strict Jensen inequality for the exponential null transform -/)
  (latexEnv := "lemma")]
lemma null_exp_mean_strictly_exceeds_exp_mean
    {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X) :
    Real.exp m < ∫ x, Real.exp x ∂P := by
  have hexp : Integrable (fun x : ℝ => Real.exp x) P := by
    apply Integrable.of_bound Real.continuous_exp.aestronglyMeasurable (Real.exp 1)
    filter_upwards [hmodel.support] with x hx
    rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos x)]
    exact Real.exp_le_exp.mpr hx.2
  have hid : Integrable (fun x : ℝ => x) P := by
    apply Integrable.of_bound continuous_id.aestronglyMeasurable 1
    filter_upwards [hmodel.support] with x hx
    simpa [Real.norm_eq_abs, abs_of_nonneg hx.1] using hx.2
  let gap : ℝ → ℝ := fun x => Real.exp x - Real.exp m * (1 + x - m)
  have hgap_nonneg : ∀ x : ℝ, 0 ≤ gap x := by
    intro x
    have ht := Real.add_one_le_exp (x - m)
    have hem : 0 < Real.exp m := Real.exp_pos m
    rw [Real.exp_sub] at ht
    have ht' := (le_div_iff₀ hem).mp ht
    dsimp [gap]
    nlinarith
  have hlinear : Integrable (fun x : ℝ => Real.exp m * (1 + x - m)) P := by
    have hone : Integrable (fun _ : ℝ => (1 : ℝ)) P := integrable_const 1
    have hmconst : Integrable (fun _ : ℝ => m) P := integrable_const m
    exact ((hone.add hid).sub hmconst).const_mul _
  have hgap : Integrable gap P := hexp.sub hlinear
  have hgap_pos : 0 < ∫ x, gap x ∂P := by
    have hnonneg : 0 ≤ ∫ x, gap x ∂P := integral_nonneg hgap_nonneg
    refine lt_of_le_of_ne hnonneg ?_
    intro hzero
    have hae_gap : gap =ᵐ[P] 0 :=
      (integral_eq_zero_iff_of_nonneg hgap_nonneg hgap).mp hzero.symm
    have hae : (fun x : ℝ => x) =ᵐ[P] fun _ => m := by
      filter_upwards [hae_gap] with x hx
      by_contra hxm
      have hstrict := Real.add_one_lt_exp (sub_ne_zero.mpr hxm)
      have hem : 0 < Real.exp m := Real.exp_pos m
      rw [Real.exp_sub] at hstrict
      have hstrict' := (lt_div_iff₀ hem).mp hstrict
      dsimp [gap] at hx
      nlinarith
    apply hmodel.nondegenerate
    calc
      P = Measure.map (fun x : ℝ => x) P := by simp
      _ = Measure.map (fun _ : ℝ => m) P := Measure.map_congr hae
      _ = Measure.dirac m := by simp
  change 0 < ∫ x, Real.exp x - Real.exp m * (1 + x - m) ∂P at hgap_pos
  rw [integral_sub hexp hlinear, integral_const_mul] at hgap_pos
  have hone : Integrable (fun _ : ℝ => (1 : ℝ)) P := integrable_const 1
  have hmconst : Integrable (fun _ : ℝ => m) P := integrable_const m
  have hlinint : ∫ x : ℝ, 1 + x - m ∂P = 1 := by
    have hs := integral_sub (hone.add hid) hmconst
    have ha := integral_add hone hid
    calc
      (∫ x : ℝ, 1 + x - m ∂P) =
          (∫ x : ℝ, 1 + x ∂P) - ∫ _ : ℝ, m ∂P := by
            simpa only [Pi.sub_apply, Pi.add_apply] using hs
      _ = ((∫ _ : ℝ, 1 ∂P) + ∫ x : ℝ, x ∂P) - ∫ _ : ℝ, m ∂P := by
            rw [ha]
      _ = 1 := by simp [hmodel.mean]
  rw [hlinint] at hgap_pos
  linarith

@[blueprint "lem:exponential-null-model-for-oscillation"
  (statement := /-- Put \(h(x)=e^x/e\), \(Y_n=h(X_n)\),
  \(Q=P\circ h^{-1}\), and \(q=\int h\,dP\).  Then \((\mu,Q,q,Y)\) is a betting null
  model. -/)
  (proof := /-- Coordinatewise measurable transformations preserve independence and common
  law.  On the support \([0,1]\), monotonicity of the exponential gives
  \(0<h(x)\leq1\), so pushforward gives the required support, and change of variables gives
  the mean \(q\).  Finally, \(h\) is globally injective, with measurable left inverse
  \(y\mapsto\log(ey)\).  If \(Q\) were a point mass, then \(X_n\), and hence \(P\), would be
  almost surely constant; the mean identity would identify that constant with \(m\), contrary
  to the non-degeneracy field of \cref{def:betting-null-model}. -/)
  (title := /-- Exponential recoding of a betting null model -/)
  (latexEnv := "lemma")]
lemma exponential_null_model_for_oscillation
    {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X)
    [IsProbabilityMeasure (Measure.map (fun x : ℝ => Real.exp x / Real.exp 1) P)] :
    betting_null_model μ (Measure.map (fun x : ℝ => Real.exp x / Real.exp 1) P)
      (∫ x, Real.exp x / Real.exp 1 ∂P)
      (fun n ω => Real.exp (X n ω) / Real.exp 1) := by
  let h : ℝ → ℝ := fun x => Real.exp x / Real.exp 1
  have hh : Measurable h := Real.measurable_exp.div_const _
  constructor
  · have hi := hmodel.independent.comp (fun _ => h) (fun _ => hh)
    simpa [h, Function.comp_def] using hi
  · intro n
    have hcomp := (hmodel.commonLaw n).comp hh
    have hmap : IdentDistrib h id P (Measure.map h P) := by
      refine ⟨hh.aemeasurable, measurable_id.aemeasurable, ?_⟩
      simp [hh]
    simpa [h, Function.comp_def] using hcomp.trans hmap
  · apply (ae_map_iff hh.aemeasurable measurableSet_Icc).mpr
    filter_upwards [hmodel.support] with x hx
    constructor
    · exact le_of_lt (div_pos (Real.exp_pos x) (Real.exp_pos 1))
    · exact (div_le_one (Real.exp_pos 1)).mpr (Real.exp_le_exp.mpr hx.2)
  · simpa [h] using
      (integral_map hh.aemeasurable
        (continuous_id.aestronglyMeasurable :
          AEStronglyMeasurable (fun x : ℝ => x) (Measure.map h P)))
  · intro hdeg
    let q : ℝ := ∫ x, h x ∂P
    have hq : ∀ᵐ y ∂Measure.map h P, y = q := by
      rw [show Measure.map h P = Measure.dirac q by simpa [h, q] using hdeg]
      simp
    have hhp : ∀ᵐ x ∂P, h x = q :=
      (ae_map_iff hh.aemeasurable (measurableSet_singleton q)).mp hq
    let r : ℝ := Real.log (q * Real.exp 1)
    have hxp : (fun x : ℝ => x) =ᵐ[P] fun _ => r := by
      filter_upwards [hhp] with x hx
      have hx' := congrArg (fun y : ℝ => Real.log (y * Real.exp 1)) hx
      dsimp [h, r] at hx' ⊢
      field_simp at hx'
      simpa [mul_comm] using hx'
    have hmr : m = r := by
      rw [← hmodel.mean, integral_congr_ae hxp]
      simp
    apply hmodel.nondegenerate
    calc
      P = Measure.map (fun x : ℝ => x) P := by simp
      _ = Measure.map (fun _ : ℝ => r) P := Measure.map_congr hxp
      _ = Measure.dirac r := by simp
      _ = Measure.dirac m := by rw [hmr]

@[blueprint "lem:exponential-history-dominates-for-oscillation"
  (statement := /-- The strict-past history generated by \(X_k\) is contained in the
  strict-past history generated by \(e^{X_k}/e\) at every time. -/)
  (proof := /-- The measurable function \(j(y)=\log(ey)\) is a left inverse of
  \(h(x)=e^x/e\) on all real \(x\).  Thus each past observation \(X_k=j(h(X_k))\) is
  measurable with respect to the pullback generated by \(h(X_k)\).  Taking the supremum over
  \(k<n\) in \cref{def:betting-history} gives the claimed inclusion. -/)
  (title := /-- Exponential recoding preserves the full history -/)
  (latexEnv := "lemma")]
lemma exponential_history_dominates_for_oscillation
    {Ω : Type*} [MeasurableSpace Ω] (X : ℕ → Ω → ℝ) (n : ℕ) :
    betting_history X n ≤
      betting_history (fun k ω => Real.exp (X k ω) / Real.exp 1) n := by
  let Y : ℕ → Ω → ℝ := fun k ω => Real.exp (X k ω) / Real.exp 1
  let j : ℝ → ℝ := fun y => Real.log (y * Real.exp 1)
  have hj : Measurable j := Real.measurable_log.comp (measurable_id.mul_const _)
  unfold betting_history
  refine iSup_le fun k => ?_
  have hY : @Measurable Ω ℝ
      (MeasurableSpace.comap (Y k) inferInstance) inferInstance (Y k) := comap_measurable _
  have hX : @Measurable Ω ℝ
      (MeasurableSpace.comap (Y k) inferInstance) inferInstance (X k) := by
    have hcomp := hj.comp hY
    convert hcomp using 1
    funext ω
    dsimp [j, Y]
    field_simp
    simp
  have hcomap := hX.comap_le
  have hterm := le_iSup
    (fun q : Fin n => MeasurableSpace.comap
      ((fun k ω => Real.exp (X k ω) / Real.exp 1) (q : ℕ)) inferInstance) k
  exact hcomap.trans hterm

@[blueprint "lem:exponential-capital-bet-admissible-for-oscillation"
  (statement := /-- Let \(Y_n=e^{X_n}/e\), \(q=\mathbb E_P[e^X/e]\), and
  \(w_n=\lambda_n^2\).  For \(K_n=C+\sum_{k<n}w_k(q-Y_k)\), clamping
  \(-w_n/K_n\) to the admissibility interval at mean \(q\) gives an admissible predictable
  bet for the \(Y\)-process. -/)
  (proof := /-- By \cref{lem:exponential-history-dominates-for-oscillation}, every
  \(X\)-predictable \(\lambda_n\), hence every \(w_n=\lambda_n^2\), remains predictable for
  the exponentially recoded history.  The history monotonicity in
  \cref{lem:betting-history-mono-for-oscillation} and past-observation measurability in
  \cref{lem:betting-history-observation-measurable-for-oscillation} show that past
  \(Y_k\)'s and the relevant finite sums are history-measurable, so \(K_n\), the quotient,
  and its clamp are predictable.  The recoded process is a
  non-degenerate null model by \cref{lem:exponential-null-model-for-oscillation}; applying
  \cref{lem:null-mean-strict-unit-interval-for-oscillation} to it places \(q\) strictly
  between zero and one.  The elementary bounds for minimum and maximum then prove pointwise
  admissibility. -/)
  (title := /-- Admissibility of the exponential capital strategy -/)
  (latexEnv := "lemma")]
lemma exponential_capital_bet_admissible_for_oscillation
    {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X lam : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X)
    (hbet : is_admissible_bet X m lam)
    [IsProbabilityMeasure (Measure.map (fun x : ℝ => Real.exp x / Real.exp 1) P)]
    (c : ℕ) :
    let Y : ℕ → Ω → ℝ := fun n ω => Real.exp (X n ω) / Real.exp 1
    let q : ℝ := ∫ x, Real.exp x / Real.exp 1 ∂P
    is_admissible_bet Y q (fun n ω =>
      max (-(1 / (1 - q))) (min (1 / q)
        (-(lam n ω) ^ 2 /
          ((c : ℝ) + 1 +
            ∑ k ∈ Finset.range n, (lam k ω) ^ 2 * (q - Y k ω))))) := by
  dsimp only
  let Y : ℕ → Ω → ℝ := fun n ω => Real.exp (X n ω) / Real.exp 1
  let q : ℝ := ∫ x, Real.exp x / Real.exp 1 ∂P
  have hYmodel := exponential_null_model_for_oscillation μ P m X hmodel
  have hq := null_mean_strict_unit_interval_for_oscillation μ
    (Measure.map (fun x : ℝ => Real.exp x / Real.exp 1) P) q Y hYmodel
  have hlower : -(1 / (1 - q)) ≤ 1 / q := by
    have hleft : -(1 / (1 - q)) ≤ 0 := by
      have : 0 < 1 / (1 - q) := one_div_pos.mpr (sub_pos.mpr hq.2)
      linarith
    exact hleft.trans (le_of_lt (one_div_pos.mpr hq.1))
  constructor
  · intro n
    have hlamY : @Measurable Ω ℝ (betting_history Y n) inferInstance (lam n) :=
      (hbet.1 n).mono (exponential_history_dominates_for_oscillation X n) le_rfl
    have hsum : @Measurable Ω ℝ (betting_history Y n) inferInstance (fun ω =>
        ∑ k ∈ Finset.range n, (lam k ω) ^ 2 * (q - Y k ω)) := by
      apply Finset.measurable_sum
      intro k hk
      have hklt : k < n := Finset.mem_range.mp hk
      have hlamk : @Measurable Ω ℝ (betting_history Y n) inferInstance (lam k) :=
        ((hbet.1 k).mono (exponential_history_dominates_for_oscillation X k) le_rfl).mono
          (betting_history_mono_for_oscillation Y hklt.le) le_rfl
      have hYk := betting_history_observation_measurable_for_oscillation Y hklt
      exact (hlamk.pow_const 2).mul (measurable_const.sub hYk)
    have hK : @Measurable Ω ℝ (betting_history Y n) inferInstance (fun ω =>
        (c : ℝ) + 1 + ∑ k ∈ Finset.range n, (lam k ω) ^ 2 * (q - Y k ω)) :=
      measurable_const.add hsum
    exact measurable_const.max (measurable_const.min ((hlamY.pow_const 2).neg.div hK))
  · intro n ω
    constructor
    · exact le_max_left _ _
    · exact max_le hlower (min_le_left _ _)

@[blueprint "lem:betting-realized-squares-diverge-with-squared-bets"
  (statement := /-- In a non-degenerate betting null model, almost surely, divergence of
  \(\sum_n\lambda_n^2\) implies divergence of
  \(\sum_n(\lambda_n(X_n-m))^2\). -/)
  (proof := /-- Recode the observations as \(Y_n=e^{X_n}/e\).  By
  \cref{lem:exponential-null-model-for-oscillation}, this is again a non-degenerate betting
  null model.  The admissible capital strategies constructed in
  \cref{lem:exponential-capital-bet-admissible-for-oscillation} preserve the predictability
  of \(w_n=\lambda_n^2\).  Let \(q=\mathbb E[Y_0]\) and
  \(\delta=q-e^m/e>0\); positivity follows from
  \cref{lem:null-exp-mean-strictly-exceeds-exp-mean}.  The interval bounds used below are
  supplied by \cref{lem:null-mean-mem-unit-interval} and
  \cref{lem:null-mean-strict-unit-interval-for-oscillation}.  On \([0,1]\), the bound
  \(|e^x/e-e^m/e|\leq2|x-m|\), followed by Young's inequality, gives
  \[
    q-Y_n\geq \frac\delta2-\frac2\delta(X_n-m)^2.
  \]
  Hence, if \(A_n=\sum_{k<n}w_k\to\infty\) while
  \(B_n=\sum_{k<n}w_k(X_k-m)^2\) remains bounded, then
  \(K_n=C+\sum_{k<n}w_k(q-Y_k)\to\infty\).  Choose \(C\) large enough that \(K_n\) is
  uniformly positive and the clamp in
  exponential capital strategy is inactive.  Its wealth telescopes to \(K_n/C\),
  contradicting the finite limit supplied by
  \cref{lem:betting-wealth-has-ae-limit}. -/)
  (title := /-- Divergent squared bets force divergent realized squares -/)
  (latexEnv := "lemma")]
lemma betting_realized_squares_diverge_with_squared_bets
    {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X lam : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X)
    (hbet : is_admissible_bet X m lam) :
    ∀ᵐ ω ∂μ, ¬Summable (fun n => (lam n ω) ^ 2) →
      ¬Summable (fun n => (lam n ω * (X n ω - m)) ^ 2) := by
  let h : ℝ → ℝ := fun x => Real.exp x / Real.exp 1
  let Y : ℕ → Ω → ℝ := fun n ω => h (X n ω)
  let Q : Measure ℝ := Measure.map h P
  let q : ℝ := ∫ x, h x ∂P
  have hh : Measurable h := Real.measurable_exp.div_const _
  letI : IsProbabilityMeasure Q := Measure.isProbabilityMeasure_map hh.aemeasurable
  have hYmodel : betting_null_model μ Q q Y := by
    simpa [h, Y, Q, q] using exponential_null_model_for_oscillation μ P m X hmodel
  let capBet : ℕ → ℕ → Ω → ℝ := fun c n ω =>
    max (-(1 / (1 - q))) (min (1 / q)
      (-(lam n ω) ^ 2 /
        ((c : ℝ) + 1 +
          ∑ k ∈ Finset.range n, (lam k ω) ^ 2 * (q - Y k ω))))
  have hlimits : ∀ c : ℕ, ∃ Wlim : Ω → ℝ,
      ∀ᵐ ω ∂μ, Tendsto (fun n => betting_wealth q Y (capBet c) n ω)
        atTop (𝓝 (Wlim ω)) := by
    intro c
    exact betting_wealth_has_ae_limit μ Q q Y (capBet c) hYmodel (by
      simpa [h, Y, Q, q, capBet] using
        exponential_capital_bet_admissible_for_oscillation μ P m X lam hmodel hbet c)
  choose Wlim hWlim using hlimits
  have hWlim_all : ∀ᵐ ω ∂μ, ∀ c : ℕ,
      Tendsto (fun n => betting_wealth q Y (capBet c) n ω) atTop (𝓝 (Wlim c ω)) :=
    ae_all_iff.mpr hWlim
  have hsupport_each : ∀ n : ℕ, ∀ᵐ ω ∂μ, X n ω ∈ Set.Icc (0 : ℝ) 1 := by
    intro n
    exact (hmodel.commonLaw n).symm.ae_mem_snd measurableSet_Icc hmodel.support
  have hsupport_all : ∀ᵐ ω ∂μ, ∀ n : ℕ, X n ω ∈ Set.Icc (0 : ℝ) 1 :=
    ae_all_iff.mpr hsupport_each
  filter_upwards [hWlim_all, hsupport_all] with ω hω hsupp
  intro hAsum hBsum
  have hm := null_mean_strict_unit_interval_for_oscillation μ P m X hmodel
  have hq := null_mean_strict_unit_interval_for_oscillation μ Q q Y hYmodel
  have hjensen := null_exp_mean_strictly_exceeds_exp_mean μ P m X hmodel
  have hdelta : 0 < q - h m := by
    dsimp [q, h]
    rw [integral_div]
    exact sub_pos.mpr (div_lt_div_of_pos_right hjensen (Real.exp_pos 1))
  let delta : ℝ := q - h m
  have hdelta' : 0 < delta := hdelta
  let A : ℕ → ℝ := fun n => ∑ k ∈ Finset.range n, (lam k ω) ^ 2
  let B : ℕ → ℝ := fun n =>
    ∑ k ∈ Finset.range n, (lam k ω * (X k ω - m)) ^ 2
  have hAtop : Tendsto A atTop atTop := by
    exact (not_summable_iff_tendsto_nat_atTop_of_nonneg (fun n => sq_nonneg (lam n ω))).mp hAsum
  have hBtend : Tendsto B atTop (𝓝 (∑' n, (lam n ω * (X n ω - m)) ^ 2)) := by
    simpa [B] using hBsum.hasSum.tendsto_sum_nat
  obtain ⟨M, hM⟩ := hBtend.bddAbove_range
  have hM0 : 0 ≤ M := by
    have hzero : B 0 = 0 := by simp [B]
    have := hM ⟨0, rfl⟩
    linarith
  have hhm := null_mean_mem_unit_interval μ P m X hmodel
  have hLip : ∀ n : ℕ, |Y n ω - h m| ≤ 2 * |X n ω - m| := by
    intro n
    have habs : |X n ω - m| ≤ 1 := by
      rw [abs_le]
      constructor <;> linarith [(hsupp n).1, (hsupp n).2, hhm.1, hhm.2]
    have hexp := Real.abs_exp_sub_one_le habs
    have hem_le : Real.exp m / Real.exp 1 ≤ 1 :=
      (div_le_one (Real.exp_pos 1)).mpr (Real.exp_le_exp.mpr hhm.2)
    have hem_nonneg : 0 ≤ Real.exp m / Real.exp 1 :=
      le_of_lt (div_pos (Real.exp_pos m) (Real.exp_pos 1))
    dsimp [Y, h]
    rw [show Real.exp (X n ω) / Real.exp 1 - Real.exp m / Real.exp 1 =
        (Real.exp m / Real.exp 1) * (Real.exp (X n ω - m) - 1) by
      rw [Real.exp_sub]
      field_simp
      ]
    rw [abs_mul, abs_of_nonneg hem_nonneg]
    calc
      Real.exp m / Real.exp 1 * |Real.exp (X n ω - m) - 1| ≤
          Real.exp m / Real.exp 1 * (2 * |X n ω - m|) :=
        mul_le_mul_of_nonneg_left hexp hem_nonneg
      _ ≤ 2 * |X n ω - m| :=
        mul_le_of_le_one_left (mul_nonneg (by norm_num) (abs_nonneg _)) hem_le
  have hYoung : ∀ n : ℕ,
      delta / 2 - 2 / delta * (X n ω - m) ^ 2 ≤ q - Y n ω := by
    intro n
    have hlip := hLip n
    have habs0 := abs_nonneg (X n ω - m)
    have hsquare := sq_nonneg (2 * |X n ω - m| - delta)
    have habssq : |X n ω - m| ^ 2 = (X n ω - m) ^ 2 := sq_abs _
    have hyoung : 2 * |X n ω - m| ≤
        delta / 2 + 2 / delta * (X n ω - m) ^ 2 := by
      field_simp [ne_of_gt hdelta']
      nlinarith [habssq]
    have hdiff : -|Y n ω - h m| ≤ h m - Y n ω := by
      rw [abs_sub_comm]
      exact neg_abs_le (h m - Y n ω)
    have herr : -(delta / 2 + 2 / delta * (X n ω - m) ^ 2) ≤ h m - Y n ω := by
      linarith
    have hidelta : q - Y n ω = delta + (h m - Y n ω) := by simp [delta]
    rw [hidelta]
    linarith
  let Abound : ℝ := max (1 / (1 - m)) (1 / m)
  have hAbound0 : 0 ≤ Abound := by
    exact le_trans (le_of_lt (one_div_pos.mpr (sub_pos.mpr hm.2))) (le_max_left _ _)
  have hlamSq : ∀ n : ℕ, (lam n ω) ^ 2 ≤ Abound ^ 2 := by
    intro n
    have habs : |lam n ω| ≤ Abound := by
      apply abs_le.mpr
      constructor
      · exact (neg_le_neg (le_max_left _ _)).trans (hbet.2 n ω).1
      · exact (hbet.2 n ω).2.trans (le_max_right _ _)
    simpa [sq_abs] using ((sq_le_sq₀ (abs_nonneg (lam n ω)) hAbound0).mpr habs)
  obtain ⟨c : ℕ, hc⟩ := exists_nat_ge
    (2 / delta * M + max 1 ((1 - q) * Abound ^ 2) + 1)
  let C : ℝ := (c : ℝ) + 1
  have hCpos : 0 < C := by positivity
  have hCne : C ≠ 0 := ne_of_gt hCpos
  let K : ℕ → ℝ := fun n => C +
    ∑ k ∈ Finset.range n, (lam k ω) ^ 2 * (q - Y k ω)
  have hKbound : ∀ n : ℕ,
      C + delta / 2 * A n - 2 / delta * B n ≤ K n := by
    intro n
    have hsum : (∑ k ∈ Finset.range n,
        (lam k ω) ^ 2 * (delta / 2 - 2 / delta * (X k ω - m) ^ 2)) ≤
        ∑ k ∈ Finset.range n, (lam k ω) ^ 2 * (q - Y k ω) := by
      apply Finset.sum_le_sum
      intro k hk
      exact mul_le_mul_of_nonneg_left (hYoung k) (sq_nonneg _)
    have heq : delta / 2 * A n - 2 / delta * B n =
        ∑ k ∈ Finset.range n,
          (lam k ω) ^ 2 * (delta / 2 - 2 / delta * (X k ω - m) ^ 2) := by
      dsimp [A, B]
      simp_rw [mul_sub]
      rw [Finset.sum_sub_distrib]
      simp only [Finset.mul_sum]
      congr 1 <;> apply Finset.sum_congr rfl <;> intro k hk <;> ring
    dsimp [K]
    calc
      C + delta / 2 * A n - 2 / delta * B n =
          C + (delta / 2 * A n - 2 / delta * B n) := by ring
      _ = C + ∑ k ∈ Finset.range n,
          (lam k ω) ^ 2 * (delta / 2 - 2 / delta * (X k ω - m) ^ 2) := by rw [heq]
      _ ≤ C + ∑ k ∈ Finset.range n, (lam k ω) ^ 2 * (q - Y k ω) := by
        simpa [add_comm] using add_le_add_left hsum C
  have hKbase : ∀ n : ℕ, max 1 ((1 - q) * Abound ^ 2) ≤ K n := by
    intro n
    have hBn : B n ≤ M := hM ⟨n, rfl⟩
    have hAn : 0 ≤ A n := Finset.sum_nonneg fun _ _ => sq_nonneg _
    have hcast : 2 / delta * M + max 1 ((1 - q) * Abound ^ 2) + 1 ≤ (c : ℝ) := hc
    have hcoef : 0 ≤ 2 / delta := div_nonneg (by norm_num) (le_of_lt hdelta')
    have hCbound : 2 / delta * M + max 1 ((1 - q) * Abound ^ 2) + 1 ≤ C := by
      dsimp [C]
      linarith
    linarith [hKbound n, mul_nonneg (le_of_lt (half_pos hdelta')) hAn,
      mul_le_mul_of_nonneg_left hBn hcoef, hCbound]
  have hKpos : ∀ n : ℕ, 0 < K n := by
    intro n
    exact lt_of_lt_of_le zero_lt_one ((le_max_left _ _).trans (hKbase n))
  have hcap_eq : ∀ n : ℕ, capBet c n ω = -(lam n ω) ^ 2 / K n := by
    intro n
    have hupper : -(lam n ω) ^ 2 / K n ≤ 1 / q := by
      have : -(lam n ω) ^ 2 / K n ≤ 0 := div_nonpos_of_nonpos_of_nonneg
        (neg_nonpos.mpr (sq_nonneg _)) (le_of_lt (hKpos n))
      exact this.trans (le_of_lt (one_div_pos.mpr hq.1))
    have hlower : -(1 / (1 - q)) ≤ -(lam n ω) ^ 2 / K n := by
      rw [neg_div, neg_le_neg_iff]
      apply (div_le_iff₀ (hKpos n)).mpr
      have hqnonneg : 0 ≤ 1 - q := le_of_lt (sub_pos.mpr hq.2)
      have hbase := (le_max_right 1 ((1 - q) * Abound ^ 2)).trans (hKbase n)
      have := hlamSq n
      have hmul := mul_le_mul_of_nonneg_left this hqnonneg
      have hwK : (1 - q) * (lam n ω) ^ 2 ≤ K n := hmul.trans hbase
      calc
        (lam n ω) ^ 2 ≤ K n / (1 - q) :=
          (le_div_iff₀ (sub_pos.mpr hq.2)).mpr (by simpa [mul_comm] using hwK)
        _ = (1 / (1 - q)) * K n := by field_simp
    change max (-(1 / (1 - q))) (min (1 / q) (-(lam n ω) ^ 2 / K n)) =
      -(lam n ω) ^ 2 / K n
    rw [min_eq_right hupper, max_eq_right hlower]
  have hwealth : ∀ n : ℕ, betting_wealth q Y (capBet c) n ω = K n / C := by
    intro n
    induction n with
    | zero => simp [betting_wealth, K, C, hCne]
    | succ n ih =>
        rw [betting_wealth, Finset.prod_range_succ]
        rw [show Finset.prod (Finset.range n)
              (fun k => 1 + capBet c k ω * (Y k ω - q)) = K n / C by
          simpa [betting_wealth] using ih]
        rw [hcap_eq n]
        rw [show K (n + 1) = K n + (lam n ω) ^ 2 * (q - Y n ω) by
          simp [K, Finset.sum_range_succ]
          ring]
        field_simp [ne_of_gt (hKpos n)]
        ring
  have hKtop : Tendsto K atTop atTop := by
    rw [Filter.tendsto_atTop]
    intro z
    have hevent := Filter.tendsto_atTop.1 hAtop
      (((2 / delta) * M + (z - C) + 1) * (2 / delta))
    filter_upwards [hevent] with n hn
    have hBn : B n ≤ M := hM ⟨n, rfl⟩
    have hcoef : 0 < delta / 2 := half_pos hdelta'
    have hnonneg : 0 ≤ 2 / delta := div_nonneg (by norm_num) (le_of_lt hdelta')
    have hmain := hKbound n
    have hAlarge : z ≤ C + delta / 2 * A n - 2 / delta * B n := by
      field_simp [ne_of_gt hdelta'] at hn ⊢
      nlinarith [mul_le_mul_of_nonneg_left hBn hnonneg]
    exact hAlarge.trans hmain
  have hwealth_top : Tendsto (fun n => betting_wealth q Y (capBet c) n ω) atTop atTop := by
    have hdiv : Tendsto (fun n => K n / C) atTop atTop := hKtop.atTop_div_const hCpos
    exact hdiv.congr' (Filter.Eventually.of_forall fun n => (hwealth n).symm)
  exact (not_tendsto_nhds_of_tendsto_atTop hwealth_top (Wlim c ω)) (hω c)

@[blueprint "lem:betting-transform-oscillates-downward"
  (statement := /-- Let \(\mu\) and \(P\) be probability measures, and suppose that
  \((\mu,P,m,X)\) is a betting null model and that \(\lambda\) is an admissible predictable
  bet process for \(X\) at mean \(m\).  Then, for \(\mu\)-almost every \(\omega\), if
  \(\sum_n\lambda_n(\omega)^2\) is not summable, the transform \(S_n(\omega)\) visits every
  lower half-line at arbitrarily large times:
  \[
    \forall a\in\mathbb R\ \forall N\in\mathbb N\ \exists n\geq N,\quad S_n(\omega)<a.
  \] -/)
  (proof := /-- Work on the common full-measure event supplied by the three local results
  below.  By \cref{lem:betting-realized-squares-diverge-with-squared-bets}, divergence of
  \(\sum_n\lambda_n^2\) forces divergence of
  \(\sum_n(\lambda_n(X_n-m))^2\).  Suppose that the displayed conclusion failed for some
  \(a\) and \(N\).  Then \(S_n\geq a\) for every \(n\geq N\), so
  \cref{lem:betting-transform-converges-if-eventually-lower-bounded} gives a finite limit for
  \(S_n\).  But \cref{lem:betting-realized-squares-summable-if-transform-converges} then
  makes the same realized-square series summable, a contradiction.  Therefore every lower
  half-line is visited after every time \(N\). -/)
  (title := /-- Downward oscillation under divergent squared bets -/)
  (latexEnv := "lemma")]
lemma betting_transform_oscillates_downward {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X lam : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X)
    (hbet : is_admissible_bet X m lam) :
    ∀ᵐ ω ∂μ, ¬Summable (fun n => (lam n ω) ^ 2) →
      ∀ a : ℝ, ∀ N : ℕ, ∃ n ≥ N, betting_transform m X lam n ω < a := by
  filter_upwards
    [betting_transform_converges_if_eventually_lower_bounded μ P m X lam hmodel hbet,
      betting_realized_squares_summable_if_transform_converges μ P m X lam hmodel hbet,
      betting_realized_squares_diverge_with_squared_bets μ P m X lam hmodel hbet]
    with ω hconv hsum hdiv
  intro hlam a N
  by_contra hnone
  push Not at hnone
  have hlimit : ∃ s : ℝ,
      Tendsto (fun n => betting_transform m X lam n ω) atTop (𝓝 s) :=
    hconv ⟨a, N, fun n hn => hnone n hn⟩
  exact (hdiv hlam) (hsum hlimit)

@[blueprint "lem:betting-wealth-le-exp-transform"
  (statement := /-- Let \((\Omega,\mu)\) be a probability space, let \(P\) be a probability
  measure on \(\mathbb R\), let \(m\in\mathbb R\), and let
  \(X=(X_n)_{n\geq0}\) and \(\lambda=(\lambda_n)_{n\geq0}\) be families of real-valued
  functions on \(\Omega\).  Suppose that \((\mu,P,m,X)\) is a betting null model and that
  \(\lambda\) is an admissible bet process for \(X\) at mean \(m\).  Then, for
  \(\mu\)-almost every \(\omega\in\Omega\) and every \(n\geq0\),
  \[
    W_n^\lambda(\omega)\leq \exp\bigl(S_n(\omega)\bigr).
  \] -/)
  (proof := /-- By \cref{def:betting-null-model}, identical distribution transfers the
  \(P\)-almost-sure support condition to \(X_k\in[0,1]\) almost surely for every \(k\).
  Countability yields a single full-measure event on which this holds for all \(k\).
  By \cref{lem:null-mean-mem-unit-interval}, \(m\in[0,1]\), while
  \cref{def:is-admissible-bet} gives
  \(-(1-m)^{-1}\leq\lambda_k\leq m^{-1}\).  If \(m=0\) or \(m=1\), the corresponding
  one-sided bounds show directly that \(\lambda_k(X_k-m)\geq-1\).  If \(0<m<1\), the same
  conclusion follows by splitting according to the sign of \(\lambda_k\) and multiplying
  the appropriate admissibility bound by \(m\) or \(1-m\).  Hence every factor
  \(1+\lambda_k(X_k-m)\) is nonnegative.  Applying \(1+y\leq e^y\) to each factor and using
  monotonicity of finite products gives
  \[
    \prod_{k<n}(1+\lambda_k(X_k-m))
      \leq\prod_{k<n}e^{\lambda_k(X_k-m)}
      =e^{\sum_{k<n}\lambda_k(X_k-m)}.
  \]
  The first and last expressions are respectively the wealth and transform of
  \cref{def:betting-wealth,def:betting-transform}. -/)
  (title := /-- Exponential upper bound for wealth -/)
  (latexEnv := "lemma")]
lemma betting_wealth_le_exp_transform {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X lam : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X)
    (hbet : is_admissible_bet X m lam) :
    ∀ᵐ ω ∂μ, ∀ n,
      betting_wealth m X lam n ω ≤ Real.exp (betting_transform m X lam n ω) := by
  have hm := null_mean_mem_unit_interval μ P m X hmodel
  have hX : ∀ᵐ ω ∂μ, ∀ k, X k ω ∈ Set.Icc (0 : ℝ) 1 := by
    rw [eventually_countable_forall]
    intro k
    simpa using
      (hmodel.commonLaw k).symm.ae_snd measurableSet_Icc hmodel.support
  filter_upwards [hX] with ω hω
  intro n
  unfold betting_wealth betting_transform
  calc
    ∏ k ∈ Finset.range n, (1 + lam k ω * (X k ω - m)) ≤
        ∏ k ∈ Finset.range n, Real.exp (lam k ω * (X k ω - m)) := by
      apply Finset.prod_le_prod
      · intro k hk
        have hx := hω k
        have hb := hbet.2 k ω
        have hy : -1 ≤ lam k ω * (X k ω - m) := by
          by_cases hm0 : m = 0
          · subst m
            norm_num at hb ⊢
            exact hb.1.trans (by
              simpa using mul_le_mul_of_nonpos_left hx.2 hb.2)
          · by_cases hm1 : m = 1
            · subst m
              norm_num at hb ⊢
              nlinarith [mul_nonneg hb.1 hx.1]
            · have hmpos : 0 < m := lt_of_le_of_ne hm.1 (Ne.symm hm0)
              have hmlt : m < 1 := lt_of_le_of_ne hm.2 hm1
              by_cases hlam : 0 ≤ lam k ω
              · have hlamm : lam k ω * m ≤ 1 := by
                  calc
                    lam k ω * m ≤ (1 / m) * m :=
                      mul_le_mul_of_nonneg_right hb.2 hm.1
                    _ = 1 := by field_simp
                nlinarith [mul_nonneg hlam hx.1]
              · have hlam' : lam k ω ≤ 0 := le_of_not_ge hlam
                have hprod : -1 ≤ lam k ω * (1 - m) := by
                  calc
                    -1 = -(1 / (1 - m)) * (1 - m) := by field_simp
                    _ ≤ lam k ω * (1 - m) :=
                      mul_le_mul_of_nonneg_right hb.1 (by linarith)
                exact hprod.trans
                  (mul_le_mul_of_nonpos_left (sub_le_sub_right hx.2 m) hlam')
        linarith
      · intro k hk
        simpa [add_comm] using Real.add_one_le_exp (lam k ω * (X k ω - m))
    _ = Real.exp (∑ k ∈ Finset.range n, lam k ω * (X k ω - m)) :=
      (Real.exp_sum (Finset.range n) (fun k => lam k ω * (X k ω - m))).symm

@[blueprint "lem:betting-wealth-nonnegative-for-bankruptcy"
  (statement := /-- Let \((\Omega,\mu)\) be a probability space, let \(P\) be a probability
  measure on \(\mathbb R\), and let \(m\in\mathbb R\).  Let \(X\) and \(\lambda\) be
  real-valued processes indexed by \(\mathbb N\).  If \((\mu,P,m,X)\) is a betting null
  model and \(\lambda\) is an admissible predictable bet process for \(X\) at mean \(m\),
  then, for \(\mu\)-almost every \(\omega\) and every \(n\in\mathbb N\),
  \(0\leq W_n^\lambda(\omega)\). -/)
  (proof := /-- By \cref{lem:null-mean-mem-unit-interval}, one has \(m\in[0,1]\).  The
  common-law and support conditions in \cref{def:betting-null-model} yield a single
  full-measure event on which \(X_k\in[0,1]\) for every \(k\).  Fix a path in this event.
  The bounds in \cref{def:is-admissible-bet} imply
  \(\lambda_k(X_k-m)\geq-1\): for \(m=0\) or \(m=1\), this follows from the corresponding
  one-sided bound, while for \(0<m<1\) it follows by separating the cases
  \(\lambda_k\geq0\) and \(\lambda_k<0\).  Thus every factor in the finite product defining
  \(W_n^\lambda\) in \cref{def:betting-wealth} is nonnegative, and hence so is the product. -/)
  (title := /-- Nonnegativity of admissible betting wealth -/)
  (latexEnv := "lemma")]
lemma betting_wealth_nonnegative_for_bankruptcy {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X lam : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X)
    (hbet : is_admissible_bet X m lam) :
    ∀ᵐ ω ∂μ, ∀ n, 0 ≤ betting_wealth m X lam n ω := by
  have hm := null_mean_mem_unit_interval μ P m X hmodel
  have hX : ∀ᵐ ω ∂μ, ∀ k, X k ω ∈ Set.Icc (0 : ℝ) 1 := by
    rw [eventually_countable_forall]
    intro k
    simpa using
      (hmodel.commonLaw k).symm.ae_snd measurableSet_Icc hmodel.support
  filter_upwards [hX] with ω hω
  intro n
  unfold betting_wealth
  apply Finset.prod_nonneg
  intro k hk
  have hx := hω k
  have hb := hbet.2 k ω
  have hy : -1 ≤ lam k ω * (X k ω - m) := by
    by_cases hm0 : m = 0
    · subst m
      norm_num at hb ⊢
      exact hb.1.trans (by
        simpa using mul_le_mul_of_nonpos_left hx.2 hb.2)
    · by_cases hm1 : m = 1
      · subst m
        norm_num at hb ⊢
        nlinarith [mul_nonneg hb.1 hx.1]
      · have hmpos : 0 < m := lt_of_le_of_ne hm.1 (Ne.symm hm0)
        have hmlt : m < 1 := lt_of_le_of_ne hm.2 hm1
        by_cases hlam : 0 ≤ lam k ω
        · have hlamm : lam k ω * m ≤ 1 := by
            calc
              lam k ω * m ≤ (1 / m) * m :=
                mul_le_mul_of_nonneg_right hb.2 hm.1
              _ = 1 := by field_simp
          nlinarith [mul_nonneg hlam hx.1]
        · have hlam' : lam k ω ≤ 0 := le_of_not_ge hlam
          have hprod : -1 ≤ lam k ω * (1 - m) := by
            calc
              -1 = -(1 / (1 - m)) * (1 - m) := by field_simp
              _ ≤ lam k ω * (1 - m) :=
                mul_le_mul_of_nonneg_right hb.1 (by linarith)
          exact hprod.trans
            (mul_le_mul_of_nonpos_left (sub_le_sub_right hx.2 m) hlam')
  linarith

@[blueprint "lem:bankruptcy-of-nonsummable-bets"
  (statement := /-- Let \((\Omega,\mu)\) be a probability space, let \(P\) be a probability
  measure on \(\mathbb R\), and let \(m\in\mathbb R\).  Let
  \(X=(X_n)_{n\geq0}\) and \(\lambda=(\lambda_n)_{n\geq0}\) be families of real-valued
  functions on \(\Omega\).  Suppose that \((\mu,P,m,X)\) is a betting null model and that
  \(\lambda\) is an admissible predictable bet process for \(X\) at mean \(m\).  If a
  function \(W_\infty:\Omega\to\mathbb R\) satisfies
  \(W_n^\lambda(\omega)\to W_\infty(\omega)\) for \(\mu\)-almost every \(\omega\), then,
  for \(\mu\)-almost every \(\omega\), divergence of
  \(\sum_{n=0}^{\infty}\lambda_n(\omega)^2\) implies \(W_\infty(\omega)=0\). -/)
  (proof := /-- Work on the common full-measure event supplied by
  \cref{lem:betting-transform-oscillates-downward,lem:betting-wealth-le-exp-transform,
  lem:betting-wealth-nonnegative-for-bankruptcy}, together with the assumed convergence.
  Fix a path in this event on which \(\sum_n\lambda_n^2\) diverges.  If
  \(W_\infty>0\), convergence gives an index \(N\) such that
  \(W_n^\lambda>W_\infty/2\) for every \(n\geq N\).  Downward oscillation supplies an
  \(n\geq N\) such that \(S_n<\log(W_\infty/2)\).  Strict monotonicity of the exponential
  function and the exponential wealth bound then give
  \(W_n^\lambda\leq e^{S_n}<W_\infty/2\), a contradiction.  Hence
  \(W_\infty\leq0\).  Nonnegativity of every \(W_n^\lambda\), together with convergence,
  gives \(W_\infty\geq0\), and therefore \(W_\infty=0\). -/)
  (title := /-- Bankruptcy under divergent squared bets -/)
  (latexEnv := "lemma")]
lemma bankruptcy_of_nonsummable_bets {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X lam : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X)
    (hbet : is_admissible_bet X m lam)
    (Wlim : Ω → ℝ)
    (hlim : ∀ᵐ ω ∂μ,
      Tendsto (fun n => betting_wealth m X lam n ω) atTop (𝓝 (Wlim ω))) :
    ∀ᵐ ω ∂μ, ¬Summable (fun n => (lam n ω) ^ 2) → Wlim ω = 0 := by
  filter_upwards
    [hlim, betting_transform_oscillates_downward μ P m X lam hmodel hbet,
      betting_wealth_le_exp_transform μ P m X lam hmodel hbet,
      betting_wealth_nonnegative_for_bankruptcy μ P m X lam hmodel hbet]
    with ω hconv hdown hupper hnonneg
  intro hlam
  apply le_antisymm
  · apply le_of_not_gt
    intro hpos
    have hhalf : 0 < Wlim ω / 2 := half_pos hpos
    have hevent : ∀ᶠ n in atTop,
        Wlim ω / 2 < betting_wealth m X lam n ω :=
      (tendsto_order.1 hconv).1 (Wlim ω / 2) (by linarith)
    obtain ⟨N, hN⟩ := eventually_atTop.1 hevent
    obtain ⟨n, hnN, hnS⟩ := hdown hlam (Real.log (Wlim ω / 2)) N
    have hexp : Real.exp (betting_transform m X lam n ω) < Wlim ω / 2 := by
      rw [← Real.exp_log hhalf]
      exact Real.exp_lt_exp.mpr hnS
    linarith [hN n hnN, hupper n]
  · exact ge_of_tendsto hconv (Filter.Eventually.of_forall hnonneg)

@[blueprint "lem:betting-null-mean-strictly-between"
  (statement := /-- Let \(\mu\) and \(P\) be probability measures and suppose that
  \((\mu,P,m,X)\) is a betting null model.  Then \(0<m<1\). -/)
  (proof := /-- By \cref{lem:null-mean-mem-unit-interval}, \(m\in[0,1]\).  If \(m=0\),
  the nonnegative identity function on the support \([0,1]\) has integral zero, so it is zero
  \(P\)-almost everywhere and \(P=\delta_0\), contradicting non-degeneracy.  If \(m=1\), the
  same argument applied to \(x\mapsto1-x\) gives \(P=\delta_1\), again a contradiction. -/)
  (title := /-- The null mean is strictly internal -/)
  (latexEnv := "lemma")]
lemma betting_null_mean_strictly_between {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X) :
    0 < m ∧ m < 1 := by
  have hm := null_mean_mem_unit_interval μ P m X hmodel
  have hid_int : Integrable (fun x : ℝ => x) P :=
    Integrable.of_bound continuous_id.aestronglyMeasurable 1
      (hmodel.support.mono fun x hx => by simpa [abs_of_nonneg hx.1] using hx.2)
  constructor
  · refine lt_of_le_of_ne hm.1 ?_
    intro hm0
    have hae0 : (fun x : ℝ => x) =ᵐ[P] 0 :=
      (integral_eq_zero_iff_of_nonneg_ae
        (hmodel.support.mono fun x hx => hx.1) hid_int).mp (by simpa [hm0] using hmodel.mean)
    have hP : P = Measure.dirac 0 := by
      simpa using (hasLaw_dirac_of_ae_eq (P := P) (x := (0 : ℝ)) hae0).map_eq
    exact hmodel.nondegenerate (by simpa [hm0] using hP)
  · refine lt_of_le_of_ne hm.2 ?_
    intro hm1
    have hone_int : Integrable (fun x : ℝ => 1 - x) P :=
      (integrable_const (c := (1 : ℝ))).sub hid_int
    have hae1sub : (fun x : ℝ => 1 - x) =ᵐ[P] 0 :=
      (integral_eq_zero_iff_of_nonneg_ae
        (hmodel.support.mono fun x hx => sub_nonneg.mpr hx.2) hone_int).mp (by
          rw [integral_sub (integrable_const (c := (1 : ℝ))) hid_int]
          simp [hmodel.mean, hm1])
    have hae1 : (fun x : ℝ => x) =ᵐ[P] fun _ => 1 :=
      hae1sub.mono fun x hx => by simpa using (sub_eq_zero.mp hx).symm
    have hP : P = Measure.dirac 1 := by
      simpa using (hasLaw_dirac_of_ae_eq (P := P) (x := (1 : ℝ)) hae1).map_eq
    exact hmodel.nondegenerate (by simpa [hm1] using hP)

@[blueprint "lem:betting-log-error-bounds"
  (statement := /-- If \(z\in[-1/2,1/2]\), then
  \[
    0\leq z-\log(1+z)\leq 2z^2.
  \] -/)
  (proof := /-- The upper logarithmic bound \(\log(1+z)\leq z\) gives the first
  inequality.  The lower bound \(\log(1+z)\geq1-(1+z)^{-1}\), together with
  \(z\geq-1/2\), gives \(\log(1+z)\geq z-2z^2\), which is the second inequality. -/)
  (title := /-- A quadratic bound for the logarithmic error -/)
  (latexEnv := "lemma")]
lemma betting_log_error_bounds {z : ℝ} (hz : |z| ≤ 1 / 2) :
    0 ≤ z - Real.log (1 + z) ∧ z - Real.log (1 + z) ≤ 2 * z ^ 2 := by
  have hzlo : -(1 / 2 : ℝ) ≤ z := (abs_le.mp hz).1
  have hpos : 0 < 1 + z := by linarith
  constructor
  · linarith [Real.log_le_sub_one_of_pos hpos]
  · have hlog := Real.one_sub_inv_le_log_of_pos hpos
    have hinv : (1 + z) * (1 + z)⁻¹ = 1 := mul_inv_cancel₀ (ne_of_gt hpos)
    nlinarith [sq_nonneg z, mul_nonneg (sq_nonneg z) (by linarith : 0 ≤ 1 + 2 * z)]

@[blueprint "lem:betting-centered-sum-converges-of-opposite-products"
  (statement := /-- Let \((z_n)\) be a real sequence with \(|z_n|\leq1/2\) and
  \(\sum_n z_n^2<\infty\).  If both partial products
  \(\prod_{k<n}(1+z_k)\) and \(\prod_{k<n}(1-z_k)\) converge to finite real limits, then
  the partial sums \(\sum_{k<n}z_k\) converge to a finite real limit. -/)
  (proof := /-- By \cref{lem:betting-log-error-bounds}, the nonnegative errors
  \(z_n-\log(1+z_n)\) form a summable series.  Moreover,
  \[
    \prod_{k<n}(1+z_k)\prod_{k<n}(1-z_k)=\prod_{k<n}(1-z_k^2).
  \]
  The infinite product on the right converges to a nonzero value because \(\sum_nz_n^2\)
  converges and every factor is positive.  Thus the limit of the first product is positive,
  so continuity of the logarithm shows that \(\sum_{k<n}\log(1+z_k)\) converges.  Adding the
  convergent error series proves convergence of \(\sum_{k<n}z_k\). -/)
  (title := /-- Centered-sum convergence from opposite products -/)
  (latexEnv := "lemma")]
lemma betting_centered_sum_converges_of_opposite_products
    (z : ℕ → ℝ) (hz : ∀ n, |z n| ≤ 1 / 2)
    (hsq : Summable fun n => (z n) ^ 2)
    (a b : ℝ)
    (hplus : Tendsto (fun n => ∏ k ∈ Finset.range n, (1 + z k)) atTop (𝓝 a))
    (hminus : Tendsto (fun n => ∏ k ∈ Finset.range n, (1 - z k)) atTop (𝓝 b)) :
    ∃ s : ℝ, Tendsto (fun n => ∑ k ∈ Finset.range n, z k) atTop (𝓝 s) := by
  let err : ℕ → ℝ := fun n => z n - Real.log (1 + z n)
  have herr : Summable err := by
    refine Summable.of_nonneg_of_le (fun n => (betting_log_error_bounds (hz n)).1)
      (fun n => (betting_log_error_bounds (hz n)).2) ?_
    exact hsq.mul_left 2
  let logPair : ℕ → ℝ := fun n => Real.log (1 - (z n) ^ 2)
  have hlogPair : Summable logPair := by
    refine Summable.of_norm_bounded (hsq.mul_left 2) ?_
    intro n
    have hsqle : (z n) ^ 2 ≤ 1 / 4 := by
      nlinarith [sq_nonneg (z n + 1 / 2), sq_nonneg (z n - 1 / 2),
        (abs_le.mp (hz n)).1, (abs_le.mp (hz n)).2]
    have hwabs : |-(z n) ^ 2| ≤ 1 / 2 := by
      rw [abs_neg, abs_of_nonneg (sq_nonneg (z n))]
      linarith
    have herrPair := betting_log_error_bounds hwabs
    have hlog_nonpos : Real.log (1 - (z n) ^ 2) ≤ 0 := by
      exact Real.log_nonpos (by linarith) (by nlinarith [sq_nonneg (z n)])
    change ‖Real.log (1 - (z n) ^ 2)‖ ≤ 2 * (z n) ^ 2
    rw [Real.norm_eq_abs, abs_of_nonpos hlog_nonpos]
    have hquartic : 2 * (-(z n) ^ 2) ^ 2 ≤ (z n) ^ 2 := by
      nlinarith [mul_nonneg (sq_nonneg (z n))
        (by linarith : 0 ≤ 1 / 2 - (z n) ^ 2)]
    have herrPair' : -(z n) ^ 2 - Real.log (1 - (z n) ^ 2) ≤
        2 * (-(z n) ^ 2) ^ 2 := by
      simpa only [sub_eq_add_neg] using herrPair.2
    nlinarith [herrPair', hquartic]
  have hpair : Tendsto (fun n => ∏ k ∈ Finset.range n, (1 + -(z k) ^ 2)) atTop
      (𝓝 (a * b)) := by
    convert hplus.mul hminus using 1
    funext n
    rw [← Finset.prod_mul_distrib]
    apply Finset.prod_congr rfl
    intro k hk
    ring
  have hpair' : Tendsto (fun n => ∏ k ∈ Finset.range n, (1 + -(z k) ^ 2)) atTop
      (𝓝 (Real.exp (∑' n, logPair n))) := by
    have hexp :=
      (Real.continuous_exp.tendsto (∑' n, logPair n)).comp hlogPair.hasSum.tendsto_sum_nat
    convert hexp using 1
    funext n
    simp only [Function.comp_apply]
    rw [Real.exp_sum]
    apply Finset.prod_congr rfl
    intro k hk
    have hsqle : (z k) ^ 2 ≤ 1 / 4 := by
      nlinarith [sq_nonneg (z k + 1 / 2), sq_nonneg (z k - 1 / 2),
        (abs_le.mp (hz k)).1, (abs_le.mp (hz k)).2]
    change 1 + -(z k) ^ 2 = Real.exp (Real.log (1 - (z k) ^ 2))
    rw [Real.exp_log (by linarith : 0 < 1 - (z k) ^ 2)]
    linarith
  have hab : a * b = Real.exp (∑' n, logPair n) :=
    tendsto_nhds_unique hpair hpair'
  have hab_ne : a * b ≠ 0 := hab ▸ Real.exp_ne_zero _
  have ha_nonneg : 0 ≤ a := by
    refine le_of_tendsto_of_tendsto tendsto_const_nhds hplus ?_
    filter_upwards [] with n
    exact Finset.prod_nonneg fun k hk => by linarith [(abs_le.mp (hz k)).1]
  have ha_pos : 0 < a := lt_of_le_of_ne ha_nonneg (by
    intro ha
    exact hab_ne (by rw [← ha]; simp))
  have hlogwealth :
      Tendsto (fun n => Real.log (∏ k ∈ Finset.range n, (1 + z k))) atTop
        (𝓝 (Real.log a)) :=
    (Real.continuousAt_log (ne_of_gt ha_pos)).tendsto.comp hplus
  have hlog : Tendsto (fun n => ∑ k ∈ Finset.range n, Real.log (1 + z k)) atTop
      (𝓝 (Real.log a)) := by
    convert hlogwealth using 1
    funext n
    rw [Real.log_prod]
    intro k hk
    exact ne_of_gt (by linarith [(abs_le.mp (hz k)).1])
  refine ⟨Real.log a + ∑' n, err n, ?_⟩
  convert hlog.add herr.hasSum.tendsto_sum_nat using 1
  funext n
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro k hk
  simp [err]

@[blueprint "lem:betting-transform-converges-of-summable-bets"
  (statement := /-- Let \(\mu\) and \(P\) be probability measures and suppose that
  \((\mu,P,m,X)\) is a betting null model.  For every admissible predictable bet process
  \(\lambda\), for \(\mu\)-almost every \(\omega\), if
  \(\sum_{n=0}^{\infty}\lambda_n(\omega)^2<\infty\), then there exists \(s\in\mathbb R\) such
  that the centered transforms
  \[
    S_n(\omega)=\sum_{k=0}^{n-1}\lambda_k(\omega)(X_k(\omega)-m)
  \]
  converge to \(s\) as \(n\to\infty\). -/)
  (proof := /-- By \cref{lem:betting-null-mean-strictly-between}, \(0<m<1\).  Set
  \(c=\frac12\min\{m,1-m\}>0\).  Both \(c\lambda\) and \(-c\lambda\) are admissible predictable
  bets: admissibility gives \(\lvert c\lambda_n\rvert\leq1/2\), and the admissible interval
  contains \([-1/2,1/2]\).  Hence \cref{lem:betting-wealth-has-ae-limit} gives finite
  almost-sure limits for both corresponding wealth processes.

  Outside one null set, these two limits exist and \(X_n\in[0,1]\) for every \(n\).  Fix such a
  sample point \(\omega\) for which \(\sum_n\lambda_n(\omega)^2<\infty\), and put
  \[
    z_n=c\lambda_n(\omega)(X_n(\omega)-m).
  \]
  Since \(X_n(\omega),m\in[0,1]\), one has \(\lvert z_n\rvert\leq1/2\) and
  \(\sum_nz_n^2<\infty\).  The two convergent wealth processes are exactly the partial products
  \(\prod_{k<n}(1+z_k)\) and \(\prod_{k<n}(1-z_k)\).  Therefore
  \cref{lem:betting-centered-sum-converges-of-opposite-products} shows that
  \(\sum_{k<n}z_k\) converges.  Multiplication by \(c^{-1}\) identifies these partial sums with
  \(cS_n(\omega)\), proving that \(S_n(\omega)\) has a finite real limit. -/)
  (title := /-- Transform convergence under square summability -/)
  (latexEnv := "lemma")]
lemma betting_transform_converges_of_summable_bets {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X lam : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X)
    (hbet : is_admissible_bet X m lam) :
    ∀ᵐ ω ∂μ, Summable (fun n => (lam n ω) ^ 2) →
      ∃ s : ℝ, Tendsto (fun n => betting_transform m X lam n ω) atTop (𝓝 s) := by
  have hm := betting_null_mean_strictly_between μ P m X hmodel
  let c : ℝ := min m (1 - m) / 2
  have hcpos : 0 < c := by
    dsimp [c]
    have : 0 < min m (1 - m) := lt_min hm.1 (by linarith [hm.2])
    linarith
  have hcm : c ≤ m / 2 := by
    exact div_le_div_of_nonneg_right (min_le_left _ _) (by norm_num)
  have hc1m : c ≤ (1 - m) / 2 := by
    exact div_le_div_of_nonneg_right (min_le_right _ _) (by norm_num)
  have hscaled : ∀ n ω, |c * lam n ω| ≤ 1 / 2 := by
    intro n ω
    rw [abs_le]
    constructor
    · calc
        -(1 / 2 : ℝ) ≤ c * (-(1 / (1 - m))) := by
          have hi : 0 < 1 / (1 - m) := one_div_pos.mpr (by linarith [hm.2])
          have hcdiv : c * (1 / (1 - m)) ≤ 1 / 2 := by
            calc
              c * (1 / (1 - m)) ≤ ((1 - m) / 2) * (1 / (1 - m)) :=
                mul_le_mul_of_nonneg_right hc1m (le_of_lt hi)
              _ = 1 / 2 := by field_simp [ne_of_gt (by linarith [hm.2] : 0 < 1 - m)]
          linarith
        _ ≤ c * lam n ω :=
          mul_le_mul_of_nonneg_left (hbet.2 n ω).1 (le_of_lt hcpos)
    · calc
        c * lam n ω ≤ c * (1 / m) :=
          mul_le_mul_of_nonneg_left (hbet.2 n ω).2 (le_of_lt hcpos)
        _ ≤ (m / 2) * (1 / m) :=
          mul_le_mul_of_nonneg_right hcm (le_of_lt (one_div_pos.mpr hm.1))
        _ = 1 / 2 := by field_simp [ne_of_gt hm.1]
  have hhalf_lower : -(1 / (1 - m)) ≤ -(1 / 2 : ℝ) := by
    have h : 1 ≤ 1 / (1 - m) := by
      apply (le_div_iff₀ (by linarith [hm.2])).2
      linarith [hm.1]
    linarith
  have hhalf_upper : (1 / 2 : ℝ) ≤ 1 / m := by
    have h : 1 ≤ 1 / m := by
      apply (le_div_iff₀ hm.1).2
      linarith [hm.2]
    linarith
  let lamPlus : ℕ → Ω → ℝ := fun n ω => c * lam n ω
  let lamMinus : ℕ → Ω → ℝ := fun n ω => -c * lam n ω
  have hplus_adm : is_admissible_bet X m lamPlus := by
    constructor
    · intro n
      exact (hbet.1 n).const_mul c
    · intro n ω
      have hs := abs_le.mp (hscaled n ω)
      exact ⟨hhalf_lower.trans hs.1, hs.2.trans hhalf_upper⟩
  have hminus_adm : is_admissible_bet X m lamMinus := by
    constructor
    · intro n
      exact (hbet.1 n).const_mul (-c)
    · intro n ω
      have hs := abs_le.mp (hscaled n ω)
      have hs' : -(1 / 2 : ℝ) ≤ -c * lam n ω ∧ -c * lam n ω ≤ 1 / 2 := by
        constructor <;> linarith
      exact ⟨hhalf_lower.trans hs'.1, hs'.2.trans hhalf_upper⟩
  obtain ⟨A, hA⟩ := betting_wealth_has_ae_limit μ P m X lamPlus hmodel hplus_adm
  obtain ⟨B, hB⟩ := betting_wealth_has_ae_limit μ P m X lamMinus hmodel hminus_adm
  have hX : ∀ᵐ ω ∂μ, ∀ n, X n ω ∈ Set.Icc (0 : ℝ) 1 := by
    rw [ae_all_iff]
    intro n
    exact (hmodel.commonLaw n).symm.ae_mem_snd measurableSet_Icc hmodel.support
  filter_upwards [hA, hB, hX] with ω hAω hBω hXω
  intro hlam
  let z : ℕ → ℝ := fun n => c * lam n ω * (X n ω - m)
  have hdev : ∀ n, |X n ω - m| ≤ 1 := by
    intro n
    rw [abs_le]
    constructor <;> linarith [(hXω n).1, (hXω n).2, hm.1, hm.2]
  have hz : ∀ n, |z n| ≤ 1 / 2 := by
    intro n
    change |c * lam n ω * (X n ω - m)| ≤ 1 / 2
    rw [abs_mul]
    calc
      |c * lam n ω| * |X n ω - m| ≤ (1 / 2) * 1 :=
        mul_le_mul (hscaled n ω) (hdev n) (abs_nonneg _) (by norm_num)
      _ = 1 / 2 := by norm_num
  have hsq : Summable fun n => (z n) ^ 2 := by
    refine Summable.of_nonneg_of_le (fun n => sq_nonneg (z n)) ?_ hlam
    intro n
    have hcabs : |c| ≤ 1 := by
      rw [abs_of_pos hcpos]
      linarith [hcm, hm.2]
    have habs : |z n| ≤ |lam n ω| := by
      change |c * lam n ω * (X n ω - m)| ≤ |lam n ω|
      rw [abs_mul, abs_mul]
      calc
        |c| * |lam n ω| * |X n ω - m| ≤ 1 * |lam n ω| * 1 :=
          mul_le_mul (mul_le_mul hcabs le_rfl (abs_nonneg _) (by norm_num))
            (hdev n) (abs_nonneg _) (by positivity)
        _ = |lam n ω| := by ring
    nlinarith [sq_abs (z n), sq_abs (lam n ω), abs_nonneg (z n), abs_nonneg (lam n ω)]
  have hplus : Tendsto (fun n => ∏ k ∈ Finset.range n, (1 + z k)) atTop (𝓝 (A ω)) := by
    simpa [betting_wealth, lamPlus, z, mul_assoc] using hAω
  have hminus : Tendsto (fun n => ∏ k ∈ Finset.range n, (1 - z k)) atTop (𝓝 (B ω)) := by
    convert hBω using 1
    funext n
    apply Finset.prod_congr rfl
    intro k hk
    simp only [betting_wealth, lamMinus, z]
    ring
  obtain ⟨s, hs⟩ :=
    betting_centered_sum_converges_of_opposite_products z hz hsq (A ω) (B ω) hplus hminus
  refine ⟨c⁻¹ * s, ?_⟩
  have hscaled_limit :
      Tendsto (fun n => c⁻¹ * ∑ k ∈ Finset.range n, z k) atTop (𝓝 (c⁻¹ * s)) :=
    tendsto_const_nhds.mul hs
  convert hscaled_limit using 1
  · funext n
    change betting_transform m X lam n ω = c⁻¹ * ∑ k ∈ Finset.range n,
      c * lam k ω * (X k ω - m)
    have hsumc : (∑ k ∈ Finset.range n, c * lam k ω * (X k ω - m)) =
        c * ∑ k ∈ Finset.range n, lam k ω * (X k ω - m) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro k hk
      ring
    rw [betting_transform, hsumc]
    field_simp [ne_of_gt hcpos]

@[blueprint "lem:weighted-squared-deviations-summable"
  (statement := /-- Let \((\Omega,\mu)\) be a probability space, let \(P\) be a probability
  measure on \(\mathbb R\), let \(m\in\mathbb R\), and let
  \(X_n,\lambda_n:\Omega\to\mathbb R\) for \(n\in\mathbb N\).  If
  \((\mu,P,m,X)\) is a betting null model, then, for \(\mu\)-almost every \(\omega\),
  convergence of the series \(\sum_{n=0}^{\infty}\lambda_n(\omega)^2\) implies convergence of
  \[
    \sum_{n=0}^{\infty}\lambda_n(\omega)^2\bigl(X_n(\omega)-m\bigr)^2.
  \] -/)
  (proof := /-- By \cref{lem:null-mean-mem-unit-interval}, \(m\in[0,1]\).  The common-law and
  support conditions in \cref{def:betting-null-model} imply, for each \(n\), that
  \(X_n(\omega)\in[0,1]\) for \(\mu\)-almost every \(\omega\).  Taking the countable
  intersection of these full-measure events gives this inclusion simultaneously for every
  \(n\).  On that event, \(m,X_n(\omega)\in[0,1]\), so
  \(\lvert X_n(\omega)-m\rvert\leq1\), and hence
  \[
    0\leq\lambda_n(\omega)^2\bigl(X_n(\omega)-m\bigr)^2
      \leq\lambda_n(\omega)^2
  \]
  for every \(n\).  The comparison test for nonnegative series now shows that summability of
  \(\bigl(\lambda_n(\omega)^2\bigr)_n\) implies summability of the weighted squared
  deviations. -/)
  (title := /-- Summability of the quadratic correction -/)
  (latexEnv := "lemma")]
lemma weighted_squared_deviations_summable {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X lam : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X) :
    ∀ᵐ ω ∂μ, Summable (fun n => (lam n ω) ^ 2) →
      Summable (fun n => (lam n ω) ^ 2 * (X n ω - m) ^ 2) := by
  have hm := null_mean_mem_unit_interval μ P m X hmodel
  have hX : ∀ᵐ ω ∂μ, ∀ n, X n ω ∈ Set.Icc (0 : ℝ) 1 := by
    rw [ae_all_iff]
    intro n
    exact (hmodel.commonLaw n).symm.ae_mem_snd measurableSet_Icc hmodel.support
  filter_upwards [hX] with ω hXω
  intro hlam
  refine Summable.of_nonneg_of_le
    (fun n => mul_nonneg (sq_nonneg _) (sq_nonneg _)) ?_ hlam
  intro n
  have hdevsq : (X n ω - m) ^ 2 ≤ 1 := by
    have hleft : 0 ≤ 1 - (X n ω - m) := by
      linarith [(hXω n).2, hm.1]
    have hright : 0 ≤ 1 + (X n ω - m) := by
      linarith [(hXω n).1, hm.2]
    nlinarith [mul_nonneg hleft hright]
  exact mul_le_of_le_one_right (sq_nonneg _) hdevsq

@[blueprint "lem:log-one-plus-quadratic-lower-bound"
  (statement := /-- For every real number \(x\) with \(\lvert x\rvert\leq\tfrac12\),
  \[
    \log(1+x)\geq x-x^2.
  \] -/)
  (proof := /-- First suppose that \(x\geq0\).  Applying
  \(1-y^{-1}\leq\log y\) to \(y=1+x\), and using
  \[
    x-x^2\leq\frac{x}{1+x}=1-(1+x)^{-1},
  \]
  proves the result in this case.

  Now suppose that \(x<0\), and put \(u=-x\), so that \(0<u\leq\tfrac12\).  Set
  \(b=(u+u^2)/9\).  The binomial estimate
  \[
    1+9b+36b^2\leq(1+b)^9
  \]
  and the identity
  \[
    (1-u)(1+9b+36b^2)-1
      =\frac{u^2(1-2u)(2u^2+3u+4)}9\geq0
  \]
  give \((1-u)^{-1}\leq(1+b)^9\).  Monotonicity of the logarithm, together with
  \(\log z\leq z-1\) for \(z>0\), therefore yields
  \[
    -\log(1-u)=\log((1-u)^{-1})
      \leq9\log(1+b)\leq9b=u+u^2.
  \]
  Substituting \(u=-x\) proves \(x-x^2\leq\log(1+x)\). -/)
  (title := /-- A quadratic lower bound for the logarithm -/)
  (latexEnv := "lemma")]
lemma log_one_plus_quadratic_lower_bound (x : ℝ) (hx : |x| ≤ (1 : ℝ) / 2) :
    x - x ^ 2 ≤ Real.log (1 + x) := by
  have hx_lower : -(1 : ℝ) / 2 ≤ x := by
    linarith [neg_abs_le x]
  have hx_upper : x ≤ (1 : ℝ) / 2 := le_trans (le_abs_self x) hx
  by_cases hx_nonneg : 0 ≤ x
  · have hpos : 0 < 1 + x := by
      linarith
    have hlog := Real.one_sub_inv_le_log_of_pos hpos
    have halg : x - x ^ 2 ≤ 1 - (1 + x)⁻¹ := by
      have hcubic : 0 ≤ x * x ^ 2 := mul_nonneg hx_nonneg (sq_nonneg x)
      have hid : 1 - (1 + x)⁻¹ = x / (1 + x) := by
        field_simp
        ring
      rw [hid]
      apply (le_div_iff₀ hpos).2
      nlinarith
    exact halg.trans hlog
  · have hx_nonpos : x ≤ 0 := le_of_not_ge hx_nonneg
    let u : ℝ := -x
    have hu_nonneg : 0 ≤ u := by
      dsimp [u]
      linarith
    have hu_upper : u ≤ (1 : ℝ) / 2 := by
      dsimp [u]
      linarith
    have hden : 0 < 1 - u := by
      linarith
    let b : ℝ := (u + u ^ 2) / 9
    have hb_nonneg : 0 ≤ b := by
      dsimp [b]
      positivity
    have hpow : 1 + 9 * b + 36 * b ^ 2 ≤ (1 + b) ^ 9 := by
      ring_nf
      nlinarith [pow_nonneg hb_nonneg 3, pow_nonneg hb_nonneg 4,
        pow_nonneg hb_nonneg 5, pow_nonneg hb_nonneg 6, pow_nonneg hb_nonneg 7,
        pow_nonneg hb_nonneg 8, pow_nonneg hb_nonneg 9]
    have hfactor : 0 ≤ 1 - 2 * u := by
      linarith
    have hquad : 0 ≤ 2 * u ^ 2 + 3 * u + 4 := by
      nlinarith [sq_nonneg u]
    have hbase : 1 ≤ (1 - u) * (1 + 9 * b + 36 * b ^ 2) := by
      calc
        1 ≤ 1 + u ^ 2 * (1 - 2 * u) * (2 * u ^ 2 + 3 * u + 4) / 9 := by
          nlinarith [mul_nonneg (mul_nonneg (sq_nonneg u) hfactor) hquad]
        _ = (1 - u) * (1 + 9 * b + 36 * b ^ 2) := by
          dsimp [b]
          ring
    have hproduct : 1 ≤ (1 - u) * (1 + b) ^ 9 :=
      hbase.trans (mul_le_mul_of_nonneg_left hpow (le_of_lt hden))
    have hinv : (1 - u)⁻¹ ≤ (1 + b) ^ 9 := by
      rw [inv_eq_one_div]
      apply (div_le_iff₀ hden).2
      simpa [mul_comm] using hproduct
    have hlog_mono : Real.log ((1 - u)⁻¹) ≤ Real.log ((1 + b) ^ 9) :=
      Real.log_le_log (inv_pos.mpr hden) hinv
    have hb_pos : 0 < 1 + b := by
      linarith
    have hlog_basic : Real.log (1 + b) ≤ b := by
      nlinarith [Real.log_le_sub_one_of_pos hb_pos]
    have hbound : Real.log ((1 - u)⁻¹) ≤ u + u ^ 2 := by
      calc
        Real.log ((1 - u)⁻¹) ≤ Real.log ((1 + b) ^ 9) := hlog_mono
        _ = 9 * Real.log (1 + b) := by rw [Real.log_pow]; norm_num
        _ ≤ 9 * b := by nlinarith
        _ = u + u ^ 2 := by
          dsimp [b]
          ring
    rw [Real.log_inv] at hbound
    dsimp [u] at hbound
    rw [sub_neg_eq_add] at hbound
    nlinarith

@[blueprint "lem:positive-limit-of-summable-bets"
  (statement := /-- Let \(\mu\) be a probability measure on a measurable space \(\Omega\),
  let \(P\) be a probability measure on \(\mathbb R\), let \(m\in\mathbb R\), and let
  \(X_n,\lambda_n:\Omega\to\mathbb R\) for \(n\in\mathbb N\).  Suppose that
  \((\mu,P,m,X)\) is a betting null model and that \(\lambda\) is an admissible bet process.
  Let \(W_\infty:\Omega\to\mathbb R\).  If \(W_n^\lambda\to W_\infty\)
  \(\mu\)-almost surely, then, for \(\mu\)-almost every \(\omega\),
  \[
    \left(\sum_{n=0}^{\infty}\lambda_n(\omega)^2<\infty
      \ \text{and}\
      \ \lambda_n(\omega)(X_n(\omega)-m)>-1\ \text{for every }n\in\mathbb N\right)
    \quad\Longrightarrow\quad W_\infty(\omega)>0.
  \] -/)
  (proof := /-- Intersect the full-measure events supplied by the assumed wealth convergence,
  \cref{lem:betting-transform-converges-of-summable-bets}, and
  \cref{lem:weighted-squared-deviations-summable}, and fix a sample point \(\omega\) in this
  intersection.  Assume that the squared bets are summable and that every wealth factor is
  strictly positive.  Put
  \[
    z_n=\lambda_n(\omega)(X_n(\omega)-m).
  \]
  The weighted-summability conclusion gives \(\sum_n z_n^2<\infty\), so \(z_n^2\to0\).
  Hence there is \(N\) such that \(\lvert z_n\rvert\leq\tfrac12\) for all \(n\geq N\).

  Define \(e_n=z_n-\log(1+z_n)\).  Since \(1+z_n>0\), the standard upper logarithmic bound
  gives \(e_n\geq0\).  For \(n\geq N\),
  \cref{lem:log-one-plus-quadratic-lower-bound} gives \(e_n\leq z_n^2\).  The comparison test
  therefore shows that the tail of \(\sum_n e_n\) is summable, and adjoining its finite
  initial segment shows that the whole error series is summable.

  By \cref{lem:betting-transform-converges-of-summable-bets} and
  \cref{def:betting-transform}, the partial sums of \(z_n\) converge.  Consequently the
  identity
  \[
    \sum_{k<n}\log(1+z_k)=\sum_{k<n}z_k-\sum_{k<n}e_k
  \]
  shows that the logarithmic partial sums converge to some finite \(L\).  Every factor is
  positive, so \cref{def:betting-wealth} gives
  \[
    W_n^\lambda(\omega)=\exp\!\left(\sum_{k<n}\log(1+z_k)\right)\longrightarrow e^L>0.
  \]
  Uniqueness of real limits identifies the assumed limit \(W_\infty(\omega)\) with \(e^L\),
  proving the claim. -/)
  (title := /-- Positivity under square summability and no ruin -/)
  (latexEnv := "lemma")]
lemma positive_limit_of_summable_bets {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X lam : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X)
    (hbet : is_admissible_bet X m lam)
    (Wlim : Ω → ℝ)
    (hlim : ∀ᵐ ω ∂μ,
      Tendsto (fun n => betting_wealth m X lam n ω) atTop (𝓝 (Wlim ω))) :
    ∀ᵐ ω ∂μ,
      (Summable (fun n => (lam n ω) ^ 2) ∧
        ∀ n, -1 < lam n ω * (X n ω - m)) →
      0 < Wlim ω := by
  have htransform :=
    betting_transform_converges_of_summable_bets μ P m X lam hmodel hbet
  have hweighted := weighted_squared_deviations_summable μ P m X lam hmodel
  filter_upwards [hlim, htransform, hweighted] with ω hwealth htransformω hweightedω
  rintro ⟨hlam, hfactor⟩
  obtain ⟨s, hs⟩ := htransformω hlam
  have hweighted' := hweightedω hlam
  let z : ℕ → ℝ := fun n => lam n ω * (X n ω - m)
  have hsq : Summable (fun n => (z n) ^ 2) := by
    refine hweighted'.congr ?_
    intro n
    dsimp [z]
    ring
  have hzsq_zero : Tendsto (fun n => (z n) ^ 2) atTop (𝓝 0) :=
    hsq.tendsto_atTop_zero
  have hzsq_small : ∀ᶠ n in atTop, (z n) ^ 2 < (1 : ℝ) / 4 :=
    (tendsto_order.1 hzsq_zero).2 _ (by norm_num)
  obtain ⟨N, hN⟩ := eventually_atTop.1 hzsq_small
  have hzbound (n : ℕ) : |z (n + N)| ≤ (1 : ℝ) / 2 := by
    have hn := hN (n + N) (by omega)
    rw [abs_le]
    constructor <;> nlinarith [sq_nonneg (z (n + N))]
  let err : ℕ → ℝ := fun n => z n - Real.log (1 + z n)
  have hsq_tail : Summable (fun n => (z (n + N)) ^ 2) := by
    exact hsq.comp_injective (i := fun n : ℕ => n + N) (by
      intro a b hab
      exact Nat.add_right_cancel hab)
  have herr : Summable err := by
    rw [← summable_nat_add_iff N]
    refine Summable.of_nonneg_of_le ?_ ?_ hsq_tail
    · intro n
      have hpos : 0 < 1 + z (n + N) := by
        dsimp [z]
        linarith [hfactor (n + N)]
      linarith [Real.log_le_sub_one_of_pos hpos]
    · intro n
      have hlower := log_one_plus_quadratic_lower_bound (z (n + N)) (hzbound n)
      dsimp [err]
      linarith
  have hzsum : Tendsto (fun n => ∑ k ∈ Finset.range n, z k) atTop (𝓝 s) := by
    simpa only [betting_transform, z] using hs
  have hlogsum :
      Tendsto (fun n => ∑ k ∈ Finset.range n, Real.log (1 + z k)) atTop
        (𝓝 (s - ∑' n, err n)) := by
    convert hzsum.sub herr.hasSum.tendsto_sum_nat using 1
    funext n
    rw [← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro k hk
    simp [err]
  have hwealth_exp :
      Tendsto (fun n => betting_wealth m X lam n ω) atTop
        (𝓝 (Real.exp (s - ∑' n, err n))) := by
    have hexp :=
      (Real.continuous_exp.tendsto (s - ∑' n, err n)).comp hlogsum
    convert hexp using 1
    funext n
    simp only [Function.comp_apply, betting_wealth]
    rw [Real.exp_sum]
    apply Finset.prod_congr rfl
    intro k hk
    rw [Real.exp_log]
    dsimp [z]
    linarith [hfactor k]
  have hlimit : Wlim ω = Real.exp (s - ∑' n, err n) :=
    tendsto_nhds_unique hwealth hwealth_exp
  rw [hlimit]
  exact Real.exp_pos _

@[blueprint "lem:ruinous-factor-forces-bankruptcy"
  (statement := /-- Let \(\mu\) be a measure on \(\Omega\), let \(m\in\mathbb R\), and let
  \(X_n,\lambda_n:\Omega\to\mathbb R\) and \(W_\infty:\Omega\to\mathbb R\).  If
  \(W_n^\lambda(\omega)\to W_\infty(\omega)\) for \(\mu\)-almost every \(\omega\), then,
  for \(\mu\)-almost every \(\omega\),
  \[
    \bigl(\exists n\in\mathbb N,\ \lambda_n(\omega)(X_n(\omega)-m)=-1\bigr)
    \quad\Longrightarrow\quad W_\infty(\omega)=0.
  \] -/)
  (proof := /-- Fix \(\omega\) in the full-measure set on which
  \(W_k^\lambda(\omega)\to W_\infty(\omega)\), and suppose that
  \(\lambda_n(\omega)(X_n(\omega)-m)=-1\) for some \(n\in\mathbb N\).  For every
  \(k\geq n+1\), the index \(n\) belongs to \(\{0,\ldots,k-1\}\).  By
  \cref{def:betting-wealth}, the corresponding factor in \(W_k^\lambda(\omega)\) is
  \(1+\lambda_n(\omega)(X_n(\omega)-m)=0\), and hence \(W_k^\lambda(\omega)=0\).
  Thus the wealth sequence is eventually equal to the constant zero sequence and therefore
  converges to zero.  Uniqueness of limits in \(\mathbb R\) gives
  \(W_\infty(\omega)=0\). -/)
  (title := /-- A ruinous factor is absorbing -/)
  (latexEnv := "lemma")]
lemma ruinous_factor_forces_bankruptcy {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) (m : ℝ) (X lam : ℕ → Ω → ℝ)
    (Wlim : Ω → ℝ)
    (hlim : ∀ᵐ ω ∂μ,
      Tendsto (fun n => betting_wealth m X lam n ω) atTop (𝓝 (Wlim ω))) :
    ∀ᵐ ω ∂μ,
      (∃ n, lam n ω * (X n ω - m) = -1) → Wlim ω = 0 := by
  filter_upwards [hlim] with ω hω
  rintro ⟨n, hn⟩
  apply tendsto_nhds_unique hω
  apply tendsto_const_nhds.congr'
  filter_upwards [eventually_ge_atTop (n + 1)] with k hk
  symm
  unfold betting_wealth
  apply Finset.prod_eq_zero (Finset.mem_range.mpr (Nat.lt_of_succ_le hk))
  linarith

@[blueprint "lem:wealth-limit-nonnegative"
  (statement := /-- Let \((\Omega,\mu)\) be a probability space, let \(P\) be a probability
  measure on \(\mathbb R\), and suppose that \((\mu,P,m,X)\) is a betting null model and
  \(\lambda\) is an admissible bet process. If a function \(W_\infty:\Omega\to\mathbb R\)
  satisfies \(W_n^\lambda(\omega)\to W_\infty(\omega)\) for \(\mu\)-almost every \(\omega\),
  then \(W_\infty(\omega)\geq0\) for \(\mu\)-almost every \(\omega\). -/)
  (proof := /-- By \cref{lem:betting-null-mean-strictly-between}, \(0<m<1\).
  The common-law and support fields in \cref{def:betting-null-model} imply, outside one
  \(\mu\)-null set, that \(0\leq X_n(\omega)\leq1\) for every \(n\). Fix such an
  \(\omega\) at which the assumed convergence also holds. If \(\lambda_n(\omega)\geq0\),
  then \(X_n(\omega)\geq0\) and the upper bound in
  \cref{def:is-admissible-bet} give
  \[
    \lambda_n(\omega)(X_n(\omega)-m)\geq-\lambda_n(\omega)m\geq-1.
  \]
  If \(\lambda_n(\omega)<0\), then \(X_n(\omega)\leq1\) and the lower admissibility bound
  give
  \[
    \lambda_n(\omega)(X_n(\omega)-m)
      \geq\lambda_n(\omega)(1-m)\geq-1.
  \]
  Thus every factor in \cref{def:betting-wealth} is nonnegative, so every finite wealth
  product is nonnegative. Passing this inequality to the assumed real limit yields
  \(W_\infty(\omega)\geq0\). -/)
  (title := /-- Nonnegativity of the wealth limit -/)
  (latexEnv := "lemma")]
lemma wealth_limit_nonnegative {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X lam : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X)
    (hbet : is_admissible_bet X m lam)
    (Wlim : Ω → ℝ)
    (hlim : ∀ᵐ ω ∂μ,
      Tendsto (fun n => betting_wealth m X lam n ω) atTop (𝓝 (Wlim ω))) :
    ∀ᵐ ω ∂μ, 0 ≤ Wlim ω := by
  have hm := betting_null_mean_strictly_between μ P m X hmodel
  have hsupport_each : ∀ n : ℕ, ∀ᵐ ω ∂μ, X n ω ∈ Set.Icc (0 : ℝ) 1 := by
    intro n
    exact (hmodel.commonLaw n).symm.ae_mem_snd measurableSet_Icc hmodel.support
  have hsupport_all : ∀ᵐ ω ∂μ, ∀ n : ℕ, X n ω ∈ Set.Icc (0 : ℝ) 1 :=
    ae_all_iff.mpr hsupport_each
  filter_upwards [hlim, hsupport_all] with ω hω hsupp
  apply ge_of_tendsto hω
  filter_upwards [] with n
  unfold betting_wealth
  apply Finset.prod_nonneg
  intro k hk
  by_cases hlam : 0 ≤ lam k ω
  · have hdev : -m ≤ X k ω - m := by
      linarith [(hsupp k).1]
    have hbound : lam k ω * m ≤ 1 :=
      (le_div_iff₀ hm.1).mp (hbet.2 k ω).2
    have hmul := mul_le_mul_of_nonneg_left hdev hlam
    nlinarith
  · have hlam' : lam k ω ≤ 0 := le_of_not_ge hlam
    have hdev : X k ω - m ≤ 1 - m := by
      linarith [(hsupp k).2]
    have hbound : -1 ≤ lam k ω * (1 - m) :=
      (div_le_iff₀ (sub_pos.mpr hm.2)).mp (by
        simpa [neg_div] using (hbet.2 k ω).1)
    have hmul := mul_le_mul_of_nonpos_left hdev hlam'
    nlinarith

@[blueprint "lem:zero-limit-characterization"
  (statement := /-- Let \((\Omega,\mu)\) be a probability space, let \(P\) be a probability
  measure on \(\mathbb R\), and let \(m\in\mathbb R\).  Let
  \(X=(X_n)_{n\geq0}\) and \(\lambda=(\lambda_n)_{n\geq0}\) be families of real-valued
  functions on \(\Omega\).  Suppose that \((\mu,P,m,X)\) is a betting null model and that
  \(\lambda\) is an admissible predictable bet process for \(X\) at mean \(m\).  If a
  function \(W_\infty:\Omega\to\mathbb R\) satisfies
  \(W_n^\lambda(\omega)\to W_\infty(\omega)\) for \(\mu\)-almost every \(\omega\), then,
  for \(\mu\)-almost every \(\omega\),
  \[
    W_\infty(\omega)=0
    \quad\Longleftrightarrow\quad
    \sum_{n=0}^{\infty}\lambda_n(\omega)^2\ \text{is not summable}
    \ \text{or}\
    \exists n\in\mathbb N,\ \lambda_n(\omega)(X_n(\omega)-m)=-1.
  \] -/)
  (proof := /-- By \cref{lem:betting-null-mean-strictly-between}, \(0<m<1\).  The common-law
  and support fields of \cref{def:betting-null-model} imply that, outside one \(\mu\)-null
  set, \(0\leq X_n(\omega)\leq1\) for every \(n\).  Work on this set and on the full-measure
  sets supplied by \cref{lem:bankruptcy-of-nonsummable-bets,
  lem:positive-limit-of-summable-bets,lem:ruinous-factor-forces-bankruptcy}.

  If \(W_\infty(\omega)=0\) and the squared bets are summable, suppose that no ruinous
  factor occurs.  For each \(n\), the bounds in \cref{def:is-admissible-bet}, the support
  bound on \(X_n(\omega)\), and \(0<m<1\) give
  \(\lambda_n(\omega)(X_n(\omega)-m)\geq-1\).  Since equality is excluded, the inequality
  is strict for every \(n\).  Then \cref{lem:positive-limit-of-summable-bets} yields
  \(W_\infty(\omega)>0\), contradicting \(W_\infty(\omega)=0\).  Hence a ruinous factor
  occurs.  Conversely, nonsummability implies a zero limit by
  \cref{lem:bankruptcy-of-nonsummable-bets}, while the occurrence of a ruinous factor
  implies a zero limit by \cref{lem:ruinous-factor-forces-bankruptcy}. -/)
  (title := /-- Characterization of a zero wealth limit -/)
  (latexEnv := "lemma")]
lemma zero_limit_characterization {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X lam : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X)
    (hbet : is_admissible_bet X m lam)
    (Wlim : Ω → ℝ)
    (hlim : ∀ᵐ ω ∂μ,
      Tendsto (fun n => betting_wealth m X lam n ω) atTop (𝓝 (Wlim ω))) :
    ∀ᵐ ω ∂μ,
      Wlim ω = 0 ↔
        ¬Summable (fun n => (lam n ω) ^ 2) ∨
          ∃ n, lam n ω * (X n ω - m) = -1 := by
  have hbank :=
    bankruptcy_of_nonsummable_bets μ P m X lam hmodel hbet Wlim hlim
  have hpos :=
    positive_limit_of_summable_bets μ P m X lam hmodel hbet Wlim hlim
  have hruin := ruinous_factor_forces_bankruptcy μ m X lam Wlim hlim
  have hm := betting_null_mean_strictly_between μ P m X hmodel
  have hsupport_each : ∀ n : ℕ, ∀ᵐ ω ∂μ, X n ω ∈ Set.Icc (0 : ℝ) 1 := by
    intro n
    exact (hmodel.commonLaw n).symm.ae_mem_snd measurableSet_Icc hmodel.support
  have hsupport_all : ∀ᵐ ω ∂μ, ∀ n : ℕ, X n ω ∈ Set.Icc (0 : ℝ) 1 :=
    ae_all_iff.mpr hsupport_each
  filter_upwards [hbank, hpos, hruin, hsupport_all]
    with ω hbankω hposω hruinω hsupp
  constructor
  · intro hzero
    by_cases hsum : Summable (fun n => (lam n ω) ^ 2)
    · by_cases hfactor : ∃ n, lam n ω * (X n ω - m) = -1
      · exact Or.inr hfactor
      · exfalso
        have hstrict : ∀ n, -1 < lam n ω * (X n ω - m) := by
          intro n
          have hne : lam n ω * (X n ω - m) ≠ -1 := by
            intro hn
            exact hfactor ⟨n, hn⟩
          have hge : -1 ≤ lam n ω * (X n ω - m) := by
            by_cases hlam : 0 ≤ lam n ω
            · have hdev : -m ≤ X n ω - m := by
                linarith [(hsupp n).1]
              have hbound : lam n ω * m ≤ 1 :=
                (le_div_iff₀ hm.1).mp (hbet.2 n ω).2
              have hmul := mul_le_mul_of_nonneg_left hdev hlam
              nlinarith
            · have hlam' : lam n ω ≤ 0 := le_of_not_ge hlam
              have hdev : X n ω - m ≤ 1 - m := by
                linarith [(hsupp n).2]
              have hbound : -1 ≤ lam n ω * (1 - m) :=
                (div_le_iff₀ (sub_pos.mpr hm.2)).mp (by
                  simpa [neg_div] using (hbet.2 n ω).1)
              have hmul := mul_le_mul_of_nonpos_left hdev hlam'
              nlinarith
          exact lt_of_le_of_ne hge (Ne.symm hne)
        have hpositive := hposω ⟨hsum, hstrict⟩
        linarith
    · exact Or.inl hsum
  · rintro (hnonsum | hfactor)
    · exact hbankω hnonsum
    · exact hruinω hfactor

@[blueprint "lem:admissible-factor-lower-bound-for-positive-limit"
  (statement := /-- Let \((\Omega,\mu)\) be a probability space, let \(P\) be a probability
  measure on \(\mathbb R\), and let \(m\in\mathbb R\).  Let
  \(X=(X_n)_{n\geq0}\) and \(\lambda=(\lambda_n)_{n\geq0}\) be families of real-valued
  functions on \(\Omega\).  Suppose that \((\mu,P,m,X)\) is a betting null model and
  that \(\lambda\) is an admissible predictable bet process for \(X\) at mean \(m\).
  Then, for \(\mu\)-almost every \(\omega\),
  \[
    \lambda_n(\omega)(X_n(\omega)-m)\geq-1
    \qquad\text{for every }n\in\mathbb N.
  \] -/)
  (proof := /-- By \cref{lem:betting-null-mean-strictly-between}, \(0<m<1\).
  The common-law and support fields of \cref{def:betting-null-model} imply that, outside
  one \(\mu\)-null set, \(0\leq X_n(\omega)\leq1\) for every \(n\).  Fix such an
  \(\omega\) and an index \(n\).  If \(\lambda_n(\omega)\geq0\), then
  \(X_n(\omega)-m\geq-m\), and the upper bound in
  \cref{def:is-admissible-bet} gives \(\lambda_n(\omega)m\leq1\).  Hence
  \(\lambda_n(\omega)(X_n(\omega)-m)\geq-1\).  If
  \(\lambda_n(\omega)<0\), then \(X_n(\omega)-m\leq1-m\), and the lower
  admissibility bound gives \(\lambda_n(\omega)(1-m)\geq-1\).  Multiplication by the
  nonpositive number \(\lambda_n(\omega)\) again yields
  \(\lambda_n(\omega)(X_n(\omega)-m)\geq-1\). -/)
  (title := /-- Admissible wealth factors are bounded below -/)
  (latexEnv := "lemma")]
lemma admissible_factor_lower_bound_for_positive_limit {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X lam : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X)
    (hbet : is_admissible_bet X m lam) :
    ∀ᵐ ω ∂μ, ∀ n, -1 ≤ lam n ω * (X n ω - m) := by
  have hm := betting_null_mean_strictly_between μ P m X hmodel
  have hsupport_each : ∀ n : ℕ, ∀ᵐ ω ∂μ, X n ω ∈ Set.Icc (0 : ℝ) 1 := by
    intro n
    exact (hmodel.commonLaw n).symm.ae_mem_snd measurableSet_Icc hmodel.support
  have hsupport_all : ∀ᵐ ω ∂μ, ∀ n : ℕ, X n ω ∈ Set.Icc (0 : ℝ) 1 :=
    ae_all_iff.mpr hsupport_each
  filter_upwards [hsupport_all] with ω hsupp
  intro n
  by_cases hlam : 0 ≤ lam n ω
  · have hdev : -m ≤ X n ω - m := by
      linarith [(hsupp n).1]
    have hbound : lam n ω * m ≤ 1 :=
      (le_div_iff₀ hm.1).mp (hbet.2 n ω).2
    have hmul := mul_le_mul_of_nonneg_left hdev hlam
    nlinarith
  · have hlam' : lam n ω ≤ 0 := le_of_not_ge hlam
    have hdev : X n ω - m ≤ 1 - m := by
      linarith [(hsupp n).2]
    have hbound : -1 ≤ lam n ω * (1 - m) :=
      (div_le_iff₀ (sub_pos.mpr hm.2)).mp (by
        simpa [neg_div] using (hbet.2 n ω).1)
    have hmul := mul_le_mul_of_nonpos_left hdev hlam'
    nlinarith

@[blueprint "lem:positive-limit-characterization"
  (statement := /-- Let \((\Omega,\mu)\) be a probability space, let \(P\) be a probability
  measure on \(\mathbb R\), and let \(m\in\mathbb R\).  Let
  \(X=(X_n)_{n\geq0}\) and \(\lambda=(\lambda_n)_{n\geq0}\) be families of real-valued
  functions on \(\Omega\).  Suppose that \((\mu,P,m,X)\) is a betting null model and
  that \(\lambda\) is an admissible predictable bet process for \(X\) at mean \(m\).
  If a function \(W_\infty:\Omega\to\mathbb R\) satisfies
  \(W_n^\lambda(\omega)\to W_\infty(\omega)\) for \(\mu\)-almost every \(\omega\),
  then, for \(\mu\)-almost every \(\omega\),
  \[
    W_\infty(\omega)>0
    \quad\Longleftrightarrow\quad
    \sum_{n=0}^{\infty}\lambda_n(\omega)^2<\infty
    \ \text{and}\
    \forall n\in\mathbb N,\ \lambda_n(\omega)(X_n(\omega)-m)>-1.
  \] -/)
  (proof := /-- By \cref{lem:wealth-limit-nonnegative}, \(W_\infty(\omega)\geq0\) outside
  a null set.  On the same full-measure set, \cref{lem:zero-limit-characterization} says
  that \(W_\infty(\omega)=0\) if and only if the squared bets are not summable or some
  factor increment equals \(-1\).  Thus positivity implies square summability and excludes
  equality with \(-1\) at every index.  By
  \cref{lem:admissible-factor-lower-bound-for-positive-limit}, every factor increment is at
  least \(-1\), so excluding equality makes every inequality strict.  Conversely, square
  summability and strictness exclude both alternatives in the zero-limit characterization;
  hence \(W_\infty(\omega)\neq0\), and nonnegativity yields
  \(W_\infty(\omega)>0\). -/)
  (title := /-- Characterization of a positive wealth limit -/)
  (latexEnv := "lemma")]
lemma positive_limit_characterization {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X lam : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X)
    (hbet : is_admissible_bet X m lam)
    (Wlim : Ω → ℝ)
    (hlim : ∀ᵐ ω ∂μ,
      Tendsto (fun n => betting_wealth m X lam n ω) atTop (𝓝 (Wlim ω))) :
    ∀ᵐ ω ∂μ,
      0 < Wlim ω ↔
        Summable (fun n => (lam n ω) ^ 2) ∧
          ∀ n, -1 < lam n ω * (X n ω - m) := by
  have hzero :=
    zero_limit_characterization μ P m X lam hmodel hbet Wlim hlim
  have hnonnegative :=
    wealth_limit_nonnegative μ P m X lam hmodel hbet Wlim hlim
  have hfactor :=
    admissible_factor_lower_bound_for_positive_limit μ P m X lam hmodel hbet
  filter_upwards [hzero, hnonnegative, hfactor]
    with ω hzeroω hnonnegativeω hfactorω
  constructor
  · intro hpositive
    have hne : Wlim ω ≠ 0 := ne_of_gt hpositive
    constructor
    · by_contra hnonsummable
      exact hne (hzeroω.mpr (Or.inl hnonsummable))
    · intro n
      have hfactor_ne : lam n ω * (X n ω - m) ≠ -1 := by
        intro heq
        exact hne (hzeroω.mpr (Or.inr ⟨n, heq⟩))
      exact lt_of_le_of_ne (hfactorω n) (Ne.symm hfactor_ne)
  · rintro ⟨hsummable, hstrict⟩
    have hne : Wlim ω ≠ 0 := by
      intro heq
      rcases hzeroω.mp heq with hnonsummable | ⟨n, hfactor_eq⟩
      · exact hnonsummable hsummable
      · exact (ne_of_gt (hstrict n)) hfactor_eq
    exact lt_of_le_of_ne hnonnegativeω (Ne.symm hne)

@[blueprint "thm:sum-of-squares-criterion"
  (statement := /-- Let \((\Omega,\mu)\) be a probability space, let \(P\) be a probability
  measure on \(\mathbb R\), and let \(m\in\mathbb R\).  Let
  \(X=(X_n)_{n\geq0}\) and \(\lambda=(\lambda_n)_{n\geq0}\) be families of real-valued
  functions on \(\Omega\).  Assume that the functions \(X_n\) are mutually independent and
  have common law \(P\), that \(P\) is supported on \([0,1]\), that
  \(\int_{\mathbb R}x\,dP(x)=m\), and that \(P\ne\delta_m\).  Assume also that each
  \(\lambda_n\) is measurable with respect to the sigma-algebra generated by
  \(X_0,\ldots,X_{n-1}\), and that, for every \(n\in\mathbb N\) and \(\omega\in\Omega\),
  \[
    -\frac{1}{1-m}\leq\lambda_n(\omega)\leq\frac{1}{m}.
  \]
  Define
  \[
    W_n^\lambda(\omega)=\prod_{k=0}^{n-1}
      \bigl(1+\lambda_k(\omega)(X_k(\omega)-m)\bigr).
  \]
  Then there exists a function \(W_\infty:\Omega\to\mathbb R\) such that
  \(W_n^\lambda(\omega)\to W_\infty(\omega)\) for \(\mu\)-almost every \(\omega\).
  Moreover, for \(\mu\)-almost every \(\omega\),
  \[
    W_\infty(\omega)=0
    \Longleftrightarrow
    \left(\bigl(\lambda_n(\omega)^2\bigr)_{n\geq0}\ \text{is not summable}\right)
      \ \text{or}\
    \left(\exists n\in\mathbb N,\ \lambda_n(\omega)(X_n(\omega)-m)=-1\right),
  \]
  and
  \[
    W_\infty(\omega)>0
    \Longleftrightarrow
    \left(\bigl(\lambda_n(\omega)^2\bigr)_{n\geq0}\ \text{is summable}\right)
      \ \text{and}\
    \left(\forall n\in\mathbb N,\ \lambda_n(\omega)(X_n(\omega)-m)>-1\right).
  \] -/)
  (proof := /-- By \cref{lem:betting-wealth-has-ae-limit}, there is a function
  \(W_\infty:\Omega\to\mathbb R\) to which the wealth converges for \(\mu\)-almost every
  \(\omega\).  For this function and this almost-sure convergence hypothesis,
  \cref{lem:zero-limit-characterization} gives the asserted zero-limit equivalence, while
  \cref{lem:positive-limit-characterization} gives the asserted positive-limit equivalence.
  Taking \(W_\infty\) as the existential witness and adjoining these two conclusions to the
  convergence conclusion proves the result. -/)
  (title := /-- Sum-of-squares criterion -/)
  (latexEnv := "theorem")]
theorem sum_of_squares_criterion {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (P : Measure ℝ) [IsProbabilityMeasure P]
    (m : ℝ) (X lam : ℕ → Ω → ℝ)
    (hmodel : betting_null_model μ P m X)
    (hbet : is_admissible_bet X m lam) :
    ∃ Wlim : Ω → ℝ,
      (∀ᵐ ω ∂μ,
        Tendsto (fun n => betting_wealth m X lam n ω) atTop (𝓝 (Wlim ω))) ∧
      (∀ᵐ ω ∂μ,
        Wlim ω = 0 ↔
          ¬Summable (fun n => (lam n ω) ^ 2) ∨
            ∃ n, lam n ω * (X n ω - m) = -1) ∧
      (∀ᵐ ω ∂μ,
        0 < Wlim ω ↔
          Summable (fun n => (lam n ω) ^ 2) ∧
            ∀ n, -1 < lam n ω * (X n ω - m)) := by
  obtain ⟨Wlim, hlim⟩ :=
    betting_wealth_has_ae_limit μ P m X lam hmodel hbet
  refine ⟨Wlim, hlim, ?_, ?_⟩
  · exact zero_limit_characterization μ P m X lam hmodel hbet Wlim hlim
  · exact positive_limit_characterization μ P m X lam hmodel hbet Wlim hlim
